Cell["n=3 Verification", "Section",ExpressionUUID->"fbab4140-1e9b-4e2a-a61c-de7de514b2c0"],

Cell["\<\
All four conjectures also verified in n=3 with general diagonal gamma and \
symmetric Hessian. \
\>", "Text",ExpressionUUID->"a2b49fa7-882d-4b23-99ad-67877021901c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"n", "=", 
    RowBox[{"3", " ", "with", " ", "plain", " ", "variable", " ", "names"}]}],
    " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"l3", "=", 
     RowBox[{"{", 
      RowBox[{"la", ",", "lb", ",", "lc"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"hess3", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"Haa", ",", "Hab", ",", "Hac"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"Hab", ",", "Hbb", ",", "Hbc"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"Hac", ",", "Hbc", ",", "Hcc"}], "}"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"gam3", "=", 
     RowBox[{"DiagonalMatrix", "[", 
      RowBox[{"{", 
       RowBox[{"ga", ",", "gb", ",", "gc"}], "}"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"xi", "=", 
     RowBox[{"Symbol", "[", "\"\<xi\>\"", "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"g3", "=", 
     RowBox[{"gam3", "+", 
      RowBox[{"xi", "*", 
       RowBox[{"Outer", "[", 
        RowBox[{"Times", ",", "l3", ",", "l3"}], "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"gamInv3", "=", 
     RowBox[{"DiagonalMatrix", "[", 
      RowBox[{"1", "/", 
       RowBox[{"Diagonal", "[", "gam3", "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"lUp3", "=", 
     RowBox[{"gamInv3", " ", ".", " ", "l3"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"normSq3", "=", 
     RowBox[{
      RowBox[{"l3", " ", ".", " ", "gamInv3", " ", ".", " ", "l3"}], " ", "//",
       " ", "Simplify"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"gInv3", "=", 
     RowBox[{
      RowBox[{"gamInv3", "-", 
       RowBox[{"xi", "*", 
        RowBox[{
         RowBox[{"Outer", "[", 
          RowBox[{"Times", ",", "lUp3", ",", "lUp3"}], "]"}], "/", 
         RowBox[{"(", 
          RowBox[{"1", "+", 
           RowBox[{"xi", "*", "normSq3"}]}], ")"}]}]}]}], " ", "//", " ", 
      "Simplify"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"dg3", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"xi", "*", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"hess3", "[", 
            RowBox[{"[", 
             RowBox[{"k", ",", "i"}], "]"}], "]"}], "*", 
           RowBox[{"l3", "[", 
            RowBox[{"[", "j", "]"}], "]"}]}], "+", 
          RowBox[{
           RowBox[{"l3", "[", 
            RowBox[{"[", "i", "]"}], "]"}], "*", 
           RowBox[{"hess3", "[", 
            RowBox[{"[", 
             RowBox[{"k", ",", "j"}], "]"}], "]"}]}]}], ")"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"k", ",", "3"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "3"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "3"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"bracket3", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"dg3", "[", 
         RowBox[{"[", 
          RowBox[{"i", ",", "j", ",", "ll"}], "]"}], "]"}], "+", 
        RowBox[{"dg3", "[", 
         RowBox[{"[", 
          RowBox[{"j", ",", "i", ",", "ll"}], "]"}], "]"}], "-", 
        RowBox[{"dg3", "[", 
         RowBox[{"[", 
          RowBox[{"ll", ",", "i", ",", "j"}], "]"}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "3"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "3"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"ll", ",", "3"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"chris3", "=", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", "/", "2"}], ")"}], "*", 
           RowBox[{"gInv3", "[", 
            RowBox[{"[", 
             RowBox[{"k", ",", "ll"}], "]"}], "]"}], "*", 
           RowBox[{"bracket3", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", "j", ",", "ll"}], "]"}], "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"ll", ",", "3"}], "}"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"k", ",", "3"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "3"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", "3"}], "}"}]}], "]"}], " ", "//", " ", 
      "Simplify"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"chrisFormula3", "=", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"xi", "*", 
         RowBox[{"hess3", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "j"}], "]"}], "]"}], "*", 
         RowBox[{
          RowBox[{"lUp3", "[", 
           RowBox[{"[", "k", "]"}], "]"}], "/", 
          RowBox[{"(", 
           RowBox[{"1", "+", 
            RowBox[{"xi", "*", "normSq3"}]}], ")"}]}]}], ",", 
        RowBox[{"{", 
         RowBox[{"k", ",", "3"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "3"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", "3"}], "}"}]}], "]"}], " ", "//", " ", 
      "Simplify"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"FullSimplify", "[", 
      RowBox[{"chris3", "-", "chrisFormula3"}], "]"}], " ", "//", " ", 
     "Flatten"}], " ", "//", " ", "DeleteDuplicates"}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"Result", ":", " ", 
      RowBox[{"{", "0", "}"}]}], " ", "\[LongDash]", " ", "VERIFIED"}], " ", 
    "*)"}]}]}]], "Input",ExpressionUUID->"c7108e2b-f12f-484b-a48c-\
5af3813122cd"],

Cell["Second Fundamental Form", "Section",ExpressionUUID->"314ba021-cbc7-4690-9989-329477e754de"],

Cell[TextData[{
 "Embedding ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[CurlyPhi]", 
         RowBox[{"(", "\[Theta]", ")"}], "\[LongEqual]", 
         RowBox[{"(", 
           RowBox[{
             SuperscriptBox["\[Theta]", "1"], ",", "\[Ellipsis]", ",", 
             SuperscriptBox["\[Theta]", 
              StyleBox["N", "TI"]], ",", 
             StyleBox["L", "TI"], 
             RowBox[{"(", "\[Theta]", ")"}]}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\varphi(\\theta) = (\\theta^1, \\ldots, \\theta^N, L(\\theta))", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "1214628f-9e4b-4844-a2c8-905ad19ef072"],
 " with ambient metric ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["h", "TI"], "\[LongEqual]", "diag", 
         RowBox[{"(", 
           RowBox[{
             SubscriptBox["\[Gamma]", "1"], ",", "\[Ellipsis]", ",", 
             SubscriptBox["\[Gamma]", 
              StyleBox["N", "TI"]], ",", "\[Xi]"}], ")"}]}], TraditionalForm],
      "errors" -> {}, "input" -> 
     "h = \\text{diag}(\\gamma_1, \\ldots, \\gamma_N, \\xi)", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "8e711974-b8c0-4678-bb7c-f1b7ec8f2ec6"],
 "."
}], "Text",ExpressionUUID->"1081fbd9-9960-4a39-be6d-d7e7dc49e918"],

Cell[TextData[{
 "Unit normal: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["n", "TI"], "3"], "\[LongEqual]", "1", "/", 
         SqrtBox[
          RowBox[{"\[Xi]", "(", 
            
            RowBox[{"1", "+", "\[Xi]", 
              "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", 
              StyleBox["l", "TI"], 
              SubsuperscriptBox[
              "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", 
               "\[Gamma]", "2"]}], ")"}]]}], TraditionalForm], "errors" -> {},
      "input" -> "n_3 = 1/\\sqrt{\\xi(1 + \\xi|l|^2_\\gamma)}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "9ebf2fab-4581-45aa-ac34-4ccd383bcf90"],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["b", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"]}]], "\[LongEqual]", 
         SqrtBox[
          FractionBox["\[Xi]", 
           
           RowBox[{"1", "+", "\[Xi]", 
             "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", 
             StyleBox["l", "TI"], 
             SubsuperscriptBox[
             "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", 
              "\[Gamma]", "2"]}]]], " ", 
         SubscriptBox[
          StyleBox["H", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"]}]]}], TraditionalForm], "errors" -> {}, 
     "input" -> 
     "b_{ij} = \\sqrt{\\frac{\\xi}{1 + \\xi|l|^2_\\gamma}}\\, H_{ij}", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "459669db-357e-4c1d-8424-c9a037c4d244"],
 "Relationship: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          RowBox[{"(", 
            RowBox[{
              SubscriptBox["Hess", 
               StyleBox["g", "TI"]], " ", 
              StyleBox["L", "TI"]}], ")"}], 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"]}]], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["n", "TI"], "3"], " ", 
         SubscriptBox[
          StyleBox["b", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"]}]]}], TraditionalForm], "errors" -> {}, 
     "input" -> "(\\text{Hess}_g\\, L)_{ij} = n_3\\, b_{ij}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "1b4cbfb3-4d81-4837-9d15-16032362b1a6"]
}], "Text",ExpressionUUID->"b924d0a0-fe20-416a-b987-7cbe635d64fe"],

Cell["Gauss Equation", "Section",ExpressionUUID->"fb093c2e-dcf9-45bc-aeb9-e41a9d138325"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["R", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"], 
            StyleBox["k", "TI"], 
            StyleBox["l", "TI"]}]], "\[LongEqual]", 
         FractionBox["\[Xi]", 
          
          RowBox[{"1", "+", "\[Xi]", 
            "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", 
            StyleBox["l", "TI"], 
            SubsuperscriptBox[
            "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", "\[Gamma]",
              "2"]}]], " ", 
         RowBox[{"(", 
           RowBox[{
             SubscriptBox[
              StyleBox["H", "TI"], 
              RowBox[{
                StyleBox["i", "TI"], 
                StyleBox["k", "TI"]}]], " ", 
             SubscriptBox[
              StyleBox["H", "TI"], 
              RowBox[{
                StyleBox["j", "TI"], 
                StyleBox["l", "TI"]}]], "-", 
             SubscriptBox[
              StyleBox["H", "TI"], 
              RowBox[{
                StyleBox["i", "TI"], 
                StyleBox["l", "TI"]}]], " ", 
             SubscriptBox[
              StyleBox["H", "TI"], 
              RowBox[{
                StyleBox["j", "TI"], 
                StyleBox["k", "TI"]}]]}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "R_{ijkl} = \\frac{\\xi}{1+\\xi|l|^2_\\gamma}\\,(H_{ik}\\,H_{jl} - \
H_{il}\\,H_{jk})", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "fcb0111a-c1ee-463b-9f9b-76755ef3dd5e"],
 "Gaussian curvature (n=2): ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["K", "TI"], "\[LongEqual]", 
         FractionBox[
          RowBox[{"\[Xi] ", "det", 
            RowBox[{"(", 
              StyleBox["H", "TI"], ")"}]}], 
          RowBox[{"det", 
            RowBox[{"(", "\[Gamma]", ")"}], " ", 
            SuperscriptBox[
             RowBox[{"(", 
               
               RowBox[{
                "1", "+", "\[Xi]", 
                 "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", 
                 StyleBox["l", "TI"], 
                 SubsuperscriptBox[
                 "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", 
                  "\[Gamma]", "2"]}], ")"}], "2"]}]]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "K = \\frac{\\xi\\,\\det(H)}{\\det(\\gamma)\\,(1+\\xi|l|^2_\\gamma)^2}", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "18ccaa6e-7f90-40a5-b0d6-2a1d2a2ff76b"],
 "Scalar curvature: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["R", "TI"], "\[LongEqual]", "2", 
         StyleBox["K", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "R = 2K", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "68aa1738-c241-447e-9369-9c1816ce4415"],
 " (as expected for a 2D surface). "
}], "Text",ExpressionUUID->"66af3d60-38bd-4989-91bc-861e9ac8351d"],

Cell["PSD / Geodesic Convexity Analysis", "Section",ExpressionUUID->"6f05f06a-0334-468e-878f-cd995b1b7beb"],

Cell[TextData[{
 StyleBox["Key Result:",
  FontWeight->Bold],
 " Since ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          RowBox[{"(", 
            RowBox[{
              SubscriptBox["Hess", 
               StyleBox["g", "TI"]], " ", 
              StyleBox["L", "TI"]}], ")"}], 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"]}]], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["H", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"]}]], "/", 
         RowBox[{"(", 
           
           RowBox[{"1", "+", "\[Xi]", 
             "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", 
             StyleBox["l", "TI"], 
             SubsuperscriptBox[
             "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", 
              "\[Gamma]", "2"]}], ")"}]}], TraditionalForm], "errors" -> {}, 
     "input" -> "(\\text{Hess}_g\\, L)_{ij} = H_{ij}/(1+\\xi|l|^2_\\gamma)", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e8858a96-02d2-4565-ad00-65f19276dbb4"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
        "1", "+", "\[Xi]", 
         "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", 
         StyleBox["l", "TI"], 
         SubsuperscriptBox[
         "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", "\[Gamma]", 
          "2"], ">", "0"}], TraditionalForm], "errors" -> {}, "input" -> 
     "1+\\xi|l|^2_\\gamma > 0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "8662472b-4492-4f2e-b856-d285ff964ee1"],
 " always: "
}], "Text",ExpressionUUID->"d85a6213-5088-4d1c-8ab1-35d02010aef7"],

Cell[TextData[{
 "Eigenvalues of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["Hess", 
          StyleBox["g", "TI"]], " ", 
         StyleBox["L", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\text{Hess}_g\\, L", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
