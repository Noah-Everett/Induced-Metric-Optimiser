      RowBox[{"i", ",", "2"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "2"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"el", ",", "2"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Simplify", "[", 
  RowBox[{"bracketOD", "-", "bracketODexpected"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Expected", ":", " ", 
     RowBox[{"all", " ", "zeros"}]}], " ", "\[LongDash]", " ", 
    RowBox[{
     RowBox[{"when", " ", "a"}], "=", "b"}], ",", " ", 
    RowBox[{
     RowBox[{
     "first", " ", "term", " ", "vanishes", " ", "and", " ", "bracket"}], " ",
      "\[Proportional]", " ", 
     RowBox[{"H_", 
      RowBox[{"{", "ij", "}"}]}]}]}], " ", "*)"}]}]}], "Input",ExpressionUUID->\
"298d1113-6f13-457c-9972-6cba0e40650a"],

Cell["10. Numerical Verification: Rosenbrock", "Section",ExpressionUUID->"618da6de-ab8b-440c-aadb-1685d96b8ee3"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"rosenbrock", "[", 
    RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "-", "x"}], ")"}], "^", "2"}], "+", 
    RowBox[{"100", "*", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"y", "-", 
        RowBox[{"x", "^", "2"}]}], ")"}], "^", "2"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"gradR", "[", 
    RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"-", "2"}], "*", 
       RowBox[{"(", 
        RowBox[{"1", "-", "x"}], ")"}]}], "-", 
      RowBox[{"400", "*", "x", "*", 
       RowBox[{"(", 
        RowBox[{"y", "-", 
         RowBox[{"x", "^", "2"}]}], ")"}]}]}], ",", 
     RowBox[{"200", "*", 
      RowBox[{"(", 
       RowBox[{"y", "-", 
        RowBox[{"x", "^", "2"}]}], ")"}]}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"hessR", "[", 
     RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"2", "+", 
         RowBox[{"800", "*", 
          RowBox[{"x", "^", "2"}]}], "-", 
         RowBox[{"400", "*", 
          RowBox[{"(", 
           RowBox[{"y", "-", 
            RowBox[{"x", "^", "2"}]}], ")"}]}]}], ",", 
        RowBox[{
         RowBox[{"-", "400"}], "*", "x"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "400"}], "*", "x"}], ",", "200"}], "}"}]}], "}"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"pts", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "1"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0.5", ",", "0.25"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"2", ",", "4"}], "}"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"xiVal", "=", "10"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"results", "=", 
    RowBox[{"Table", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "lv", ",", "hm", ",", "ns", ",", "rH", ",", "rHf", ",", "maxErr"}], 
         "}"}], ",", "\[IndentingNewLine]", "    ", 
        RowBox[{
         RowBox[{"lv", "=", 
          RowBox[{
           RowBox[{"gradR", "[", 
            RowBox[{
             RowBox[{"pt", "[", 
              RowBox[{"[", "1", "]"}], "]"}], ",", 
             RowBox[{"pt", "[", 
              RowBox[{"[", "2", "]"}], "]"}]}], "]"}], " ", "//", " ", 
           "N"}]}], ";", "\[IndentingNewLine]", "    ", 
         RowBox[{"hm", "=", 
          RowBox[{
           RowBox[{"hessR", "[", 
            RowBox[{
             RowBox[{"pt", "[", 
              RowBox[{"[", "1", "]"}], "]"}], ",", 
             RowBox[{"pt", "[", 
              RowBox[{"[", "2", "]"}], "]"}]}], "]"}], " ", "//", " ", 
           "N"}]}], ";", "\[IndentingNewLine]", "    ", 
         RowBox[{"ns", "=", 
          RowBox[{"lv", ".", "lv"}]}], ";", "\[IndentingNewLine]", "    ", 
         RowBox[{"(*", " ", 
          RowBox[{"Direct", " ", "computation"}], " ", "*)"}], 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"gm", "=", 
          RowBox[{
           RowBox[{"IdentityMatrix", "[", "2", "]"}], "+", 
           RowBox[{"xiVal", "*", 
            RowBox[{"Outer", "[", 
             RowBox[{"Times", ",", "lv", ",", "lv"}], "]"}]}]}]}], ";", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"ginv", "=", 
          RowBox[{"Inverse", "[", "gm", "]"}]}], ";", "\[IndentingNewLine]", 
         "    ", 
         RowBox[{"dg", "=", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"xiVal", "*", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{"hm", "[", 
                 RowBox[{"[", 
                  RowBox[{"k", ",", "i"}], "]"}], "]"}], "*", 
                RowBox[{"lv", "[", 
                 RowBox[{"[", "j", "]"}], "]"}]}], "+", 
               RowBox[{
                RowBox[{"lv", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], "*", 
                RowBox[{"hm", "[", 
                 RowBox[{"[", 
                  RowBox[{"k", ",", "j"}], "]"}], "]"}]}]}], ")"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"k", ",", "2"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "2"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"j", ",", "2"}], "}"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"br", "=", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"dg", "[", 
              RowBox[{"[", 
               RowBox[{"i", ",", "j", ",", "el"}], "]"}], "]"}], "+", 
             RowBox[{"dg", "[", 
              RowBox[{"[", 
               RowBox[{"j", ",", "i", ",", "el"}], "]"}], "]"}], "-", 
             RowBox[{"dg", "[", 
              RowBox[{"[", 
               RowBox[{"el", ",", "i", ",", "j"}], "]"}], "]"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "2"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"j", ",", "2"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"el", ",", "2"}], "}"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"ch", "=", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"Sum", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{"1", "/", "2"}], ")"}], "*", 
               RowBox[{"ginv", "[", 
                RowBox[{"[", 
                 RowBox[{"k", ",", "el"}], "]"}], "]"}], "*", 
               RowBox[{"br", "[", 
                RowBox[{"[", 
                 RowBox[{"i", ",", "j", ",", "el"}], "]"}], "]"}]}], ",", 
              RowBox[{"{", 
               RowBox[{"el", ",", "2"}], "}"}]}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"k", ",", "2"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "2"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"j", ",", "2"}], "}"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"corr", "=", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"Sum", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"ch", "[", 
                RowBox[{"[", 
                 RowBox[{"k", ",", "i", ",", "j"}], "]"}], "]"}], "*", 
               RowBox[{"lv", "[", 
                RowBox[{"[", "k", "]"}], "]"}]}], ",", 
              RowBox[{"{", 
               RowBox[{"k", ",", "2"}], "}"}]}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "2"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"j", ",", "2"}], "}"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"rH", "=", 
          RowBox[{"hm", "-", "corr"}]}], ";", "\[IndentingNewLine]", "    ", 
         RowBox[{"(*", " ", "Formula", " ", "*)"}], "\[IndentingNewLine]", 
         "    ", 
         RowBox[{"rHf", "=", 
          RowBox[{"hm", "/", 
           RowBox[{"(", 
            RowBox[{"1", "+", 
             RowBox[{"xiVal", "*", "ns"}]}], ")"}]}]}], ";", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"maxErr", "=", 
          RowBox[{"Max", "[", 
           RowBox[{"Abs", "[", 
            RowBox[{"Flatten", "[", 
             RowBox[{"rH", "-", "rHf"}], "]"}], "]"}], "]"}]}], ";", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"{", 
          RowBox[{"pt", ",", 
           RowBox[{"Sort", "[", 
            RowBox[{"Eigenvalues", "[", "hm", "]"}], "]"}], ",", 
           RowBox[{"Sort", "[", 
            RowBox[{"Eigenvalues", "[", "rH", "]"}], "]"}], ",", "maxErr"}], 
          "}"}]}]}], "\[IndentingNewLine]", "  ", "]"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"pt", ",", "pts"}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"TableForm", "[", 
  RowBox[{"results", ",", 
   RowBox[{"TableHeadings", "->", 
    RowBox[{"{", 
     RowBox[{"None", ",", 
      RowBox[{"{", 
       RowBox[{"\"\<Point\>\"", ",", "\"\<\[Lambda](H)\>\"", 
        ",", "\"\<\[Lambda](Hess_g)\>\"", ",", "\"\<Max Error\>\""}], "}"}]}],
      "}"}]}]}], "]"}]}], "Input",ExpressionUUID->"e92aaaa3-27c4-4bed-bd32-\
c3bda86f75b0"],

Cell["11. Numerical Verification: Saddle L = x\.b2 - y\.b2", "Section",ExpressionUUID->"cd8cc6ba-0319-4c09-ac9b-59d67545e808"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "At", " ", "origin", " ", "and", " ", "on", " ", "unit", " ", "circle"}], 
   " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"hSaddle", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"2", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", 
         RowBox[{"-", "2"}]}], "}"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Table", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"px", ",", "py", ",", "lv", ",", "ns"}], "}"}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{
         RowBox[{"px", "=", 
          RowBox[{"Cos", "[", "th", "]"}]}], ";", " ", 
         RowBox[{"py", "=", 
          RowBox[{"Sin", "[", "th", "]"}]}], ";", "\[IndentingNewLine]", 
         "    ", 
         RowBox[{"lv", "=", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"2", "*", "px"}], ",", 
            RowBox[{
             RowBox[{"-", "2"}], "*", "py"}]}], "}"}]}], ";", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"ns", "=", 
          RowBox[{"lv", ".", "lv"}]}], ";", "\[IndentingNewLine]", "    ", 
         RowBox[{"{", 
          RowBox[{"th", ",", 
           RowBox[{"Sort", "[", 
            RowBox[{"Eigenvalues", "[", 
             RowBox[{"hSaddle", "/", 
              RowBox[{"(", 
               RowBox[{"1", "+", 
                RowBox[{"10", "*", "ns"}]}], ")"}]}], "]"}], "]"}]}], 
          "}"}]}]}], "\[IndentingNewLine]", "  ", "]"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"th", ",", "0", ",", 
        RowBox[{"2", "*", "Pi"}], ",", 
        RowBox[{"Pi", "/", "4"}]}], "}"}]}], "]"}], " ", "//", " ", 
    "TableForm"}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "All", " ", "entries", " ", "should", " ", "have", " ", "one", " ", 
     "positive", " ", "and", " ", "one", " ", "negative", " ", "eigenvalue"}],
     " ", "*)"}]}]}]], "Input",ExpressionUUID->"c8d32e96-9dfb-45ac-9ff8-\
76f9b9e3d80e"],

