Cell["5. Second Fundamental Form and Gauss Equation", "Section",ExpressionUUID->"26798a93-6e7d-4abc-a7a2-0a535675edd3"],

Cell["A different route to the same answer", "Subsection",ExpressionUUID->"294db44f-258a-45ed-8003-e53410001c08"],

Cell[TextData[{
 "Instead of computing Christoffel symbols directly, we can study the ",
 StyleBox["extrinsic geometry",
  FontWeight->Bold],
 " of the embedded surface ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[CurlyPhi]", 
         RowBox[{"(", "\[Theta]", ")"}], "\[LongEqual]", 
         RowBox[{"(", 
           RowBox[{"\[Theta]", ",", 
             StyleBox["L", "TI"], 
             RowBox[{"(", "\[Theta]", ")"}]}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\varphi(\\theta) = (\\theta, L(\\theta))", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5041eafb-b265-4f1d-9d57-ba1dc4f13b97"],
 " in ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox[
        StyleBox["R", FontSlant -> "Plain"], 
        RowBox[{
          StyleBox["N", "TI"], "+", "1"}]], TraditionalForm], "errors" -> {}, 
     "input" -> "\\mathbb{R}^{N+1}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "caab6a8b-0ae7-4fc5-8651-26cbcffa66c0"],
 "."
}], "Text",ExpressionUUID->"82202bee-17e1-4895-b830-b057047465ca"],

Cell[TextData[{
 "The ",
 StyleBox["second fundamental form",
  FontWeight->Bold],
 " $b_{ij}$ measures how the surface curves within the ambient space. The ",
 StyleBox["Gauss equation",
  FontWeight->Bold],
 " then relates the intrinsic curvature (Riemann tensor of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["g", "TI"], TraditionalForm], "errors" -> {}, "input" -> "g", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "814946ce-a526-47ac-b34b-1960901d0852"],
 ") to $b_{ij}$. "
}], "Text",ExpressionUUID->"26cc60c5-d8c9-4186-a2ce-400b7089fe04"],

Cell["Unit normal to the surface", "Subsection",ExpressionUUID->"32ce09d9-407c-4a7c-baba-d968bd67ca30"],

Cell[TextData[{
 "The surface has tangent vectors ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["e", "TI"], 
          StyleBox["i", "TI"]], "\[LongEqual]", 
         RowBox[{"(", 
           RowBox[{
             SubscriptBox["\[Delta]", 
              RowBox[{
                StyleBox["i", "TI"], "1"}]], ",", "\[Ellipsis]", ",", 
             SubscriptBox["\[Delta]", 
              RowBox[{
                StyleBox["i", "TI"], 
                StyleBox["N", "TI"]}]], ",", 
             SubscriptBox[
              StyleBox["l", "TI"], 
              StyleBox["i", "TI"]]}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "e_i = (\\delta_{i1}, \\ldots, \\delta_{iN}, l_i)", "state" -> "Boxes"|>,
    
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "fb2516eb-1d83-4cfe-9872-ce83355b6308"],
 ". The unit normal ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["n", "TI"], TraditionalForm], "errors" -> {}, "input" -> "n", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f30fde22-1d66-4275-8561-2b591f9a8dec"],
 " (with respect to the ambient metric ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["h", "TI"], "\[LongEqual]", 
         StyleBox["diag", FontSlant -> "Plain"], 
         RowBox[{"(", 
           RowBox[{
             SubscriptBox["\[Gamma]", "1"], ",", "\[Ellipsis]", ",", 
             SubscriptBox["\[Gamma]", 
              StyleBox["N", "TI"]], ",", "\[Xi]"}], ")"}]}], TraditionalForm],
      "errors" -> {}, "input" -> 
     "h = \\mathrm{diag}(\\gamma_1, \\ldots, \\gamma_N, \\xi)", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "86d37fff-61a1-4244-927e-4cfafd764822"],
 ") must satisfy ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["h", "TI"], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["n", "TI"], ",", 
             SubscriptBox[
              StyleBox["e", "TI"], 
              StyleBox["i", "TI"]]}], ")"}], "\[LongEqual]", "0"}], 
       TraditionalForm], "errors" -> {}, "input" -> "h(n, e_i) = 0", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "2011f27b-d0ed-47cf-bb54-ebf9100a04b8"],
 " for all ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["i", "TI"], TraditionalForm], "errors" -> {}, "input" -> "i", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "8c59c05a-50f1-4c4a-92c7-e48ce2d11199"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["h", "TI"], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["n", "TI"], ",", 
             StyleBox["n", "TI"]}], ")"}], "\[LongEqual]", "1"}], 
       TraditionalForm], "errors" -> {}, "input" -> "h(n, n) = 1", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "05476a34-7053-47be-ad26-a076b1388a5a"],
 "."
}], "Text",ExpressionUUID->"2fbff514-72a3-41a7-979e-e62b8d32ffca"],

Cell[TextData[{
 "The normal component in the ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"(", 
         RowBox[{
           StyleBox["N", "TI"], "+", "1"}], ")"}], TraditionalForm], 
     "errors" -> {}, "input" -> "(N+1)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "6736b570-586b-4bee-bc09-67953c4ca3b9"],
 "-th direction is: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["n", "TI"], "3"], "\[LongEqual]", 
         FractionBox["1", 
          SqrtBox[
           RowBox[{"\[Xi]", "(", 
             
             RowBox[{"1", "+", "\[Xi]", 
               "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", 
               StyleBox["l", "TI"], 
               SubsuperscriptBox[
               "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", 
                "\[Gamma]", "2"]}], ")"}]]]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "n_3 = \\frac{1}{\\sqrt{\\xi(1 + \\xi|l|_\\gamma^2)}}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "10688dd2-401c-4fca-bafe-8afc5a43c8a2"]
}], "Text",ExpressionUUID->"0bb25a81-1c91-49d1-aa30-9124a15c8a10"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"l", "=", 
   RowBox[{"{", 
    RowBox[{"l1", ",", "l2"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"hess", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"H11", ",", "H12"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"H12", ",", "H22"}], "}"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"xi", "=", 
   RowBox[{"Symbol", "[", "\"\<xi\>\"", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"normSq", "=", 
    RowBox[{
     RowBox[{
      RowBox[{"l1", "^", "2"}], "/", "g1"}], "+", 
     RowBox[{
      RowBox[{"l2", "^", "2"}], "/", "g2"}]}]}], ";"}], "\[IndentingNewLine]",
   "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
   "Tangent", " ", "vectors", " ", "and", " ", "ambient", " ", "metric"}], 
   " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"e1", "=", 
   RowBox[{"{", 
    RowBox[{"1", ",", "0", ",", "l1"}], "}"}]}], ";", " ", 
  RowBox[{"e2", "=", 
   RowBox[{"{", 
    RowBox[{"0", ",", "1", ",", "l2"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"h", "=", 
    RowBox[{"DiagonalMatrix", "[", 
     RowBox[{"{", 
      RowBox[{"g1", ",", "g2", ",", "xi"}], "}"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"Unit", " ", "normal"}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"n3", "=", 
   RowBox[{"1", "/", 
    RowBox[{"Sqrt", "[", 
     RowBox[{"xi", "*", 
      RowBox[{"(", 
       RowBox[{"1", "+", 
        RowBox[{"xi", "*", "normSq"}]}], ")"}]}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"nVec", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "xi"}], "*", "l1", "*", 
       RowBox[{"n3", "/", "g1"}]}], ",", 
      RowBox[{
       RowBox[{"-", "xi"}], "*", "l2", "*", 
       RowBox[{"n3", "/", "g2"}]}], ",", "n3"}], "}"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Verify", ":", " ", 
     RowBox[{"orthogonal", " ", "to", " ", "tangent", " ", "vectors"}]}], ",",
     " ", 
    RowBox[{"unit", " ", "length"}]}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Simplify", "[", 
    RowBox[{"nVec", ".", "h", ".", "e1"}], "]"}], ",", 
   RowBox[{"Simplify", "[", 
    RowBox[{"nVec", ".", "h", ".", "e2"}], "]"}], ",", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{"nVec", ".", "h", ".", "nVec"}], ",", 
     RowBox[{"Assumptions", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"xi", ">", "0"}], ",", 
        RowBox[{"g1", ">", "0"}], ",", 
        RowBox[{"g2", ">", "0"}]}], "}"}]}]}], "]"}]}], "}"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"0", ",", " ", "0", ",", " ", "1"}], "}"}], " ", "\[LongDash]", 
    " ", "VERIFIED"}], " ", "*)"}]}]}], "Input",ExpressionUUID->"5706915b-\
5dbb-43e3-ac4b-ab83fd163036"],

Cell["Second fundamental form", "Subsection",ExpressionUUID->"10329be5-c1ee-496b-9ac9-4d9483a76c41"],

Cell[TextData[{
 "Since ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[PartialD]", 
          StyleBox["i", "TI"]], 
         SubscriptBox["\[PartialD]", 
          StyleBox["j", "TI"]], "\[CurlyPhi]", "\[LongEqual]", 
         RowBox[{"(", 
           RowBox[{"0", ",", "\[Ellipsis]", ",", "0", ",", 
             SubscriptBox[
              StyleBox["H", "TI"], 
              RowBox[{
                StyleBox["i", "TI"], 
                StyleBox["j", "TI"]}]]}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\partial_i \\partial_j \\varphi = (0, \\ldots, 0, H_{ij})", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f5e2261d-465d-4b68-9dc1-d160001834ec"],
 ", the second fundamental form is: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["b", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"]}]], "\[LongEqual]", 
         StyleBox["h", "TI"], 
         RowBox[{"(", 
           RowBox[{
             SubscriptBox["\[PartialD]", 
              StyleBox["i", "TI"]], 
             SubscriptBox["\[PartialD]", 
              StyleBox["j", "TI"]], "\[CurlyPhi]", ",", 
             StyleBox["n", "TI"]}], ")"}], "\[LongEqual]", "\[Xi] ", 
         SubscriptBox[
          StyleBox["n", "TI"], "3"], " ", 
         SubscriptBox[
          StyleBox["H", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"]}]], "\[LongEqual]", 
         SqrtBox[
          FractionBox["\[Xi]", 
           
           RowBox[{"1", "+", "\[Xi]", 
             "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", 
             StyleBox["l", "TI"], 
             SubsuperscriptBox[
             "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", 
              "\[Gamma]", "2"]}]]], " ", 
         SubscriptBox[
          StyleBox["H", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"]}]]}], TraditionalForm], "errors" -> {}, 
     "input" -> 
     "b_{ij} = h(\\partial_i \\partial_j \\varphi, n) = \\xi\\, n_3\\, H_{ij} \
= \\sqrt{\\frac{\\xi}{1 + \\xi|l|_\\gamma^2}}\\; H_{ij}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "08106c32-c0ad-414b-8896-c3646682ff8f"],
 "Like the Riemannian Hessian, $b_{ij}$ is ",
 StyleBox["proportional to the Euclidean Hessian",
  FontWeight->Bold],
 ". "
}], "Text",ExpressionUUID->"b9ab82c4-e4b5-4a69-8985-65c44d90dee0"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"bExplicit", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", "0", ",", 
         RowBox[{"hess", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "j"}], "]"}], "]"}]}], "}"}], ".", "h", ".", 
       "nVec"}], " ", "//", " ", "Simplify"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "2"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "2"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"bFormula", "=", 
   RowBox[{
    RowBox[{"xi", "*", "n3", "*", "hess"}], " ", "//", " ", 
    "FullSimplify"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{"bExplicit", "-", "bFormula"}], ",", 
   RowBox[{"Assumptions", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"xi", ">", "0"}], ",", 
      RowBox[{"g1", ">", "0"}], ",", 
      RowBox[{"g2", ">", "0"}]}], "}"}]}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "0"}], "}"}]}], "}"}], " ", "\[LongDash]", " ", 
    "VERIFIED"}], " ", "*)"}]}]}], "Input",ExpressionUUID->"de692875-bb27-\
469b-9ecc-d4a76fc72519"],

Cell["\<\
Connection between second fundamental form and Riemannian Hessian\
\>", "Subsection",ExpressionUUID->"4eb68692-103f-40e1-a08d-105784e27838"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          RowBox[{"(", 
            RowBox[{
              SubscriptBox[
               StyleBox["Hess", FontSlant -> "Plain"], 
               StyleBox["g", "TI"]], 
              StyleBox["L", "TI"]}], ")"}], 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"]}]], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["n", "TI"], "3"], "\[CenterDot]", 
         SubscriptBox[
          StyleBox["b", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"]}]]}], TraditionalForm], "errors" -> {}, 
     "input" -> "(\\mathrm{Hess}_g L)_{ij} = n_3 \\cdot b_{ij}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "4af770ae-4259-43b5-839c-d3adf3ec4b43"],
 "The Riemannian Hessian equals the second fundamental form scaled by the \
normal component $n_3$. "
}], "Text",ExpressionUUID->"89ea0fe3-24c7-4aca-b38c-18119b796381"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Numerical", " ", "check"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"testVals", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"l1", "->", "1"}], ",", 
       RowBox[{"l2", "->", "2"}], ",", 
       RowBox[{"H11", "->", "3"}], ",", 
       RowBox[{"H12", "->", "1"}], ",", 
       RowBox[{"H22", "->", "5"}], ",", 
       RowBox[{"g1", "->", "1"}], ",", 
       RowBox[{"g2", "->", "1"}], ",", 
       RowBox[{"xi", "->", "2"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"bNum", "=", 
     RowBox[{
      RowBox[{"bExplicit", " ", "/.", " ", "testVals"}], " ", "//", " ", 
      "N"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"rHessNum", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"hess", "/", 
        RowBox[{"(", 
         RowBox[{"1", "+", 
          RowBox[{"xi", "*", "normSq"}]}], ")"}]}], " ", "/.", " ", 
       "testVals"}], " ", "//", " ", "N"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"n3Num", "=", 
     RowBox[{
      RowBox[{"n3", " ", "/.", " ", "testVals"}], " ", "//", " ", "N"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{"Max", "[", 
    RowBox[{"Abs", "[", 
     RowBox[{"Flatten", "[", 
      RowBox[{"rHessNum", "-", 
       RowBox[{"n3Num", "*", "bNum"}]}], "]"}], "]"}], "]"}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"~", "0"}], " ", "to", " ", "machine", " ", "precision"}], " ", 
     "\[LongDash]", " ", "VERIFIED"}], " ", "*)"}]}]}]], "Input",ExpressionUUI\
D->"ebde9a66-27a4-46cf-bb7f-c822a2f8a661"],

Cell["Gauss equation and curvature", "Subsection",ExpressionUUID->"6d2fcd67-c696-438d-9685-991ca31f02b6"],

Cell[TextData[{
 "For a hypersurface in flat ambient space, the Gauss equation gives the \
Riemann curvature tensor: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["R", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"], 
            StyleBox["k", "TI"], 
            StyleBox["l", "TI"]}]], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["b", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["k", "TI"]}]], " ", 
         SubscriptBox[
          StyleBox["b", "TI"], 
          RowBox[{
            StyleBox["j", "TI"], 
            StyleBox["l", "TI"]}]], "-", 
         SubscriptBox[
          StyleBox["b", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["l", "TI"]}]], " ", 
         SubscriptBox[
          StyleBox["b", "TI"], 
          RowBox[{
            StyleBox["j", "TI"], 
            StyleBox["k", "TI"]}]], "\[LongEqual]", 
         FractionBox["\[Xi]", 
          
          RowBox[{"1", "+", "\[Xi]", 
            "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", 
            StyleBox["l", "TI"], 
            SubsuperscriptBox[
            "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", "\[Gamma]",
              "2"]}]], 
         RowBox[{"(", 
           RowBox[{
             SubscriptBox[
              StyleBox["H", "TI"], 
              RowBox[{
                StyleBox["i", "TI"], 
                StyleBox["k", "TI"]}]], 
             SubscriptBox[
              StyleBox["H", "TI"], 
              RowBox[{
                StyleBox["j", "TI"], 
                StyleBox["l", "TI"]}]], "-", 
             SubscriptBox[
              StyleBox["H", "TI"], 
              RowBox[{
                StyleBox["i", "TI"], 
                StyleBox["l", "TI"]}]], 
             SubscriptBox[
              StyleBox["H", "TI"], 
              RowBox[{
                StyleBox["j", "TI"], 
                StyleBox["k", "TI"]}]]}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "R_{ijkl} = b_{ik}\\, b_{jl} - b_{il}\\, b_{jk} = \\frac{\\xi}{1 + \
\\xi|l|_\\gamma^2}\\left(H_{ik} H_{jl} - H_{il} H_{jk}\\right)", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c263904a-75bd-47ca-80fb-5a49975b2279"],
 "For a 2D parameter space, the ",
 StyleBox["Gaussian curvature",
  FontWeight->Bold],
 " is: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["K", "TI"], "\[LongEqual]", 
         FractionBox[
          RowBox[{"\[Xi] ", "det", 
            RowBox[{"(", 
              StyleBox["H", "TI"], ")"}]}], 
          RowBox[{"det", 
            RowBox[{"(", "\[Gamma]", ")"}], " ", 
            SuperscriptBox[
             RowBox[{"(", 
               
               RowBox[{
                "1", "+", "\[Xi]", 
                 "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", 
                 StyleBox["l", "TI"], 
                 SubsuperscriptBox[
                 "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", 
                  "\[Gamma]", "2"]}], ")"}], "2"]}]]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "K = \\frac{\\xi\\, \\det(H)}{\\det(\\gamma)\\,(1 + \
\\xi|l|_\\gamma^2)^2}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0fb05da1-4222-4937-8cb4-8d4311b09924"],
 "This gives a direct ",
 StyleBox["curvature\[Dash]Hessian dictionary",
  FontWeight->Bold],
 ": "
}], "Text",ExpressionUUID->"0a540ca9-9d5c-41e1-80c9-b587e5a68b1a"],

Cell[TextData[{
 "$K > 0$ \[DoubleLongLeftRightArrow] ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"det", 
         RowBox[{"(", 
           StyleBox["H", "TI"], ")"}], ">", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\det(H) > 0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "2a730ee1-2b11-44cb-9c32-e28512f82731"],
 " \[DoubleLongLeftRightArrow] ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["H", "TI"], TraditionalForm], "errors" -> {}, "input" -> "H", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d0105c2b-52ad-4c2c-b488-e4af565a3ad8"],
 " is definite (both eigenvalues same sign) \[LongDash] ",
 StyleBox["bowl or dome",
  FontWeight->Bold]
}], "Item",ExpressionUUID->"21870ba2-af08-4ae1-bd28-66f1eb998b3e"],

Cell[TextData[{
 "$K < 0$ \[DoubleLongLeftRightArrow] ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"det", 
         RowBox[{"(", 
           StyleBox["H", "TI"], ")"}], "<", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\det(H) < 0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "1df01a39-ef89-47a5-b575-e204eef05786"],
 " \[DoubleLongLeftRightArrow] ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["H", "TI"], TraditionalForm], "errors" -> {}, "input" -> "H", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b9a189ae-4e85-48d0-a833-456faa175662"],
 " is indefinite \[LongDash] ",
 StyleBox["saddle point",
  FontWeight->Bold]
}], "Item",ExpressionUUID->"6aa9b988-0760-4127-8760-b2f4b93b7901"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["K", "TI"], "\[LongEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "K = 0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f1958ffb-6c77-4780-b567-aa1619bd3baf"],
 " \[DoubleLongLeftRightArrow] ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"det", 
         RowBox[{"(", 
           StyleBox["H", "TI"], ")"}], "\[LongEqual]", "0"}], 
       TraditionalForm], "errors" -> {}, "input" -> "\\det(H) = 0", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "41ff4102-fae3-4628-b9e3-d85c4d2b7b8c"],
 " \[DoubleLongLeftRightArrow] ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["H", "TI"], TraditionalForm], "errors" -> {}, "input" -> "H", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "40914a09-d6bd-40e5-9e22-bbbd30d18da0"],
 " is singular \[LongDash] ",
 StyleBox["ridge or valley",
  FontWeight->Bold]
}], "Item",ExpressionUUID->"bada19f2-1cdd-481d-9800-7d6c123396be"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"R1212", "=", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"bExplicit", "[", 
       RowBox[{"[", 
        RowBox[{"1", ",", "1"}], "]"}], "]"}], "*", 
      RowBox[{"bExplicit", "[", 
       RowBox[{"[", 
        RowBox[{"2", ",", "2"}], "]"}], "]"}]}], "-", 
     RowBox[{
      RowBox[{"bExplicit", "[", 
       RowBox[{"[", 
        RowBox[{"1", ",", "2"}], "]"}], "]"}], "^", "2"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"detH", "=", 
   RowBox[{
    RowBox[{"H11", "*", "H22"}], "-", 
    RowBox[{"H12", "^", "2"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"R1212formula", "=", 
   RowBox[{
    RowBox[{"xi", "*", 
     RowBox[{"detH", "/", 
      RowBox[{"(", 
       RowBox[{"1", "+", 
        RowBox[{"xi", "*", "normSq"}]}], ")"}]}]}], " ", "//", " ", 
    "Simplify"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{"R1212", "-", "R1212formula"}], ",", 
   RowBox[{"Assumptions", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"xi", ">", "0"}], ",", 
      RowBox[{"g1", ">", "0"}], ",", 
      RowBox[{"g2", ">", "0"}]}], "}"}]}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"0", " ", "\[LongDash]", " ", 
    RowBox[{"Gauss", " ", "equation", " ", "VERIFIED"}]}], " ", 
   "*)"}]}]}], "Input",ExpressionUUID->"6d93355a-534f-4baf-a466-d41924077cc9"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Gaussian", " ", "curvature"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"gMatrix", "=", 
     RowBox[{
      RowBox[{"DiagonalMatrix", "[", 
       RowBox[{"{", 
        RowBox[{"g1", ",", "g2"}], "}"}], "]"}], "+", 
      RowBox[{"xi", "*", 
       RowBox[{"Outer", "[", 
        RowBox[{"Times", ",", "l", ",", "l"}], "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"gaussK", "=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{
       RowBox[{"R1212", "/", 
        RowBox[{"Det", "[", "gMatrix", "]"}]}], ",", 
       RowBox[{"Assumptions", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"xi", ">", "0"}], ",", 
          RowBox[{"g1", ">", "0"}], ",", 
          RowBox[{"g2", ">", "0"}]}], "}"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Kformula", "=", 
     RowBox[{"xi", "*", 
      RowBox[{"detH", "/", 
       RowBox[{"(", 
        RowBox[{"g1", "*", "g2", "*", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", "+", 
            RowBox[{"xi", "*", "normSq"}]}], ")"}], "^", "2"}]}], ")"}]}]}]}],
     ";"}], "\[IndentingNewLine]", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{"gaussK", "-", "Kformula"}], ",", 
     RowBox[{"Assumptions", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"xi", ">", "0"}], ",", 
        RowBox[{"g1", ">", "0"}], ",", 
        RowBox[{"g2", ">", "0"}]}], "}"}]}]}], "]"}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"0", " ", "\[LongDash]", " ", 
     RowBox[{
     "Gaussian", " ", "curvature", " ", "formula", " ", "VERIFIED"}]}], " ", 
    "*)"}]}]}]], "Input",ExpressionUUID->"356d36ba-3aaa-4881-a9d9-\
40a1df1b4b98"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Ricci", " ", "tensor", " ", "and", " ", "scalar", " ", "curvature"}], " ",
    "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"For", " ", "a", " ", "2", "D", " ", 
     RowBox[{"surface", ":", " ", 
      RowBox[{"R_", 
       RowBox[{"{", "ij", "}"}]}]}]}], " ", "=", " ", 
    RowBox[{
     RowBox[{"K", " ", "g_", 
      RowBox[{"{", "ij", "}"}], " ", "and", " ", "R"}], " ", "=", " ", 
     RowBox[{"2", "K"}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"gInvMatrix", "=", 
     RowBox[{
      RowBox[{"Inverse", "[", "gMatrix", "]"}], " ", "//", " ", 
      "Simplify"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"riemann", "=", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"bExplicit", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", "k"}], "]"}], "]"}], "*", 
          RowBox[{"bExplicit", "[", 
           RowBox[{"[", 
            RowBox[{"j", ",", "ll"}], "]"}], "]"}]}], "-", 
         RowBox[{
          RowBox[{"bExplicit", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", "ll"}], "]"}], "]"}], "*", 
          RowBox[{"bExplicit", "[", 
           RowBox[{"[", 
            RowBox[{"j", ",", "k"}], "]"}], "]"}]}]}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", "2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"k", ",", "2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"ll", ",", "2"}], "}"}]}], "]"}], " ", "//", " ", 
      "FullSimplify"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ricciTensor", "=", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"gInvMatrix", "[", 
            RowBox[{"[", 
             RowBox[{"k", ",", "ll"}], "]"}], "]"}], "*", 
           RowBox[{"riemann", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", "k", ",", "j", ",", "ll"}], "]"}], "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"k", ",", "2"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"ll", ",", "2"}], "}"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", "2"}], "}"}]}], "]"}], " ", "//", " ", 
      "FullSimplify"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"scalarCurv", "=", 
     RowBox[{
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"gInvMatrix", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "j"}], "]"}], "]"}], "*", 
         RowBox[{"ricciTensor", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "j"}], "]"}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", "2"}], "}"}]}], "]"}], " ", "//", " ", 
      "FullSimplify"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"Verify", " ", "R_", 
      RowBox[{"{", "ij", "}"}]}], " ", "=", " ", 
     RowBox[{"K", " ", "g_", 
      RowBox[{"{", "ij", "}"}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{"ricciTensor", "-", 
      RowBox[{"gaussK", "*", "gMatrix"}]}], ",", 
     RowBox[{"Assumptions", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"xi", ">", "0"}], ",", 
        RowBox[{"g1", ">", "0"}], ",", 
        RowBox[{"g2", ">", "0"}]}], "}"}]}]}], "]"}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "0"}], "}"}]}], "}"}], " ", "\[LongDash]", " ",
      "VERIFIED"}], " ", "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"Verify", " ", "R"}], " ", "=", " ", 
     RowBox[{"2", "K"}]}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{"scalarCurv", "-", 
      RowBox[{"2", "*", "gaussK"}]}], ",", 
     RowBox[{"Assumptions", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"xi", ">", "0"}], ",", 
        RowBox[{"g1", ">", "0"}], ",", 
        RowBox[{"g2", ">", "0"}]}], "}"}]}]}], "]"}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"0", " ", "\[LongDash]", " ", "VERIFIED"}], " ", 
    "*)"}]}]}]], "Input",ExpressionUUID->"31cf957c-5c9f-4589-817b-\
563999dbcc01"],

