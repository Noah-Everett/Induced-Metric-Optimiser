Cell["7. The Off-Diagonal Metric", "Section",ExpressionUUID->"fa7b5583-429b-4fb7-9d43-c597956b69f6"],

Cell["Can a richer metric do better?", "Subsection",ExpressionUUID->"c39ed8a1-ed94-4678-b14f-fa062d0ac25d"],

Cell[TextData[{
 "The project also uses an off-diagonal metric with coupling vectors $a, b$: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["g", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"]}]], "\[LongEqual]", 
         SubscriptBox["\[Gamma]", 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"]}]], "+", "\[Xi]", 
         RowBox[{"(", 
           RowBox[{
             SubscriptBox[
              StyleBox["a", "TI"], 
              StyleBox["i", "TI"]], 
             SubscriptBox[
              StyleBox["l", "TI"], 
              StyleBox["j", "TI"]], "+", 
             SubscriptBox[
              StyleBox["b", "TI"], 
              StyleBox["j", "TI"]], 
             SubscriptBox[
              StyleBox["l", "TI"], 
              StyleBox["i", "TI"]], "+", 
             SubscriptBox[
              StyleBox["l", "TI"], 
              StyleBox["i", "TI"]], 
             SubscriptBox[
              StyleBox["l", "TI"], 
              StyleBox["j", "TI"]]}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "g_{ij} = \\gamma_{ij} + \\xi(a_i l_j + b_j l_i + l_i l_j)", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "765635f8-1b6a-4fb8-bb53-4b28b6415e43"],
 "The Christoffel bracket for this metric (with $a, b$ constant) is: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[PartialD]", 
          StyleBox["i", "TI"]], 
         SubscriptBox[
          StyleBox["g", "TI"], 
          RowBox[{
            StyleBox["j", "TI"], 
            StyleBox["l", "TI"]}]], "+", 
         SubscriptBox["\[PartialD]", 
          StyleBox["j", "TI"]], 
         SubscriptBox[
          StyleBox["g", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["l", "TI"]}]], "-", 
         SubscriptBox["\[PartialD]", 
          StyleBox["l", "TI"]], 
         SubscriptBox[
          StyleBox["g", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"]}]], "\[LongEqual]", "\[Xi]", 
         RowBox[{"[", 
           RowBox[{
             RowBox[{"(", 
               RowBox[{
                 SubscriptBox[
                  StyleBox["a", "TI"], 
                  StyleBox["j", "TI"]], "-", 
                 SubscriptBox[
                  StyleBox["b", "TI"], 
                  StyleBox["j", "TI"]]}], ")"}], 
             SubscriptBox[
              StyleBox["H", "TI"], 
              RowBox[{
                StyleBox["i", "TI"], 
                StyleBox["l", "TI"]}]], "+", "2", 
             RowBox[{"(", 
               RowBox[{
                 SubscriptBox[
                  StyleBox["b", "TI"], 
                  StyleBox["l", "TI"]], "+", 
                 SubscriptBox[
                  StyleBox["l", "TI"], 
                  StyleBox["l", "TI"]]}], ")"}], 
             SubscriptBox[
              StyleBox["H", "TI"], 
              RowBox[{
                StyleBox["i", "TI"], 
                StyleBox["j", "TI"]}]]}], "]"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\partial_i g_{jl} + \\partial_j g_{il} - \\partial_l g_{ij} = \
\\xi\\left[(a_j - b_j) H_{il} + 2(b_l + l_l) H_{ij}\\right]", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "1d1a9d23-f3fd-41f6-818e-29ae945e49f5"],
 "When ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["a", "TI"], "\[NotEqual]", 
         StyleBox["b", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "a \\neq b", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5da179c2-1f2c-4697-b151-62114b4d7db0"],
 ", the bracket is ",
 StyleBox["not",
  FontWeight->Bold],
 " proportional to $H_{ij}$ \[LongDash] the extra term ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         RowBox[{"(", 
           RowBox[{
             SubscriptBox[
              StyleBox["a", "TI"], 
              StyleBox["j", "TI"]], "-", 
             SubscriptBox[
              StyleBox["b", "TI"], 
              StyleBox["j", "TI"]]}], ")"}], 
         SubscriptBox[
          StyleBox["H", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["l", "TI"]}]]}], TraditionalForm], "errors" -> {}, 
     "input" -> "(a_j - b_j) H_{il}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c75424a6-8c96-4cdf-acee-521f0ec03ae0"],
 " mixes different Hessian directions. This could in principle change the \
eigenvalue structure. "
}], "Text",ExpressionUUID->"50c5ec94-6369-497c-b220-b04a3671003c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"aa", "=", 
   RowBox[{"{", 
    RowBox[{"a1", ",", "a2"}], "}"}]}], ";", " ", 
  RowBox[{"bb", "=", 
   RowBox[{"{", 
    RowBox[{"b1", ",", "b2"}], "}"}]}], ";", " ", 
  RowBox[{"ll", "=", 
   RowBox[{"{", 
    RowBox[{"l1", ",", "l2"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"hh", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"H11", ",", "H12"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"H12", ",", "H22"}], "}"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"xxi", "=", 
   RowBox[{"Symbol", "[", "\"\<xxi\>\"", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"gam", "=", 
    RowBox[{"DiagonalMatrix", "[", 
     RowBox[{"{", 
      RowBox[{"ga", ",", "gb"}], "}"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"gOD", "=", 
   RowBox[{"gam", "+", 
    RowBox[{"xxi", "*", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Outer", "[", 
        RowBox[{"Times", ",", "aa", ",", "ll"}], "]"}], "+", 
       RowBox[{"Outer", "[", 
        RowBox[{"Times", ",", "ll", ",", "bb"}], "]"}], "+", 
       RowBox[{"Outer", "[", 
        RowBox[{"Times", ",", "ll", ",", "ll"}], "]"}]}], ")"}]}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dgOD", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"xxi", "*", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"aa", "[", 
            RowBox[{"[", "i", "]"}], "]"}], "+", 
           RowBox[{"ll", "[", 
            RowBox[{"[", "i", "]"}], "]"}]}], ")"}], "*", 
         RowBox[{"hh", "[", 
          RowBox[{"[", 
           RowBox[{"k", ",", "j"}], "]"}], "]"}]}], "+", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"bb", "[", 
            RowBox[{"[", "j", "]"}], "]"}], "+", 
           RowBox[{"ll", "[", 
            RowBox[{"[", "j", "]"}], "]"}]}], ")"}], "*", 
         RowBox[{"hh", "[", 
          RowBox[{"[", 
           RowBox[{"k", ",", "i"}], "]"}], "]"}]}]}], ")"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"k", ",", "2"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "2"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "2"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"bracketOD", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"dgOD", "[", 
       RowBox[{"[", 
        RowBox[{"i", ",", "j", ",", "el"}], "]"}], "]"}], "+", 
      RowBox[{"dgOD", "[", 
       RowBox[{"[", 
        RowBox[{"j", ",", "i", ",", "el"}], "]"}], "]"}], "-", 
      RowBox[{"dgOD", "[", 
       RowBox[{"[", 
        RowBox[{"el", ",", "i", ",", "j"}], "]"}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "2"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "2"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"el", ",", "2"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"bracketODexpected", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"xxi", "*", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"aa", "[", 
            RowBox[{"[", "j", "]"}], "]"}], "-", 
           RowBox[{"bb", "[", 
            RowBox[{"[", "j", "]"}], "]"}]}], ")"}], "*", 
         RowBox[{"hh", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "el"}], "]"}], "]"}]}], "+", 
        RowBox[{"2", "*", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"bb", "[", 
            RowBox[{"[", "el", "]"}], "]"}], "+", 
           RowBox[{"ll", "[", 
            RowBox[{"[", "el", "]"}], "]"}]}], ")"}], "*", 
         RowBox[{"hh", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "j"}], "]"}], "]"}]}]}], ")"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "2"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "2"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"el", ",", "2"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Simplify", "[", 
  RowBox[{"bracketOD", "-", "bracketODexpected"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"All", " ", "zeros"}], " ", "\[LongDash]", " ", 
    RowBox[{"bracket", " ", "formula", " ", "VERIFIED"}]}], " ", 
   "*)"}]}]}], "Input",ExpressionUUID->"ac36a0b0-8ca2-4c95-928a-661f3acc3ef4"],

Cell["But there's a catch", "Subsection",ExpressionUUID->"ea13c1d4-6b21-4cdf-bac9-e24b4d4c22d4"],

Cell[TextData[{
 "When ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["a", "TI"], "\[LongEqual]", 
         StyleBox["b", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "a = b", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "353b3454-a705-486b-820c-9ab74229723b"],
 " (symmetric coupling), the ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"(", 
         RowBox[{
           SubscriptBox[
            StyleBox["a", "TI"], 
            StyleBox["j", "TI"]], "-", 
           SubscriptBox[
            StyleBox["b", "TI"], 
            StyleBox["j", "TI"]]}], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "(a_j - b_j)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "bcece301-e056-4e56-8607-ddeb33711e44"],
 " term vanishes and we're back to proportionality with $H_{ij}$. The \
Riemannian Hessian is still a scalar multiple of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["H", "TI"], TraditionalForm], "errors" -> {}, "input" -> "H", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0854caae-04a0-497f-9787-02269392ebfe"],
 " \[LongDash] no eigenvalue sign change."
}], "Text",ExpressionUUID->"97006731-e127-4af5-bc1c-41e25dafbdd7"],

Cell[TextData[{
 "When ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["a", "TI"], "\[NotEqual]", 
         StyleBox["b", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "a \\neq b", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "df2719e1-efed-4ec8-9a3c-67aa08ae0811"],
 ", the metric ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["g", "TI"], TraditionalForm], "errors" -> {}, "input" -> "g", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "4ea4f070-cd7b-4d50-9f60-903ad8564a1e"],
 " is ",
 StyleBox["not symmetric",
  FontWeight->Bold],
 " (",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["g", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"]}]], "\[NotEqual]", 
         SubscriptBox[
          StyleBox["g", "TI"], 
          RowBox[{
            StyleBox["j", "TI"], 
            StyleBox["i", "TI"]}]]}], TraditionalForm], "errors" -> {}, 
     "input" -> "g_{ij} \\neq g_{ji}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "030ea911-9052-4d24-9107-203cbf499b64"],
 "), which means it's not a proper Riemannian metric. A scan over thousands \
of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"(", 
         RowBox[{
           StyleBox["a", "TI"], ",", 
           StyleBox["b", "TI"], ",", 
           StyleBox["l", "TI"], ",", "\[Xi]"}], ")"}], TraditionalForm], 
     "errors" -> {}, "input" -> "(a, b, l, \\xi)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "3b90de0c-a85f-44be-aa18-d8000e34ca63"],
 " configurations confirmed: "
}], "Text",ExpressionUUID->"38d8f66c-3e33-4be2-a8e0-0d93467008e0"],

Cell[TextData[{
 StyleBox["Symmetric",
  FontWeight->Bold],
 " (",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["a", "TI"], "\[LongEqual]", 
         StyleBox["b", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "a = b", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b74a7aa7-6b00-4c13-b49e-eb3bdd0ba799"],
 "): ",
 StyleBox["0 cases",
  FontWeight->Bold],
 " where a saddle became convex"
}], "Item",ExpressionUUID->"e4841525-fbda-49be-a87e-2f42df2a328d"],

Cell[TextData[{
 StyleBox["Asymmetric",
  FontWeight->Bold],
 " (",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["a", "TI"], "\[NotEqual]", 
         StyleBox["b", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "a \\neq b", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "24976bd6-69f0-413d-a61e-f64905bcb3f9"],
 "): some cases flip eigenvalue signs, but the metric is non-Riemannian"
}], "Item",ExpressionUUID->"48496e2a-b039-4589-9149-dcef1ee609c8"],

Cell[TextData[{
 StyleBox["Conclusion:",
  FontWeight->Bold],
 " Within the framework of Riemannian geometry (symmetric metrics), the \
induced metric family cannot convert non-convex to geodesically convex. "
}], "Text",ExpressionUUID->"e4cc9ffe-0af2-4291-936f-f8d2e4470293"],

