}], "Item",ExpressionUUID->"2637277c-2a76-4931-990b-f6662af72dc1"],

Cell[TextData[{
 StyleBox["Sign structure is identical:",
  FontWeight->Bold],
 " ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["Hess", 
          StyleBox["g", "TI"]], " ", 
         StyleBox["L", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\text{Hess}_g\\, L", "state" -> "Boxes"|>,
