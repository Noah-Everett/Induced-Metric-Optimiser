Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Unit", " ", "normal"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"normSq", "=", 
