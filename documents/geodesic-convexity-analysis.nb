 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"eec17ff8-f57b-43d7-85ed-fa0ff831c91e"],

Cell["1. Background: The Induced Metric", "Section",ExpressionUUID->"2261c675-76d8-4dd8-818d-afdbf855813e"],

Cell["The geometric idea", "Subsection",ExpressionUUID->"8e8e18a4-99aa-400b-a02b-f649c3f4649f"],

Cell[TextData[{
 "We have ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["N", "TI"], TraditionalForm], "errors" -> {}, "input" -> "N", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0ab64144-0658-4089-85ce-28fb59b6c525"],
 " parameters ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Theta]", "\[LongEqual]", 
         RowBox[{"(", 
           RowBox[{
             SuperscriptBox["\[Theta]", "1"], ",", "\[Ellipsis]", ",", 
             SuperscriptBox["\[Theta]", 
              StyleBox["N", "TI"]]}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\theta = (\\theta^1, \\ldots, \\theta^N)", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "88ff448c-339a-46cd-b6c3-2226ca9a0d10"],
 " and a loss function ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["L", "TI"], "(", "\[Theta]", ")"}], TraditionalForm], 
     "errors" -> {}, "input" -> "L(\\theta)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "4a78e12e-805d-4e35-83a4-bb68f84871c5"],
 ". The optimiser embeds parameter space into one higher dimension: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[CurlyPhi]", 
         RowBox[{"(", "\[Theta]", ")"}], "\[LongEqual]", 
         RowBox[{"(", 
           RowBox[{
             SuperscriptBox["\[Theta]", "1"], ",", "\[Ellipsis]", ",", 
             SuperscriptBox["\[Theta]", 
              StyleBox["N", "TI"]], ",", 
             StyleBox["L", "TI"], 
             RowBox[{"(", "\[Theta]", ")"}]}], ")"}], "\[Element]", 
         SuperscriptBox[
          StyleBox["R", FontSlant -> "Plain"], 
          RowBox[{
            StyleBox["N", "TI"], "+", "1"}]]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\varphi(\\theta) = (\\theta^1, \\ldots, \\theta^N, L(\\theta)) \\in \
\\mathbb{R}^{N+1}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f761db96-1de4-45c6-866e-6c6619a163d6"],
 "This turns the loss landscape into a literal surface sitting inside ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox[
        StyleBox["R", FontSlant -> "Plain"], 
        RowBox[{
          StyleBox["N", "TI"], "+", "1"}]], TraditionalForm], "errors" -> {}, 
     "input" -> "\\mathbb{R}^{N+1}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "7efbba20-8016-4f66-923e-53655fd7523c"],
 ". The ambient space carries a metric ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["h", "TI"], "\[LongEqual]", 
         StyleBox["diag", FontSlant -> "Plain"], 
         RowBox[{"(", 
           RowBox[{
             SubscriptBox["\[Gamma]", "1"], ",", "\[Ellipsis]", ",", 
             SubscriptBox["\[Gamma]", 
              StyleBox["N", "TI"]], ",", "\[Xi]"}], ")"}]}], TraditionalForm],
      "errors" -> {}, "input" -> 
     "h = \\mathrm{diag}(\\gamma_1, \\ldots, \\gamma_N, \\xi)", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "dc86fcb3-a6a1-4925-abe8-002f04389a68"],
 " which, when \"pulled back\" onto the surface, gives the ",
 StyleBox["induced metric",
  FontWeight->Bold],
 ": ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["g", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"]}]], "\[LongEqual]", 
         SubscriptBox["\[Gamma]", 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"]}]], "+", "\[Xi] ", 
         SubscriptBox[
          StyleBox["l", "TI"], 
          StyleBox["i", "TI"]], " ", 
         SubscriptBox[
          StyleBox["l", "TI"], 
          StyleBox["j", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "g_{ij} = \\gamma_{ij} + \\xi\\, l_i\\, l_j", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "707ba75e-be36-4a28-a46f-a690bc0ee30d"],
 "where ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["l", "TI"], 
          StyleBox["i", "TI"]], "\[LongEqual]", "\[PartialD]", 
         StyleBox["L", "TI"], "/", "\[PartialD]", 
         SuperscriptBox["\[Theta]", 
          StyleBox["i", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "l_i = \\partial L / \\partial \\theta^i", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "4565c956-ff3b-4338-8776-b0bd4d6ee574"],
 " is the loss gradient and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Gamma]", 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"]}]], "\[LongEqual]", 
         StyleBox["diag", FontSlant -> "Plain"], 
         RowBox[{"(", 
           RowBox[{
             SubscriptBox["\[Gamma]", "1"], ",", "\[Ellipsis]", ",", 
             SubscriptBox["\[Gamma]", 
              StyleBox["N", "TI"]]}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\gamma_{ij} = \\mathrm{diag}(\\gamma_1, \\ldots, \\gamma_N)", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "dda86547-e6b9-4282-b191-0c7afd76b4fb"],
 " is a constant base metric."
}], "Text",ExpressionUUID->"7a9f49d5-190f-4081-8d53-2885e0d94c03"],

Cell[TextData[{
 "This is a ",
 StyleBox["rank-1 perturbation",
  FontWeight->Bold],
 " of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Gamma]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\gamma", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "2f158099-0ddd-4417-a8bd-e9a4ebf255a6"],
 ": the gradient vector ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["l", "TI"], TraditionalForm], "errors" -> {}, "input" -> "l", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c3fc2d74-5701-41bd-8149-7dc95e65efa0"],
 " \"stretches\" the metric in its own direction. The parameter ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Xi]", ">", "0"}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\xi > 0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "67197a6b-ed1f-4285-9f34-a3c4077ba19c"],
 " controls how much. "
}], "Text",ExpressionUUID->"5faf3e43-7794-4bb9-ba1c-7345219fcccc"],

Cell["Why geodesic convexity matters", "Subsection",ExpressionUUID->"da4b1778-22a6-489a-b61b-c007e3d3011a"],

Cell[TextData[{
 "A function is ",
 StyleBox["geodesically convex",
  FontWeight->Bold],
 " with respect to a metric ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["g", "TI"], TraditionalForm], "errors" -> {}, "input" -> "g", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5133e92d-304a-4608-a111-853315294338"],
 " if its ",
 StyleBox["Riemannian Hessian",
  FontWeight->Bold],
 " ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["Hess", FontSlant -> "Plain"], 
          StyleBox["g", "TI"]], 
         StyleBox["L", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\mathrm{Hess}_g L", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d1b838d4-caa9-471e-b0a2-e9a5b169d989"],
 " is positive semi-definite (PSD). If ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["L", "TI"], TraditionalForm], "errors" -> {}, "input" -> "L", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f0d754c8-b927-4f18-8c7e-9499022bccdb"],
 " is geodesically convex w.r.t. ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["g", "TI"], TraditionalForm], "errors" -> {}, "input" -> "g", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ca2b2c20-7f3c-4af4-beef-f53454762749"],
 ", then Riemannian gradient descent ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox["\[Delta]\[Theta]", 
          StyleBox["i", "TI"]], "\[LongEqual]", "-", "\[Eta] ", 
         SuperscriptBox[
          StyleBox["g", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"]}]], 
         SubscriptBox[
          StyleBox["l", "TI"], 
          StyleBox["j", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\delta\\theta^i = -\\eta\\, g^{ij} l_j", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "21416bf0-620b-469a-8d68-93e6229a817e"],
 " is guaranteed to converge to a global minimum \[LongDash] even if ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["L", "TI"], TraditionalForm], "errors" -> {}, "input" -> "L", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5aacaf4b-7a15-4645-8bb7-51046555c7a0"],
 " is non-convex in the ordinary Euclidean sense."
}], "Text",ExpressionUUID->"2a93caaf-d15b-4447-a32e-ebf51a9e08ed"],

Cell[TextData[{
 "The Riemannian Hessian is: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          RowBox[{"(", 
            RowBox[{
              SubscriptBox[
               StyleBox["Hess", FontSlant -> "Plain"], 
               StyleBox["g", "TI"]], 
              StyleBox["L", "TI"]}], ")"}], 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"]}]], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["H", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"]}]], "-", 
         SubsuperscriptBox["\[CapitalGamma]", 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"]}], 
          StyleBox["k", "TI"]], " ", 
         SubscriptBox[
          StyleBox["l", "TI"], 
          StyleBox["k", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "(\\mathrm{Hess}_g L)_{ij} = H_{ij} - \\Gamma^k_{ij}\\, l_k", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "60ec700f-cf68-4193-8b1b-89725a546b83"],
 "where ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["H", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"]}]], "\[LongEqual]", 
         SuperscriptBox["\[PartialD]", "2"], 
         StyleBox["L", "TI"], "/", "\[PartialD]", 
         SuperscriptBox["\[Theta]", 
          StyleBox["i", "TI"]], "\[PartialD]", 
         SuperscriptBox["\[Theta]", 
          StyleBox["j", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "H_{ij} = \\partial^2 L / \\partial\\theta^i \\partial\\theta^j", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "541c5a10-f987-4ef6-9165-ec764dccd556"],
 " is the ordinary Hessian and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubsuperscriptBox["\[CapitalGamma]", 
        RowBox[{
          StyleBox["i", "TI"], 
          StyleBox["j", "TI"]}], 
        StyleBox["k", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\Gamma^k_{ij}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "695aa1b0-c9ac-4455-95b1-c24685425094"],
 " are the ",
 StyleBox["Christoffel symbols",
  FontWeight->Bold],
 " of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["g", "TI"], TraditionalForm], "errors" -> {}, "input" -> "g", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "812b8cbf-4d6c-4f29-b683-68665babb259"],
 " (encoding the curvature of the metric). The correction term ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubsuperscriptBox["\[CapitalGamma]", 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"]}], 
          StyleBox["k", "TI"]], 
         SubscriptBox[
          StyleBox["l", "TI"], 
          StyleBox["k", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\Gamma^k_{ij} l_k", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "af46d0e6-f2a6-4db3-8e90-6305f4c2611b"],
 " is what the metric \"subtracts\" from the Euclidean Hessian. If this \
subtraction removes negative eigenvalues, the metric has made the landscape \
geodesically convex. "
}], "Text",ExpressionUUID->"4ef634d7-1d19-409f-bee0-fd58154e1f02"],

Cell["The inverse metric (Sherman\[Dash]Morrison)", "Subsection",ExpressionUUID->"4e362e20-b6c4-42fe-94b9-5c4ecc01e041"],

Cell[TextData[{
 "Since ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["g", "TI"], "\[LongEqual]", "\[Gamma]", "+", "\[Xi] ", 
         StyleBox["l", "TI"], "\[CircleTimes]", 
         StyleBox["l", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "g = \\gamma + \\xi\\, l \\otimes l", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "6cf28400-7dbe-491c-bc59-ee628c0e4e6b"],
 " is a rank-1 update of the diagonal matrix ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Gamma]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\gamma", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "bdba3ba8-8fb5-4f21-ae91-9a6b87d548f0"],
 ", its inverse follows from the Sherman\[Dash]Morrison formula: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["g", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"]}]], "\[LongEqual]", 
         SuperscriptBox["\[Gamma]", 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"]}]], "-", 
         FractionBox[
          RowBox[{"\[Xi] ", 
            SuperscriptBox[
             StyleBox["l", "TI"], 
             StyleBox["i", "TI"]], " ", 
            SuperscriptBox[
             StyleBox["l", "TI"], 
             StyleBox["j", "TI"]]}], 
          
          RowBox[{"1", "+", "\[Xi] ", 
            "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", 
            StyleBox["l", "TI"], 
            SubsuperscriptBox[
            "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", "\[Gamma]",
              "2"]}]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "g^{ij} = \\gamma^{ij} - \\frac{\\xi\\, l^i\\, l^j}{1 + \\xi\\, \
|l|_\\gamma^2}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "772f877a-6254-4ae4-9e41-5112f73ff1f2"],
 "where ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["l", "TI"], 
          StyleBox["i", "TI"]], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["l", "TI"], 
          StyleBox["i", "TI"]], "/", 
         SubscriptBox["\[Gamma]", 
          StyleBox["i", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "l^i = l_i / \\gamma_i", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "28c7d809-b2d3-4496-804e-0a5edb5dde0f"],
 " is the \"raised\" gradient and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", 
         StyleBox["l", "TI"], 
         SubsuperscriptBox[
         "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", "\[Gamma]", 
          "2"], "\[LongEqual]", 
         UnderscriptBox["\[Sum]", 
          StyleBox["k", "TI"], LimitsPositioning -> True], 
         SubsuperscriptBox[
          StyleBox["l", "TI"], 
          StyleBox["k", "TI"], "2"], "/", 
         SubscriptBox["\[Gamma]", 
          StyleBox["k", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "|l|_\\gamma^2 = \\sum_k l_k^2 / \\gamma_k", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5df65e48-f488-43bf-b184-eecf34ee1c40"],
 ". "
}], "Text",ExpressionUUID->"139b7fb8-ba44-463e-8a67-770b09984081"],

Cell["Setup code", "Subsection",ExpressionUUID->"09d8336f-7194-4ccc-9c7a-529ebab9b92b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"l", "=", 
   RowBox[{"{", 
    RowBox[{"l1", ",", "l2"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"hess", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"H11", ",", "H12"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"H12", ",", "H22"}], "}"}]}], "}"}]}], ";"}], "  ", 
  RowBox[{"(*", " ", 
   RowBox[{"Symmetric", " ", "Hessian", " ", "of", " ", "L"}], " ", 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"gam", "=", 
    RowBox[{"DiagonalMatrix", "[", 
     RowBox[{"{", 
      RowBox[{"g1", ",", "g2"}], "}"}], "]"}]}], ";"}], "   ", 
  RowBox[{"(*", " ", 
   RowBox[{"Diagonal", " ", "base", " ", "metric"}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"xi", "=", 
    RowBox[{"Symbol", "[", "\"\<xi\>\"", "]"}]}], ";"}], "                 ", 
  
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Embedding", " ", "weight"}], ",", " ", 
    RowBox[{"xi", " ", ">", " ", "0"}]}], " ", "*)"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Induced", " ", 
     RowBox[{"metric", ":", " ", "g"}]}], " ", "=", " ", 
    RowBox[{"\[Gamma]", " ", "+", " ", 
     RowBox[{"\[Xi]", " ", 
      RowBox[{"l", "\[CircleTimes]", "l"}]}]}]}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"g", "=", 
    RowBox[{"gam", "+", 
     RowBox[{"xi", "*", 
      RowBox[{"Outer", "[", 
       RowBox[{"Times", ",", "l", ",", "l"}], "]"}]}]}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Inverse", " ", "metric", " ", "via", " ", "Sherman"}], "-", 
    "Morrison"}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"gamInv", "=", 
   RowBox[{"DiagonalMatrix", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"1", "/", "g1"}], ",", 
      RowBox[{"1", "/", "g2"}]}], "}"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"lUp", "=", 
    RowBox[{"gamInv", " ", ".", " ", "l"}]}], ";"}], "                  ", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Raised", " ", 
     RowBox[{"gradient", ":", " ", 
      RowBox[{"l", "^", "i"}]}]}], " ", "=", " ", 
    RowBox[{"l_i", "/", "\[Gamma]_i"}]}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"normSq", "=", 
    RowBox[{"l", " ", ".", " ", "gamInv", " ", ".", " ", "l"}]}], ";"}], 
  "          ", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"||", "l", "||", "\.b2_\[Gamma]"}], " ", "=", " ", 
    RowBox[{"\[CapitalSigma]", " ", 
     RowBox[{"l_i\.b2", "/", "\[Gamma]_i"}]}]}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"gInv", "=", 
   RowBox[{
    RowBox[{"gamInv", "-", 
     RowBox[{"xi", "*", 
      RowBox[{
       RowBox[{"Outer", "[", 
        RowBox[{"Times", ",", "lUp", ",", "lUp"}], "]"}], "/", 
       RowBox[{"(", 
        RowBox[{"1", "+", 
         RowBox[{"xi", "*", "normSq"}]}], ")"}]}]}]}], " ", "//", " ", 
    "Simplify"}]}], ";"}]}], "Input",ExpressionUUID->"3d0b17b7-041b-400d-8ac5-\
8204ec524ccb"],

Cell[TextData[{
 "Verify the inverse is correct: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["g", "TI"], "\[CenterDot]", 
         SuperscriptBox[
          StyleBox["g", "TI"], "-1"], "\[LongEqual]", 
         StyleBox["I", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "g \\cdot g^{-1} = I", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f6fc540e-e8f8-4472-bc92-03fca379fc5e"]
}], "Text",ExpressionUUID->"88b69a1e-a336-4c94-86c1-b7f0b681c8a9"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Simplify", "[", 
   RowBox[{"g", " ", ".", " ", "gInv"}], "]"}], "==", 
  RowBox[{"IdentityMatrix", "[", "2", "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"(*", " ", "True", " ", "*)"}]}]}], "Input",ExpressionUUID->\
"467cd21d-b41d-4b06-ab7e-aa60ef78b275"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"785de7f5-8c1f-4558-8b49-9574e8958ca4"],

Cell["2. Christoffel Symbols", "Section",ExpressionUUID->"f2df856f-846d-47b5-9c5e-f23cb17f07ca"],

Cell["What are Christoffel symbols?", "Subsection",ExpressionUUID->"763faecb-a312-4254-b271-4ee25a5d997a"],

Cell[TextData[{
 "The Christoffel symbols ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubsuperscriptBox["\[CapitalGamma]", 
        RowBox[{
          StyleBox["i", "TI"], 
          StyleBox["j", "TI"]}], 
        StyleBox["k", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\Gamma^k_{ij}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "50f97ce6-fd42-40c6-bfec-20ea09ecc918"],
 " tell you how the coordinate basis vectors change as you move across the \
surface. They appear in the formula for parallel transport, geodesics, and \
the Riemannian Hessian. For a metric ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["g", "TI"], TraditionalForm], "errors" -> {}, "input" -> "g", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "08a200f2-feea-4a41-be16-d66e7e2f0eb0"],
 ": ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubsuperscriptBox["\[CapitalGamma]", 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"]}], 
          StyleBox["k", "TI"]], "\[LongEqual]", 
         FractionBox["1", "2"], " ", 
         SuperscriptBox[
          StyleBox["g", "TI"], 
          RowBox[{
            StyleBox["k", "TI"], 
            StyleBox["l", "TI"]}]], 
         RowBox[{"(", 
           RowBox[{
             SubscriptBox["\[PartialD]", 
              StyleBox["i", "TI"]], 
             SubscriptBox[
              StyleBox["g", "TI"], 
              RowBox[{
                StyleBox["j", "TI"], 
                StyleBox["l", "TI"]}]], "+", 
             SubscriptBox["\[PartialD]", 
              StyleBox["j", "TI"]], 
             SubscriptBox[
              StyleBox["g", "TI"], 
              RowBox[{
                StyleBox["i", "TI"], 
                StyleBox["l", "TI"]}]], "-", 
             SubscriptBox["\[PartialD]", 
              StyleBox["l", "TI"]], 
             SubscriptBox[
              StyleBox["g", "TI"], 
              RowBox[{
                StyleBox["i", "TI"], 
                StyleBox["j", "TI"]}]]}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\Gamma^k_{ij} = \\frac{1}{2}\\, g^{kl}\\left(\\partial_i g_{jl} + \
\\partial_j g_{il} - \\partial_l g_{ij}\\right)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "6fa11934-66c0-4477-9477-59a5225917e7"]
}], "Text",ExpressionUUID->"122f704d-e487-47fc-b844-fd84f0dbd71b"],

Cell["Step 1: Metric derivatives", "Subsection",ExpressionUUID->"c592358d-b2c9-4cff-8b3e-1f931eaae186"],

Cell[TextData[{
 "Since ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Gamma]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\gamma", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c362f0fb-af3d-437c-b853-89af871699f8"],
 " is constant (doesn't depend on ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Theta]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\theta", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "00db853c-cf16-4962-8666-44504d5eac02"],
 "), the only ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Theta]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\theta", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "2074a847-86e3-4a60-bc14-edc7b1e81f94"],
 "-dependence in ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["g", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"]}]], "\[LongEqual]", 
         SubscriptBox["\[Gamma]", 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"]}]], "+", "\[Xi]", 
         SubscriptBox[
          StyleBox["l", "TI"], 
          StyleBox["i", "TI"]], 
         SubscriptBox[
          StyleBox["l", "TI"], 
          StyleBox["j", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "g_{ij} = \\gamma_{ij} + \\xi l_i l_j", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "39279383-cfcf-4324-8a11-bd83caa90bef"],
 " comes from the gradient $l_i$. Using the product rule and the fact that ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[PartialD]", 
          StyleBox["k", "TI"]], 
         SubscriptBox[
          StyleBox["l", "TI"], 
          StyleBox["i", "TI"]], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["H", "TI"], 
          RowBox[{
            StyleBox["k", "TI"], 
            StyleBox["i", "TI"]}]]}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\partial_k l_i = H_{ki}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "15d6db84-e597-40f0-9e63-77ec4e680b9d"],
 " (the Hessian): ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[PartialD]", 
          StyleBox["k", "TI"]], 
         SubscriptBox[
          StyleBox["g", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"]}]], "\[LongEqual]", "\[Xi]", 
         RowBox[{"(", 
           RowBox[{
             SubscriptBox[
              StyleBox["H", "TI"], 
              RowBox[{
                StyleBox["k", "TI"], 
                StyleBox["i", "TI"]}]], " ", 
             SubscriptBox[
              StyleBox["l", "TI"], 
              StyleBox["j", "TI"]], "+", 
             SubscriptBox[
              StyleBox["l", "TI"], 
              StyleBox["i", "TI"]], " ", 
             SubscriptBox[
              StyleBox["H", "TI"], 
              RowBox[{
                StyleBox["k", "TI"], 
                StyleBox["j", "TI"]}]]}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\partial_k g_{ij} = \\xi\\left(H_{ki}\\, l_j + l_i\\, H_{kj}\\right)", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "1c172822-36e4-4e20-b8e5-fe281726cc1e"]
}], "Text",ExpressionUUID->"2bc7249c-8c1d-402e-a8e3-46d2806d321a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"\[PartialD]", "_k"}], " ", "g_", 
     RowBox[{"{", "ij", "}"}]}], " ", "=", " ", 
    RowBox[{"\[Xi]", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"H_", 
        RowBox[{"{", "ki", "}"}], " ", "l_j"}], " ", "+", " ", 
       RowBox[{"l_i", " ", "H_", 
        RowBox[{"{", "kj", "}"}]}]}], ")"}]}]}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"dg", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"xi", "*", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"hess", "[", 
           RowBox[{"[", 
            RowBox[{"k", ",", "i"}], "]"}], "]"}], "*", 
          RowBox[{"l", "[", 
           RowBox[{"[", "j", "]"}], "]"}]}], "+", 
         RowBox[{
          RowBox[{"l", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "*", 
          RowBox[{"hess", "[", 
           RowBox[{"[", 
            RowBox[{"k", ",", "j"}], "]"}], "]"}]}]}], ")"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"k", ",", "2"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "2"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"j", ",", "2"}], "}"}]}], "]"}]}], ";"}]}]], "Input",Expression\
UUID->"e22dd7c1-8578-4a43-a506-90454e1c5b27"],

Cell["Step 2: The Christoffel bracket simplifies beautifully", "Subsection",ExpressionUUID->"ebe6c832-4eaa-443c-9320-9a085b1ae76a"],

Cell[TextData[{
 "The combination ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[PartialD]", 
          StyleBox["i", "TI"]], 
         SubscriptBox[
          StyleBox["g", "TI"], 
          RowBox[{
            StyleBox["j", "TI"], 
            StyleBox["l", "TI"]}]], "+", 
         SubscriptBox["\[PartialD]", 
          StyleBox["j", "TI"]], 
         SubscriptBox[
          StyleBox["g", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["l", "TI"]}]], "-", 
         SubscriptBox["\[PartialD]", 
          StyleBox["l", "TI"]], 
         SubscriptBox[
          StyleBox["g", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"]}]]}], TraditionalForm], "errors" -> {}, 
     "input" -> 
     "\\partial_i g_{jl} + \\partial_j g_{il} - \\partial_l g_{ij}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0374a1b8-5960-4313-bdd9-d30e25ee517d"],
 " is called the \"Christoffel bracket.\" When we substitute our metric \
derivatives and use the symmetry of the Hessian (",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["H", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"]}]], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["H", "TI"], 
          RowBox[{
            StyleBox["j", "TI"], 
            StyleBox["i", "TI"]}]]}], TraditionalForm], "errors" -> {}, 
     "input" -> "H_{ij} = H_{ji}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "fd8466cf-9136-4a9e-b51b-945a65ee79e9"],
 "), ",
 StyleBox["all cross-terms cancel",
  FontWeight->Bold],
 " and we get: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[PartialD]", 
          StyleBox["i", "TI"]], 
         SubscriptBox[
          StyleBox["g", "TI"], 
          RowBox[{
            StyleBox["j", "TI"], 
            StyleBox["l", "TI"]}]], "+", 
         SubscriptBox["\[PartialD]", 
          StyleBox["j", "TI"]], 
         SubscriptBox[
          StyleBox["g", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["l", "TI"]}]], "-", 
         SubscriptBox["\[PartialD]", 
          StyleBox["l", "TI"]], 
         SubscriptBox[
          StyleBox["g", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"]}]], "\[LongEqual]", "2", "\[Xi] ", 
         SubscriptBox[
          StyleBox["H", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"]}]], " ", 
         SubscriptBox[
          StyleBox["l", "TI"], 
          StyleBox["l", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\partial_i g_{jl} + \\partial_j g_{il} - \\partial_l g_{ij} = 2\\xi\\, \
H_{ij}\\, l_l", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "335d91d3-4baa-496a-b8ab-170317a9bde7"],
 "This is the key simplification \[LongDash] the bracket is proportional to \
$H",
 StyleBox["{ij}$ times $l",
  FontSlant->Italic],
 "l$. "
}], "Text",ExpressionUUID->"eefdb5ac-9901-4e5c-96b7-a1ca24a61251"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"bracket", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"dg", "[", 
       RowBox[{"[", 
        RowBox[{"i", ",", "j", ",", "ll"}], "]"}], "]"}], "+", 
      RowBox[{"dg", "[", 
       RowBox[{"[", 
        RowBox[{"j", ",", "i", ",", "ll"}], "]"}], "]"}], "-", 
      RowBox[{"dg", "[", 
       RowBox[{"[", 
        RowBox[{"ll", ",", "i", ",", "j"}], "]"}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "2"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "2"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"ll", ",", "2"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"expected", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"2", "*", "xi", "*", 
      RowBox[{"hess", "[", 
       RowBox[{"[", 
        RowBox[{"i", ",", "j"}], "]"}], "]"}], "*", 
      RowBox[{"l", "[", 
       RowBox[{"[", "ll", "]"}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "2"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "2"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"ll", ",", "2"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Simplify", "[", 
  RowBox[{"bracket", "-", "expected"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "0"}], "}"}]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "0"}], "}"}]}], "}"}]}], "}"}], " ", "\[LongDash]",
     " ", "VERIFIED"}], " ", "*)"}]}]}], "Input",ExpressionUUID->"f42bf551-\
05ea-4682-987f-a8f69c3745ed"],

Cell["Step 3: Contract with the inverse metric", "Subsection",ExpressionUUID->"70a8f500-ef17-4fb5-8fe6-f26cd3fb6485"],

Cell[TextData[{
 "We also need ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["g", "TI"], 
          RowBox[{
            StyleBox["k", "TI"], 
            StyleBox["l", "TI"]}]], 
         SubscriptBox[
          StyleBox["l", "TI"], 
          StyleBox["l", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "g^{kl} l_l", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "8185bfa3-bf09-44b4-b28e-c03f0d1b8509"],
 ", the gradient \"raised\" with ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["g", "TI"], TraditionalForm], "errors" -> {}, "input" -> "g", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a8cba66b-b79b-4f41-84d6-09af1c4aa02a"],
 " (not ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Gamma]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\gamma", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "cdac3762-e4c9-4071-92c1-393e26c8c381"],
 "). From Sherman\[Dash]Morrison: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["g", "TI"], 
          RowBox[{
            StyleBox["k", "TI"], 
            StyleBox["l", "TI"]}]], " ", 
         SubscriptBox[
          StyleBox["l", "TI"], 
          StyleBox["l", "TI"]], "\[LongEqual]", 
         FractionBox[
          SuperscriptBox[
           StyleBox["l", "TI"], 
           StyleBox["k", "TI"]], 
          
          RowBox[{"1", "+", "\[Xi] ", 
            "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", 
            StyleBox["l", "TI"], 
            SubsuperscriptBox[
            "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", "\[Gamma]",
              "2"]}]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "g^{kl}\\, l_l = \\frac{l^k}{1 + \\xi\\, |l|_\\gamma^2}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "050d8ad1-53a3-4c8d-889d-abe46af1f8cc"],
 "This is just the ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Gamma]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\gamma", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ae0ba8ad-5264-468c-bcc1-eb83405aaf00"],
 "-raised gradient divided by the denominator factor. "
}], "Text",ExpressionUUID->"ae21be29-e948-4847-8fbe-1aca554e96cd"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"gInvDotL", "=", 
   RowBox[{"Simplify", "[", 
    RowBox[{"gInv", " ", ".", " ", "l"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"expectedGInvL", "=", 
   RowBox[{"lUp", "/", 
    RowBox[{"(", 
     RowBox[{"1", "+", 
      RowBox[{"xi", "*", "normSq"}]}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Simplify", "[", 
  RowBox[{"gInvDotL", "-", "expectedGInvL"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"0", ",", " ", "0"}], "}"}], " ", "\[LongDash]", " ", 
    "VERIFIED"}], " ", "*)"}]}]}], "Input",ExpressionUUID->"4329f2d9-685f-\
4d6a-9354-c102f39c243d"],

Cell["Step 4: The closed-form Christoffel symbols", "Subsection",ExpressionUUID->"e5e5eaf4-b879-4789-bf60-e04503f52743"],

Cell[TextData[{
 "Putting it together: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubsuperscriptBox["\[CapitalGamma]", 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"]}], 
          StyleBox["k", "TI"]], "\[LongEqual]", 
         FractionBox["1", "2"], 
         SuperscriptBox[
          StyleBox["g", "TI"], 
          RowBox[{
            StyleBox["k", "TI"], 
            StyleBox["l", "TI"]}]], "\[CenterDot]", "2", "\[Xi]", 
         SubscriptBox[
          StyleBox["H", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"]}]], 
         SubscriptBox[
          StyleBox["l", "TI"], 
          StyleBox["l", "TI"]], "\[LongEqual]", "\[Xi]", 
         SubscriptBox[
          StyleBox["H", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"]}]], "\[CenterDot]", 
         SuperscriptBox[
          StyleBox["g", "TI"], 
          RowBox[{
            StyleBox["k", "TI"], 
            StyleBox["l", "TI"]}]], 
         SubscriptBox[
          StyleBox["l", "TI"], 
          StyleBox["l", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\Gamma^k_{ij} = \\frac{1}{2} g^{kl} \\cdot 2\\xi H_{ij} l_l = \\xi \
H_{ij} \\cdot g^{kl} l_l", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "267b9e4e-11f6-499c-a84c-0d9e765d0f34"],
 ", giving: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubsuperscriptBox["\[CapitalGamma]", 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"]}], 
          StyleBox["k", "TI"]], "\[LongEqual]", 
         FractionBox[
          RowBox[{"\[Xi] ", 
            SubscriptBox[
             StyleBox["H", "TI"], 
             RowBox[{
               StyleBox["i", "TI"], 
               StyleBox["j", "TI"]}]], " ", 
            SuperscriptBox[
             StyleBox["l", "TI"], 
             StyleBox["k", "TI"]]}], 
          
          RowBox[{"1", "+", "\[Xi] ", 
            "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", 
            StyleBox["l", "TI"], 
            SubsuperscriptBox[
            "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", "\[Gamma]",
              "2"]}]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\boxed{\\Gamma^k_{ij} = \\frac{\\xi\\, H_{ij}\\, l^k}{1 + \\xi\\, |l|_\
\\gamma^2}}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "65944e2a-9312-43ce-95bc-4bb40fab01d8"],
 "The Christoffel symbol is the Hessian times the raised gradient, divided by \
the \"denominator\" factor. It is: "
}], "Text",ExpressionUUID->"00531c8c-f4b6-4d1c-8c48-42153bf96ba1"],

Cell[TextData[{
 "Symmetric in $i,j$ (as required, since ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["H", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"]}]], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["H", "TI"], 
          RowBox[{
            StyleBox["j", "TI"], 
            StyleBox["i", "TI"]}]]}], TraditionalForm], "errors" -> {}, 
     "input" -> "H_{ij} = H_{ji}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0c652d4d-efff-4048-8e09-d9cc4ebfd35a"],
 ")"
}], "Item",ExpressionUUID->"c4a79984-ad6b-427d-b8af-7267ff6e41cc"],

Cell[TextData[{
 "Zero when ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Xi]", "\[LongEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\xi = 0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "7df53fdf-d02b-436e-84ba-43acb481090c"],
 " (recovering the flat metric)"
}], "Item",ExpressionUUID->"eccdf075-e088-4a04-8dcf-f852d4036248"],

Cell["\<\
Proportional to $H_{ij}$ \[LongDash] this is what drives the main result\
\>", "Item",ExpressionUUID->"29056834-96dc-4824-97f6-46e8efd5323a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"chris", "=", 
   RowBox[{
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "/", "2"}], ")"}], "*", 
         RowBox[{"gInv", "[", 
          RowBox[{"[", 
           RowBox[{"k", ",", "ll"}], "]"}], "]"}], "*", 
         RowBox[{"bracket", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "j", ",", "ll"}], "]"}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"ll", ",", "2"}], "}"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"k", ",", "2"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "2"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"j", ",", "2"}], "}"}]}], "]"}], " ", "//", " ", 
    "Simplify"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"chrisFormula", "=", 
   RowBox[{
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"xi", "*", 
       RowBox[{"hess", "[", 
        RowBox[{"[", 
         RowBox[{"i", ",", "j"}], "]"}], "]"}], "*", 
       RowBox[{
        RowBox[{"lUp", "[", 
         RowBox[{"[", "k", "]"}], "]"}], "/", 
        RowBox[{"(", 
         RowBox[{"1", "+", 
          RowBox[{"xi", "*", "normSq"}]}], ")"}]}]}], ",", 
      RowBox[{"{", 
       RowBox[{"k", ",", "2"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "2"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"j", ",", "2"}], "}"}]}], "]"}], " ", "//", " ", 
    "Simplify"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Simplify", "[", 
  RowBox[{"chris", "-", "chrisFormula"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "0"}], "}"}]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "0"}], "}"}]}], "}"}]}], "}"}], " ", "\[LongDash]",
     " ", "VERIFIED"}], " ", "*)"}]}]}], "Input",ExpressionUUID->"18251aae-\
4e2e-4c2d-b31f-eeeabec6c1a6"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
