Notebook[{
Cell["Geodesic Convexity Analysis for the Induced Metric", "Title",ExpressionUUID->"3649933f-57cf-4c75-9c04-ff5cc3c28c23"],

Cell["Setup", "Section",ExpressionUUID->"0df42e2d-352f-4152-a8fe-0aae028c3a74"],

Cell[TextData[{
 "The induced metric on parameter space: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["g", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"]}]], "\[LongEqual]", 
         SubscriptBox["\[Gamma]", 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"]}]], "+", "\[Xi] ", 
         SubscriptBox[
          StyleBox["l", "TI"], 
          StyleBox["i", "TI"]], " ", 
         SubscriptBox[
          StyleBox["l", "TI"], 
          StyleBox["j", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "g_{ij} = \\gamma_{ij} + \\xi\\, l_i\\, l_j", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a3167485-6a36-467d-82be-76590797d045"],
 "where ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Gamma]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\gamma", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a6047d47-8794-4ba1-9110-2ade4c591ff3"],
 " is a constant diagonal base metric, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["l", "TI"], 
          StyleBox["i", "TI"]], "\[LongEqual]", 
         SubscriptBox["\[PartialD]", 
          StyleBox["i", "TI"]], 
         StyleBox["L", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "l_i = \\partial_i L", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "00c1cd10-2604-4d36-9356-94744113701e"],
 " is the loss gradient, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Xi]", ">", "0"}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\xi > 0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d0906dd6-89d4-4c1e-a8d4-5b1bf8e6ea55"],
 ". "
}], "Text",ExpressionUUID->"15c9caec-ca77-4be1-a134-90708783a6e9"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"===", " ", 
     RowBox[{"STEP", " ", "1"}]}], ":", " ", 
    RowBox[{
     RowBox[{"Christoffel", " ", "Symbols", " ", 
      RowBox[{"(", 
       RowBox[{"n", "=", 
        RowBox[{"2", " ", "verification"}]}], ")"}]}], " ", "==="}]}], " ", 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"l", "=", 
     RowBox[{"{", 
      RowBox[{"l1", ",", "l2"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"hess", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"H11", ",", "H12"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"H12", ",", "H22"}], "}"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"gam", "=", 
     RowBox[{"DiagonalMatrix", "[", 
      RowBox[{"{", 
       RowBox[{"g1", ",", "g2"}], "}"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"xi", "=", 
     RowBox[{"Symbol", "[", "\"\<xi\>\"", "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"g", "=", 
     RowBox[{"gam", "+", 
      RowBox[{"xi", "*", 
       RowBox[{"Outer", "[", 
        RowBox[{"Times", ",", "l", ",", "l"}], "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"gamInv", "=", 
     RowBox[{"DiagonalMatrix", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"1", "/", "g1"}], ",", 
        RowBox[{"1", "/", "g2"}]}], "}"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"lUp", "=", 
     RowBox[{"gamInv", " ", ".", " ", "l"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"normSq", "=", 
     RowBox[{"l", " ", ".", " ", "gamInv", " ", ".", " ", "l"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"gInv", "=", 
     RowBox[{
      RowBox[{"gamInv", "-", 
       RowBox[{"xi", "*", 
        RowBox[{
         RowBox[{"Outer", "[", 
          RowBox[{"Times", ",", "lUp", ",", "lUp"}], "]"}], "/", 
         RowBox[{"(", 
          RowBox[{"1", "+", 
           RowBox[{"xi", "*", "normSq"}]}], ")"}]}]}]}], " ", "//", " ", 
      "Simplify"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"Verify", " ", "inverse"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Simplify", "[", 
     RowBox[{"g", " ", ".", " ", "gInv"}], "]"}], "==", 
    RowBox[{"IdentityMatrix", "[", "2", "]"}]}]}]}]], "Input",ExpressionUUID->\
"74e6dc17-c831-4b9a-8bf1-0e97748c098d"],

Cell["Conjecture 1: Christoffel Bracket", "Section",ExpressionUUID->"46a6427d-ffe3-4d2d-973a-59458b307a74"],

Cell[TextData[Cell[BoxData[
 FormBox[
  TemplateBox[<|"boxes" -> FormBox[
      RowBox[{
        SubscriptBox["\[PartialD]", 
         StyleBox["i", "TI"]], 
        SubscriptBox[
         StyleBox["g", "TI"], 
         RowBox[{
           StyleBox["j", "TI"], 
           StyleBox["l", "TI"]}]], "+", 
        SubscriptBox["\[PartialD]", 
         StyleBox["j", "TI"]], 
        SubscriptBox[
         StyleBox["g", "TI"], 
         RowBox[{
           StyleBox["i", "TI"], 
           StyleBox["l", "TI"]}]], "-", 
        SubscriptBox["\[PartialD]", 
         StyleBox["l", "TI"]], 
        SubscriptBox[
         StyleBox["g", "TI"], 
         RowBox[{
           StyleBox["i", "TI"], 
           StyleBox["j", "TI"]}]], "\[LongEqual]", "2", "\[Xi] ", 
        SubscriptBox[
         StyleBox["H", "TI"], 
         RowBox[{
           StyleBox["i", "TI"], 
           StyleBox["j", "TI"]}]], " ", 
        SubscriptBox[
         StyleBox["l", "TI"], 
         StyleBox["l", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
    "\\partial_i g_{jl} + \\partial_j g_{il} - \\partial_l g_{ij} = 2\\xi\\, \
H_{ij}\\, l_l", "state" -> "Boxes"|>,
   "TeXAssistantTemplate"], 
  TraditionalForm]],ExpressionUUID->"1fb69f82-b490-4800-a531-447dc4105612"]], \
"Text",ExpressionUUID->"4a3c21a9-74e0-4dab-8d91-8c8d13a78d59"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"dg", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"xi", "*", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"hess", "[", 
          RowBox[{"[", 
           RowBox[{"k", ",", "i"}], "]"}], "]"}], "*", 
         RowBox[{"l", "[", 
          RowBox[{"[", "j", "]"}], "]"}]}], "+", 
        RowBox[{
         RowBox[{"l", "[", 
          RowBox[{"[", "i", "]"}], "]"}], "*", 
         RowBox[{"hess", "[", 
          RowBox[{"[", 
           RowBox[{"k", ",", "j"}], "]"}], "]"}]}]}], ")"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"k", ",", "2"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "2"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "2"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"bracket", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"dg", "[", 
       RowBox[{"[", 
        RowBox[{"i", ",", "j", ",", "ll"}], "]"}], "]"}], "+", 
      RowBox[{"dg", "[", 
       RowBox[{"[", 
        RowBox[{"j", ",", "i", ",", "ll"}], "]"}], "]"}], "-", 
      RowBox[{"dg", "[", 
       RowBox[{"[", 
        RowBox[{"ll", ",", "i", ",", "j"}], "]"}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "2"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "2"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"ll", ",", "2"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"expected", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"2", "*", "xi", "*", 
      RowBox[{"hess", "[", 
       RowBox[{"[", 
        RowBox[{"i", ",", "j"}], "]"}], "]"}], "*", 
      RowBox[{"l", "[", 
       RowBox[{"[", "ll", "]"}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "2"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "2"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"ll", ",", "2"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Simplify", "[", 
  RowBox[{"bracket", "-", "expected"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Result", ":", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"0", ",", " ", "0"}], "}"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"0", ",", " ", "0"}], "}"}]}], "}"}]}], "}"}]}], " ", "\[LongDash]",
     " ", "VERIFIED"}], " ", "*)"}]}]}], "Input",ExpressionUUID->"8f0d87ad-\
3033-4b26-826d-77203ae6d48c"],

Cell["Conjecture 2: Christoffel Symbols", "Section",ExpressionUUID->"ebf3846a-0353-4966-9b0c-8100540310a3"],

Cell[TextData[Cell[BoxData[
 FormBox[
  TemplateBox[<|"boxes" -> FormBox[
      RowBox[{
        SubsuperscriptBox["\[CapitalGamma]", 
         RowBox[{
           StyleBox["i", "TI"], 
           StyleBox["j", "TI"]}], 
         StyleBox["k", "TI"]], "\[LongEqual]", 
        FractionBox[
         RowBox[{"\[Xi] ", 
           SubscriptBox[
            StyleBox["H", "TI"], 
            RowBox[{
              StyleBox["i", "TI"], 
              StyleBox["j", "TI"]}]], " ", 
           SuperscriptBox[
            StyleBox["l", "TI"], 
            StyleBox["k", "TI"]]}], 
         RowBox[{
          "1", "+", "\[Xi] ", 
           "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", 
           StyleBox["l", "TI"], 
           SubsuperscriptBox[
           "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", "\[Gamma]", 
            "2"]}]]}], TraditionalForm], "errors" -> {}, "input" -> 
    "\\Gamma^k_{ij} = \\frac{\\xi\\, H_{ij}\\, l^k}{1 + \\xi\\, \
|l|^2_\\gamma}", "state" -> "Boxes"|>,
   "TeXAssistantTemplate"], 
  TraditionalForm]],ExpressionUUID->"1fbef035-551d-476b-803e-1b335d4a0dd8"]], \
"Text",ExpressionUUID->"9c878bef-67ba-404d-8aac-3f3e6f40086c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"chris", "=", 
   RowBox[{
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "/", "2"}], ")"}], "*", 
         RowBox[{"gInv", "[", 
          RowBox[{"[", 
           RowBox[{"k", ",", "ll"}], "]"}], "]"}], "*", 
         RowBox[{"bracket", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "j", ",", "ll"}], "]"}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"ll", ",", "2"}], "}"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"k", ",", "2"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "2"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"j", ",", "2"}], "}"}]}], "]"}], " ", "//", " ", 
    "Simplify"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"chrisFormula", "=", 
   RowBox[{
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"xi", "*", 
       RowBox[{"hess", "[", 
        RowBox[{"[", 
         RowBox[{"i", ",", "j"}], "]"}], "]"}], "*", 
       RowBox[{
        RowBox[{"lUp", "[", 
         RowBox[{"[", "k", "]"}], "]"}], "/", 
        RowBox[{"(", 
         RowBox[{"1", "+", 
          RowBox[{"xi", "*", "normSq"}]}], ")"}]}]}], ",", 
      RowBox[{"{", 
       RowBox[{"k", ",", "2"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "2"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"j", ",", "2"}], "}"}]}], "]"}], " ", "//", " ", 
    "Simplify"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Simplify", "[", 
  RowBox[{"chris", "-", "chrisFormula"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Result", ":", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"0", ",", " ", "0"}], "}"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"0", ",", " ", "0"}], "}"}]}], "}"}]}], "}"}]}], " ", "\[LongDash]",
     " ", "VERIFIED"}], " ", "*)"}]}]}], "Input",ExpressionUUID->"e14b928b-\
98eb-463d-83cc-c8b36da20c55"],

Cell["Conjecture 3: Correction Term", "Section",ExpressionUUID->"49fd1633-0642-40e8-8cca-218f24a44db2"],

Cell[TextData[Cell[BoxData[
 FormBox[
  TemplateBox[<|"boxes" -> FormBox[
      RowBox[{
        SubscriptBox[
         StyleBox["C", "TI"], 
         RowBox[{
           StyleBox["i", "TI"], 
           StyleBox["j", "TI"]}]], "\[LongEqual]", 
        SubsuperscriptBox["\[CapitalGamma]", 
         RowBox[{
           StyleBox["i", "TI"], 
           StyleBox["j", "TI"]}], 
         StyleBox["k", "TI"]], " ", 
        SubscriptBox[
         StyleBox["l", "TI"], 
         StyleBox["k", "TI"]], "\[LongEqual]", 
        FractionBox[
         RowBox[{
          "\[Xi] ", "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", 
           StyleBox["l", "TI"], 
           SubsuperscriptBox[
           "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", "\[Gamma]", 
            "2"]}], 
         RowBox[{
          "1", "+", "\[Xi] ", 
           "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", 
           StyleBox["l", "TI"], 
           SubsuperscriptBox[
           "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", "\[Gamma]", 
            "2"]}]], " ", 
        SubscriptBox[
         StyleBox["H", "TI"], 
         RowBox[{
           StyleBox["i", "TI"], 
           StyleBox["j", "TI"]}]]}], TraditionalForm], "errors" -> {}, 
    "input" -> 
    "C_{ij} = \\Gamma^k_{ij}\\, l_k = \\frac{\\xi\\, |l|^2_\\gamma}{1 + \
\\xi\\, |l|^2_\\gamma}\\, H_{ij}", "state" -> "Boxes"|>,
   "TeXAssistantTemplate"], 
  TraditionalForm]],ExpressionUUID->"49393131-f03d-4cd5-83da-70a3a5b0cca9"]], \
"Text",ExpressionUUID->"608d4068-fa0e-4d27-8b34-06edfe04257e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"correction", "=", 
   RowBox[{
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"chris", "[", 
          RowBox[{"[", 
           RowBox[{"k", ",", "i", ",", "j"}], "]"}], "]"}], "*", 
         RowBox[{"l", "[", 
          RowBox[{"[", "k", "]"}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"k", ",", "2"}], "}"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "2"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"j", ",", "2"}], "}"}]}], "]"}], " ", "//", " ", 
    "Simplify"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"corrFormula", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"xi", "*", 
       RowBox[{"normSq", "/", 
        RowBox[{"(", 
         RowBox[{"1", "+", 
          RowBox[{"xi", "*", "normSq"}]}], ")"}]}]}], ")"}], "*", "hess"}], 
    " ", "//", " ", "Simplify"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Simplify", "[", 
  RowBox[{"correction", "-", "corrFormula"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Result", ":", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "0"}], "}"}]}], "}"}]}], " ", "\[LongDash]", 
    " ", "VERIFIED"}], " ", "*)"}]}]}], "Input",ExpressionUUID->"757330f7-\
39d7-424d-9804-30b26c47a8b7"],

Cell["Conjecture 4: Riemannian Hessian", "Section",ExpressionUUID->"d771f882-d4fa-4077-950a-899f7138a3cf"],

Cell[TextData[Cell[BoxData[
 FormBox[
  TemplateBox[<|"boxes" -> FormBox[
