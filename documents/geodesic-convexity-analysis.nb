Cell["6. Eigenvalue Analysis", "Section",ExpressionUUID->"1f4e9cbd-c075-4558-ba83-e6ae32195f24"],

Cell["The eigenvalue ratio is uniform", "Subsection",ExpressionUUID->"be5d97c4-08cf-4eae-ac4c-1d97f0115adb"],

Cell[TextData[{
 "Since ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["Hess", FontSlant -> "Plain"], 
          StyleBox["g", "TI"]], 
         StyleBox["L", "TI"], "\[LongEqual]", 
         StyleBox["H", "TI"], "/", 
         RowBox[{"(", 
           
           RowBox[{"1", "+", "\[Xi]", 
             "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", 
             StyleBox["l", "TI"], 
             SubsuperscriptBox[
             "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", 
              "\[Gamma]", "2"]}], ")"}]}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\mathrm{Hess}_g L = H / (1 + \\xi|l|_\\gamma^2)", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "33e54621-d16b-4f92-a195-9550db59de60"],
 ", the eigenvalues of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["Hess", FontSlant -> "Plain"], 
          StyleBox["g", "TI"]], 
         StyleBox["L", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\mathrm{Hess}_g L", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "48d70bad-c5c5-483e-9094-0e17babc9ff4"],
 " are exactly ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Lambda]", 
          StyleBox["k", "TI"]], "/", 
         RowBox[{"(", 
           
           RowBox[{"1", "+", "\[Xi]", 
             "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", 
             StyleBox["l", "TI"], 
             SubsuperscriptBox[
             "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", 
              "\[Gamma]", "2"]}], ")"}]}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\lambda_k / (1 + \\xi|l|_\\gamma^2)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "67ea2984-2805-4aa7-b916-c05e6b1244a4"],
 " where ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["\[Lambda]", 
        StyleBox["k", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\lambda_k", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "82ec4b58-4189-46e7-b349-ade6323be3ff"],
 " are the eigenvalues of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["H", "TI"], TraditionalForm], "errors" -> {}, "input" -> "H", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "990d4ed1-9d25-4837-9fab-b19cad6327ae"],
 ". Let's verify: "
}], "CodeText",ExpressionUUID->"6a0b9a26-2f8b-4a96-9487-6cfaccc39f73"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"hess2", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"aa", ",", "bb"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"bb", ",", "cc"}], "}"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"xxi", "=", 
   RowBox[{"Symbol", "[", "\"\<xxi\>\"", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"nSq", "=", 
    RowBox[{"Symbol", "[", "\"\<nSq\>\"", "]"}]}], ";"}], "  ", 
  RowBox[{"(*", " ", 
   RowBox[{"represents", " ", "||", "l", "||", "\.b2_\[Gamma]"}], " ", "*)"}],
   "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rHess2", "=", 
   RowBox[{"hess2", "/", 
    RowBox[{"(", 
     RowBox[{"1", "+", 
      RowBox[{"xxi", "*", "nSq"}]}], ")"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"eigH", "=", 
   RowBox[{
    RowBox[{"Eigenvalues", "[", "hess2", "]"}], " ", "//", " ", 
    "Simplify"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"eigRH", "=", 
   RowBox[{
    RowBox[{"Eigenvalues", "[", "rHess2", "]"}], " ", "//", " ", 
    "Simplify"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"FullSimplify", "[", 
  RowBox[{"eigRH", "/", "eigH"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"1", "/", 
       RowBox[{"(", 
        RowBox[{"1", " ", "+", " ", 
         RowBox[{"nSq", "*", "xxi"}]}], ")"}]}], ",", " ", 
      RowBox[{"1", "/", 
       RowBox[{"(", 
        RowBox[{"1", " ", "+", " ", 
         RowBox[{"nSq", "*", "xxi"}]}], ")"}]}]}], "}"}], " ", "\[LongDash]", 
    " ", 
    RowBox[{"both", " ", "eigenvalues", " ", "scale", " ", "identically"}]}], 
   " ", "*)"}]}]}], "Input",ExpressionUUID->"3abd9122-ac0d-4c8e-a9a7-\
d03a6fe68026"],

