 " is PSD"
}], "Item",ExpressionUUID->"4dae0c31-89f3-4627-bb00-b31b27208c22"],

Cell[TextData[{
 StyleBox["Condition number is unchanged:",
  FontWeight->Bold],
 " ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Kappa]", 
         RowBox[{"(", 
           SubscriptBox["Hess", 
            StyleBox["g", "TI"]], ")"}], "\[LongEqual]", "\[Kappa]", 
         RowBox[{"(", 
           StyleBox["H", "TI"], ")"}]}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\kappa(\\text{Hess}_g) = \\kappa(H)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
