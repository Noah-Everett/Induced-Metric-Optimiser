Notebook[{
Cell["Geodesic Convexity Analysis \[LongDash] Induced Metric Optimiser", \
"Title",ExpressionUUID->"06dcac23-09e3-4411-8a6d-33897267d7f4"],

Cell[TextData[{
 "Mathematica verification of all results in the \"Geodesic Convexity \
Analysis\" section of ",
 Cell[BoxData[Cell["optimisers.tex",
   Background->None,ExpressionUUID->"efae5e01-b47c-4cc0-9dfa-98aec1732b77"]], 
  "InlineCode",ExpressionUUID->"552137c9-6a64-4855-a83d-a1e471038742"],
 ". "
}], "Text",ExpressionUUID->"81e615a2-6458-4385-b6b6-8975a7744677"],

Cell["1. Setup (n=2)", "Section",ExpressionUUID->"4dc4f586-c583-4e0f-9ac7-10460e4886c0"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"l", "=", 
   RowBox[{"{", 
    RowBox[{"l1", ",", "l2"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"hess", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"H11", ",", "H12"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"H12", ",", "H22"}], "}"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"gam", "=", 
   RowBox[{"DiagonalMatrix", "[", 
    RowBox[{"{", 
     RowBox[{"g1", ",", "g2"}], "}"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"xi", "=", 
   RowBox[{"Symbol", "[", "\"\<xi\>\"", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"g", "=", 
   RowBox[{"gam", "+", 
    RowBox[{"xi", "*", 
     RowBox[{"Outer", "[", 
      RowBox[{"Times", ",", "l", ",", "l"}], "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"gamInv", "=", 
   RowBox[{"DiagonalMatrix", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"1", "/", "g1"}], ",", 
      RowBox[{"1", "/", "g2"}]}], "}"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"lUp", "=", 
   RowBox[{"gamInv", " ", ".", " ", "l"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"normSq", "=", 
   RowBox[{"l", " ", ".", " ", "gamInv", " ", ".", " ", "l"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"gInv", "=", 
   RowBox[{
    RowBox[{"gamInv", "-", 
     RowBox[{"xi", "*", 
      RowBox[{
       RowBox[{"Outer", "[", 
        RowBox[{"Times", ",", "lUp", ",", "lUp"}], "]"}], "/", 
       RowBox[{"(", 
        RowBox[{"1", "+", 
         RowBox[{"xi", "*", "normSq"}]}], ")"}]}]}]}], " ", "//", " ", 
    "Simplify"}]}], ";"}]}], "Input",ExpressionUUID->"55033279-437b-4bbb-828a-\
ef3c36897f6a"],

Cell["Verify inverse: ", "CodeText",ExpressionUUID->"e82a6323-2b53-4d3a-88f9-68ecf9f669a0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Simplify", "[", 
   RowBox[{"g", " ", ".", " ", "gInv"}], "]"}], "==", 
  RowBox[{"IdentityMatrix", "[", "2", "]"}]}]], "Input",ExpressionUUID->\
"b272e350-51b6-402f-95d4-d4f736808345"],

Cell["2. Conjecture 1: Christoffel Bracket = 2\[Xi] H l", "Section",ExpressionUUID->"a2e1f40d-7ec2-40d0-8e84-4bc4b4281e00"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"dg", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"xi", "*", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"hess", "[", 
          RowBox[{"[", 
           RowBox[{"k", ",", "i"}], "]"}], "]"}], "*", 
         RowBox[{"l", "[", 
          RowBox[{"[", "j", "]"}], "]"}]}], "+", 
        RowBox[{
         RowBox[{"l", "[", 
          RowBox[{"[", "i", "]"}], "]"}], "*", 
         RowBox[{"hess", "[", 
          RowBox[{"[", 
           RowBox[{"k", ",", "j"}], "]"}], "]"}]}]}], ")"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"k", ",", "2"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "2"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "2"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"bracket", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"dg", "[", 
       RowBox[{"[", 
        RowBox[{"i", ",", "j", ",", "ll"}], "]"}], "]"}], "+", 
      RowBox[{"dg", "[", 
       RowBox[{"[", 
        RowBox[{"j", ",", "i", ",", "ll"}], "]"}], "]"}], "-", 
      RowBox[{"dg", "[", 
       RowBox[{"[", 
        RowBox[{"ll", ",", "i", ",", "j"}], "]"}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "2"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "2"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"ll", ",", "2"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"expected", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"2", "*", "xi", "*", 
      RowBox[{"hess", "[", 
       RowBox[{"[", 
        RowBox[{"i", ",", "j"}], "]"}], "]"}], "*", 
      RowBox[{"l", "[", 
       RowBox[{"[", "ll", "]"}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "2"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "2"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"ll", ",", "2"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Simplify", "[", 
  RowBox[{"bracket", "-", "expected"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Expected", ":", " ", 
    RowBox[{"all", " ", "zeros"}]}], " ", "*)"}]}]}], "Input",ExpressionUUID->\
"dc0922da-74d1-470b-810a-ddaa4a339cb8"],

Cell["3. Conjecture 2: Christoffel Symbols", "Section",ExpressionUUID->"349eb465-69ae-424a-905d-e1e7548157e9"],

Cell[TextData[Cell[BoxData[
 FormBox[
  TemplateBox[<|"boxes" -> FormBox[
      RowBox[{
        SubsuperscriptBox["\[CapitalGamma]", 
         RowBox[{
           StyleBox["i", "TI"], 
           StyleBox["j", "TI"]}], 
         StyleBox["k", "TI"]], "\[LongEqual]", "\[Xi]", 
        SubscriptBox[
         StyleBox["H", "TI"], 
         RowBox[{
           StyleBox["i", "TI"], 
           StyleBox["j", "TI"]}]], 
        SuperscriptBox[
         StyleBox["l", "TI"], 
         StyleBox["k", "TI"]], "/", 
        RowBox[{"(", 
          
          RowBox[{"1", "+", "\[Xi]", 
            "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", 
            StyleBox["l", "TI"], 
            SubsuperscriptBox[
            "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", "\[Gamma]",
              "2"]}], ")"}]}], TraditionalForm], "errors" -> {}, "input" -> 
    "\\Gamma^k_{ij} = \\xi H_{ij} l^k / (1 + \\xi |l|^2_\\gamma)", "state" -> 
    "Boxes"|>,
   "TeXAssistantTemplate"], 
  TraditionalForm]],ExpressionUUID->"bd5e88ae-0db4-4076-8333-3e91c471732c"]], \
"Text",ExpressionUUID->"f569d29d-a1a5-454c-920e-f5ba8c813fdd"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"chris", "=", 
   RowBox[{
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "/", "2"}], ")"}], "*", 
         RowBox[{"gInv", "[", 
          RowBox[{"[", 
           RowBox[{"k", ",", "ll"}], "]"}], "]"}], "*", 
         RowBox[{"bracket", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "j", ",", "ll"}], "]"}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"ll", ",", "2"}], "}"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"k", ",", "2"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "2"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"j", ",", "2"}], "}"}]}], "]"}], " ", "//", " ", 
    "Simplify"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"chrisFormula", "=", 
   RowBox[{
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"xi", "*", 
       RowBox[{"hess", "[", 
        RowBox[{"[", 
         RowBox[{"i", ",", "j"}], "]"}], "]"}], "*", 
       RowBox[{
        RowBox[{"lUp", "[", 
         RowBox[{"[", "k", "]"}], "]"}], "/", 
        RowBox[{"(", 
         RowBox[{"1", "+", 
          RowBox[{"xi", "*", "normSq"}]}], ")"}]}]}], ",", 
      RowBox[{"{", 
       RowBox[{"k", ",", "2"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "2"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"j", ",", "2"}], "}"}]}], "]"}], " ", "//", " ", 
    "Simplify"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Simplify", "[", 
  RowBox[{"chris", "-", "chrisFormula"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Expected", ":", " ", 
    RowBox[{"all", " ", "zeros"}]}], " ", "*)"}]}]}], "Input",ExpressionUUID->\
"982c7bd6-97d6-422f-b38e-ea22dc8e9d2e"],

Cell["4. Conjecture 3: Correction Term", "Section",ExpressionUUID->"4968ad0d-7b25-455e-8354-bed567825b8d"],

Cell[TextData[Cell[BoxData[
 FormBox[
  TemplateBox[<|"boxes" -> FormBox[
      RowBox[{
        SubscriptBox[
         StyleBox["C", "TI"], 
         RowBox[{
           StyleBox["i", "TI"], 
           StyleBox["j", "TI"]}]], "\[LongEqual]", 
        SubsuperscriptBox["\[CapitalGamma]", 
         RowBox[{
           StyleBox["i", "TI"], 
           StyleBox["j", "TI"]}], 
         StyleBox["k", "TI"]], 
        SubscriptBox[
         StyleBox["l", "TI"], 
         StyleBox["k", "TI"]], "\[LongEqual]", 
        FractionBox[
         RowBox[{
          "\[Xi]", "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", 
           StyleBox["l", "TI"], 
           SubsuperscriptBox[
           "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", "\[Gamma]", 
            "2"]}], 
         RowBox[{
          "1", "+", "\[Xi]", 
           "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", 
           StyleBox["l", "TI"], 
           SubsuperscriptBox[
           "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", "\[Gamma]", 
            "2"]}]], 
        SubscriptBox[
         StyleBox["H", "TI"], 
         RowBox[{
           StyleBox["i", "TI"], 
           StyleBox["j", "TI"]}]]}], TraditionalForm], "errors" -> {}, 
    "input" -> 
    "C_{ij} = \\Gamma^k_{ij} l_k = \\frac{\\xi |l|^2_\\gamma}{1 + \\xi |l|^2_\
\\gamma} H_{ij}", "state" -> "Boxes"|>,
   "TeXAssistantTemplate"], 
  TraditionalForm]],ExpressionUUID->"c1f7db24-01bf-4008-99d7-ea6d0d4ca5aa"]], \
"Text",ExpressionUUID->"d74c2661-52f4-4b4c-8d5b-155e4e28242d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"correction", "=", 
   RowBox[{
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"chris", "[", 
          RowBox[{"[", 
           RowBox[{"k", ",", "i", ",", "j"}], "]"}], "]"}], "*", 
         RowBox[{"l", "[", 
          RowBox[{"[", "k", "]"}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"k", ",", "2"}], "}"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "2"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"j", ",", "2"}], "}"}]}], "]"}], " ", "//", " ", 
    "Simplify"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"corrFormula", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"xi", "*", 
       RowBox[{"normSq", "/", 
        RowBox[{"(", 
         RowBox[{"1", "+", 
          RowBox[{"xi", "*", "normSq"}]}], ")"}]}]}], ")"}], "*", "hess"}], 
    " ", "//", " ", "Simplify"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Simplify", "[", 
  RowBox[{"correction", "-", "corrFormula"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Expected", ":", " ", 
    RowBox[{"all", " ", "zeros"}]}], " ", "*)"}]}]}], "Input",ExpressionUUID->\
"0f2148c2-6083-49a0-9137-1f1e3e0b28b5"],

Cell["5. Conjecture 4: Riemannian Hessian", "Section",ExpressionUUID->"196e882f-557f-4a69-a0cc-d3d2f02242f1"],

Cell[TextData[Cell[BoxData[
 FormBox[
  TemplateBox[<|"boxes" -> FormBox[
      RowBox[{
        SubscriptBox[
         RowBox[{"(", 
           RowBox[{
             SubscriptBox["Hess", 
              StyleBox["g", "TI"]], 
             StyleBox["L", "TI"]}], ")"}], 
         RowBox[{
           StyleBox["i", "TI"], 
           StyleBox["j", "TI"]}]], "\[LongEqual]", 
        SubscriptBox[
         StyleBox["H", "TI"], 
         RowBox[{
           StyleBox["i", "TI"], 
           StyleBox["j", "TI"]}]], "/", 
        RowBox[{"(", 
          
          RowBox[{"1", "+", "\[Xi]", 
            "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", 
            StyleBox["l", "TI"], 
            SubsuperscriptBox[
            "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", "\[Gamma]",
              "2"]}], ")"}]}], TraditionalForm], "errors" -> {}, "input" -> 
    "(\\text{Hess}_g L)_{ij} = H_{ij} / (1 + \\xi |l|^2_\\gamma)", "state" -> 
    "Boxes"|>,
   "TeXAssistantTemplate"], 
  TraditionalForm]],ExpressionUUID->"c5dd4903-1910-4b70-a01c-849892c487f0"]], \
"Text",ExpressionUUID->"99db4cd4-df86-4e75-9cbc-63ebf3b2ff66"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"rHess", "=", 
   RowBox[{
    RowBox[{"hess", "-", "correction"}], " ", "//", " ", "Simplify"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rHessFormula", "=", 
   RowBox[{
    RowBox[{"hess", "/", 
     RowBox[{"(", 
      RowBox[{"1", "+", 
       RowBox[{"xi", "*", "normSq"}]}], ")"}]}], " ", "//", " ", 
    "Simplify"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Simplify", "[", 
  RowBox[{"rHess", "-", "rHessFormula"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Expected", ":", " ", 
    RowBox[{"all", " ", "zeros"}]}], " ", "*)"}]}]}], "Input",ExpressionUUID->\
"a9bdf19f-f203-4eca-9af0-1b9e885ce366"],

Cell["6. Verification in n=3", "Section",ExpressionUUID->"86fe0539-4c61-4d76-b944-855307b0c952"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"l3", "=", 
   RowBox[{"{", 
    RowBox[{"la", ",", "lb", ",", "lc"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"hess3", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"Haa", ",", "Hab", ",", "Hac"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"Hab", ",", "Hbb", ",", "Hbc"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"Hac", ",", "Hbc", ",", "Hcc"}], "}"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"gam3", "=", 
   RowBox[{"DiagonalMatrix", "[", 
    RowBox[{"{", 
     RowBox[{"ga", ",", "gb", ",", "gc"}], "}"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"xi", "=", 
   RowBox[{"Symbol", "[", "\"\<xi\>\"", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"g3", "=", 
   RowBox[{"gam3", "+", 
    RowBox[{"xi", "*", 
     RowBox[{"Outer", "[", 
      RowBox[{"Times", ",", "l3", ",", "l3"}], "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"gamInv3", "=", 
   RowBox[{"DiagonalMatrix", "[", 
    RowBox[{"1", "/", 
     RowBox[{"Diagonal", "[", "gam3", "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"lUp3", "=", 
   RowBox[{"gamInv3", " ", ".", " ", "l3"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"normSq3", "=", 
   RowBox[{
    RowBox[{"l3", " ", ".", " ", "gamInv3", " ", ".", " ", "l3"}], " ", "//", 
    " ", "Simplify"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"gInv3", "=", 
    RowBox[{
     RowBox[{"gamInv3", "-", 
      RowBox[{"xi", "*", 
       RowBox[{
        RowBox[{"Outer", "[", 
         RowBox[{"Times", ",", "lUp3", ",", "lUp3"}], "]"}], "/", 
        RowBox[{"(", 
         RowBox[{"1", "+", 
          RowBox[{"xi", "*", "normSq3"}]}], ")"}]}]}]}], " ", "//", " ", 
     "Simplify"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", "Bracket", " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dg3", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"xi", "*", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"hess3", "[", 
          RowBox[{"[", 
           RowBox[{"k", ",", "i"}], "]"}], "]"}], "*", 
         RowBox[{"l3", "[", 
          RowBox[{"[", "j", "]"}], "]"}]}], "+", 
        RowBox[{
         RowBox[{"l3", "[", 
          RowBox[{"[", "i", "]"}], "]"}], "*", 
         RowBox[{"hess3", "[", 
          RowBox[{"[", 
           RowBox[{"k", ",", "j"}], "]"}], "]"}]}]}], ")"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"k", ",", "3"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "3"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "3"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"bracket3", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"dg3", "[", 
       RowBox[{"[", 
        RowBox[{"i", ",", "j", ",", "ll"}], "]"}], "]"}], "+", 
      RowBox[{"dg3", "[", 
       RowBox[{"[", 
        RowBox[{"j", ",", "i", ",", "ll"}], "]"}], "]"}], "-", 
      RowBox[{"dg3", "[", 
       RowBox[{"[", 
        RowBox[{"ll", ",", "i", ",", "j"}], "]"}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "3"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "3"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"ll", ",", "3"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"expected3", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"2", "*", "xi", "*", 
      RowBox[{"hess3", "[", 
       RowBox[{"[", 
        RowBox[{"i", ",", "j"}], "]"}], "]"}], "*", 
      RowBox[{"l3", "[", 
       RowBox[{"[", "ll", "]"}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "3"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "3"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"ll", ",", "3"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Simplify", "[", 
    RowBox[{"bracket3", "-", "expected3"}], "]"}], " ", "//", " ", 
   "Flatten"}], " ", "//", " ", "DeleteDuplicates"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Expected", ":", " ", 
    RowBox[{"{", "0", "}"}]}], " ", "*)"}]}]}], "Input",ExpressionUUID->\
"48e3ee95-9764-4297-9160-cc59979187af"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Christoffel", " ", "symbols"}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"chris3", "=", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", "/", "2"}], ")"}], "*", 
           RowBox[{"gInv3", "[", 
            RowBox[{"[", 
             RowBox[{"k", ",", "ll"}], "]"}], "]"}], "*", 
           RowBox[{"bracket3", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", "j", ",", "ll"}], "]"}], "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"ll", ",", "3"}], "}"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"k", ",", "3"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "3"}], "}"}], ",", 
