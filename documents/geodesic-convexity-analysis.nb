      RowBox[{"0", ",", " ", "0", ",", " ", "1"}], "}"}]}], " ", 
    "*)"}]}]}]], "Input",ExpressionUUID->"67d3dec6-ae05-48f2-ae0b-\
271bd4c51b46"],

