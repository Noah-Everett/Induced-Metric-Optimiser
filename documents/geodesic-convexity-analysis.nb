Cell[BoxData[{
 RowBox[{
  RowBox[{"hSaddle", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"2", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", 
       RowBox[{"-", "2"}]}], "}"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"xiVals", "=", 
   RowBox[{"{", 
    RowBox[{"0.1", ",", "1", ",", "10", ",", "100"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"pts2", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "0"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"0", ",", "1"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"1", ",", "1"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"2", ",", "3"}], "}"}]}], "}"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Table", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"lv", ",", "ns"}], "}"}], ",", "\[IndentingNewLine]", "    ", 
       
       RowBox[{
        RowBox[{"lv", "=", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"2", "*", 
             RowBox[{"pt", "[", 
              RowBox[{"[", "1", "]"}], "]"}]}], ",", 
            RowBox[{
             RowBox[{"-", "2"}], "*", 
             RowBox[{"pt", "[", 
              RowBox[{"[", "2", "]"}], "]"}]}]}], "}"}], " ", "//", " ", 
          "N"}]}], ";", "\[IndentingNewLine]", "    ", 
        RowBox[{"ns", "=", 
         RowBox[{"lv", ".", "lv"}]}], ";", "\[IndentingNewLine]", "    ", 
        RowBox[{"{", 
         RowBox[{"pt", ",", "xv", ",", 
          RowBox[{"Round", "[", 
           RowBox[{
            RowBox[{"Sort", "[", 
             RowBox[{"Eigenvalues", "[", 
              RowBox[{"hSaddle", "/", 
               RowBox[{"(", 
                RowBox[{"1", "+", 
                 RowBox[{"xv", "*", "ns"}]}], ")"}]}], "]"}], "]"}], ",", 
            "0.00001"}], "]"}]}], "}"}]}]}], "\[IndentingNewLine]", "  ", 
      "]"}], ",", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"pt", ",", "pts2"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"xv", ",", "xiVals"}], "}"}]}], "]"}], " ", "//", " ", 
   "TableForm"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
   "Every", " ", "row", " ", "has", " ", "one", " ", "positive", " ", "and", " ",
     "one", " ", "negative", " ", "eigenvalue"}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "The", " ", "magnitude", " ", "decreases", " ", "with", " ", "\[Xi]", " ", 
    "but", " ", "the", " ", "sign", " ", "never", " ", "flips"}], " ", 
   "*)"}]}]}], "Input",ExpressionUUID->"1a4b9099-d93b-4af2-a518-0aa7b6a05b39"],

