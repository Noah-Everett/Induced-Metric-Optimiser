Cell[TextData[{
 "The induced metric ",
 StyleBox["cannot",
  FontWeight->Bold],
 " convert a non-convex function to a geodesically convex one"
}], "Item",ExpressionUUID->"c6e36816-aa8a-42cd-94a2-318305fafd83"],

Cell["Off-Diagonal Metric", "Section",ExpressionUUID->"ab3bad93-4a51-4a35-b764-e57d69aad574"],

Cell[TextData[{
 "For ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["g", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"]}]], "\[LongEqual]", 
         SubscriptBox["\[Gamma]", 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"]}]], "+", "\[Xi]", 
         RowBox[{"(", 
           RowBox[{
             SubscriptBox[
              StyleBox["a", "TI"], 
              StyleBox["i", "TI"]], 
             SubscriptBox[
              StyleBox["l", "TI"], 
              StyleBox["j", "TI"]], "+", 
             SubscriptBox[
              StyleBox["b", "TI"], 
              StyleBox["j", "TI"]], 
             SubscriptBox[
              StyleBox["l", "TI"], 
              StyleBox["i", "TI"]], "+", 
             SubscriptBox[
              StyleBox["l", "TI"], 
              StyleBox["i", "TI"]], 
             SubscriptBox[
              StyleBox["l", "TI"], 
              StyleBox["j", "TI"]]}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "g_{ij} = \\gamma_{ij} + \\xi(a_i l_j + b_j l_i + l_i l_j)", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "dd1e51c6-f869-457a-8299-8430bbf62fd5"],
 ":",
 StyleBox["Bracket:",
  FontWeight->Bold],
 " $\\partial",
 StyleBox["i g",
  FontSlant->Italic],
 "{jl} + \\partial",
 StyleBox["j g",
  FontSlant->Italic],
 "{il} - \\partial",
 StyleBox["l g",
  FontSlant->Italic],
 "{ij} = \\xi\\left[(a",
 StyleBox["j - b",
  FontSlant->Italic],
 "j)\\,H",
 StyleBox["{il} + 2(b",
  FontSlant->Italic],
 "l + l",
 StyleBox["l)\\,H",
  FontSlant->Italic],
 "{ij}\\right]$ "
}], "Text",ExpressionUUID->"9751f245-41b0-4d3a-a83f-7a289656ab78"],

Cell[TextData[{
 "When ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["a", "TI"], "\[LongEqual]", 
         StyleBox["b", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "a = b", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "3b370b07-af31-45e8-a147-adff8c8b25a2"],
 " (symmetric, proper Riemannian): still proportional to $H_{ij}$ \[LongDash] \
no sign change possible"
}], "Item",ExpressionUUID->"4068e17a-3d87-44b1-a34e-f2b1d09a2554"],

Cell[TextData[{
 "When ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["a", "TI"], "\[NotEqual]", 
         StyleBox["b", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "a \\neq b", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "8fa05880-7205-43bc-9741-028657d2f8fe"],
 " (asymmetric): the Hessian correction is NOT proportional to ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["H", "TI"], TraditionalForm], "errors" -> {}, "input" -> "H", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "24dec57c-83d3-4d35-8a79-258179a548f8"],
 " \[LongDash] anisotropic, but metric is not symmetric (not Riemannian)"
}], "Item",ExpressionUUID->"779d2b11-814b-49a5-b996-ac726bd1b9de"],

