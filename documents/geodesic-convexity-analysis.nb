 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"7c4fdfea-f3e3-40f0-bb5a-393a07684800"],

Cell["3. The Riemannian Hessian", "Section",ExpressionUUID->"6cc2b1e9-b7d9-417d-aa9e-820989cef201"],

Cell["The correction term", "Subsection",ExpressionUUID->"9e9a810f-fb82-4445-85de-f723cd55f152"],

Cell[TextData[{
 "The Riemannian Hessian subtracts ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubsuperscriptBox["\[CapitalGamma]", 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"]}], 
          StyleBox["k", "TI"]], 
         SubscriptBox[
          StyleBox["l", "TI"], 
          StyleBox["k", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\Gamma^k_{ij} l_k", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "7397b5b7-e0ec-4b7a-bba0-c301be0b6cee"],
 " from the Euclidean Hessian. Contracting our Christoffel symbol with $l_k$: \
",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubsuperscriptBox["\[CapitalGamma]", 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"]}], 
          StyleBox["k", "TI"]], " ", 
         SubscriptBox[
          StyleBox["l", "TI"], 
          StyleBox["k", "TI"]], "\[LongEqual]", 
         FractionBox[
          RowBox[{"\[Xi] ", 
            SubscriptBox[
             StyleBox["H", "TI"], 
             RowBox[{
               StyleBox["i", "TI"], 
               StyleBox["j", "TI"]}]], " ", 
            SuperscriptBox[
             StyleBox["l", "TI"], 
             StyleBox["k", "TI"]], 
            SubscriptBox[
             StyleBox["l", "TI"], 
             StyleBox["k", "TI"]]}], 
          
          RowBox[{"1", "+", "\[Xi] ", 
            "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", 
            StyleBox["l", "TI"], 
            SubsuperscriptBox[
            "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", "\[Gamma]",
              "2"]}]], "\[LongEqual]", 
         FractionBox[
          
          RowBox[{"\[Xi] ", 
            "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", 
            StyleBox["l", "TI"], 
            SubsuperscriptBox[
            "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", "\[Gamma]",
              "2"]}], 
          
          RowBox[{"1", "+", "\[Xi] ", 
            "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", 
            StyleBox["l", "TI"], 
            SubsuperscriptBox[
            "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", "\[Gamma]",
              "2"]}]], " ", 
         SubscriptBox[
          StyleBox["H", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"]}]]}], TraditionalForm], "errors" -> {}, 
     "input" -> 
     "\\Gamma^k_{ij}\\, l_k = \\frac{\\xi\\, H_{ij}\\, l^k l_k}{1 + \\xi\\, \
|l|_\\gamma^2} = \\frac{\\xi\\, |l|_\\gamma^2}{1 + \\xi\\, |l|_\\gamma^2}\\, \
H_{ij}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "aa6557e3-b3e0-4505-a014-644491a04e8d"],
 "The correction is ",
 StyleBox["proportional to $H_{ij}$",
  FontWeight->Bold],
 " with a scalar coefficient in $[0, 1)$. "
}], "Text",ExpressionUUID->"26ebe54d-225c-4648-bb29-9802c1e57e11"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"correction", "=", 
   RowBox[{
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"chris", "[", 
          RowBox[{"[", 
           RowBox[{"k", ",", "i", ",", "j"}], "]"}], "]"}], "*", 
         RowBox[{"l", "[", 
          RowBox[{"[", "k", "]"}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"k", ",", "2"}], "}"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "2"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"j", ",", "2"}], "}"}]}], "]"}], " ", "//", " ", 
    "Simplify"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"corrFormula", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"xi", "*", 
       RowBox[{"normSq", "/", 
        RowBox[{"(", 
         RowBox[{"1", "+", 
          RowBox[{"xi", "*", "normSq"}]}], ")"}]}]}], ")"}], "*", "hess"}], 
    " ", "//", " ", "Simplify"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Simplify", "[", 
  RowBox[{"correction", "-", "corrFormula"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "0"}], "}"}]}], "}"}], " ", "\[LongDash]", " ", 
    "VERIFIED"}], " ", "*)"}]}]}], "Input",ExpressionUUID->"607b9f01-7b96-\
48ef-954c-c69ab67850f4"],

Cell["The main result", "Subsection",ExpressionUUID->"55ad595a-b615-41b6-96e2-57fdd6898e40"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          RowBox[{"(", 
            RowBox[{
              SubscriptBox[
               StyleBox["Hess", FontSlant -> "Plain"], 
               StyleBox["g", "TI"]], 
              StyleBox["L", "TI"]}], ")"}], 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"]}]], "\[LongEqual]", 
         FractionBox[
          SubscriptBox[
           StyleBox["H", "TI"], 
           RowBox[{
             StyleBox["i", "TI"], 
             StyleBox["j", "TI"]}]], 
          
          RowBox[{"1", "+", "\[Xi] ", 
            "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", 
            StyleBox["l", "TI"], 
            SubsuperscriptBox[
            "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", "\[Gamma]",
              "2"]}]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\boxed{(\\mathrm{Hess}_g L)_{ij} = \\frac{H_{ij}}{1 + \\xi\\, \
|l|_\\gamma^2}}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e8cb2079-08c5-43f1-b30f-889980439ddc"],
 "The Riemannian Hessian is simply the Euclidean Hessian divided by a \
positive scalar ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         RowBox[{"(", 
           
           RowBox[{"1", "+", "\[Xi]", 
             "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", 
             StyleBox["l", "TI"], 
             SubsuperscriptBox[
             "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", 
              "\[Gamma]", "2"]}], ")"}], ">", "1"}], TraditionalForm], 
     "errors" -> {}, "input" -> "(1 + \\xi |l|_\\gamma^2) > 1", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5b3b6228-505f-4b80-8bbe-0fa8b4dbb7fa"],
 ". "
}], "Text",ExpressionUUID->"50075e63-4a45-4ad7-a58f-82c883c72c84"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"rHess", "=", 
   RowBox[{
    RowBox[{"hess", "-", "correction"}], " ", "//", " ", "Simplify"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rHessFormula", "=", 
   RowBox[{
    RowBox[{"hess", "/", 
     RowBox[{"(", 
      RowBox[{"1", "+", 
       RowBox[{"xi", "*", "normSq"}]}], ")"}]}], " ", "//", " ", 
    "Simplify"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Simplify", "[", 
  RowBox[{"rHess", "-", "rHessFormula"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "0"}], "}"}]}], "}"}], " ", "\[LongDash]", " ", 
    "VERIFIED"}], " ", "*)"}]}]}], "Input",ExpressionUUID->"c151db1b-060b-\
4961-8847-37102eeb2c37"],

Cell["What this means", "Subsection",ExpressionUUID->"dfe10c40-70fd-4dd9-875e-395ad3bbfcad"],

Cell[TextData[{
 "Since the scaling factor ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"1", "/", 
         RowBox[{"(", 
           
           RowBox[{"1", "+", "\[Xi]", 
             "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", 
             StyleBox["l", "TI"], 
             SubsuperscriptBox[
             "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", 
              "\[Gamma]", "2"]}], ")"}]}], TraditionalForm], "errors" -> {}, 
     "input" -> "1/(1 + \\xi |l|_\\gamma^2)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "aa4a0dcd-ffdf-47a1-844e-bf55ad67c7a6"],
 " is always ",
 StyleBox["strictly positive",
  FontWeight->Bold],
 ": "
}], "Text",ExpressionUUID->"0b8f9333-7960-4435-bb53-6399ba9c5bff"],

Cell[TextData[{
 "Every eigenvalue of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["Hess", FontSlant -> "Plain"], 
          StyleBox["g", "TI"]], 
         StyleBox["L", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\mathrm{Hess}_g L", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ba44380a-c11d-473d-8aa3-0589a74497dd"],
 " is the corresponding eigenvalue of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["H", "TI"], TraditionalForm], "errors" -> {}, "input" -> "H", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "90cb081d-1d8a-4eb1-b755-cd27b1ead4e7"],
 " divided by the same positive number"
}], "Item",ExpressionUUID->"af38cd57-ec14-4cdc-96cc-0dc5f834b37a"],

Cell[TextData[{
 StyleBox["Eigenvalue signs are preserved",
  FontWeight->Bold],
 " \[LongDash] positive stays positive, negative stays negative"
}], "Item",ExpressionUUID->"70174d30-5a7d-48e0-81fa-da90a5b9fafe"],

Cell[TextData[{
 StyleBox["The condition number is unchanged",
  FontWeight->Bold],
 ": ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> InterpretationBox["", 
       Failure[
       "TeXAssistantError", <|
        "MessageTemplate" -> "Errors: `Errors`", 
         "MessageParameters" -> <|"Errors" -> {}|>, "Input" -> 
         "\\kappa(\\mathrm{Hess}_g L) = \\lambda_\\max / \\lambda_\\min = \
\\kappa(H)"|>]], "errors" -> {}, "input" -> 
     "\\kappa(\\mathrm{Hess}_g L) = \\lambda_\\max / \\lambda_\\min = \
\\kappa(H)", "state" -> "Error"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "758424aa-a651-469d-a29e-1fcc912500e4"]
}], "Item",ExpressionUUID->"5438e98d-c400-4aad-a0a4-998be10e8c6f"],

Cell[TextData[{
 "Geodesic convexity ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[DoubleLeftRightArrow]", TraditionalForm], 
     "errors" -> {}, "input" -> "\\Leftrightarrow", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "cb9b5bd0-bdb7-47d2-8b16-1a2d68e2b4ff"],
 " Euclidean convexity",
 " \[LongDash] the metric cannot make a non-convex function geodesically \
convex"
}], "Item",ExpressionUUID->"408fe8e2-f9a1-46a7-8c29-61439f47a039"],

Cell[TextData[{
 "But the scaling is ",
 StyleBox["position-dependent",
  FontWeight->Bold],
 ": "
}], "Text",ExpressionUUID->"0f4848c4-fc07-4f0d-8fe0-71c0d548599a"],

Cell[TextData[{
 StyleBox["Far from minima",
  FontWeight->Bold],
 " (where ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
        "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", "\[Del]", 
         StyleBox["L", "TI"], 
         "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9"}], 
       TraditionalForm], "errors" -> {}, "input" -> "|\\nabla L|", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "9042b85d-ac03-46ca-8b6b-1e96347b4a88"],
 " is large): strong damping, curvature compressed toward zero"
}], "Item",ExpressionUUID->"cf22da59-f648-4eef-b23f-1a0f3cb13567"],

Cell[TextData[{
 StyleBox["Near minima",
  FontWeight->Bold],
 " (where ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
        "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", "\[Del]", 
         StyleBox["L", "TI"], 
         "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", "\[Rule]", 
         "0"}], TraditionalForm], "errors" -> {}, "input" -> 
     "|\\nabla L| \\to 0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "aacad5cd-fc4c-4fbf-9bb3-9ba89d904204"],
 "): ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["Hess", FontSlant -> "Plain"], 
          StyleBox["g", "TI"]], 
         StyleBox["L", "TI"], "\[Rule]", 
         StyleBox["H", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\mathrm{Hess}_g L \\to H", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ebf7d8db-8270-4043-bd03-a62418a250ef"],
 ", full Euclidean curvature preserved"
}], "Item",ExpressionUUID->"1b4fc2db-2d21-4c1a-b116-7c4f17fdc355"],

Cell[TextData[{
 "This is precisely the ",
 StyleBox["smooth gradient clipping",
  FontWeight->Bold],
 " interpretation of the optimiser. "
}], "Text",ExpressionUUID->"c8755533-ae26-4de0-8fa5-3a529efe03de"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"4cf5a5c7-3be6-4b8a-801c-a077f2121422"],

Cell["4. Verification in n=3", "Section",ExpressionUUID->"de91d353-c1f2-4b3f-bd7f-ccfbac8dac11"],

Cell[TextData[{
 "The result should hold in any dimension. Let's verify in ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["n", "TI"], "\[LongEqual]", "3"}], TraditionalForm], 
     "errors" -> {}, "input" -> "n = 3", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e0408388-e45b-411a-98ae-f11e559098c5"],
 " with a general symmetric Hessian and diagonal ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Gamma]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\gamma", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "2764a209-0904-4dde-b66d-34753065da76"],
 ". "
}], "Text",ExpressionUUID->"d2f47800-acd8-46d2-ab44-c5a43f740d5d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"l3", "=", 
   RowBox[{"{", 
    RowBox[{"la", ",", "lb", ",", "lc"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"hess3", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"Haa", ",", "Hab", ",", "Hac"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"Hab", ",", "Hbb", ",", "Hbc"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"Hac", ",", "Hbc", ",", "Hcc"}], "}"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"gam3", "=", 
   RowBox[{"DiagonalMatrix", "[", 
    RowBox[{"{", 
     RowBox[{"ga", ",", "gb", ",", "gc"}], "}"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"xi", "=", 
    RowBox[{"Symbol", "[", "\"\<xi\>\"", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"g3", "=", 
   RowBox[{"gam3", "+", 
    RowBox[{"xi", "*", 
     RowBox[{"Outer", "[", 
      RowBox[{"Times", ",", "l3", ",", "l3"}], "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"gamInv3", "=", 
   RowBox[{"DiagonalMatrix", "[", 
    RowBox[{"1", "/", 
     RowBox[{"Diagonal", "[", "gam3", "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"lUp3", "=", 
   RowBox[{"gamInv3", " ", ".", " ", "l3"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"normSq3", "=", 
   RowBox[{
    RowBox[{"l3", " ", ".", " ", "gamInv3", " ", ".", " ", "l3"}], " ", "//", 
    " ", "Simplify"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"gInv3", "=", 
    RowBox[{
     RowBox[{"gamInv3", "-", 
      RowBox[{"xi", "*", 
       RowBox[{
        RowBox[{"Outer", "[", 
         RowBox[{"Times", ",", "lUp3", ",", "lUp3"}], "]"}], "/", 
        RowBox[{"(", 
         RowBox[{"1", "+", 
          RowBox[{"xi", "*", "normSq3"}]}], ")"}]}]}]}], " ", "//", " ", 
     "Simplify"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"Verify", " ", "inverse"}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Simplify", "[", 
   RowBox[{"g3", " ", ".", " ", "gInv3"}], "]"}], "==", 
  RowBox[{"IdentityMatrix", "[", "3", "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"(*", " ", "True", " ", "*)"}]}]}], "Input",ExpressionUUID->\
"122e9660-f7f2-4e66-b418-a0f021eadc24"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Bracket", " ", "verification"}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"dg3", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"xi", "*", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"hess3", "[", 
            RowBox[{"[", 
             RowBox[{"k", ",", "i"}], "]"}], "]"}], "*", 
           RowBox[{"l3", "[", 
            RowBox[{"[", "j", "]"}], "]"}]}], "+", 
          RowBox[{
           RowBox[{"l3", "[", 
            RowBox[{"[", "i", "]"}], "]"}], "*", 
           RowBox[{"hess3", "[", 
            RowBox[{"[", 
             RowBox[{"k", ",", "j"}], "]"}], "]"}]}]}], ")"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"k", ",", "3"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "3"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "3"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"bracket3", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"dg3", "[", 
         RowBox[{"[", 
          RowBox[{"i", ",", "j", ",", "ll"}], "]"}], "]"}], "+", 
        RowBox[{"dg3", "[", 
         RowBox[{"[", 
          RowBox[{"j", ",", "i", ",", "ll"}], "]"}], "]"}], "-", 
        RowBox[{"dg3", "[", 
         RowBox[{"[", 
          RowBox[{"ll", ",", "i", ",", "j"}], "]"}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "3"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "3"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"ll", ",", "3"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"expected3", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"2", "*", "xi", "*", 
        RowBox[{"hess3", "[", 
         RowBox[{"[", 
          RowBox[{"i", ",", "j"}], "]"}], "]"}], "*", 
        RowBox[{"l3", "[", 
         RowBox[{"[", "ll", "]"}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "3"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "3"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"ll", ",", "3"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Simplify", "[", 
      RowBox[{"bracket3", "-", "expected3"}], "]"}], " ", "//", " ", 
     "Flatten"}], " ", "//", " ", "DeleteDuplicates"}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"{", "0", "}"}], " ", "\[LongDash]", " ", 
     RowBox[{
      RowBox[{
      "Bracket", " ", "identity", " ", "verified", " ", "in", " ", "n"}], "=",
       "3"}]}], " ", "*)"}]}]}]], "Input",ExpressionUUID->"07ca9559-e13f-4b46-\
b711-b2c31f3299e1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Christoffel", " ", "symbols"}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"chris3", "=", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", "/", "2"}], ")"}], "*", 
           RowBox[{"gInv3", "[", 
            RowBox[{"[", 
             RowBox[{"k", ",", "ll"}], "]"}], "]"}], "*", 
           RowBox[{"bracket3", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", "j", ",", "ll"}], "]"}], "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"ll", ",", "3"}], "}"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"k", ",", "3"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "3"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", "3"}], "}"}]}], "]"}], " ", "//", " ", 
      "Simplify"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"chrisFormula3", "=", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"xi", "*", 
         RowBox[{"hess3", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "j"}], "]"}], "]"}], "*", 
         RowBox[{
          RowBox[{"lUp3", "[", 
           RowBox[{"[", "k", "]"}], "]"}], "/", 
          RowBox[{"(", 
           RowBox[{"1", "+", 
            RowBox[{"xi", "*", "normSq3"}]}], ")"}]}]}], ",", 
        RowBox[{"{", 
         RowBox[{"k", ",", "3"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "3"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", "3"}], "}"}]}], "]"}], " ", "//", " ", 
      "Simplify"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"FullSimplify", "[", 
      RowBox[{"chris3", "-", "chrisFormula3"}], "]"}], " ", "//", " ", 
     "Flatten"}], " ", "//", " ", "DeleteDuplicates"}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"{", "0", "}"}], " ", "\[LongDash]", " ", 
     RowBox[{
      RowBox[{
      "Christoffel", " ", "formula", " ", "verified", " ", "in", " ", "n"}], "=",
       "3"}]}], " ", "*)"}]}]}]], "Input",ExpressionUUID->"9bd6e4f9-feb3-46e7-\
992f-d1ca7cb84908"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Riemannian", " ", "Hessian"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"correction3", "=", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"chris3", "[", 
            RowBox[{"[", 
             RowBox[{"k", ",", "i", ",", "j"}], "]"}], "]"}], "*", 
           RowBox[{"l3", "[", 
            RowBox[{"[", "k", "]"}], "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"k", ",", "3"}], "}"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "3"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", "3"}], "}"}]}], "]"}], " ", "//", " ", 
      "FullSimplify"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"rHess3", "=", 
     RowBox[{
      RowBox[{"hess3", "-", "correction3"}], " ", "//", " ", 
      "FullSimplify"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"rHessFormula3", "=", 
     RowBox[{
      RowBox[{"hess3", "/", 
       RowBox[{"(", 
        RowBox[{"1", "+", 
         RowBox[{"xi", "*", "normSq3"}]}], ")"}]}], " ", "//", " ", 
      "FullSimplify"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"FullSimplify", "[", 
      RowBox[{"rHess3", "-", "rHessFormula3"}], "]"}], " ", "//", " ", 
     "Flatten"}], " ", "//", " ", "DeleteDuplicates"}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"{", "0", "}"}], " ", "\[LongDash]", " ", 
     RowBox[{
      RowBox[{
      "Riemannian", " ", "Hessian", " ", "formula", " ", "verified", " ", 
       "in", " ", "n"}], "=", "3"}]}], " ", "*)"}]}]}]], "Input",ExpressionUUI\
D->"08df636d-3442-4cf4-8167-ed8ea954f6e6"],

Cell[TextData[{
 "All four identities hold in ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["n", "TI"], "\[LongEqual]", "3"}], TraditionalForm], 
     "errors" -> {}, "input" -> "n = 3", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "13348bdf-1131-40aa-89c0-b019ca1f3a98"],
 ". The proofs are dimension-independent (they only use index contractions \
and Sherman\[Dash]Morrison), so this confirms they hold for general ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["N", "TI"], TraditionalForm], "errors" -> {}, "input" -> "N", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "52d30375-781e-4ae4-9ff6-03aeef4ec435"],
 ". "
}], "Text",ExpressionUUID->"288ac71b-3524-4780-9eb6-7e9a8ddbec79"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
