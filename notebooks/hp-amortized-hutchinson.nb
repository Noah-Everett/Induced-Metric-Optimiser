          "886cf743-d7e7-4e3f-b89f-798b3e2d164b"], "\<\"4586\"\>", \
"\<\"2866\"\>", "\<\"2776\"\>", "\<\"2930\"\>", "\<\"3640\"\>", "\<\"10\"\>", \
"\<\"1.65\[Times]\"\>"}
       },
       GridBoxAlignment->{
        "Columns" -> {
          Center, Center, Center, Center, Center, Center, Center, {Center}}, 
         "Rows" -> {{Baseline}}},
       GridBoxDividers->{
        "Columns" -> {{False}}, "Rows" -> {False, True, {False}, False}},
       GridBoxSpacings->{"Columns" -> {
           Offset[0.27999999999999997`], {
            Offset[2.0999999999999996`]}, 
           Offset[0.27999999999999997`]}, "Rows" -> {
           Offset[0.2], {
            Offset[0.4]}, 
           Offset[0.2]}}],
      {None, OutputFormsDump`HeadedColumns}],
     Function[BoxForm`e$, 
      TableForm[
      BoxForm`e$, 
       TableHeadings -> {
        None, {"Target", "k=1", "k=5", "k=10", "k=20", "k=50", "best k", 
          "speedup"}}]]], "Text",
