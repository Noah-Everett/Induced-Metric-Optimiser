 PaneBox[
  PaneBox[
   StyleBox[
    TagBox[
     TagBox[GridBox[{
        {
         TagBox["\<\"Target\"\>",
          HoldForm], 
         TagBox["\<\"k=1\"\>",
          HoldForm], 
         TagBox["\<\"k=5\"\>",
          HoldForm], 
