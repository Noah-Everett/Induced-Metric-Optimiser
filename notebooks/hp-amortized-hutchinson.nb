Cell["\<\
For typical NN training, k=10-50 captures most of the theoretical 2\[Times] \
savings. \
\>", "Text",ExpressionUUID->"d5f39bff-fd35-4961-b113-48840d2c38f4"],

Cell["Part VIII: EMA Tracking Error on Cubic", "Section",ExpressionUUID->"c7c50ee2-235b-4adf-8ce2-b9fdd8878cd0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Measure", " ", "how", " ", "well", " ", "the", " ", "EMA", " ", "tracks", 
    " ", "the", " ", "changing", " ", "Newton", " ", "target"}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"SeedRandom", "[", "42", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"n", "=", "10"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"hBase", "=", 
     RowBox[{"Exp", "[", 
      RowBox[{"Range", "[", 
       RowBox[{"0.", ",", 
        RowBox[{"Log", "[", "100.", "]"}], ",", 
        RowBox[{
         RowBox[{"Log", "[", "100.", "]"}], "/", "9"}]}], "]"}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"a", "=", 
     RowBox[{"RandomReal", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "1."}], ",", "1."}], "}"}], ",", "n"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"hessDiagC", "[", "\[Theta]_", "]"}], ":=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"hBase", "[", 
         RowBox[{"[", "i", "]"}], "]"}], "+", 
        RowBox[{
         RowBox[{"a", "[", 
          RowBox[{"[", "i", "]"}], "]"}], " ", 
         RowBox[{"\[Theta]", "[", 
          RowBox[{"[", "i", "]"}], "]"}]}]}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "n"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"gradFC", "[", "\[Theta]_", "]"}], ":=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"hBase", "[", 
          RowBox[{"[", "i", "]"}], "]"}], " ", 
         RowBox[{"\[Theta]", "[", 
          RowBox[{"[", "i", "]"}], "]"}]}], "+", 
        RowBox[{"0.5", " ", 
         RowBox[{"a", "[", 
          RowBox[{"[", "i", "]"}], "]"}], " ", 
         RowBox[{
          RowBox[{"\[Theta]", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "^", "2"}]}]}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "n"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Alpha]", "=", "0.001"}], ";", " ", 
    RowBox[{"\[Beta]s", "=", "0.05"}], ";", " ", 
    RowBox[{"cc", "=", "3."}], ";", " ", 
    RowBox[{"\[Epsilon]", "=", "1.*^-8"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"clipCenter", "[", 
      RowBox[{"s_", ",", "c_"}], "]"}], ":=", 
     RowBox[{"Clip", "[", 
      RowBox[{
       RowBox[{"s", "-", 
        RowBox[{"Mean", "[", "s", "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "c"}], ",", "c"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<EMA tracking error (max_i |s_i - s_ideal_i|):\>\"", 
     "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"Do", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"SeedRandom", "[", "100", "]"}], ";", "\[IndentingNewLine]", 
      "  ", 
      RowBox[{"s", "=", 
       RowBox[{"ConstantArray", "[", 
        RowBox[{"0.", ",", "n"}], "]"}]}], ";", " ", 
      RowBox[{"\[Theta]", "=", 
       RowBox[{"RandomReal", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "0.5"}], ",", "0.5"}], "}"}], ",", "n"}], "]"}]}], ";",
       "\[IndentingNewLine]", "  ", 
      RowBox[{"trackingErrors", "=", 
       RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", "  ", 
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"g", "=", 
          RowBox[{"gradFC", "[", "\[Theta]", "]"}]}], ";", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"hNow", "=", 
          RowBox[{"hessDiagC", "[", "\[Theta]", "]"}]}], ";", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"sIdeal", "=", 
          RowBox[{"-", 
           RowBox[{"Log", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Max", "[", 
               RowBox[{"#", ",", "\[Epsilon]"}], "]"}], " ", "&"}], " ", "/@",
              " ", "hNow"}], "]"}]}]}], ";", "\[IndentingNewLine]", "    ", 
         RowBox[{"sIdeal", "=", 
          RowBox[{"Clip", "[", 
           RowBox[{
            RowBox[{"sIdeal", "-", 
             RowBox[{"Mean", "[", "sIdeal", "]"}]}], ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "cc"}], ",", "cc"}], "}"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Mod", "[", 
             RowBox[{
              RowBox[{"t", "-", "1"}], ",", "kVal"}], "]"}], "==", "0"}], ",",
            "\[IndentingNewLine]", "      ", 
           RowBox[{
            RowBox[{"target", "=", 
             RowBox[{"-", 
              RowBox[{"Log", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"Max", "[", 
                  RowBox[{"#", ",", "\[Epsilon]"}], "]"}], " ", "&"}], " ", "/@",
                 " ", "hNow"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
            "      ", 
            RowBox[{"s", "=", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{"1", "-", "\[Beta]s"}], ")"}], " ", "s"}], "+", 
              RowBox[{"\[Beta]s", "*", "target"}]}]}], ";", " ", 
            RowBox[{"s", "=", 
             RowBox[{"clipCenter", "[", 
              RowBox[{"s", ",", "cc"}], "]"}]}]}]}], "]"}], ";", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"t", ">", "100"}], ",", 
           RowBox[{"AppendTo", "[", 
            RowBox[{"trackingErrors", ",", 
             RowBox[{"Max", "[", 
              RowBox[{"Abs", "[", 
               RowBox[{"s", "-", "sIdeal"}], "]"}], "]"}]}], "]"}]}], "]"}], ";",
          "\[IndentingNewLine]", "    ", 
         RowBox[{"\[Theta]", "=", 
          RowBox[{"\[Theta]", "-", 
           RowBox[{"\[Alpha]", " ", 
            RowBox[{"Exp", "[", "s", "]"}], " ", "g"}]}]}]}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"{", 
         RowBox[{"t", ",", "5000"}], "}"}]}], "]"}], ";", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<k=\>\"", ",", "kVal", ",", "\"\<: mean=\>\"", ",", 
        RowBox[{"ScientificForm", "[", 
         RowBox[{
          RowBox[{"Mean", "[", "trackingErrors", "]"}], ",", "3"}], "]"}], ",",
         "\[IndentingNewLine]", "    ", "\"\<, 95th pct=\>\"", ",", 
        RowBox[{"ScientificForm", "[", 
         RowBox[{
          RowBox[{"Quantile", "[", 
           RowBox[{"trackingErrors", ",", "0.95"}], "]"}], ",", "3"}], "]"}], 
        ",", "\[IndentingNewLine]", "    ", "\"\<, max=\>\"", ",", 
        RowBox[{"ScientificForm", "[", 
         RowBox[{
          RowBox[{"Max", "[", "trackingErrors", "]"}], ",", "3"}], "]"}]}], 
       "]"}]}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"{", 
      RowBox[{"kVal", ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "5", ",", "10", ",", "20", ",", "50"}], "}"}]}], 
      "}"}]}], "]"}]}]}]], "Input",ExpressionUUID->"695854f9-2a58-40da-b102-\
8d1a2eb1276d"],

Cell[TextData[StyleBox["Result:",
 FontWeight->Bold]], "Text",ExpressionUUID->"802c28c8-bfdb-4a00-9126-38c83caf9bac"],

