Cell[TextData[{
 "The formula ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["k", "TI"], "*"], "\[LongEqual]", 
         SqrtBox[
          RowBox[{
            SubscriptBox[
             StyleBox["T", "TI"], 
             StyleBox["GE", FontSlant -> "Plain"]], "\[CenterDot]", 
            SubscriptBox["\[Beta]", 
             StyleBox["s", "TI"]], "/", "2"}]]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "k^* = \\sqrt{T_{\\mathrm{GE}} \\cdot \\beta_s / 2}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "82231b37-25da-4dfa-9f72-e6488c87bdd9"],
 " captures the correct scaling. The numerical optimum is slightly higher \
because the formula's constant-rate approximation underestimates the \
transient's impact at large k. "
}], "Text",ExpressionUUID->"65cfb58a-5b97-4f66-808a-2e5948684f62"],

Cell["Part V: Hessian Drift Analysis (Beyond Quadratics)", "Section",ExpressionUUID->"2278e16f-2b29-4c23-a6da-56f5e32912a6"],

Cell[TextData[{
 "On a cubic loss ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       FractionBox[
        FractionBox[
         RowBox[{
           StyleBox["L", "TI"], "\[LongEqual]", "1"}], 
         RowBox[{"2", 
           SuperscriptBox["\[Theta]", 
            StyleBox["H", "TI"]], "\[Theta]", "+", "1"}]], 
        RowBox[{"6", 
          UnderscriptBox["\[Sum]", 
           StyleBox["i", "TI"], LimitsPositioning -> True], 
          SubscriptBox[
           StyleBox["a", "TI"], 
           StyleBox["i", "TI"]], 
          SubsuperscriptBox["\[Theta]", 
           StyleBox["i", "TI"], "3"]}]], TraditionalForm], "errors" -> {}, 
     "input" -> 
     "L = \\tfrac{1}{2}\\theta^\\top H\\theta + \\tfrac{1}{6}\\sum_i a_i \
\\theta_i^3", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "3f11e52c-ec40-45e9-9b43-59e7adf4c377"],
 ", the Hessian is position-dependent: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["H", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["i", "TI"]}]], 
         RowBox[{"(", "\[Theta]", ")"}], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["h", "TI"], 
          StyleBox["i", "TI"]], "+", 
         SubscriptBox[
          StyleBox["a", "TI"], 
          StyleBox["i", "TI"]], 
         SubscriptBox["\[Theta]", 
          StyleBox["i", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "H_{ii}(\\theta) = h_i + a_i\\theta_i", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "93d09c07-07a4-4183-8a17-42565bf6fd43"],
 ". The Hessian Lipschitz constant is ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["L", "TI"], 
          StyleBox["H", "TI"]], "\[LongEqual]", 
         UnderscriptBox["max", 
          StyleBox["i", "TI"], LimitsPositioning -> True], "|", 
         SubscriptBox[
          StyleBox["a", "TI"], 
          StyleBox["i", "TI"]], "|"}], TraditionalForm], "errors" -> {}, 
     "input" -> "L_H = \\max_i |a_i|", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a3055b06-8595-4577-aba5-fb13eda2595a"],
 ".",
 StyleBox["Theorem 3 (staleness bound).",
  FontWeight->Bold],
 " Over k steps: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"|", 
         SubscriptBox[
          StyleBox["H", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["i", "TI"]}]], 
         RowBox[{"(", 
           SuperscriptBox["\[Theta]", 
            RowBox[{
              StyleBox["t", "TI"], "+", 
              StyleBox["k", "TI"]}]], ")"}], "-", 
         SubscriptBox[
          StyleBox["H", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["i", "TI"]}]], 
         RowBox[{"(", 
           SuperscriptBox["\[Theta]", 
            StyleBox["t", "TI"]], ")"}], "|", "\[LessEqual]", 
         SubscriptBox[
          StyleBox["L", "TI"], 
          StyleBox["H", "TI"]], "\[CenterDot]", 
         StyleBox["k", "TI"], "\[CenterDot]", "\[Eta]", "\[CenterDot]", 
         SuperscriptBox[
          StyleBox["e", "TI"], 
          StyleBox["c", "TI"]], "\[CenterDot]", 
         "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", 
         StyleBox["g", "TI"], 
         "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9"}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "|H_{ii}(\\theta^{t+k}) - H_{ii}(\\theta^t)| \\leq L_H \\cdot k \\cdot \
\\eta \\cdot e^c \\cdot |g|", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "bd003b96-be9d-4569-a9b0-736c155e288e"],
 "The relative staleness error is: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Delta]", 
          StyleBox["stale", FontSlant -> "Plain"]], "\[LessEqual]", 
         FractionBox[
          RowBox[{
            SubscriptBox[
             StyleBox["L", "TI"], 
             StyleBox["H", "TI"]], "\[CenterDot]", 
            StyleBox["k", "TI"], "\[CenterDot]", "\[Eta]", "\[CenterDot]", 
            SuperscriptBox[
             StyleBox["e", "TI"], 
             StyleBox["c", "TI"]], "\[CenterDot]", 
            "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", 
            StyleBox["g", "TI"], 
            "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9"}], 
          SubscriptBox[
           StyleBox["h", "TI"], "min"]]}], TraditionalForm], "errors" -> {}, 
     "input" -> 
     "\\delta_{\\mathrm{stale}} \\leq \\frac{L_H \\cdot k \\cdot \\eta \\cdot \
e^c \\cdot |g|}{h_{\\min}}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "49278f7a-7680-4ae3-9b31-bc1ed759be8f"]
}], "Text",ExpressionUUID->"c0d0709a-66f3-4329-9cfb-49fd608a0bb6"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Verify", " ", "staleness", " ", "bound", " ", "on", " ", "cubic"}], " ", 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"SeedRandom", "[", "42", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"n", "=", "10"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"hBase", "=", 
     RowBox[{"Exp", "[", 
      RowBox[{"Range", "[", 
       RowBox[{"0.", ",", 
        RowBox[{"Log", "[", "100.", "]"}], ",", 
        RowBox[{
         RowBox[{"Log", "[", "100.", "]"}], "/", "9"}]}], "]"}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"a", "=", 
     RowBox[{"RandomReal", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "1."}], ",", "1."}], "}"}], ",", "n"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"lH", "=", 
     RowBox[{"Max", "[", 
      RowBox[{"Abs", "[", "a", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"hessDiagC", "[", "\[Theta]_", "]"}], ":=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"hBase", "[", 
         RowBox[{"[", "i", "]"}], "]"}], "+", 
        RowBox[{
         RowBox[{"a", "[", 
          RowBox[{"[", "i", "]"}], "]"}], " ", 
         RowBox[{"\[Theta]", "[", 
          RowBox[{"[", "i", "]"}], "]"}]}]}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "n"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"gradFC", "[", "\[Theta]_", "]"}], ":=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"hBase", "[", 
          RowBox[{"[", "i", "]"}], "]"}], " ", 
         RowBox[{"\[Theta]", "[", 
          RowBox[{"[", "i", "]"}], "]"}]}], "+", 
        RowBox[{"0.5", " ", 
         RowBox[{"a", "[", 
          RowBox[{"[", "i", "]"}], "]"}], " ", 
         RowBox[{
          RowBox[{"\[Theta]", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "^", "2"}]}]}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "n"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Alpha]", "=", "0.001"}], ";", " ", 
    RowBox[{"\[Beta]s", "=", "0.05"}], ";", " ", 
    RowBox[{"cc", "=", "3."}], ";", " ", 
    RowBox[{"\[Epsilon]", "=", "1.*^-8"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"clipCenter", "[", 
      RowBox[{"s_", ",", "c_"}], "]"}], ":=", 
     RowBox[{"Clip", "[", 
      RowBox[{
       RowBox[{"s", "-", 
        RowBox[{"Mean", "[", "s", "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "c"}], ",", "c"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<L_H = \>\"", ",", 
      RowBox[{"NumberForm", "[", 
       RowBox[{"lH", ",", "4"}], "]"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"Do", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"SeedRandom", "[", "100", "]"}], ";", "\[IndentingNewLine]", 
      "  ", 
      RowBox[{"s", "=", 
       RowBox[{"ConstantArray", "[", 
        RowBox[{"0.", ",", "n"}], "]"}]}], ";", " ", 
      RowBox[{"\[Theta]", "=", 
       RowBox[{"RandomReal", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "0.5"}], ",", "0.5"}], "}"}], ",", "n"}], "]"}]}], ";",
       "\[IndentingNewLine]", "  ", 
      RowBox[{"drifts", "=", 
       RowBox[{"{", "}"}]}], ";", " ", 
      RowBox[{"bounds", "=", 
       RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", "  ", 
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"g", "=", 
          RowBox[{"gradFC", "[", "\[Theta]", "]"}]}], ";", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Mod", "[", 
             RowBox[{
              RowBox[{"t", "-", "1"}], ",", "kVal"}], "]"}], "==", "0"}], ",",
            "\[IndentingNewLine]", "      ", 
           RowBox[{
            RowBox[{"hEst", "=", 
             RowBox[{"hessDiagC", "[", "\[Theta]", "]"}]}], ";", 
            "\[IndentingNewLine]", "      ", 
            RowBox[{"target", "=", 
             RowBox[{"-", 
              RowBox[{"Log", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"Max", "[", 
                  RowBox[{"#", ",", "\[Epsilon]"}], "]"}], " ", "&"}], " ", "/@",
                 " ", "hEst"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
            "      ", 
            RowBox[{"s", "=", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{"1", "-", "\[Beta]s"}], ")"}], " ", "s"}], "+", 
              RowBox[{"\[Beta]s", "*", "target"}]}]}], ";", " ", 
            RowBox[{"s", "=", 
             RowBox[{"clipCenter", "[", 
              RowBox[{"s", ",", "cc"}], "]"}]}]}]}], "]"}], ";", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"hOld", "=", 
          RowBox[{"hessDiagC", "[", "\[Theta]", "]"}]}], ";", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"\[Theta]", "=", 
          RowBox[{"\[Theta]", "-", 
           RowBox[{"\[Alpha]", " ", 
            RowBox[{"Exp", "[", "s", "]"}], " ", "g"}]}]}], ";", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"Mod", "[", 
              RowBox[{"t", ",", "kVal"}], "]"}], "==", "0"}], "&&", 
            RowBox[{"t", ">", "kVal"}]}], ",", "\[IndentingNewLine]", 
           "      ", 
           RowBox[{
            RowBox[{"hNew", "=", 
             RowBox[{"hessDiagC", "[", "\[Theta]", "]"}]}], ";", 
            "\[IndentingNewLine]", "      ", 
            RowBox[{"AppendTo", "[", 
             RowBox[{"drifts", ",", 
              RowBox[{"Max", "[", 
               RowBox[{
                RowBox[{"Abs", "[", 
                 RowBox[{"hNew", "-", "hOld"}], "]"}], "/", 
                RowBox[{"Abs", "[", "hOld", "]"}]}], "]"}]}], "]"}], ";", 
            "\[IndentingNewLine]", "      ", 
            RowBox[{"AppendTo", "[", 
             RowBox[{"bounds", ",", 
              RowBox[{"lH", "*", "kVal", "*", "\[Alpha]", "*", 
               RowBox[{"Exp", "[", "cc", "]"}], "*", 
               RowBox[{
                RowBox[{"Norm", "[", "g", "]"}], "/", 
                RowBox[{"Min", "[", 
                 RowBox[{"Abs", "[", "hOld", "]"}], "]"}]}]}]}], "]"}]}]}], 
          "]"}]}], ",", "\[IndentingNewLine]", "    ", 
        RowBox[{"{", 
         RowBox[{"t", ",", "5000"}], "}"}]}], "]"}], ";", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<k=\>\"", ",", "kVal", ",", "\"\<: actual drift mean=\>\"",
         ",", 
        RowBox[{"ScientificForm", "[", 
         RowBox[{
          RowBox[{"Mean", "[", "drifts", "]"}], ",", "3"}], "]"}], ",", 
        "\[IndentingNewLine]", "    ", "\"\<, bound mean=\>\"", ",", 
        RowBox[{"ScientificForm", "[", 
         RowBox[{
          RowBox[{"Mean", "[", "bounds", "]"}], ",", "3"}], "]"}], ",", 
        "\[IndentingNewLine]", "    ", "\"\< (bound is \>\"", ",", 
        RowBox[{"NumberForm", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Mean", "[", "bounds", "]"}], "/", 
           RowBox[{"Mean", "[", "drifts", "]"}]}], ",", "3"}], "]"}], 
        ",", "\"\<\[Times] conservative)\>\""}], "]"}]}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"{", 
      RowBox[{"kVal", ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "5", ",", "10", ",", "20", ",", "50"}], "}"}]}], 
      "}"}]}], "]"}]}]}]], "Input",ExpressionUUID->"5ba5e895-1a20-4170-8ecc-\
6cd02592319e"],

