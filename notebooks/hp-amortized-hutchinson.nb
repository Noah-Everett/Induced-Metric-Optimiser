Cell["Part III: Convergence Speedup on Quadratic", "Section",ExpressionUUID->"8388c9c3-9c4b-4ffe-a8bf-cc34ef85d4d9"],

Cell["\<\
On a quadratic with fixed compute budget (gradient evaluations), k>1 is more \
efficient because it avoids wasting half the budget on Hutchinson. \
\>", "Text",ExpressionUUID->"00fa9e04-235e-4395-ad2e-44a342f0137b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Quadratic", ":", " ", 
    RowBox[{
    "gradient", " ", "evaluations", " ", "to", " ", "reach", " ", "target", " ",
      "loss", " ", "for", " ", "each", " ", "k"}]}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"SeedRandom", "[", "42", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"n", "=", "10"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"h", "=", 
     RowBox[{"Exp", "[", 
      RowBox[{"Range", "[", 
       RowBox[{"0.", ",", 
        RowBox[{"Log", "[", "100.", "]"}], ",", 
        RowBox[{
         RowBox[{"Log", "[", "100.", "]"}], "/", "9"}]}], "]"}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Hoff", "=", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{"0.", ",", 
       RowBox[{"{", 
        RowBox[{"n", ",", "n"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"i", "<", "j"}], ",", "\[IndentingNewLine]", "  ", 
        RowBox[{
         RowBox[{
          RowBox[{"Hoff", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", "j"}], "]"}], "]"}], "=", 
          RowBox[{"0.1", " ", 
           RowBox[{"RandomReal", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "1"}], ",", "1"}], "}"}], "]"}], " ", 
           RowBox[{
            RowBox[{"Sqrt", "[", 
             RowBox[{
              RowBox[{"h", "[", 
               RowBox[{"[", "i", "]"}], "]"}], " ", 
              RowBox[{"h", "[", 
               RowBox[{"[", "j", "]"}], "]"}]}], "]"}], "/", 
            RowBox[{"(", 
             RowBox[{"n", "-", "1"}], ")"}]}]}]}], ";", "\[IndentingNewLine]",
          "  ", 
         RowBox[{
          RowBox[{"Hoff", "[", 
           RowBox[{"[", 
            RowBox[{"j", ",", "i"}], "]"}], "]"}], "=", 
          RowBox[{"Hoff", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", "j"}], "]"}], "]"}]}]}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "n"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"j", ",", "n"}], "}"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
   
   RowBox[{
    RowBox[{"Hfull", "=", 
     RowBox[{
      RowBox[{"DiagonalMatrix", "[", "h", "]"}], "+", "Hoff"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Hfull", "=", 
     RowBox[{"Hfull", "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Max", "[", 
          RowBox[{"0", ",", 
           RowBox[{"-", 
            RowBox[{"Min", "[", 
             RowBox[{"Eigenvalues", "[", "Hfull", "]"}], "]"}]}]}], "]"}], "+",
          "0.01"}], ")"}], " ", 
       RowBox[{"IdentityMatrix", "[", "n", "]"}]}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Beta]s", "=", "0.05"}], ";", " ", 
    RowBox[{"\[Epsilon]", "=", "1.*^-8"}], ";", " ", 
    RowBox[{"\[Alpha]", "=", "0.005"}], ";", " ", 
    RowBox[{"cc", "=", "3."}], ";", " ", 
    RowBox[{"nSteps", "=", "5000"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"clipCenter", "[", 
      RowBox[{"s_", ",", "c_"}], "]"}], ":=", 
     RowBox[{"Clip", "[", 
      RowBox[{
       RowBox[{"s", "-", 
        RowBox[{"Mean", "[", "s", "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "c"}], ",", "c"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"geData", "=", 
     RowBox[{"Association", "[", "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"SeedRandom", "[", "100", "]"}], ";", "\[IndentingNewLine]", 
       "  ", 
       RowBox[{"s", "=", 
        RowBox[{"ConstantArray", "[", 
         RowBox[{"0.", ",", "n"}], "]"}]}], ";", " ", 
       RowBox[{"\[Theta]", "=", 
        RowBox[{"RandomReal", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", "n"}], "]"}]}], ";", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"gradEvals", "=", "0"}], ";", " ", 
       RowBox[{"curve", "=", 
        RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", "  ", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"l", "=", 
           RowBox[{"0.5", " ", 
            RowBox[{"\[Theta]", ".", "Hfull", ".", "\[Theta]"}]}]}], ";", " ", 
          RowBox[{"g", "=", 
           RowBox[{"Hfull", ".", "\[Theta]"}]}], ";", " ", 
          RowBox[{"gradEvals", " ", "+=", " ", "1"}], ";", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Mod", "[", 
              RowBox[{
               RowBox[{"t", "-", "1"}], ",", "kVal"}], "]"}], "==", "0"}], ",",
             "\[IndentingNewLine]", "      ", 
            RowBox[{
             RowBox[{"v", "=", 
              RowBox[{
               RowBox[{"2.", " ", 
                RowBox[{"RandomInteger", "[", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{"0", ",", "1"}], "}"}], ",", "n"}], "]"}]}], "-", 
               "1."}]}], ";", "\[IndentingNewLine]", "      ", 
             RowBox[{"hEst", "=", 
              RowBox[{"v", "*", 
               RowBox[{"(", 
                RowBox[{"Hfull", ".", "v"}], ")"}]}]}], ";", " ", 
             RowBox[{"gradEvals", " ", "+=", " ", "1"}], ";", 
             "\[IndentingNewLine]", "      ", 
             RowBox[{"target", "=", 
              RowBox[{"-", 
               RowBox[{"Log", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"Max", "[", 
                   RowBox[{"#", ",", "\[Epsilon]"}], "]"}], " ", "&"}], " ", "/@",
                  " ", "hEst"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
             "      ", 
             RowBox[{"s", "=", 
              RowBox[{
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"1", "-", "\[Beta]s"}], ")"}], " ", "s"}], "+", 
               RowBox[{"\[Beta]s", "*", "target"}]}]}], ";", " ", 
             RowBox[{"s", "=", 
              RowBox[{"clipCenter", "[", 
               RowBox[{"s", ",", "cc"}], "]"}]}]}]}], "]"}], ";", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"\[Theta]", "=", 
           RowBox[{"\[Theta]", "-", 
            RowBox[{"\[Alpha]", " ", 
             RowBox[{"Exp", "[", "s", "]"}], " ", "g"}]}]}], ";", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"curve", ",", 
            RowBox[{"{", 
             RowBox[{"gradEvals", ",", "l"}], "}"}]}], "]"}]}], ",", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"{", 
          RowBox[{"t", ",", "nSteps"}], "}"}]}], "]"}], ";", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{
        RowBox[{"geData", "[", "kVal", "]"}], "=", "curve"}]}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"{", 
       RowBox[{"kVal", ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "5", ",", "10", ",", "20", ",", "50"}], "}"}]}], 
       "}"}]}], "]"}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Compute", " ", "GE", " ", "to", " ", "reach", " ", "target", " ", 
     "losses"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"targets", "=", 
     RowBox[{"{", 
      RowBox[{"1.*^-10", ",", "1.*^-20", ",", "1.*^-50", ",", "1.*^-100"}], 
      "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<QUADRATIC: Gradient evaluations to reach target \
loss:\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Target     | k=1    | k=5    | k=10   | k=20   | k=50  \
 | best k | speedup\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"Do", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"bestGE", "=", "Infinity"}], ";", " ", 
      RowBox[{"bestK", "=", "1"}], ";", " ", 
      RowBox[{"geForK", "=", 
       RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", "  ", 
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"curve", "=", 
          RowBox[{"geData", "[", "kVal", "]"}]}], ";", "\[IndentingNewLine]", 
         "    ", 
         RowBox[{"hit", "=", 
          RowBox[{"Select", "[", 
           RowBox[{"curve", ",", 
            RowBox[{
             RowBox[{
              RowBox[{"#", "[", 
               RowBox[{"[", "2", "]"}], "]"}], "<=", "tgt"}], " ", "&"}]}], 
           "]"}]}], ";", "\[IndentingNewLine]", "    ", 
         RowBox[{"ge", "=", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Length", "[", "hit", "]"}], ">", "0"}], ",", 
            RowBox[{"hit", "[", 
             RowBox[{"[", 
              RowBox[{"1", ",", "1"}], "]"}], "]"}], ",", "Infinity"}], 
           "]"}]}], ";", "\[IndentingNewLine]", "    ", 
         RowBox[{"AppendTo", "[", 
          RowBox[{"geForK", ",", "ge"}], "]"}], ";", "\[IndentingNewLine]", 
         "    ", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"ge", "<", "bestGE"}], ",", 
           RowBox[{
            RowBox[{"bestGE", "=", "ge"}], ";", " ", 
            RowBox[{"bestK", "=", "kVal"}]}]}], "]"}]}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"{", 
         RowBox[{"kVal", ",", 
          RowBox[{"{", 
           RowBox[{"1", ",", "5", ",", "10", ",", "20", ",", "50"}], "}"}]}], 
         "}"}]}], "]"}], ";", "\[IndentingNewLine]", "  ", 
      RowBox[{"geK1", "=", 
       RowBox[{"geForK", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", "  ", 
      RowBox[{"speedup", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"bestGE", "<", "Infinity"}], "&&", 
          RowBox[{"geK1", "<", "Infinity"}]}], ",", 
         RowBox[{"N", "[", 
          RowBox[{"geK1", "/", "bestGE"}], "]"}], ",", "\"\<N/A\>\""}], 
        "]"}]}], ";", "\[IndentingNewLine]", "  ", 
      RowBox[{"Print", "[", 
       RowBox[{
        RowBox[{"ScientificForm", "[", 
         RowBox[{"tgt", ",", "1"}], "]"}], ",", "\"\< | \>\"", ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"StringJoin", "[", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"geForK", "[", 
                RowBox[{"[", "i", "]"}], "]"}], "<", "Infinity"}], ",", 
              "\[IndentingNewLine]", "      ", 
              RowBox[{"ToString", "[", 
               RowBox[{"PaddedForm", "[", 
                RowBox[{
                 RowBox[{"geForK", "[", 
                  RowBox[{"[", "i", "]"}], "]"}], ",", "7"}], "]"}], "]"}], 
              ",", "\"\<    inf\>\""}], "]"}], " ", "<>", 
            " ", "\"\< | \>\""}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "5"}], "}"}]}], "]"}], "]"}], ",", 
        "\[IndentingNewLine]", "    ", "bestK", ",", "\"\<      | \>\"", ",", 
        
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"NumberQ", "[", "speedup", "]"}], ",", 
          RowBox[{
           RowBox[{"ToString", "[", 
            RowBox[{"NumberForm", "[", 
             RowBox[{"speedup", ",", "3"}], "]"}], "]"}], " ", "<>", 
           " ", "\"\<\[Times]\>\""}], ",", "speedup"}], "]"}]}], "]"}]}], ",",
      "\[IndentingNewLine]", "  ", 
     RowBox[{"{", 
      RowBox[{"tgt", ",", "targets"}], "}"}]}], "]"}]}]}]], "Input",Expression\
UUID->"2a1ddc41-df03-44d9-b9e3-c587c776aa5c"],

Cell[TextData[StyleBox["Key result:",
 FontWeight->Bold]], "Text",ExpressionUUID->"47a3b946-15f1-4e21-b9e0-49a8516c1abe"],

