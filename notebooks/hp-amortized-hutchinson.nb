Cell[TextData[{
 "From the robustness theorem (IMO-85): even with ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Delta]", "\[LongEqual]", "0.5"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\delta = 0.5", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "86b12037-2545-421a-b5c0-4d6e8ad994d9"],
 " (50% relative error), the preconditioner achieves ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Kappa]", 
          StyleBox["prec", FontSlant -> "Plain"]], "\[LessEqual]", "3"}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\kappa_{\\mathrm{prec}} \\leq 3", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "906e2ff4-39da-4e6b-9db4-8280f8871559"],
 ". So the tracking error for k=10-20 is well within the safe regime. "
}], "Text",ExpressionUUID->"82ae1ee7-7d26-41ef-946b-c04f8c43b411"],

