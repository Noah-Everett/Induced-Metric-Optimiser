Cell[TextData[{
 "The cubic results are nearly identical to the quadratic: ",
 StyleBox["staleness is negligible and k=5-20 gives 1.65-1.78\[Times] speedup",
  FontWeight->Bold],
 ". "
}], "Text",ExpressionUUID->"36d972ba-089e-4b1e-89e5-a42cc5230e4f"],

Cell["Part VII: Optimal k Formula", "Section",ExpressionUUID->"e05acda6-6e2f-4d8a-a225-fdf70ea023f5"],

Cell[TextData[{
 StyleBox["Theorem 4 (optimal estimation frequency).",
  FontWeight->Bold],
 " The total gradient-evaluation cost to reach loss ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Epsilon]", TraditionalForm], "errors" -> {}, 
     "input" -> "\\varepsilon", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "8c4330d6-2b83-4d9f-b328-56a261bd42df"],
 " from ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["L", "TI"], "0"], TraditionalForm], "errors" -> {}, "input" -> 
     "L_0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b0ab430d-b86d-45bc-ab5f-6bea3b8da7b8"],
 " is: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["C", "TI"], 
         RowBox[{"(", 
           StyleBox["k", "TI"], ")"}], "\[LongEqual]", 
         RowBox[{"(", 
           RowBox[{
             FractionBox[
              RowBox[{"2", 
                StyleBox["k", "TI"]}], 
              SubscriptBox["\[Beta]", 
               StyleBox["s", "TI"]]], "+", 
             SubscriptBox[
              StyleBox["T", "TI"], 
              StyleBox["steady", FontSlant -> "Plain"]]}], ")"}], 
         "\[CenterDot]", 
         RowBox[{"(", 
           RowBox[{"1", "+", 
             FractionBox["1", 
              StyleBox["k", "TI"]]}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "C(k) = \\left(\\frac{2k}{\\beta_s} + T_{\\mathrm{steady}}\\right) \
\\cdot \\left(1 + \\frac{1}{k}\\right)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "7e1f6dd1-1c86-4560-b15d-210f887cbf5c"],
 "where the first term is the transient EMA convergence time and the second \
is the compute cost per step."
}], "Text",ExpressionUUID->"93e79e76-1bcc-4586-8d8d-99be6f56ae2f"],

Cell[TextData[{
 "Minimizing over k: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         FractionBox[
          RowBox[{
            StyleBox["d", "TI"], 
            StyleBox["C", "TI"]}], 
          RowBox[{
            StyleBox["d", "TI"], 
            StyleBox["k", "TI"]}]], "\[LongEqual]", 
         FractionBox["2", 
          SubscriptBox["\[Beta]", 
           StyleBox["s", "TI"]]], "-", 
         FractionBox[
          SubscriptBox[
           StyleBox["T", "TI"], 
           StyleBox["steady", FontSlant -> "Plain"]], 
          SuperscriptBox[
           StyleBox["k", "TI"], "2"]], "\[LongEqual]", "0"}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\frac{dC}{dk} = \\frac{2}{\\beta_s} - \
\\frac{T_{\\mathrm{steady}}}{k^2} = 0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "61912060-27d9-457f-ada7-f5e071031296"],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["k", "TI"], "*"], "\[LongEqual]", 
         SqrtBox[
          FractionBox[
           RowBox[{
             SubscriptBox[
              StyleBox["T", "TI"], 
              StyleBox["steady", FontSlant -> "Plain"]], "\[CenterDot]", 
             SubscriptBox["\[Beta]", 
              StyleBox["s", "TI"]]}], "2"]], "\[TildeTilde]", 
         SqrtBox[
          FractionBox[
           RowBox[{
             SubscriptBox[
              StyleBox["T", "TI"], 
              StyleBox["GE", FontSlant -> "Plain"]], "\[CenterDot]", 
             SubscriptBox["\[Beta]", 
              StyleBox["s", "TI"]]}], "2"]]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\boxed{k^* = \\sqrt{\\frac{T_{\\mathrm{steady}} \\cdot \\beta_s}{2}} \
\\approx \\sqrt{\\frac{T_{\\mathrm{GE}} \\cdot \\beta_s}{2}}}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b5d25b2a-d370-4d5f-88e4-ed978207773e"],
 "where ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["T", "TI"], 
        StyleBox["GE", FontSlant -> "Plain"]], TraditionalForm], 
     "errors" -> {}, "input" -> "T_{\\mathrm{GE}}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f571680c-9fa8-42c3-9d31-a3f1ae807a02"],
 " is the total gradient evaluation budget (",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["T", "TI"], 
          StyleBox["steady", FontSlant -> "Plain"]], "\[TildeTilde]", 
         SubscriptBox[
          StyleBox["T", "TI"], 
          StyleBox["GE", FontSlant -> "Plain"]], "/", "2"}], TraditionalForm],
      "errors" -> {}, "input" -> 
     "T_{\\mathrm{steady}} \\approx T_{\\mathrm{GE}}/2", "state" -> "Boxes"|>,
    
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f949e3cf-a906-4797-9629-8ecceb22b4cb"],
 " when k=1 spends half the budget on Hutchinson). "
}], "Text",ExpressionUUID->"0ffcdab1-4cff-4c6e-9b76-9ef2f832b42b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Verify", " ", "formula", " ", "against", " ", "numerical", " ", 
    "optima"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"\[Beta]s", "=", "0.05"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<Formula verification:\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Budget | numerical k* | formula k* = \[Sqrt](T\
\[CenterDot]\[Beta]/2)\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"budgets", "=", 
     RowBox[{"{", 
      RowBox[{"1000", ",", "2000", ",", "4000", ",", "8000"}], "}"}]}], ";"}],
    "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"numericalKstar", "=", 
     RowBox[{"{", 
      RowBox[{"5", ",", "7", ",", "12", ",", "17"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"Do", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{
      RowBox[{"predicted", "=", 
       RowBox[{"Sqrt", "[", 
        RowBox[{
         RowBox[{"budgets", "[", 
          RowBox[{"[", "i", "]"}], "]"}], "*", 
         RowBox[{"\[Beta]s", "/", "2."}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"Print", "[", 
       RowBox[{
        RowBox[{"budgets", "[", 
         RowBox[{"[", "i", "]"}], "]"}], ",", "\"\<    | \>\"", ",", 
        RowBox[{"numericalKstar", "[", 
         RowBox[{"[", "i", "]"}], "]"}], ",", "\[IndentingNewLine]", 
        "    ", "\"\<            | \>\"", ",", 
        RowBox[{"NumberForm", "[", 
         RowBox[{"predicted", ",", "3"}], "]"}]}], "]"}]}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"{", 
      RowBox[{"i", ",", "4"}], "}"}]}], "]"}]}]}]], "Input",ExpressionUUID->\
"6cfd1fb9-2605-4534-af06-879f17b939c5"],

Cell[TextData[StyleBox["Formula predictions for neural network training:",
 FontWeight->Bold]], "Text",ExpressionUUID->"a0fdf390-2a99-4bc5-bd15-\
360403f875b7"],

