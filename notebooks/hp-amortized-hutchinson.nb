Notebook[{
Cell["\<\
IMO-129: Amortized Hutchinson \[LongDash] Every-k-Step Estimation Guarantees\
\>", "Title",ExpressionUUID->"a7d818b6-d2ee-47b3-88a2-cde862f53960"],

Cell[TextData[{
 "Companion to ",
 Cell[BoxData[Cell["notes/amortized-hutchinson.md",
   Background->None,ExpressionUUID->"014f6a06-7f73-4197-8e11-12fcecd63c61"]], 
  "InlineCode",ExpressionUUID->"a00af55e-b41d-4e9f-9f4e-df9b60bb2f36"],
 ". Verifies all theoretical claims numerically."
}], "Text",ExpressionUUID->"d8c5c4d3-cf5b-4319-8061-466571132919"],

Cell["\<\
The Hutchinson Hessian diagonal estimator costs one Hessian-vector product \
per step (~2\[Times] the per-step cost of plain gradient descent). If we only \
compute Hutchinson every k steps, reusing the stale estimate for the k-1 \
intervening steps, the per-step overhead drops from 2\[Times] to (1+1/k)\
\[Times]. Sophia (Liu et al., 2024) uses k=10 empirically.\
\>", "Text",ExpressionUUID->"03171812-da4a-4b42-89e0-b2fb905f86c1"],

Cell["\<\
This notebook derives guarantees for every-k-step estimation and finds the \
optimal k. \
\>", "Text",ExpressionUUID->"78e550b1-9fdd-458c-911c-5006cb674ce6"],

Cell["\<\
Part I: Quadratic Case \[LongDash] Steady-State Variance Is Independent of k\
\>", "Section",ExpressionUUID->"7dfd1d05-ca74-4c9a-9752-436edc2cceb5"],

Cell[TextData[{
 "On a quadratic ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       FractionBox[
        RowBox[{
          StyleBox["L", "TI"], "\[LongEqual]", "1"}], 
        RowBox[{"2", 
          SuperscriptBox["\[Theta]", 
           StyleBox["H", "TI"]], "\[Theta]"}]], TraditionalForm], 
     "errors" -> {}, "input" -> "L = \\tfrac{1}{2}\\theta^\\top H\\theta", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "bd403b8b-f1e3-4ad0-aa31-6de3df8c670e"],
 " with constant ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["H", "TI"], TraditionalForm], "errors" -> {}, "input" -> "H", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "1d287fab-0426-481c-bc1a-f089a1e836d4"],
 ", the Hessian is fixed. The only effect of every-k estimation is on the EMA \
convergence.",
 StyleBox["Theorem 1.",
  FontWeight->Bold],
 " The steady-state variance ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["Var", FontSlant -> "Plain"], "(", 
         SubscriptBox[
          StyleBox["s", "TI"], 
          StyleBox["i", "TI"]], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\mathrm{Var}(s_i)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "98d791c3-2e3d-4997-9505-2d0e544062c7"],
 " of the EMA around the true Newton target is independent of the update \
frequency ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["k", "TI"], TraditionalForm], "errors" -> {}, "input" -> "k", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "736d6927-472e-46a3-adab-615eef14ba8e"],
 ": ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["Var", FontSlant -> "Plain"], "\[Infinity]"], 
         RowBox[{"(", 
           SubscriptBox[
            StyleBox["s", "TI"], 
            StyleBox["i", "TI"]], ")"}], "\[LongEqual]", 
         FractionBox[
          RowBox[{
            SubscriptBox["\[Beta]", 
             StyleBox["s", "TI"]], "\[CenterDot]", 
            StyleBox["Var", FontSlant -> "Plain"], 
            RowBox[{"(", 
              RowBox[{"-", "log", 
                SubscriptBox[
                 OverscriptBox[
                  StyleBox["h", "TI"], "^"], 
                 StyleBox["i", "TI"]]}], ")"}]}], 
          RowBox[{"2", "-", 
            SubscriptBox["\[Beta]", 
             StyleBox["s", "TI"]]}]]}], TraditionalForm], "errors" -> {}, 
     "input" -> 
     "\\mathrm{Var}_\\infty(s_i) = \\frac{\\beta_s \\cdot \
\\mathrm{Var}(-\\log\\hat{h}_i)}{2 - \\beta_s}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "8429d7dd-0eaa-48da-a1f6-7b47b9576896"],
 "This holds because the EMA update equation ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["s", "TI"], 
          RowBox[{"(", 
            RowBox[{
              StyleBox["m", "TI"], "+", "1"}], ")"}]], "\[LongEqual]", 
         RowBox[{"(", 
           RowBox[{"1", "-", 
             SubscriptBox["\[Beta]", 
              StyleBox["s", "TI"]]}], ")"}], " ", 
         SuperscriptBox[
          StyleBox["s", "TI"], 
          RowBox[{"(", 
            StyleBox["m", "TI"], ")"}]], "+", 
         SubscriptBox["\[Beta]", 
          StyleBox["s", "TI"]], " ", 
         SuperscriptBox[
          StyleBox["x", "TI"], 
          RowBox[{"(", 
            StyleBox["m", "TI"], ")"}]]}], TraditionalForm], "errors" -> {}, 
     "input" -> "s^{(m+1)} = (1-\\beta_s)\\,s^{(m)} + \\beta_s\\,x^{(m)}", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "956cce87-0b91-47c2-ba76-9cc41790e30d"],
 " has the same steady-state statistics regardless of the time between \
updates. "
}], "Text",ExpressionUUID->"4905a293-660d-4eb8-8906-c8533535a88f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Verify", ":", " ", 
    RowBox[{"steady", "-", 
     RowBox[{
     "state", " ", "variance", " ", "is", " ", "independent", " ", "of", " ", 
      "k"}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"SeedRandom", "[", "42", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"n", "=", "10"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"h", "=", 
     RowBox[{"Exp", "[", 
      RowBox[{"Range", "[", 
       RowBox[{"0.", ",", 
        RowBox[{"Log", "[", "100.", "]"}], ",", 
        RowBox[{
         RowBox[{"Log", "[", "100.", "]"}], "/", "9"}]}], "]"}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Hoff", "=", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{"0.", ",", 
       RowBox[{"{", 
        RowBox[{"n", ",", "n"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"i", "<", "j"}], ",", "\[IndentingNewLine]", "  ", 
        RowBox[{
         RowBox[{
          RowBox[{"Hoff", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", "j"}], "]"}], "]"}], "=", 
          RowBox[{"0.1", " ", 
           RowBox[{"RandomReal", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "1"}], ",", "1"}], "}"}], "]"}], " ", 
           RowBox[{
            RowBox[{"Sqrt", "[", 
             RowBox[{
              RowBox[{"h", "[", 
               RowBox[{"[", "i", "]"}], "]"}], " ", 
              RowBox[{"h", "[", 
               RowBox[{"[", "j", "]"}], "]"}]}], "]"}], "/", 
            RowBox[{"(", 
             RowBox[{"n", "-", "1"}], ")"}]}]}]}], ";", "\[IndentingNewLine]",
          "  ", 
         RowBox[{
          RowBox[{"Hoff", "[", 
           RowBox[{"[", 
            RowBox[{"j", ",", "i"}], "]"}], "]"}], "=", 
          RowBox[{"Hoff", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", "j"}], "]"}], "]"}]}]}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "n"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"j", ",", "n"}], "}"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
   
   RowBox[{
    RowBox[{"Hfull", "=", 
     RowBox[{
      RowBox[{"DiagonalMatrix", "[", "h", "]"}], "+", "Hoff"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Hfull", "=", 
     RowBox[{"Hfull", "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Max", "[", 
          RowBox[{"0", ",", 
           RowBox[{"-", 
            RowBox[{"Min", "[", 
             RowBox[{"Eigenvalues", "[", "Hfull", "]"}], "]"}]}]}], "]"}], "+",
          "0.01"}], ")"}], " ", 
       RowBox[{"IdentityMatrix", "[", "n", "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"hTrue", "=", 
     RowBox[{"Diagonal", "[", "Hfull", "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Beta]s", "=", "0.05"}], ";", " ", 
    RowBox[{"\[Epsilon]", "=", "1.*^-8"}], ";", " ", 
    RowBox[{"nSteps", "=", "100000"}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"varianceResults", "=", 
     RowBox[{"Association", "[", "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Do", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{
       RowBox[{"SeedRandom", "[", 
        RowBox[{"42", "+", "kVal"}], "]"}], ";", "\[IndentingNewLine]", "  ", 
       
       RowBox[{"s", "=", 
        RowBox[{"ConstantArray", "[", 
         RowBox[{"0.", ",", "n"}], "]"}]}], ";", "\[IndentingNewLine]", "  ", 
       
       RowBox[{"sHistory", "=", 
        RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", "  ", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Mod", "[", 
              RowBox[{
               RowBox[{"t", "-", "1"}], ",", "kVal"}], "]"}], "==", "0"}], ",",
             "\[IndentingNewLine]", "    ", 
            RowBox[{
             RowBox[{"v", "=", 
              RowBox[{
               RowBox[{"2.", " ", 
                RowBox[{"RandomInteger", "[", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{"0", ",", "1"}], "}"}], ",", "n"}], "]"}]}], "-", 
               "1."}]}], ";", "\[IndentingNewLine]", "    ", 
             RowBox[{"hEst", "=", 
              RowBox[{"v", "*", 
               RowBox[{"(", 
                RowBox[{"Hfull", ".", "v"}], ")"}]}]}], ";", 
             "\[IndentingNewLine]", "    ", 
             RowBox[{"target", "=", 
              RowBox[{"-", 
               RowBox[{"Log", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"Max", "[", 
                   RowBox[{"#", ",", "\[Epsilon]"}], "]"}], " ", "&"}], " ", "/@",
                  " ", "hEst"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
             "    ", 
             RowBox[{"s", "=", 
              RowBox[{
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"1", "-", "\[Beta]s"}], ")"}], " ", "s"}], "+", 
               RowBox[{"\[Beta]s", "*", "target"}]}]}]}]}], "]"}], ";", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"sHistory", ",", "s"}], "]"}]}], ",", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"{", 
          RowBox[{"t", ",", "nSteps"}], "}"}]}], "]"}], ";", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"steadyState", "=", 
        RowBox[{"sHistory", "[", 
         RowBox[{"[", 
          RowBox[{
           RowBox[{
            RowBox[{"-", "nSteps"}], "/", "2"}], " ", ";;"}], "]"}], "]"}]}], 
       ";", "\[IndentingNewLine]", "  ", 
       RowBox[{"sMean", "=", 
        RowBox[{"Mean", "[", "steadyState", "]"}]}], ";", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"sVar", "=", 
        RowBox[{"Mean", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"#", "-", "sMean"}], ")"}], "^", "2"}], " ", "&"}], " ", 
          "/@", " ", "steadyState"}], "]"}]}], ";", "\[IndentingNewLine]", 
       "  ", 
       RowBox[{
        RowBox[{"varianceResults", "[", "kVal", "]"}], "=", 
        RowBox[{"Max", "[", "sVar", "]"}]}]}], ",", "\[IndentingNewLine]", 
      "  ", 
      RowBox[{"{", 
       RowBox[{"kVal", ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "2", ",", "5", ",", "10", ",", "20", ",", "50"}], 
         "}"}]}], "}"}]}], "]"}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<Max Var(s_i) at steady state:\>\"", "]"}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{"Do", "[", 
    RowBox[{
     RowBox[{"Print", "[", 
      RowBox[{"\"\<k = \>\"", ",", "k", ",", "\"\<: \>\"", ",", 
       RowBox[{"ScientificForm", "[", 
        RowBox[{
         RowBox[{"varianceResults", "[", "k", "]"}], ",", "4"}], "]"}], ",", 
       "\[IndentingNewLine]", "  ", "\"\<  ratio to k=1: \>\"", ",", 
       RowBox[{"NumberForm", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"varianceResults", "[", "k", "]"}], "/", 
          RowBox[{"varianceResults", "[", "1", "]"}]}], ",", "4"}], "]"}]}], 
      "]"}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"{", 
      RowBox[{"k", ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "2", ",", "5", ",", "10", ",", "20", ",", "50"}], 
        "}"}]}], "}"}]}], "]"}]}]}]], "Input",ExpressionUUID->"d275e8b3-d756-\
4961-929c-67b2569075b4"],

Cell[TextData[{
 StyleBox["Result: CONFIRMED.",
  FontWeight->Bold],
 " Steady-state variance is ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[TildeTilde]", "2", "\[Cross]", 
         SuperscriptBox["10", "-4"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\approx 2 \\times 10^{-4}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "eafe96e7-af16-4be5-8fb1-58b157c06a9a"],
 " for all ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["k", "TI"], TraditionalForm], "errors" -> {}, "input" -> "k", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ff4fe744-c365-4198-828b-f8da38c637d6"],
 " from 1 to 50. The ratio ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["Var", FontSlant -> "Plain"], 
          StyleBox["k", "TI"]], "/", 
         SubscriptBox[
          StyleBox["Var", FontSlant -> "Plain"], "1"], "\[TildeTilde]", "1"}],
        TraditionalForm], "errors" -> {}, "input" -> 
     "\\mathrm{Var}_k / \\mathrm{Var}_1 \\approx 1", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "dde4fd0f-a966-4c08-8863-99bdec1b8e0c"],
 ". "
}], "Text",ExpressionUUID->"618cc172-987d-406d-a229-27fb6e6da539"],

Cell["Part II: Convergence Time Scales as k", "Section",ExpressionUUID->"84c06f10-8c3b-4057-b09d-2ba435f162fa"],

Cell[TextData[{
 StyleBox["Theorem 2.",
  FontWeight->Bold],
 " The convergence time of the EMA to steady state scales linearly with ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["k", "TI"], TraditionalForm], "errors" -> {}, "input" -> "k", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "87354330-061d-4d73-a8cb-8b72130f8e7e"],
 ": ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["T", "TI"], 
          StyleBox["converge", FontSlant -> "Plain"]], 
         RowBox[{"(", 
           StyleBox["k", "TI"], ")"}], "\[LongEqual]", 
         StyleBox["k", "TI"], "\[CenterDot]", 
         SubscriptBox[
          StyleBox["T", "TI"], 
          StyleBox["converge", FontSlant -> "Plain"]], 
         RowBox[{"(", "1", ")"}], "\[LongEqual]", 
         FractionBox[
          RowBox[{"2", 
            StyleBox["k", "TI"]}], 
          SubscriptBox["\[Beta]", 
           StyleBox["s", "TI"]]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "T_{\\mathrm{converge}}(k) = k \\cdot T_{\\mathrm{converge}}(1) = \
\\frac{2k}{\\beta_s}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "dabb6d65-0577-43df-b058-db6dbd326191"]
}], "Text",ExpressionUUID->"453a226a-dd61-4f23-88ea-2bad94da8742"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Track", " ", "convergence", " ", "of", " ", "s", " ", "to", " ", "target",
     " ", "for", " ", "different", " ", "k"}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"SeedRandom", "[", "42", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"n", "=", "10"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"h", "=", 
     RowBox[{"Exp", "[", 
      RowBox[{"Range", "[", 
       RowBox[{"0.", ",", 
        RowBox[{"Log", "[", "100.", "]"}], ",", 
        RowBox[{
         RowBox[{"Log", "[", "100.", "]"}], "/", "9"}]}], "]"}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Hoff", "=", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{"0.", ",", 
       RowBox[{"{", 
        RowBox[{"n", ",", "n"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"i", "<", "j"}], ",", "\[IndentingNewLine]", "  ", 
        RowBox[{
         RowBox[{
          RowBox[{"Hoff", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", "j"}], "]"}], "]"}], "=", 
          RowBox[{"0.1", " ", 
           RowBox[{"RandomReal", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "1"}], ",", "1"}], "}"}], "]"}], " ", 
           RowBox[{
            RowBox[{"Sqrt", "[", 
             RowBox[{
              RowBox[{"h", "[", 
               RowBox[{"[", "i", "]"}], "]"}], " ", 
              RowBox[{"h", "[", 
               RowBox[{"[", "j", "]"}], "]"}]}], "]"}], "/", 
            RowBox[{"(", 
             RowBox[{"n", "-", "1"}], ")"}]}]}]}], ";", "\[IndentingNewLine]",
          "  ", 
         RowBox[{
          RowBox[{"Hoff", "[", 
           RowBox[{"[", 
            RowBox[{"j", ",", "i"}], "]"}], "]"}], "=", 
          RowBox[{"Hoff", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", "j"}], "]"}], "]"}]}]}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "n"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"j", ",", "n"}], "}"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
   
   RowBox[{
    RowBox[{"Hfull", "=", 
     RowBox[{
      RowBox[{"DiagonalMatrix", "[", "h", "]"}], "+", "Hoff"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Hfull", "=", 
     RowBox[{"Hfull", "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Max", "[", 
          RowBox[{"0", ",", 
           RowBox[{"-", 
            RowBox[{"Min", "[", 
             RowBox[{"Eigenvalues", "[", "Hfull", "]"}], "]"}]}]}], "]"}], "+",
          "0.01"}], ")"}], " ", 
       RowBox[{"IdentityMatrix", "[", "n", "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"hTrue", "=", 
     RowBox[{"Diagonal", "[", "Hfull", "]"}]}], ";"}], "\[IndentingNewLine]", 
   
   RowBox[{
    RowBox[{"sTarget", "=", 
     RowBox[{"-", 
      RowBox[{"Log", "[", "hTrue", "]"}]}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Beta]s", "=", "0.05"}], ";", " ", 
    RowBox[{"\[Epsilon]", "=", "1.*^-8"}], ";", " ", 
    RowBox[{"nSteps", "=", "5000"}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Convergence to steady state (max|s_i - s*_i|):\>\"", 
     "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"Do", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{
      RowBox[{"SeedRandom", "[", "100", "]"}], ";", "\[IndentingNewLine]", 
      "  ", 
      RowBox[{"s", "=", 
       RowBox[{"ConstantArray", "[", 
        RowBox[{"0.", ",", "n"}], "]"}]}], ";", "\[IndentingNewLine]", "  ", 
      RowBox[{"milestones", "=", 
       RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", "  ", 
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Mod", "[", 
             RowBox[{
              RowBox[{"t", "-", "1"}], ",", "kVal"}], "]"}], "==", "0"}], ",",
            "\[IndentingNewLine]", "    ", 
           RowBox[{
            RowBox[{"v", "=", 
             RowBox[{
              RowBox[{"2.", " ", 
               RowBox[{"RandomInteger", "[", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"0", ",", "1"}], "}"}], ",", "n"}], "]"}]}], "-", 
              "1."}]}], ";", "\[IndentingNewLine]", "    ", 
            RowBox[{"hEst", "=", 
             RowBox[{"v", "*", 
              RowBox[{"(", 
               RowBox[{"Hfull", ".", "v"}], ")"}]}]}], ";", 
            "\[IndentingNewLine]", "    ", 
            RowBox[{"target", "=", 
             RowBox[{"-", 
              RowBox[{"Log", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"Max", "[", 
                  RowBox[{"#", ",", "\[Epsilon]"}], "]"}], " ", "&"}], " ", "/@",
                 " ", "hEst"}], "]"}]}]}], ";", "\[IndentingNewLine]", "    ", 
            RowBox[{"s", "=", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{"1", "-", "\[Beta]s"}], ")"}], " ", "s"}], "+", 
              RowBox[{"\[Beta]s", "*", "target"}]}]}]}]}], "]"}], ";", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"MemberQ", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
              "10", ",", "50", ",", "100", ",", "200", ",", "500", ",", 
               "1000", ",", "2000", ",", "5000"}], "}"}], ",", "t"}], "]"}], ",",
            "\[IndentingNewLine]", "      ", 
           RowBox[{"AppendTo", "[", 
            RowBox[{"milestones", ",", 
             RowBox[{"{", 
              RowBox[{"t", ",", 
               RowBox[{"Max", "[", 
                RowBox[{"Abs", "[", 
                 RowBox[{"s", "-", "sTarget"}], "]"}], "]"}]}], "}"}]}], 
            "]"}]}], "]"}]}], ",", "\[IndentingNewLine]", "    ", 
        RowBox[{"{", 
         RowBox[{"t", ",", "nSteps"}], "}"}]}], "]"}], ";", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<k = \>\"", ",", "kVal", ",", "\"\<: \>\"", ",", 
        "milestones"}], "]"}]}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"{", 
      RowBox[{"kVal", ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "5", ",", "10", ",", "20", ",", "50"}], "}"}]}], 
      "}"}]}], "]"}]}]}]], "Input",ExpressionUUID->"6042c843-ba29-4c7d-bafd-\
7f4a25606212"],

