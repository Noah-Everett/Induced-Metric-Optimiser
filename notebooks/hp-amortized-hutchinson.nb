Cell["\<\
The optimal k increases with the compute budget, and the speedup approaches \
the theoretical maximum of 2\[Times]. \
\>", "Text",ExpressionUUID->"18abcd68-3c0e-49b2-a1d0-2737cc723696"],

Cell["Part IV: Optimal k Sweep on Quadratic", "Section",ExpressionUUID->"be7bfcbd-3656-44fe-9e0e-17eafc19516c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Fine", "-", 
    RowBox[{
    "grained", " ", "sweep", " ", "of", " ", "k", " ", "on", " ", "the", " ", 
     "quadratic"}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"SeedRandom", "[", "42", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"n", "=", "10"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"h", "=", 
     RowBox[{"Exp", "[", 
      RowBox[{"Range", "[", 
       RowBox[{"0.", ",", 
        RowBox[{"Log", "[", "100.", "]"}], ",", 
        RowBox[{
         RowBox[{"Log", "[", "100.", "]"}], "/", "9"}]}], "]"}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Hoff", "=", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{"0.", ",", 
       RowBox[{"{", 
        RowBox[{"n", ",", "n"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"i", "<", "j"}], ",", "\[IndentingNewLine]", "  ", 
        RowBox[{
         RowBox[{
          RowBox[{"Hoff", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", "j"}], "]"}], "]"}], "=", 
          RowBox[{"0.1", " ", 
           RowBox[{"RandomReal", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "1"}], ",", "1"}], "}"}], "]"}], " ", 
           RowBox[{
            RowBox[{"Sqrt", "[", 
             RowBox[{
              RowBox[{"h", "[", 
               RowBox[{"[", "i", "]"}], "]"}], " ", 
              RowBox[{"h", "[", 
               RowBox[{"[", "j", "]"}], "]"}]}], "]"}], "/", 
            RowBox[{"(", 
             RowBox[{"n", "-", "1"}], ")"}]}]}]}], ";", "\[IndentingNewLine]",
          "  ", 
         RowBox[{
          RowBox[{"Hoff", "[", 
           RowBox[{"[", 
            RowBox[{"j", ",", "i"}], "]"}], "]"}], "=", 
          RowBox[{"Hoff", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", "j"}], "]"}], "]"}]}]}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "n"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"j", ",", "n"}], "}"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
   
   RowBox[{
    RowBox[{"Hfull", "=", 
     RowBox[{
      RowBox[{"DiagonalMatrix", "[", "h", "]"}], "+", "Hoff"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Hfull", "=", 
     RowBox[{"Hfull", "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Max", "[", 
          RowBox[{"0", ",", 
           RowBox[{"-", 
            RowBox[{"Min", "[", 
             RowBox[{"Eigenvalues", "[", "Hfull", "]"}], "]"}]}]}], "]"}], "+",
          "0.01"}], ")"}], " ", 
       RowBox[{"IdentityMatrix", "[", "n", "]"}]}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Beta]s", "=", "0.05"}], ";", " ", 
    RowBox[{"\[Epsilon]", "=", "1.*^-8"}], ";", " ", 
    RowBox[{"\[Alpha]", "=", "0.005"}], ";", " ", 
    RowBox[{"cc", "=", "3."}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"clipCenter", "[", 
      RowBox[{"s_", ",", "c_"}], "]"}], ":=", 
     RowBox[{"Clip", "[", 
      RowBox[{
       RowBox[{"s", "-", 
        RowBox[{"Mean", "[", "s", "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "c"}], ",", "c"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"kSweep", "=", 
     RowBox[{"Range", "[", 
      RowBox[{"1", ",", "50"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"Sweep", " ", "at", " ", "multiple", " ", "budgets"}], " ", 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{"Do", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{
      RowBox[{"sweepLosses", "=", 
       RowBox[{"Table", "[", "\[IndentingNewLine]", "    ", 
        RowBox[{
         RowBox[{
          RowBox[{"nSteps", "=", 
           RowBox[{"Ceiling", "[", 
            RowBox[{"budget", "/", 
             RowBox[{"(", 
              RowBox[{"1.", "+", 
               RowBox[{"1.", "/", "k"}]}], ")"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"SeedRandom", "[", "100", "]"}], ";", "\[IndentingNewLine]",
           "    ", 
          RowBox[{"s", "=", 
           RowBox[{"ConstantArray", "[", 
            RowBox[{"0.", ",", "n"}], "]"}]}], ";", " ", 
          RowBox[{"\[Theta]", "=", 
           RowBox[{"RandomReal", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", "n"}], "]"}]}], ";",
           "\[IndentingNewLine]", "    ", 
          RowBox[{"gradEvals", "=", "0"}], ";", "\[IndentingNewLine]", "    ", 
          RowBox[{"Do", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"g", "=", 
              RowBox[{"Hfull", ".", "\[Theta]"}]}], ";", " ", 
             RowBox[{"gradEvals", " ", "+=", " ", "1"}], ";", 
             "\[IndentingNewLine]", "      ", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"gradEvals", ">", "budget"}], ",", 
               RowBox[{"Break", "[", "]"}]}], "]"}], ";", 
             "\[IndentingNewLine]", "      ", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"Mod", "[", 
                 RowBox[{
                  RowBox[{"t", "-", "1"}], ",", "k"}], "]"}], "==", "0"}], ",",
                "\[IndentingNewLine]", "        ", 
               RowBox[{
                RowBox[{"v", "=", 
                 RowBox[{
                  RowBox[{"2.", " ", 
                   RowBox[{"RandomInteger", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"0", ",", "1"}], "}"}], ",", "n"}], "]"}]}], "-", 
                  "1."}]}], ";", "\[IndentingNewLine]", "        ", 
                RowBox[{"hEst", "=", 
                 RowBox[{"v", "*", 
                  RowBox[{"(", 
                   RowBox[{"Hfull", ".", "v"}], ")"}]}]}], ";", " ", 
                RowBox[{"gradEvals", " ", "+=", " ", "1"}], ";", 
                "\[IndentingNewLine]", "        ", 
                RowBox[{"target", "=", 
                 RowBox[{"-", 
                  RowBox[{"Log", "[", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"Max", "[", 
                    RowBox[{"#", ",", "1.*^-8"}], "]"}], " ", "&"}], " ", "/@",
                     " ", "hEst"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
                "        ", 
                RowBox[{"s", "=", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{"1", "-", "\[Beta]s"}], ")"}], " ", "s"}], "+", 
                  RowBox[{"\[Beta]s", "*", "target"}]}]}], ";", " ", 
                RowBox[{"s", "=", 
                 RowBox[{"clipCenter", "[", 
                  RowBox[{"s", ",", "cc"}], "]"}]}]}]}], "]"}], ";", 
             "\[IndentingNewLine]", "      ", 
             RowBox[{"\[Theta]", "=", 
              RowBox[{"\[Theta]", "-", 
               RowBox[{"\[Alpha]", " ", 
                RowBox[{"Exp", "[", "s", "]"}], " ", "g"}]}]}]}], ",", 
            "\[IndentingNewLine]", "      ", 
            RowBox[{"{", 
             RowBox[{"t", ",", 
              RowBox[{"nSteps", "+", "100"}]}], "}"}]}], "]"}], ";", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"{", 
           RowBox[{"k", ",", 
            RowBox[{"Log10", "[", 
             RowBox[{"Max", "[", 
              RowBox[{
               RowBox[{"0.5", " ", 
                RowBox[{"\[Theta]", ".", "Hfull", ".", "\[Theta]"}]}], ",", 
               "1.*^-300"}], "]"}], "]"}]}], "}"}]}], ",", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"{", 
          RowBox[{"k", ",", "kSweep"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"bestK", "=", 
       RowBox[{"sweepLosses", "[", 
        RowBox[{"[", 
         RowBox[{
          RowBox[{"Ordering", "[", 
           RowBox[{
            RowBox[{"sweepLosses", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", "2"}], "]"}], "]"}], ",", "1"}], "]"}], "[", 
          RowBox[{"[", "1", "]"}], "]"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"predicted", "=", 
       RowBox[{"Sqrt", "[", 
        RowBox[{"budget", "*", 
         RowBox[{"\[Beta]s", "/", "2."}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<Budget=\>\"", ",", "budget", ",", "\"\< GE: best k=\>\"", 
        ",", 
        RowBox[{"bestK", "[", 
         RowBox[{"[", "1", "]"}], "]"}], ",", "\[IndentingNewLine]", 
        "    ", "\"\< (log10 loss=\>\"", ",", 
        RowBox[{"NumberForm", "[", 
         RowBox[{
          RowBox[{"bestK", "[", 
           RowBox[{"[", "2", "]"}], "]"}], ",", "4"}], "]"}], ",", "\"\<)\>\"",
         ",", "\[IndentingNewLine]", "    ", "\"\<, formula k*=\>\"", ",", 
        RowBox[{"NumberForm", "[", 
         RowBox[{"predicted", ",", "3"}], "]"}]}], "]"}]}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"{", 
      RowBox[{"budget", ",", 
       RowBox[{"{", 
        RowBox[{"1000", ",", "2000", ",", "4000", ",", "8000"}], "}"}]}], 
      "}"}]}], "]"}]}]}]], "Input",ExpressionUUID->"8ca96f2c-d947-4886-b8a4-\
e9c8d95a230c"],

Cell[TextData[StyleBox["Result:",
 FontWeight->Bold]], "Text",ExpressionUUID->"bcc75b62-f3fd-442a-bf81-bb9eb9b5f38f"],

Cell[BoxData[
 PaneBox[
  PaneBox[
   StyleBox[
    TagBox[
     TagBox[GridBox[{
        {
         TagBox["\<\"Budget (GE)\"\>",
          HoldForm], 
         TagBox["\<\"Numerical k*\"\>",
          HoldForm], 
         TagBox[Cell[TextData[{
           "Formula k* = ",
           Cell[BoxData[
            FormBox[
             TemplateBox[<|"boxes" -> FormBox[
                 SqrtBox[
                  RowBox[{
                    StyleBox["T", "TI"], 
                    SubscriptBox["\[Beta]", 
                    StyleBox["s", "TI"]], "/", "2"}]], TraditionalForm], 
               "errors" -> {}, "input" -> "\\sqrt{T \\beta_s/2}", "state" -> 
               "Boxes"|>,
              "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
            "0868a3f6-b816-49b4-96b9-5f044a75f31c"]
          }],ExpressionUUID->"1f71cccf-014a-40f0-930f-47b8f0fc6d8f"],
          HoldForm]},
        {"\<\"1000\"\>", "\<\"5\"\>", "\<\"5.0\"\>"},
        {"\<\"2000\"\>", "\<\"7\"\>", "\<\"7.1\"\>"},
        {"\<\"4000\"\>", "\<\"12\"\>", "\<\"10.0\"\>"},
        {"\<\"8000\"\>", "\<\"17\"\>", "\<\"14.1\"\>"}
       },
       GridBoxAlignment->{
        "Columns" -> {Center, Center, {Center}}, "Rows" -> {{Baseline}}},
       GridBoxDividers->{
        "Columns" -> {{False}}, "Rows" -> {False, True, {False}, False}},
       GridBoxSpacings->{"Columns" -> {
           Offset[0.27999999999999997`], {
            Offset[2.0999999999999996`]}, 
           Offset[0.27999999999999997`]}, "Rows" -> {
           Offset[0.2], {
            Offset[0.4]}, 
           Offset[0.2]}}],
      {None, OutputFormsDump`HeadedColumns}],
     Function[BoxForm`e$, 
      TableForm[
      BoxForm`e$, TableHeadings -> {None, {"Budget (GE)", "Numerical k*", 
          RawBoxes[
