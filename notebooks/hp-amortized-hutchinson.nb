Cell["Summary", "Section",ExpressionUUID->"084c0062-787f-41c6-a475-a8df61f23cf8"],

Cell[TextData[{
 "1. ",
 StyleBox["Steady-state variance is independent of k",
  FontWeight->Bold],
 " (Theorem 1, verified Part I). The EMA reaches the same equilibrium \
regardless of update frequency."
}], "Text",ExpressionUUID->"703d7781-d944-48b2-8298-728e57831bf5"],

Cell[TextData[{
 "2. ",
 StyleBox["Convergence time scales linearly with k",
  FontWeight->Bold],
 " (Theorem 2, verified Part II). The EMA takes ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["k", "TI"], TraditionalForm], "errors" -> {}, "input" -> "k", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "941fa1d9-eb58-4fab-9d86-ecac095870e8"],
 " times longer to converge."
}], "Text",ExpressionUUID->"6994d438-1baa-45e9-b30d-8d933437c870"],

Cell[TextData[{
 "3. ",
 StyleBox["Hessian drift is negligible",
  FontWeight->Bold],
 " (Theorem 3, verified Part V). The theoretical staleness bound is 400-5500\
\[Times] conservative. Actual drift is ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Tilde]", 
         SuperscriptBox["10", "-5"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\sim 10^{-5}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "dc2a20e3-f248-4477-a3a3-67d9d148ed44"],
 " for k up to 50."
}], "Text",ExpressionUUID->"c84bbcf1-a9ca-4d20-97ba-97d45a90b162"],

Cell[TextData[{
 "4. ",
 StyleBox["Optimal k follows",
  FontWeight->Bold],
 " ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["k", "TI"], "*"], "\[LongEqual]", 
         SqrtBox[
          RowBox[{
            SubscriptBox[
             StyleBox["T", "TI"], 
             StyleBox["GE", FontSlant -> "Plain"]], "\[CenterDot]", 
            SubscriptBox["\[Beta]", 
             StyleBox["s", "TI"]], "/", "2"}]]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "k^* = \\sqrt{T_{\\mathrm{GE}} \\cdot \\beta_s / 2}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "9d72565f-2987-4f57-b586-07d0a794bd6c"],
 " (Theorem 4, verified Part IV). This balances transient overhead against \
compute savings."
}], "Text",ExpressionUUID->"e0396ba6-b5ac-4d4e-a043-0a9966b9c9b7"],

Cell[TextData[{
 "5. ",
 StyleBox["k=5-20 gives 1.2-1.8\[Times] speedup",
  FontWeight->Bold],
 " over k=1 on both quadratic and cubic losses, verified numerically."
}], "Text",ExpressionUUID->"7db60472-7bcb-4ef7-80f7-164c929bcc17"],

Cell[TextData[{
 "6. ",
 StyleBox["For neural network training",
  FontWeight->Bold],
 " (",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["T", "TI"], "\[Tilde]", 
         SuperscriptBox["10", "5"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "T \\sim 10^5", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "3477da79-1187-459d-ae7b-f7c00d8f3763"],
 "-",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox["10", "6"], TraditionalForm], "errors" -> {}, "input" -> 
     "10^6", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "84b373df-b4c9-499c-ad2e-3f504ec3a48d"],
 " GE, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Beta]", 
          StyleBox["s", "TI"]], "\[Tilde]", "0.01"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\beta_s \\sim 0.01", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "3c48bd53-0999-4fab-baba-7a6d19af379c"],
 "-0.05): ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["k", "TI"], "*"], "\[TildeTilde]", "10"}], 
       TraditionalForm], "errors" -> {}, "input" -> "k^* \\approx 10", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f1016fe9-0eb6-45be-8093-241214d78751"],
 "-70, achieving ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Tilde]", "1.9"}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\sim 1.9", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "94635e35-3f85-405c-a952-271ea840d088"],
 "\[Times] savings. Sophia's empirical choice of k=10 is well-justified."
}], "Text",ExpressionUUID->"1a618b71-274b-4349-9010-4276d5519c30"],

Cell[TextData[{
 "7. ",
 StyleBox["The theoretical maximum savings is 2\[Times]",
  FontWeight->Bold],
 " (eliminating all Hutchinson cost). For long training runs, k=10-50 \
captures 90-98% of this maximum."
}], "Text",ExpressionUUID->"f5870750-d66b-428e-b79e-558140994d7b"]
},
