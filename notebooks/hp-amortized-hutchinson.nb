Cell[TextData[{
 "The bound holds but is extremely conservative (400-5500\[Times]). The \
actual Hessian drift is negligible (~",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox["10", "-5"], TraditionalForm], "errors" -> {}, "input" -> 
     "10^{-5}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "aabf214c-6039-42f4-ba56-f390f2437c0c"],
 ") even for k=50. ",
 StyleBox["Staleness is not a practical concern.",
  FontWeight->Bold]
}], "Text",ExpressionUUID->"1e758c43-c358-4541-a3c1-a8fb0f1b2528"],

Cell["Part VI: Convergence on Cubic (Non-Constant Hessian)", "Section",ExpressionUUID->"a207dbf2-41da-41e0-97e7-7a03c96b41ab"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Cubic", ":", " ", 
    RowBox[{
    "convergence", " ", "curves", " ", "for", " ", "various", " ", "k"}]}], 
   " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"SeedRandom", "[", "42", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"n", "=", "10"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"hBase", "=", 
     RowBox[{"Exp", "[", 
      RowBox[{"Range", "[", 
       RowBox[{"0.", ",", 
        RowBox[{"Log", "[", "100.", "]"}], ",", 
        RowBox[{
         RowBox[{"Log", "[", "100.", "]"}], "/", "9"}]}], "]"}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"a", "=", 
     RowBox[{"RandomReal", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "1."}], ",", "1."}], "}"}], ",", "n"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"lossFC", "[", "\[Theta]_", "]"}], ":=", 
     RowBox[{
      RowBox[{"0.5", " ", 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"hBase", "[", 
           RowBox[{"[", "i", "]"}], "]"}], " ", 
          RowBox[{
           RowBox[{"\[Theta]", "[", 
            RowBox[{"[", "i", "]"}], "]"}], "^", "2"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "n"}], "}"}]}], "]"}]}], "+", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "/", "6."}], ")"}], " ", 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"a", "[", 
           RowBox[{"[", "i", "]"}], "]"}], " ", 
          RowBox[{
           RowBox[{"\[Theta]", "[", 
            RowBox[{"[", "i", "]"}], "]"}], "^", "3"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "n"}], "}"}]}], "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"gradFC", "[", "\[Theta]_", "]"}], ":=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"hBase", "[", 
          RowBox[{"[", "i", "]"}], "]"}], " ", 
         RowBox[{"\[Theta]", "[", 
          RowBox[{"[", "i", "]"}], "]"}]}], "+", 
        RowBox[{"0.5", " ", 
         RowBox[{"a", "[", 
          RowBox[{"[", "i", "]"}], "]"}], " ", 
         RowBox[{
          RowBox[{"\[Theta]", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "^", "2"}]}]}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "n"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"hessDiagC", "[", "\[Theta]_", "]"}], ":=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"hBase", "[", 
         RowBox[{"[", "i", "]"}], "]"}], "+", 
        RowBox[{
         RowBox[{"a", "[", 
          RowBox[{"[", "i", "]"}], "]"}], " ", 
         RowBox[{"\[Theta]", "[", 
          RowBox[{"[", "i", "]"}], "]"}]}]}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "n"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Alpha]", "=", "0.001"}], ";", " ", 
    RowBox[{"\[Beta]s", "=", "0.05"}], ";", " ", 
    RowBox[{"cc", "=", "3."}], ";", " ", 
    RowBox[{"\[Epsilon]", "=", "1.*^-8"}], ";", " ", 
    RowBox[{"nSteps", "=", "10000"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"clipCenter", "[", 
      RowBox[{"s_", ",", "c_"}], "]"}], ":=", 
     RowBox[{"Clip", "[", 
      RowBox[{
       RowBox[{"s", "-", 
        RowBox[{"Mean", "[", "s", "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "c"}], ",", "c"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"geDataC", "=", 
     RowBox[{"Association", "[", "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"SeedRandom", "[", "100", "]"}], ";", "\[IndentingNewLine]", 
       "  ", 
       RowBox[{"s", "=", 
        RowBox[{"ConstantArray", "[", 
         RowBox[{"0.", ",", "n"}], "]"}]}], ";", " ", 
       RowBox[{"\[Theta]", "=", 
        RowBox[{"RandomReal", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "0.5"}], ",", "0.5"}], "}"}], ",", "n"}], "]"}]}], ";",
        "\[IndentingNewLine]", "  ", 
       RowBox[{"gradEvals", "=", "0"}], ";", " ", 
       RowBox[{"curve", "=", 
        RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", "  ", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"l", "=", 
           RowBox[{"lossFC", "[", "\[Theta]", "]"}]}], ";", " ", 
          RowBox[{"g", "=", 
           RowBox[{"gradFC", "[", "\[Theta]", "]"}]}], ";", " ", 
          RowBox[{"gradEvals", " ", "+=", " ", "1"}], ";", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Mod", "[", 
              RowBox[{
               RowBox[{"t", "-", "1"}], ",", "kVal"}], "]"}], "==", "0"}], ",",
             "\[IndentingNewLine]", "      ", 
            RowBox[{
             RowBox[{"hEst", "=", 
              RowBox[{"hessDiagC", "[", "\[Theta]", "]"}]}], ";", " ", 
             RowBox[{"gradEvals", " ", "+=", " ", "1"}], ";", 
             "\[IndentingNewLine]", "      ", 
             RowBox[{"target", "=", 
              RowBox[{"-", 
               RowBox[{"Log", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"Max", "[", 
                   RowBox[{"#", ",", "\[Epsilon]"}], "]"}], " ", "&"}], " ", "/@",
                  " ", "hEst"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
             "      ", 
             RowBox[{"s", "=", 
              RowBox[{
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"1", "-", "\[Beta]s"}], ")"}], " ", "s"}], "+", 
               RowBox[{"\[Beta]s", "*", "target"}]}]}], ";", " ", 
             RowBox[{"s", "=", 
              RowBox[{"clipCenter", "[", 
               RowBox[{"s", ",", "cc"}], "]"}]}]}]}], "]"}], ";", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"\[Theta]", "=", 
           RowBox[{"\[Theta]", "-", 
            RowBox[{"\[Alpha]", " ", 
             RowBox[{"Exp", "[", "s", "]"}], " ", "g"}]}]}], ";", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"curve", ",", 
            RowBox[{"{", 
             RowBox[{"gradEvals", ",", "l"}], "}"}]}], "]"}]}], ",", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"{", 
          RowBox[{"t", ",", "nSteps"}], "}"}]}], "]"}], ";", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{
        RowBox[{"geDataC", "[", "kVal", "]"}], "=", "curve"}]}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"{", 
       RowBox[{"kVal", ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "5", ",", "10", ",", "20", ",", "50"}], "}"}]}], 
       "}"}]}], "]"}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"targets", "=", 
     RowBox[{"{", 
      RowBox[{"1.*^-5", ",", "1.*^-10", ",", "1.*^-20", ",", "1.*^-50"}], 
      "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<CUBIC: Gradient evaluations to reach target loss:\>\"",
      "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"Do", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"bestGE", "=", "Infinity"}], ";", " ", 
      RowBox[{"bestK", "=", "1"}], ";", " ", 
      RowBox[{"geForK", "=", 
       RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", "  ", 
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"curve", "=", 
          RowBox[{"geDataC", "[", "kVal", "]"}]}], ";", "\[IndentingNewLine]",
          "    ", 
         RowBox[{"hit", "=", 
          RowBox[{"Select", "[", 
           RowBox[{"curve", ",", 
            RowBox[{
             RowBox[{
              RowBox[{"#", "[", 
               RowBox[{"[", "2", "]"}], "]"}], "<=", "tgt"}], " ", "&"}]}], 
           "]"}]}], ";", "\[IndentingNewLine]", "    ", 
         RowBox[{"ge", "=", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Length", "[", "hit", "]"}], ">", "0"}], ",", 
            RowBox[{"hit", "[", 
             RowBox[{"[", 
              RowBox[{"1", ",", "1"}], "]"}], "]"}], ",", "Infinity"}], 
           "]"}]}], ";", "\[IndentingNewLine]", "    ", 
         RowBox[{"AppendTo", "[", 
          RowBox[{"geForK", ",", "ge"}], "]"}], ";", "\[IndentingNewLine]", 
         "    ", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"ge", "<", "bestGE"}], ",", 
           RowBox[{
            RowBox[{"bestGE", "=", "ge"}], ";", " ", 
            RowBox[{"bestK", "=", "kVal"}]}]}], "]"}]}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"{", 
         RowBox[{"kVal", ",", 
          RowBox[{"{", 
           RowBox[{"1", ",", "5", ",", "10", ",", "20", ",", "50"}], "}"}]}], 
         "}"}]}], "]"}], ";", "\[IndentingNewLine]", "  ", 
      RowBox[{"geK1", "=", 
       RowBox[{"geForK", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", "  ", 
      RowBox[{"speedup", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"bestGE", "<", "Infinity"}], "&&", 
          RowBox[{"geK1", "<", "Infinity"}]}], ",", 
         RowBox[{"N", "[", 
          RowBox[{"geK1", "/", "bestGE"}], "]"}], ",", "\"\<N/A\>\""}], 
        "]"}]}], ";", "\[IndentingNewLine]", "  ", 
      RowBox[{"Print", "[", 
       RowBox[{
        RowBox[{"ScientificForm", "[", 
         RowBox[{"tgt", ",", "1"}], "]"}], ",", "\"\<: best k=\>\"", ",", 
        "bestK", ",", "\[IndentingNewLine]", "    ", "\"\<, speedup=\>\"", ",", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"NumberQ", "[", "speedup", "]"}], ",", 
          RowBox[{
           RowBox[{"ToString", "[", 
            RowBox[{"NumberForm", "[", 
             RowBox[{"speedup", ",", "3"}], "]"}], "]"}], " ", "<>", 
           " ", "\"\<\[Times]\>\""}], ",", "speedup"}], "]"}]}], "]"}]}], ",",
      "\[IndentingNewLine]", "  ", 
     RowBox[{"{", 
      RowBox[{"tgt", ",", "targets"}], "}"}]}], "]"}]}]}]], "Input",Expression\
UUID->"4b93fb59-4c55-4746-b4ec-cc91b2739328"],

Cell[TextData[StyleBox["Result:",
