             "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
           "1d8162ab-eec3-4055-beca-30ce8fe20db6"]
         }],ExpressionUUID->"9692686d-b403-4049-aaa9-9e09f62d1d02"], Cell[
         BoxData[
          FormBox[
           TemplateBox[<|"boxes" -> FormBox[
               SuperscriptBox[
                RowBox[{"(", 
