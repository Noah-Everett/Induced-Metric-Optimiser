Cell["5. Stochastic Effects", "Section",ExpressionUUID->"04a0aa9e-836c-4e6d-9179-782252e6ccc7"],

Cell[TextData[{
 "With noisy gradients ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["g", "TI"], 
          StyleBox["i", "TI"]], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["h", "TI"], 
          StyleBox["i", "TI"]], 
         SubscriptBox["\[Theta]", 
          StyleBox["i", "TI"]], "+", 
         SubscriptBox["\[Sigma]", 
          StyleBox["i", "TI"]], 
         SubscriptBox["\[Epsilon]", 
          StyleBox["i", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "g_i = h_i\\theta_i + \\sigma_i\\epsilon_i", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "7cfc5bbd-ae80-4b1f-87ee-c23b042a7e8f"],
 ": ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["E", FontSlant -> "Plain"], 
         RowBox[{"[", 
           StyleBox["v", "TI"], "]"}], "\[LongEqual]", "2", "\[Xi]", 
         SubscriptBox[
          StyleBox["h", "TI"], "geo"], 
         StyleBox["L", "TI"], "+", "\[Xi]", 
         SubscriptBox[
          StyleBox["h", "TI"], "geo"], 
         UnderscriptBox["\[Sum]", 
          StyleBox["i", "TI"], LimitsPositioning -> True], 
         SubsuperscriptBox["\[Sigma]", 
          StyleBox["i", "TI"], "2"], "/", 
         SubscriptBox[
          StyleBox["h", "TI"], 
          StyleBox["i", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\mathbb{E}[v] = 2\\xi h_{\\text{geo}} L + \\xi h_{\\text{geo}} \\sum_i \
\\sigma_i^2/h_i", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "82837996-1b3c-4fe7-9214-feca53c2704c"],
 "The noise term ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Xi]", 
         SubscriptBox[
          StyleBox["h", "TI"], "geo"], 
         StyleBox["S", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\xi h_{\\text{geo}} S", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "2e6c1532-5161-4c50-9886-533c50d48e92"],
 " adds unwanted extra damping that reduces the effective learning rate even \
when ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["L", "TI"], TraditionalForm], "errors" -> {}, "input" -> "L", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5fea61ce-626c-4493-b359-a9e46e2ec23a"],
 " is small. For the plain embedding, this is strictly harmful. "
}], "Text",ExpressionUUID->"bafe4126-9163-4285-8158-a5cd39e8f8ec"],

Cell["6. Conclusion", "Section",ExpressionUUID->"251fc81a-0e4f-4bc7-9040-5cd2fe2e3a09"],

Cell[TextData[{
 "With Newton-targeted $s_i$, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Xi]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\xi", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "89360f83-875c-4b09-aa1b-a7779a310f0b"],
 " was the coupling constant between loss landscape and metric. \
Newton-targeting decouples them: the metric learns from Hessian information \
directly, not from the gradient outer product.",
 StyleBox["Plain embedding",
  FontWeight->Bold],
 ": Set ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Xi]", "\[LongEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\xi=0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "66cff384-6a8a-411a-9a4a-ba905e840807"],
 ". The optimizer reduces to diagonal Newton preconditioner + momentum + \
learning rate.",
 StyleBox["Log-loss embedding",
  FontWeight->Bold],
 ": ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Xi]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\xi", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "8ea93cd1-d627-4372-9b6e-4a82418949e2"],
 " is structurally required. Set ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Eta]", "\[LongEqual]", "2", "\[Xi]"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\eta = 2\\xi", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "35f19897-9092-40bf-bf64-7b30fa09316a"],
 " for optimal convergence near minima."
}], "Text",ExpressionUUID->"96529ef8-df4d-4bce-af9c-c058b3d266d2"]
},
