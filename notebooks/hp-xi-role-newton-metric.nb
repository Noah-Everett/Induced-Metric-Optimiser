             "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
           "6b50f4e8-c82d-4ca6-923a-45f7fad9f445"]
         }],ExpressionUUID->"475d0b3d-4218-4e3e-b327-7204c5db00bd"], Cell[
         BoxData[
          FormBox[
           TemplateBox[<|"boxes" -> FormBox[
