Cell["4. Fixed Point Analysis", "Section",ExpressionUUID->"8b9fbaf6-26e2-471b-b0f1-3077e36f43c3"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{"\[Xi]", ",", "\[Eta]", ",", "hgeo", ",", "LL"}], "]"}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Loss", " ", "map", " ", "derivatives", " ", "at", " ", "L"}], "=",
     "0"}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"fPlain", "[", 
    RowBox[{"\[Eta]_", ",", "\[Xi]_", ",", "hgeo_", ",", "LL_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "-", 
       RowBox[{"\[Eta]", " ", 
        RowBox[{"hgeo", "/", 
         RowBox[{"(", 
          RowBox[{"1", "+", 
           RowBox[{"2", " ", "\[Xi]", " ", "hgeo", " ", "LL"}]}], ")"}]}]}]}],
       ")"}], "^", "2"}], " ", "LL"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"fLog", "[", 
     RowBox[{"\[Eta]_", ",", "\[Xi]_", ",", "hgeo_", ",", "LL_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{"\[Eta]", " ", 
         RowBox[{"hgeo", "/", 
          RowBox[{"(", 
           RowBox[{"LL", "+", 
            RowBox[{"2", " ", "\[Xi]", " ", "hgeo"}]}], ")"}]}]}]}], ")"}], "^",
       "2"}], " ", "LL"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"Column", "[", 
  RowBox[{"{", "\[IndentingNewLine]", "  ", 
   RowBox[{
    RowBox[{"Row", "[", 
     RowBox[{"{", 
      RowBox[{"\"\<Plain f'(0) = \>\"", ",", 
       RowBox[{
        RowBox[{"Limit", "[", 
         RowBox[{
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{"fPlain", "[", 
             RowBox[{"\[Eta]", ",", "\[Xi]", ",", "hgeo", ",", "LL"}], "]"}], 
            ",", "LL"}], "]"}], ",", 
          RowBox[{"LL", "->", "0"}]}], "]"}], " ", "//", " ", "Simplify"}]}], 
      "}"}], "]"}], ",", "\[IndentingNewLine]", "  ", 
    RowBox[{"Row", "[", 
     RowBox[{"{", 
      RowBox[{"\"\<Log   f'(0) = \>\"", ",", 
       RowBox[{
        RowBox[{"Limit", "[", 
         RowBox[{
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{"fLog", "[", 
             RowBox[{"\[Eta]", ",", "\[Xi]", ",", "hgeo", ",", "LL"}], "]"}], 
            ",", "LL"}], "]"}], ",", 
          RowBox[{"LL", "->", "0"}], ",", "\[IndentingNewLine]", "    ", 
          RowBox[{"Assumptions", "->", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"\[Xi]", ">", "0"}], ",", 
             RowBox[{"\[Eta]", ">", "0"}], ",", 
             RowBox[{"hgeo", ">", "0"}]}], "}"}]}]}], "]"}], " ", "//", " ", 
        "Simplify"}]}], "}"}], "]"}]}], "\[IndentingNewLine]", "}"}], 
  "]"}]}], "Input",ExpressionUUID->"d321fd0f-64b1-45a9-bbdc-079d1e0e6a7c"],

