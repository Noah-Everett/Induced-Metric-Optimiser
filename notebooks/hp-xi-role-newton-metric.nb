Notebook[{
Cell["IMO-86: Role of \[Xi] with Newton-Targeted Metric", "Title",ExpressionUUID->"cbc0dc96-0ef2-4ea7-a8ae-b64ea5036f24"],

Cell[TextData[{
 "Companion analysis to ",
 Cell[BoxData[Cell["notes/xi-role-newton-metric.md",
   Background->None,ExpressionUUID->"ea8d23f0-2769-4d81-9493-5e271fca203f"]], 
  "InlineCode",ExpressionUUID->"e0e33ca5-3f97-43d3-9155-a91a5de7f83c"],
 ". "
}], "Text",ExpressionUUID->"32e5772d-17c0-4f7b-b116-4955622410ae"],

Cell["1. Setup: Quadratic with Newton-targeted s_i", "Section",ExpressionUUID->"978c7e8f-37ac-4823-b5e5-d326ffd94dc6"],

Cell[TextData[{
 "Loss ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["L", "TI"], "\[LongEqual]", 
         FractionBox["1", "2"], 
         UnderscriptBox["\[Sum]", 
          StyleBox["i", "TI"], LimitsPositioning -> True], 
         SubscriptBox[
          StyleBox["h", "TI"], 
          StyleBox["i", "TI"]], 
         SubsuperscriptBox["\[Theta]", 
          StyleBox["i", "TI"], "2"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "L = \\frac{1}{2}\\sum_i h_i \\theta_i^2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d575bf81-cebc-44cc-82d3-392acc401f3a"],
 " with diagonal Hessian ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["H", "TI"], "\[LongEqual]", "diag", 
         RowBox[{"(", 
           RowBox[{
             SubscriptBox[
              StyleBox["h", "TI"], "1"], ",", "\[Ellipsis]", ",", 
             SubscriptBox[
              StyleBox["h", "TI"], 
              StyleBox["N", "TI"]]}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> "H = \\text{diag}(h_1,\\ldots,h_N)", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "127a1c65-b441-4b45-b235-b406658219c6"],
 "."
}], "Text",ExpressionUUID->"fe6b2dfd-0c41-418e-bf49-07adf52532a4"],

Cell[TextData[{
 "Newton-targeted metric: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["e", "TI"], 
          SubscriptBox[
           StyleBox["s", "TI"], 
           StyleBox["i", "TI"]]], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["h", "TI"], "geo"], "/", 
         SubscriptBox[
          StyleBox["h", "TI"], 
          StyleBox["i", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "e^{s_i} = h_{\\text{geo}}/h_i", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "eb06a681-812e-4e10-986d-ac542534bd1c"],
 " where ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["h", "TI"], "geo"], "\[LongEqual]", 
         SuperscriptBox[
          RowBox[{"(", 
            RowBox[{"\[Product]", 
              SubscriptBox[
               StyleBox["h", "TI"], 
               StyleBox["i", "TI"]]}], ")"}], 
          RowBox[{"1", "/", 
            StyleBox["N", "TI"]}]]}], TraditionalForm], "errors" -> {}, 
     "input" -> "h_{\\text{geo}} = (\\prod h_i)^{1/N}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "456d7d54-7ff5-4cc5-b711-a19e9c42a443"],
 ".",
 StyleBox["Verify",
  FontWeight->Bold],
 ": the trace statistic ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["v", "TI"], "\[LongEqual]", "\[Xi]", 
         UnderscriptBox["\[Sum]", 
          StyleBox["i", "TI"], LimitsPositioning -> True], 
         SuperscriptBox[
          StyleBox["e", "TI"], 
          SubscriptBox[
           StyleBox["s", "TI"], 
           StyleBox["i", "TI"]]], 
         SubsuperscriptBox[
          StyleBox["g", "TI"], 
          StyleBox["i", "TI"], "2"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "v = \\xi\\sum_i e^{s_i} g_i^2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "575d1d40-d1af-4884-b99a-404342db937a"],
 " simplifies to ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["v", "TI"], "\[LongEqual]", "2", "\[Xi]", 
         SubscriptBox[
          StyleBox["h", "TI"], "geo"], 
         StyleBox["L", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "v = 2\\xi h_{\\text{geo}} L", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d9394be5-bb9e-4a85-b381-893b373cf68d"],
 ". "
}], "Text",ExpressionUUID->"fd33ef51-4b50-4e74-bc7f-337453c24848"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Symbolic", " ", "verification", " ", "for", " ", "N"}], "=", 
    "4"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"n", "=", "4"}], ",", "h", ",", "\[Theta]", ",", "si", ",", 
      "esi", ",", "g", ",", "v", ",", "loss", ",", "ratio", ",", "hgeo"}], 
     "}"}], ",", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"h", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Subscript", "[", 
         RowBox[{"hh", ",", "i"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "n"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"\[Theta]", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Subscript", "[", 
         RowBox[{"\[Theta]\[Theta]", ",", "i"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "n"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"si", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"-", 
          RowBox[{"Log", "[", 
           RowBox[{"h", "[", 
            RowBox[{"[", "i", "]"}], "]"}], "]"}]}], "+", 
         RowBox[{"Mean", "[", 
          RowBox[{"Log", "[", "h", "]"}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "n"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"esi", "=", 
      RowBox[{"Exp", " ", "/@", " ", "si"}]}], ";", "\[IndentingNewLine]", 
     "  ", 
     RowBox[{"g", "=", 
      RowBox[{"h", "*", "\[Theta]"}]}], ";", "\[IndentingNewLine]", "  ", 
     RowBox[{"v", "=", 
      RowBox[{"\[Xi]", "*", 
       RowBox[{"Total", "[", 
        RowBox[{"esi", "*", 
         RowBox[{"g", "^", "2"}]}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     "  ", 
     RowBox[{"loss", "=", 
      RowBox[{
       RowBox[{"Total", "[", 
        RowBox[{"h", "*", 
         RowBox[{"\[Theta]", "^", "2"}]}], "]"}], "/", "2"}]}], ";", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"hgeo", "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"Times", " ", "@@", " ", "h"}], ")"}], "^", 
       RowBox[{"(", 
        RowBox[{"1", "/", "n"}], ")"}]}]}], ";", "\[IndentingNewLine]", "  ", 
     
     RowBox[{"ratio", "=", 
      RowBox[{"FullSimplify", "[", 
       RowBox[{
        RowBox[{"v", "/", 
         RowBox[{"(", 
          RowBox[{"2", " ", "\[Xi]", "*", "loss"}], ")"}]}], ",", 
        RowBox[{"Assumptions", "->", 
         RowBox[{
          RowBox[{"Thread", "[", 
           RowBox[{"h", ">", "0"}], "]"}], "&&", 
          RowBox[{"Thread", "[", 
           RowBox[{"\[Theta]", ">", "0"}], "]"}]}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"Column", "[", 
      RowBox[{"{", "\[IndentingNewLine]", "    ", 
       RowBox[{
        RowBox[{"Row", "[", 
         RowBox[{"{", 
          RowBox[{"\"\<v / (2\[Xi]L) = \>\"", ",", "ratio"}], "}"}], "]"}], ",",
         "\[IndentingNewLine]", "    ", 
        RowBox[{"Row", "[", 
         RowBox[{"{", 
          RowBox[{"\"\<h_geo = \>\"", ",", "hgeo"}], "}"}], "]"}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"Row", "[", 
         RowBox[{"{", 
          RowBox[{"\"\<Equal? \>\"", ",", 
           RowBox[{"FullSimplify", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"ratio", "-", "hgeo"}], "==", "0"}], ",", 
             RowBox[{"Assumptions", "->", 
              RowBox[{"Thread", "[", 
               RowBox[{"h", ">", "0"}], "]"}]}]}], "]"}]}], "}"}], "]"}]}], 
       "\[IndentingNewLine]", "  ", "}"}], "]"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",ExpressionUUID->"422358db-1db3-439f-8ea6-2cf2b398f0b4"],

Cell[TextData[{
 StyleBox["Result",
  FontWeight->Bold],
 ": ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["v", "TI"], "\[LongEqual]", "2", "\[Xi]", 
         SubscriptBox[
          StyleBox["h", "TI"], "geo"], 
         StyleBox["L", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "v = 2\\xi h_{\\text{geo}} L", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "28e781a2-a6a1-4276-99b5-3c5248bb3dc7"],
 ". The trace statistic is proportional to the loss times the geometric mean \
eigenvalue. "
}], "Text",ExpressionUUID->"edf9794d-e94f-4ba4-b04a-06f47b7c65b4"],

Cell["2. Plain Embedding: r = 1/(1 + |v\:0302|)", "Section",ExpressionUUID->"d46d2b9e-2a54-4919-8a11-ab5e5a1d9656"],

Cell[TextData[{
 "With the Newton metric at equilibrium, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         OverscriptBox[
          StyleBox["v", "TI"], "^"], "\[LongEqual]", 
         StyleBox["v", "TI"], "\[LongEqual]", "2", "\[Xi]", 
         SubscriptBox[
          StyleBox["h", "TI"], "geo"], 
         StyleBox["L", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\hat{v} = v = 2\\xi h_{\\text{geo}} L", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "cd15a8d1-ad6e-448f-b56e-a9d0afe706cb"],
 ": ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["r", "TI"], "\[LongEqual]", 
         FractionBox["1", 
          RowBox[{"1", "+", "2", "\[Xi]", 
            SubscriptBox[
             StyleBox["h", "TI"], "geo"], 
            StyleBox["L", "TI"]}]]}], TraditionalForm], "errors" -> {}, 
     "input" -> "r = \\frac{1}{1 + 2\\xi h_{\\text{geo}} L}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f3fccf66-ee78-4f88-9ef0-4b696d22c955"],
 "The parameter update (all coordinates contract uniformly): ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubsuperscriptBox["\[Theta]", 
          StyleBox["i", "TI"], "new"], "\[LongEqual]", 
         RowBox[{"(", 
           RowBox[{"1", "-", 
             FractionBox[
              RowBox[{"\[Eta]", 
                SubscriptBox[
                 StyleBox["h", "TI"], "geo"]}], 
              RowBox[{"1", "+", "2", "\[Xi]", 
                SubscriptBox[
                 StyleBox["h", "TI"], "geo"], 
                StyleBox["L", "TI"]}]]}], ")"}], 
         SubscriptBox["\[Theta]", 
          StyleBox["i", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\theta_i^{\\text{new}} = \\left(1 - \\frac{\\eta h_{\\text{geo}}}{1 + \
2\\xi h_{\\text{geo}} L}\\right) \\theta_i", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "054cfb35-4d9a-42d0-8c6f-c67a01ed9fb9"]
}], "Text",ExpressionUUID->"507a81c9-f1a4-4513-8243-70bed07c274a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Contraction", " ", "factor", " ", "and", " ", "convergence", " ", 
    "rate"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", 
     RowBox[{"\[Xi]", ",", "\[Eta]", ",", "hgeo", ",", "LL"}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"\[Rho]Plain", "[", 
      RowBox[{"\[Eta]_", ",", "\[Xi]_", ",", "hgeo_", ",", "LL_"}], "]"}], ":=", 
     RowBox[{"1", "-", 
      RowBox[{"\[Eta]", " ", 
       RowBox[{"hgeo", "/", 
        RowBox[{"(", 
         RowBox[{"1", "+", 
          RowBox[{"2", " ", "\[Xi]", " ", "hgeo", " ", "LL"}]}], 
         ")"}]}]}]}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"Column", "[", 
    RowBox[{"{", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"Row", "[", 
       RowBox[{"{", 
        RowBox[{"\"\<\[Rho](L) = \>\"", ",", 
         RowBox[{"\[Rho]Plain", "[", 
          RowBox[{"\[Eta]", ",", "\[Xi]", ",", "hgeo", ",", "LL"}], "]"}]}], 
        "}"}], "]"}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"Row", "[", 
       RowBox[{"{", 
        RowBox[{"\"\<L\[RightArrow]0: \[Rho] \[RightArrow] \>\"", ",", 
         RowBox[{"Limit", "[", 
          RowBox[{
           RowBox[{"\[Rho]Plain", "[", 
            RowBox[{"\[Eta]", ",", "\[Xi]", ",", "hgeo", ",", "LL"}], "]"}], ",", 
           RowBox[{"LL", "->", "0"}]}], "]"}]}], "}"}], "]"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"Row", "[", 
       RowBox[{"{", 
        RowBox[{"\"\<L\[RightArrow]\[Infinity]: \[Rho] \[RightArrow] \>\"", ",", 
         RowBox[{"Limit", "[", 
          RowBox[{
           RowBox[{"\[Rho]Plain", "[", 
            RowBox[{"\[Eta]", ",", "\[Xi]", ",", "hgeo", ",", "LL"}], "]"}], ",", 
           RowBox[{"LL", "->", "Infinity"}]}], "]"}]}], "}"}], "]"}]}], 
     "\[IndentingNewLine]", "}"}], "]"}]}]}]], "Input",ExpressionUUID->\
"d67acf04-920b-4089-b170-8b6935ff18ef"],

Cell[TextData[{
 StyleBox["Key result",
  FontWeight->Bold],
 ": The local convergence rate at ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["L", "TI"], "\[LongEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "L=0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "fb963987-1e58-42bc-a144-555908b9e3ae"],
 " is ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox[
        RowBox[{"(", 
          RowBox[{"1", "-", "\[Eta]", 
            SubscriptBox[
             StyleBox["h", "TI"], "geo"]}], ")"}], "2"], TraditionalForm], 
     "errors" -> {}, "input" -> "(1-\\eta h_{\\text{geo}})^2", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ee12a28c-7eca-40bd-9150-bcf383e96617"],
 ", ",
 StyleBox["independent of \[Xi]",
  FontWeight->Bold],
 ". "
}], "Text",ExpressionUUID->"076c27fd-b984-4734-9ea5-c585c514f9ce"],

Cell["Convergence trajectories", "Subsection",ExpressionUUID->"6fb234d4-3621-43e0-babd-85f5bf3d62e9"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Compare", " ", "\[Xi]", " ", "values", " ", "on", " ", "the", " ", "loss",
     " ", "map"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"hgeoVal", "=", "1.0"}], ";", " ", 
    RowBox[{"\[Eta]Val", "=", "0.8"}], ";", " ", 
    RowBox[{"L0val", "=", "100.0"}], ";", " ", 
    RowBox[{"nSteps", "=", "50"}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"trajectoryPlain", "[", "\[Xi]val_", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"LL", "=", "L0val"}], ",", 
         RowBox[{"traj", "=", 
          RowBox[{"{", "L0val", "}"}]}]}], "}"}], ",", "\[IndentingNewLine]", 
       "  ", 
       RowBox[{
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{"Module", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"r", "=", 
              RowBox[{"1", "/", 
               RowBox[{"(", 
                RowBox[{"1", "+", 
                 RowBox[{"2", " ", "\[Xi]val", " ", "hgeoVal", " ", "LL"}]}], 
                ")"}]}]}], "}"}], ",", "\[IndentingNewLine]", "    ", 
            RowBox[{
             RowBox[{"LL", "=", 
              RowBox[{
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"1", "-", 
                  RowBox[{"\[Eta]Val", " ", "hgeoVal", " ", "r"}]}], ")"}], "^",
                 "2"}], " ", "LL"}]}], ";", "\[IndentingNewLine]", "    ", 
             RowBox[{"AppendTo", "[", 
              RowBox[{"traj", ",", "LL"}], "]"}]}]}], "]"}], ",", 
          RowBox[{"{", "nSteps", "}"}]}], "]"}], ";", " ", "traj"}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"ListLogPlot", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"trajectoryPlain", "[", "0", "]"}], ",", 
       RowBox[{"trajectoryPlain", "[", "0.1", "]"}], ",", 
       RowBox[{"trajectoryPlain", "[", "1.0", "]"}], ",", 
       RowBox[{"trajectoryPlain", "[", "10.0", "]"}]}], "}"}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"PlotLegends", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<\[Xi]=0\>\"", ",", "\"\<\[Xi]=0.1\>\"", 
        ",", "\"\<\[Xi]=1\>\"", ",", "\"\<\[Xi]=10\>\""}], "}"}]}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"AxesLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<Step\>\"", ",", "\"\<Loss\>\""}], "}"}]}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{
     "PlotLabel", 
      "->", "\"\<Plain embedding: \[Eta]=0.8, h_geo=1, L\:2080=100\>\""}], ",",
      "\[IndentingNewLine]", "  ", 
     RowBox[{"PlotRange", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"10", "^", 
         RowBox[{"-", "30"}]}], ",", "200"}], "}"}]}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"ImageSize", "->", "600"}]}], "\[IndentingNewLine]", 
    "]"}]}]}]], "Input",ExpressionUUID->"ed1f750e-166f-4d44-860e-\
a8ce618f43d0"],

Cell[TextData[{
 StyleBox["Result",
  FontWeight->Bold],
 ": \[Xi]=0 converges fastest. \[Xi]>0 slows convergence by damping the \
Newton step. "
}], "Text",ExpressionUUID->"45d840df-490f-4233-a64b-26793ef03b9a"],

Cell["3. Log-Loss Embedding: r = L/(L\.b2 + |v\:0302|)", "Section",ExpressionUUID->"056ec550-ddab-44a2-b7f2-bf76c5eacaea"],

Cell[TextData[Cell[BoxData[
 FormBox[
  TemplateBox[<|"boxes" -> FormBox[
      RowBox[{
        StyleBox["r", "TI"], "\[LongEqual]", 
        FractionBox[
         StyleBox["L", "TI"], 
         RowBox[{
           SuperscriptBox[
            StyleBox["L", "TI"], "2"], "+", "2", "\[Xi]", 
           SubscriptBox[
            StyleBox["h", "TI"], "geo"], 
           StyleBox["L", "TI"]}]], "\[LongEqual]", 
        FractionBox["1", 
         RowBox[{
           StyleBox["L", "TI"], "+", "2", "\[Xi]", 
           SubscriptBox[
            StyleBox["h", "TI"], "geo"]}]]}], TraditionalForm], 
    "errors" -> {}, "input" -> 
    "r = \\frac{L}{L^2 + 2\\xi h_{\\text{geo}} L} = \\frac{1}{L + 2\\xi \
h_{\\text{geo}}}", "state" -> "Boxes"|>,
   "TeXAssistantTemplate"], 
  TraditionalForm]],ExpressionUUID->"6c17f07a-3ff6-4530-9827-8e7c16d407c8"]], \
"Text",ExpressionUUID->"ba3acee7-77dc-4058-830d-6db6aab0cd19"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{"\[Xi]", ",", "\[Eta]", ",", "hgeo", ",", "LL"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"\[Rho]Log", "[", 
     RowBox[{"\[Eta]_", ",", "\[Xi]_", ",", "hgeo_", ",", "LL_"}], "]"}], ":=", 
    RowBox[{"1", "-", 
     RowBox[{"\[Eta]", " ", 
      RowBox[{"hgeo", "/", 
       RowBox[{"(", 
        RowBox[{"LL", "+", 
         RowBox[{"2", " ", "\[Xi]", " ", "hgeo"}]}], ")"}]}]}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"Column", "[", 
  RowBox[{"{", "\[IndentingNewLine]", "  ", 
   RowBox[{
    RowBox[{"Row", "[", 
     RowBox[{"{", 
      RowBox[{"\"\<\[Rho](L) = \>\"", ",", 
       RowBox[{"\[Rho]Log", "[", 
        RowBox[{"\[Eta]", ",", "\[Xi]", ",", "hgeo", ",", "LL"}], "]"}]}], 
      "}"}], "]"}], ",", "\[IndentingNewLine]", "  ", 
    RowBox[{"Row", "[", 
     RowBox[{"{", 
      RowBox[{"\"\<L\[RightArrow]0: \[Rho] \[RightArrow] \>\"", ",", 
       RowBox[{"Limit", "[", 
        RowBox[{
         RowBox[{"\[Rho]Log", "[", 
          RowBox[{"\[Eta]", ",", "\[Xi]", ",", "hgeo", ",", "LL"}], "]"}], ",", 
         RowBox[{"LL", "->", "0"}], ",", 
         RowBox[{"Assumptions", "->", 
          RowBox[{"{", 
           RowBox[{"\[Xi]", ">", "0"}], "}"}]}]}], "]"}]}], "}"}], "]"}], ",",
     "\[IndentingNewLine]", "  ", 
    RowBox[{"Row", "[", 
     RowBox[{"{", 
      RowBox[{"\"\<L\[RightArrow]\[Infinity]: \[Rho] \[RightArrow] \>\"", ",", 
       RowBox[{"Limit", "[", 
        RowBox[{
         RowBox[{"\[Rho]Log", "[", 
          RowBox[{"\[Eta]", ",", "\[Xi]", ",", "hgeo", ",", "LL"}], "]"}], ",", 
         RowBox[{"LL", "->", "Infinity"}]}], "]"}]}], "}"}], "]"}], ",", 
    "\[IndentingNewLine]", "  ", "\"\<\>\"", ",", "\[IndentingNewLine]", "  ", 
    RowBox[{"Row", "[", 
     RowBox[{"{", 
      RowBox[{"\"\<\[Xi]=0, L\[RightArrow]0: \[Rho] \[RightArrow] \>\"", ",", 
       
       RowBox[{"Limit", "[", 
        RowBox[{
         RowBox[{"1", "-", 
          RowBox[{"\[Eta]", " ", 
           RowBox[{"hgeo", "/", "LL"}]}]}], ",", 
         RowBox[{"LL", "->", "0"}]}], "]"}]}], "}"}], "]"}], ",", 
    "\[IndentingNewLine]", 
    "  ", "\"\<\[Xi]=0 is SINGULAR \[LongDash] r diverges as L\[RightArrow]0!\
\>\""}], "\[IndentingNewLine]", "}"}], "]"}]}], "Input",ExpressionUUID->\
"6f04aa0b-1fe4-476b-adb7-e088c783cb4a"],

Cell[TextData[{
 StyleBox["Key results",
  FontWeight->Bold],
 ": "
}], "Text",ExpressionUUID->"e7a06278-3b52-4e10-9e9b-f731dd60e5c2"],

Cell[TextData[{
 "Near minimum: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Rho]", "\[Rule]", "1", "-", "\[Eta]", "/", 
         RowBox[{"(", 
           RowBox[{"2", "\[Xi]"}], ")"}]}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\rho \\to 1 - \\eta/(2\\xi)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5fc2cc53-4caf-4a52-b9f4-de0a617607e4"],
 ", ",
 "independent of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["h", "TI"], "geo"], TraditionalForm], "errors" -> {}, 
     "input" -> "h_{\\text{geo}}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "946c3796-f95f-4e49-b035-9caa7b8293d1"]
}], "Item",ExpressionUUID->"8906916c-2975-474e-9878-a2ef77ffbf63"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Xi]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\xi", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "3ff0ec4d-8291-4eff-95a3-602a6d0594e2"],
 " directly controls the effective learning rate: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
