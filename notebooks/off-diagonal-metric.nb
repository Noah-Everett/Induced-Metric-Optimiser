      RowBox[{"-", 
       RowBox[{"(", 
        RowBox[{"\[Gamma]Inv", ".", "a"}], ")"}]}], "/", "S"}]}], ";"}], 
   "                          ", 
   RowBox[{"(*", 
    RowBox[{"n", "\[Times]", "1", " ", "block"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"g21", "=", 
