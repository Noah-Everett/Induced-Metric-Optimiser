   RowBox[{
    RowBox[{"g22", "=", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"1", "/", "S"}], "}"}], "}"}]}], ";"}], 
   "                               ", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"1", "\[Times]", "1", " ", "block"}], ",", 
     RowBox[{"wrapped", " ", "as", " ", 
      RowBox[{"{", 
       RowBox[{"{", "...", "}"}], "}"}]}]}], "*)"}], "\n", 
