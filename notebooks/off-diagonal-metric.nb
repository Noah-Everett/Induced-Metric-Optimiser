     RowBox[{
      RowBox[{"Schur", " ", "complement", " ", "S"}], "=", 
      RowBox[{"1", "-", 
       RowBox[{
        RowBox[{"b", "^", "T"}], " ", 
        RowBox[{"\[Gamma]", "^", 
         RowBox[{"-", "1"}]}], " ", "a"}]}]}], ";", "scalar"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"S", "=", 
     RowBox[{"1", "-", 
      RowBox[{"Tr", "[", 
       RowBox[{
        RowBox[{"Transpose", "[", "b", "]"}], ".", "\[Gamma]Inv", ".", "a"}], 
       "]"}]}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Block", " ", "components", " ", "of", " ", "the", " ", "theoretical", 
     " ", "inverse"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"g11", "=", 
     RowBox[{"\[Gamma]Inv", "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"\[Gamma]Inv", ".", "a", ".", 
         RowBox[{"Transpose", "[", "b", "]"}], ".", "\[Gamma]Inv"}], ")"}], 
       "/", "S"}]}]}], ";"}], "   ", 
   RowBox[{"(*", 
    RowBox[{"n", "\[Times]", "n", " ", "block"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"g12", "=", 
