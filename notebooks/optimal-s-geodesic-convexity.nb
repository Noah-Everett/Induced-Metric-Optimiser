         RowBox[{"{", 
          RowBox[{"ds12v", ",", 
           RowBox[{"-", "10"}], ",", "10"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"ds21v", ",", 
           RowBox[{"-", "10"}], ",", "10"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"ds22v", ",", 
           RowBox[{"-", "10"}], ",", "10"}], "}"}]}], "}"}], ",", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"Method", "->", "\"\<NelderMead\>\""}], ",", 
       RowBox[{"MaxIterations", "->", "5000"}]}], "\[IndentingNewLine]", 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<=== Test 1: L = x\.b2 - y\.b2 at (1, 0.5) ===\>\"", 
     "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<H = \>\"", ",", 
      RowBox[{"MatrixForm", "[", "h1", "]"}], ",", "\"\<, g = \>\"", ",", 
      "gVec1"}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
