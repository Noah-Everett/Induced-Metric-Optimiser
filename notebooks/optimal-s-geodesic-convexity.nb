     RowBox[{"\"\<\\nOptimal parameters: \>\"", ",", 
      RowBox[{"result1", "[", 
       RowBox[{"[", "2", "]"}], "]"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
   
   RowBox[{
