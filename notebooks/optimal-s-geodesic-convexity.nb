   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"effectiveH3", "[", 
      RowBox[{"ds11v_", ",", "ds12v_", ",", "ds21v_", ",", "ds22v_"}], "]"}], 
     ":=", "\[IndentingNewLine]", "  ", 
     RowBox[{"h3", "-", 
      RowBox[{"(", 
       RowBox[{"cMatrixAt0", " ", "/.", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"ds11", "->", "ds11v"}], ",", 
          RowBox[{"ds12", "->", "ds12v"}], ",", 
          RowBox[{"ds21", "->", "ds21v"}], ",", 
