          RowBox[{"ds22v", ",", 
           RowBox[{"-", "200"}], ",", "200"}], "}"}]}], "}"}], ",", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"Method", "->", "\"\<DifferentialEvolution\>\""}], ",", 
