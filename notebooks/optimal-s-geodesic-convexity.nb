      RowBox[{
       RowBox[{"Min", "[", 
        RowBox[{"Eigenvalues", "[", "effH3", "]"}], "]"}], ">", "0"}]}], 
     "]"}], ";"}]}]}]], "Input",ExpressionUUID->"dde6c1a9-e21e-43b0-8f23-\
57deb16a4c8b"],

Cell["Part V: The Universal Rule", "Section",ExpressionUUID->"e7a6ccb8-d587-4c0c-b692-0dbb6c55bbf6"],

Cell[TextData[{
 "Verify that the optimal derivative satisfies ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[PartialD]", 
          StyleBox["i", "TI"]], 
         SubscriptBox[
          StyleBox["s", "TI"], 
          StyleBox["i", "TI"]], "\[LongEqual]", "2", 
         SubscriptBox[
          StyleBox["H", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["i", "TI"]}]], "/", 
         SubscriptBox[
          StyleBox["g", "TI"], 
          StyleBox["i", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\partial_i s_i = 2 H_{ii} / g_i", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e78c1c39-db68-47dc-a346-a56e25ce86c1"],
 " at ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["s", "TI"], "1"], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["s", "TI"], "2"], "\[LongEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "s_1 = s_2 = 0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e8b8b8f9-808b-4fcf-9e8b-498cdbaf6ead"],
 ". "
}], "Text",ExpressionUUID->"b2f4d818-c112-4057-9bb1-5713ffd897d5"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
   "Print", "[", "\"\<=== Universal Rule Verification: \[PartialD]_i s_i = 2 \
H_{ii} / g_i ===\\n\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"At", " ", "s1"}], "=", 
     RowBox[{"s2", "=", "0"}]}], ",", " ", 
    RowBox[{"the", " ", "diagonal", " ", "entry", " ", "C_", 
     RowBox[{"{", "ii", "}"}], " ", "simplifies", " ", 
     RowBox[{"to", ":"}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"C_", 
     RowBox[{"{", "ii", "}"}]}], " ", "=", " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"\[PartialD]", "_i"}], " ", "s_i"}], ")"}], " ", "g_i"}]}], 
   " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"For", " ", "H"}], "-", 
     RowBox[{"C", " ", "to", " ", "have", " ", "H_", 
      RowBox[{"{", "ii", "}"}]}], " ", "-", " ", 
     RowBox[{"C_", 
      RowBox[{"{", "ii", "}"}]}]}], " ", "=", " ", 
    RowBox[{
     RowBox[{"H_", 
      RowBox[{"{", "ii", "}"}]}], " ", "-", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"\[PartialD]", "_i"}], " ", "s_i"}], ")"}], " ", "g_i"}]}]}], 
   " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Setting", " ", 
      RowBox[{"\[PartialD]", "_i"}], " ", "s_i"}], " ", "=", " ", 
     RowBox[{
      RowBox[{"H_", 
       RowBox[{
        RowBox[{"{", "ii", "}"}], "/", "g_i"}], " ", "makes", " ", "C_", 
       RowBox[{"{", "ii", "}"}]}], " ", "=", " ", 
      RowBox[{"H_", 
       RowBox[{"{", "ii", "}"}]}]}]}], ",", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"so", " ", "diagonal", " ", "of", " ", "H"}], "-", "C"}], " ", "=",
      " ", "0"}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"But", " ", "for", " ", "saddle", " ", "points"}], ",", " ", 
    RowBox[{
    "we", " ", "want", " ", "to", " ", "flip", " ", "the", " ", "sign", " ", 
     "of", " ", "negative", " ", "eigenvalues"}]}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"So", " ", 
     RowBox[{"\[PartialD]", "_i"}], " ", "s_i"}], " ", "=", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"2", " ", "H_", 
       RowBox[{
        RowBox[{"{", "ii", "}"}], "/", "g_i"}], " ", "makes", " ", "H_", 
       RowBox[{"{", "ii", "}"}]}], " ", "-", " ", 
      RowBox[{"C_", 
       RowBox[{"{", "ii", "}"}]}]}], " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"H_", 
        RowBox[{"{", "ii", "}"}]}], " ", "-", " ", 
       RowBox[{"2", "H_", 
        RowBox[{"{", "ii", "}"}]}]}], " ", "=", " ", 
      RowBox[{
       RowBox[{"-", "H_"}], 
       RowBox[{"{", "ii", "}"}]}]}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"This", " ", "flips", " ", "negative", " ", "to", " ", 
    RowBox[{"positive", "!"}]}], " ", "*)"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"Test", " ", "1", " ", "prediction"}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"pred1", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"2", " ", 
      RowBox[{
       RowBox[{"h1", "[", 
        RowBox[{"[", 
         RowBox[{"1", ",", "1"}], "]"}], "]"}], "/", 
       RowBox[{"gVec1", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}]}], ",", 
     RowBox[{"2", " ", 
      RowBox[{
       RowBox[{"h1", "[", 
        RowBox[{"[", 
         RowBox[{"2", ",", "2"}], "]"}], "]"}], "/", 
       RowBox[{"gVec1", "[", 
        RowBox[{"[", "2", "]"}], "]"}]}]}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Test 1: predicted \[PartialD]\:2081s\:2081 = \>\"", ",", 
    RowBox[{"pred1", "[", 
     RowBox[{"[", "1", "]"}], "]"}], 
    ",", "\"\<, \[PartialD]\:2082s\:2082 = \>\"", ",", 
    RowBox[{"pred1", "[", 
     RowBox[{"[", "2", "]"}], "]"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Print", "[", 
    RowBox[{"\"\<  Actual optimal ds11 = \>\"", ",", 
     RowBox[{"ds11v", " ", "/.", " ", 
      RowBox[{"result1", "[", 
       RowBox[{"[", "2", "]"}], "]"}]}], ",", "\"\<, ds22 = \>\"", ",", 
     RowBox[{"ds22v", " ", "/.", " ", 
      RowBox[{"result1", "[", 
       RowBox[{"[", "2", "]"}], "]"}]}]}], "]"}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"Test", " ", "2", " ", "prediction"}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"pred2", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"2", " ", 
      RowBox[{
       RowBox[{"h2", "[", 
        RowBox[{"[", 
         RowBox[{"1", ",", "1"}], "]"}], "]"}], "/", 
       RowBox[{"gVec2", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}]}], ",", 
     RowBox[{"2", " ", 
      RowBox[{
       RowBox[{"h2", "[", 
        RowBox[{"[", 
         RowBox[{"2", ",", "2"}], "]"}], "]"}], "/", 
       RowBox[{"gVec2", "[", 
        RowBox[{"[", "2", "]"}], "]"}]}]}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
