         RowBox[{"ds11v", ",", "ds12v", ",", "ds21v", ",", "ds22v"}], "]"}], 
        "}"}], ",", "\[IndentingNewLine]", "  ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"ds11v", ",", 
           RowBox[{"-", "200"}], ",", "200"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"ds12v", ",", 
           RowBox[{"-", "200"}], ",", "200"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"ds21v", ",", 
           RowBox[{"-", "200"}], ",", "200"}], "}"}], ",", 
