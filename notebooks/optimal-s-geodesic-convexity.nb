     RowBox[{"[", "2", "]"}], "]"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Print", "[", 
    RowBox[{"\"\<  Actual optimal ds11 = \>\"", ",", 
     RowBox[{"ds11v", " ", "/.", " ", 
      RowBox[{"result2", "[", 
       RowBox[{"[", "2", "]"}], "]"}]}], ",", "\"\<, ds22 = \>\"", ",", 
     RowBox[{"ds22v", " ", "/.", " ", 
      RowBox[{"result2", "[", 
       RowBox[{"[", "2", "]"}], "]"}]}]}], "]"}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"Test", " ", "3", " ", "prediction"}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"pred3", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"2", " ", 
      RowBox[{
       RowBox[{"h3", "[", 
        RowBox[{"[", 
         RowBox[{"1", ",", "1"}], "]"}], "]"}], "/", 
       RowBox[{"gVec3", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}]}], ",", 
     RowBox[{"2", " ", 
      RowBox[{
       RowBox[{"h3", "[", 
        RowBox[{"[", 
         RowBox[{"2", ",", "2"}], "]"}], "]"}], "/", 
       RowBox[{"gVec3", "[", 
        RowBox[{"[", "2", "]"}], "]"}]}]}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<\\nTest 3: predicted \[PartialD]\:2081s\:2081 = \>\"", ",", 
    RowBox[{"pred3", "[", 
     RowBox[{"[", "1", "]"}], "]"}], 
    ",", "\"\<, \[PartialD]\:2082s\:2082 = \>\"", ",", 
