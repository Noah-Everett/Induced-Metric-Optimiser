Cell[TextData[{
 "Perturb the optimal ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["d", "TI"], 
         SubscriptBox[
          StyleBox["s", "TI"], "22"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "ds_{22}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "08b9df91-1981-428c-ab7c-928fb3f55ab4"],
 " by ",
