   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"minEig3", "[", 
      RowBox[{
       RowBox[{"ds11v_", "?", "NumericQ"}], ",", 
       RowBox[{"ds12v_", "?", "NumericQ"}], ",", 
       RowBox[{"ds21v_", "?", "NumericQ"}], ",", 
       RowBox[{"ds22v_", "?", "NumericQ"}]}], "]"}], ":=", 
     "\[IndentingNewLine]", "  ", 
