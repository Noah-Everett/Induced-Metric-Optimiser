Cell["Part VI: Convexity of the Optimization Problem", "Section",ExpressionUUID->"c919455e-553b-40a2-b434-1be1683a80dd"],

Cell[TextData[{
 "Show that the minimum eigenvalue of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"(", 
         RowBox[{
           StyleBox["H", "TI"], "-", 
           StyleBox["C", "TI"]}], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "(H - C)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5bc00fb3-162a-4e1a-af15-75aa28c53acc"],
 " is concave in ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"(", 
         RowBox[{
           StyleBox["d", "TI"], 
           SubscriptBox[
            StyleBox["s", "TI"], "11"], ",", 
           StyleBox["d", "TI"], 
           SubscriptBox[
            StyleBox["s", "TI"], "12"], ",", 
           StyleBox["d", "TI"], 
           SubscriptBox[
            StyleBox["s", "TI"], "21"], ",", 
           StyleBox["d", "TI"], 
           SubscriptBox[
            StyleBox["s", "TI"], "22"]}], ")"}], TraditionalForm], 
     "errors" -> {}, "input" -> "(ds_{11}, ds_{12}, ds_{21}, ds_{22})", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f4db80e9-c61b-4dc0-b05d-90b3a6011878"],
 " for fixed ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["s", "TI"], TraditionalForm], "errors" -> {}, "input" -> "s", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b9449bb8-5d5c-4ec5-b93c-8c961ab3d1fd"],
 ". This means the optimization problem has no spurious local maxima. "
}], "Text",ExpressionUUID->"cee1f755-ee58-4f2f-8c32-41f1f603ef36"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "The", " ", "minimum", " ", "eigenvalue", " ", "of", " ", "a", " ", 
    "matrix", " ", "that", " ", "depends", " ", "affinely", " ", "on", " ", 
    "parameters", " ", "is", " ", "concave"}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "C", " ", "depends", " ", "linearly", " ", "on", " ", "the", " ", "ds", " ",
      "parameters"}], ",", " ", 
    RowBox[{
     RowBox[{"so", " ", "H"}], "-", 
     RowBox[{"C", " ", "is", " ", "affine", " ", "in", " ", "ds"}]}]}], " ", 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"min", "-", 
    RowBox[{
    "eigenvalue", " ", "of", " ", "an", " ", "affine", " ", "matrix", " ", 
     "family", " ", "is", " ", "concave"}]}], " ", "*)"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"Verify", " ", "affine", " ", "dependence"}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Print", "[", "\"\<=== Affine dependence check ===\>\"", "]"}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<C at s=0:\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"MatrixForm", "[", "cMatrixAt0", "]"}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<\\nC is LINEAR in (ds11, ds12, ds21, ds22) \[LongDash] \
confirmed by inspection.\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<H - C is therefore AFFINE in these parameters.\>\"", 
     "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Min eigenvalue of affine matrix family is CONCAVE \
(well-known result).\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<\[DoubleLongRightArrow] No spurious local maxima in \
the geodesic convexity optimization.\\n\>\"", "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"Plot", " ", "min"}], "-", 
     RowBox[{
     "eigenvalue", " ", "as", " ", "function", " ", "of", " ", "ds22", " ", 
      "for", " ", "Test", " ", "1"}]}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Fix", " ", "other", " ", "parameters", " ", "at", " ", "optimal", " ", 
     "values"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"optDs11_", "1"}], "=", 
     RowBox[{"ds11v", " ", "/.", " ", 
      RowBox[{"result1", "[", 
       RowBox[{"[", "2", "]"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"optDs12_", "1"}], "=", 
     RowBox[{"ds12v", " ", "/.", " ", 
      RowBox[{"result1", "[", 
       RowBox[{"[", "2", "]"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"optDs21_", "1"}], "=", 
     RowBox[{"ds21v", " ", "/.", " ", 
      RowBox[{"result1", "[", 
       RowBox[{"[", "2", "]"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"plotData", "=", 
     RowBox[{"Table", "[", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"d22", ",", 
         RowBox[{"minEig1", "[", 
          RowBox[{
           RowBox[{"optDs11_", "1"}], ",", 
           RowBox[{"optDs12_", "1"}], ",", 
           RowBox[{"optDs21_", "1"}], ",", "d22"}], "]"}]}], "}"}], ",", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"{", 
        RowBox[{"d22", ",", 
         RowBox[{"-", "5"}], ",", "5", ",", "0.1"}], "}"}]}], 
      "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"ListLinePlot", "[", 
    RowBox[{"plotData", ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"PlotStyle", "->", 
      RowBox[{"{", 
       RowBox[{"Blue", ",", "Thick"}], "}"}]}], ",", "\[IndentingNewLine]", 
     "  ", 
     RowBox[{"AxesLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<ds\:2082\:2082\>\"", 
        ",", "\"\<min eigenvalue of (H-C)\>\""}], "}"}]}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{
     "PlotLabel", 
      "->", "\"\<Test 1: Concavity in ds\:2082\:2082 (other params fixed at \
optimum)\>\""}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"Epilog", "->", 
      RowBox[{"{", 
       RowBox[{"Red", ",", 
        RowBox[{"PointSize", "[", "0.02", "]"}], ",", "\[IndentingNewLine]", 
        "    ", 
        RowBox[{"Point", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"ds22v", " ", "/.", " ", 
            RowBox[{"result1", "[", 
             RowBox[{"[", "2", "]"}], "]"}]}], ",", 
           RowBox[{"result1", "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], "}"}], "]"}]}], "}"}]}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"GridLines", "->", "Automatic"}], ",", "\[IndentingNewLine]", 
     "  ", 
     RowBox[{"ImageSize", "->", "500"}]}], "\[IndentingNewLine]", 
    "]"}]}]}]], "Input",ExpressionUUID->"3c3138a4-c2f0-4141-9344-\
241bb9221478"],

