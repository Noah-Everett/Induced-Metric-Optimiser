Cell["Part IV: Test Function 3 \[LongDash] L = x^2 - 100y^2 at (1, 0.01)", \
"Section",ExpressionUUID->"4ba7c876-aa85-4946-89f0-1d0a25401747"],

Cell["\<\
An extreme saddle with a very negative eigenvalue and small gradient in the y \
direction. \
\>", "Text",ExpressionUUID->"6d266dfe-f857-48c9-8c52-cd3e1b075415"],

Cell[BoxData[
 RowBox[{
