Cell["Part II: Test Function 1 \[LongDash] L = x^2 - y^2 at (1, 0.5)", \
"Section",ExpressionUUID->"480f0b20-a339-4a70-a2e2-00d8221370f7"],

Cell[TextData[{
 "The Hessian is ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["H", "TI"], "\[LongEqual]", 
         StyleBox["diag", FontSlant -> "Plain"], 
         RowBox[{"(", 
           RowBox[{"2", ",", "-2"}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> "H = \\mathrm{diag}(2, -2)", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b3700352-2a4d-4f56-8f11-992b68b2a369"],
 " and the gradient is ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["g", "TI"], "\[LongEqual]", 
         RowBox[{"(", 
           RowBox[{"2", ",", "-1"}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> "g = (2, -1)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "8547517c-3c7f-456c-a8d3-ed1fe8e30c0c"],
 ". This is a classic saddle point with one negative eigenvalue. "
}], "Text",ExpressionUUID->"24d45e7d-401f-4514-982b-09c7670e0415"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Test", " ", "1"}], ":", " ", "L"}], " ", "=", " ", 
    RowBox[{"x\.b2", " ", "-", " ", 
     RowBox[{"y\.b2", " ", "at", " ", 
      RowBox[{"(", 
       RowBox[{"1", ",", " ", "0.5"}], ")"}]}]}]}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"h1", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"2", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", 
         RowBox[{"-", "2"}]}], "}"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"gVec1", "=", 
     RowBox[{"{", 
      RowBox[{"2", ",", 
       RowBox[{"-", "1"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"Effective", " ", 
      RowBox[{"Hessian", ":", " ", 
       RowBox[{"H", " ", "-", " ", "C"}]}]}], ",", " ", 
     RowBox[{
      RowBox[{"evaluated", " ", "at", " ", "s1"}], "=", 
      RowBox[{"s2", "=", "0"}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"effectiveH1", "[", 
      RowBox[{"ds11v_", ",", "ds12v_", ",", "ds21v_", ",", "ds22v_"}], "]"}], 
     ":=", "\[IndentingNewLine]", "  ", 
     RowBox[{"h1", "-", 
      RowBox[{"(", 
       RowBox[{"cMatrixAt0", " ", "/.", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"ds11", "->", "ds11v"}], ",", 
          RowBox[{"ds12", "->", "ds12v"}], ",", 
          RowBox[{"ds21", "->", "ds21v"}], ",", 
          RowBox[{"ds22", "->", "ds22v"}], ",", "\[IndentingNewLine]", 
          "                        ", 
          RowBox[{"g1", "->", 
           RowBox[{"gVec1", "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], ",", 
          RowBox[{"g2", "->", 
           RowBox[{"gVec1", "[", 
            RowBox[{"[", "2", "]"}], "]"}]}]}], "}"}]}], ")"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"Objective", ":", " ", 
     RowBox[{
      RowBox[{"minimize", " ", "eigenvalue", " ", "of", " ", "H"}], "-", 
      RowBox[{"C", " ", 
       RowBox[{"(", 
        RowBox[{"we", " ", "want", " ", "to", " ", "maximize", " ", "it"}], 
        ")"}]}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"minEig1", "[", 
      RowBox[{
       RowBox[{"ds11v_", "?", "NumericQ"}], ",", 
       RowBox[{"ds12v_", "?", "NumericQ"}], ",", 
       RowBox[{"ds21v_", "?", "NumericQ"}], ",", 
       RowBox[{"ds22v_", "?", "NumericQ"}]}], "]"}], ":=", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"Min", "[", 
      RowBox[{"Eigenvalues", "[", 
       RowBox[{"effectiveH1", "[", 
        RowBox[{"ds11v", ",", "ds12v", ",", "ds21v", ",", "ds22v"}], "]"}], 
       "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"Maximize", " ", "the", " ", "minimum", " ", "eigenvalue"}], " ", 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"result1", "=", 
     RowBox[{"NMaximize", "[", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"minEig1", "[", 
         RowBox[{"ds11v", ",", "ds12v", ",", "ds21v", ",", "ds22v"}], "]"}], 
        "}"}], ",", "\[IndentingNewLine]", "  ", 
       RowBox[{"{", 
