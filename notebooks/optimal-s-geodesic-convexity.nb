        RowBox[{"{", "ij", "}"}]}]}], ")"}]}]}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"christoffel", "[", 
     RowBox[{"k_", ",", "i_", ",", "j_"}], "]"}], ":=", 
    RowBox[{"Sum", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{
       RowBox[{"gammaInv", "[", 
        RowBox[{"k", ",", "l"}], "]"}], " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"dGamma", "[", 
           RowBox[{"i", ",", "l", ",", "j"}], "]"}], "+", 
          RowBox[{"dGamma", "[", 
           RowBox[{"j", ",", "l", ",", "i"}], "]"}], "-", 
          RowBox[{"dGamma", "[", 
           RowBox[{"l", ",", "i", ",", "j"}], "]"}]}], ")"}], "/", "2"}]}], ",",
       "\[IndentingNewLine]", "  ", 
      RowBox[{"{", 
       RowBox[{"l", ",", "1", ",", "2"}], "}"}]}], "\[IndentingNewLine]", 
     "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
