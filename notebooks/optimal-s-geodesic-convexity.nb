Notebook[{
Cell["\<\
Optimal Metric for Geodesic Convexity at Saddle Points (IMO-163)\
\>", "Title",ExpressionUUID->"54b904d6-dcf5-4acd-aa42-aff80379398e"],

Cell[TextData[{
 "This notebook reproduces the finding that geodesic convexity is achievable \
at saddle points via optimal choice of the metric parameters ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["s", "TI"], 
        StyleBox["i", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "s_i", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b5f38b7d-162a-4d2c-80be-cfe9c7a7976d"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[PartialD]", 
          StyleBox["j", "TI"]], 
         SubscriptBox[
          StyleBox["s", "TI"], 
          StyleBox["i", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\partial_j s_i", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "fc7c6817-ba2d-4677-be84-fcfb2e508356"],
 ". By tuning the Christoffel symbol contribution ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["C", "TI"], 
        RowBox[{
          StyleBox["i", "TI"], 
          StyleBox["j", "TI"]}]], TraditionalForm], "errors" -> {}, "input" -> 
     "C_{ij}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "11c64084-3af6-4208-ae2a-b3d6f9307591"],
 ", the effective Hessian ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["H", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"]}]], "-", 
         SubscriptBox[
          StyleBox["C", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"]}]]}], TraditionalForm], "errors" -> {}, 
     "input" -> "H_{ij} - C_{ij}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "cfb76e56-d214-4ae4-812c-646689a06ab5"],
 " can be made positive definite even when the Euclidean Hessian has negative \
eigenvalues. "
}], "Text",ExpressionUUID->"a0750688-f37d-4dd0-a31a-f45cd5683eb8"],

Cell["Part I: Christoffel Symbols for 2D Diagonal Metric", "Section",ExpressionUUID->"6e50e4f1-3cf5-4977-b4e2-732344421423"],

Cell[TextData[{
 "For a diagonal metric ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Gamma]", "\[LongEqual]", 
         StyleBox["diag", FontSlant -> "Plain"], 
         RowBox[{"(", 
           RowBox[{
             SuperscriptBox[
              StyleBox["e", "TI"], 
              RowBox[{"2", 
                SubscriptBox[
                 StyleBox["s", "TI"], "1"]}]], ",", 
             SuperscriptBox[
              StyleBox["e", "TI"], 
              RowBox[{"2", 
                SubscriptBox[
                 StyleBox["s", "TI"], "2"]}]]}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\gamma = \\mathrm{diag}(e^{2s_1}, e^{2s_2})", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "2dae7c5b-c044-4fb6-af39-6bca21e47ec0"],
 ", the Christoffel symbols of the second kind are: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubsuperscriptBox["\[CapitalGamma]", 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"]}], 
          StyleBox["k", "TI"]], "\[LongEqual]", 
         FractionBox["1", "2"], 
         SuperscriptBox["\[Gamma]", 
          RowBox[{
            StyleBox["k", "TI"], 
            StyleBox["l", "TI"]}]], 
         RowBox[{"(", 
           RowBox[{
             SubscriptBox["\[PartialD]", 
              StyleBox["i", "TI"]], 
             SubscriptBox["\[Gamma]", 
              RowBox[{
                StyleBox["l", "TI"], 
                StyleBox["j", "TI"]}]], "+", 
             SubscriptBox["\[PartialD]", 
              StyleBox["j", "TI"]], 
             SubscriptBox["\[Gamma]", 
              RowBox[{
                StyleBox["l", "TI"], 
                StyleBox["i", "TI"]}]], "-", 
             SubscriptBox["\[PartialD]", 
              StyleBox["l", "TI"]], 
             SubscriptBox["\[Gamma]", 
              RowBox[{
                StyleBox["i", "TI"], 
                StyleBox["j", "TI"]}]]}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\Gamma^k_{ij} = \\frac{1}{2} \\gamma^{kl}(\\partial_i \\gamma_{lj} + \
\\partial_j \\gamma_{li} - \\partial_l \\gamma_{ij})", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b689d402-5213-462a-9bc8-c6720a52f546"],
 "The connection correction to the Hessian is ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["C", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"]}]], "\[LongEqual]", 
         SubsuperscriptBox["\[CapitalGamma]", 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"]}], 
          StyleBox["k", "TI"]], 
         SubscriptBox[
          StyleBox["g", "TI"], 
          StyleBox["k", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "C_{ij} = \\Gamma^k_{ij} g_k", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5d0f9a4f-5a52-4d86-a2eb-1585c2107566"],
 " where ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["g", "TI"], 
          StyleBox["k", "TI"]], "\[LongEqual]", 
         SubscriptBox["\[PartialD]", 
          StyleBox["k", "TI"]], 
         StyleBox["L", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "g_k = \\partial_k L", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "08689d03-1127-4e6a-a9c2-fc3032e72d3f"],
 " is the gradient. "
}], "Text",ExpressionUUID->"a73b3d82-8016-4406-83c6-9e3796f8cba2"],

