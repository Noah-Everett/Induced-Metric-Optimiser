   RowBox[{"MatrixForm", "[", "cMatrix", "]"}], "]"}], ";"}]}], "Input",Expres\
sionUUID->"e57b5684-41fa-479d-a387-436d0624f4cc"],

Cell["Simplified form at s1 = s2 = 0", "Subsection",ExpressionUUID->"009be341-5ece-4b57-b06f-66d5453c4dfd"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"At", " ", "s1"}], "=", 
     RowBox[{"s2", "=", 
      RowBox[{
       RowBox[{"0", ":", " ", 
        RowBox[{"e", "^", 
         RowBox[{"{", 
          RowBox[{"2", "s"}], "}"}]}]}], "=", "1"}]}]}], ",", " ", 
    RowBox[{
     RowBox[{"e", "^", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "2"}], "s"}], "}"}]}], "=", "1"}], ",", " ", 
    RowBox[{"simplifies", " ", "greatly"}]}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"cMatrixAt0", "=", 
     RowBox[{
      RowBox[{"cMatrix", " ", "/.", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"s1", "->", "0"}], ",", 
         RowBox[{"s2", "->", "0"}]}], "}"}]}], " ", "//", " ", "Simplify"}]}],
     ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<C at s1=s2=0:\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"MatrixForm", "[", "cMatrixAt0", "]"}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"Extract", " ", "individual", " ", "entries"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<\\nC_{11} = \>\"", ",", 
      RowBox[{"cMatrixAt0", "[", 
       RowBox[{"[", 
        RowBox[{"1", ",", "1"}], "]"}], "]"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<C_{12} = \>\"", ",", 
      RowBox[{"cMatrixAt0", "[", 
       RowBox[{"[", 
        RowBox[{"1", ",", "2"}], "]"}], "]"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<C_{21} = \>\"", ",", 
      RowBox[{"cMatrixAt0", "[", 
       RowBox[{"[", 
        RowBox[{"2", ",", "1"}], "]"}], "]"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<C_{22} = \>\"", ",", 
      RowBox[{"cMatrixAt0", "[", 
       RowBox[{"[", 
