      RowBox[{"Eigenvalues", "[", 
       RowBox[{"effectiveH3", "[", 
        RowBox[{"ds11v", ",", "ds12v", ",", "ds21v", ",", "ds22v"}], "]"}], 
       "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
