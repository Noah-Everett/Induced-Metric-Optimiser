     RowBox[{"\"\<Max(min eigenvalue of H-C): \>\"", ",", 
      RowBox[{"result1", "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"optParams1", "=", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"ds11v", ",", "ds12v", ",", "ds21v", ",", "ds22v"}], "}"}], 
      " ", "/.", " ", 
      RowBox[{"result1", "[", 
       RowBox[{"[", "2", "]"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"effH1", "=", 
     RowBox[{"effectiveH1", " ", "@@", " ", "optParams1"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Effective Hessian: \>\"", ",", 
      RowBox[{"MatrixForm", "[", 
       RowBox[{"effH1", " ", "//", " ", "N"}], "]"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Eigenvalues: \>\"", ",", 
      RowBox[{
       RowBox[{"Eigenvalues", "[", "effH1", "]"}], " ", "//", " ", "N"}]}], 
     "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Geodesically convex? \>\"", ",", 
      RowBox[{
       RowBox[{"Min", "[", 
        RowBox[{"Eigenvalues", "[", "effH1", "]"}], "]"}], ">", "0"}]}], 
     "]"}], ";"}]}]}]], "Input",ExpressionUUID->"9324ba7d-9d69-469e-b828-\
c247ae1bcac8"],

