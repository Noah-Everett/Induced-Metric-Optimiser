Cell["Part VIII: Exponential Amplification", "Section",ExpressionUUID->"7b99744f-989f-442b-b985-8e6c6894e2c7"],

Cell[TextData[{
 "Show that at ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["s", "TI"], "1"], "\[LongEqual]", "0", ",", 
         SubscriptBox[
          StyleBox["s", "TI"], "2"], "\[LongEqual]", "\[CapitalDelta]"}], 
       TraditionalForm], "errors" -> {}, "input" -> "s_1 = 0, s_2 = \\Delta", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "96897070-11e7-470d-b633-3048f9d3be03"],
 " with ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[CapitalDelta]", ">", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\Delta > 0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0da8c4a5-9c4e-414d-b840-e128b03200cb"],
 ", the required ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
        "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", "\[Del]", 
         StyleBox["s", "TI"], 
         "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9"}], 
       TraditionalForm], "errors" -> {}, "input" -> "|\\nabla s|", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a11caa6b-4b73-45cd-a699-fb5eddbb383c"],
 " for convexity decreases as ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox[
        StyleBox["e", "TI"], 
        RowBox[{"-", "\[CapitalDelta]"}]], TraditionalForm], "errors" -> {}, 
     "input" -> "e^{-\\Delta}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5060c379-aa42-40e4-b04d-d5cb6a827857"],
 ". The exponential metric amplifies the effect of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Del]", 
         StyleBox["s", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\nabla s", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f9e463c1-f819-4b16-a130-ed38346beeed"],
 ". "
}], "Text",ExpressionUUID->"0410d244-7e7a-44bc-8bad-66721dd31a3e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"At", " ", "s1"}], "=", "0"}], ",", " ", 
    RowBox[{"s2", "=", "\[CapitalDelta]"}], ",", " ", 
    RowBox[{"the", " ", "C_", 
     RowBox[{"{", "22", "}"}], " ", "term", " ", 
     RowBox[{"becomes", ":"}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"C_", 
     RowBox[{"{", "22", "}"}]}], " ", "=", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"\[PartialD]", "\:2082s\:2082"}], ")"}], " ", "g\:2082", " ", 
      RowBox[{
       RowBox[{"e", "^", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "2"}], "\[CapitalDelta]"}], "}"}]}], " ", "\[CenterDot]",
        " ", 
       RowBox[{"e", "^", 
        RowBox[{"{", 
         RowBox[{"2", "\[CapitalDelta]"}], "}"}]}]}]}], " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"\[PartialD]", "\:2082s\:2082"}], ")"}], " ", "g\:2082"}], 
       " ", "..."}], " ", "but", " ", 
      RowBox[{"let", "'"}], "s", " ", "compute", " ", "exactly"}]}]}], " ", 
   "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<=== Exponential amplification: required ||\[Del]s|| vs \
\[CapitalDelta] ===\\n\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"For", " ", "Test", " ", "1"}], ":", " ", 
      RowBox[{
       RowBox[{"need", " ", "H_", 
        RowBox[{"{", "22", "}"}]}], " ", "-", " ", 
       RowBox[{"C_", 
        RowBox[{"{", "22", "}"}]}]}]}], " ", "=", " ", 
     RowBox[{"0", " ", 
      RowBox[{"(", 
       RowBox[{"threshold", " ", "of", " ", "convexity"}], ")"}]}]}], " ", 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"At", " ", "s1"}], "=", "0"}], ",", " ", 
     RowBox[{"s2", "=", 
      RowBox[{"\[CapitalDelta]", ":"}]}]}], " ", "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"\[Gamma]_", 
       RowBox[{"{", "22", "}"}]}], " ", "=", " ", 
      RowBox[{"e", "^", 
       RowBox[{"{", 
        RowBox[{"2", "\[CapitalDelta]"}], "}"}]}]}], ",", " ", 
     RowBox[{
      RowBox[{"\[Gamma]", "^", 
       RowBox[{"{", "22", "}"}]}], " ", "=", " ", 
      RowBox[{"e", "^", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "2"}], "\[CapitalDelta]"}], "}"}]}]}]}], " ", "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"\[CapitalGamma]", "^", "2"}], "_", 
      RowBox[{"{", "22", "}"}]}], " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"\[Gamma]", "^", 
         RowBox[{"{", "22", "}"}]}], " ", "\[CenterDot]", " ", 
        RowBox[{"\[PartialD]", "\:2082\[Gamma]_"}]}], 
       RowBox[{
        RowBox[{"{", "22", "}"}], "/", "2"}]}], " ", "=", " ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"e", "^", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "2"}], "\[CapitalDelta]"}], "}"}]}], " ", "\[CenterDot]",
          " ", "2"}], 
        RowBox[{"(", 
         RowBox[{"\[PartialD]", "\:2082s\:2082"}], ")"}], 
        RowBox[{
         RowBox[{"e", "^", 
          RowBox[{"{", 
           RowBox[{"2", "\[CapitalDelta]"}], "}"}]}], "/", "2"}]}], " ", "=", 
       " ", 
       RowBox[{"\[PartialD]", "\:2082s\:2082"}]}]}]}], " ", "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"But", " ", 
      RowBox[{"\[CapitalGamma]", "^", "1"}], "_", 
      RowBox[{"{", "22", "}"}]}], " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"-", 
         RowBox[{"\[Gamma]", "^", 
          RowBox[{"{", "11", "}"}]}]}], " ", "\[CenterDot]", " ", 
        RowBox[{"\[PartialD]", "\:2081\[Gamma]_"}]}], 
       RowBox[{
        RowBox[{"{", "22", "}"}], "/", "2"}]}], " ", "=", " ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"-", 
          RowBox[{"e", "^", 
           RowBox[{"{", "0", "}"}]}]}], " ", "\[CenterDot]", " ", "2"}], 
        RowBox[{"(", 
         RowBox[{"\[PartialD]", "\:2081s\:2082"}], ")"}], 
        RowBox[{
         RowBox[{"e", "^", 
          RowBox[{"{", 
           RowBox[{"2", "\[CapitalDelta]"}], "}"}]}], "/", "2"}]}], " ", "=", 
       " ", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"(", 
          RowBox[{"\[PartialD]", "\:2081s\:2082"}], ")"}]}], 
        RowBox[{"e", "^", 
         RowBox[{"{", 
          RowBox[{"2", "\[CapitalDelta]"}], "}"}]}]}]}]}]}], " ", "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"C_", 
      RowBox[{"{", "22", "}"}]}], " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"\[CapitalGamma]", "^", "1"}], "_", 
        RowBox[{"{", "22", "}"}], "g\:2081"}], " ", "+", " ", 
       RowBox[{
        RowBox[{"\[CapitalGamma]", "^", "2"}], "_", 
        RowBox[{"{", "22", "}"}], "g\:2082"}]}], " ", "=", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"-", 
         RowBox[{"(", 
          RowBox[{"\[PartialD]", "\:2081s\:2082"}], ")"}]}], 
        RowBox[{"e", "^", 
         RowBox[{"{", 
          RowBox[{"2", "\[CapitalDelta]"}], "}"}]}], "g\:2081"}], " ", "+", 
       " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"\[PartialD]", "\:2082s\:2082"}], ")"}], "g\:2082"}]}]}]}], 
    " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"For", " ", "convexity", " ", "at", " ", 
     RowBox[{"saddle", ":", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"H_", 
         RowBox[{"{", "22", "}"}]}], " ", "-", " ", 
        RowBox[{"C_", 
         RowBox[{"{", "22", "}"}]}]}], " ", ">", " ", "0"}]}]}], " ", "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "2"}], " ", "+", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"\[PartialD]", "\:2081s\:2082"}], ")"}], 
       RowBox[{"e", "^", 
        RowBox[{"{", 
         RowBox[{"2", "\[CapitalDelta]"}], "}"}]}], "g\:2081"}], " ", "-", 
      " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"\[PartialD]", "\:2082s\:2082"}], ")"}], "g\:2082"}]}], " ", ">",
      " ", "0"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"Using", " ", 
      RowBox[{"\[PartialD]", "\:2081s\:2082"}], " ", "to", " ", 
      RowBox[{"flip", ":", " ", 
       RowBox[{
        RowBox[{"need", " ", 
         RowBox[{"(", 
          RowBox[{"\[PartialD]", "\:2081s\:2082"}], ")"}]}], " ", ">", " ", 
        RowBox[{"2", "/", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"e", "^", 
            RowBox[{"{", 
             RowBox[{"2", "\[CapitalDelta]"}], "}"}]}], "g\:2081"}], 
          ")"}]}]}]}]}], " ", "=", " ", 
     RowBox[{
      RowBox[{"2", "/", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"e", "^", 
          RowBox[{"{", 
           RowBox[{"2", "\[CapitalDelta]"}], "}"}]}], "\[CenterDot]", "2"}], 
        ")"}]}], " ", "=", " ", 
      RowBox[{"e", "^", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "2"}], "\[CapitalDelta]"}], "}"}]}]}]}], " ", "*)"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"Numerical", " ", "verification"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"deltaValues", "=", 
     RowBox[{"Range", "[", 
      RowBox[{"0", ",", "3", ",", "0.1"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"For", " ", "each", " ", "\[CapitalDelta]"}], ",", " ", 
     RowBox[{
      RowBox[{"find", " ", "minimum"}], " ", "||", 
      RowBox[{"\[Del]", "s"}], "||", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"needed", " ", "to", " ", "achieve", " ", "min"}], "-", 
        RowBox[{"eig", 
         RowBox[{"(", 
          RowBox[{"H", "-", "C"}], ")"}]}]}], " ", "\[GreaterEqual]", " ", 
       "0"}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"requiredGradNorm", "=", 
     RowBox[{"Table", "[", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
          "cMatDelta", ",", "effHDelta", ",", "minEigFunc", ",", 
           "resultDelta", ",", "optParamsDelta", ",", "gradNorm"}], "}"}], ",",
          "\[IndentingNewLine]", "    ", 
         RowBox[{"(*", " ", 
          RowBox[{
           RowBox[{
            RowBox[{
            "Evaluate", " ", "C", " ", "matrix", " ", "at", " ", "s1"}], "=", 
            "0"}], ",", " ", 
           RowBox[{"s2", "=", "delta"}]}], " ", "*)"}], "\[IndentingNewLine]",
          "    ", 
         RowBox[{
          RowBox[{
           RowBox[{"cMatDelta", "[", 
            RowBox[{"d11_", ",", "d12_", ",", "d21_", ",", "d22_"}], "]"}], ":=",
            "\[IndentingNewLine]", "      ", 
           RowBox[{"cMatrix", " ", "/.", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"s1", "->", "0"}], ",", 
              RowBox[{"s2", "->", "delta"}], ",", 
              RowBox[{"ds11", "->", "d11"}], ",", 
              RowBox[{"ds12", "->", "d12"}], ",", "\[IndentingNewLine]", 
              "                  ", 
              RowBox[{"ds21", "->", "d21"}], ",", 
              RowBox[{"ds22", "->", "d22"}], ",", 
              RowBox[{"g1", "->", 
               RowBox[{"gVec1", "[", 
                RowBox[{"[", "1", "]"}], "]"}]}], ",", 
              RowBox[{"g2", "->", 
               RowBox[{"gVec1", "[", 
                RowBox[{"[", "2", "]"}], "]"}]}]}], "}"}]}]}], ";", 
          "\[IndentingNewLine]", "    ", "\[IndentingNewLine]", "    ", 
          RowBox[{
           RowBox[{"effHDelta", "[", 
            RowBox[{"d11_", ",", "d12_", ",", "d21_", ",", "d22_"}], "]"}], ":=", 
           RowBox[{"h1", "-", 
            RowBox[{"cMatDelta", "[", 
             RowBox[{"d11", ",", "d12", ",", "d21", ",", "d22"}], "]"}]}]}], ";",
           "\[IndentingNewLine]", "    ", "\[IndentingNewLine]", "    ", 
          RowBox[{
           RowBox[{"minEigDelta", "[", 
            RowBox[{
             RowBox[{"d11_", "?", "NumericQ"}], ",", 
             RowBox[{"d12_", "?", "NumericQ"}], ",", 
             RowBox[{"d21_", "?", "NumericQ"}], ",", 
             RowBox[{"d22_", "?", "NumericQ"}]}], "]"}], ":=", 
           "\[IndentingNewLine]", "      ", 
           RowBox[{"Min", "[", 
            RowBox[{"Re", "[", 
             RowBox[{"Eigenvalues", "[", 
              RowBox[{
               RowBox[{"effHDelta", "[", 
                RowBox[{"d11", ",", "d12", ",", "d21", ",", "d22"}], "]"}], 
               " ", "//", " ", "N"}], "]"}], "]"}], "]"}]}], ";", 
          "\[IndentingNewLine]", "    ", "\[IndentingNewLine]", "    ", 
          RowBox[{"(*", " ", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{
              "Find", " ", "params", " ", "that", " ", "achieve", " ", 
               "min"}], "-", "eig"}], " ", "\[GreaterEqual]", " ", 
             RowBox[{"0", " ", "with", " ", "minimum"}]}], " ", "||", 
            RowBox[{"\[Del]", "s"}], "||"}], " ", "*)"}], 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"resultDelta", "=", 
           RowBox[{"NMinimize", "[", "\[IndentingNewLine]", "      ", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{
                RowBox[{"d11", "^", "2"}], "+", 
                RowBox[{"d12", "^", "2"}], "+", 
                RowBox[{"d21", "^", "2"}], "+", 
                RowBox[{"d22", "^", "2"}]}], ",", "\[IndentingNewLine]", 
               "       ", 
               RowBox[{
                RowBox[{"minEigDelta", "[", 
                 RowBox[{"d11", ",", "d12", ",", "d21", ",", "d22"}], "]"}], ">=",
                 "0"}]}], "}"}], ",", "\[IndentingNewLine]", "      ", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"d11", ",", 
                 RowBox[{"-", "20"}], ",", "20"}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{"d12", ",", 
                 RowBox[{"-", "20"}], ",", "20"}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{"d21", ",", 
                 RowBox[{"-", "20"}], ",", "20"}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{"d22", ",", 
                 RowBox[{"-", "20"}], ",", "20"}], "}"}]}], "}"}], ",", 
             "\[IndentingNewLine]", "      ", 
             RowBox[{"Method", "->", "\"\<InteriorPoint\>\""}], ",", 
             RowBox[{"MaxIterations", "->", "2000"}]}], "\[IndentingNewLine]",
             "    ", "]"}]}], ";", "\[IndentingNewLine]", "    ", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"gradNorm", "=", 
           RowBox[{"Sqrt", "[", 
            RowBox[{"resultDelta", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "]"}]}], ";", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"{", 
           RowBox[{"delta", ",", "gradNorm"}], "}"}]}]}], 
        "\[IndentingNewLine]", "  ", "]"}], ",", "\[IndentingNewLine]", "  ", 
       
       RowBox[{"{", 
        RowBox[{"delta", ",", "deltaValues"}], "}"}]}], "\[IndentingNewLine]",
       "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"Filter", " ", "out", " ", "failures"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"validData", "=", 
     RowBox[{"Select", "[", 
      RowBox[{"requiredGradNorm", ",", 
       RowBox[{
        RowBox[{
         RowBox[{"NumberQ", "[", 
          RowBox[{"#", "[", 
           RowBox[{"[", "2", "]"}], "]"}], "]"}], "&&", 
         RowBox[{
          RowBox[{"#", "[", 
           RowBox[{"[", "2", "]"}], "]"}], "<", "100"}]}], " ", "&"}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<\[CapitalDelta]\\t\\t||\[Del]s||_min\\te^{-2\
\[CapitalDelta]}\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<---\\t\\t----------\\t-------\>\"", "]"}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Do", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"MemberQ", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
           "0", ",", "0.5", ",", "1.0", ",", "1.5", ",", "2.0", ",", "2.5", ",",
             "3.0"}], "}"}], ",", 
          RowBox[{"d", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], "]"}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"Print", "[", 
         RowBox[{
          RowBox[{"d", "[", 
           RowBox[{"[", "1", "]"}], "]"}], ",", "\"\<\\t\\t\>\"", ",", 
          RowBox[{"Round", "[", 
           RowBox[{
            RowBox[{"d", "[", 
             RowBox[{"[", "2", "]"}], "]"}], ",", "0.0001"}], "]"}], 
          ",", "\"\<\\t\\t\>\"", ",", 
          RowBox[{"Round", "[", 
           RowBox[{
            RowBox[{"Exp", "[", 
             RowBox[{
              RowBox[{"-", "2"}], " ", 
              RowBox[{"d", "[", 
               RowBox[{"[", "1", "]"}], "]"}]}], "]"}], ",", "0.0001"}], 
           "]"}]}], "]"}]}], "\[IndentingNewLine]", "  ", "]"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"{", 
       RowBox[{"d", ",", "validData"}], "}"}]}], "\[IndentingNewLine]", "]"}],
     ";"}]}]}]], "Input",ExpressionUUID->"7fbcc40f-7813-4ff3-9ae7-\
9b9d60878775"],

Cell["Exponential decay plot", "Subsection",ExpressionUUID->"2ff2ade9-bd98-4aa4-8e27-a9eba6af5ed2"],

Cell[BoxData[
 RowBox[{"Show", "[", "\[IndentingNewLine]", "  ", 
  RowBox[{
   RowBox[{"ListLogPlot", "[", 
    RowBox[{"validData", ",", 
     RowBox[{"PlotStyle", "->", 
      RowBox[{"{", 
       RowBox[{"Blue", ",", 
        RowBox[{"PointSize", "[", "0.015", "]"}]}], "}"}]}], ",", 
     "\[IndentingNewLine]", "    ", 
     RowBox[{"PlotLegends", "->", 
      RowBox[{"{", "\"\<||\[Del]s||_min (numerical)\>\"", "}"}]}]}], "]"}], ",",
    "\[IndentingNewLine]", "  ", 
   RowBox[{"LogPlot", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"validData", "[", 
       RowBox[{"[", 
        RowBox[{"1", ",", "2"}], "]"}], "]"}], " ", 
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{"-", "2"}], " ", "delta"}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"delta", ",", "0", ",", "3"}], "}"}], ",", 
     "\[IndentingNewLine]", "    ", 
     RowBox[{"PlotStyle", "->", 
      RowBox[{"{", 
       RowBox[{"Red", ",", "Dashed"}], "}"}]}], ",", "\[IndentingNewLine]", 
     "    ", 
     RowBox[{"PlotLegends", "->", 
      RowBox[{
      "{", "\"\<a\[CenterDot]e^{-2\[CapitalDelta]} (fit)\>\"", "}"}]}]}], 
    "]"}], ",", "\[IndentingNewLine]", "  ", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<\[CapitalDelta] (metric offset s\:2082)\>\"", 
      ",", "\"\<Required ||\[Del]s||\>\""}], "}"}]}], ",", 
   "\[IndentingNewLine]", "  ", 
   RowBox[{
   "PlotLabel", 
    "->", "\"\<Exponential Amplification: Required Gradient Norm vs Metric \
Offset\>\""}], ",", "\[IndentingNewLine]", "  ", 
   RowBox[{"ImageSize", "->", "500"}]}], "\[IndentingNewLine]", 
  "]"}]], "Input",ExpressionUUID->"eb4c61cd-dcb7-4e5f-99b6-52d3adcdd74e"],

Cell["Fit the exponential decay", "Subsection",ExpressionUUID->"52d4b4d3-639c-44bf-9973-2968718ebc8c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Fit", ":", " ", 
    RowBox[{"||", 
     RowBox[{"\[Del]", "s"}], "||", 
     RowBox[{"_min", " ", "\[TildeTilde]", " ", 
      RowBox[{"a", " ", 
       RowBox[{"e", "^", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "b"}], " ", "\[CapitalDelta]"}], "}"}]}]}]}]}]}], " ", 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"expFit", "=", 
     RowBox[{"NonlinearModelFit", "[", 
      RowBox[{"validData", ",", 
       RowBox[{"a", " ", 
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"-", "b"}], " ", "delta"}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"a", ",", "1"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"b", ",", "2"}], "}"}]}], "}"}], ",", "delta"}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Exponential fit: ||\[Del]s||_min = \>\"", ",", 
      RowBox[{"expFit", "[", "\"\<BestFitParameters\>\"", "]"}]}], "]"}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<  Expected b \[TildeTilde] 2 (from \
e^{-2\[CapitalDelta]} scaling)\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<  R\.b2 = \>\"", ",", 
      RowBox[{"expFit", "[", "\"\<RSquared\>\"", "]"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<\\nConclusion: Pre-scaling the metric by e^{2\
\[CapitalDelta]} in the negative-curvature\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<direction exponentially reduces the gradient-of-metric \
effort needed\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<to achieve geodesic convexity.\>\"", "]"}], 
    ";"}]}]}]], "Input",ExpressionUUID->"ede48e6f-edcd-4b7f-8b1d-\
7ea05d8e05f2"],

Cell["Conclusions", "Section",ExpressionUUID->"14f5db60-aef8-42bc-9d4c-8795ab659ad8"],

Cell[TextData[{
 "1. ",
 StyleBox["Geodesic convexity at saddles",
  FontWeight->Bold],
 ": By choosing ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Del]", 
         StyleBox["s", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\nabla s", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "93f1d47c-2c7b-4527-9f17-78bbf57ef745"],
 " appropriately, the connection correction ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["C", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"]}]], "\[LongEqual]", 
         SubsuperscriptBox["\[CapitalGamma]", 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"]}], 
          StyleBox["k", "TI"]], 
         SubscriptBox[
          StyleBox["g", "TI"], 
          StyleBox["k", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "C_{ij} = \\Gamma^k_{ij} g_k", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "14e93562-aa55-4c81-8a3e-7e66f8bccbd3"],
 " can flip negative eigenvalues of the Hessian, making the effective Hessian \
",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["H", "TI"], "-", 
         StyleBox["C", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "H - C", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "45ca7c72-3706-47ba-9a9f-fe3717f486fe"],
 " positive definite."
}], "Text",ExpressionUUID->"ffd633f5-2fe4-492a-b214-39f8a5812309"],

Cell[TextData[{
 "2. ",
 StyleBox["Universal rule",
  FontWeight->Bold],
 ": At ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["s", "TI"], "\[LongEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "s = 0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0e9a78c2-63ce-46e0-ac1b-3c8d6ed10a1e"],
 ", the optimal diagonal derivatives satisfy ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[PartialD]", 
          StyleBox["i", "TI"]], 
         SubscriptBox[
          StyleBox["s", "TI"], 
          StyleBox["i", "TI"]], "\[LongEqual]", "2", 
         SubscriptBox[
          StyleBox["H", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["i", "TI"]}]], "/", 
         SubscriptBox[
          StyleBox["g", "TI"], 
          StyleBox["i", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\partial_i s_i = 2 H_{ii} / g_i", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "99801170-5178-4209-8ff9-57d9e744f23f"],
 ". This is a simple, closed-form prescription."
}], "Text",ExpressionUUID->"fe72c9fe-70e8-43e9-a469-5b738c2a2ce0"],

Cell[TextData[{
 "3. ",
 StyleBox["Concave optimization",
  FontWeight->Bold],
 ": The minimum eigenvalue of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["H", "TI"], "-", 
         StyleBox["C", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "H - C", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "dd3453e5-0c29-49a1-bc04-fcf55fe054b8"],
 " is concave in the metric derivatives (since ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["C", "TI"], TraditionalForm], "errors" -> {}, "input" -> "C", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d578372b-a4be-444b-93bc-f6dcfbfdd51c"],
 " is linear in ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Del]", 
         StyleBox["s", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\nabla s", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5fd33495-aa14-47c3-bd16-ed790893c4bb"],
 "). There are no spurious local maxima."
}], "Text",ExpressionUUID->"e2c3a174-502e-4989-b295-dcd6aaf1ab39"],

Cell[TextData[{
 "4. ",
 StyleBox["Graceful degradation",
  FontWeight->Bold],
 ": Moderate perturbations (",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[PlusMinus]", "10%"}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\pm 10\\%", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "2d40488a-5027-4611-8840-42743e4e80bc"],
 ") of the optimal parameters preserve convexity. The method is not brittle."
}], "Text",ExpressionUUID->"c03f5afd-1456-45cd-a816-bf9fe6592fb7"],

Cell[TextData[{
 "5. ",
 StyleBox["Exponential amplification",
  FontWeight->Bold],
 ": Pre-scaling the metric by ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox[
        StyleBox["e", "TI"], 
        RowBox[{"2", "\[CapitalDelta]"}]], TraditionalForm], "errors" -> {}, 
     "input" -> "e^{2\\Delta}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "8c4881a5-c4e4-48a8-aa61-9f55819c2d26"],
 " in the negative-curvature direction exponentially reduces the required ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
        "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", "\[Del]", 
         StyleBox["s", "TI"], 
         "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9"}], 
       TraditionalForm], "errors" -> {}, "input" -> "|\\nabla s|", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a5852cbb-cc16-4308-a56d-77354571531f"],
 ", making the correction cheaper to achieve in practice.",
 StyleBox["Implication",
  FontWeight->Bold],
 ": The induced metric optimizer can navigate saddle points by learning \
metric parameters that enforce geodesic convexity. The optimization over \
metric parameters is well-behaved (concave), and the exponential \
amplification means that even modest metric offsets dramatically reduce the \
correction effort."
}], "Text",ExpressionUUID->"bd923e4f-cee8-433c-a85c-aaeac29dc171"]
},
