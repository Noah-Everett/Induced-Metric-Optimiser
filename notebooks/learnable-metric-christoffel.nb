    RowBox[{
     RowBox[{
      RowBox[{"\[Gamma]", "^", 
       RowBox[{
        RowBox[{"{", "kl", "}"}], " ", "[", 
        RowBox[{"ij", ",", "l"}], "]"}]}], "_\[Gamma]"}], " ", "-", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"\[Xi]", "/", "\[Alpha]"}], ")"}], " ", 
      RowBox[{"l", "^", "k"}], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"l", "^", 
         RowBox[{"l", " ", "[", 
          RowBox[{"ij", ",", "l"}], "]"}]}], "_\[Gamma]"}], ")"}]}]}]}], " ", 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", "                  ", 
   RowBox[{"=", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"\[CapitalGamma]", "^", "k_"}], 
      RowBox[{"{", "ij", "}"}], 
      RowBox[{"(", "\[Gamma]", ")"}]}], " ", "-", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"\[Xi]", "/", "\[Alpha]"}], ")"}], " ", 
      RowBox[{"l", "^", "k"}], " ", 
      RowBox[{"(", 
       RowBox[{"l_m", " ", 
        RowBox[{"\[CapitalGamma]", "^", "m_"}], 
        RowBox[{"{", "ij", "}"}], 
        RowBox[{"(", "\[Gamma]", ")"}]}], ")"}]}]}]}], " ", "*)"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"Therefore", ":"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<\:2554\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\
\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\
\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\
