Cell["7. Part 5: Numerical Demonstrations", "Section",ExpressionUUID->"85add384-e74c-4729-8dfd-0d7b6909f66b"],

Cell["7.1 Summary Table", "Subsection",ExpressionUUID->"8ebb0daf-f02d-4d84-a2cd-545b01804ed8"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "\"\<Global`*\>\"", "]"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"coords", "=", 
   RowBox[{"{", 
    RowBox[{"x", ",", "y"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"pt", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"x", "->", "1"}], ",", 
      RowBox[{"y", "->", "1"}]}], "}"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"computeRH", "[", 
     RowBox[{"lossFunc_", ",", "gamFunc_", ",", "xiVal_"}], "]"}], ":=", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "lGrad", ",", "hessM", ",", "gamExpr", ",", "gExpr", ",", "gamN", ",", 
        "gN", ",", "gInvN", ",", "lN", ",", "hN", ",", "dgdi", ",", "christN",
         ",", "rhN"}], "}"}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"lGrad", "=", 
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"lossFunc", "[", 
           RowBox[{"x", ",", "y"}], "]"}], ",", 
          RowBox[{"{", "coords", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]",
        "  ", 
       RowBox[{"hessM", "=", 
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"lossFunc", "[", 
           RowBox[{"x", ",", "y"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"coords", ",", "2"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"gamExpr", "=", 
        RowBox[{"gamFunc", "[", 
         RowBox[{"x", ",", "y"}], "]"}]}], ";", "\[IndentingNewLine]", "  ", 
       RowBox[{"gExpr", "=", 
        RowBox[{"gamExpr", "+", 
         RowBox[{"xiVal", "*", 
          RowBox[{"Outer", "[", 
           RowBox[{"Times", ",", "lGrad", ",", "lGrad"}], "]"}]}]}]}], ";", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"gamN", "=", 
        RowBox[{
         RowBox[{"gamExpr", " ", "/.", " ", "pt"}], " ", "//", " ", "N"}]}], ";",
        "\[IndentingNewLine]", "  ", 
       RowBox[{"gN", "=", 
        RowBox[{
         RowBox[{"gExpr", " ", "/.", " ", "pt"}], " ", "//", " ", "N"}]}], ";",
        "\[IndentingNewLine]", "  ", 
       RowBox[{"gInvN", "=", 
        RowBox[{"Inverse", "[", "gN", "]"}]}], ";", "\[IndentingNewLine]", 
       "  ", 
       RowBox[{"lN", "=", 
        RowBox[{
         RowBox[{"lGrad", " ", "/.", " ", "pt"}], " ", "//", " ", "N"}]}], ";",
        "\[IndentingNewLine]", "  ", 
       RowBox[{"hN", "=", 
        RowBox[{
         RowBox[{"hessM", " ", "/.", " ", "pt"}], " ", "//", " ", "N"}]}], ";",
        "\[IndentingNewLine]", "  ", 
       RowBox[{"dgdi", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"D", "[", 
             RowBox[{"gExpr", ",", 
              RowBox[{"coords", "[", 
               RowBox[{"[", "i", "]"}], "]"}]}], "]"}], " ", "/.", " ", 
            "pt"}], " ", "//", " ", "N"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "1", ",", "2"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"christN", "=", 
        RowBox[{"Table", "[", "\[IndentingNewLine]", "    ", 
         RowBox[{
          RowBox[{"Sum", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"gInvN", "[", 
              RowBox[{"[", 
               RowBox[{"k", ",", "ll"}], "]"}], "]"}], "*", 
             RowBox[{"(", 
              RowBox[{"1", "/", "2"}], ")"}], "*", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{"dgdi", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], "[", 
                RowBox[{"[", 
                 RowBox[{"j", ",", "ll"}], "]"}], "]"}], "+", 
               RowBox[{
                RowBox[{"dgdi", "[", 
                 RowBox[{"[", "j", "]"}], "]"}], "[", 
                RowBox[{"[", 
                 RowBox[{"i", ",", "ll"}], "]"}], "]"}], "-", 
               RowBox[{
                RowBox[{"dgdi", "[", 
                 RowBox[{"[", "ll", "]"}], "]"}], "[", 
                RowBox[{"[", 
                 RowBox[{"i", ",", "j"}], "]"}], "]"}]}], ")"}]}], ",", 
            RowBox[{"{", 
