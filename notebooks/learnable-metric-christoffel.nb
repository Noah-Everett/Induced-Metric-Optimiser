    RowBox[{"Expanding", " ", 
     RowBox[{"g", "^", 
      RowBox[{"{", "kl", "}"}]}]}], " ", "=", " ", 
    RowBox[{
     RowBox[{"\[Gamma]", "^", 
      RowBox[{"{", "kl", "}"}]}], " ", "-", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"\[Xi]", "/", "\[Alpha]"}], ")"}], " ", 
      RowBox[{"l", "^", "k"}], " ", 
      RowBox[{"l", "^", "l"}], " ", "in", " ", "the", " ", "first", " ", 
      RowBox[{"term", ":"}]}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
