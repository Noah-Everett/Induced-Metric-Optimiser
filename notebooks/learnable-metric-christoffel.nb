Cell["2. General Formula \[LongDash] Derivation", "Section",ExpressionUUID->"c53313a7-bc4a-48c9-94de-5275c2cad585"],

Cell["2.1 Metric Derivative", "Subsection",ExpressionUUID->"2382fdbb-6add-4990-923d-dcf54326199c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "The", " ", "metric", " ", "derivative", " ", "picks", " ", "up", " ", 
    "terms", " ", "from", " ", "both", " ", "\[Gamma]", " ", "and", " ", 
    "the", " ", "outer", " ", "product"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"\[PartialD]", "_k"}], " ", "g_", 
     RowBox[{"{", "ij", "}"}]}], " ", "=", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"\[PartialD]", "_k"}], " ", "\[Gamma]_", 
      RowBox[{"{", "ij", "}"}]}], " ", "+", " ", 
     RowBox[{"\[Xi]", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"H_", 
         RowBox[{"{", "ki", "}"}], " ", "l_j"}], " ", "+", " ", 
        RowBox[{"l_i", " ", "H_", 
         RowBox[{"{", "kj", "}"}]}]}], ")"}]}]}]}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<\[PartialD]_k g_{ij} = \[PartialD]_k \[Gamma]_{ij} + \
\[Xi](H_{ki} l_j + l_i H_{kj})\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<where H_{ij} = \[PartialD]_i l_j is the Hessian \
(symmetric)\>\"", "]"}], ";"}]}]}]], "Input",ExpressionUUID->"22bd4f1c-5f0d-\
4dca-95b3-d524f81da782"],

Cell["2.2 Christoffel Bracket", "Subsection",ExpressionUUID->"764b6af3-71ae-4792-96cb-b5bd2af750f5"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"The", " ", "Christoffel", " ", 
     RowBox[{"bracket", " ", "[", 
      RowBox[{"ij", ",", "l"}], "]"}], "_g"}], " ", "=", " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "/", "2"}], ")"}], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"\[PartialD]", "_i"}], " ", "g_", 
        RowBox[{"{", "jl", "}"}]}], " ", "+", " ", 
       RowBox[{
        RowBox[{"\[PartialD]", "_j"}], " ", "g_", 
        RowBox[{"{", "il", "}"}]}], " ", "-", " ", 
       RowBox[{
        RowBox[{"\[PartialD]", "_l"}], " ", "g_", 
        RowBox[{"{", "ij", "}"}]}]}], ")"}]}]}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"Expanding", " ", "using", " ", "the", " ", "metric", " ", 
    RowBox[{"derivative", ":"}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<[ij,l]_g = (1/2)(\[PartialD]_i g_{jl} + \[PartialD]_j \
g_{il} - \[PartialD]_l g_{ij})\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<= (1/2)[\[PartialD]_i \[Gamma]_{jl} + \[Xi](H_{ij} l_l \
+ l_j H_{il})\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<       + \[PartialD]_j \[Gamma]_{il} + \[Xi](H_{ji} \
l_l + l_i H_{jl})\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<       - \[PartialD]_l \[Gamma]_{ij} - \[Xi](H_{li} \
l_j + l_i H_{lj})]\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<The \[Xi] terms simplify using H symmetric \
(H_{ij}=H_{ji}, H_{il}=H_{li}, H_{jl}=H_{lj}):\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<\[Xi] terms = (1/2)\[Xi][2 H_{ij} l_l + (l_j H_{il} - \
H_{il} l_j) + (l_i H_{jl} - l_i H_{lj})]\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<        = \[Xi] H_{ij} l_l\>\"", "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<Therefore:\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<  [ij,l]_g = [ij,l]_\[Gamma] + \[Xi] H_{ij} l_l\>\"", 
     "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<This is EXACT \[LongDash] the cross terms cancel \
perfectly.\>\"", "]"}], ";"}]}]}]], "Input",ExpressionUUID->"3a958066-f361-\
4847-8c27-15a36dc5044f"],

Cell["2.3 Sherman-Morrison Inverse", "Subsection",ExpressionUUID->"b1fe8c62-799b-4b7c-87cd-99c8980d3dfc"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"\[Gamma]", " ", "+", " ", 
      RowBox[{"\[Xi]", " ", 
       RowBox[{"l", "\[CircleTimes]", "l"}]}]}]}], ",", " ", 
    RowBox[{
     RowBox[{"so", " ", "by", " ", "Sherman"}], "-", 
     RowBox[{"Morrison", ":"}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"g", "^", 
     RowBox[{"{", "kl", "}"}]}], " ", "=", " ", 
    RowBox[{
     RowBox[{"\[Gamma]", "^", 
      RowBox[{"{", "kl", "}"}]}], " ", "-", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"\[Xi]", "/", "\[Alpha]"}], ")"}], " ", 
      RowBox[{"l", "^", "k"}], " ", 
      RowBox[{"l", "^", "l"}]}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"where", " ", "\[Alpha]"}], " ", "=", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"1", " ", "+", " ", "\[Xi]"}], " ", "||", "l", "||", 
      RowBox[{"\.b2_\[Gamma]", " ", "and", " ", 
       RowBox[{"l", "^", "k"}]}]}], " ", "=", " ", 
     RowBox[{
      RowBox[{"\[Gamma]", "^", 
       RowBox[{"{", "km", "}"}]}], " ", "l_m"}]}]}], " ", "*)"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Key", " ", 
     RowBox[{"identity", ":", " ", 
      RowBox[{
       RowBox[{"g", "^", 
        RowBox[{"{", "kl", "}"}]}], " ", "l_l"}]}]}], " ", "=", " ", 
    RowBox[{
     RowBox[{"l", "^", "k"}], "/", "\[Alpha]"}]}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Proof", ":", " ", 
     RowBox[{
      RowBox[{"g", "^", 
       RowBox[{"{", "kl", "}"}]}], " ", "l_l"}]}], " ", "=", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"\[Gamma]", "^", 
       RowBox[{"{", "kl", "}"}]}], " ", "l_l"}], " ", "-", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"\[Xi]", "/", "\[Alpha]"}], ")"}], " ", 
      RowBox[{"l", "^", "k"}], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"l", "^", "l"}], " ", "l_l"}], ")"}]}]}]}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", "      ", 
   RowBox[{"=", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"l", "^", "k"}], " ", "-", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"\[Xi]", "/", "\[Alpha]"}], ")"}], " ", 
       RowBox[{"l", "^", "k"}]}]}], " ", "||", "l", "||", "\.b2_\[Gamma]"}]}],
    " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", "      ", 
   RowBox[{"=", " ", 
    RowBox[{
     RowBox[{"l", "^", "k"}], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"1", " ", "-", " ", "\[Xi]"}], "||", "l", "||", 
       RowBox[{"\.b2_\[Gamma]", "/", "\[Alpha]"}]}], ")"}]}]}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", "      ", 
   RowBox[{"=", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"l", "^", "k"}], "/", "\[Alpha]"}], "   ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"since", " ", "\[Alpha]"}], " ", "-", " ", "\[Xi]"}], "||", 
        "l", "||", "\.b2_\[Gamma]"}], " ", "=", " ", "1"}], ")"}]}]}], " ", 
   "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"Verify", " ", "symbolically"}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Clear", "[", "\"\<Global`*\>\"", "]"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"coords", "=", 
     RowBox[{"{", 
      RowBox[{"x", ",", "y"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"gam", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"g11", "[", 
          RowBox[{"x", ",", "y"}], "]"}], ",", 
         RowBox[{"g12", "[", 
          RowBox[{"x", ",", "y"}], "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"g12", "[", 
          RowBox[{"x", ",", "y"}], "]"}], ",", 
         RowBox[{"g22", "[", 
          RowBox[{"x", ",", "y"}], "]"}]}], "}"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"gamInv", "=", 
     RowBox[{"Inverse", "[", "gam", "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"loss", "[", 
      RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
     RowBox[{"LL", "[", 
      RowBox[{"x", ",", "y"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"lGrad", "=", 
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"loss", "[", 
        RowBox[{"x", ",", "y"}], "]"}], ",", 
       RowBox[{"{", "coords", "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   
   RowBox[{
    RowBox[{"xi", "=", "\[Xi]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"lUp", "=", 
     RowBox[{"gamInv", " ", ".", " ", "lGrad"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"normSqGam", "=", 
     RowBox[{"lGrad", " ", ".", " ", "gamInv", " ", ".", " ", "lGrad"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"alpha", "=", 
     RowBox[{"1", "+", 
      RowBox[{"xi", "*", "normSqGam"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"gInvSM", "=", 
     RowBox[{"gamInv", "-", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"xi", "/", "alpha"}], ")"}], "*", 
       RowBox[{"Outer", "[", 
        RowBox[{"Times", ",", "lUp", ",", "lUp"}], "]"}]}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"Check", " ", 
      RowBox[{"g", "^", 
       RowBox[{"{", "kl", "}"}]}], " ", "l_l"}], " ", "=", " ", 
     RowBox[{
      RowBox[{"l", "^", "k"}], "/", "\[Alpha]"}]}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"diff", "=", 
     RowBox[{"Simplify", "[", 
      RowBox[{
       RowBox[{"gInvSM", " ", ".", " ", "lGrad"}], "-", 
       RowBox[{"lUp", "/", "alpha"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<g^{kl} l_l - l^k/\[Alpha] = \>\"", ",", "diff", 
      ",", "\"\<  (should be {0,0})\>\""}], "]"}], ";"}]}]}]], "Input",Express\
ionUUID->"2fcbd3b5-b620-4b9a-8080-0d518196b290"],

Cell["2.4 Full Christoffel Symbol", "Subsection",ExpressionUUID->"350389b2-0e46-434d-9e0d-3e3d669386be"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"\[CapitalGamma]", "^", "k_"}], 
