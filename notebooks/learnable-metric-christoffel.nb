}], "Subsection",ExpressionUUID->"0cfc2813-e951-46a2-8acb-94c6e2fe02bb"],

Cell[BoxData[{
 RowBox[{"Clear", "[", "\"\<Global`*\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"coords", "=", 
    RowBox[{"{", 
     RowBox[{"x", ",", "y"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"\[Gamma]", " ", "=", " ", 
     RowBox[{
      RowBox[{"e", "^", 
       RowBox[{"{", 
        RowBox[{"s", 
         RowBox[{"(", 
          RowBox[{"x", ",", "y"}], ")"}]}], "}"}]}], " ", "I"}]}], " ", "\[LongDash]",
     " ", 
    RowBox[{"conformally", " ", "flat", " ", "metric"}]}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"gamSym", "=", 
   RowBox[{
    RowBox[{"Exp", "[", 
     RowBox[{"s", "[", 
      RowBox[{"x", ",", "y"}], "]"}], "]"}], "*", 
    RowBox[{"IdentityMatrix", "[", "2", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"gamInvSym", "=", 
    RowBox[{"Inverse", "[", "gamSym", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"christGamSym", "=", 
    RowBox[{"Table", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"Simplify", "[", 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"gamInvSym", "[", 
           RowBox[{"[", 
            RowBox[{"k", ",", "l"}], "]"}], "]"}], "*", 
          RowBox[{"(", 
           RowBox[{"1", "/", "2"}], ")"}], "*", 
          RowBox[{"(", "\[IndentingNewLine]", "    ", 
           RowBox[{
            RowBox[{"D", "[", 
             RowBox[{
              RowBox[{"gamSym", "[", 
               RowBox[{"[", 
                RowBox[{"j", ",", "l"}], "]"}], "]"}], ",", 
              RowBox[{"coords", "[", 
               RowBox[{"[", "i", "]"}], "]"}]}], "]"}], "+", 
            RowBox[{"D", "[", 
             RowBox[{
              RowBox[{"gamSym", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", "l"}], "]"}], "]"}], ",", 
              RowBox[{"coords", "[", 
               RowBox[{"[", "j", "]"}], "]"}]}], "]"}], "-", 
            RowBox[{"D", "[", 
             RowBox[{
              RowBox[{"gamSym", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", "j"}], "]"}], "]"}], ",", 
              RowBox[{"coords", "[", 
               RowBox[{"[", "l", "]"}], "]"}]}], "]"}]}], 
           "\[IndentingNewLine]", "  ", ")"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"l", ",", "1", ",", "2"}], "}"}]}], "]"}], "]"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"{", 
       RowBox[{"k", ",", "1", ",", "2"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "1", ",", "2"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"j", ",", "1", ",", "2"}], "}"}]}], "\[IndentingNewLine]", 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<Christoffel symbols of \[Gamma] = e^s I:\>\"", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"For", "[", 
    RowBox[{
     RowBox[{"k", "=", "1"}], ",", 
     RowBox[{"k", "<=", "2"}], ",", 
     RowBox[{"k", "++"}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"i", "=", "1"}], ",", 
       RowBox[{"i", "<=", "2"}], ",", 
       RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", "    ", 
       RowBox[{"For", "[", 
        RowBox[{
         RowBox[{"j", "=", "i"}], ",", 
         RowBox[{"j", "<=", "2"}], ",", 
         RowBox[{"j", "++"}], ",", "\[IndentingNewLine]", "      ", 
         RowBox[{"Print", "[", 
          
          RowBox[{"\"\<  \[CapitalGamma]^\>\"", ",", "k", ",", "\"\<_{\>\"", ",",
            "i", ",", "\"\<,\>\"", ",", "j", ",", "\"\<}(\[Gamma]) = \>\"", ",", 
           RowBox[{"christGamSym", "[", 
            RowBox[{"[", 
             RowBox[{"k", ",", "i", ",", "j"}], "]"}], "]"}]}], "]"}]}], 
        "\[IndentingNewLine]", "    ", "]"}]}], "\[IndentingNewLine]", "  ", 
      "]"}]}], "\[IndentingNewLine]", "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<Using notation s_x = \[PartialD]s/\[PartialD]x, s_y = \
\[PartialD]s/\[PartialD]y:\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<  \[CapitalGamma]^1_{11} = s_x/2,   \
\[CapitalGamma]^1_{12} = s_y/2,   \[CapitalGamma]^1_{22} = -s_x/2\>\"", "]"}],
   ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<  \[CapitalGamma]^2_{11} = -s_y/2,  \
\[CapitalGamma]^2_{12} = s_x/2,   \[CapitalGamma]^2_{22} = s_y/2\>\"", "]"}], 
  ";"}]}], "Input",ExpressionUUID->"4f568e7a-013a-483f-b563-d2d655546545"],

Cell[TextData[{
 "4.2 Correction Term ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["C", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"]}]], "\[LongEqual]", 
         SubsuperscriptBox["\[CapitalGamma]", 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"]}], 
          StyleBox["k", "TI"]], 
         RowBox[{"(", "\[Gamma]", ")"}], " ", 
         SubscriptBox[
          StyleBox["l", "TI"], 
          StyleBox["k", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "C_{ij} = \\Gamma^k_{ij}(\\gamma)\\, l_k", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0a0c1a71-2b2c-4cba-843e-d2738f681aa3"]
}], "Subsection",ExpressionUUID->"4a1e409a-0735-4af4-a515-8be538957390"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Compute", " ", "the", " ", "correction"}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"lSym", "=", 
     RowBox[{"{", 
      RowBox[{"lx", ",", "ly"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"corrScalar", "=", 
     RowBox[{
      RowBox[{"Table", "[", "\[IndentingNewLine]", "  ", 
       RowBox[{
        RowBox[{"Simplify", "[", 
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"christGamSym", "[", 
             RowBox[{"[", 
              RowBox[{"k", ",", "i", ",", "j"}], "]"}], "]"}], "*", 
            RowBox[{"lSym", "[", 
             RowBox[{"[", "k", "]"}], "]"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"k", ",", "1", ",", "2"}], "}"}]}], "]"}], "]"}], ",", 
        "\[IndentingNewLine]", "  ", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", "2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", "1", ",", "2"}], "}"}]}], "\[IndentingNewLine]", 
       "]"}], " ", "/.", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"Derivative", "[", 
            RowBox[{"1", ",", "0"}], "]"}], "[", "s", "]"}], "[", 
          RowBox[{"x", ",", "y"}], "]"}], "->", "sx"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"Derivative", "[", 
            RowBox[{"0", ",", "1"}], "]"}], "[", "s", "]"}], "[", 
          RowBox[{"x", ",", "y"}], "]"}], "->", "sy"}]}], "}"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Correction matrix C_{ij} = \[CapitalGamma]^k_{ij}(\
\[Gamma]) l_k:\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"corrScalar", " ", "//", " ", "MatrixForm"}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"Verify", " ", "it", " ", "equals", " ", 
     RowBox[{"(", 
      RowBox[{"1", "/", "2"}], ")"}], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"\[Del]", "s"}], "\[CircleTimes]", "l"}], " ", "+", " ", 
       RowBox[{"l", "\[CircleTimes]", 
        RowBox[{"\[Del]", "s"}]}], " ", "-", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"\[Del]", "s"}], "\[CenterDot]", "l"}], ")"}], "I"}]}], 
      ")"}]}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"sGrad", "=", 
     RowBox[{"{", 
      RowBox[{"sx", ",", "sy"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"formulaC", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "/", "2"}], ")"}], "*", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Outer", "[", 
         RowBox[{"Times", ",", "sGrad", ",", "lSym"}], "]"}], "+", 
        RowBox[{"Outer", "[", 
         RowBox[{"Times", ",", "lSym", ",", "sGrad"}], "]"}], "-", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"sGrad", " ", ".", " ", "lSym"}], ")"}], "*", 
         RowBox[{"IdentityMatrix", "[", "2", "]"}]}]}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Closed form: C = (1/2)(\[Del]s\[CircleTimes]l + l\
\[CircleTimes]\[Del]s - (\[Del]s\[CenterDot]l)I)\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Verification: \>\"", ",", 
      RowBox[{"Simplify", "[", 
       RowBox[{"corrScalar", "-", "formulaC"}], "]"}], 
      ",", "\"\<  (should be zero matrix)\>\""}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<Properties:\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<  Tr(C) = \>\"", ",", 
      RowBox[{"Simplify", "[", 
       RowBox[{"Tr", "[", "corrScalar", "]"}], "]"}], 
      ",", "\"\<  (TRACELESS)\>\""}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<  Eigenvalues of C: \
\[PlusMinus]||\[Del]s||\[CenterDot]||l||/2\>\"", "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"Verify", " ", "eigenvalue", " ", "formula"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"eigC", "=", 
     RowBox[{
      RowBox[{"Eigenvalues", "[", "corrScalar", "]"}], " ", "//", " ", 
      "Simplify"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<  Symbolic eigenvalues: \>\"", ",", "eigC"}], "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<  Simplified: \[PlusMinus]\>\"", ",", 
      RowBox[{
       RowBox[{"Simplify", "[", 
        RowBox[{"Sqrt", "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"sx", "^", "2"}], "+", 
            RowBox[{"sy", "^", "2"}]}], ")"}], "*", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"lx", "^", "2"}], "+", 
            RowBox[{"ly", "^", "2"}]}], ")"}]}], "]"}], "]"}], "/", "2"}]}], 
     "]"}], ";"}]}]}]], "Input",ExpressionUUID->"75fd7055-fa9b-404c-a62c-\
7d01d356f9aa"],

Cell["4.3 Riemannian Hessian \[LongDash] Scalar Case", "Subsection",ExpressionUUID->"8e5632b5-4e4c-4d3e-a308-2eb21005474a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<\:2554\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\
\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\
\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\
\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\
\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\
\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\
\:2550\:2557\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<\:2551  SCALAR CASE: \[Gamma] = e^s I                    \
                            \:2551\>\"", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<\:2551                                                   \
                       \:2551\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<\:2551  (Hess_g L)_{ij} = [H_{ij} - (s_i l_j + s_j l_i - \
(\[Del]s\[CenterDot]l)\[Delta]_{ij})/2] / \[Alpha] \:2551\>\"", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<\:2551                                                   \
                       \:2551\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<\:2551  where \[Alpha] = 1 + \[Xi] e^{-s} ||l||\.b2      \
                                    \:2551\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<\:2551                                                   \
                       \:2551\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<\:2551  Correction C is TRACELESS with eigenvalues \
\[PlusMinus]||\[Del]s||\[CenterDot]||l||/2              \:2551\>\"", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<\:2551                                                   \
                       \:2551\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<\:2551  NECESSARY CONDITION for sign flip: Tr(H) = \
\[CapitalDelta]L > 0                      \:2551\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<\:2551  (Laplacian of L must be positive)                \
                       \:2551\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
