Cell["9. Implications for the Paper", "Section",ExpressionUUID->"c38457c4-706d-428b-909c-1f3eaf6d42b8"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Print", "[", "\"\<IMPLICATIONS FOR THE PAPER:\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<1. The learnable metric is NOT just doing adaptive \
learning rate.\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<   It performs genuine Riemannian curvature \
correction.\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<2. The scalar metric (\[Gamma] = e^s I) can 'convexify' \
saddle points\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<   only when the loss has positive Laplacian (Tr(H) > \
0).\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<   This is a limited but useful form of curvature \
correction.\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<3. The diagonal metric (\[Gamma] = diag(e^{s\:2081}, \
e^{s\:2082})) is strictly\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<   more powerful due to its non-traceless correction \
term.\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<   It can convexify ANY saddle point, regardless of \
Tr(H).\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<4. The extra correction terms \[Proportional] \
\[CapitalGamma]^k_{ij}(\[Gamma]) l_k involve\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<   the Christoffel symbols of the learned metric \
contracted\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<   with the loss gradient. This is a genuinely geometric \
object.\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<5. The mechanism is: the LEARNED CURVATURE of \[Gamma] \
(which evolves\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<   during training) compensates for the negative \
curvature\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<   of the loss landscape. This is NOT available with \
constant \[Gamma].\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<6. For the diagonal case, the key mechanism is the \
ANISOTROPY\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<   ratio e^{s\:2081-s\:2082}, which creates asymmetric \
amplification\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<   in the correction term. Larger anisotropy = stronger \
correction.\>\"", "]"}], ";"}]}], "Input",ExpressionUUID->"b0b3c483-aa2b-4cf9-\
a318-6220b7fd5b42"]
},
FrontEndVersion->"14.3 for Mac OS X ARM (64-bit) (July 8, 2025)",
