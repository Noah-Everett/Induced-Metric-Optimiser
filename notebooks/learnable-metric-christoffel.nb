Cell[TextData[{
 "4.1 Christoffel Symbols of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Gamma]", "\[LongEqual]", 
         SuperscriptBox[
          StyleBox["e", "TI"], 
          RowBox[{
            StyleBox["s", "TI"], "(", "\[Theta]", ")"}]], 
