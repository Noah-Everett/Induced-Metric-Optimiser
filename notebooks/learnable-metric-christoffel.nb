Cell[TextData[{
 "5. Part 3: Learnable Diagonal \[LongDash] ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Gamma]", "\[LongEqual]", "diag", 
         RowBox[{"(", 
           RowBox[{
             SuperscriptBox[
              StyleBox["e", "TI"], 
              SubscriptBox[
               StyleBox["s", "TI"], "1"]], ",", 
             SuperscriptBox[
              StyleBox["e", "TI"], 
              SubscriptBox[
               StyleBox["s", "TI"], "2"]]}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\gamma = \\text{diag}(e^{s_1}, e^{s_2})", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "abcf73ea-8604-4b25-aaa9-b033b35b320a"]
}], "Section",ExpressionUUID->"5cf3ba20-021a-4daa-a4ee-db17f7526d1e"],

Cell["5.1 Christoffel Symbols", "Subsection",ExpressionUUID->"44bd7d34-18aa-40c4-b937-33c03da28d7d"],

Cell[BoxData[{
 RowBox[{"Clear", "[", "\"\<Global`*\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"coords", "=", 
    RowBox[{"{", 
     RowBox[{"x", ",", "y"}], "}"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"gamDiag", "=", 
   RowBox[{"DiagonalMatrix", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Exp", "[", 
       RowBox[{"s1", "[", 
        RowBox[{"x", ",", "y"}], "]"}], "]"}], ",", 
      RowBox[{"Exp", "[", 
       RowBox[{"s2", "[", 
        RowBox[{"x", ",", "y"}], "]"}], "]"}]}], "}"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"gamDiagInv", "=", 
    RowBox[{"Inverse", "[", "gamDiag", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"christGamDiag", "=", 
    RowBox[{"Table", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"Simplify", "[", 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"gamDiagInv", "[", 
           RowBox[{"[", 
            RowBox[{"k", ",", "l"}], "]"}], "]"}], "*", 
          RowBox[{"(", 
           RowBox[{"1", "/", "2"}], ")"}], "*", 
          RowBox[{"(", "\[IndentingNewLine]", "    ", 
           RowBox[{
            RowBox[{"D", "[", 
             RowBox[{
              RowBox[{"gamDiag", "[", 
               RowBox[{"[", 
                RowBox[{"j", ",", "l"}], "]"}], "]"}], ",", 
              RowBox[{"coords", "[", 
               RowBox[{"[", "i", "]"}], "]"}]}], "]"}], "+", 
            RowBox[{"D", "[", 
             RowBox[{
              RowBox[{"gamDiag", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", "l"}], "]"}], "]"}], ",", 
              RowBox[{"coords", "[", 
               RowBox[{"[", "j", "]"}], "]"}]}], "]"}], "-", 
            RowBox[{"D", "[", 
             RowBox[{
              RowBox[{"gamDiag", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", "j"}], "]"}], "]"}], ",", 
              RowBox[{"coords", "[", 
               RowBox[{"[", "l", "]"}], "]"}]}], "]"}]}], 
           "\[IndentingNewLine]", "  ", ")"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"l", ",", "1", ",", "2"}], "}"}]}], "]"}], "]"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"{", 
       RowBox[{"k", ",", "1", ",", "2"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "1", ",", "2"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"j", ",", "1", ",", "2"}], "}"}]}], "\[IndentingNewLine]", 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<Christoffel symbols of \[Gamma] = diag(e^{s\:2081}, e^{s\
\:2082}):\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"For", "[", 
   RowBox[{
    RowBox[{"k", "=", "1"}], ",", 
    RowBox[{"k", "<=", "2"}], ",", 
    RowBox[{"k", "++"}], ",", "\[IndentingNewLine]", "  ", 
    RowBox[{"For", "[", 
     RowBox[{
      RowBox[{"i", "=", "1"}], ",", 
      RowBox[{"i", "<=", "2"}], ",", 
      RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", "    ", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"j", "=", "i"}], ",", 
        RowBox[{"j", "<=", "2"}], ",", 
        RowBox[{"j", "++"}], ",", "\[IndentingNewLine]", "      ", 
        RowBox[{
         RowBox[{"expr", "=", 
          RowBox[{"christGamDiag", "[", 
           RowBox[{"[", 
            RowBox[{"k", ",", "i", ",", "j"}], "]"}], "]"}]}], ";", 
         "\[IndentingNewLine]", "      ", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"expr", "=!=", "0"}], ",", 
           RowBox[{"Print", "[", 
            
            RowBox[{"\"\<  \[CapitalGamma]^\>\"", ",", "k", ",", "\"\<_{\>\"",
              ",", "i", ",", "\"\<,\>\"", ",", "j", 
             ",", "\"\<}(\[Gamma]) = \>\"", ",", "expr"}], "]"}]}], "]"}]}]}],
        "\[IndentingNewLine]", "    ", "]"}]}], "\[IndentingNewLine]", "  ", 
     "]"}]}], "\[IndentingNewLine]", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<Key difference from scalar case: cross-terms involve \
e^{s\:2081-s\:2082} and e^{s\:2082-s\:2081}\>\"", "]"}], ";"}]}], "Input",Expr\
essionUUID->"98417407-236c-4851-9b3c-7fa07c2fcafa"],

Cell["5.2 Correction Term", "Subsection",ExpressionUUID->"e59e2b65-8157-40cb-b45f-5c8987a791bd"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"lSym", "=", 
   RowBox[{"{", 
    RowBox[{"lx", ",", "ly"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"corrDiag", "=", 
    RowBox[{"Table", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"Simplify", "[", 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"christGamDiag", "[", 
           RowBox[{"[", 
            RowBox[{"k", ",", "i", ",", "j"}], "]"}], "]"}], "*", 
          RowBox[{"lSym", "[", 
           RowBox[{"[", "k", "]"}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", "1", ",", "2"}], "}"}]}], "]"}], "]"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"{", 
       RowBox[{"i", ",", "1", ",", "2"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"j", ",", "1", ",", "2"}], "}"}]}], "\[IndentingNewLine]", 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"corrDiag2", "=", 
    RowBox[{"corrDiag", " ", "/.", " ", 
     RowBox[{"{", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Derivative", "[", 
           RowBox[{"1", ",", "0"}], "]"}], "[", "s1", "]"}], "[", 
         RowBox[{"x", ",", "y"}], "]"}], "->", 
        RowBox[{"Subscript", "[", 
         RowBox[{"s1", ",", "x"}], "]"}]}], ",", "\[IndentingNewLine]", "  ", 
       
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Derivative", "[", 
           RowBox[{"0", ",", "1"}], "]"}], "[", "s1", "]"}], "[", 
         RowBox[{"x", ",", "y"}], "]"}], "->", 
        RowBox[{"Subscript", "[", 
         RowBox[{"s1", ",", "y"}], "]"}]}], ",", "\[IndentingNewLine]", "  ", 
       
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Derivative", "[", 
           RowBox[{"1", ",", "0"}], "]"}], "[", "s2", "]"}], "[", 
         RowBox[{"x", ",", "y"}], "]"}], "->", 
        RowBox[{"Subscript", "[", 
         RowBox[{"s2", ",", "x"}], "]"}]}], ",", "\[IndentingNewLine]", "  ", 
       
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Derivative", "[", 
           RowBox[{"0", ",", "1"}], "]"}], "[", "s2", "]"}], "[", 
         RowBox[{"x", ",", "y"}], "]"}], "->", 
        RowBox[{"Subscript", "[", 
         RowBox[{"s2", ",", "y"}], "]"}]}]}], "\[IndentingNewLine]", 
      "}"}]}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<Correction matrix C_{ij} = \[CapitalGamma]^k_{ij}(\
\[Gamma]) l_k (diagonal case):\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"corrDiag2", " ", "//", " ", "MatrixForm"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"Compute", " ", "trace"}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"trC", "=", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{"corrDiag", "[", 
      RowBox[{"[", 
       RowBox[{"1", ",", "1"}], "]"}], "]"}], "+", 
     RowBox[{"corrDiag", "[", 
      RowBox[{"[", 
       RowBox[{"2", ",", "2"}], "]"}], "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"trC2", "=", 
   RowBox[{"trC", " ", "/.", " ", 
    RowBox[{"{", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Derivative", "[", 
          RowBox[{"1", ",", "0"}], "]"}], "[", "s1", "]"}], "[", 
        RowBox[{"x", ",", "y"}], "]"}], "->", 
       RowBox[{"Subscript", "[", 
        RowBox[{"s1", ",", "x"}], "]"}]}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Derivative", "[", 
          RowBox[{"0", ",", "1"}], "]"}], "[", "s1", "]"}], "[", 
        RowBox[{"x", ",", "y"}], "]"}], "->", 
       RowBox[{"Subscript", "[", 
        RowBox[{"s1", ",", "y"}], "]"}]}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Derivative", "[", 
          RowBox[{"1", ",", "0"}], "]"}], "[", "s2", "]"}], "[", 
        RowBox[{"x", ",", "y"}], "]"}], "->", 
       RowBox[{"Subscript", "[", 
        RowBox[{"s2", ",", "x"}], "]"}]}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Derivative", "[", 
          RowBox[{"0", ",", "1"}], "]"}], "[", "s2", "]"}], "[", 
        RowBox[{"x", ",", "y"}], "]"}], "->", 
       RowBox[{"Subscript", "[", 
        RowBox[{"s2", ",", "y"}], "]"}]}]}], "\[IndentingNewLine]", "}"}]}]}],
   ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Tr(C) = \>\"", ",", "trC2"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<CRITICAL: Tr(C) \[NotEqual] 0 in general (unlike scalar \
case)!\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<The exponential factors e^{s\:2081-s\:2082} create \
asymmetric amplification.\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<This is the mechanism for curvature correction beyond \
the scalar case.\>\"", "]"}], ";"}]}], "Input",ExpressionUUID->"0ab689b3-350f-\
4e0e-ae6c-7775b0ac234e"],

Cell["5.3 Reduction to Scalar Case", "Subsection",ExpressionUUID->"606398e4-1b2d-432e-a170-4845721a5d1c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"When", " ", "s1"}], " ", "=", " ", 
     RowBox[{"s2", " ", "=", " ", "s"}]}], ",", " ", 
    RowBox[{"verify", " ", "reduction"}]}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"corrReduced", "=", 
     RowBox[{"corrDiag", " ", "/.", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"s1", "->", "s"}], ",", 
        RowBox[{"s2", "->", "s"}]}], "}"}]}]}], ";"}], "\[IndentingNewLine]", 
   
   RowBox[{
    RowBox[{"corrReduced2", "=", 
     RowBox[{"corrReduced", " ", "/.", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"Derivative", "[", 
            RowBox[{"1", ",", "0"}], "]"}], "[", "s", "]"}], "[", 
          RowBox[{"x", ",", "y"}], "]"}], "->", "sx"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"Derivative", "[", 
            RowBox[{"0", ",", "1"}], "]"}], "[", "s", "]"}], "[", 
          RowBox[{"x", ",", "y"}], "]"}], "->", "sy"}]}], "}"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<When s\:2081 = s\:2082 = s (scalar case):\>\"", "]"}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<C reduces to: \>\"", ",", 
      RowBox[{
       RowBox[{"Simplify", "[", "corrReduced2", "]"}], " ", "//", " ", 
       "MatrixForm"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Tr(C) = \>\"", ",", 
      RowBox[{"Simplify", "[", 
       RowBox[{"Tr", "[", "corrReduced2", "]"}], "]"}], 
      ",", "\"\<  (traceless, as expected)\>\""}], "]"}], ";"}]}]}]], "Input",\
ExpressionUUID->"bb06d5a2-8999-4f0d-b3f5-34b585a5a732"],

