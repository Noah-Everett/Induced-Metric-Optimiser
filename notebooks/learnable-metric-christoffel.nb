     RowBox[{"(", "g", ")"}]}], " ", "=", " ", 
    RowBox[{
     RowBox[{"g", "^", 
      RowBox[{
       RowBox[{"{", "kl", "}"}], " ", "[", 
       RowBox[{"ij", ",", "l"}], "]"}]}], "_g"}]}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", "             ", 
   RowBox[{"=", " ", 
    RowBox[{
     RowBox[{"g", "^", 
      RowBox[{"{", "kl", "}"}]}], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"[", 
         RowBox[{"ij", ",", "l"}], "]"}], "_\[Gamma]"}], " ", "+", " ", 
       RowBox[{"\[Xi]", " ", "H_", 
        RowBox[{"{", "ij", "}"}], " ", "l_l"}]}], ")"}]}]}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", "             ", 
   RowBox[{"=", " ", 
