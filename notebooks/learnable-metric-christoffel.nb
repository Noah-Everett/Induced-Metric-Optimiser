Cell["3. Numerical Verification of General Formula", "Section",ExpressionUUID->"0d52b230-04e4-42d8-b283-b8f36f5cc3be"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Verify", " ", "the", " ", "formula", " ", "with", " ", "concrete", " ", 
    "functions"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Clear", "[", "\"\<Global`*\>\"", "]"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"coords", "=", 
     RowBox[{"{", 
      RowBox[{"x", ",", "y"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"xiVal", "=", "1"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"L", " ", "=", " ", 
      RowBox[{
       RowBox[{"3", "x\.b2"}], " ", "-", " ", "y\.b2"}]}], ",", " ", 
     RowBox[{"\[Gamma]", " ", "=", " ", 
      RowBox[{
       RowBox[{"e", "^", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"6", "x"}], "+", 
            RowBox[{"2", "y"}]}], ")"}], "/", "5"}], "}"}]}], " ", "I"}]}]}], 
    " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"lossF", "[", 
      RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"3", " ", 
       RowBox[{"x", "^", "2"}]}], "-", 
      RowBox[{"y", "^", "2"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"sF", "[", 
      RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"6", "/", "5"}], ")"}], " ", "x"}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"2", "/", "5"}], ")"}], " ", "y"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"gamF", "=", 
     RowBox[{
      RowBox[{"Exp", "[", 
       RowBox[{"sF", "[", 
        RowBox[{"x", ",", "y"}], "]"}], "]"}], "*", 
      RowBox[{"IdentityMatrix", "[", "2", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"lGradF", "=", 
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"lossF", "[", 
        RowBox[{"x", ",", "y"}], "]"}], ",", 
       RowBox[{"{", "coords", "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   
   RowBox[{
    RowBox[{"hessF", "=", 
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"lossF", "[", 
        RowBox[{"x", ",", "y"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"coords", ",", "2"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"gF", "=", 
     RowBox[{"gamF", "+", 
      RowBox[{"xiVal", "*", 
       RowBox[{"Outer", "[", 
        RowBox[{"Times", ",", "lGradF", ",", "lGradF"}], "]"}]}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"pt", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"x", "->", "1"}], ",", 
       RowBox[{"y", "->", "1"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"Compute", " ", "Riemannian", " ", "Hessian", " ", "directly"}], 
    " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"gamNum", "=", 
     RowBox[{
      RowBox[{"gamF", " ", "/.", " ", "pt"}], " ", "//", " ", "N"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"gNum", "=", 
     RowBox[{
      RowBox[{"gF", " ", "/.", " ", "pt"}], " ", "//", " ", "N"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"gInvNum", "=", 
     RowBox[{"Inverse", "[", "gNum", "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"lNum", "=", 
     RowBox[{
      RowBox[{"lGradF", " ", "/.", " ", "pt"}], " ", "//", " ", "N"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"hNum", "=", 
     RowBox[{
      RowBox[{"hessF", " ", "/.", " ", "pt"}], " ", "//", " ", "N"}]}], ";"}],
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"dgdi", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"D", "[", 
          RowBox[{"gF", ",", 
           RowBox[{"coords", "[", 
            RowBox[{"[", "i", "]"}], "]"}]}], "]"}], " ", "/.", " ", "pt"}], 
        " ", "//", " ", "N"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", "2"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"christGNum", "=", 
     RowBox[{"Table", "[", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"gInvNum", "[", 
           RowBox[{"[", 
            RowBox[{"k", ",", "ll"}], "]"}], "]"}], "*", 
          RowBox[{"(", 
           RowBox[{"1", "/", "2"}], ")"}], "*", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"dgdi", "[", 
              RowBox[{"[", "i", "]"}], "]"}], "[", 
             RowBox[{"[", 
              RowBox[{"j", ",", "ll"}], "]"}], "]"}], "+", 
            RowBox[{
             RowBox[{"dgdi", "[", 
              RowBox[{"[", "j", "]"}], "]"}], "[", 
             RowBox[{"[", 
              RowBox[{"i", ",", "ll"}], "]"}], "]"}], "-", 
            RowBox[{
             RowBox[{"dgdi", "[", 
              RowBox[{"[", "ll", "]"}], "]"}], "[", 
             RowBox[{"[", 
              RowBox[{"i", ",", "j"}], "]"}], "]"}]}], ")"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"ll", ",", "1", ",", "2"}], "}"}]}], "]"}], ",", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"{", 
        RowBox[{"k", ",", "1", ",", "2"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", "2"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "1", ",", "2"}], "}"}]}], "\[IndentingNewLine]", 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"directRH", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"hNum", "[", 
         RowBox[{"[", 
          RowBox[{"i", ",", "j"}], "]"}], "]"}], "-", 
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"christGNum", "[", 
            RowBox[{"[", 
             RowBox[{"k", ",", "i", ",", "j"}], "]"}], "]"}], "*", 
           RowBox[{"lNum", "[", 
            RowBox[{"[", "k", "]"}], "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"k", ",", "1", ",", "2"}], "}"}]}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", "2"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "1", ",", "2"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"Compute", " ", "via", " ", 
     RowBox[{"formula", ":", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"H", " ", "-", " ", 
         RowBox[{"\[CapitalGamma]", 
          RowBox[{
           RowBox[{"(", "\[Gamma]", ")"}], "\[CenterDot]", "l"}]}]}], ")"}], 
       " ", "/", " ", "\[Alpha]"}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"gamInvNum", "=", 
     RowBox[{"Inverse", "[", "gamNum", "]"}]}], ";"}], "\[IndentingNewLine]", 
   
   RowBox[{
    RowBox[{"dgamdi", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"D", "[", 
          RowBox[{"gamF", ",", 
           RowBox[{"coords", "[", 
            RowBox[{"[", "i", "]"}], "]"}]}], "]"}], " ", "/.", " ", "pt"}], 
        " ", "//", " ", "N"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", "2"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"christGamNum", "=", 
     RowBox[{"Table", "[", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"gamInvNum", "[", 
           RowBox[{"[", 
            RowBox[{"k", ",", "ll"}], "]"}], "]"}], "*", 
          RowBox[{"(", 
           RowBox[{"1", "/", "2"}], ")"}], "*", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"dgamdi", "[", 
              RowBox[{"[", "i", "]"}], "]"}], "[", 
             RowBox[{"[", 
              RowBox[{"j", ",", "ll"}], "]"}], "]"}], "+", 
            RowBox[{
             RowBox[{"dgamdi", "[", 
              RowBox[{"[", "j", "]"}], "]"}], "[", 
             RowBox[{"[", 
              RowBox[{"i", ",", "ll"}], "]"}], "]"}], "-", 
            RowBox[{
             RowBox[{"dgamdi", "[", 
              RowBox[{"[", "ll", "]"}], "]"}], "[", 
             RowBox[{"[", 
              RowBox[{"i", ",", "j"}], "]"}], "]"}]}], ")"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"ll", ",", "1", ",", "2"}], "}"}]}], "]"}], ",", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"{", 
        RowBox[{"k", ",", "1", ",", "2"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", "2"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "1", ",", "2"}], "}"}]}], "\[IndentingNewLine]", 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"gamCorr", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"christGamNum", "[", 
           RowBox[{"[", 
            RowBox[{"k", ",", "i", ",", "j"}], "]"}], "]"}], "*", 
          RowBox[{"lNum", "[", 
           RowBox[{"[", "k", "]"}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", "1", ",", "2"}], "}"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", "2"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "1", ",", "2"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"alphaNum", "=", 
     RowBox[{"1", "+", 
      RowBox[{"xiVal", "*", 
       RowBox[{
       "lNum", " ", ".", " ", "gamInvNum", " ", ".", " ", "lNum"}]}]}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"formulaRH", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"hNum", "-", "gamCorr"}], ")"}], "/", "alphaNum"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<=== VERIFICATION: General Formula ===\>\"", "]"}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<At (1,1) with L = 3x\.b2-y\.b2, \[Gamma] = \
e^{(6x+2y)/5} I, \[Xi] = 1\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Direct computation:  \>\"", ",", 
      RowBox[{"directRH", " ", "//", " ", "MatrixForm"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Formula (H-\[CapitalGamma]\[CenterDot]l)/\[Alpha]:  \>\"", ",", 
      RowBox[{"formulaRH", " ", "//", " ", "MatrixForm"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Difference:          \>\"", ",", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"directRH", "-", "formulaRH"}], ")"}], " ", "//", " ", 
       "MatrixForm"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Max |difference|:    \>\"", ",", 
      RowBox[{"Max", "[", 
       RowBox[{"Abs", "[", 
        RowBox[{"Flatten", "[", 
         RowBox[{"directRH", "-", "formulaRH"}], "]"}], "]"}], "]"}]}], "]"}],
     ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<\[Alpha] = \>\"", ",", "alphaNum"}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<H/\[Alpha] = \>\"", ",", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"hNum", "/", "alphaNum"}], ")"}], " ", "//", " ", 
       "MatrixForm"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Correction -\[CapitalGamma](\[Gamma])\[CenterDot]l/\[Alpha] \
= \>\"", ",", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "gamCorr"}], "/", "alphaNum"}], ")"}], " ", "//", " ", 
       "MatrixForm"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<eigenvalues(H) = \>\"", ",", 
      RowBox[{"Sort", "[", 
       RowBox[{"Eigenvalues", "[", "hNum", "]"}], "]"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<eigenvalues(Hess_g) = \>\"", ",", 
      RowBox[{"Sort", "[", 
       RowBox[{"Eigenvalues", "[", "directRH", "]"}], "]"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<SIGN CHANGE: \>\"", ",", 
      RowBox[{
       RowBox[{
        RowBox[{"Min", "[", 
         RowBox[{"Eigenvalues", "[", "hNum", "]"}], "]"}], "<", "0"}], "&&", 
       RowBox[{
        RowBox[{"Min", "[", 
         RowBox[{"Eigenvalues", "[", "directRH", "]"}], "]"}], ">", "0"}]}]}],
      "]"}], ";"}]}]}]], "Input",ExpressionUUID->"e0de20b4-9d48-41e4-b45b-\
a0c41821a743"],

