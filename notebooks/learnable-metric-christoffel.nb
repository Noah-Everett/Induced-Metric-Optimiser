        RowBox[{"{", "ij", "}"}]}], " ", "-", " ", 
       RowBox[{
        RowBox[{"\[CapitalGamma]", "^", "k_"}], 
        RowBox[{"{", "ij", "}"}], 
        RowBox[{"(", "\[Gamma]", ")"}], " ", "l_k"}]}], ")"}]}]}], " ", 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"=", " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "/", "\[Alpha]"}], ")"}], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"H_", 
        RowBox[{"{", "ij", "}"}]}], " ", "-", " ", 
       RowBox[{
        RowBox[{"\[CapitalGamma]", "^", "k_"}], 
