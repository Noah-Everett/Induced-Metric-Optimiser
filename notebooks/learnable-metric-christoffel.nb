\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\
\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2557\>\"",
      "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<\:2551  \[CapitalGamma]^k_{ij}(g) = \
\[CapitalGamma]^k_{ij}(\[Gamma]) + (\[Xi]/\[Alpha]) l^k [H_{ij} - \
\[CapitalGamma]^m_{ij}(\[Gamma]) l_m]  \:2551\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
