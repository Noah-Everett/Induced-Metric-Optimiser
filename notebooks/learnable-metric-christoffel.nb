             \:2551\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<\:2551  (Hess_g L)_{ij} = [H_{ij} - \
\[CapitalGamma]^k_{ij}(\[Gamma]) l_k] / \[Alpha]         \:2551\>\"", "]"}], 
    ";"}], "\[IndentingNewLine]", 
