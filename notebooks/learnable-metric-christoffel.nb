Cell[TextData[{
 "The induced metric is ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["g", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"]}]], 
         RowBox[{"(", "\[Theta]", ")"}], "\[LongEqual]", 
         SubscriptBox["\[Gamma]", 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"]}]], 
         RowBox[{"(", "\[Theta]", ")"}], "+", "\[Xi] ", 
         SubscriptBox[
          StyleBox["l", "TI"], 
          StyleBox["i", "TI"]], " ", 
         SubscriptBox[
          StyleBox["l", "TI"], 
          StyleBox["j", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "g_{ij}(\\theta) = \\gamma_{ij}(\\theta) + \\xi\\, l_i\\, l_j", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5dc99ccc-7ad9-48e3-b0c2-cd785ac0f8b7"],
 " where: "
}], "Text",ExpressionUUID->"3506d46d-90eb-433d-a678-4ca61675bcfa"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Gamma]", 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"]}]], "(", "\[Theta]", ")"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\gamma_{ij}(\\theta)", "state" -> "Boxes"|>,
    
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d11c8578-5823-4c9b-a582-22b1c61ef2fa"],
 " is a ",
 StyleBox["learnable",
  FontWeight->Bold],
 " base metric (depends on parameters ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Theta]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\theta", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "26bf6481-98b9-41ee-84af-11cbba409e59"],
 ")"
}], "Item",ExpressionUUID->"471028a0-d70c-454b-99d6-97605892f33f"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["l", "TI"], 
          StyleBox["i", "TI"]], "\[LongEqual]", 
         SubscriptBox["\[PartialD]", 
          StyleBox["i", "TI"]], 
         StyleBox["L", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "l_i = \\partial_i L", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ef591cad-490b-4d5f-9cdb-fece50dcdc14"],
 " is the gradient of the loss function"
}], "Item",ExpressionUUID->"da9f8c57-f1b1-4531-be13-64f21076cdff"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["H", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"]}]], "\[LongEqual]", 
         SubscriptBox["\[PartialD]", 
          StyleBox["i", "TI"]], 
         SubscriptBox["\[PartialD]", 
          StyleBox["j", "TI"]], 
         StyleBox["L", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "H_{ij} = \\partial_i \\partial_j L", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "57610614-931b-4e7c-b640-07a23be6f4c2"],
 " is the Euclidean Hessian"
}], "Item",ExpressionUUID->"42127bb5-476e-4b66-9692-d1b3f5f32f7d"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Xi]", ">", "0"}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\xi > 0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "deaa0517-0047-4f4a-bc42-ce9a113914db"],
 " is a scalar hyperparameter"
}], "Item",ExpressionUUID->"11e50230-fd82-48e1-a1e7-8e65fb48f5d7"],

Cell[TextData[{
 "When ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Gamma]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\gamma", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "30407ecf-0c80-4ea5-8668-3a72ca5745c0"],
 " is ",
 StyleBox["constant",
  FontWeight->Bold],
 ": ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubsuperscriptBox["\[CapitalGamma]", 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"]}], 
          StyleBox["k", "TI"]], 
         RowBox[{"(", "\[Gamma]", ")"}], "\[LongEqual]", "0"}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\Gamma^k_{ij}(\\gamma) = 0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ccc8e586-9c2f-465e-97e4-b55d65d80e3c"],
 " and the Riemannian Hessian reduces to ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["H", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"]}]], "/", 
         RowBox[{"(", 
           
           RowBox[{"1", "+", "\[Xi]", 
             "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", 
             StyleBox["l", "TI"], 
             SubsuperscriptBox[
             "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", 
              "\[Gamma]", "2"]}], ")"}]}], TraditionalForm], "errors" -> {}, 
     "input" -> "H_{ij} / (1 + \\xi |l|_\\gamma^2)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "7efa4ef6-0acc-4bf9-8f5c-5ac9d94f4679"],
 ", which is just a scalar rescaling of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["H", "TI"], TraditionalForm], "errors" -> {}, "input" -> "H", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "40c13f6c-8c17-47c3-9971-c9fb0ea124d2"],
 ". Eigenvalue signs are preserved \[LongDash] no curvature correction.",
 StyleBox["Question:",
  FontWeight->Bold],
 " When ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Gamma]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\gamma", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "930adedc-bf18-4db1-9c83-cabb78b32b98"],
 " depends on ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Theta]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\theta", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "8351dfc4-0678-4014-ab23-8b86084c0ab1"],
 ", do the extra Christoffel terms break this proportionality? "
}], "Text",ExpressionUUID->"fd9045e0-f24b-4fee-aa01-68674b4878f9"],

