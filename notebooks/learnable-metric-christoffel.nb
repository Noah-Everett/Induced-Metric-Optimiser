    "Print", "[", "\"\<- Diagonal \[Gamma]: ALWAYS flips signs (even more \
robust)\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<- All eigenvalues decrease as \[Xi] increases \
(stronger regularization)\>\"", "]"}], ";"}]}]}]], "Input",ExpressionUUID->\
"9ba455cf-a21a-4835-886d-b0e442a18a84"],

Cell["7.3 Scalar Case Cannot Fix Pure Saddle", "Subsection",ExpressionUUID->"11010db8-18cb-4486-84e8-f593acb97dc6"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Scan", " ", "over", " ", "all", " ", "possible", " ", 
     RowBox[{"\[Del]", "s"}], " ", "for", " ", "L"}], " ", "=", " ", 
    RowBox[{"x\.b2", "-", "y\.b2"}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<=== IMPOSSIBILITY: Scalar case cannot fix pure saddle \
===\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<L = x\.b2-y\.b2 at (1,1): H = diag(2,-2), Tr(H) = \
0\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"lPureSaddle", "=", 
     RowBox[{"{", 
      RowBox[{"2", ",", 
       RowBox[{"-", "2"}]}], "}"}]}], ";"}], "  ", 
   RowBox[{"(*", " ", 
    RowBox[{"gradient", " ", "at", " ", 
     RowBox[{"(", 
      RowBox[{"1", ",", "1"}], ")"}]}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"hPureSaddle", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"2", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", 
         RowBox[{"-", "2"}]}], "}"}]}], "}"}]}], ";"}], "\[IndentingNewLine]",
    "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"minEigs", "=", 
     RowBox[{"Table", "[", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"corr", ",", "hmc"}], "}"}], ",", "\[IndentingNewLine]", 
         "    ", 
         RowBox[{
          RowBox[{"corr", "=", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"1", "/", "2"}], ")"}], "*", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"Outer", "[", 
               RowBox[{"Times", ",", 
                RowBox[{"{", 
                 RowBox[{"sx", ",", "sy"}], "}"}], ",", "lPureSaddle"}], 
               "]"}], "+", 
              RowBox[{"Outer", "[", 
               RowBox[{"Times", ",", "lPureSaddle", ",", 
                RowBox[{"{", 
                 RowBox[{"sx", ",", "sy"}], "}"}]}], "]"}], "-", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"sx", ",", "sy"}], "}"}], " ", ".", " ", 
                 "lPureSaddle"}], ")"}], "*", 
               RowBox[{"IdentityMatrix", "[", "2", "]"}]}]}], ")"}]}]}], ";", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"hmc", "=", 
           RowBox[{"hPureSaddle", "-", "corr"}]}], ";", "\[IndentingNewLine]",
           "    ", 
          RowBox[{"Min", "[", 
           RowBox[{"Eigenvalues", "[", 
            RowBox[{"N", "[", "hmc", "]"}], "]"}], "]"}]}]}], 
        "\[IndentingNewLine]", "  ", "]"}], ",", "\[IndentingNewLine]", "  ", 
       
       RowBox[{"{", 
        RowBox[{"sx", ",", 
         RowBox[{"-", "3"}], ",", "3", ",", "0.5"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"sy", ",", 
         RowBox[{"-", "3"}], ",", "3", ",", "0.5"}], "}"}]}], 
      "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Maximum of min(eigenvalue(H-C)) over all \[Del]s \[Element] \
[-3,3]\.b2: \>\"", ",", 
      RowBox[{"Max", "[", 
       RowBox[{"Flatten", "[", "minEigs", "]"}], "]"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<This is \[LessEqual] 0 everywhere \[LongDash] sign \
flip is IMPOSSIBLE for scalar case when Tr(H)=0\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<The maximum is achieved at \[Del]s \[Proportional] (1, \
1), where H-C becomes the zero matrix.\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<This is a THEORETICAL BARRIER, not just a numerical \
limitation.\>\"", "]"}], ";"}]}]}]], "Input",ExpressionUUID->"4075ef15-00af-\
45dc-b6d3-69363d0bf7ef"],

Cell["7.4 Diagonal Case: Mechanism Explained", "Subsection",ExpressionUUID->"6eb7aea9-b1d2-4296-804e-4a9f35115aca"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Show", " ", "how", " ", "the", " ", "non"}], "-", 
    RowBox[{"traceless", " ", "correction", " ", "works"}]}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<=== MECHANISM: How the diagonal metric fixes pure \
saddles ===\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<L = x\.b2-y\.b2 at (1,1): H = diag(2,-2), l = (2,-2)\>\
\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<\[Gamma] = diag(e^{-x}, e^{3y}), so at (1,1):\>\"", 
     "]"}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"gamPS", "=", 
     RowBox[{"DiagonalMatrix", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Exp", "[", 
         RowBox[{"-", "1."}], "]"}], ",", 
        RowBox[{"Exp", "[", "3.", "]"}]}], "}"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"gamPSInv", "=", 
     RowBox[{"Inverse", "[", "gamPS", "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"lPS", "=", 
     RowBox[{"{", 
      RowBox[{"2.", ",", 
       RowBox[{"-", "2."}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"hPS", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"2.", ",", "0."}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0.", ",", 
         RowBox[{"-", "2."}]}], "}"}]}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Christoffel", " ", "symbols", " ", "of", " ", "\[Gamma]", " ", "at", " ",
      "this", " ", "point"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"\[Del]", "s1"}], " ", "=", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "1"}], ",", " ", "0"}], ")"}]}], ",", " ", 
     RowBox[{
      RowBox[{"\[Del]", "s2"}], " ", "=", " ", 
      RowBox[{"(", 
       RowBox[{"0", ",", " ", "3"}], ")"}]}]}], " ", "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"\[CapitalGamma]", "^", "1"}], "_", 
       RowBox[{"{", "11", "}"}]}], " ", "=", " ", 
      RowBox[{
       RowBox[{"-", "1"}], "/", "2"}]}], ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"\[CapitalGamma]", "^", "1"}], "_", 
       RowBox[{"{", "12", "}"}]}], " ", "=", " ", "0"}], ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"\[CapitalGamma]", "^", "1"}], "_", 
       RowBox[{"{", "22", "}"}]}], " ", "=", " ", "0"}]}], " ", "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"\[CapitalGamma]", "^", "2"}], "_", 
       RowBox[{"{", "11", "}"}]}], " ", "=", " ", "0"}], ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"\[CapitalGamma]", "^", "2"}], "_", 
       RowBox[{"{", "12", "}"}]}], " ", "=", " ", "0"}], ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"\[CapitalGamma]", "^", "2"}], "_", 
       RowBox[{"{", "22", "}"}]}], " ", "=", " ", 
      RowBox[{"3", "/", "2"}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"Plus", " ", "cross", " ", "terms", " ", "with", " ", 
      RowBox[{"e", "^", 
       RowBox[{"{", 
        RowBox[{"s1", "-", "s2"}], "}"}]}]}], " ", "=", " ", 
     RowBox[{"e", "^", 
      RowBox[{"{", 
       RowBox[{"-", "4"}], "}"}]}]}], " ", "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"christPS", "=", 
     RowBox[{"Table", "[", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"gamPSInv", "[", 
           RowBox[{"[", 
            RowBox[{"k", ",", "ll"}], "]"}], "]"}], "*", 
          RowBox[{"(", 
           RowBox[{"1", "/", "2"}], ")"}], "*", 
          RowBox[{"(", "\[IndentingNewLine]", "    ", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{"D", "[", 
                 RowBox[{
                  RowBox[{"DiagonalMatrix", "[", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"Exp", "[", 
                    RowBox[{"-", "x"}], "]"}], ",", 
                    RowBox[{"Exp", "[", 
                    RowBox[{"3", " ", "y"}], "]"}]}], "}"}], "]"}], ",", 
                  RowBox[{"coords", "[", 
                   RowBox[{"[", "i", "]"}], "]"}]}], "]"}], "[", 
                RowBox[{"[", 
                 RowBox[{"j", ",", "ll"}], "]"}], "]"}], "+", 
               "\[IndentingNewLine]", "     ", 
               RowBox[{
                RowBox[{"D", "[", 
                 RowBox[{
                  RowBox[{"DiagonalMatrix", "[", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"Exp", "[", 
                    RowBox[{"-", "x"}], "]"}], ",", 
                    RowBox[{"Exp", "[", 
                    RowBox[{"3", " ", "y"}], "]"}]}], "}"}], "]"}], ",", 
                  RowBox[{"coords", "[", 
                   RowBox[{"[", "j", "]"}], "]"}]}], "]"}], "[", 
                RowBox[{"[", 
                 RowBox[{"i", ",", "ll"}], "]"}], "]"}], "-", 
               "\[IndentingNewLine]", "     ", 
               RowBox[{
                RowBox[{"D", "[", 
                 RowBox[{
                  RowBox[{"DiagonalMatrix", "[", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"Exp", "[", 
                    RowBox[{"-", "x"}], "]"}], ",", 
                    RowBox[{"Exp", "[", 
                    RowBox[{"3", " ", "y"}], "]"}]}], "}"}], "]"}], ",", 
                  RowBox[{"coords", "[", 
                   RowBox[{"[", "ll", "]"}], "]"}]}], "]"}], "[", 
                RowBox[{"[", 
                 RowBox[{"i", ",", "j"}], "]"}], "]"}]}], ")"}], " ", "/.", 
             " ", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"x", "->", "1"}], ",", 
               RowBox[{"y", "->", "1"}]}], "}"}]}], " ", "//", " ", "N"}], 
           "\[IndentingNewLine]", "  ", ")"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"ll", ",", "1", ",", "2"}], "}"}]}], "]"}], ",", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"{", 
        RowBox[{"k", ",", "1", ",", "2"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", "2"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "1", ",", "2"}], "}"}]}], "\[IndentingNewLine]", 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"corrPS", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"christPS", "[", 
           RowBox[{"[", 
            RowBox[{"k", ",", "i", ",", "j"}], "]"}], "]"}], "*", 
          RowBox[{"lPS", "[", 
           RowBox[{"[", "k", "]"}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", "1", ",", "2"}], "}"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", "2"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "1", ",", "2"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"alphaPS", "=", 
     RowBox[{"1", "+", 
      RowBox[{"1.", "*", 
       RowBox[{"lPS", " ", ".", " ", "gamPSInv", " ", ".", " ", "lPS"}]}]}]}],
     ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<  \[Gamma] = \>\"", ",", 
      RowBox[{"gamPS", " ", "//", " ", "MatrixForm"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<  Correction C = \>\"", ",", 
      RowBox[{"corrPS", " ", "//", " ", "MatrixForm"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<  Tr(C) = \>\"", ",", 
      RowBox[{"Tr", "[", "corrPS", "]"}], 
      ",", "\"\<  \[LeftArrow] NON-ZERO! (this is the key)\>\""}], "]"}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<  H - C = \>\"", ",", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"hPS", "-", "corrPS"}], ")"}], " ", "//", " ", 
       "MatrixForm"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<  eigenvalues(H - C) = \>\"", ",", 
      RowBox[{"Sort", "[", 
       RowBox[{"Eigenvalues", "[", 
        RowBox[{"hPS", "-", "corrPS"}], "]"}], "]"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<  \[Alpha] = \>\"", ",", "alphaPS"}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<  Hess_g = (H-C)/\[Alpha]:  eigenvalues = \>\"", ",", 
      RowBox[{"Sort", "[", 
       RowBox[{"Eigenvalues", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"hPS", "-", "corrPS"}], ")"}], "/", "alphaPS"}], "]"}], 
       "]"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<The non-zero trace Tr(C) = \>\"", ",", 
      RowBox[{"Tr", "[", "corrPS", "]"}], 
      ",", "\"\< shifts the eigenvalue sum\>\""}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<from Tr(H) = 0 to Tr(H-C) = \>\"", ",", 
      RowBox[{"Tr", "[", 
       RowBox[{"hPS", "-", "corrPS"}], "]"}], ",", "\"\< > 0\>\""}], "]"}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<This makes both eigenvalues positive possible!\>\"", 
     "]"}], ";"}]}]}]], "Input",ExpressionUUID->"5236408d-b01c-4596-b66f-\
7483df6117ab"],

