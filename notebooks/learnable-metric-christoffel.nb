     RowBox[{"\[Xi]", " ", "H_", 
      RowBox[{
       RowBox[{"{", "ij", "}"}], " ", "\[CenterDot]", " ", 
       RowBox[{
        RowBox[{"l", "^", "k"}], "/", "\[Alpha]"}]}]}]}]}], " ", "*)"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
