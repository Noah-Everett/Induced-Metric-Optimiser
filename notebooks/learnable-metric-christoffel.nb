         RowBox[{"{", "ij", "}"}], 
         RowBox[{"(", "\[Gamma]", ")"}], " ", "l_m"}]}], ")"}]}]}]}], " ", 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
