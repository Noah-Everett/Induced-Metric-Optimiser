      RowBox[{"(", "\[Gamma]", ")"}], " ", "l_k"}], " ", "-", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"\[Xi]", "||", "l", "||", 
        RowBox[{"\.b2_\[Gamma]", "/", "\[Alpha]"}]}], ")"}], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"H_", 
         RowBox[{"{", "ij", "}"}]}], " ", "-", " ", 
        RowBox[{
