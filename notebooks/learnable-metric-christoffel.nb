Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"For", " ", "H"}], " ", "=", " ", 
    RowBox[{
     RowBox[{"diag", 
      RowBox[{"(", 
       RowBox[{"\[Lambda]\:208a", ",", " ", "\[Lambda]\:208b"}], ")"}], " ", 
      "with", " ", "\[Lambda]\:208a"}], " ", ">", " ", "0", " ", ">", " ", 
     RowBox[{"\[Lambda]\:208b", ":"}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"H", " ", "-", " ", 
     RowBox[{"C", " ", 
      RowBox[{"pos", ".", " ", "def", ".", " ", "requires"}], " ", "Tr", 
      RowBox[{"(", 
       RowBox[{"H", "-", "C"}], ")"}]}]}], " ", ">", " ", 
    RowBox[{"0", " ", "and", " ", "det", 
     RowBox[{"(", 
      RowBox[{"H", "-", "C"}], ")"}]}], " ", ">", " ", "0"}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Tr", 
     RowBox[{"(", 
      RowBox[{"H", "-", "C"}], ")"}]}], " ", "=", " ", 
    RowBox[{
     RowBox[{"Tr", 
      RowBox[{"(", "H", ")"}]}], " ", "=", " ", 
     RowBox[{"\[Lambda]\:208a", " ", "+", " ", 
      RowBox[{"\[Lambda]\:208b", " ", 
       RowBox[{"(", 
        RowBox[{"since", " ", "C", " ", "is", " ", "traceless"}], 
        ")"}]}]}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Need", " ", "\[Lambda]\:208a"}], " ", "+", " ", 
     "\[Lambda]\:208b"}], " ", ">", " ", 
    RowBox[{"0", " ", 
     RowBox[{"(", 
      RowBox[{"positive", " ", "Laplacian"}], ")"}]}]}], " ", "*)"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"At", " ", "optimal", " ", 
     RowBox[{"\[Del]", 
      RowBox[{"s", ":", " ", "C"}]}]}], " ", "=", " ", 
    RowBox[{"diag", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"\[Lambda]\:208a", "-", "\[Lambda]\:208b"}], ")"}], "/", 
        "2"}], ",", " ", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"(", 
          RowBox[{"\[Lambda]\:208a", "-", "\[Lambda]\:208b"}], ")"}]}], "/", 
        "2"}]}], ")"}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"H", " ", "-", " ", "C"}], " ", "=", " ", 
    RowBox[{
     RowBox[{"diag", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"\[Lambda]\:208a", " ", "-", " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"\[Lambda]\:208a", "-", "\[Lambda]\:208b"}], ")"}], "/", 
          "2"}]}], ",", " ", 
        RowBox[{"\[Lambda]\:208b", " ", "+", " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"\[Lambda]\:208a", "-", "\[Lambda]\:208b"}], ")"}], "/", 
          "2"}]}]}], ")"}]}], " ", "=", " ", 
     RowBox[{"diag", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"\[Lambda]\:208a", "+", "\[Lambda]\:208b"}], ")"}], "/", 
         "2"}], ",", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"\[Lambda]\:208a", "+", "\[Lambda]\:208b"}], ")"}], "/", 
         "2"}]}], ")"}]}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"Both", " ", "eigenvalues", " ", "equal", " ", "Tr", 
    RowBox[{
     RowBox[{"(", "H", ")"}], "/", 
     RowBox[{"2", "!"}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"The", " ", "optimal", " ", 
    RowBox[{"\[Del]", "s"}], " ", 
    RowBox[{"satisfies", ":"}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"sx", " ", "ly"}], " ", "+", " ", 
     RowBox[{"sy", " ", "lx"}]}], " ", "=", " ", 
    RowBox[{"0", " ", 
     RowBox[{"(", 
      RowBox[{"makes", " ", "C", " ", "diagonal"}], ")"}]}]}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"sx", " ", "lx"}], " ", "-", " ", 
     RowBox[{"sy", " ", "ly"}]}], " ", "=", " ", 
    RowBox[{"\[Lambda]\:208a", " ", "-", " ", 
     RowBox[{"\[Lambda]\:208b", " ", 
      RowBox[{"(", 
       RowBox[{"sets", " ", "C_", 
        RowBox[{"{", "11", "}"}], " ", "to", " ", "optimal", " ", "value"}], 
       ")"}]}]}]}], " ", "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<OPTIMAL \[Del]s for convexification:\>\"", "]"}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<For H = diag(\[Lambda]\:208a, \[Lambda]\:208b) with \
\[Lambda]\:208a > 0 > \[Lambda]\:208b:\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<The optimal \[Del]s satisfies:\>\"", "]"}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<  s_x l_y + s_y l_x = 0     (diagonalizes C)\>\"", 
     "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<  s_x l_x - s_y l_y = \[Lambda]\:208a - \
\[Lambda]\:208b  (optimal magnitude)\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<At the optimum: H - C = (Tr(H)/2) \[CenterDot] I\>\"", 
     "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Both eigenvalues become Tr(H)/(2\[Alpha])\>\"", "]"}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<EXAMPLE: L = 3x\.b2-y\.b2 at (1,1):\>\"", "]"}], ";"}],
    "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<  H = diag(6, -2), l = (6, -2), Tr(H) = 4\>\"", "]"}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<  Optimal: s_x = 6/5, s_y = 2/5\>\"", "]"}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<  H - C = diag(2, 2) \[RightArrow] Hess_g eigenvalues \
= {2/\[Alpha], 2/\[Alpha]}\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", "Verify", " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{"Clear", "[", "\"\<Global`*\>\"", "]"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"coords", "=", 
     RowBox[{"{", 
      RowBox[{"x", ",", "y"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"pt", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"x", "->", "1"}], ",", 
       RowBox[{"y", "->", "1"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"hOpt", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"6", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", 
         RowBox[{"-", "2"}]}], "}"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"lOpt", "=", 
     RowBox[{"{", 
      RowBox[{"6", ",", 
       RowBox[{"-", "2"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"sGradOpt", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"6", "/", "5"}], ",", 
       RowBox[{"2", "/", "5"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"corrOpt", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "/", "2"}], ")"}], "*", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Outer", "[", 
         RowBox[{"Times", ",", "sGradOpt", ",", "lOpt"}], "]"}], "+", 
        RowBox[{"Outer", "[", 
         RowBox[{"Times", ",", "lOpt", ",", "sGradOpt"}], "]"}], "-", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"sGradOpt", " ", ".", " ", "lOpt"}], ")"}], "*", 
         RowBox[{"IdentityMatrix", "[", "2", "]"}]}]}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<C_opt = \>\"", ",", 
      RowBox[{"corrOpt", " ", "//", " ", "MatrixForm"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<H - C_opt = \>\"", ",", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"hOpt", "-", "corrOpt"}], ")"}], " ", "//", " ", 
       "MatrixForm"}], 
      ",", "\"\<  \[LeftArrow] proportional to I \[Checkmark]\>\""}], "]"}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<eigenvalues(H - C_opt) = \>\"", ",", 
      RowBox[{"Eigenvalues", "[", 
       RowBox[{"hOpt", "-", "corrOpt"}], "]"}]}], "]"}], ";"}]}]}]], "Input",E\
xpressionUUID->"b2be8fd2-b0ac-4d1f-8031-291e86227d39"],

