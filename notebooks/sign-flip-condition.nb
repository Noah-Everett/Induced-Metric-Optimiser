Cell["7d. Phase diagram", "Subsection",ExpressionUUID->"871d892e-7d94-4768-b3bf-f2ec62853f16"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"For", " ", "a", " ", "saddle", " ", "L"}], " ", "=", " ", 
     RowBox[{
      RowBox[{"x", "^", "2"}], " ", "-", " ", 
      RowBox[{"y", "^", "2"}]}]}], ",", " ", 
    RowBox[{
    "classify", " ", "behavior", " ", "at", " ", "each", " ", "r", " ", 
     "value"}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"rTestValues", "=", 
     RowBox[{"Range", "[", 
      RowBox[{"0.01", ",", "0.5", ",", "0.01"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Phase diagram for saddle direction:\>\"", "]"}], ";"}],
    "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"Grid", "[", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"Prepend", "[", "\[IndentingNewLine]", "    ", 
        RowBox[{
         RowBox[{"Table", "[", "\[IndentingNewLine]", "      ", 
          RowBox[{
           RowBox[{"Module", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"sEq", ",", "phiVal", ",", "phase"}], "}"}], ",", 
             "\[IndentingNewLine]", "        ", 
             RowBox[{
              RowBox[{"sEq", "=", 
               RowBox[{"s", " ", "/.", " ", 
                RowBox[{"FindRoot", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"s", " ", 
                    RowBox[{"Exp", "[", 
                    RowBox[{"-", "s"}], "]"}]}], "==", "r"}], ",", 
                  RowBox[{"{", 
                   RowBox[{"s", ",", "0.5"}], "}"}]}], "]"}]}]}], ";", 
              "\[IndentingNewLine]", "        ", 
              RowBox[{"phiVal", "=", 
               RowBox[{"phi", "[", "sEq", "]"}]}], ";", "\[IndentingNewLine]",
               "        ", 
              RowBox[{"phase", "=", 
               RowBox[{"Which", "[", "\[IndentingNewLine]", "          ", 
                RowBox[{
                 RowBox[{"sEq", "<", "0.5"}], 
                 ",", "\"\<Normal (repulsion)\>\"", ",", 
                 "\[IndentingNewLine]", "          ", 
                 RowBox[{"sEq", "<", "1"}], 
                 ",", "\"\<SIGN FLIP (attraction)\>\"", ",", 
                 "\[IndentingNewLine]", "          ", "True", 
                 ",", "\"\<Unstable\>\""}], "\[IndentingNewLine]", "        ",
                 "]"}]}], ";", "\[IndentingNewLine]", "        ", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"Round", "[", 
                 RowBox[{"r", ",", "0.01"}], "]"}], ",", 
                RowBox[{"Round", "[", 
                 RowBox[{"sEq", ",", "0.001"}], "]"}], ",", 
                RowBox[{"Round", "[", 
                 RowBox[{"phiVal", ",", "0.001"}], "]"}], ",", "phase"}], 
               "}"}]}]}], "\[IndentingNewLine]", "      ", "]"}], ",", 
           "\[IndentingNewLine]", "      ", 
           RowBox[{"{", 
            RowBox[{"r", ",", 
             RowBox[{"{", 
              RowBox[{"0.1", ",", "0.2", ",", "0.3", ",", 
               RowBox[{
                RowBox[{"rOfS", "[", 
                 RowBox[{"1", "/", "2"}], "]"}], " ", "//", " ", "N"}], ",", 
               "0.35", ",", 
               RowBox[{
                RowBox[{"rOfS", "[", "1", "]"}], " ", "//", " ", "N"}]}], 
              "}"}]}], "}"}]}], "\[IndentingNewLine]", "    ", "]"}], ",", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"{", 
          
          RowBox[{"\"\<r\>\"", ",", "\"\<s*\>\"", ",", "\"\<\[Phi](s*)\>\"", 
           ",", "\"\<Phase\>\""}], "}"}]}], "\[IndentingNewLine]", "  ", 
        "]"}], ",", "\[IndentingNewLine]", "  ", 
       RowBox[{"Frame", "->", "All"}]}], "\[IndentingNewLine]", "]"}], "]"}], 
    ";"}]}]}]], "Input",ExpressionUUID->"82f594a4-8859-4cdc-8421-\
4a913e3081b0"],

Cell["Summary", "Section",ExpressionUUID->"bba85a15-15c3-486d-9476-5167485fbfd8"],

Cell["All verifications pass: ", "Text",ExpressionUUID->"eaba9d17-56d7-4307-8394-8f3fa49af34c"],

Cell[BoxData[
 PaneBox[
  PaneBox[
   StyleBox[
    TagBox[
     TagBox[GridBox[{
        {
         TagBox["\<\"Check\"\>",
          HoldForm], 
         TagBox["\<\"Result\"\>",
          HoldForm]},
        {"\<\"1. Christoffel symbols\"\>", Cell[TextData[{
          "All 8 computed; proportional to spatial gradients of ",
          Cell[BoxData[
           FormBox[
            TemplateBox[<|"boxes" -> FormBox[
                StyleBox["s", "TI"], TraditionalForm], "errors" -> {}, 
              "input" -> "s", "state" -> "Boxes"|>,
             "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
           "33a51629-ac9b-470c-ad44-420e2541dfbd"]
         }],ExpressionUUID->"80e985be-52fd-46e6-a5b0-87256b751aeb"]},
        {Cell[TextData[{
          "2. Curvature correction ",
          Cell[BoxData[
           FormBox[
            TemplateBox[<|"boxes" -> FormBox[
                StyleBox["C", "TI"], TraditionalForm], "errors" -> {}, 
              "input" -> "C", "state" -> "Boxes"|>,
             "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
           "8c9a312b-0de5-4314-ac6c-e6b4aea5529f"]
         }],ExpressionUUID->"3fcab69d-232f-4746-bb80-022faf2383da"], Cell[
         TextData[{
          Cell[BoxData[
           FormBox[
            TemplateBox[<|"boxes" -> FormBox[
                RowBox[{
                  SubscriptBox[
                   StyleBox["C", "TI"], 
                   RowBox[{
                    StyleBox["i", "TI"], 
                    StyleBox["j", "TI"]}]], "\[LongEqual]", 
                  UnderscriptBox["\[Sum]", 
                   StyleBox["k", "TI"], LimitsPositioning -> True], 
                  SubsuperscriptBox["\[CapitalGamma]", 
                   RowBox[{
                    StyleBox["i", "TI"], 
                    StyleBox["j", "TI"]}], 
                   StyleBox["k", "TI"]], 
                  SubscriptBox[
                   StyleBox["g", "TI"], 
                   StyleBox["k", "TI"]]}], TraditionalForm], "errors" -> {}, 
              "input" -> "C_{ij} = \\sum_k \\Gamma^k_{ij} g_k", "state" -> 
              "Boxes"|>,
             "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
           "6e2beb2e-1668-4d8f-9619-34ad9b925148"],
          " computed symbolically"
         }],ExpressionUUID->"6e6113d8-fd86-4b63-aa69-4086385d8d87"]},
        {"\<\"3. Sign-flip on saddle\"\>", Cell[TextData[{
          Cell[BoxData[
           FormBox[
            TemplateBox[<|"boxes" -> FormBox[
                RowBox[{
                  StyleBox["H", "TI"], "-", 
                  StyleBox["C", "TI"]}], TraditionalForm], "errors" -> {}, 
              "input" -> "H - C", "state" -> "Boxes"|>,
             "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
           "2265e10b-628b-4c06-a91a-fe0e07a91285"],
          " diagonal when off-diagonal spatial gradients vanish"
         }],ExpressionUUID->"ec61ba4f-c478-457e-9b48-8f3f3bed5244"]},
        {Cell[TextData[{
          "4. Eigenvalue multiplier ",
          Cell[BoxData[
           FormBox[
            TemplateBox[<|"boxes" -> FormBox[
                RowBox[{"\[CurlyPhi]", "(", 
                  StyleBox["s", "TI"], ")"}], TraditionalForm], 
              "errors" -> {}, "input" -> "\\varphi(s)", "state" -> "Boxes"|>,
             "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
           "bf428109-4492-4c3b-bbbb-419c6e28bb15"]
         }],ExpressionUUID->"6bde4007-8369-459d-b178-ad135ca55676"], Cell[
         TextData[{
          "Zero at ",
          Cell[BoxData[
           FormBox[
            TemplateBox[<|"boxes" -> FormBox[
                RowBox[{
                  StyleBox["s", "TI"], "\[LongEqual]", "1", "/", "2"}], 
                TraditionalForm], "errors" -> {}, "input" -> "s = 1/2", 
              "state" -> "Boxes"|>,
             "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
           "65c80126-45c3-47f2-8687-b09db964bf8c"],
          ", sign-flip zone ",
          Cell[BoxData[
           FormBox[
            TemplateBox[<|"boxes" -> FormBox[
                RowBox[{
                  StyleBox["s", "TI"], "\[Element]", 
                  RowBox[{"(", 
                    RowBox[{"1", "/", "2", ",", "1"}], ")"}]}], 
                TraditionalForm], "errors" -> {}, "input" -> 
              "s \\in (1/2, 1)", "state" -> "Boxes"|>,
             "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
           "f06d39fd-8fae-4660-89a2-dbd1c354422b"]
         }],ExpressionUUID->"00639eca-87c4-4d89-a39b-5af8324190c4"]},
        {"\<\"5. Equilibrium analysis\"\>", Cell[TextData[{
          Cell[BoxData[
           FormBox[
            TemplateBox[<|"boxes" -> FormBox[
                SubsuperscriptBox[
                 StyleBox["s", "TI"], 
                 StyleBox["i", "TI"], "*"], TraditionalForm], "errors" -> {}, 
              "input" -> "s_i^*", "state" -> "Boxes"|>,
             "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
           "c4565e7c-050a-4037-b9a8-4d45bd5980e0"],
          " found via implicit equation; spatial gradients by IFT"
         }],ExpressionUUID->"8286af64-9668-4c26-abe8-e5e75199d597"]},
        {"\<\"6. F1 probe verification\"\>", Cell[TextData[{
          "Eigenvalues of ",
          Cell[BoxData[
           FormBox[
            TemplateBox[<|"boxes" -> FormBox[
                RowBox[{
                  StyleBox["H", "TI"], "-", 
                  StyleBox["C", "TI"], "\[LongEqual]", 
                  RowBox[{"{", 
                    RowBox[{"2", ",", "0"}], "}"}]}], TraditionalForm], 
              "errors" -> {}, "input" -> "H - C = \\{2, 0\\}", "state" -> 
              "Boxes"|>,
             "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
           "f641c955-05a5-4a55-ab80-14279652582f"],
          " at ",
          Cell[BoxData[
           FormBox[
            TemplateBox[<|"boxes" -> FormBox[
                RowBox[{
                  SubscriptBox["\[PartialD]", "2"], 
                  SubscriptBox[
                   StyleBox["s", "TI"], "2"], "\[LongEqual]", "4"}], 
                TraditionalForm], "errors" -> {}, "input" -> 
              "\\partial_2 s_2 = 4", "state" -> "Boxes"|>,
             "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
           "ef68705b-92c4-4119-be07-0c50e38d4bea"]
         }],ExpressionUUID->"db5b5903-ce50-46dd-b218-fa0724d359e2"]},
        {"\<\"7. The 21% window\"\>", Cell[TextData[{
          "Sign-flip zone ",
          Cell[BoxData[
           FormBox[
            TemplateBox[<|"boxes" -> FormBox[
                RowBox[{
                  StyleBox["r", "TI"], "\[Element]", 
                  RowBox[{"(", 
                    RowBox[{"1", "/", 
                    StyleBox["e", "TI"], ", ", "1", "/", 
                    RowBox[{"(", 
                    RowBox[{"2", 
                    SqrtBox[
                    StyleBox["e", "TI"]]}], ")"}]}], ")"}]}], 
                TraditionalForm], "errors" -> {}, "input" -> 
              "r \\in (1/e,\\, 1/(2\\sqrt{e}))", "state" -> "Boxes"|>,
             "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
           "fa9a1bab-ae9f-4d0b-bbee-7c4d982a6299"],
          " verified"
         }],ExpressionUUID->"882527e7-efd7-4032-9b3f-0511c7b11a01"]}
       },
