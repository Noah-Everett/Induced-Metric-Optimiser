              RowBox[{"1", "/", "2"}], "]"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"3", ",", 
             RowBox[{"rOfS", "[", 
              RowBox[{"1", "/", "2"}], "]"}]}], "}"}]}], "}"}], "]"}]}], 
       "}"}], ",", "\[IndentingNewLine]", "    ", 
      RowBox[{"{", 
       RowBox[{"Blue", ",", "Dashed", ",", 
        RowBox[{"Line", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", 
             RowBox[{"rOfS", "[", "1", "]"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"3", ",", 
             RowBox[{"rOfS", "[", "1", "]"}]}], "}"}]}], "}"}], "]"}]}], 
       "}"}], ",", "\[IndentingNewLine]", "    ", 
      RowBox[{"Text", "[", 
       RowBox[{"\"\<s = 1/2\>\"", ",", 
        RowBox[{"{", 
         RowBox[{"0.5", ",", "0.42"}], "}"}]}], "]"}], ",", 
      "\[IndentingNewLine]", "    ", 
      RowBox[{"Text", "[", 
       RowBox[{"\"\<s = 1\>\"", ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "0.42"}], "}"}]}], "]"}], ",", 
      "\[IndentingNewLine]", "    ", 
      RowBox[{"Text", "[", 
       RowBox[{
        RowBox[{"Row", "[", 
         RowBox[{"{", 
          RowBox[{"\"\<r = \>\"", ",", 
           RowBox[{"Round", "[", 
            RowBox[{
             RowBox[{"rOfS", "[", 
              RowBox[{"1", "/", "2"}], "]"}], ",", "0.001"}], "]"}]}], "}"}], 
         "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"2.5", ",", 
          RowBox[{
           RowBox[{"rOfS", "[", 
            RowBox[{"1", "/", "2"}], "]"}], "+", "0.015"}]}], "}"}]}], "]"}], 
      ",", "\[IndentingNewLine]", "    ", 
