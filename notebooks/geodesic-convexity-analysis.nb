   RowBox[{"g", " ", ".", " ", "gInv"}], "]"}], "==", 
  RowBox[{"IdentityMatrix", "[", "2", "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"(*", " ", "True", " ", "*)"}]}]}], "Input",ExpressionUUID->\
"70c63db9-defe-45e2-822a-628f3abf3cd8"],

Cell["Bracket identity", "Subsection",ExpressionUUID->"7b15b12c-3354-43c4-9b3d-0b4ee4220533"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"dg", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"xi", "*", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"hess", "[", 
          RowBox[{"[", 
           RowBox[{"k", ",", "i"}], "]"}], "]"}], "*", 
         RowBox[{"l", "[", 
          RowBox[{"[", "j", "]"}], "]"}]}], "+", 
        RowBox[{
         RowBox[{"l", "[", 
          RowBox[{"[", "i", "]"}], "]"}], "*", 
         RowBox[{"hess", "[", 
          RowBox[{"[", 
           RowBox[{"k", ",", "j"}], "]"}], "]"}]}]}], ")"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"k", ",", "2"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "2"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "2"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"bracket", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"dg", "[", 
       RowBox[{"[", 
        RowBox[{"i", ",", "j", ",", "ll"}], "]"}], "]"}], "+", 
      RowBox[{"dg", "[", 
       RowBox[{"[", 
        RowBox[{"j", ",", "i", ",", "ll"}], "]"}], "]"}], "-", 
      RowBox[{"dg", "[", 
       RowBox[{"[", 
        RowBox[{"ll", ",", "i", ",", "j"}], "]"}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "2"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "2"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"ll", ",", "2"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"expected", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"2", "*", "xi", "*", 
      RowBox[{"hess", "[", 
       RowBox[{"[", 
        RowBox[{"i", ",", "j"}], "]"}], "]"}], "*", 
      RowBox[{"l", "[", 
       RowBox[{"[", "ll", "]"}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "2"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "2"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"ll", ",", "2"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Simplify", "[", 
  RowBox[{"bracket", "-", "expected"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "0"}], "}"}]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "0"}], "}"}]}], "}"}]}], "}"}], " ", 
    "\[Checkmark]"}], " ", "*)"}]}]}], "Input",ExpressionUUID->"1fd4be99-53c8-\
4fd8-9120-c7bd08ad44df"],

Cell["Christoffel symbols", "Subsection",ExpressionUUID->"cc832a89-bdb5-404d-90e9-8e38ea059c66"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"chris", "=", 
   RowBox[{
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "/", "2"}], ")"}], "*", 
         RowBox[{"gInv", "[", 
          RowBox[{"[", 
           RowBox[{"k", ",", "ll"}], "]"}], "]"}], "*", 
         RowBox[{"bracket", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "j", ",", "ll"}], "]"}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"ll", ",", "2"}], "}"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"k", ",", "2"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "2"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"j", ",", "2"}], "}"}]}], "]"}], " ", "//", " ", 
    "Simplify"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"chrisFormula", "=", 
   RowBox[{
    RowBox[{"Table", "[", 
     RowBox[{
