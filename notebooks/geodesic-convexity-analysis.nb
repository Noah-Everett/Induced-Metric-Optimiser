Cell["The bottom line", "Subsection",ExpressionUUID->"17efc514-eef8-44ba-9aef-a43a946420ba"],

Cell[TextData[{
 "The rank-1 induced metric ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["g", "TI"], "\[LongEqual]", "\[Gamma]", "+", "\[Xi] ", 
         StyleBox["l", "TI"], "\[CircleTimes]", 
         StyleBox["l", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "g = \\gamma + \\xi\\, l \\otimes l", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "be063b14-3616-4df2-bc08-dafb47b3edcd"],
 " provides ",
 StyleBox["adaptive curvature damping",
  FontWeight->Bold],
 " (smooth gradient clipping), not geodesic convexity. It uniformly scales \
all Hessian eigenvalues by ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"1", "/", 
         RowBox[{"(", 
           
           RowBox[{"1", "+", "\[Xi]", 
             "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", "\[Del]", 
             
             StyleBox["L", "TI"], 
             SubsuperscriptBox[
             "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", 
              "\[Gamma]", "2"]}], ")"}]}], TraditionalForm], "errors" -> {}, 
     "input" -> "1/(1 + \\xi|\\nabla L|_\\gamma^2)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "813d57e9-e7f0-498a-ad98-f1d99cbf10ff"],
 ", preserving signs and condition numbers. This explains why the optimiser \
improves stability without needing the loss to be convex."
}], "Text",ExpressionUUID->"6e6e196c-e68e-4ebe-8259-adae0170539e"],

