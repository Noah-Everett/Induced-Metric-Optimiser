Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"loss", "[", 
    RowBox[{"xx_", ",", "yy_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "-", "xx"}], ")"}], "^", "2"}], "+", 
    RowBox[{"100", "*", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"yy", "-", 
