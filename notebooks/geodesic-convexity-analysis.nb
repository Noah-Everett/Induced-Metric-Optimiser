Cell["Setup", "Subsection",ExpressionUUID->"b91beab8-8b41-46a8-ab8d-574225f9a3c9"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"l", "=", 
   RowBox[{"{", 
    RowBox[{"l1", ",", "l2"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"hess", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"H11", ",", "H12"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"H12", ",", "H22"}], "}"}]}], "}"}]}], ";"}], "  ", 
  RowBox[{"(*", " ", 
   RowBox[{"Symmetric", " ", "Hessian", " ", "of", " ", "L"}], " ", 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"gam", "=", 
    RowBox[{"DiagonalMatrix", "[", 
     RowBox[{"{", 
      RowBox[{"g1", ",", "g2"}], "}"}], "]"}]}], ";"}], "   ", 
  RowBox[{"(*", " ", 
   RowBox[{"Diagonal", " ", "base", " ", "metric"}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"xi", "=", 
    RowBox[{"Symbol", "[", "\"\<xi\>\"", "]"}]}], ";"}], "                 ", 
  
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Embedding", " ", "weight"}], ",", " ", 
    RowBox[{"xi", " ", ">", " ", "0"}]}], " ", "*)"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Induced", " ", 
     RowBox[{"metric", ":", " ", "g"}]}], " ", "=", " ", 
    RowBox[{"\[Gamma]", " ", "+", " ", 
     RowBox[{"\[Xi]", " ", 
      RowBox[{"l", "\[CircleTimes]", "l"}]}]}]}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"g", "=", 
    RowBox[{"gam", "+", 
     RowBox[{"xi", "*", 
      RowBox[{"Outer", "[", 
       RowBox[{"Times", ",", "l", ",", "l"}], "]"}]}]}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Inverse", " ", "metric", " ", "via", " ", "Sherman"}], "-", 
    "Morrison"}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"gamInv", "=", 
   RowBox[{"DiagonalMatrix", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"1", "/", "g1"}], ",", 
      RowBox[{"1", "/", "g2"}]}], "}"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"lUp", "=", 
    RowBox[{"gamInv", " ", ".", " ", "l"}]}], ";"}], "                  ", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Raised", " ", 
     RowBox[{"gradient", ":", " ", 
      RowBox[{"l", "^", "i"}]}]}], " ", "=", " ", 
    RowBox[{"l_i", "/", "\[Gamma]_i"}]}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"normSq", "=", 
    RowBox[{"l", " ", ".", " ", "gamInv", " ", ".", " ", "l"}]}], ";"}], 
  "          ", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"||", "l", "||", "\.b2_\[Gamma]"}], " ", "=", " ", 
    RowBox[{"\[CapitalSigma]", " ", 
     RowBox[{"l_i\.b2", "/", "\[Gamma]_i"}]}]}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"gInv", "=", 
   RowBox[{
    RowBox[{"gamInv", "-", 
     RowBox[{"xi", "*", 
      RowBox[{
       RowBox[{"Outer", "[", 
        RowBox[{"Times", ",", "lUp", ",", "lUp"}], "]"}], "/", 
       RowBox[{"(", 
        RowBox[{"1", "+", 
         RowBox[{"xi", "*", "normSq"}]}], ")"}]}]}]}], " ", "//", " ", 
    "Simplify"}]}], ";"}]}], "Input",ExpressionUUID->"eb65238e-1702-4176-8c74-\
1416f5aecd89"],

Cell[TextData[{
 "Verify the inverse is correct: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["g", "TI"], "\[CenterDot]", 
         SuperscriptBox[
          StyleBox["g", "TI"], "-1"], "\[LongEqual]", 
         StyleBox["I", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "g \\cdot g^{-1} = I", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "185ff426-7224-4369-8d10-d5b8e55933be"]
}], "Text",ExpressionUUID->"911198a0-c9ae-49ad-b431-ff17f094e94d"],

