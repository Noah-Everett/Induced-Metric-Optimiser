Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"l3", "=", 
   RowBox[{"{", 
    RowBox[{"la", ",", "lb", ",", "lc"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"hess3", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"Haa", ",", "Hab", ",", "Hac"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"Hab", ",", "Hbb", ",", "Hbc"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"Hac", ",", "Hbc", ",", "Hcc"}], "}"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"gam3", "=", 
   RowBox[{"DiagonalMatrix", "[", 
    RowBox[{"{", 
     RowBox[{"ga", ",", "gb", ",", "gc"}], "}"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"xi", "=", 
    RowBox[{"Symbol", "[", "\"\<xi\>\"", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"g3", "=", 
   RowBox[{"gam3", "+", 
    RowBox[{"xi", "*", 
     RowBox[{"Outer", "[", 
      RowBox[{"Times", ",", "l3", ",", "l3"}], "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"gamInv3", "=", 
   RowBox[{"DiagonalMatrix", "[", 
    RowBox[{"1", "/", 
     RowBox[{"Diagonal", "[", "gam3", "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"lUp3", "=", 
   RowBox[{"gamInv3", " ", ".", " ", "l3"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"normSq3", "=", 
   RowBox[{
    RowBox[{"l3", " ", ".", " ", "gamInv3", " ", ".", " ", "l3"}], " ", "//", 
    " ", "Simplify"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"gInv3", "=", 
    RowBox[{
     RowBox[{"gamInv3", "-", 
      RowBox[{"xi", "*", 
       RowBox[{
        RowBox[{"Outer", "[", 
         RowBox[{"Times", ",", "lUp3", ",", "lUp3"}], "]"}], "/", 
        RowBox[{"(", 
         RowBox[{"1", "+", 
          RowBox[{"xi", "*", "normSq3"}]}], ")"}]}]}]}], " ", "//", " ", 
     "Simplify"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"Verify", " ", "inverse"}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Simplify", "[", 
   RowBox[{"g3", " ", ".", " ", "gInv3"}], "]"}], "==", 
  RowBox[{"IdentityMatrix", "[", "3", "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"(*", " ", "True", " ", "*)"}]}]}], "Input",ExpressionUUID->\
"6c6d8dba-fce4-45be-aa64-85d84a7ff572"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"All", " ", "four", " ", "identities"}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"dg3", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"xi", "*", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"hess3", "[", 
            RowBox[{"[", 
             RowBox[{"k", ",", "i"}], "]"}], "]"}], "*", 
           RowBox[{"l3", "[", 
            RowBox[{"[", "j", "]"}], "]"}]}], "+", 
          RowBox[{
           RowBox[{"l3", "[", 
            RowBox[{"[", "i", "]"}], "]"}], "*", 
           RowBox[{"hess3", "[", 
            RowBox[{"[", 
             RowBox[{"k", ",", "j"}], "]"}], "]"}]}]}], ")"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"k", ",", "3"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "3"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "3"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"bracket3", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"dg3", "[", 
         RowBox[{"[", 
          RowBox[{"i", ",", "j", ",", "ll"}], "]"}], "]"}], "+", 
        RowBox[{"dg3", "[", 
         RowBox[{"[", 
          RowBox[{"j", ",", "i", ",", "ll"}], "]"}], "]"}], "-", 
        RowBox[{"dg3", "[", 
         RowBox[{"[", 
          RowBox[{"ll", ",", "i", ",", "j"}], "]"}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "3"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "3"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"ll", ",", "3"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"chris3", "=", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", "/", "2"}], ")"}], "*", 
           RowBox[{"gInv3", "[", 
            RowBox[{"[", 
             RowBox[{"k", ",", "ll"}], "]"}], "]"}], "*", 
           RowBox[{"bracket3", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", "j", ",", "ll"}], "]"}], "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"ll", ",", "3"}], "}"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"k", ",", "3"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "3"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", "3"}], "}"}]}], "]"}], " ", "//", " ", 
      "Simplify"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"chrisFormula3", "=", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"xi", "*", 
         RowBox[{"hess3", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "j"}], "]"}], "]"}], "*", 
         RowBox[{
          RowBox[{"lUp3", "[", 
           RowBox[{"[", "k", "]"}], "]"}], "/", 
          RowBox[{"(", 
           RowBox[{"1", "+", 
            RowBox[{"xi", "*", "normSq3"}]}], ")"}]}]}], ",", 
        RowBox[{"{", 
         RowBox[{"k", ",", "3"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "3"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", "3"}], "}"}]}], "]"}], " ", "//", " ", 
      "Simplify"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"correction3", "=", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"chris3", "[", 
            RowBox[{"[", 
             RowBox[{"k", ",", "i", ",", "j"}], "]"}], "]"}], "*", 
           RowBox[{"l3", "[", 
            RowBox[{"[", "k", "]"}], "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"k", ",", "3"}], "}"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "3"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", "3"}], "}"}]}], "]"}], " ", "//", " ", 
      "FullSimplify"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"rHess3", "=", 
     RowBox[{
      RowBox[{"hess3", "-", "correction3"}], " ", "//", " ", 
      "FullSimplify"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"{", "\[IndentingNewLine]", "  ", 
    RowBox[{"\"\<Bracket:\>\"", ",", 
     RowBox[{
      RowBox[{
       RowBox[{"Simplify", "[", 
        RowBox[{"bracket3", "-", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"2", "*", "xi", "*", 
            RowBox[{"hess3", "[", 
             RowBox[{"[", 
              RowBox[{"i", ",", "j"}], "]"}], "]"}], "*", 
            RowBox[{"l3", "[", 
             RowBox[{"[", "ll", "]"}], "]"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "3"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"j", ",", "3"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"ll", ",", "3"}], "}"}]}], "]"}]}], "]"}], " ", "//", " ",
        "Flatten"}], " ", "//", " ", "DeleteDuplicates"}], ",", 
     "\[IndentingNewLine]", "  ", "\"\<Christoffel:\>\"", ",", 
     RowBox[{
      RowBox[{
       RowBox[{"FullSimplify", "[", 
        RowBox[{"chris3", "-", "chrisFormula3"}], "]"}], " ", "//", " ", 
       "Flatten"}], " ", "//", " ", "DeleteDuplicates"}], ",", 
     "\[IndentingNewLine]", "  ", "\"\<Riem. Hessian:\>\"", ",", 
     RowBox[{
      RowBox[{
       RowBox[{"FullSimplify", "[", 
        RowBox[{"rHess3", "-", 
         RowBox[{"hess3", "/", 
          RowBox[{"(", 
           RowBox[{"1", "+", 
            RowBox[{"xi", "*", "normSq3"}]}], ")"}]}]}], "]"}], " ", "//", 
       " ", "Flatten"}], " ", "//", " ", "DeleteDuplicates"}]}], 
    "\[IndentingNewLine]", "}"}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"All", " ", 
     RowBox[{"{", "0", "}"}], " ", "\[Checkmark]"}], " ", "*)"}]}]}]], "Input",\
ExpressionUUID->"fa19b1c9-6a7b-4843-b515-fd0fcb78e650"],

