 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"77df4f95-ceb7-4eaa-bba5-61156cc5d91e"],

Cell["1. Background: The Induced Metric", "Section",ExpressionUUID->"29ec2c49-4d3f-4e4a-bb1a-e0c1df73ecbd"],

Cell["The geometric idea", "Subsection",ExpressionUUID->"beaf3b86-7402-464a-bff4-d1df9e645093"],

Cell[TextData[{
 "We have ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["N", "TI"], TraditionalForm], "errors" -> {}, "input" -> "N", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "14c012a7-239d-469c-a1eb-ece1eceab475"],
 " parameters ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Theta]", "\[LongEqual]", 
         RowBox[{"(", 
           RowBox[{
             SuperscriptBox["\[Theta]", "1"], ",", "\[Ellipsis]", ",", 
             SuperscriptBox["\[Theta]", 
              StyleBox["N", "TI"]]}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\theta = (\\theta^1, \\ldots, \\theta^N)", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b3a2ded9-814d-41ba-8429-0177bba34e01"],
 " and a loss function ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["L", "TI"], "(", "\[Theta]", ")"}], TraditionalForm], 
     "errors" -> {}, "input" -> "L(\\theta)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e6d27488-23e5-4d59-a3d1-07b3a8ebc263"],
 ". The optimiser embeds parameter space into one higher dimension: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[CurlyPhi]", 
         RowBox[{"(", "\[Theta]", ")"}], "\[LongEqual]", 
         RowBox[{"(", 
           RowBox[{
             SuperscriptBox["\[Theta]", "1"], ",", "\[Ellipsis]", ",", 
             SuperscriptBox["\[Theta]", 
              StyleBox["N", "TI"]], ",", 
             StyleBox["L", "TI"], 
             RowBox[{"(", "\[Theta]", ")"}]}], ")"}], "\[Element]", 
         SuperscriptBox[
          StyleBox["R", FontSlant -> "Plain"], 
          RowBox[{
            StyleBox["N", "TI"], "+", "1"}]]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\varphi(\\theta) = (\\theta^1, \\ldots, \\theta^N, L(\\theta)) \\in \
\\mathbb{R}^{N+1}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "8e011d58-d7ce-472c-8d64-998f2eff1fb2"],
 "This turns the loss landscape into a literal surface sitting inside ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox[
        StyleBox["R", FontSlant -> "Plain"], 
        RowBox[{
          StyleBox["N", "TI"], "+", "1"}]], TraditionalForm], "errors" -> {}, 
     "input" -> "\\mathbb{R}^{N+1}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ca6c7e2d-3df0-4f03-9596-e6d77cf79ee3"],
 ". The ambient space carries a metric ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["h", "TI"], "\[LongEqual]", 
         StyleBox["diag", FontSlant -> "Plain"], 
         RowBox[{"(", 
           RowBox[{
             SubscriptBox["\[Gamma]", "1"], ",", "\[Ellipsis]", ",", 
             SubscriptBox["\[Gamma]", 
              StyleBox["N", "TI"]], ",", "\[Xi]"}], ")"}]}], TraditionalForm],
      "errors" -> {}, "input" -> 
     "h = \\mathrm{diag}(\\gamma_1, \\ldots, \\gamma_N, \\xi)", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "7288851d-ff30-47ab-87a2-78d6da4747ab"],
 " which, when \"pulled back\" onto the surface, gives the ",
 StyleBox["induced metric",
  FontWeight->Bold],
 ": ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["g", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"]}]], "\[LongEqual]", 
         SubscriptBox["\[Gamma]", 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"]}]], "+", "\[Xi] ", 
         SubscriptBox[
          StyleBox["l", "TI"], 
          StyleBox["i", "TI"]], " ", 
         SubscriptBox[
          StyleBox["l", "TI"], 
          StyleBox["j", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "g_{ij} = \\gamma_{ij} + \\xi\\, l_i\\, l_j", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "729939b9-7d0a-4d20-b4cd-54c5c9f49449"],
 "where ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["l", "TI"], 
          StyleBox["i", "TI"]], "\[LongEqual]", "\[PartialD]", 
         StyleBox["L", "TI"], "/", "\[PartialD]", 
         SuperscriptBox["\[Theta]", 
          StyleBox["i", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "l_i = \\partial L / \\partial \\theta^i", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "961961b8-a0bc-4e72-89f6-78496c58df8c"],
 " is the loss gradient and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Gamma]", 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"]}]], "\[LongEqual]", 
         StyleBox["diag", FontSlant -> "Plain"], 
         RowBox[{"(", 
           RowBox[{
             SubscriptBox["\[Gamma]", "1"], ",", "\[Ellipsis]", ",", 
             SubscriptBox["\[Gamma]", 
              StyleBox["N", "TI"]]}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\gamma_{ij} = \\mathrm{diag}(\\gamma_1, \\ldots, \\gamma_N)", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "3a583e5a-b0e5-4813-9e43-94cf26b99368"],
 " is a constant base metric."
}], "Text",ExpressionUUID->"c0a24e94-e69c-4a27-9fad-76e137d578e5"],

Cell[TextData[{
 "This is a ",
 StyleBox["rank-1 perturbation",
  FontWeight->Bold],
 " of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Gamma]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\gamma", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "91520b86-5d77-46ab-bc21-2cfa77811727"],
 ": the gradient vector ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["l", "TI"], TraditionalForm], "errors" -> {}, "input" -> "l", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5d33a8c0-1863-411a-9bda-acab63931067"],
 " \"stretches\" the metric in its own direction. The parameter ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Xi]", ">", "0"}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\xi > 0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "6af837f3-1b0e-4e88-8226-86de96ef0149"],
 " controls how much. "
}], "Text",ExpressionUUID->"226b4829-a985-410e-9200-9b2953f2021d"],

Cell["Why geodesic convexity matters", "Subsection",ExpressionUUID->"8be2f7ef-5972-4f35-a2cb-e40d107ce702"],

Cell[TextData[{
 "A function is ",
 StyleBox["geodesically convex",
  FontWeight->Bold],
 " with respect to a metric ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["g", "TI"], TraditionalForm], "errors" -> {}, "input" -> "g", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c224fd06-6797-4046-914d-cf6e6db54588"],
 " if its ",
 StyleBox["Riemannian Hessian",
  FontWeight->Bold],
 " ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["Hess", FontSlant -> "Plain"], 
          StyleBox["g", "TI"]], 
         StyleBox["L", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\mathrm{Hess}_g L", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "47c6fa5b-919a-4391-b690-a6d1494f3ed0"],
 " is positive semi-definite (PSD). If ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["L", "TI"], TraditionalForm], "errors" -> {}, "input" -> "L", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "91729974-a1a0-4dbf-b9c2-6d82fcf0114d"],
 " is geodesically convex w.r.t. ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["g", "TI"], TraditionalForm], "errors" -> {}, "input" -> "g", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "3d6b4ec3-4465-4bd6-a9c1-8b45cedc03df"],
 ", then Riemannian gradient descent ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox["\[Delta]\[Theta]", 
          StyleBox["i", "TI"]], "\[LongEqual]", "-", "\[Eta] ", 
         SuperscriptBox[
          StyleBox["g", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"]}]], 
         SubscriptBox[
          StyleBox["l", "TI"], 
          StyleBox["j", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\delta\\theta^i = -\\eta\\, g^{ij} l_j", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b14dbaa9-f31f-4ce2-bb05-73f522955c54"],
 " is guaranteed to converge to a global minimum \[LongDash] even if ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["L", "TI"], TraditionalForm], "errors" -> {}, "input" -> "L", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "8c5f5435-b1c8-4e9c-9a85-171ed01d9af4"],
 " is non-convex in the ordinary Euclidean sense."
}], "Text",ExpressionUUID->"6553998d-b8e2-4252-9c13-7372fac62e64"],

Cell[TextData[{
 "The Riemannian Hessian is: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          RowBox[{"(", 
            RowBox[{
              SubscriptBox[
               StyleBox["Hess", FontSlant -> "Plain"], 
               StyleBox["g", "TI"]], 
              StyleBox["L", "TI"]}], ")"}], 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"]}]], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["H", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"]}]], "-", 
         SubsuperscriptBox["\[CapitalGamma]", 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"]}], 
          StyleBox["k", "TI"]], " ", 
         SubscriptBox[
          StyleBox["l", "TI"], 
          StyleBox["k", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "(\\mathrm{Hess}_g L)_{ij} = H_{ij} - \\Gamma^k_{ij}\\, l_k", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c14a4e16-4e74-47ef-9adf-ef622f0cba0f"],
 "where ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["H", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"]}]], "\[LongEqual]", 
         SuperscriptBox["\[PartialD]", "2"], 
         StyleBox["L", "TI"], "/", "\[PartialD]", 
         SuperscriptBox["\[Theta]", 
          StyleBox["i", "TI"]], "\[PartialD]", 
         SuperscriptBox["\[Theta]", 
          StyleBox["j", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "H_{ij} = \\partial^2 L / \\partial\\theta^i \\partial\\theta^j", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "14225400-9593-44cf-b91f-606ab7209aba"],
 " is the ordinary Hessian and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubsuperscriptBox["\[CapitalGamma]", 
        RowBox[{
          StyleBox["i", "TI"], 
          StyleBox["j", "TI"]}], 
        StyleBox["k", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\Gamma^k_{ij}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "86c6cc34-bcde-48a8-a9a9-c1a83326ae98"],
 " are the ",
 StyleBox["Christoffel symbols",
  FontWeight->Bold],
 " of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["g", "TI"], TraditionalForm], "errors" -> {}, "input" -> "g", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "1477f830-96cf-4849-a63e-5c59d4fd1828"],
 " (encoding the curvature of the metric). The correction term ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubsuperscriptBox["\[CapitalGamma]", 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"]}], 
          StyleBox["k", "TI"]], 
         SubscriptBox[
          StyleBox["l", "TI"], 
          StyleBox["k", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\Gamma^k_{ij} l_k", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "4e3d5f7a-5a74-4bfd-af17-70ded9ae9115"],
 " is what the metric \"subtracts\" from the Euclidean Hessian. If this \
subtraction removes negative eigenvalues, the metric has made the landscape \
geodesically convex. "
}], "Text",ExpressionUUID->"2ce70554-20f5-4027-b547-ab5f94015ca6"],

Cell["The inverse metric (Sherman\[Dash]Morrison)", "Subsection",ExpressionUUID->"5a2c1085-63f5-4701-a604-86339b717695"],

Cell[TextData[{
 "Since ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["g", "TI"], "\[LongEqual]", "\[Gamma]", "+", "\[Xi] ", 
         StyleBox["l", "TI"], "\[CircleTimes]", 
         StyleBox["l", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "g = \\gamma + \\xi\\, l \\otimes l", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "87c9f380-54f1-4d39-bf4a-2e6ecca16a62"],
 " is a rank-1 update of the diagonal matrix ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Gamma]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\gamma", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b21bcfa1-4146-41fb-a2d6-045086797b6a"],
 ", its inverse follows from the Sherman\[Dash]Morrison formula: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["g", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"]}]], "\[LongEqual]", 
         SuperscriptBox["\[Gamma]", 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"]}]], "-", 
         FractionBox[
          RowBox[{"\[Xi] ", 
            SuperscriptBox[
             StyleBox["l", "TI"], 
             StyleBox["i", "TI"]], " ", 
            SuperscriptBox[
             StyleBox["l", "TI"], 
             StyleBox["j", "TI"]]}], 
          
          RowBox[{"1", "+", "\[Xi] ", 
            "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", 
            StyleBox["l", "TI"], 
            SubsuperscriptBox[
            "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", "\[Gamma]",
              "2"]}]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "g^{ij} = \\gamma^{ij} - \\frac{\\xi\\, l^i\\, l^j}{1 + \\xi\\, \
|l|_\\gamma^2}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f483a6d2-931c-411a-a857-8a857de3090c"],
 "where ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["l", "TI"], 
          StyleBox["i", "TI"]], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["l", "TI"], 
          StyleBox["i", "TI"]], "/", 
         SubscriptBox["\[Gamma]", 
          StyleBox["i", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "l^i = l_i / \\gamma_i", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "fb349fb6-28c1-4909-942d-feccc7e8c1d1"],
 " is the \"raised\" gradient and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", 
         StyleBox["l", "TI"], 
         SubsuperscriptBox[
         "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", "\[Gamma]", 
          "2"], "\[LongEqual]", 
         UnderscriptBox["\[Sum]", 
          StyleBox["k", "TI"], LimitsPositioning -> True], 
         SubsuperscriptBox[
          StyleBox["l", "TI"], 
          StyleBox["k", "TI"], "2"], "/", 
         SubscriptBox["\[Gamma]", 
          StyleBox["k", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "|l|_\\gamma^2 = \\sum_k l_k^2 / \\gamma_k", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "299d145a-dfd3-4907-b6ab-4a63eced38ec"],
 ". "
}], "Text",ExpressionUUID->"edeee88e-34c9-49e8-b7a4-b97432ab0a78"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
