        RowBox[{"{", 
         RowBox[{"0", ",", " ", "0"}], "}"}]}], "}"}]}], "}"}], " ", 
    "\[Checkmark]"}], " ", "*)"}]}]}], "Input",ExpressionUUID->"b0641996-836b-\
4434-9b9d-3b1fc3eaff4e"],

