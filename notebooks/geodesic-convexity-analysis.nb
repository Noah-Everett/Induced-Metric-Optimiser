     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"0b744113-0442-4ad9-8d13-46b0225622ec"],

Cell["2. Abstract Proof via xAct (General N)", "Section",ExpressionUUID->"78c26bfd-6299-41b1-bae8-d65dbc800a22"],

Cell[TextData[{
 "xAct lets us work with abstract indices on an ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["N", "TI"], TraditionalForm], "errors" -> {}, "input" -> "N", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "466130ca-709a-453b-8492-21da2d9e07ca"],
 "-dimensional manifold \[LongDash] no need to fix a dimension. This is the \
rigorous, dimension-independent proof. "
}], "Text",ExpressionUUID->"2e1a6615-f749-4dc9-a5f9-0286fa6152b7"],

Cell["Setup", "Subsection",ExpressionUUID->"0500233a-6f95-4ca1-a53a-7c6a861a721f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Load", " ", "xAct"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Needs", "[", "\"\<xAct`xTensor`\>\"", "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"Define", " ", "an", " ", "N"}], "-", 
      RowBox[{
      "dimensional", " ", "manifold", " ", "M", " ", "with", " ", "abstract", 
       " ", "indices", " ", "a"}]}], ",", " ", "b", ",", " ", "c", ",", " ", 
     "..."}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"DefManifold", "[", 
     RowBox[{"M", ",", "n", ",", 
      RowBox[{"{", 
       RowBox[{
       "a", ",", "b", ",", "c", ",", "d", ",", "e", ",", "f", ",", "i", ",", 
        "j", ",", "k", ",", "l", ",", "m", ",", "p", ",", "q", ",", "r", ",", 
        "s"}], "}"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Define", " ", "the", " ", "base", " ", "metric", " ", "\[Gamma]", " ", 
     "on", " ", "M"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "The", " ", "\"\<1\>\"", " ", "means", " ", "Riemannian", " ", 
      "signature"}], ";", " ", 
     RowBox[{
     "cd", " ", "is", " ", "the", " ", "covariant", " ", "derivative"}]}], 
    " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"DefMetric", "[", 
     RowBox[{"1", ",", 
      RowBox[{"gammaM", "[", 
       RowBox[{
        RowBox[{"-", "a"}], ",", 
        RowBox[{"-", "b"}]}], "]"}], ",", "cd", ",", 
      RowBox[{"SymbolOfCovD", "->", 
       RowBox[{"{", 
        RowBox[{"\"\<;\>\"", ",", "\"\<\[Del]\>\""}], "}"}]}]}], "]"}], ";"}],
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Define", " ", "the", " ", "scalar", " ", "loss", " ", "function", " ", 
     "L", " ", "and", " ", "embedding", " ", "weight", " ", "\[Xi]"}], " ", 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"DefScalar", "[", 
     RowBox[{"L", "[", "]"}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"DefScalar", "[", 
     RowBox[{"xi", "[", "]"}], "]"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Define", " ", "the", " ", "gradient", " ", "covector", " ", "l_a", " ", 
     "and", " ", "the", " ", "symmetric", " ", "Hessian", " ", "H_", 
     RowBox[{"{", "ab", "}"}]}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "These", " ", "are", " ", "treated", " ", "as", " ", "independent", " ", 
      "tensor", " ", "fields"}], " ", "\[LongDash]", " ", 
     RowBox[{"we", " ", 
      RowBox[{"don", "'"}], "t", " ", "need"}]}], " ", "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"to", " ", "derive", " ", "them", " ", "from", " ", "L"}], ",", 
     " ", 
     RowBox[{"just", " ", "verify", " ", "algebraic", " ", "identities"}]}], 
    " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"DefTensor", "[", 
     RowBox[{
      RowBox[{"ll", "[", 
       RowBox[{"-", "a"}], "]"}], ",", "M"}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"DefTensor", "[", 
     RowBox[{
      RowBox[{"HH", "[", 
       RowBox[{
        RowBox[{"-", "a"}], ",", 
