Cell["5. Second Fundamental Form and Gauss Equation", "Section",ExpressionUUID->"a173203a-c480-4857-8f43-039d3b0c277e"],

Cell["A different route to the same answer", "Subsection",ExpressionUUID->"05a9d8b9-5d57-45c5-8616-b698a5c6b921"],

Cell[TextData[{
 "Instead of computing Christoffel symbols directly, we can study the ",
 StyleBox["extrinsic geometry",
  FontWeight->Bold],
 " of the embedded surface ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[CurlyPhi]", 
         RowBox[{"(", "\[Theta]", ")"}], "\[LongEqual]", 
         RowBox[{"(", 
           RowBox[{"\[Theta]", ",", 
             StyleBox["L", "TI"], 
             RowBox[{"(", "\[Theta]", ")"}]}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\varphi(\\theta) = (\\theta, L(\\theta))", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "4e815934-6146-4e51-a8b6-bc9385f56150"],
 " in ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox[
        StyleBox["R", FontSlant -> "Plain"], 
        RowBox[{
          StyleBox["N", "TI"], "+", "1"}]], TraditionalForm], "errors" -> {}, 
     "input" -> "\\mathbb{R}^{N+1}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "79bb1e29-7714-4a5d-98e7-4d7e75c54ffc"],
 "."
}], "Text",ExpressionUUID->"3012ad07-d991-4c16-9c3c-0197ba2e832b"],

Cell[TextData[{
 "The ",
 StyleBox["second fundamental form",
  FontWeight->Bold],
 " $b_{ij}$ measures how the surface curves within the ambient space. The ",
 StyleBox["Gauss equation",
  FontWeight->Bold],
 " then relates the intrinsic curvature (Riemann tensor of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["g", "TI"], TraditionalForm], "errors" -> {}, "input" -> "g", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "77fe0c94-c217-4c02-842f-fdf9e1e27258"],
 ") to $b_{ij}$. "
}], "Text",ExpressionUUID->"8abcd10b-d474-43d7-be11-e9a3e0277396"],

Cell["Unit normal to the surface", "Subsection",ExpressionUUID->"e737844e-47bb-4e0a-a7fc-e537ead3a0e4"],

Cell[TextData[{
 "The surface has tangent vectors ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["e", "TI"], 
          StyleBox["i", "TI"]], "\[LongEqual]", 
         RowBox[{"(", 
           RowBox[{
             SubscriptBox["\[Delta]", 
              RowBox[{
                StyleBox["i", "TI"], "1"}]], ",", "\[Ellipsis]", ",", 
             SubscriptBox["\[Delta]", 
              RowBox[{
                StyleBox["i", "TI"], 
                StyleBox["N", "TI"]}]], ",", 
             SubscriptBox[
              StyleBox["l", "TI"], 
              StyleBox["i", "TI"]]}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "e_i = (\\delta_{i1}, \\ldots, \\delta_{iN}, l_i)", "state" -> "Boxes"|>,
    
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "4b776d6b-5c67-4993-9bf6-49cfa2f6d9b1"],
 ". The unit normal ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["n", "TI"], TraditionalForm], "errors" -> {}, "input" -> "n", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "34bf69bd-ca49-4cf4-b462-9c24be70b540"],
 " (with respect to the ambient metric ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["h", "TI"], "\[LongEqual]", 
         StyleBox["diag", FontSlant -> "Plain"], 
         RowBox[{"(", 
           RowBox[{
             SubscriptBox["\[Gamma]", "1"], ",", "\[Ellipsis]", ",", 
             SubscriptBox["\[Gamma]", 
              StyleBox["N", "TI"]], ",", "\[Xi]"}], ")"}]}], TraditionalForm],
      "errors" -> {}, "input" -> 
     "h = \\mathrm{diag}(\\gamma_1, \\ldots, \\gamma_N, \\xi)", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f36b9d6b-a5dc-4b2d-96ac-c6d89bfd17d8"],
 ") must satisfy ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["h", "TI"], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["n", "TI"], ",", 
             SubscriptBox[
              StyleBox["e", "TI"], 
              StyleBox["i", "TI"]]}], ")"}], "\[LongEqual]", "0"}], 
       TraditionalForm], "errors" -> {}, "input" -> "h(n, e_i) = 0", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d807a45e-1c59-4ed3-b6b1-de88f0e07e7c"],
 " for all ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["i", "TI"], TraditionalForm], "errors" -> {}, "input" -> "i", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "75940498-2212-4150-8e8e-40b6f24d2415"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["h", "TI"], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["n", "TI"], ",", 
             StyleBox["n", "TI"]}], ")"}], "\[LongEqual]", "1"}], 
       TraditionalForm], "errors" -> {}, "input" -> "h(n, n) = 1", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "33b297b3-5a41-432f-9120-62eeb8963939"],
 "."
}], "Text",ExpressionUUID->"5b714785-bb75-4b34-9d2c-735a14b94fac"],

Cell[TextData[{
 "The normal component in the ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"(", 
         RowBox[{
           StyleBox["N", "TI"], "+", "1"}], ")"}], TraditionalForm], 
     "errors" -> {}, "input" -> "(N+1)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "cad2d115-2ef4-40a6-b8e1-9fcaabf8829c"],
 "-th direction is ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["n", "TI"], "3"], "\[LongEqual]", "1", "/", 
         SqrtBox[
          RowBox[{"\[Xi]", "(", 
            
            RowBox[{"1", "+", "\[Xi]", 
              "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", 
              StyleBox["l", "TI"], 
              SubsuperscriptBox[
              "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", 
               "\[Gamma]", "2"]}], ")"}]]}], TraditionalForm], "errors" -> {},
      "input" -> "n_3 = 1/\\sqrt{\\xi(1 + \\xi|l|_\\gamma^2)}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e526ad78-9dce-4a41-814d-04c7a45f3a32"],
 ". "
}], "Text",ExpressionUUID->"14f2f510-cf98-4389-8a80-dc5d53699e9f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"l", "=", 
   RowBox[{"{", 
    RowBox[{"l1", ",", "l2"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"hess", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"H11", ",", "H12"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"H12", ",", "H22"}], "}"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"xi", "=", 
   RowBox[{"Symbol", "[", "\"\<xi\>\"", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"normSq", "=", 
    RowBox[{
     RowBox[{
      RowBox[{"l1", "^", "2"}], "/", "g1"}], "+", 
     RowBox[{
      RowBox[{"l2", "^", "2"}], "/", "g2"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"e1", "=", 
   RowBox[{"{", 
    RowBox[{"1", ",", "0", ",", "l1"}], "}"}]}], ";", " ", 
  RowBox[{"e2", "=", 
   RowBox[{"{", 
    RowBox[{"0", ",", "1", ",", "l2"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"h", "=", 
    RowBox[{"DiagonalMatrix", "[", 
     RowBox[{"{", 
      RowBox[{"g1", ",", "g2", ",", "xi"}], "}"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"n3", "=", 
   RowBox[{"1", "/", 
    RowBox[{"Sqrt", "[", 
     RowBox[{"xi", "*", 
      RowBox[{"(", 
       RowBox[{"1", "+", 
        RowBox[{"xi", "*", "normSq"}]}], ")"}]}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"nVec", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "xi"}], "*", "l1", "*", 
       RowBox[{"n3", "/", "g1"}]}], ",", 
      RowBox[{
       RowBox[{"-", "xi"}], "*", "l2", "*", 
       RowBox[{"n3", "/", "g2"}]}], ",", "n3"}], "}"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"Verify", ":", " ", 
    RowBox[{
    "orthogonal", " ", "to", " ", "both", " ", "tangent", " ", "vectors", " ",
      "and", " ", "unit", " ", "length"}]}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Simplify", "[", 
    RowBox[{"nVec", ".", "h", ".", "e1"}], "]"}], ",", 
   RowBox[{"Simplify", "[", 
    RowBox[{"nVec", ".", "h", ".", "e2"}], "]"}], ",", "\[IndentingNewLine]", 
   " ", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{"nVec", ".", "h", ".", "nVec"}], ",", 
     RowBox[{"Assumptions", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"xi", ">", "0"}], ",", 
        RowBox[{"g1", ">", "0"}], ",", 
        RowBox[{"g2", ">", "0"}]}], "}"}]}]}], "]"}]}], "}"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"0", ",", " ", "0", ",", " ", "1"}], "}"}], " ", 
    "\[Checkmark]"}], " ", "*)"}]}]}], "Input",ExpressionUUID->"e2df7fc0-8c75-\
43d7-bcf1-49ddf30ebf71"],

Cell["Second fundamental form", "Subsection",ExpressionUUID->"b517768b-58ec-4910-911a-4fa169e3d661"],

Cell[TextData[{
 "Since ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[PartialD]", 
          StyleBox["i", "TI"]], 
         SubscriptBox["\[PartialD]", 
          StyleBox["j", "TI"]], "\[CurlyPhi]", "\[LongEqual]", 
         RowBox[{"(", 
           RowBox[{"0", ",", "\[Ellipsis]", ",", "0", ",", 
             SubscriptBox[
              StyleBox["H", "TI"], 
              RowBox[{
                StyleBox["i", "TI"], 
                StyleBox["j", "TI"]}]]}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\partial_i \\partial_j \\varphi = (0, \\ldots, 0, H_{ij})", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "66376e92-6b96-4e47-8829-f275dfccdd6a"],
 ": ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["b", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"]}]], "\[LongEqual]", 
         StyleBox["h", "TI"], 
         RowBox[{"(", 
           RowBox[{
             SubscriptBox["\[PartialD]", 
              StyleBox["i", "TI"]], 
             SubscriptBox["\[PartialD]", 
              StyleBox["j", "TI"]], "\[CurlyPhi]", ",", 
             StyleBox["n", "TI"]}], ")"}], "\[LongEqual]", "\[Xi] ", 
         SubscriptBox[
          StyleBox["n", "TI"], "3"], " ", 
         SubscriptBox[
          StyleBox["H", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"]}]], "\[LongEqual]", 
         SqrtBox[
          FractionBox["\[Xi]", 
           
           RowBox[{"1", "+", "\[Xi]", 
             "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", 
             StyleBox["l", "TI"], 
             SubsuperscriptBox[
             "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", 
              "\[Gamma]", "2"]}]]], " ", 
         SubscriptBox[
          StyleBox["H", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"]}]]}], TraditionalForm], "errors" -> {}, 
     "input" -> 
     "b_{ij} = h(\\partial_i \\partial_j \\varphi, n) = \\xi\\, n_3\\, H_{ij} \
= \\sqrt{\\frac{\\xi}{1 + \\xi|l|_\\gamma^2}}\\; H_{ij}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f4801f96-5e7c-4640-b187-e4555d94c242"],
 "The key relationship between the second fundamental form and the Riemannian \
Hessian is: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          RowBox[{"(", 
            RowBox[{
              SubscriptBox[
               StyleBox["Hess", FontSlant -> "Plain"], 
               StyleBox["g", "TI"]], 
              StyleBox["L", "TI"]}], ")"}], 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"]}]], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["n", "TI"], "3"], "\[CenterDot]", 
         SubscriptBox[
          StyleBox["b", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"]}]]}], TraditionalForm], "errors" -> {}, 
     "input" -> "(\\mathrm{Hess}_g L)_{ij} = n_3 \\cdot b_{ij}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "285f56d3-4606-4ff3-be73-919e536787d2"],
 ". "
}], "Text",ExpressionUUID->"e8244e5b-55c8-476c-b6df-6d4e93cec5e9"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"bExplicit", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", "0", ",", 
         RowBox[{"hess", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "j"}], "]"}], "]"}]}], "}"}], ".", "h", ".", 
       "nVec"}], " ", "//", " ", "Simplify"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "2"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "2"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"bFormula", "=", 
   RowBox[{
    RowBox[{"xi", "*", "n3", "*", "hess"}], " ", "//", " ", 
    "FullSimplify"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{"bExplicit", "-", "bFormula"}], ",", 
   RowBox[{"Assumptions", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"xi", ">", "0"}], ",", 
      RowBox[{"g1", ">", "0"}], ",", 
      RowBox[{"g2", ">", "0"}]}], "}"}]}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "0"}], "}"}]}], "}"}], " ", "\[Checkmark]"}], 
   " ", "*)"}]}]}], "Input",ExpressionUUID->"47cb64c6-b7d7-4d27-ab54-\
1cf8e2c54848"],

Cell["Gauss equation and Gaussian curvature", "Subsection",ExpressionUUID->"4df1e6e0-6a88-4186-8536-51c1d065654e"],

Cell[TextData[{
 "For a hypersurface in flat ambient space: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["R", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"], 
            StyleBox["k", "TI"], 
            StyleBox["l", "TI"]}]], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["b", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["k", "TI"]}]], 
         SubscriptBox[
          StyleBox["b", "TI"], 
          RowBox[{
            StyleBox["j", "TI"], 
            StyleBox["l", "TI"]}]], "-", 
         SubscriptBox[
          StyleBox["b", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["l", "TI"]}]], 
         SubscriptBox[
          StyleBox["b", "TI"], 
          RowBox[{
            StyleBox["j", "TI"], 
            StyleBox["k", "TI"]}]]}], TraditionalForm], "errors" -> {}, 
     "input" -> "R_{ijkl} = b_{ik} b_{jl} - b_{il} b_{jk}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0528d0eb-6282-4566-9e35-dfbea330e268"],
 ". "
}], "Text",ExpressionUUID->"4c63e221-d9f4-49ac-94fb-5bafc94ec9dd"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"R1212", "=", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"bExplicit", "[", 
       RowBox[{"[", 
        RowBox[{"1", ",", "1"}], "]"}], "]"}], "*", 
      RowBox[{"bExplicit", "[", 
       RowBox[{"[", 
        RowBox[{"2", ",", "2"}], "]"}], "]"}]}], "-", 
     RowBox[{
      RowBox[{"bExplicit", "[", 
       RowBox[{"[", 
        RowBox[{"1", ",", "2"}], "]"}], "]"}], "^", "2"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"detH", "=", 
   RowBox[{
    RowBox[{"H11", "*", "H22"}], "-", 
    RowBox[{"H12", "^", "2"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"R1212formula", "=", 
   RowBox[{
    RowBox[{"xi", "*", 
     RowBox[{"detH", "/", 
      RowBox[{"(", 
       RowBox[{"1", "+", 
        RowBox[{"xi", "*", "normSq"}]}], ")"}]}]}], " ", "//", " ", 
    "Simplify"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{"R1212", "-", "R1212formula"}], ",", 
   RowBox[{"Assumptions", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"xi", ">", "0"}], ",", 
      RowBox[{"g1", ">", "0"}], ",", 
      RowBox[{"g2", ">", "0"}]}], "}"}]}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"0", " ", "\[Checkmark]"}], " ", "*)"}]}]}], "Input",ExpressionUUID\
->"c14d9470-d2f9-48b4-b359-fb59d448b4eb"],

Cell[TextData[{
 "Gaussian curvature: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["K", "TI"], "\[LongEqual]", "\[Xi]", "det", 
         RowBox[{"(", 
           StyleBox["H", "TI"], ")"}], "/", 
         RowBox[{"[", 
           RowBox[{"det", 
             RowBox[{"(", "\[Gamma]", ")"}], 
             SuperscriptBox[
              RowBox[{"(", 
                
                RowBox[{
                 "1", "+", "\[Xi]", 
                  "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", 
                  StyleBox["l", "TI"], 
                  SubsuperscriptBox[
                  "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", 
                   "\[Gamma]", "2"]}], ")"}], "2"]}], "]"}]}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "K = \\xi \\det(H) / [\\det(\\gamma)(1 + \\xi|l|_\\gamma^2)^2]", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "4e05306b-2ca8-4b31-94fb-ffc0835e4d5e"]
}], "Text",ExpressionUUID->"e57d25a0-00d8-460c-b866-b52ce5b5bc93"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"gMatrix", "=", 
   RowBox[{
    RowBox[{"DiagonalMatrix", "[", 
     RowBox[{"{", 
      RowBox[{"g1", ",", "g2"}], "}"}], "]"}], "+", 
    RowBox[{"xi", "*", 
     RowBox[{"Outer", "[", 
      RowBox[{"Times", ",", "l", ",", "l"}], "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"gaussK", "=", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{"R1212", "/", 
      RowBox[{"Det", "[", "gMatrix", "]"}]}], ",", 
     RowBox[{"Assumptions", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"xi", ">", "0"}], ",", 
        RowBox[{"g1", ">", "0"}], ",", 
        RowBox[{"g2", ">", "0"}]}], "}"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Kformula", "=", 
   RowBox[{"xi", "*", 
    RowBox[{"detH", "/", 
     RowBox[{"(", 
      RowBox[{"g1", "*", "g2", "*", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "+", 
          RowBox[{"xi", "*", "normSq"}]}], ")"}], "^", "2"}]}], ")"}]}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{"gaussK", "-", "Kformula"}], ",", 
   RowBox[{"Assumptions", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"xi", ">", "0"}], ",", 
      RowBox[{"g1", ">", "0"}], ",", 
      RowBox[{"g2", ">", "0"}]}], "}"}]}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"0", " ", "\[Checkmark]"}], " ", "*)"}]}]}], "Input",ExpressionUUID\
->"d445d81b-ac1a-41b6-9f0e-cab518c7b298"],

Cell["Curvature\[Dash]Hessian dictionary", "Subsection",ExpressionUUID->"6591e0b7-a9ad-45a1-8f0d-2a818500f7cb"],

Cell[BoxData[
 PaneBox[
  PaneBox[
   StyleBox[
    TagBox[
     TagBox[GridBox[{
        {
         TagBox["\<\"Surface geometry\"\>",
          HoldForm], 
         TagBox["\<\"Condition\"\>",
          HoldForm], 
