Cell["The bracket identity (Theorem 1)", "Subsection",ExpressionUUID->"e4f3ca1f-bc25-41f5-af40-bc5ddd72e895"],

Cell[TextData[{
 "The Christoffel bracket ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[PartialD]", 
          StyleBox["a", "TI"]], 
         SubscriptBox[
          StyleBox["g", "TI"], 
          RowBox[{
            StyleBox["b", "TI"], 
            StyleBox["c", "TI"]}]], "+", 
         SubscriptBox["\[PartialD]", 
          StyleBox["b", "TI"]], 
         SubscriptBox[
          StyleBox["g", "TI"], 
          RowBox[{
            StyleBox["a", "TI"], 
            StyleBox["c", "TI"]}]], "-", 
         SubscriptBox["\[PartialD]", 
          StyleBox["c", "TI"]], 
         SubscriptBox[
          StyleBox["g", "TI"], 
          RowBox[{
            StyleBox["a", "TI"], 
            StyleBox["b", "TI"]}]]}], TraditionalForm], "errors" -> {}, 
     "input" -> 
     "\\partial_a g_{bc} + \\partial_b g_{ac} - \\partial_c g_{ab}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "424e3de3-a86d-457a-a9f7-864885d3150a"],
 " involves six terms from the product rule applied to ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Xi]", 
         SubscriptBox[
          StyleBox["l", "TI"], 
          StyleBox["i", "TI"]], 
         SubscriptBox[
          StyleBox["l", "TI"], 
          StyleBox["j", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\xi l_i l_j", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "02e48f1b-bc81-4157-bf70-561f9ec4429d"],
 ". We write all six terms and let xAct's ",
 Cell[BoxData[Cell["ToCanonical",
   Background->None,ExpressionUUID->"851de5df-3e03-430e-918c-1e28e1bfab74"]], 
  "InlineCode",ExpressionUUID->"e73b820a-3bbf-496e-8596-4e36eedaf885"],
 " simplify using the symmetry ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["H", "TI"], 
          RowBox[{
            StyleBox["a", "TI"], 
            StyleBox["b", "TI"]}]], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["H", "TI"], 
          RowBox[{
            StyleBox["b", "TI"], 
            StyleBox["a", "TI"]}]]}], TraditionalForm], "errors" -> {}, 
     "input" -> "H_{ab} = H_{ba}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5eb431e6-79f9-4e50-a854-6c8abdd692e6"],
 ": "
}], "CodeText",ExpressionUUID->"5d52cba7-c459-4b2f-b7d0-e1a44d5728a8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "The", " ", "six", " ", "terms", " ", "of", " ", "the", " ", "bracket"}], 
    ",", " ", 
    RowBox[{
     RowBox[{"using", " ", 
      RowBox[{"\[PartialD]", "_c"}], " ", "g_", 
      RowBox[{"{", "ab", "}"}]}], " ", "=", " ", 
     RowBox[{"\[Xi]", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"H_", 
         RowBox[{"{", "ca", "}"}], " ", "l_b"}], " ", "+", " ", 
        RowBox[{"l_a", " ", "H_", 
         RowBox[{"{", "cb", "}"}]}]}], ")"}]}]}]}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"bracketExpr", "=", 
     RowBox[{
      RowBox[{"xi", "[", "]"}], "*", 
      RowBox[{"(", "\[IndentingNewLine]", "    ", 
       RowBox[{
        RowBox[{
         RowBox[{"HH", "[", 
          RowBox[{
           RowBox[{"-", "a"}], ",", 
           RowBox[{"-", "b"}]}], "]"}], " ", 
         RowBox[{"ll", "[", 
          RowBox[{"-", "c"}], "]"}]}], "+", 
        RowBox[{
         RowBox[{"ll", "[", 
          RowBox[{"-", "b"}], "]"}], " ", 
         RowBox[{"HH", "[", 
          RowBox[{
           RowBox[{"-", "a"}], ",", 
           RowBox[{"-", "c"}]}], "]"}]}], "     ", 
        RowBox[{"(*", " ", 
         RowBox[{"from", " ", 
          RowBox[{"\[PartialD]", "_a"}], " ", "g_", 
          RowBox[{"{", "bc", "}"}]}], " ", "*)"}], "\[IndentingNewLine]", "+", 
        RowBox[{
         RowBox[{"HH", "[", 
          RowBox[{
           RowBox[{"-", "b"}], ",", 
           RowBox[{"-", "a"}]}], "]"}], " ", 
         RowBox[{"ll", "[", 
          RowBox[{"-", "c"}], "]"}]}], "+", 
        RowBox[{
         RowBox[{"ll", "[", 
          RowBox[{"-", "a"}], "]"}], " ", 
         RowBox[{"HH", "[", 
          RowBox[{
           RowBox[{"-", "b"}], ",", 
           RowBox[{"-", "c"}]}], "]"}]}], "     ", 
        RowBox[{"(*", " ", 
         RowBox[{"from", " ", 
          RowBox[{"\[PartialD]", "_b"}], " ", "g_", 
          RowBox[{"{", "ac", "}"}]}], " ", "*)"}], "\[IndentingNewLine]", "-", 
        RowBox[{
         RowBox[{"HH", "[", 
          RowBox[{
           RowBox[{"-", "c"}], ",", 
           RowBox[{"-", "a"}]}], "]"}], " ", 
         RowBox[{"ll", "[", 
          RowBox[{"-", "b"}], "]"}]}], "-", 
        RowBox[{
         RowBox[{"ll", "[", 
          RowBox[{"-", "a"}], "]"}], " ", 
         RowBox[{"HH", "[", 
          RowBox[{
           RowBox[{"-", "c"}], ",", 
           RowBox[{"-", "b"}]}], "]"}]}]}], "     ", 
       RowBox[{"(*", " ", 
        RowBox[{"from", " ", "-", 
         RowBox[{
          RowBox[{"\[PartialD]", "_c"}], " ", "g_", 
          RowBox[{"{", "ab", "}"}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
       ")"}]}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"xAct", " ", "automatically", " ", "uses", " ", "H_", 
      RowBox[{"{", "ab", "}"}]}], " ", "=", " ", 
     RowBox[{
      RowBox[{"H_", 
       RowBox[{"{", "ba", "}"}], " ", "to", " ", "cancel", " ", "cross"}], "-",
       "terms"}]}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{"ToCanonical", "[", "bracketExpr", "]"}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"Result", ":", " ", 
     RowBox[{"2", " ", 
      RowBox[{"HH", "[", 
       RowBox[{
        RowBox[{"-", "a"}], ",", " ", 
        RowBox[{"-", "b"}]}], "]"}], " ", 
      RowBox[{"ll", "[", 
       RowBox[{"-", "c"}], "]"}], " ", 
      RowBox[{"xi", "[", "]"}]}]}], "  ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"i", ".", "e", "."}], ",", " ", 
     RowBox[{"2", "\[Xi]", " ", "H_", 
      RowBox[{"{", "ab", "}"}], " ", "l_c"}], " ", "\[LongDash]", " ", 
     RowBox[{"PROVEN", " ", "for", " ", "general", " ", "N"}]}], " ", 
    "*)"}]}]}]], "Input",ExpressionUUID->"4407e191-e6ee-4a7c-94cd-\
12ca60203869"],

Cell[TextData[{
 "This is the key simplification. The four cross-terms ($l",
 StyleBox["b H",
  FontSlant->Italic],
 "{ac}$, $l",
 StyleBox["a H",
  FontSlant->Italic],
 "{bc}$, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"-", 
         SubscriptBox[
          StyleBox["H", "TI"], 
          RowBox[{
            StyleBox["c", "TI"], 
            StyleBox["a", "TI"]}]], 
         SubscriptBox[
          StyleBox["l", "TI"], 
          StyleBox["b", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "-H_{ca} l_b", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "90411d1b-3860-4cf9-983c-62367d3801a5"],
 ", ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"-", 
         SubscriptBox[
          StyleBox["l", "TI"], 
          StyleBox["a", "TI"]], 
         SubscriptBox[
          StyleBox["H", "TI"], 
          RowBox[{
            StyleBox["c", "TI"], 
            StyleBox["b", "TI"]}]]}], TraditionalForm], "errors" -> {}, 
     "input" -> "-l_a H_{cb}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "8cdc8293-715c-4916-869e-e63b3a3d1cb1"],
 ") cancel pairwise by the symmetry of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["H", "TI"], TraditionalForm], "errors" -> {}, "input" -> "H", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "bc1ff8da-f818-4cc9-b259-ebc5016c9fb3"],
 ", leaving only the two $H",
 StyleBox["{ab} l",
  FontSlant->Italic],
 "c$ terms. "
}], "Text",ExpressionUUID->"bd44ee87-1d9b-4938-9acc-ee8213cee604"],

Cell["The Riemannian Hessian (Theorem 2)", "Subsection",ExpressionUUID->"68108137-22fc-4d4a-82dd-ca83df72dc58"],

Cell[TextData[{
 "From the bracket identity and the Sherman\[Dash]Morrison formula for ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["g", "TI"], 
          RowBox[{
            StyleBox["k", "TI"], 
            StyleBox["l", "TI"]}]], 
         SubscriptBox[
          StyleBox["l", "TI"], 
          StyleBox["l", "TI"]], "\[LongEqual]", 
         SuperscriptBox[
          StyleBox["l", "TI"], 
          StyleBox["k", "TI"]], "/", 
         RowBox[{"(", 
           
           RowBox[{"1", "+", "\[Xi]", 
             "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", 
             StyleBox["l", "TI"], 
             SubsuperscriptBox[
             "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", 
              "\[Gamma]", "2"]}], ")"}]}], TraditionalForm], "errors" -> {}, 
     "input" -> "g^{kl} l_l = l^k/(1 + \\xi|l|_\\gamma^2)", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0467ef52-88f6-4d40-90a6-57e69766cb97"],
 ": ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubsuperscriptBox["\[CapitalGamma]", 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"]}], 
          StyleBox["k", "TI"]], "\[LongEqual]", 
         FractionBox[
          RowBox[{"\[Xi] ", 
            SubscriptBox[
             StyleBox["H", "TI"], 
             RowBox[{
               StyleBox["i", "TI"], 
               StyleBox["j", "TI"]}]], " ", 
            SuperscriptBox[
             StyleBox["l", "TI"], 
             StyleBox["k", "TI"]]}], 
          
          RowBox[{"1", "+", "\[Xi] ", 
            "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", 
            StyleBox["l", "TI"], 
            SubsuperscriptBox[
            "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", "\[Gamma]",
              "2"]}]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\Gamma^k_{ij} = \\frac{\\xi\\, H_{ij}\\, l^k}{1 + \\xi\\, \
|l|_\\gamma^2}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "eee88ef4-d63b-4cd4-a292-5e0add4f65b1"],
 "Contracting with $l_k$: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubsuperscriptBox["\[CapitalGamma]", 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"]}], 
          StyleBox["k", "TI"]], 
         SubscriptBox[
          StyleBox["l", "TI"], 
          StyleBox["k", "TI"]], "\[LongEqual]", 
         FractionBox[
          
          RowBox[{"\[Xi] ", 
            "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", 
            StyleBox["l", "TI"], 
            SubsuperscriptBox[
            "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", "\[Gamma]",
              "2"]}], 
          
          RowBox[{"1", "+", "\[Xi] ", 
            "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", 
            StyleBox["l", "TI"], 
            SubsuperscriptBox[
            "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", "\[Gamma]",
              "2"]}]], " ", 
         SubscriptBox[
          StyleBox["H", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"]}]]}], TraditionalForm], "errors" -> {}, 
     "input" -> 
     "\\Gamma^k_{ij} l_k = \\frac{\\xi\\, |l|_\\gamma^2}{1 + \\xi\\, \
|l|_\\gamma^2}\\, H_{ij}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0ede8531-655a-4f1d-af8d-c9895da8eaec"],
 "Therefore: "
}], "CodeText",ExpressionUUID->"1e26c4f2-67ee-40ca-8f17-03489bc548bf"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Riemannian", " ", "Hessian"}], " ", "=", " ", 
    RowBox[{"H", " ", "-", " ", "correction"}]}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"correctionTerm", "=", 
     RowBox[{
      RowBox[{"xi", "[", "]"}], "*", 
      RowBox[{
       RowBox[{"normSqGamma", "[", "]"}], "/", 
       RowBox[{"(", 
        RowBox[{"1", "+", 
         RowBox[{
          RowBox[{"xi", "[", "]"}], "*", 
          RowBox[{"normSqGamma", "[", "]"}]}]}], ")"}]}], "*", 
      RowBox[{"HH", "[", 
       RowBox[{
        RowBox[{"-", "a"}], ",", 
        RowBox[{"-", "b"}]}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"riemHess", "=", 
    RowBox[{
     RowBox[{
      RowBox[{"HH", "[", 
       RowBox[{
        RowBox[{"-", "a"}], ",", 
        RowBox[{"-", "b"}]}], "]"}], "-", "correctionTerm"}], " ", "//", " ", 
     "Simplify"}]}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"Result", ":", " ", 
     RowBox[{
      RowBox[{"HH", "[", 
       RowBox[{
        RowBox[{"-", "a"}], ",", " ", 
        RowBox[{"-", "b"}]}], "]"}], "/", 
      RowBox[{"(", 
       RowBox[{"1", " ", "+", " ", 
        RowBox[{
         RowBox[{"normSqGamma", "[", "]"}], " ", 
         RowBox[{"xi", "[", "]"}]}]}], ")"}]}]}], "  ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"i", ".", "e", "."}], ",", " ", 
     RowBox[{"H_", 
      RowBox[{
       RowBox[{"{", "ab", "}"}], " ", "/", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"1", " ", "+", " ", "\[Xi]"}], " ", "||", "l", "||", 
         "\.b2_\[Gamma]"}], ")"}]}]}], " ", "\[LongDash]", " ", 
     RowBox[{"PROVEN", " ", "for", " ", "general", " ", "N"}]}], " ", 
    "*)"}]}]}]], "Input",ExpressionUUID->"2a0f9d17-f098-4e78-9676-\
a41ca4646b71"],

Cell["Riemann tensor symmetries (Theorem 3)", "Subsection",ExpressionUUID->"def03108-258e-4be0-8a87-149ad4c240ec"],

Cell[TextData[{
 "The Gauss equation gives ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["R", "TI"], 
          RowBox[{
            StyleBox["a", "TI"], 
            StyleBox["b", "TI"], 
            StyleBox["c", "TI"], 
            StyleBox["d", "TI"]}]], "\[LongEqual]", 
         FractionBox["\[Xi]", 
          
          RowBox[{"1", "+", "\[Xi]", 
            "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", 
            StyleBox["l", "TI"], 
            SubsuperscriptBox[
            "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", "\[Gamma]",
              "2"]}]], 
         RowBox[{"(", 
           RowBox[{
             SubscriptBox[
              StyleBox["H", "TI"], 
              RowBox[{
                StyleBox["a", "TI"], 
                StyleBox["c", "TI"]}]], 
             SubscriptBox[
              StyleBox["H", "TI"], 
              RowBox[{
                StyleBox["b", "TI"], 
                StyleBox["d", "TI"]}]], "-", 
             SubscriptBox[
              StyleBox["H", "TI"], 
              RowBox[{
                StyleBox["a", "TI"], 
                StyleBox["d", "TI"]}]], 
             SubscriptBox[
              StyleBox["H", "TI"], 
              RowBox[{
                StyleBox["b", "TI"], 
                StyleBox["c", "TI"]}]]}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "R_{abcd} = \\frac{\\xi}{1+\\xi|l|_\\gamma^2}(H_{ac}H_{bd} - \
H_{ad}H_{bc})", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ce3341b2-ad2f-484c-b7fb-be6012e1bb5a"],
 ". Let's verify all symmetries abstractly: "
}], "CodeText",ExpressionUUID->"abdf5c9f-c958-4b5f-aa20-4bd7011fb71f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"riemannFromGauss", "=", 
    RowBox[{
     RowBox[{
      RowBox[{"xi", "[", "]"}], "/", 
      RowBox[{"(", 
       RowBox[{"1", "+", 
        RowBox[{
         RowBox[{"xi", "[", "]"}], "*", 
         RowBox[{"normSqGamma", "[", "]"}]}]}], ")"}]}], "*", 
     RowBox[{"(", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{
        RowBox[{"HH", "[", 
         RowBox[{
          RowBox[{"-", "a"}], ",", 
          RowBox[{"-", "c"}]}], "]"}], " ", 
        RowBox[{"HH", "[", 
         RowBox[{
          RowBox[{"-", "b"}], ",", 
          RowBox[{"-", "d"}]}], "]"}]}], "-", 
       RowBox[{
        RowBox[{"HH", "[", 
         RowBox[{
          RowBox[{"-", "a"}], ",", 
          RowBox[{"-", "d"}]}], "]"}], " ", 
        RowBox[{"HH", "[", 
         RowBox[{
          RowBox[{"-", "b"}], ",", 
          RowBox[{"-", "c"}]}], "]"}]}]}], "\[IndentingNewLine]", ")"}]}]}], 
   ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Skew", "-", 
     RowBox[{"symmetry", " ", "in", " ", "first", " ", 
      RowBox[{"pair", ":", " ", 
