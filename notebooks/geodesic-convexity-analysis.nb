Cell["7. The Off-Diagonal Metric", "Section",ExpressionUUID->"0d0abce6-0928-414b-9710-c4f57371a145"],

Cell["Can a richer metric do better?", "Subsection",ExpressionUUID->"1ff61073-0691-4173-a7e9-2b161246cfdb"],

Cell[TextData[{
 "The project also uses an off-diagonal metric with coupling vectors $a, b$: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["g", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"]}]], "\[LongEqual]", 
         SubscriptBox["\[Gamma]", 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"]}]], "+", "\[Xi]", 
         RowBox[{"(", 
           RowBox[{
             SubscriptBox[
              StyleBox["a", "TI"], 
              StyleBox["i", "TI"]], 
             SubscriptBox[
              StyleBox["l", "TI"], 
              StyleBox["j", "TI"]], "+", 
             SubscriptBox[
              StyleBox["b", "TI"], 
              StyleBox["j", "TI"]], 
             SubscriptBox[
              StyleBox["l", "TI"], 
              StyleBox["i", "TI"]], "+", 
             SubscriptBox[
              StyleBox["l", "TI"], 
              StyleBox["i", "TI"]], 
             SubscriptBox[
              StyleBox["l", "TI"], 
              StyleBox["j", "TI"]]}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "g_{ij} = \\gamma_{ij} + \\xi(a_i l_j + b_j l_i + l_i l_j)", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "67122edf-f9a8-451c-ab50-06461e4c0759"],
 "The Christoffel bracket becomes: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[PartialD]", 
          StyleBox["i", "TI"]], 
         SubscriptBox[
          StyleBox["g", "TI"], 
          RowBox[{
            StyleBox["j", "TI"], 
            StyleBox["l", "TI"]}]], "+", 
         SubscriptBox["\[PartialD]", 
          StyleBox["j", "TI"]], 
         SubscriptBox[
          StyleBox["g", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["l", "TI"]}]], "-", 
         SubscriptBox["\[PartialD]", 
          StyleBox["l", "TI"]], 
         SubscriptBox[
          StyleBox["g", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"]}]], "\[LongEqual]", "\[Xi]", 
         RowBox[{"[", 
           RowBox[{
             RowBox[{"(", 
               RowBox[{
                 SubscriptBox[
                  StyleBox["a", "TI"], 
                  StyleBox["j", "TI"]], "-", 
                 SubscriptBox[
                  StyleBox["b", "TI"], 
                  StyleBox["j", "TI"]]}], ")"}], 
             SubscriptBox[
              StyleBox["H", "TI"], 
              RowBox[{
                StyleBox["i", "TI"], 
                StyleBox["l", "TI"]}]], "+", "2", 
             RowBox[{"(", 
               RowBox[{
                 SubscriptBox[
                  StyleBox["b", "TI"], 
                  StyleBox["l", "TI"]], "+", 
                 SubscriptBox[
                  StyleBox["l", "TI"], 
                  StyleBox["l", "TI"]]}], ")"}], 
             SubscriptBox[
              StyleBox["H", "TI"], 
              RowBox[{
                StyleBox["i", "TI"], 
                StyleBox["j", "TI"]}]]}], "]"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\partial_i g_{jl} + \\partial_j g_{il} - \\partial_l g_{ij} = \
\\xi\\left[(a_j - b_j) H_{il} + 2(b_l + l_l) H_{ij}\\right]", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "2de3916a-e0a1-4cb7-ba46-8ef15217fc51"],
 "When ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["a", "TI"], "\[NotEqual]", 
         StyleBox["b", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "a \\neq b", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "382b04d2-ea93-4e3c-99ce-7d9629fae732"],
 ", the bracket has a term ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         RowBox[{"(", 
           RowBox[{
             SubscriptBox[
              StyleBox["a", "TI"], 
              StyleBox["j", "TI"]], "-", 
             SubscriptBox[
              StyleBox["b", "TI"], 
              StyleBox["j", "TI"]]}], ")"}], 
         SubscriptBox[
          StyleBox["H", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["l", "TI"]}]]}], TraditionalForm], "errors" -> {}, 
     "input" -> "(a_j - b_j) H_{il}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b6367e13-d0d4-4185-a8aa-57eaeaf51ae4"],
 " that mixes different Hessian directions \[LongDash] the correction is ",
 StyleBox["not",
  FontWeight->Bold],
 " proportional to $H_{ij}$. "
}], "Text",ExpressionUUID->"41ec8fbe-b529-4686-a21c-e76b017c5494"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"aa", "=", 
   RowBox[{"{", 
    RowBox[{"a1", ",", "a2"}], "}"}]}], ";", " ", 
  RowBox[{"bb", "=", 
   RowBox[{"{", 
    RowBox[{"b1", ",", "b2"}], "}"}]}], ";", " ", 
  RowBox[{"ll", "=", 
   RowBox[{"{", 
    RowBox[{"l1", ",", "l2"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"hh", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"H11", ",", "H12"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"H12", ",", "H22"}], "}"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"xxi", "=", 
   RowBox[{"Symbol", "[", "\"\<xxi\>\"", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"gam", "=", 
    RowBox[{"DiagonalMatrix", "[", 
     RowBox[{"{", 
      RowBox[{"ga", ",", "gb"}], "}"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"gOD", "=", 
   RowBox[{"gam", "+", 
    RowBox[{"xxi", "*", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Outer", "[", 
        RowBox[{"Times", ",", "aa", ",", "ll"}], "]"}], "+", 
       RowBox[{"Outer", "[", 
        RowBox[{"Times", ",", "ll", ",", "bb"}], "]"}], "+", 
       RowBox[{"Outer", "[", 
        RowBox[{"Times", ",", "ll", ",", "ll"}], "]"}]}], ")"}]}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dgOD", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"xxi", "*", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"aa", "[", 
            RowBox[{"[", "i", "]"}], "]"}], "+", 
           RowBox[{"ll", "[", 
            RowBox[{"[", "i", "]"}], "]"}]}], ")"}], "*", 
         RowBox[{"hh", "[", 
          RowBox[{"[", 
           RowBox[{"k", ",", "j"}], "]"}], "]"}]}], "+", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"bb", "[", 
            RowBox[{"[", "j", "]"}], "]"}], "+", 
           RowBox[{"ll", "[", 
            RowBox[{"[", "j", "]"}], "]"}]}], ")"}], "*", 
         RowBox[{"hh", "[", 
          RowBox[{"[", 
           RowBox[{"k", ",", "i"}], "]"}], "]"}]}]}], ")"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"k", ",", "2"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "2"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "2"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"bracketOD", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"dgOD", "[", 
       RowBox[{"[", 
        RowBox[{"i", ",", "j", ",", "el"}], "]"}], "]"}], "+", 
      RowBox[{"dgOD", "[", 
       RowBox[{"[", 
        RowBox[{"j", ",", "i", ",", "el"}], "]"}], "]"}], "-", 
      RowBox[{"dgOD", "[", 
       RowBox[{"[", 
        RowBox[{"el", ",", "i", ",", "j"}], "]"}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "2"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "2"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"el", ",", "2"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"bracketODexpected", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"xxi", "*", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"aa", "[", 
            RowBox[{"[", "j", "]"}], "]"}], "-", 
           RowBox[{"bb", "[", 
            RowBox[{"[", "j", "]"}], "]"}]}], ")"}], "*", 
         RowBox[{"hh", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "el"}], "]"}], "]"}]}], "+", 
        RowBox[{"2", "*", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"bb", "[", 
            RowBox[{"[", "el", "]"}], "]"}], "+", 
           RowBox[{"ll", "[", 
            RowBox[{"[", "el", "]"}], "]"}]}], ")"}], "*", 
         RowBox[{"hh", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "j"}], "]"}], "]"}]}]}], ")"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "2"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "2"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"el", ",", "2"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Simplify", "[", 
  RowBox[{"bracketOD", "-", "bracketODexpected"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"All", " ", "zeros", " ", "\[Checkmark]"}], " ", 
   "*)"}]}]}], "Input",ExpressionUUID->"2f2c3a10-0bd2-4312-9b4a-2976313b6f00"],

Cell["But the catch", "Subsection",ExpressionUUID->"5a6b96ec-a025-4b7b-af4e-e99d1aa2436e"],

Cell[TextData[{
 "When ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["a", "TI"], "\[LongEqual]", 
         StyleBox["b", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "a = b", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "3ac36d78-0a7f-410d-97a4-4427dbc45822"],
 " (symmetric, proper Riemannian metric): the ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"(", 
         RowBox[{
           SubscriptBox[
            StyleBox["a", "TI"], 
            StyleBox["j", "TI"]], "-", 
           SubscriptBox[
            StyleBox["b", "TI"], 
            StyleBox["j", "TI"]]}], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "(a_j - b_j)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "2e218a03-46f9-4eb9-91e7-a7d643eceafe"],
 " term vanishes. The Riemannian Hessian is still proportional to ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["H", "TI"], TraditionalForm], "errors" -> {}, "input" -> "H", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b99c9298-8294-497e-86a8-a0a8b1e2cf48"],
 " \[LongDash] ",
 StyleBox["no sign change possible",
  FontWeight->Bold],
 "."
}], "Item",ExpressionUUID->"1f878424-f74c-43f4-941f-4ae7ed0b9461"],

Cell[TextData[{
 "When ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["a", "TI"], "\[NotEqual]", 
         StyleBox["b", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "a \\neq b", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "796d5255-34c4-4e19-83c2-169c66a9c1c7"],
 ": eigenvalue signs can change, but ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["g", "TI"], TraditionalForm], "errors" -> {}, "input" -> "g", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ab58055d-deb9-403c-b7a0-f6c8c5b7a254"],
 " is ",
 StyleBox["not symmetric",
  FontWeight->Bold],
 " (",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["g", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"]}]], "\[NotEqual]", 
         SubscriptBox[
          StyleBox["g", "TI"], 
          RowBox[{
            StyleBox["j", "TI"], 
            StyleBox["i", "TI"]}]]}], TraditionalForm], "errors" -> {}, 
     "input" -> "g_{ij} \\neq g_{ji}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "6185a8c8-dff9-4d08-be02-3af2040837f6"],
 "), so it is not a Riemannian metric. The optimiser uses it as a \
preconditioner, but Riemannian convergence guarantees don't apply."
}], "Item",ExpressionUUID->"f838be18-ef0e-4dc2-927f-05095961d66b"],

