Cell["6. Eigenvalue Analysis", "Section",ExpressionUUID->"6c391738-c571-42f7-89e0-f00600d8ec3e"],

Cell["The eigenvalue ratio is uniform", "Subsection",ExpressionUUID->"00bfca17-be08-4f84-9b3f-03816a3aabf9"],

Cell[TextData[{
 "Since ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["Hess", FontSlant -> "Plain"], 
          StyleBox["g", "TI"]], 
         StyleBox["L", "TI"], "\[LongEqual]", 
         StyleBox["H", "TI"], "/", 
         RowBox[{"(", 
           
           RowBox[{"1", "+", "\[Xi]", 
             "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", 
             StyleBox["l", "TI"], 
             SubsuperscriptBox[
             "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", 
              "\[Gamma]", "2"]}], ")"}]}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\mathrm{Hess}_g L = H / (1 + \\xi|l|_\\gamma^2)", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c7acfd1c-143f-4af5-8055-12ae32e351f0"],
 ", every eigenvalue of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["Hess", FontSlant -> "Plain"], 
          StyleBox["g", "TI"]], 
         StyleBox["L", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\mathrm{Hess}_g L", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "bf0c9f3b-0d87-42f8-b775-63ec87c26f55"],
 " is the corresponding eigenvalue of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["H", "TI"], TraditionalForm], "errors" -> {}, "input" -> "H", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b77ac65e-a0cc-47da-adf5-b73bb47dcbc6"],
 " divided by the same positive scalar. "
}], "Text",ExpressionUUID->"8ad2cc5c-3a76-4578-b4dc-e7f431a3dc2c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"hess2", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"aa", ",", "bb"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"bb", ",", "cc"}], "}"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"xxi", "=", 
   RowBox[{"Symbol", "[", "\"\<xxi\>\"", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"nSq", "=", 
    RowBox[{"Symbol", "[", "\"\<nSq\>\"", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"eigH", "=", 
   RowBox[{
    RowBox[{"Eigenvalues", "[", "hess2", "]"}], " ", "//", " ", 
    "Simplify"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"eigRH", "=", 
   RowBox[{
    RowBox[{"Eigenvalues", "[", 
     RowBox[{"hess2", "/", 
      RowBox[{"(", 
       RowBox[{"1", "+", 
        RowBox[{"xxi", "*", "nSq"}]}], ")"}]}], "]"}], " ", "//", " ", 
    "Simplify"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"FullSimplify", "[", 
  RowBox[{"eigRH", "/", "eigH"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"1", "/", 
       RowBox[{"(", 
        RowBox[{"1", " ", "+", " ", 
         RowBox[{"nSq", "*", "xxi"}]}], ")"}]}], ",", " ", 
      RowBox[{"1", "/", 
       RowBox[{"(", 
        RowBox[{"1", " ", "+", " ", 
         RowBox[{"nSq", "*", "xxi"}]}], ")"}]}]}], "}"}], " ", "\[LongDash]", 
    " ", 
    RowBox[{"both", " ", "ratios", " ", "identical", " ", "\[Checkmark]"}]}], 
   " ", "*)"}]}]}], "Input",ExpressionUUID->"bcfa83de-507f-4a2d-ac69-\
5261ab50461c"],

