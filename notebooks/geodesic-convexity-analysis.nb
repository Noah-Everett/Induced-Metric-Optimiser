Notebook[{
Cell["Geodesic Convexity Analysis \[LongDash] Induced Metric Optimiser", \
"Title",ExpressionUUID->"a82debbb-39ab-4eaa-aa8c-76e8a2bf6148"],

Cell["What This Notebook Proves", "Section",ExpressionUUID->"d5e722cd-f166-46ce-9a2d-7083b6b2c2cb"],

Cell[TextData[{
 "This notebook asks a natural question about the induced metric optimiser: \
",
 StyleBox["does the metric make the loss landscape \"more convex\" in a \
geometric sense?",
  FontWeight->Bold],
 "The short answer is: ",
 StyleBox["no \[LongDash] but it does something useful anyway.",
  FontWeight->Bold],
 " The induced metric uniformly damps all curvatures by a position-dependent \
factor, acting as smooth gradient clipping. It cannot convert a saddle point \
into a minimum, but it prevents the optimiser from taking dangerously large \
steps in steep regions while preserving the local geometry near minima."
}], "Text",ExpressionUUID->"c9fe0f6d-0064-4a43-8798-3c66f68052e1"],

Cell["Every formula is verified two ways: ", "Text",ExpressionUUID->"9b4d9a62-c488-480b-a4e7-d036c854f451"],

Cell[TextData[{
 StyleBox["Abstract index proofs",
  FontWeight->Bold],
 " using ",
 ButtonBox["xAct",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://www.xact.es/"], None},
  ButtonNote->"http://www.xact.es/"],
 " (xTensor) for dimension-independent results"
}], "Item",ExpressionUUID->"0550ebe5-1afe-47bb-96ef-69404596e300"],

Cell[TextData[{
 StyleBox["Explicit component checks",
  FontWeight->Bold],
 " in ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["n", "TI"], "\[LongEqual]", "2"}], TraditionalForm], 
     "errors" -> {}, "input" -> "n = 2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "abda4db7-cf95-4ab1-9d80-283fb8d0c5e5"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["n", "TI"], "\[LongEqual]", "3"}], TraditionalForm], 
     "errors" -> {}, "input" -> "n = 3", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "aec78712-db79-4516-8f81-4b6c2c7bf930"],
 " for concreteness"
}], "Item",ExpressionUUID->"c6474c08-6c74-44d5-be88-0df0fc908955"],

Cell["Prerequisites", "Subsection",ExpressionUUID->"5a93f838-77d1-49dc-95a6-f4fb8d27ff75"],

Cell[TextData[{
 "This notebook uses the ",
 StyleBox["xAct",
  FontWeight->Bold],
 " package for abstract tensor calculus. If you don't have it installed, get \
it from ",
 ButtonBox["xact.es",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://www.xact.es/"], None},
  ButtonNote->"http://www.xact.es/"],
 ". The component-level checks (Sections 5\[Dash]9) work without xAct. "
}], "Text",ExpressionUUID->"1b1f73d3-5f1d-47ab-9669-6e93bfccfee4"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
