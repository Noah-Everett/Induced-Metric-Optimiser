Cell["Rosenbrock function", "Subsection",ExpressionUUID->"f672b563-7027-48bb-9257-ef346b4cf7ed"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["L", "TI"], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["x", "TI"], ",", 
             StyleBox["y", "TI"]}], ")"}], "\[LongEqual]", 
         SuperscriptBox[
          RowBox[{"(", 
            RowBox[{"1", "-", 
              StyleBox["x", "TI"]}], ")"}], "2"], "+", "100", 
         SuperscriptBox[
          RowBox[{"(", 
            RowBox[{
              StyleBox["y", "TI"], "-", 
              SuperscriptBox[
               StyleBox["x", "TI"], "2"]}], ")"}], "2"]}], TraditionalForm], 
     "errors" -> {}, "input" -> "L(x,y) = (1-x)^2 + 100(y-x^2)^2", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0900c2d4-2fe2-4541-86f3-6ec47f8a2b20"],
 " \[LongDash] non-convex with a narrow curved valley. "
}], "Text",ExpressionUUID->"0c80d216-a1ec-4065-9501-89fcb3f737c7"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"gradR", "[", 
    RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"-", "2"}], "*", 
       RowBox[{"(", 
        RowBox[{"1", "-", "x"}], ")"}]}], "-", 
      RowBox[{"400", "*", "x", "*", 
       RowBox[{"(", 
        RowBox[{"y", "-", 
         RowBox[{"x", "^", "2"}]}], ")"}]}]}], ",", 
     RowBox[{"200", "*", 
      RowBox[{"(", 
       RowBox[{"y", "-", 
        RowBox[{"x", "^", "2"}]}], ")"}]}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"hessR", "[", 
     RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"2", "+", 
         RowBox[{"800", "*", 
          RowBox[{"x", "^", "2"}]}], "-", 
         RowBox[{"400", "*", 
          RowBox[{"(", 
           RowBox[{"y", "-", 
            RowBox[{"x", "^", "2"}]}], ")"}]}]}], ",", 
        RowBox[{
         RowBox[{"-", "400"}], "*", "x"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "400"}], "*", "x"}], ",", "200"}], "}"}]}], "}"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"pts", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "1"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0.5", ",", "0.25"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"2", ",", "4"}], "}"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"xiVal", "=", "10"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"results", "=", 
    RowBox[{"Table", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "lv", ",", "hm", ",", "ns", ",", "gm", ",", "ginv", ",", "dg", ",", 
          "br", ",", "ch", ",", "corr", ",", "rH", ",", "rHf", ",", 
          "maxErr"}], "}"}], ",", "\[IndentingNewLine]", "    ", 
        RowBox[{
         RowBox[{"lv", "=", 
          RowBox[{
           RowBox[{"gradR", "[", 
            RowBox[{
             RowBox[{"pt", "[", 
              RowBox[{"[", "1", "]"}], "]"}], ",", 
             RowBox[{"pt", "[", 
              RowBox[{"[", "2", "]"}], "]"}]}], "]"}], " ", "//", " ", 
           "N"}]}], ";", "\[IndentingNewLine]", "    ", 
         RowBox[{"hm", "=", 
          RowBox[{
           RowBox[{"hessR", "[", 
            RowBox[{
             RowBox[{"pt", "[", 
              RowBox[{"[", "1", "]"}], "]"}], ",", 
             RowBox[{"pt", "[", 
              RowBox[{"[", "2", "]"}], "]"}]}], "]"}], " ", "//", " ", 
           "N"}]}], ";", "\[IndentingNewLine]", "    ", 
         RowBox[{"ns", "=", 
          RowBox[{"lv", ".", "lv"}]}], ";", "\[IndentingNewLine]", "    ", 
         RowBox[{"gm", "=", 
          RowBox[{
           RowBox[{"IdentityMatrix", "[", "2", "]"}], "+", 
           RowBox[{"xiVal", "*", 
            RowBox[{"Outer", "[", 
             RowBox[{"Times", ",", "lv", ",", "lv"}], "]"}]}]}]}], ";", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"ginv", "=", 
          RowBox[{"Inverse", "[", "gm", "]"}]}], ";", "\[IndentingNewLine]", 
         "    ", 
         RowBox[{"dg", "=", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"xiVal", "*", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{"hm", "[", 
                 RowBox[{"[", 
                  RowBox[{"k", ",", "i"}], "]"}], "]"}], "*", 
                RowBox[{"lv", "[", 
                 RowBox[{"[", "j", "]"}], "]"}]}], "+", 
               RowBox[{
                RowBox[{"lv", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], "*", 
                RowBox[{"hm", "[", 
                 RowBox[{"[", 
                  RowBox[{"k", ",", "j"}], "]"}], "]"}]}]}], ")"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"k", ",", "2"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "2"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"j", ",", "2"}], "}"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"br", "=", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"dg", "[", 
              RowBox[{"[", 
               RowBox[{"i", ",", "j", ",", "el"}], "]"}], "]"}], "+", 
             RowBox[{"dg", "[", 
              RowBox[{"[", 
               RowBox[{"j", ",", "i", ",", "el"}], "]"}], "]"}], "-", 
             RowBox[{"dg", "[", 
              RowBox[{"[", 
               RowBox[{"el", ",", "i", ",", "j"}], "]"}], "]"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "2"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"j", ",", "2"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"el", ",", "2"}], "}"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"ch", "=", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"Sum", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{"1", "/", "2"}], ")"}], "*", 
               RowBox[{"ginv", "[", 
                RowBox[{"[", 
                 RowBox[{"k", ",", "el"}], "]"}], "]"}], "*", 
               RowBox[{"br", "[", 
                RowBox[{"[", 
                 RowBox[{"i", ",", "j", ",", "el"}], "]"}], "]"}]}], ",", 
              RowBox[{"{", 
               RowBox[{"el", ",", "2"}], "}"}]}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"k", ",", "2"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "2"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"j", ",", "2"}], "}"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"corr", "=", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"Sum", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"ch", "[", 
                RowBox[{"[", 
                 RowBox[{"k", ",", "i", ",", "j"}], "]"}], "]"}], "*", 
               RowBox[{"lv", "[", 
                RowBox[{"[", "k", "]"}], "]"}]}], ",", 
              RowBox[{"{", 
               RowBox[{"k", ",", "2"}], "}"}]}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "2"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"j", ",", "2"}], "}"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"rH", "=", 
          RowBox[{"hm", "-", "corr"}]}], ";", "\[IndentingNewLine]", "    ", 
         RowBox[{"rHf", "=", 
          RowBox[{"hm", "/", 
           RowBox[{"(", 
            RowBox[{"1", "+", 
             RowBox[{"xiVal", "*", "ns"}]}], ")"}]}]}], ";", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"maxErr", "=", 
          RowBox[{"Max", "[", 
           RowBox[{"Abs", "[", 
            RowBox[{"Flatten", "[", 
             RowBox[{"rH", "-", "rHf"}], "]"}], "]"}], "]"}]}], ";", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"{", 
          RowBox[{"pt", ",", 
           RowBox[{"Round", "[", 
            RowBox[{
             RowBox[{"Sort", "[", 
              RowBox[{"Eigenvalues", "[", "hm", "]"}], "]"}], ",", "0.01"}], 
            "]"}], ",", 
           RowBox[{"Round", "[", 
            RowBox[{
             RowBox[{"Sort", "[", 
              RowBox[{"Eigenvalues", "[", "rH", "]"}], "]"}], ",", "0.0001"}],
             "]"}], ",", 
           RowBox[{"ScientificForm", "[", 
            RowBox[{"maxErr", ",", "3"}], "]"}]}], "}"}]}]}], 
       "\[IndentingNewLine]", "  ", "]"}], ",", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"pt", ",", "pts"}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"TableForm", "[", 
   RowBox[{"results", ",", 
    RowBox[{"TableHeadings", "->", 
     RowBox[{"{", 
      RowBox[{"None", ",", 
       RowBox[{"{", 
