Notebook[{
Cell["\<\
IMO-130: Hessian-Lipschitz Local Convergence --- Beyond Quadratics\
\>", "Title",ExpressionUUID->"6fb57197-f963-4b30-acb2-1c2a5f6884c8"],

Cell["\<\
IMO-130. Extends convergence theory beyond quadratics using Hessian-Lipschitz \
assumptions.\
\>", "Text",ExpressionUUID->"f4018eb2-aee0-4b8c-b33d-6a7c2e79fb74"],

Cell[TextData[{
 "Companion notes: ",
 Cell[BoxData[Cell["notes/hessian-lipschitz-convergence.md",
   Background->None,ExpressionUUID->"b1917a98-1467-4a00-b395-837e838e7f7b"]], 
  "InlineCode",ExpressionUUID->"78492334-ba17-47fd-8abd-6a109d4d016a"],
 "."
}], "Text",ExpressionUUID->"bea27495-73c6-43ad-bb01-f5601ee6a3a4"],

Cell["Builds on IMO-16 (two-timescale convergence on quadratics). ", "Text",ExpressionUUID->"62128a04-521e-4bb2-860c-98b2a7d5a2a6"],

Cell["1. Setup: Hessian-Lipschitz Assumption", "Section",ExpressionUUID->"4b4eae36-c927-45b7-ae5c-dc7e22866cbb"],

Cell[TextData[{
 StyleBox["Assumptions.",
  FontWeight->Bold],
 " Let ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["L", "TI"], ":", 
         SuperscriptBox[
          StyleBox["R", FontSlant -> "Plain"], 
          StyleBox["N", "TI"]], "\[Rule]", 
         StyleBox["R", FontSlant -> "Plain"]}], TraditionalForm], 
     "errors" -> {}, "input" -> "L : \\mathbb{R}^N \\to \\mathbb{R}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "bae019ab-a0ac-47d7-99a8-c15f8b8cee6f"],
 " be twice continuously differentiable with: "
}], "Text",ExpressionUUID->"fe1100ab-7218-4a78-89a5-5709855c255e"],

Cell[TextData[{
 "Strong convexity: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Mu]", 
          RowBox[{
            StyleBox["s", "TI"], 
            StyleBox["c", "TI"]}]], " ", 
         StyleBox["I", "TI"], "\[PrecedesEqual]", 
         StyleBox["H", "TI"], 
         RowBox[{"(", "\[Theta]", ")"}], "\[PrecedesEqual]", 
         SubscriptBox[
          StyleBox["L", "TI"], 
          RowBox[{
            StyleBox["s", "TI"], 
            StyleBox["c", "TI"]}]], " ", 
         StyleBox["I", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\mu_{sc}\\, I \\preceq H(\\theta) \\preceq L_{sc}\\, I", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "864686e0-b96b-427c-9fa4-cfee1cdc9885"]
}], "Item",ExpressionUUID->"c06df7d9-7c66-4f9e-b884-d86caa7f9bc1"],

Cell[TextData[{
 "Hessian Lipschitz: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", 
         StyleBox["H", "TI"], 
         RowBox[{"(", 
           SubscriptBox["\[Theta]", "1"], ")"}], "-", 
         StyleBox["H", "TI"], 
         RowBox[{"(", 
           SubscriptBox["\[Theta]", "2"], ")"}], 
         "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", 
         "\[LessEqual]", 
         SubscriptBox[
          StyleBox["L", "TI"], 
          StyleBox["H", "TI"]], " ", 
         "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", 
         SubscriptBox["\[Theta]", "1"], "-", 
         SubscriptBox["\[Theta]", "2"], 
         "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9"}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "|H(\\theta_1) - H(\\theta_2)| \\leq L_H\\, |\\theta_1 - \\theta_2|", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "bf4bc0f0-61b4-4811-9a09-ad4332b307af"]
}], "Item",ExpressionUUID->"019fa8c2-9ca5-4cf3-8d43-8985edce3c07"],

Cell["\<\
This is the standard assumption class for cubic-regularized Newton (Nesterov \
& Polyak 2006).\
\>", "Text",ExpressionUUID->"a0129442-9ed6-45f9-8791-a7b75bc1618b"],

Cell[TextData[{
 "The Newton target ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubsuperscriptBox[
          StyleBox["s", "TI"], 
          StyleBox["i", "TI"], "*"], 
         RowBox[{"(", "\[Theta]", ")"}], "\[LongEqual]", "-", "log", 
         SubscriptBox[
          StyleBox["H", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["i", "TI"]}]], 
         RowBox[{"(", "\[Theta]", ")"}], "+", "const"}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "s_i^*(\\theta) = -\\log H_{ii}(\\theta) + \\text{const}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a627a29c-1efa-431b-9ef5-2412f5d74491"],
 " now depends on ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Theta]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\theta", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "1e1e711c-f2ae-4612-8af2-d2a68883a79a"],
 ". "
}], "Text",ExpressionUUID->"1e865948-9c31-4a28-ba61-f47a7e66532d"],

Cell["Lipschitz constant of the Newton target", "Subsection",ExpressionUUID->"655fd8f5-afb0-4de2-84d9-f25de19224a5"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Clear", "[", "\"\<Global`*\>\"", "]"}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Mean", " ", "value", " ", 
     RowBox[{"theorem", ":", " ", 
      RowBox[{"|", 
       RowBox[{
        RowBox[{"log", " ", "a"}], " ", "-", " ", 
        RowBox[{"log", " ", "b"}]}], "|", " ", 
       RowBox[{"<=", " ", 
        RowBox[{"|", 
         RowBox[{"a", "-", "b"}], "|", 
         RowBox[{
          RowBox[{"/", "min"}], 
          RowBox[{"(", 
           RowBox[{"a", ",", "b"}], ")"}], " ", "for", " ", "a"}]}]}]}]}]}], ",", 
    RowBox[{"b", " ", ">", " ", "0"}]}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{"Assuming", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", ">", "0"}], ",", 
     RowBox[{"b", ">", "0"}], ",", 
     RowBox[{"a", ">", "b"}]}], "}"}], ",", "\[IndentingNewLine]", "  ", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Log", "[", "a", "]"}], "-", 
      RowBox[{"Log", "[", "b", "]"}]}], "<=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"a", "-", "b"}], ")"}], "/", "b"}]}], "]"}]}], 
  "\[IndentingNewLine]", "]"}]}], "Input",ExpressionUUID->"bbf77e4d-e0fb-443a-\
afe4-d376b669448a"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"|", 
         SubsuperscriptBox[
          StyleBox["s", "TI"], 
          StyleBox["i", "TI"], "*"], 
         RowBox[{"(", 
           SubscriptBox["\[Theta]", "1"], ")"}], "-", 
         SubsuperscriptBox[
          StyleBox["s", "TI"], 
          StyleBox["i", "TI"], "*"], 
         RowBox[{"(", 
           SubscriptBox["\[Theta]", "2"], ")"}], "|", "\[LongEqual]", "|", 
         "log", 
         SubscriptBox[
          StyleBox["H", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["i", "TI"]}]], 
         RowBox[{"(", 
           SubscriptBox["\[Theta]", "1"], ")"}], "-", "log", 
         SubscriptBox[
          StyleBox["H", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["i", "TI"]}]], 
         RowBox[{"(", 
           SubscriptBox["\[Theta]", "2"], ")"}], "|", "\[LessEqual]", 
         FractionBox[
          TemplateBox[{
            RowBox[{
              SubscriptBox[
               StyleBox["H", "TI"], 
               RowBox[{
                 StyleBox["i", "TI"], 
                 StyleBox["i", "TI"]}]], 
              RowBox[{"(", 
                SubscriptBox["\[Theta]", "1"], ")"}], "-", 
              SubscriptBox[
               StyleBox["H", "TI"], 
               RowBox[{
                 StyleBox["i", "TI"], 
                 StyleBox["i", "TI"]}]], 
              RowBox[{"(", 
                SubscriptBox["\[Theta]", "2"], ")"}]}]}, "Abs"], 
          RowBox[{"min", "(", 
            RowBox[{
              SubscriptBox[
               StyleBox["H", "TI"], 
               RowBox[{
                 StyleBox["i", "TI"], 
                 StyleBox["i", "TI"]}]], 
              RowBox[{"(", 
                SubscriptBox["\[Theta]", "1"], ")"}], ",", 
              SubscriptBox[
               StyleBox["H", "TI"], 
               RowBox[{
                 StyleBox["i", "TI"], 
                 StyleBox["i", "TI"]}]], 
              RowBox[{"(", 
                SubscriptBox["\[Theta]", "2"], ")"}]}], ")"}]], 
         "\[LessEqual]", 
         FractionBox[
          RowBox[{
            SubscriptBox[
             StyleBox["L", "TI"], 
             StyleBox["H", "TI"]], 
            "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", 
            SubscriptBox["\[Theta]", "1"], "-", 
            SubscriptBox["\[Theta]", "2"], 
            "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9"}], 
          SubscriptBox["\[Mu]", 
           RowBox[{
             StyleBox["s", "TI"], 
             StyleBox["c", "TI"]}]]]}], TraditionalForm], "errors" -> {}, 
     "input" -> 
     "|s_i^*(\\theta_1) - s_i^*(\\theta_2)| = |\\log H_{ii}(\\theta_1) - \
\\log H_{ii}(\\theta_2)| \\leq \\frac{|H_{ii}(\\theta_1) - \
H_{ii}(\\theta_2)|}{\\min(H_{ii}(\\theta_1), H_{ii}(\\theta_2))} \\leq \
\\frac{L_H |\\theta_1 - \\theta_2|}{\\mu_{sc}}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b330fbb9-21b8-42da-8436-783f37bb4699"],
 "**The Lipschitz constant of the Newton target is ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["L", "TI"], 
          StyleBox["s", "TI"]], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["L", "TI"], 
          StyleBox["H", "TI"]], "/", 
         SubscriptBox["\[Mu]", 
          RowBox[{
            StyleBox["s", "TI"], 
            StyleBox["c", "TI"]}]]}], TraditionalForm], "errors" -> {}, 
     "input" -> "L_s = L_H / \\mu_{sc}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e5602267-7735-4312-92e2-44dc465dae06"],
 ".**"
}], "Text",ExpressionUUID->"be989106-8dbf-450d-bc6f-c24a0149d393"],

Cell[TextData[{
 "When ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["L", "TI"], 
          StyleBox["H", "TI"]], "\[LongEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "L_H = 0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "cc08ab7a-e3fa-403a-a79e-04fd3a9fc5b5"],
 " (quadratic), the target is fixed: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["s", "TI"], "*"], 
         RowBox[{"(", "\[Theta]", ")"}], "\[LongEqual]", 
         SuperscriptBox[
          StyleBox["s", "TI"], "*"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "s^*(\\theta) = s^*", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "8d0e5db7-2b26-4102-9a7c-a47a9d886c79"],
 " for all ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Theta]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\theta", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "08bd0ef4-56d7-451e-909a-922a3d7e6aa8"],
 ". "
}], "Text",ExpressionUUID->"4e245c66-4f54-494d-90f6-64bfb275b8d7"],

Cell["2. Fixed-Target Lyapunov Function", "Section",ExpressionUUID->"e05b40c5-581b-4c42-9016-41afc805e3a3"],

Cell[TextData[{
 "On a quadratic, the joint Lyapunov function (IMO-16, Section 6) has zero \
cross-term because ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox[
        StyleBox["s", "TI"], "*"], TraditionalForm], "errors" -> {}, "input" -> 
     "s^*", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "6091422a-e141-4e31-b6e9-515eece69b8d"],
 " is constant. For general losses, the target ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["s", "TI"], "*"], "(", "\[Theta]", ")"}], TraditionalForm],
      "errors" -> {}, "input" -> "s^*(\\theta)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "88dd3bcf-cea2-4065-94b2-8c9f6597d943"],
 " moves. Using a ",
 StyleBox["moving-target",
  FontWeight->Bold],
 " Lyapunov ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["V", "TI"], "\[LongEqual]", "\[CapitalDelta]", 
         StyleBox["L", "TI"], "+", 
         RowBox[{"(", 
           RowBox[{"\[Alpha]", "/", "2"}], ")"}], 
         "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", 
         StyleBox["s", "TI"], "-", 
         SuperscriptBox[
          StyleBox["s", "TI"], "*"], 
         RowBox[{"(", "\[Theta]", ")"}], 
         SuperscriptBox[
         "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", "2"]}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "V = \\Delta L + (\\alpha/2)|s - s^*(\\theta)|^2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ded316bb-5b75-4890-85cc-f8ea7109755c"],
 " creates complicated ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["d", "TI"], 
         SuperscriptBox[
          StyleBox["s", "TI"], "*"], "/", 
         StyleBox["d", "TI"], "\[Theta]"}], TraditionalForm], "errors" -> {}, 
     "input" -> "ds^*/d\\theta", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "db846112-5a22-41c4-a0e4-bfccddf95ea3"],
 " terms."
}], "Text",ExpressionUUID->"6973c75e-a2f5-4a88-bcad-e5065ee7466b"],

Cell[TextData[{
 "Instead, we use a ",
 StyleBox["fixed-target",
  FontWeight->Bold],
 " Lyapunov: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["W", "TI"], 
         RowBox[{"(", 
           RowBox[{"\[Theta]", ",", 
             StyleBox["s", "TI"]}], ")"}], "\[LongEqual]", 
         StyleBox["L", "TI"], 
         RowBox[{"(", "\[Theta]", ")"}], "-", 
         StyleBox["L", "TI"], 
         RowBox[{"(", 
           SuperscriptBox["\[Theta]", "*"], ")"}], "+", 
         FractionBox["\[Alpha]", "2"], 
         "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", 
         StyleBox["s", "TI"], "-", 
         OverscriptBox[
          StyleBox["s", "TI"], "_"], 
         SuperscriptBox[
         "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", "2"]}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "W(\\theta, s) = L(\\theta) - L(\\theta^*) + \\frac{\\alpha}{2}|s - \
\\bar{s}|^2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "bdc1d962-4619-480b-ac80-b94d1bb035c4"],
 "where ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         OverscriptBox[
          StyleBox["s", "TI"], "_"], "\[LongEqual]", 
         SuperscriptBox[
          StyleBox["s", "TI"], "*"], 
         RowBox[{"(", 
           SuperscriptBox["\[Theta]", "*"], ")"}], "\[LongEqual]", "-", "log", 
         SubscriptBox[
          StyleBox["H", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["i", "TI"]}]], 
         RowBox[{"(", 
           SuperscriptBox["\[Theta]", "*"], ")"}], "+", "const"}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\bar{s} = s^*(\\theta^*) = -\\log H_{ii}(\\theta^*) + \\text{const}", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "1f3ad003-2bad-40fa-a0f2-d5551dd1cbd9"],
 " is the Newton target at the minimum. "
}], "Text",ExpressionUUID->"333d5ac7-548a-4d5d-85a0-1b0cbf126430"],

Cell["Time derivative", "Subsection",ExpressionUUID->"a5f28d9b-4f3c-431e-8933-065f0ded9de7"],

Cell["The continuous-time dynamics are: ", "Text",ExpressionUUID->"b64ca5d4-000f-40d7-9cf1-ef910060a188"],

Cell[TextData[Cell[BoxData[
 FormBox[
  TemplateBox[<|"boxes" -> FormBox[
      RowBox[{
        SubscriptBox[
         OverscriptBox["\[Theta]", "."], 
         StyleBox["i", "TI"]], "\[LongEqual]", "-", "\[Eta] ", 
        SuperscriptBox[
         StyleBox["e", "TI"], 
         SubscriptBox[
          StyleBox["s", "TI"], 
          StyleBox["i", "TI"]]], " ", 
        SubscriptBox["\[Del]", 
         StyleBox["i", "TI"]], 
        StyleBox["L", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
    "\\dot{\\theta}_i = -\\eta\\, e^{s_i}\\, \\nabla_i L", "state" -> "Boxes"|>,
   "TeXAssistantTemplate"], 
  TraditionalForm]],ExpressionUUID->"8d3f9250-e1c5-40f2-9703-4dac951aae13"]], \
"Item",ExpressionUUID->"4ee6d6ee-f464-4ecd-91c6-f18f706f4741"],

Cell[TextData[Cell[BoxData[
 FormBox[
  TemplateBox[<|"boxes" -> FormBox[
      RowBox[{
        SubscriptBox[
         OverscriptBox[
          StyleBox["s", "TI"], "."], 
         StyleBox["i", "TI"]], "\[LongEqual]", "-", "\[Mu]\[Lambda] ", 
        RowBox[{"(", 
          RowBox[{
            SubscriptBox[
             StyleBox["s", "TI"], 
             StyleBox["i", "TI"]], "-", 
            SubsuperscriptBox[
             StyleBox["s", "TI"], 
             StyleBox["i", "TI"], "*"], 
            RowBox[{"(", "\[Theta]", ")"}]}], ")"}]}], TraditionalForm], 
    "errors" -> {}, "input" -> 
    "\\dot{s}_i = -\\mu\\lambda\\,(s_i - s_i^*(\\theta))", "state" -> "Boxes"|>,
   "TeXAssistantTemplate"], 
  TraditionalForm]],ExpressionUUID->"6f663afd-ba68-471a-94c9-43408c02c556"]], \
"Item",ExpressionUUID->"a0731aa6-9923-4704-8b54-5b369e477ba2"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"The", " ", "s"}], "-", 
     RowBox[{"dynamics", " ", "track", " ", "s", "*", 
      RowBox[{"(", "theta", ")"}]}]}], ",", " ", 
    RowBox[{"not", " ", "s_bar"}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Decompose", ":", " ", "s_dot"}], " ", "=", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "mu"}], " ", "lam", " ", 
      RowBox[{"(", 
       RowBox[{"s", " ", "-", " ", "s_bar"}], ")"}]}], " ", "-", " ", 
     RowBox[{"mu", " ", "lam", " ", 
      RowBox[{"(", 
       RowBox[{"s_bar", " ", "-", " ", 
        RowBox[{"s", "*", 
         RowBox[{"(", "theta", ")"}]}]}], ")"}]}]}]}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", "          ", 
   RowBox[{"=", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "mu"}], " ", "lam", " ", 
      RowBox[{"(", 
       RowBox[{"s", " ", "-", " ", "s_bar"}], ")"}]}], " ", "+", " ", 
     RowBox[{"mu", " ", "lam", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"s", "*", 
         RowBox[{"(", "theta", ")"}]}], " ", "-", " ", "s_bar"}], ")"}]}]}]}],
    " ", "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Print", "[", "\"\<=== Lyapunov Time Derivative ===\>\"", "]"}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<dW/dt = <g, theta_dot> + alpha <s - s_bar, s_dot>\>\"",
      "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<= -eta <g, diag(e^s) g>  (theta decay: always \
negative)\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<  -alpha mu lam ||s - s_bar||^2  (s decay toward \
s_bar)\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<  + alpha mu lam <s - s_bar, s*(theta) - s_bar>  \
(CROSS TERM)\>\"", "]"}], ";"}]}]}]], "Input",ExpressionUUID->"9d8d65d8-54a5-\
4f4f-ac1a-98eb175b4988"],

Cell["Bounding the cross term", "Subsection",ExpressionUUID->"f0285dc3-c927-42b9-a5da-29b40e8c570c"],

Cell[TextData[{
 "The cross term arises because the ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["s", "TI"], TraditionalForm], "errors" -> {}, "input" -> "s", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d5d82584-384f-4de9-b92f-732ef9965eb6"],
 "-dynamics push toward ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["s", "TI"], "*"], "(", "\[Theta]", ")"}], TraditionalForm],
      "errors" -> {}, "input" -> "s^*(\\theta)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "4e8bdb7d-288f-4a94-b419-8b7f856eb509"],
 ", not ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       OverscriptBox[
        StyleBox["s", "TI"], "_"], TraditionalForm], "errors" -> {}, "input" -> 
     "\\bar{s}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "522b582c-ce6f-4e51-9a0f-fa5dffcfcdcc"],
 ". The mismatch ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["s", "TI"], "*"], 
         RowBox[{"(", "\[Theta]", ")"}], "-", 
         OverscriptBox[
          StyleBox["s", "TI"], "_"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "s^*(\\theta) - \\bar{s}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a914fc8f-d6b9-4302-9e19-832ada855a30"],
 " is bounded by: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", 
         SuperscriptBox[
          StyleBox["s", "TI"], "*"], 
         RowBox[{"(", "\[Theta]", ")"}], "-", 
         OverscriptBox[
          StyleBox["s", "TI"], "_"], 
         "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", 
         "\[LongEqual]", 
         "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", 
         SuperscriptBox[
          StyleBox["s", "TI"], "*"], 
         RowBox[{"(", "\[Theta]", ")"}], "-", 
         SuperscriptBox[
          StyleBox["s", "TI"], "*"], 
         RowBox[{"(", 
           SuperscriptBox["\[Theta]", "*"], ")"}], 
         "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", 
         "\[LessEqual]", 
         FractionBox[
          SubscriptBox[
           StyleBox["L", "TI"], 
           StyleBox["H", "TI"]], 
          SubscriptBox["\[Mu]", 
           RowBox[{
             StyleBox["s", "TI"], 
             StyleBox["c", "TI"]}]]], " ", 
         "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", "\[Theta]", 
         "-", 
         SuperscriptBox["\[Theta]", "*"], 
         "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", 
         "\[LessEqual]", 
         FractionBox[
          SubscriptBox[
           StyleBox["L", "TI"], 
           StyleBox["H", "TI"]], 
          SubscriptBox["\[Mu]", 
           RowBox[{
             StyleBox["s", "TI"], 
             StyleBox["c", "TI"]}]]], 
         SqrtBox[
          FractionBox[
           RowBox[{"2 ", "\[CapitalDelta]", 
             StyleBox["L", "TI"]}], 
           SubscriptBox["\[Mu]", 
            RowBox[{
              StyleBox["s", "TI"], 
              StyleBox["c", "TI"]}]]]]}], TraditionalForm], "errors" -> {}, 
     "input" -> 
     "|s^*(\\theta) - \\bar{s}| = |s^*(\\theta) - s^*(\\theta^*)| \\leq \
\\frac{L_H}{\\mu_{sc}}\\,|\\theta - \\theta^*| \\leq \
\\frac{L_H}{\\mu_{sc}}\\sqrt{\\frac{2\\,\\Delta L}{\\mu_{sc}}}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "069c15ed-4b0b-44b1-ae47-731d114a04cd"]
}], "Text",ExpressionUUID->"197916bb-d600-40b8-9b5e-da4cec333558"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Young", "'"}], "s", " ", 
    RowBox[{"inequality", ":", " ", 
     RowBox[{
      RowBox[{"a", " ", "b"}], " ", "<=", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"p", "/", "2"}], ")"}], " ", 
        RowBox[{"a", "^", "2"}]}], " ", "+", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "/", 
          RowBox[{"(", 
           RowBox[{"2", "p"}], ")"}]}], ")"}], " ", 
        RowBox[{"b", "^", "2"}]}]}]}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Apply", " ", "with", " ", "a"}], " ", "=", " ", 
     RowBox[{"||", 
      RowBox[{"s", " ", "-", " ", "s_bar"}], "||"}]}], ",", " ", 
    RowBox[{"b", " ", "=", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"L_H", "/", "mu_sc"}], ")"}], " ", "sqrt", 
      RowBox[{"(", 
       RowBox[{"2", " ", 
        RowBox[{"DeltaL", " ", "/", " ", "mu_sc"}]}], ")"}]}]}]}], " ", 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"and", " ", "p"}], " ", "=", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"1", "/", "2"}], " ", "to", " ", "absorb", " ", "half", " ", 
      "the", " ", "s"}], "-", "decay"}]}], " ", "*)"}], "\[IndentingNewLine]",
   "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Cross term bound (Young's inequality, p = 1/2):\>\"", 
     "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<|cross| <= alpha mu lam [ (1/4) ||s-s_bar||^2 + L_H^2 \
DeltaL / mu_sc^3 ]\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<Substituting into dW/dt:\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<dW/dt <= -(2 eta e^{-c} mu_sc - alpha mu lam L_H^2 / \
mu_sc^3) DeltaL\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<         -(3/4) alpha mu lam ||s - s_bar||^2\>\"", 
     "]"}], ";"}]}]}]], "Input",ExpressionUUID->"90b26b47-8e74-4dc3-a1a1-\
3a4e657c80f8"],

Cell["3. Main Theorem: Local Convergence on Strongly Convex Losses", "Section",ExpressionUUID->"d06bf867-9865-4699-b3f3-cfbd5faf25c4"],

Cell["Theorem (Hessian-Lipschitz convergence)", "Subsection",ExpressionUUID->"51b4449d-ac6c-43d9-80de-5642ae297a0b"],

Cell[TextData[{
 "Let ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["L", "TI"], TraditionalForm], "errors" -> {}, "input" -> "L", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "9be0121c-c151-4216-8430-aad5a6c0701d"],
 " satisfy the strong convexity and Hessian-Lipschitz assumptions. For the \
derived optimizer with Newton-targeted metric update, choose: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Alpha]", "<", 
         FractionBox[
          RowBox[{"2 ", "\[Eta] ", 
            SuperscriptBox[
             StyleBox["e", "TI"], 
             RowBox[{"-", 
               StyleBox["c", "TI"]}]], " ", 
            SubsuperscriptBox["\[Mu]", 
             RowBox[{
               StyleBox["s", "TI"], 
               StyleBox["c", "TI"]}], "4"]}], 
          RowBox[{"\[Mu]\[Lambda] ", 
            SubsuperscriptBox[
             StyleBox["L", "TI"], 
             StyleBox["H", "TI"], "2"]}]]}], TraditionalForm], "errors" -> {},
      "input" -> 
     "\\alpha < \\frac{2\\, \\eta\\, e^{-c}\\, \\mu_{sc}^4}{\\mu\\lambda\\, \
L_H^2}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e99e987a-50cf-44ab-bd0a-4072b2dbbece"],
 "Then the Lyapunov function ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["W", "TI"], 
         RowBox[{"(", 
           RowBox[{"\[Theta]", ",", 
             StyleBox["s", "TI"]}], ")"}], "\[LongEqual]", "\[CapitalDelta]", 
         
         StyleBox["L", "TI"], "+", 
         FractionBox["\[Alpha]", "2"], 
         "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", 
         StyleBox["s", "TI"], "-", 
         OverscriptBox[
          StyleBox["s", "TI"], "_"], 
         SuperscriptBox[
         "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", "2"]}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "W(\\theta, s) = \\Delta L + \\frac{\\alpha}{2}|s - \\bar{s}|^2", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "2018c29a-b2b5-40a4-b049-2f5240c64fca"],
 " satisfies: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         OverscriptBox[
          StyleBox["W", "TI"], "."], "\[LessEqual]", "-", "\[Gamma] ", 
         StyleBox["W", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\dot{W} \\leq -\\gamma\\, W", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "7659e25d-362c-48b5-8af7-d89018495564"],
 "where ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Gamma]", "\[LongEqual]", "min", "\[NegativeThinSpace]", 
         RowBox[{"(", 
           RowBox[{"\[Eta] ", 
             SuperscriptBox[
              StyleBox["e", "TI"], 
              RowBox[{"-", 
                StyleBox["c", "TI"]}]], " ", 
             SubscriptBox["\[Mu]", 
              RowBox[{
                StyleBox["s", "TI"], 
                StyleBox["c", "TI"]}]], ", ", 
             FractionBox["3", "2"], " ", "\[Mu]\[Lambda]"}], ")"}]}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\gamma = \\min\\!\\left(\\eta\\, e^{-c}\\, \
\\mu_{sc},\\;\\frac{3}{2}\\,\\mu\\lambda\\right)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "79ea00f8-b230-4e0f-9e8c-8cf9cc90bce1"],
 ". "
}], "Text",ExpressionUUID->"a2b4ef35-e69f-4090-9868-aa3c798b38a7"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Clear", "[", "\"\<Global`*\>\"", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"alphaMax", "=", 
   RowBox[{"2", " ", "eta", " ", 
    RowBox[{"Exp", "[", 
     RowBox[{"-", "c"}], "]"}], " ", 
    RowBox[{
     RowBox[{"muSc", "^", "4"}], "/", 
     RowBox[{"(", 
      RowBox[{"muLam", " ", 
       RowBox[{"LH", "^", "2"}]}], ")"}]}]}]}], ";"}], "\[IndentingNewLine]", 

 RowBox[{
  RowBox[{
   RowBox[{"Print", "[", 
    RowBox[{"\"\<alpha_max = \>\"", ",", "alphaMax"}], "]"}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"At", " ", "alpha"}], " ", "=", " ", 
    RowBox[{"alphaMax", " ", "/", " ", "2"}]}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"gammaTheta", "=", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{"2", " ", "eta", " ", 
      RowBox[{"Exp", "[", 
       RowBox[{"-", "c"}], "]"}], " ", "muSc"}], "-", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"alphaMax", "/", "2"}], ")"}], " ", "muLam", " ", 
      RowBox[{
       RowBox[{"LH", "^", "2"}], "/", 
       RowBox[{"muSc", "^", "3"}]}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"gammaS", "=", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{"3", "/", "4"}], " ", 
     RowBox[{"(", 
      RowBox[{"alphaMax", "/", "2"}], ")"}], " ", "muLam"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", "\"\<At alpha = alpha_max / 2:\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<gammaTheta (coefficient of DeltaL) = \>\"", ",", 
    "gammaTheta"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Print", "[", 
    RowBox[{"\"\<gammaS (coefficient of ||s-s_bar||^2) = \>\"", ",", 
     "gammaS"}], "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rateS", "=", 
   RowBox[{"Simplify", "[", 
    RowBox[{"2", " ", 
     RowBox[{"gammaS", "/", 
      RowBox[{"(", 
       RowBox[{"alphaMax", "/", "2"}], ")"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<Joint rate = min(gammaTheta / 1, 2 gammaS / alpha) = \
min(eta muSc / e^c, 3 muLam / 2)\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<  2 gammaS / alpha = \>\"", ",", "rateS"}], "]"}], 
  ";"}]}], "Input",ExpressionUUID->"1442ebb5-8ec6-4fbf-9697-f6dcec550e44"],

Cell["Proof sketch", "Subsection",ExpressionUUID->"de7e7dee-8780-4b25-8229-90b7176bbc90"],

Cell[TextData[{
 "1. Strong convexity gives ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", 
         StyleBox["g", "TI"], 
         SuperscriptBox[
         "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", "2"], 
         "\[GreaterEqual]", "2 ", 
         SubscriptBox["\[Mu]", 
          RowBox[{
            StyleBox["s", "TI"], 
            StyleBox["c", "TI"]}]], " ", "\[CapitalDelta]", 
         StyleBox["L", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "|g|^2 \\geq 2\\,\\mu_{sc}\\,\\Delta L", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "80195b24-ff1a-4c8e-a88c-6d7142d0c65a"],
 "."
}], "Text",ExpressionUUID->"72000313-e9e7-4bbe-8aa7-279594e8a3c1"],

Cell[TextData[{
 "2. The gradient decay term satisfies ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         RowBox[{"\[LeftAngleBracket]", 
           RowBox[{
             StyleBox["g", "TI"], ",", "diag", 
             RowBox[{"(", 
               SuperscriptBox[
                StyleBox["e", "TI"], 
                StyleBox["s", "TI"]], ")"}], " ", 
             StyleBox["g", "TI"]}], "\[RightAngleBracket]"}], 
         "\[GreaterEqual]", 
         SuperscriptBox[
          StyleBox["e", "TI"], 
          RowBox[{"-", 
            StyleBox["c", "TI"]}]], " ", 
         "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", 
         StyleBox["g", "TI"], 
         SuperscriptBox[
         "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", "2"], 
         "\[GreaterEqual]", "2 ", 
         SuperscriptBox[
          StyleBox["e", "TI"], 
          RowBox[{"-", 
            StyleBox["c", "TI"]}]], " ", 
         SubscriptBox["\[Mu]", 
          RowBox[{
            StyleBox["s", "TI"], 
            StyleBox["c", "TI"]}]], " ", "\[CapitalDelta]", 
         StyleBox["L", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\langle g, \\text{diag}(e^s)\\, g\\rangle \\geq e^{-c}\\,|g|^2 \\geq 2\
\\,e^{-c}\\,\\mu_{sc}\\,\\Delta L", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "74b20026-6b98-475f-aff9-73169e1cf3b2"],
 "."
}], "Text",ExpressionUUID->"853f6b2b-0e79-4926-a1f9-e96f298708d4"],

Cell[TextData[{
 "3. Young's inequality (parameter ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["p", "TI"], "\[LongEqual]", "1", "/", "2"}], 
       TraditionalForm], "errors" -> {}, "input" -> "p = 1/2", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "80c68e79-2335-47a4-ba6f-38a4efcd773d"],
 ") splits the cross term into a piece that absorbs into the ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["s", "TI"], TraditionalForm], "errors" -> {}, "input" -> "s", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c967914b-74fa-4be3-b18f-e9b59c6fe3bc"],
 "-decay and a piece proportional to ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[CapitalDelta]", 
         StyleBox["L", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\Delta L", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "3417cbbb-b829-45de-9693-6202c9127392"],
 "."
}], "Text",ExpressionUUID->"e340f1fe-f4d8-4e78-865f-b3a7de9ff8dd"],

Cell[TextData[{
 "4. The constraint on ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Alpha]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\alpha", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "cd75c2d3-d7d7-4e13-8ca8-a35a69a522a4"],
 " ensures the ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[CapitalDelta]", 
         StyleBox["L", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\Delta L", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "8342dd10-fced-49b9-9117-631c1a7db755"],
 " piece is dominated by the gradient decay."
}], "Text",ExpressionUUID->"4d3a47b8-ee28-4ded-bbdb-91b62a666eb1"],

Cell[TextData[{
 "5. The joint rate ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Gamma]", "\[LongEqual]", "min", 
         RowBox[{"(", 
           RowBox[{"\[Eta] ", 
             SuperscriptBox[
              StyleBox["e", "TI"], 
              RowBox[{"-", 
                StyleBox["c", "TI"]}]], " ", 
             SubscriptBox["\[Mu]", 
              RowBox[{
                StyleBox["s", "TI"], 
                StyleBox["c", "TI"]}]], ", ", 
             FractionBox["3", "2"], " ", "\[Mu]\[Lambda]"}], ")"}]}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\gamma = \\min(\\eta\\, e^{-c}\\, \\mu_{sc},\\; \
\\frac{3}{2}\\,\\mu\\lambda)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d6816bd4-2004-4247-bb64-eed75c21d5c6"],
 " is the minimum of the ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Theta]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\theta", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5fed2a86-1b9b-4c4c-b0e2-756298c04539"],
 "-subsystem and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["s", "TI"], TraditionalForm], "errors" -> {}, "input" -> "s", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5bc863dc-88dc-4af9-b9f8-a39b42a74297"],
 "-subsystem rates. "
}], "Text",ExpressionUUID->"613f02c3-8cd6-4eea-b1fe-f88dbb9af8fb"],

Cell["Key observation", "Subsection",ExpressionUUID->"5ee8f821-0f8a-448d-ac41-051beb40b1d5"],

Cell[TextData[{
 "**",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["L", "TI"], 
        StyleBox["H", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "L_H", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "faf4d35d-1df4-4fc0-969e-4ae11ed9630f"],
 " enters only through the constraint on ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Alpha]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\alpha", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "199e1bfb-140c-48dd-9737-4cb1505d183d"],
 ", not through ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Gamma]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\gamma", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5cd857ef-cf16-49ca-b240-951758e80659"],
 ".** The convergence rate is the same as on a quadratic (up to small \
constants). The Hessian-Lipschitz constant constrains how much weight we can \
put on the metric error in the Lyapunov function, but does not slow down \
convergence. "
}], "Text",ExpressionUUID->"4f97b4d1-6eb0-4ba2-b246-878991f4c63f"],

Cell["4. Special Cases", "Section",ExpressionUUID->"51fc6ede-612a-47cc-925c-f87070907289"],

Cell[TextData[{
 "Case 1: Quadratic (",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["L", "TI"], 
          StyleBox["H", "TI"]], "\[LongEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "L_H = 0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "9211762e-8b30-4073-94ca-8f30843b4ab4"],
 ")"
}], "Subsection",ExpressionUUID->"c2c305b1-1db5-4a66-bebb-aca595b5721b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Print", "[", "\"\<=== Case 1: L_H = 0 (Quadratic) ===\>\"", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<alpha_max -> infinity (any alpha > 0 works)\>\"", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<Cross term = 0 (s*(theta) = s_bar for all theta)\>\"", 
   "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<dW/dt = -eta <g, diag(e^s) g> - alpha mu lam \
||s-s_bar||^2 <= 0\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<Recovers IMO-16 Theorem (Section 6) exactly.\>\"", "]"}],
   ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<Global convergence, zero cross-term, any alpha.\>\"", 
   "]"}], ";"}]}], "Input",ExpressionUUID->"48c9e5ae-4daa-4e67-802c-\
c435920df4ac"],

Cell[TextData[{
 "Case 2: Large ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["L", "TI"], 
        StyleBox["H", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "L_H", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "45e5f757-0c9d-4d7f-9097-08980d03a4f1"],
 " (highly nonlinear)"
}], "Subsection",ExpressionUUID->"f2830050-1cb1-4640-bc3e-f5e85c23e57b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Print", "[", "\"\<=== Case 2: Large L_H ===\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<alpha_max ~ 2 eta e^{-c} mu_sc^4 / (mu lam L_H^2) -> 0\>\
\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", "\"\<Consequences:\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<  - Must use tiny alpha (weak coupling in Lyapunov \
function)\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<  - gammaTheta = eta e^{-c} mu_sc (UNCHANGED: theta rate \
is robust)\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<  - gammaS = (3/4) alpha mu lam -> 0 (s-rate vanishes \
with alpha)\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<  - But the metric STILL converges (just can't prove it \
as fast via Lyapunov)\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<The Lyapunov proof becomes vacuous for s-convergence \
when L_H is large,\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<but the theta-convergence rate is unaffected.\>\"", 
   "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
   "Print", "[", "\"\<Crossover L_H (where Lyapunov alpha_max = 1):\>\"", 
    "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"crossoverLH", "=", 
   RowBox[{"Simplify", "[", 
    RowBox[{"Sqrt", "[", 
     RowBox[{"2", " ", "eta", " ", 
      RowBox[{"Exp", "[", 
       RowBox[{"-", "c"}], "]"}], " ", 
      RowBox[{
       RowBox[{"muSc", "^", "4"}], "/", "muLam"}]}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<  L_H_cross = \>\"", ",", "crossoverLH"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"Numerical", " ", "examples"}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", "\"\<Examples:\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<  mu_sc=1, eta=0.01, mu lam=0.01, c=2:\>\"", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<    L_H_cross = \>\"", ",", 
    RowBox[{"N", "[", 
     RowBox[{"Sqrt", "[", 
      RowBox[{"2", " ", "0.01", " ", 
       RowBox[{"Exp", "[", 
        RowBox[{"-", "2"}], "]"}], " ", 
       RowBox[{
        RowBox[{"1.0", "^", "4"}], "/", "0.01"}]}], "]"}], "]"}]}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<  mu_sc=1, eta=0.01, mu lam=0.01, c=4:\>\"", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<    L_H_cross = \>\"", ",", 
    RowBox[{"N", "[", 
     RowBox[{"Sqrt", "[", 
      RowBox[{"2", " ", "0.01", " ", 
       RowBox[{"Exp", "[", 
        RowBox[{"-", "4"}], "]"}], " ", 
       RowBox[{
        RowBox[{"1.0", "^", "4"}], "/", "0.01"}]}], "]"}], "]"}]}], "]"}], 
  ";"}]}], "Input",ExpressionUUID->"894daaa5-c210-42d4-9e26-1201dc84cc84"],

Cell["5. Convergence Rate Comparison", "Section",ExpressionUUID->"3f970d67-cde3-4035-90f0-5e839205d813"],

