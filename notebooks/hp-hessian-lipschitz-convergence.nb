Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Clear", "[", "\"\<Global`*\>\"", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"kappaVals", "=", 
   RowBox[{"{", 
    RowBox[{"10", ",", "100", ",", "1000", ",", "10000", ",", "100000"}], 
    "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", "\"\<Improvement factor vs sqrt(kappa):\>\"", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", "\"\<kappa | improvement | sqrt(kappa)\>\"", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Do", "[", "\[IndentingNewLine]", "  ", 
   RowBox[{
    RowBox[{
     RowBox[{"mu", "=", "1"}], ";", " ", 
     RowBox[{"ls", "=", "k"}], ";", "\[IndentingNewLine]", "  ", 
     RowBox[{"etaGD", "=", 
      RowBox[{"2", "/", 
       RowBox[{"(", 
        RowBox[{"mu", "+", "ls"}], ")"}]}]}], ";", "\[IndentingNewLine]", 
     "  ", 
     RowBox[{"rGD", "=", 
      RowBox[{"Max", "[", 
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{"1", "-", 
          RowBox[{"etaGD", " ", "mu"}]}], "]"}], ",", 
        RowBox[{"Abs", "[", 
         RowBox[{"1", "-", 
          RowBox[{"etaGD", " ", "ls"}]}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"hg", "=", 
      RowBox[{"Sqrt", "[", 
       RowBox[{"mu", " ", "ls"}], "]"}]}], ";", "\[IndentingNewLine]", "  ", 
     RowBox[{"rN", "=", 
      RowBox[{"Abs", "[", 
       RowBox[{"1", "-", 
        RowBox[{"etaGD", " ", "hg"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     "  ", 
     RowBox[{"rateGD", "=", 
      RowBox[{"-", 
       RowBox[{"Log", "[", "rGD", "]"}]}]}], ";", "\[IndentingNewLine]", "  ", 
     RowBox[{"rateN", "=", 
      RowBox[{"-", 
       RowBox[{"Log", "[", "rN", "]"}]}]}], ";", "\[IndentingNewLine]", "  ", 
     
     RowBox[{"Print", "[", 
      RowBox[{"k", ",", "\"\< | \>\"", ",", 
       RowBox[{"N", "[", 
        RowBox[{
         RowBox[{"rateN", "/", "rateGD"}], ",", "4"}], "]"}], 
       ",", "\"\< | \>\"", ",", 
       RowBox[{"N", "[", 
        RowBox[{
         RowBox[{"Sqrt", "[", "k", "]"}], ",", "4"}], "]"}]}], "]"}]}], ",", 
    "\[IndentingNewLine]", "  ", 
    RowBox[{"{", 
     RowBox[{"k", ",", "kappaVals"}], "}"}]}], "\[IndentingNewLine]", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<Asymptotic: improvement ~ sqrt(kappa) for large \
kappa\>\"", "]"}], ";"}]}], "Input",ExpressionUUID->"e8052712-cd72-4197-8f21-\
ed5e2afc8ede"],

Cell["Numerical verification on quartic", "Subsection",ExpressionUUID->"2ec7feee-920c-4e07-9ac4-a0ed4006adaa"],

Cell[TextData[{
 "The quartic loss ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["L", "TI"], "\[LongEqual]", 
         UnderscriptBox["\[Sum]", 
          StyleBox["i", "TI"], LimitsPositioning -> True], 
         FractionBox[
          SubscriptBox[
           StyleBox["h", "TI"], 
           StyleBox["i", "TI"]], "2"], 
         SubsuperscriptBox["\[Theta]", 
          StyleBox["i", "TI"], "2"], "+", 
         FractionBox[
          SubscriptBox[
           StyleBox["a", "TI"], 
           StyleBox["i", "TI"]], "4"], 
         SubsuperscriptBox["\[Theta]", 
          StyleBox["i", "TI"], "4"]}], TraditionalForm], "errors" -> {}, 
     "input" -> 
     "L = \\sum_i \\frac{h_i}{2}\\theta_i^2 + \\frac{a_i}{4}\\theta_i^4", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5fab61e3-0096-4c5a-aa8a-fdbc2fd40ec6"],
 " has Hessian-Lipschitz constant ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["L", "TI"], 
          StyleBox["H", "TI"]], "\[LongEqual]", "6", "max", 
         RowBox[{"(", 
           SubscriptBox[
            StyleBox["a", "TI"], 
            StyleBox["i", "TI"]], ")"}]}], TraditionalForm], "errors" -> {}, 
     "input" -> "L_H = 6\\max(a_i)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e804246f-2213-488d-b79d-7519a2b999fe"],
 ". The derived optimizer rate is **independent of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["L", "TI"], 
        StyleBox["H", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "L_H", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "4e8ef913-4637-4b75-a81b-5358f6f995af"],
 "**: "
}], "CodeText",ExpressionUUID->"f5ca17ee-f660-4e6a-b736-1e7bd2fe6433"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Clear", "[", "\"\<Global`*\>\"", "]"}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"Derived", " ", "optimizer", " ", "simulation"}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"derivedSimRate", "[", 
     RowBox[{
     "hVals_", ",", "aVals_", ",", "eta_", ",", "betaS_", ",", "lam_", ",", 
      "c_", ",", "nSteps_", ",", "theta0_"}], "]"}], ":=", 
    "\[IndentingNewLine]", " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "n", ",", "theta", ",", "s", ",", "loss", ",", "grad", ",", "hess", ",",
         "lHist"}], "}"}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"n", "=", 
        RowBox[{"Length", "[", "hVals", "]"}]}], ";", "\[IndentingNewLine]", 
       "  ", 
       RowBox[{"theta", "=", 
        RowBox[{"N", "[", "theta0", "]"}]}], ";", "\[IndentingNewLine]", "  ", 
       RowBox[{"s", "=", 
        RowBox[{"Table", "[", 
         RowBox[{"0.0", ",", 
          RowBox[{"{", "n", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       "  ", 
       RowBox[{"lHist", "=", 
        RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", "  ", 
       RowBox[{"Do", "[", "\[IndentingNewLine]", "    ", 
        RowBox[{
         RowBox[{
          RowBox[{"loss", "=", 
           RowBox[{"Sum", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"hVals", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], "/", "2"}], " ", 
               RowBox[{
                RowBox[{"theta", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], "^", "2"}]}], "+", 
              RowBox[{
               RowBox[{
                RowBox[{"aVals", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], "/", "4"}], " ", 
               RowBox[{
                RowBox[{"theta", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], "^", "4"}]}]}], ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", "n"}], "}"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"grad", "=", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"hVals", "[", 
                RowBox[{"[", "i", "]"}], "]"}], " ", 
               RowBox[{"theta", "[", 
                RowBox[{"[", "i", "]"}], "]"}]}], "+", 
              RowBox[{
               RowBox[{"aVals", "[", 
                RowBox[{"[", "i", "]"}], "]"}], " ", 
               RowBox[{
                RowBox[{"theta", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], "^", "3"}]}]}], ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", "n"}], "}"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"hess", "=", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"hVals", "[", 
               RowBox[{"[", "i", "]"}], "]"}], "+", 
              RowBox[{"3", " ", 
               RowBox[{"aVals", "[", 
                RowBox[{"[", "i", "]"}], "]"}], " ", 
               RowBox[{
                RowBox[{"theta", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], "^", "2"}]}]}], ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", "n"}], "}"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"s", "=", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"1", "-", 
               RowBox[{"betaS", " ", "lam"}]}], ")"}], " ", "s"}], "+", 
            RowBox[{"betaS", " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"-", "lam"}], " ", 
               RowBox[{"Log", "[", 
                RowBox[{"Clip", "[", 
                 RowBox[{"hess", ",", 
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"10.0", "^", 
                    RowBox[{"-", "8"}]}], ",", "Infinity"}], "}"}]}], "]"}], 
                "]"}]}], ")"}]}]}]}], ";", "\[IndentingNewLine]", "    ", 
          RowBox[{"s", "=", 
           RowBox[{"s", "-", 
            RowBox[{"Mean", "[", "s", "]"}]}]}], ";", "\[IndentingNewLine]", 
          "    ", 
          RowBox[{"s", "=", 
           RowBox[{"Clip", "[", 
            RowBox[{"s", ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"-", "c"}], ",", "c"}], "}"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"theta", "=", 
           RowBox[{"theta", "-", 
            RowBox[{"eta", " ", 
             RowBox[{"Exp", "[", "s", "]"}], " ", "grad"}]}]}], ";", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"lHist", ",", "loss"}], "]"}], ";"}], ",", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"{", "nSteps", "}"}]}], "\[IndentingNewLine]", "  ", "]"}], ";",
        "\[IndentingNewLine]", "  ", "lHist"}]}], "\[IndentingNewLine]", 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"hV", "=", 
   RowBox[{"{", 
    RowBox[{"1.0", ",", "100.0"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"theta0", "=", 
   RowBox[{"{", 
    RowBox[{"0.5", ",", "0.5"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"eta", "=", "0.005"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"nS", "=", "3000"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"aVals", "=", 
   RowBox[{"{", 
    RowBox[{"0.0", ",", "0.1", ",", "1.0", ",", "5.0", ",", "10.0"}], "}"}]}],
   ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<=== Derived Optimizer Rate vs L_H (quartic, kappa=100) \
===\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Do", "[", "\[IndentingNewLine]", "  ", 
   RowBox[{
    RowBox[{
     RowBox[{"aV", "=", 
      RowBox[{"{", 
       RowBox[{"a", ",", "a"}], "}"}]}], ";", "\[IndentingNewLine]", "  ", 
     RowBox[{"lDer", "=", 
      RowBox[{"derivedSimRate", "[", 
       RowBox[{
       "hV", ",", "aV", ",", "eta", ",", "0.1", ",", "1.0", ",", "4.0", ",", 
        "nS", ",", "theta0"}], "]"}]}], ";", "\[IndentingNewLine]", "  ", 
     RowBox[{"derRates", "=", 
      RowBox[{"Table", "[", "\[IndentingNewLine]", "    ", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"lDer", "[", 
             RowBox[{"[", "i", "]"}], "]"}], ">", 
            RowBox[{"10.0", "^", 
             RowBox[{"-", "300"}]}]}], "&&", 
           RowBox[{
            RowBox[{"lDer", "[", 
             RowBox[{"[", 
              RowBox[{"i", "+", "1"}], "]"}], "]"}], ">", 
            RowBox[{"10.0", "^", 
             RowBox[{"-", "300"}]}]}]}], ",", "\[IndentingNewLine]", "      ", 
          RowBox[{"-", 
           RowBox[{"Log", "[", 
            RowBox[{
             RowBox[{"lDer", "[", 
              RowBox[{"[", 
               RowBox[{"i", "+", "1"}], "]"}], "]"}], "/", 
             RowBox[{"lDer", "[", 
              RowBox[{"[", "i", "]"}], "]"}]}], "]"}]}], ",", "Nothing"}], 
         "]"}], ",", "\[IndentingNewLine]", "    ", 
        RowBox[{"{", 
         RowBox[{"i", ",", "100", ",", "300"}], "}"}]}], 
       "\[IndentingNewLine]", "  ", "]"}]}], ";", "\[IndentingNewLine]", "  ", 
     RowBox[{"dr", "=", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", "derRates", "]"}], ">", "0"}], ",", 
         RowBox[{"Mean", "[", "derRates", "]"}], ",", "0"}], "]"}], " ", "//",
        " ", "N"}]}], ";", "\[IndentingNewLine]", "  ", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<a=\>\"", ",", "a", ",", "\"\< (L_H=\>\"", ",", 
       RowBox[{"6", " ", "a"}], ",", "\"\<): rate = \>\"", ",", 
       RowBox[{"NumberForm", "[", 
        RowBox[{"dr", ",", "5"}], "]"}]}], "]"}]}], ",", 
    "\[IndentingNewLine]", "  ", 
    RowBox[{"{", 
     RowBox[{"a", ",", "aVals"}], "}"}]}], "\[IndentingNewLine]", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<Predicted rate (2 eta hgeo = 2 * 0.005 * 10): 0.10\>\"", 
   "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<The rate is CONSTANT at ~0.1026 across L_H = 0 to \
60.\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<L_H does not affect the convergence rate.\>\"", "]"}], 
  ";"}]}], "Input",ExpressionUUID->"bae9299e-d6b7-405d-a828-de2025afe1f5"],

Cell["\<\
Comparison across condition numbers (each optimizer at its optimal eta)\
\>", "Subsection",ExpressionUUID->"9174b3c8-5008-4b15-aa85-1b3312429b93"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Clear", "[", "\"\<Global`*\>\"", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"derivedSimComp", "[", 
     RowBox[{
     "hVals_", ",", "aVals_", ",", "eta_", ",", "betaS_", ",", "lam_", ",", 
      "c_", ",", "nSteps_", ",", "theta0_"}], "]"}], ":=", 
    "\[IndentingNewLine]", " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "n", ",", "theta", ",", "s", ",", "loss", ",", "grad", ",", "hess", ",",
         "lHist"}], "}"}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"n", "=", 
        RowBox[{"Length", "[", "hVals", "]"}]}], ";", "\[IndentingNewLine]", 
       "  ", 
       RowBox[{"theta", "=", 
        RowBox[{"N", "[", "theta0", "]"}]}], ";", "\[IndentingNewLine]", "  ", 
       RowBox[{"s", "=", 
        RowBox[{"Table", "[", 
         RowBox[{"0.0", ",", 
          RowBox[{"{", "n", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       "  ", 
       RowBox[{"lHist", "=", 
        RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", "  ", 
       RowBox[{"Do", "[", "\[IndentingNewLine]", "    ", 
        RowBox[{
         RowBox[{
          RowBox[{"loss", "=", 
           RowBox[{"Sum", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"hVals", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], "/", "2"}], " ", 
               RowBox[{
                RowBox[{"theta", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], "^", "2"}]}], "+", 
              RowBox[{
               RowBox[{
                RowBox[{"aVals", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], "/", "4"}], " ", 
               RowBox[{
                RowBox[{"theta", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], "^", "4"}]}]}], ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", "n"}], "}"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"grad", "=", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"hVals", "[", 
                RowBox[{"[", "i", "]"}], "]"}], " ", 
               RowBox[{"theta", "[", 
                RowBox[{"[", "i", "]"}], "]"}]}], "+", 
              RowBox[{
               RowBox[{"aVals", "[", 
                RowBox[{"[", "i", "]"}], "]"}], " ", 
               RowBox[{
                RowBox[{"theta", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], "^", "3"}]}]}], ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", "n"}], "}"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"hess", "=", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"hVals", "[", 
               RowBox[{"[", "i", "]"}], "]"}], "+", 
              RowBox[{"3", " ", 
               RowBox[{"aVals", "[", 
                RowBox[{"[", "i", "]"}], "]"}], " ", 
               RowBox[{
                RowBox[{"theta", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], "^", "2"}]}]}], ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", "n"}], "}"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"s", "=", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"1", "-", 
               RowBox[{"betaS", " ", "lam"}]}], ")"}], " ", "s"}], "+", 
            RowBox[{"betaS", " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"-", "lam"}], " ", 
               RowBox[{"Log", "[", 
                RowBox[{"Clip", "[", 
                 RowBox[{"hess", ",", 
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"10.0", "^", 
                    RowBox[{"-", "8"}]}], ",", "Infinity"}], "}"}]}], "]"}], 
                "]"}]}], ")"}]}]}]}], ";", "\[IndentingNewLine]", "    ", 
          RowBox[{"s", "=", 
           RowBox[{"s", "-", 
            RowBox[{"Mean", "[", "s", "]"}]}]}], ";", "\[IndentingNewLine]", 
          "    ", 
          RowBox[{"s", "=", 
           RowBox[{"Clip", "[", 
            RowBox[{"s", ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"-", "c"}], ",", "c"}], "}"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"theta", "=", 
           RowBox[{"theta", "-", 
            RowBox[{"eta", " ", 
             RowBox[{"Exp", "[", "s", "]"}], " ", "grad"}]}]}], ";", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"lHist", ",", "loss"}], "]"}], ";"}], ",", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"{", "nSteps", "}"}]}], "\[IndentingNewLine]", "  ", "]"}], ";",
        "\[IndentingNewLine]", "  ", "lHist"}]}], "\[IndentingNewLine]", 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"gdSimComp", "[", 
     RowBox[{
     "hVals_", ",", "aVals_", ",", "eta_", ",", "nSteps_", ",", "theta0_"}], 
     "]"}], ":=", "\[IndentingNewLine]", " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"n", ",", "theta", ",", "loss", ",", "grad", ",", "lHist"}], 
       "}"}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"n", "=", 
        RowBox[{"Length", "[", "hVals", "]"}]}], ";", "\[IndentingNewLine]", 
       "  ", 
       RowBox[{"theta", "=", 
        RowBox[{"N", "[", "theta0", "]"}]}], ";", "\[IndentingNewLine]", "  ", 
       RowBox[{"lHist", "=", 
        RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", "  ", 
       RowBox[{"Do", "[", "\[IndentingNewLine]", "    ", 
        RowBox[{
         RowBox[{
          RowBox[{"loss", "=", 
           RowBox[{"Sum", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"hVals", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], "/", "2"}], " ", 
               RowBox[{
                RowBox[{"theta", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], "^", "2"}]}], "+", 
              RowBox[{
               RowBox[{
                RowBox[{"aVals", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], "/", "4"}], " ", 
               RowBox[{
                RowBox[{"theta", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], "^", "4"}]}]}], ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", "n"}], "}"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"grad", "=", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"hVals", "[", 
                RowBox[{"[", "i", "]"}], "]"}], " ", 
               RowBox[{"theta", "[", 
                RowBox[{"[", "i", "]"}], "]"}]}], "+", 
              RowBox[{
               RowBox[{"aVals", "[", 
                RowBox[{"[", "i", "]"}], "]"}], " ", 
               RowBox[{
                RowBox[{"theta", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], "^", "3"}]}]}], ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", "n"}], "}"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"theta", "=", 
           RowBox[{"theta", "-", 
            RowBox[{"eta", " ", "grad"}]}]}], ";", "\[IndentingNewLine]", 
          "    ", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"loss", ">", 
             RowBox[{"10", "^", "20"}]}], ",", 
            RowBox[{"Return", "[", "lHist", "]"}]}], "]"}], ";", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"lHist", ",", "loss"}], "]"}], ";"}], ",", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"{", "nSteps", "}"}]}], "\[IndentingNewLine]", "  ", "]"}], ";",
        "\[IndentingNewLine]", "  ", "lHist"}]}], "\[IndentingNewLine]", 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<=== Optimal-eta Comparison on Quartic (a=1, L_H=6) ===\>\
\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"kappaVals", "=", 
   RowBox[{"{", 
    RowBox[{"10", ",", "100", ",", "1000"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Do", "[", "\[IndentingNewLine]", "  ", 
   RowBox[{
    RowBox[{
     RowBox[{"hV", "=", 
      RowBox[{"{", 
       RowBox[{"1.0", ",", 
        RowBox[{"N", "[", "k", "]"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
     "  ", 
     RowBox[{"aV", "=", 
      RowBox[{"{", 
       RowBox[{"1.0", ",", "1.0"}], "}"}]}], ";", "\[IndentingNewLine]", "  ", 
     RowBox[{"theta0", "=", 
      RowBox[{"{", 
       RowBox[{"0.3", ",", "0.3"}], "}"}]}], ";", "\[IndentingNewLine]", "  ", 
     RowBox[{"nS", "=", "5000"}], ";", "\[IndentingNewLine]", "  ", 
     RowBox[{"hgeo", "=", 
      RowBox[{"Sqrt", "[", 
       RowBox[{"N", "[", "k", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     "  ", 
     RowBox[{"etaDer", "=", 
      RowBox[{"0.1", "/", "hgeo"}]}], ";", "\[IndentingNewLine]", "  ", 
     RowBox[{"etaGD", "=", 
      RowBox[{"2.0", "/", 
       RowBox[{"(", 
        RowBox[{"1.0", "+", 
         RowBox[{"N", "[", "k", "]"}], "+", 
         RowBox[{"3.0", " ", 
          RowBox[{"0.3", "^", "2"}]}]}], ")"}]}]}], ";", 
     "\[IndentingNewLine]", "  ", "\[IndentingNewLine]", "  ", 
     RowBox[{"lD", "=", 
      RowBox[{"derivedSimComp", "[", 
       RowBox[{
       "hV", ",", "aV", ",", "etaDer", ",", "0.1", ",", "1.0", ",", "4.0", ",",
         "nS", ",", "theta0"}], "]"}]}], ";", "\[IndentingNewLine]", "  ", 
     RowBox[{"lG", "=", 
      RowBox[{"gdSimComp", "[", 
       RowBox[{"hV", ",", "aV", ",", "etaGD", ",", "nS", ",", "theta0"}], 
       "]"}]}], ";", "\[IndentingNewLine]", "  ", "\[IndentingNewLine]", "  ", 
     RowBox[{"dRates", "=", 
      RowBox[{"Table", "[", "\[IndentingNewLine]", "    ", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"i", "<=", 
            RowBox[{
             RowBox[{"Length", "[", "lD", "]"}], "-", "1"}]}], "&&", 
           RowBox[{
            RowBox[{"lD", "[", 
             RowBox[{"[", "i", "]"}], "]"}], ">", 
            RowBox[{"10.0", "^", 
             RowBox[{"-", "280"}]}]}], "&&", 
           RowBox[{
            RowBox[{"lD", "[", 
             RowBox[{"[", 
              RowBox[{"i", "+", "1"}], "]"}], "]"}], ">", 
            RowBox[{"10.0", "^", 
             RowBox[{"-", "280"}]}]}]}], ",", "\[IndentingNewLine]", "      ", 
          RowBox[{"-", 
           RowBox[{"Log", "[", 
            RowBox[{
             RowBox[{"lD", "[", 
              RowBox[{"[", 
               RowBox[{"i", "+", "1"}], "]"}], "]"}], "/", 
             RowBox[{"lD", "[", 
              RowBox[{"[", "i", "]"}], "]"}]}], "]"}]}], ",", "Nothing"}], 
         "]"}], ",", "\[IndentingNewLine]", "    ", 
        RowBox[{"{", 
         RowBox[{"i", ",", 
          RowBox[{"Min", "[", 
           RowBox[{"200", ",", 
            RowBox[{
             RowBox[{"Length", "[", "lD", "]"}], "-", "1"}]}], "]"}], ",", 
          RowBox[{"Min", "[", 
           RowBox[{"500", ",", 
            RowBox[{
             RowBox[{"Length", "[", "lD", "]"}], "-", "1"}]}], "]"}]}], 
         "}"}]}], "\[IndentingNewLine]", "  ", "]"}]}], ";", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"gRates", "=", 
      RowBox[{"Table", "[", "\[IndentingNewLine]", "    ", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"i", "<=", 
            RowBox[{
             RowBox[{"Length", "[", "lG", "]"}], "-", "1"}]}], "&&", 
           RowBox[{
            RowBox[{"lG", "[", 
             RowBox[{"[", "i", "]"}], "]"}], ">", 
            RowBox[{"10.0", "^", 
             RowBox[{"-", "280"}]}]}], "&&", 
           RowBox[{
            RowBox[{"lG", "[", 
             RowBox[{"[", 
              RowBox[{"i", "+", "1"}], "]"}], "]"}], ">", 
            RowBox[{"10.0", "^", 
             RowBox[{"-", "280"}]}]}]}], ",", "\[IndentingNewLine]", "      ", 
          RowBox[{"-", 
           RowBox[{"Log", "[", 
            RowBox[{
             RowBox[{"lG", "[", 
              RowBox[{"[", 
               RowBox[{"i", "+", "1"}], "]"}], "]"}], "/", 
             RowBox[{"lG", "[", 
              RowBox[{"[", "i", "]"}], "]"}]}], "]"}]}], ",", "Nothing"}], 
         "]"}], ",", "\[IndentingNewLine]", "    ", 
        RowBox[{"{", 
         RowBox[{"i", ",", 
          RowBox[{"Min", "[", 
           RowBox[{"200", ",", 
            RowBox[{
             RowBox[{"Length", "[", "lG", "]"}], "-", "1"}]}], "]"}], ",", 
          RowBox[{"Min", "[", 
           RowBox[{"500", ",", 
            RowBox[{
             RowBox[{"Length", "[", "lG", "]"}], "-", "1"}]}], "]"}]}], 
         "}"}]}], "\[IndentingNewLine]", "  ", "]"}]}], ";", 
     "\[IndentingNewLine]", "  ", "\[IndentingNewLine]", "  ", 
     RowBox[{"dr", "=", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", "dRates", "]"}], ">", "0"}], ",", 
         RowBox[{"Mean", "[", "dRates", "]"}], ",", "0"}], "]"}], " ", "//", 
       " ", "N"}]}], ";", "\[IndentingNewLine]", "  ", 
     RowBox[{"gr", "=", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", "gRates", "]"}], ">", "0"}], ",", 
         RowBox[{"Mean", "[", "gRates", "]"}], ",", "0"}], "]"}], " ", "//", 
       " ", "N"}]}], ";", "\[IndentingNewLine]", "  ", 
     RowBox[{"imp", "=", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"gr", ">", "0"}], ",", 
         RowBox[{"dr", "/", "gr"}], ",", "0"}], "]"}], " ", "//", " ", 
       "N"}]}], ";", "\[IndentingNewLine]", "  ", "\[IndentingNewLine]", "  ", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<kappa=\>\"", ",", "k", ",", "\"\<: Derived=\>\"", ",", 
       RowBox[{"NumberForm", "[", 
        RowBox[{"dr", ",", "4"}], "]"}], ",", "\[IndentingNewLine]", 
       "    ", "\"\< GD=\>\"", ",", 
       RowBox[{"NumberForm", "[", 
        RowBox[{"gr", ",", "4"}], "]"}], ",", "\[IndentingNewLine]", 
       "    ", "\"\< Ratio=\>\"", ",", 
       RowBox[{"NumberForm", "[", 
        RowBox[{"imp", ",", "3"}], "]"}], ",", "\"\<x\>\""}], "]"}]}], ",", 
    "\[IndentingNewLine]", "  ", 
    RowBox[{"{", 
     RowBox[{"k", ",", "kappaVals"}], "}"}]}], "\[IndentingNewLine]", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<Derived rate is CONSTANT (~0.21) across all kappa.\>\"", 
   "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", "\"\<GD rate degrades as ~4/kappa.\>\"", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<Improvement ~ sqrt(kappa)/2 for large kappa.\>\"", "]"}],
   ";"}]}], "Input",ExpressionUUID->"5f204ed8-7b66-4557-afe7-cadb1233f2e0"],

Cell["6. Lyapunov Monotonicity Verification", "Section",ExpressionUUID->"849f35c3-4ad6-4095-9f9e-a44a7d976fe7"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Clear", "[", "\"\<Global`*\>\"", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"derivedSimVHist", "[", 
     RowBox[{
     "hVals_", ",", "aVals_", ",", "eta_", ",", "betaS_", ",", "lam_", ",", 
      "c_", ",", "nSteps_", ",", "theta0_"}], "]"}], ":=", 
    "\[IndentingNewLine]", " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "n", ",", "theta", ",", "s", ",", "loss", ",", "grad", ",", "hess", ",",
         "lHist", ",", "vHist", ",", "sStar"}], "}"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"n", "=", 
        RowBox[{"Length", "[", "hVals", "]"}]}], ";", "\[IndentingNewLine]", 
       "  ", 
       RowBox[{"theta", "=", 
        RowBox[{"N", "[", "theta0", "]"}]}], ";", "\[IndentingNewLine]", "  ", 
       RowBox[{"s", "=", 
        RowBox[{"Table", "[", 
         RowBox[{"0.0", ",", 
          RowBox[{"{", "n", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       "  ", 
       RowBox[{"lHist", "=", 
        RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", "  ", 
       RowBox[{"vHist", "=", 
        RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", "  ", 
       RowBox[{"Do", "[", "\[IndentingNewLine]", "    ", 
        RowBox[{
         RowBox[{
          RowBox[{"loss", "=", 
           RowBox[{"Sum", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"hVals", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], "/", "2"}], " ", 
               RowBox[{
                RowBox[{"theta", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], "^", "2"}]}], "+", 
              RowBox[{
               RowBox[{
                RowBox[{"aVals", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], "/", "4"}], " ", 
               RowBox[{
                RowBox[{"theta", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], "^", "4"}]}]}], ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", "n"}], "}"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"grad", "=", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"hVals", "[", 
                RowBox[{"[", "i", "]"}], "]"}], " ", 
               RowBox[{"theta", "[", 
                RowBox[{"[", "i", "]"}], "]"}]}], "+", 
              RowBox[{
               RowBox[{"aVals", "[", 
                RowBox[{"[", "i", "]"}], "]"}], " ", 
               RowBox[{
                RowBox[{"theta", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], "^", "3"}]}]}], ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", "n"}], "}"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"hess", "=", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"hVals", "[", 
               RowBox[{"[", "i", "]"}], "]"}], "+", 
              RowBox[{"3", " ", 
               RowBox[{"aVals", "[", 
                RowBox[{"[", "i", "]"}], "]"}], " ", 
               RowBox[{
                RowBox[{"theta", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], "^", "2"}]}]}], ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", "n"}], "}"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"s", "=", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"1", "-", 
               RowBox[{"betaS", " ", "lam"}]}], ")"}], " ", "s"}], "+", 
            RowBox[{"betaS", " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"-", "lam"}], " ", 
               RowBox[{"Log", "[", 
                RowBox[{"Clip", "[", 
                 RowBox[{"hess", ",", 
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"10.0", "^", 
                    RowBox[{"-", "8"}]}], ",", "Infinity"}], "}"}]}], "]"}], 
                "]"}]}], ")"}]}]}]}], ";", "\[IndentingNewLine]", "    ", 
          RowBox[{"s", "=", 
           RowBox[{"s", "-", 
            RowBox[{"Mean", "[", "s", "]"}]}]}], ";", "\[IndentingNewLine]", 
          "    ", 
          RowBox[{"s", "=", 
           RowBox[{"Clip", "[", 
            RowBox[{"s", ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"-", "c"}], ",", "c"}], "}"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"theta", "=", 
           RowBox[{"theta", "-", 
            RowBox[{"eta", " ", 
             RowBox[{"Exp", "[", "s", "]"}], " ", "grad"}]}]}], ";", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"sStar", "=", 
           RowBox[{"-", 
            RowBox[{"Log", "[", 
             RowBox[{"N", "[", "hVals", "]"}], "]"}]}]}], ";", " ", 
          RowBox[{"sStar", "=", 
           RowBox[{"sStar", "-", 
            RowBox[{"Mean", "[", "sStar", "]"}]}]}], ";", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"vLyap", "=", 
           RowBox[{"loss", "+", 
            RowBox[{"0.01", " ", 
             RowBox[{
              RowBox[{"Total", "[", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"s", "-", "sStar"}], ")"}], "^", "2"}], "]"}], "/", 
              "2"}]}]}]}], ";", "\[IndentingNewLine]", "    ", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"lHist", ",", "loss"}], "]"}], ";", "\[IndentingNewLine]", 
          "    ", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"vHist", ",", "vLyap"}], "]"}], ";"}], ",", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"{", "nSteps", "}"}]}], "\[IndentingNewLine]", "  ", "]"}], ";",
        "\[IndentingNewLine]", "  ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<L\>\"", "->", "lHist"}], ",", 
         RowBox[{"\"\<V\>\"", "->", "vHist"}]}], "|>"}]}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"hV", "=", 
   RowBox[{"{", 
    RowBox[{"1.0", ",", "100.0"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"nS", "=", "3000"}], ";"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Test", " ", "1"}], ":", " ", 
    RowBox[{"Moderate", " ", "L_H"}]}], " ", 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"aV", "=", 
   RowBox[{"{", 
    RowBox[{"1.0", ",", "1.0"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"res1", "=", 
   RowBox[{"derivedSimVHist", "[", 
    RowBox[{
    "hV", ",", "aV", ",", "0.005", ",", "0.1", ",", "1.0", ",", "4.0", ",", 
     "nS", ",", 
     RowBox[{"{", 
      RowBox[{"0.5", ",", "0.5"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dV1", "=", 
   RowBox[{"Differences", "[", 
    RowBox[{"res1", "[", "\"\<V\>\"", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"viol1", "=", 
   RowBox[{"Count", "[", 
    RowBox[{"dV1", ",", 
     RowBox[{"x_", " ", "/;", " ", 
      RowBox[{"x", ">", 
       RowBox[{"10", "^", 
        RowBox[{"-", "15"}]}]}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Print", "[", 
    RowBox[{"\"\<Quartic (a=1, L_H=6): \>\"", ",", "viol1", ",", "\"\</\>\"", 
     ",", 
     RowBox[{"Length", "[", "dV1", "]"}], ",", "\"\< violations\>\""}], "]"}],
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Test", " ", "2"}], ":", " ", 
    RowBox[{"Large", " ", "L_H"}]}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"aV", "=", 
   RowBox[{"{", 
    RowBox[{"10.0", ",", "10.0"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"res2", "=", 
   RowBox[{"derivedSimVHist", "[", 
    RowBox[{
    "hV", ",", "aV", ",", "0.005", ",", "0.1", ",", "1.0", ",", "4.0", ",", 
     "nS", ",", 
     RowBox[{"{", 
      RowBox[{"0.5", ",", "0.5"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dV2", "=", 
   RowBox[{"Differences", "[", 
    RowBox[{"res2", "[", "\"\<V\>\"", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"viol2", "=", 
   RowBox[{"Count", "[", 
    RowBox[{"dV2", ",", 
     RowBox[{"x_", " ", "/;", " ", 
      RowBox[{"x", ">", 
       RowBox[{"10", "^", 
        RowBox[{"-", "15"}]}]}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Print", "[", 
    RowBox[{"\"\<Quartic (a=10, L_H=60): \>\"", ",", "viol2", ",", "\"\</\>\"",
      ",", 
     RowBox[{"Length", "[", "dV2", "]"}], ",", "\"\< violations\>\""}], "]"}],
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Test", " ", "3"}], ":", " ", 
    RowBox[{"Very", " ", "large", " ", "L_H"}]}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"aV", "=", 
   RowBox[{"{", 
    RowBox[{"50.0", ",", "50.0"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"res3", "=", 
   RowBox[{"derivedSimVHist", "[", 
    RowBox[{
    "hV", ",", "aV", ",", "0.005", ",", "0.1", ",", "1.0", ",", "4.0", ",", 
     "nS", ",", 
     RowBox[{"{", 
      RowBox[{"0.5", ",", "0.5"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dV3", "=", 
   RowBox[{"Differences", "[", 
    RowBox[{"res3", "[", "\"\<V\>\"", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"viol3", "=", 
   RowBox[{"Count", "[", 
    RowBox[{"dV3", ",", 
     RowBox[{"x_", " ", "/;", " ", 
      RowBox[{"x", ">", 
       RowBox[{"10", "^", 
        RowBox[{"-", "15"}]}]}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Print", "[", 
    RowBox[{"\"\<Quartic (a=50, L_H=300): \>\"", ",", "viol3", 
     ",", "\"\</\>\"", ",", 
     RowBox[{"Length", "[", "dV3", "]"}], ",", "\"\< violations\>\""}], "]"}],
    ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<ZERO Lyapunov violations across all L_H values.\>\"", 
   "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<The fixed-target Lyapunov W(theta,s) is monotonically \
decreasing.\>\"", "]"}], ";"}]}], "Input",ExpressionUUID->"d42dca59-64ad-49e6-\
b09c-b255f3540647"],

Cell["7. Rosenbrock Function Verification", "Section",ExpressionUUID->"90e8d472-c9f9-412a-8deb-d4506452a964"],

Cell[TextData[{
 "The Rosenbrock function ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["L", "TI"], "\[LongEqual]", 
         SuperscriptBox[
          RowBox[{"(", 
            RowBox[{"1", "-", 
              StyleBox["x", "TI"]}], ")"}], "2"], "+", "100", 
         SuperscriptBox[
          RowBox[{"(", 
            RowBox[{
              StyleBox["y", "TI"], "-", 
              SuperscriptBox[
               StyleBox["x", "TI"], "2"]}], ")"}], "2"]}], TraditionalForm], 
     "errors" -> {}, "input" -> "L = (1-x)^2 + 100(y-x^2)^2", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e8d4f9cd-4474-4c6e-834b-e408bba9f67b"],
 " is a classic non-quadratic benchmark with ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Kappa]", "\[TildeTilde]", "4"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\kappa \\approx 4", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5f9e4fa2-711e-4c9b-a3c8-f2f0dfd06fbb"],
 " at the minimum. "
}], "Text",ExpressionUUID->"8612a597-111b-47c6-9291-2ad8a1ecb2b6"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Clear", "[", "\"\<Global`*\>\"", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"hStarRos", "=", 
   RowBox[{"{", 
    RowBox[{"802.0", ",", "200.0"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sStarRos", "=", 
   RowBox[{"-", 
    RowBox[{"Log", "[", "hStarRos", "]"}]}]}], ";", " ", 
  RowBox[{"sStarRos", "=", 
   RowBox[{"sStarRos", "-", 
    RowBox[{"Mean", "[", "sStarRos", "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", "\"\<Rosenbrock at minimum (1,1):\>\"", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", "\"\<  H* = diag(802, 200)\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<  s* = \>\"", ",", "sStarRos"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<  hgeo = \>\"", ",", 
    RowBox[{"Sqrt", "[", 
     RowBox[{"802.0", "*", "200.0"}], "]"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Print", "[", 
    RowBox[{"\"\<  kappa_diag = \>\"", ",", 
     RowBox[{"802.0", "/", "200.0"}]}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"rosenbrockSim", "[", 
     RowBox[{
     "eta_", ",", "betaS_", ",", "lam_", ",", "c_", ",", "nSteps_", ",", 
      "x0_", ",", "y0_"}], "]"}], ":=", "\[IndentingNewLine]", " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "x", ",", "y", ",", "sx", ",", "sy", ",", "loss", ",", "gx", ",", "gy",
         ",", "hxx", ",", "hyy", ",", "lHist", ",", "sHist", ",", "sm"}], 
       "}"}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"x", "=", 
        RowBox[{"N", "[", "x0", "]"}]}], ";", " ", 
       RowBox[{"y", "=", 
        RowBox[{"N", "[", "y0", "]"}]}], ";", "\[IndentingNewLine]", "  ", 
       RowBox[{"sx", "=", "0.0"}], ";", " ", 
       RowBox[{"sy", "=", "0.0"}], ";", "\[IndentingNewLine]", "  ", 
       RowBox[{"lHist", "=", 
        RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", "  ", 
       RowBox[{"sHist", "=", 
        RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", "  ", 
       RowBox[{"Do", "[", "\[IndentingNewLine]", "    ", 
        RowBox[{
         RowBox[{
          RowBox[{"loss", "=", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"1", "-", "x"}], ")"}], "^", "2"}], "+", 
            RowBox[{"100", " ", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"y", "-", 
                RowBox[{"x", "^", "2"}]}], ")"}], "^", "2"}]}]}]}], ";", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"gx", "=", 
           RowBox[{
            RowBox[{
             RowBox[{"-", "2"}], " ", 
             RowBox[{"(", 
              RowBox[{"1", "-", "x"}], ")"}]}], "-", 
            RowBox[{"400", " ", "x", " ", 
             RowBox[{"(", 
              RowBox[{"y", "-", 
               RowBox[{"x", "^", "2"}]}], ")"}]}]}]}], ";", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"gy", "=", 
           RowBox[{"200", " ", 
            RowBox[{"(", 
             RowBox[{"y", "-", 
              RowBox[{"x", "^", "2"}]}], ")"}]}]}], ";", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"hxx", "=", 
           RowBox[{"2", "-", 
            RowBox[{"400", " ", 
             RowBox[{"(", 
              RowBox[{"y", "-", 
               RowBox[{"x", "^", "2"}]}], ")"}]}], "+", 
            RowBox[{"800", " ", 
             RowBox[{"x", "^", "2"}]}]}]}], ";", "\[IndentingNewLine]", 
          "    ", 
          RowBox[{"hyy", "=", "200.0"}], ";", "\[IndentingNewLine]", "    ", 
          RowBox[{"sx", "=", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"1", "-", 
               RowBox[{"betaS", " ", "lam"}]}], ")"}], " ", "sx"}], "+", 
            RowBox[{"betaS", " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"-", "lam"}], " ", 
               RowBox[{"Log", "[", 
                RowBox[{"Max", "[", 
                 RowBox[{
                  RowBox[{"Abs", "[", "hxx", "]"}], ",", 
                  RowBox[{"10.0", "^", 
                   RowBox[{"-", "8"}]}]}], "]"}], "]"}]}], ")"}]}]}]}], ";", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"sy", "=", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"1", "-", 
               RowBox[{"betaS", " ", "lam"}]}], ")"}], " ", "sy"}], "+", 
            RowBox[{"betaS", " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"-", "lam"}], " ", 
               RowBox[{"Log", "[", 
                RowBox[{"Max", "[", 
                 RowBox[{
                  RowBox[{"Abs", "[", "hyy", "]"}], ",", 
                  RowBox[{"10.0", "^", 
                   RowBox[{"-", "8"}]}]}], "]"}], "]"}]}], ")"}]}]}]}], ";", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"sm", "=", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"sx", "+", "sy"}], ")"}], "/", "2"}]}], ";", " ", 
          RowBox[{"sx", "=", 
           RowBox[{"sx", "-", "sm"}]}], ";", " ", 
          RowBox[{"sy", "=", 
           RowBox[{"sy", "-", "sm"}]}], ";", "\[IndentingNewLine]", "    ", 
          RowBox[{"sx", "=", 
           RowBox[{"Clip", "[", 
            RowBox[{"sx", ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"-", "c"}], ",", "c"}], "}"}]}], "]"}]}], ";", " ", 
          RowBox[{"sy", "=", 
           RowBox[{"Clip", "[", 
            RowBox[{"sy", ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"-", "c"}], ",", "c"}], "}"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"x", "=", 
           RowBox[{"x", "-", 
            RowBox[{"eta", " ", 
             RowBox[{"Exp", "[", "sx", "]"}], " ", "gx"}]}]}], ";", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"y", "=", 
           RowBox[{"y", "-", 
            RowBox[{"eta", " ", 
             RowBox[{"Exp", "[", "sy", "]"}], " ", "gy"}]}]}], ";", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"lHist", ",", "loss"}], "]"}], ";", "\[IndentingNewLine]", 
          "    ", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"sHist", ",", 
            RowBox[{"{", 
             RowBox[{"sx", ",", "sy"}], "}"}]}], "]"}], ";"}], ",", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"{", "nSteps", "}"}]}], "\[IndentingNewLine]", "  ", "]"}], ";",
        "\[IndentingNewLine]", "  ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<L\>\"", "->", "lHist"}], ",", 
         RowBox[{"\"\<s\>\"", "->", "sHist"}]}], "|>"}]}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"rosenGD", "[", 
     RowBox[{"eta_", ",", "nSteps_", ",", "x0_", ",", "y0_"}], "]"}], ":=", 
    "\[IndentingNewLine]", " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "x", ",", "y", ",", "loss", ",", "gx", ",", "gy", ",", "lHist"}], 
       "}"}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"x", "=", 
        RowBox[{"N", "[", "x0", "]"}]}], ";", " ", 
       RowBox[{"y", "=", 
        RowBox[{"N", "[", "y0", "]"}]}], ";", "\[IndentingNewLine]", "  ", 
       RowBox[{"lHist", "=", 
        RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", "  ", 
       RowBox[{"Do", "[", "\[IndentingNewLine]", "    ", 
        RowBox[{
         RowBox[{
          RowBox[{"loss", "=", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"1", "-", "x"}], ")"}], "^", "2"}], "+", 
            RowBox[{"100", " ", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"y", "-", 
                RowBox[{"x", "^", "2"}]}], ")"}], "^", "2"}]}]}]}], ";", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"gx", "=", 
           RowBox[{
            RowBox[{
             RowBox[{"-", "2"}], " ", 
             RowBox[{"(", 
              RowBox[{"1", "-", "x"}], ")"}]}], "-", 
            RowBox[{"400", " ", "x", " ", 
             RowBox[{"(", 
              RowBox[{"y", "-", 
               RowBox[{"x", "^", "2"}]}], ")"}]}]}]}], ";", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"gy", "=", 
           RowBox[{"200", " ", 
            RowBox[{"(", 
             RowBox[{"y", "-", 
              RowBox[{"x", "^", "2"}]}], ")"}]}]}], ";", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"x", "=", 
           RowBox[{"x", "-", 
            RowBox[{"eta", " ", "gx"}]}]}], ";", "\[IndentingNewLine]", 
          "    ", 
          RowBox[{"y", "=", 
           RowBox[{"y", "-", 
            RowBox[{"eta", " ", "gy"}]}]}], ";", "\[IndentingNewLine]", 
          "    ", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"lHist", ",", "loss"}], "]"}], ";"}], ",", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"{", "nSteps", "}"}]}], "\[IndentingNewLine]", "  ", "]"}], ";",
        "\[IndentingNewLine]", "  ", "lHist"}]}], "\[IndentingNewLine]", 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<=== Rosenbrock: Derived vs GD (same eta, 30000 steps) \
===\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"etaVals", "=", 
   RowBox[{"{", 
    RowBox[{"0.001", ",", "0.0005"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Do", "[", "\[IndentingNewLine]", "  ", 
   RowBox[{
    RowBox[{
     RowBox[{"nS", "=", "30000"}], ";", "\[IndentingNewLine]", "  ", 
     RowBox[{"resDer", "=", 
      RowBox[{"rosenbrockSim", "[", 
       RowBox[{"ev", ",", "0.05", ",", "1.0", ",", "2.0", ",", "nS", ",", 
        RowBox[{"-", "1.2"}], ",", "1.0"}], "]"}]}], ";", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"resGD", "=", 
      RowBox[{"rosenGD", "[", 
       RowBox[{"ev", ",", "nS", ",", 
        RowBox[{"-", "1.2"}], ",", "1.0"}], "]"}]}], ";", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<eta=\>\"", ",", "ev", ",", "\"\<:\>\""}], "]"}], ";", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<  Derived final loss: \>\"", ",", 
       RowBox[{
        RowBox[{"resDer", "[", "\"\<L\>\"", "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"-", "1"}], "]"}], "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<  GD final loss: \>\"", ",", 
       RowBox[{"resGD", "[", 
        RowBox[{"[", 
         RowBox[{"-", "1"}], "]"}], "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<  Derived final s: \>\"", ",", 
       RowBox[{
        RowBox[{"resDer", "[", "\"\<s\>\"", "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"-", "1"}], "]"}], "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<  Ratio (GD/Derived): \>\"", ",", 
       RowBox[{
        RowBox[{"resGD", "[", 
         RowBox[{"[", 
          RowBox[{"-", "1"}], "]"}], "]"}], "/", 
        RowBox[{
         RowBox[{"resDer", "[", "\"\<L\>\"", "]"}], "[", 
         RowBox[{"[", 
          RowBox[{"-", "1"}], "]"}], "]"}]}]}], "]"}]}], ",", 
    "\[IndentingNewLine]", "  ", 
    RowBox[{"{", 
     RowBox[{"ev", ",", "etaVals"}], "}"}]}], "\[IndentingNewLine]", "]"}], 
  ";"}]}], "Input",ExpressionUUID->"d2eb0c29-b85c-4e8b-9ff5-c38b0a8b3917"],

Cell["8. Basin of Attraction", "Section",ExpressionUUID->"663906f2-ef3d-4df3-af0c-8f5535aabd84"],

Cell[TextData[{
 "The local theory predicts a basin of radius ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Rho]", "\[LongEqual]", 
         SubsuperscriptBox["\[Mu]", 
          RowBox[{
            StyleBox["s", "TI"], 
            StyleBox["c", "TI"]}], "2"], " ", 
         SuperscriptBox[
          StyleBox["e", "TI"], 
          RowBox[{"-2", 
            StyleBox["c", "TI"]}]], " ", "/", 
         RowBox[{"(", 
           RowBox[{"2 ", 
             SubscriptBox[
              StyleBox["L", "TI"], 
              RowBox[{
                StyleBox["s", "TI"], 
                StyleBox["c", "TI"]}]], " ", 
             SubscriptBox[
              StyleBox["L", "TI"], 
              StyleBox["H", "TI"]]}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\rho = \\mu_{sc}^2\\, e^{-2c}\\, / (2\\, L_{sc}\\, L_H)", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "19fbebfe-dc86-497a-bef4-aa92ad37a7a2"],
 ". In practice, the denominator ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["r", "TI"], "\[LongEqual]", "1", "/", 
         RowBox[{"(", 
           RowBox[{"1", "+", "|", 
             StyleBox["v", "TI"], "|"}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> "r = 1/(1 + |v|)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "902c9397-d2a9-4245-8b9f-42906eee8871"],
 " extends the basin far beyond this. "
}], "Text",ExpressionUUID->"580fab58-30dc-4348-aa30-38668f1f3c7a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Clear", "[", "\"\<Global`*\>\"", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"derivedSimBasin", "[", 
     RowBox[{
     "hVals_", ",", "aVals_", ",", "eta_", ",", "betaS_", ",", "lam_", ",", 
      "c_", ",", "nSteps_", ",", "theta0_"}], "]"}], ":=", 
    "\[IndentingNewLine]", " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "n", ",", "theta", ",", "s", ",", "loss", ",", "grad", ",", "hess", ",",
         "lHist"}], "}"}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"n", "=", 
        RowBox[{"Length", "[", "hVals", "]"}]}], ";", "\[IndentingNewLine]", 
       "  ", 
       RowBox[{"theta", "=", 
        RowBox[{"N", "[", "theta0", "]"}]}], ";", "\[IndentingNewLine]", "  ", 
       RowBox[{"s", "=", 
        RowBox[{"Table", "[", 
         RowBox[{"0.0", ",", 
          RowBox[{"{", "n", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       "  ", 
       RowBox[{"lHist", "=", 
        RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", "  ", 
       RowBox[{"Do", "[", "\[IndentingNewLine]", "    ", 
        RowBox[{
         RowBox[{
          RowBox[{"loss", "=", 
           RowBox[{"Sum", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"hVals", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], "/", "2"}], " ", 
               RowBox[{
                RowBox[{"theta", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], "^", "2"}]}], "+", 
              RowBox[{
               RowBox[{
                RowBox[{"aVals", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], "/", "4"}], " ", 
               RowBox[{
                RowBox[{"theta", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], "^", "4"}]}]}], ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", "n"}], "}"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"grad", "=", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"hVals", "[", 
                RowBox[{"[", "i", "]"}], "]"}], " ", 
               RowBox[{"theta", "[", 
                RowBox[{"[", "i", "]"}], "]"}]}], "+", 
              RowBox[{
               RowBox[{"aVals", "[", 
                RowBox[{"[", "i", "]"}], "]"}], " ", 
               RowBox[{
                RowBox[{"theta", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], "^", "3"}]}]}], ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", "n"}], "}"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"hess", "=", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"hVals", "[", 
               RowBox[{"[", "i", "]"}], "]"}], "+", 
              RowBox[{"3", " ", 
               RowBox[{"aVals", "[", 
                RowBox[{"[", "i", "]"}], "]"}], " ", 
               RowBox[{
                RowBox[{"theta", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], "^", "2"}]}]}], ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", "n"}], "}"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"s", "=", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"1", "-", 
               RowBox[{"betaS", " ", "lam"}]}], ")"}], " ", "s"}], "+", 
            RowBox[{"betaS", " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"-", "lam"}], " ", 
               RowBox[{"Log", "[", 
                RowBox[{"Clip", "[", 
                 RowBox[{"hess", ",", 
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"10.0", "^", 
                    RowBox[{"-", "8"}]}], ",", "Infinity"}], "}"}]}], "]"}], 
                "]"}]}], ")"}]}]}]}], ";", "\[IndentingNewLine]", "    ", 
          RowBox[{"s", "=", 
           RowBox[{"s", "-", 
            RowBox[{"Mean", "[", "s", "]"}]}]}], ";", "\[IndentingNewLine]", 
          "    ", 
          RowBox[{"s", "=", 
           RowBox[{"Clip", "[", 
            RowBox[{"s", ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"-", "c"}], ",", "c"}], "}"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"theta", "=", 
           RowBox[{"theta", "-", 
            RowBox[{"eta", " ", 
             RowBox[{"Exp", "[", "s", "]"}], " ", "grad"}]}]}], ";", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Total", "[", 
              RowBox[{"theta", "^", "2"}], "]"}], ">", 
             RowBox[{"10", "^", "20"}]}], ",", 
            RowBox[{"Return", "[", "lHist", "]"}]}], "]"}], ";", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"lHist", ",", "loss"}], "]"}], ";"}], ",", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"{", "nSteps", "}"}]}], "\[IndentingNewLine]", "  ", "]"}], ";",
        "\[IndentingNewLine]", "  ", "lHist"}]}], "\[IndentingNewLine]", 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"hV", "=", 
   RowBox[{"{", 
    RowBox[{"1.0", ",", "100.0"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"aV", "=", 
    RowBox[{"{", 
     RowBox[{"5.0", ",", "5.0"}], "}"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<=== Basin of Attraction (quartic, L_H=30) ===\>\"", 
   "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<Local theory prediction: rho_max = mu_sc^2 e^{-2c} / (2 \
L_sc L_H)\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<  = \>\"", ",", 
    RowBox[{"N", "[", 
     RowBox[{
      RowBox[{"1.0", "^", "2"}], " ", 
      RowBox[{
       RowBox[{"Exp", "[", 
        RowBox[{"-", "8"}], "]"}], "/", 
       RowBox[{"(", 
        RowBox[{"2", " ", "100.0", " ", "30.0"}], ")"}]}]}], "]"}], 
    ",", "\"\< (extremely conservative)\>\""}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", "\"\<Actual basin (eta=0.005):\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"theta0Vals", "=", 
   RowBox[{"{", 
    RowBox[{
    "0.5", ",", "1.0", ",", "2.0", ",", "5.0", ",", "10.0", ",", "50.0"}], 
    "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Do", "[", "\[IndentingNewLine]", "  ", 
   RowBox[{
    RowBox[{
     RowBox[{"t0", "=", 
      RowBox[{"Table", "[", 
       RowBox[{"th", ",", 
        RowBox[{"{", "2", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", "  ", 
     
     RowBox[{"l", "=", 
      RowBox[{"derivedSimBasin", "[", 
       RowBox[{
       "hV", ",", "aV", ",", "0.005", ",", "0.1", ",", "1.0", ",", "4.0", ",",
         "5000", ",", "t0"}], "]"}]}], ";", "\[IndentingNewLine]", "  ", 
     RowBox[{"status", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", "l", "]"}], "==", "5000"}], 
        ",", "\"\<CONVERGED\>\"", ",", 
        RowBox[{"\"\<DIVERGED at step \>\"", " ", "<>", " ", 
         RowBox[{"ToString", "[", 
          RowBox[{"Length", "[", "l", "]"}], "]"}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<  theta0 = \>\"", ",", "th", ",", "\"\<: \>\"", ",", 
       "status"}], "]"}]}], ",", "\[IndentingNewLine]", "  ", 
    RowBox[{"{", 
     RowBox[{"th", ",", "theta0Vals"}], "}"}]}], "\[IndentingNewLine]", "]"}],
   ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<The denominator r=1/(1+|v|) extends the basin by ~5 \
orders of magnitude\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<beyond the local quadratic prediction. The stability \
mechanism\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<(IMO-16, Section 8) provides effective global \
stabilization.\>\"", "]"}], ";"}]}], "Input",ExpressionUUID->"c862edcd-3d67-\
40c5-b676-8827b89054ed"],

Cell["9. Higher-Dimensional Verification (N=10)", "Section",ExpressionUUID->"c349a375-c544-4b11-98a3-0387b851cdd1"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Clear", "[", "\"\<Global`*\>\"", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"derivedSimND", "[", 
     RowBox[{
     "hVals_", ",", "aVals_", ",", "eta_", ",", "betaS_", ",", "lam_", ",", 
      "c_", ",", "nSteps_", ",", "theta0_"}], "]"}], ":=", 
    "\[IndentingNewLine]", " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "n", ",", "theta", ",", "s", ",", "loss", ",", "grad", ",", "hess", ",",
         "lHist"}], "}"}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"n", "=", 
        RowBox[{"Length", "[", "hVals", "]"}]}], ";", "\[IndentingNewLine]", 
       "  ", 
       RowBox[{"theta", "=", 
        RowBox[{"N", "[", "theta0", "]"}]}], ";", "\[IndentingNewLine]", "  ", 
       RowBox[{"s", "=", 
        RowBox[{"Table", "[", 
         RowBox[{"0.0", ",", 
          RowBox[{"{", "n", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       "  ", 
       RowBox[{"lHist", "=", 
        RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", "  ", 
       RowBox[{"Do", "[", "\[IndentingNewLine]", "    ", 
        RowBox[{
         RowBox[{
          RowBox[{"loss", "=", 
           RowBox[{"Sum", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"hVals", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], "/", "2"}], " ", 
               RowBox[{
                RowBox[{"theta", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], "^", "2"}]}], "+", 
              RowBox[{
               RowBox[{
                RowBox[{"aVals", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], "/", "4"}], " ", 
               RowBox[{
                RowBox[{"theta", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], "^", "4"}]}]}], ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", "n"}], "}"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"grad", "=", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"hVals", "[", 
                RowBox[{"[", "i", "]"}], "]"}], " ", 
               RowBox[{"theta", "[", 
                RowBox[{"[", "i", "]"}], "]"}]}], "+", 
              RowBox[{
               RowBox[{"aVals", "[", 
                RowBox[{"[", "i", "]"}], "]"}], " ", 
               RowBox[{
                RowBox[{"theta", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], "^", "3"}]}]}], ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", "n"}], "}"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"hess", "=", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"hVals", "[", 
               RowBox[{"[", "i", "]"}], "]"}], "+", 
              RowBox[{"3", " ", 
               RowBox[{"aVals", "[", 
                RowBox[{"[", "i", "]"}], "]"}], " ", 
               RowBox[{
                RowBox[{"theta", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], "^", "2"}]}]}], ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", "n"}], "}"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"s", "=", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"1", "-", 
               RowBox[{"betaS", " ", "lam"}]}], ")"}], " ", "s"}], "+", 
            RowBox[{"betaS", " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"-", "lam"}], " ", 
               RowBox[{"Log", "[", 
                RowBox[{"Clip", "[", 
                 RowBox[{"hess", ",", 
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"10.0", "^", 
                    RowBox[{"-", "8"}]}], ",", "Infinity"}], "}"}]}], "]"}], 
                "]"}]}], ")"}]}]}]}], ";", "\[IndentingNewLine]", "    ", 
          RowBox[{"s", "=", 
           RowBox[{"s", "-", 
            RowBox[{"Mean", "[", "s", "]"}]}]}], ";", "\[IndentingNewLine]", 
          "    ", 
          RowBox[{"s", "=", 
           RowBox[{"Clip", "[", 
            RowBox[{"s", ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"-", "c"}], ",", "c"}], "}"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"theta", "=", 
           RowBox[{"theta", "-", 
            RowBox[{"eta", " ", 
             RowBox[{"Exp", "[", "s", "]"}], " ", "grad"}]}]}], ";", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"lHist", ",", "loss"}], "]"}], ";"}], ",", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"{", "nSteps", "}"}]}], "\[IndentingNewLine]", "  ", "]"}], ";",
        "\[IndentingNewLine]", "  ", "lHist"}]}], "\[IndentingNewLine]", 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"gdSimND", "[", 
     RowBox[{
     "hVals_", ",", "aVals_", ",", "eta_", ",", "nSteps_", ",", "theta0_"}], 
     "]"}], ":=", "\[IndentingNewLine]", " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"n", ",", "theta", ",", "loss", ",", "grad", ",", "lHist"}], 
       "}"}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"n", "=", 
        RowBox[{"Length", "[", "hVals", "]"}]}], ";", "\[IndentingNewLine]", 
       "  ", 
       RowBox[{"theta", "=", 
        RowBox[{"N", "[", "theta0", "]"}]}], ";", "\[IndentingNewLine]", "  ", 
       RowBox[{"lHist", "=", 
        RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", "  ", 
       RowBox[{"Do", "[", "\[IndentingNewLine]", "    ", 
        RowBox[{
         RowBox[{
          RowBox[{"loss", "=", 
           RowBox[{"Sum", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"hVals", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], "/", "2"}], " ", 
               RowBox[{
                RowBox[{"theta", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], "^", "2"}]}], "+", 
              RowBox[{
               RowBox[{
                RowBox[{"aVals", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], "/", "4"}], " ", 
               RowBox[{
                RowBox[{"theta", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], "^", "4"}]}]}], ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", "n"}], "}"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"grad", "=", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"hVals", "[", 
                RowBox[{"[", "i", "]"}], "]"}], " ", 
               RowBox[{"theta", "[", 
                RowBox[{"[", "i", "]"}], "]"}]}], "+", 
              RowBox[{
               RowBox[{"aVals", "[", 
                RowBox[{"[", "i", "]"}], "]"}], " ", 
               RowBox[{
                RowBox[{"theta", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], "^", "3"}]}]}], ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", "n"}], "}"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"theta", "=", 
           RowBox[{"theta", "-", 
            RowBox[{"eta", " ", "grad"}]}]}], ";", "\[IndentingNewLine]", 
          "    ", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"lHist", ",", "loss"}], "]"}], ";"}], ",", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"{", "nSteps", "}"}]}], "\[IndentingNewLine]", "  ", "]"}], ";",
        "\[IndentingNewLine]", "  ", "lHist"}]}], "\[IndentingNewLine]", 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"n", "=", "10"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"kappa", "=", "1000"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"hV", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{"Log", "[", "1.0", "]"}], "+", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"i", "-", "1"}], ")"}], "/", 
         RowBox[{"(", 
          RowBox[{"n", "-", "1"}], ")"}]}], " ", 
        RowBox[{"Log", "[", "kappa", "]"}]}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "n"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"aV", "=", 
   RowBox[{"Table", "[", 
    RowBox[{"1.0", ",", 
     RowBox[{"{", "n", "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"theta0", "=", 
   RowBox[{"Table", "[", 
    RowBox[{"0.5", ",", 
     RowBox[{"{", "n", "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"eta", "=", "0.001"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"nS", "=", "3000"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"etaGD", "=", 
    RowBox[{"2.0", "/", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Min", "[", "hV", "]"}], "+", 
       RowBox[{"Max", "[", "hV", "]"}]}], ")"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"lDer", "=", 
   RowBox[{"derivedSimND", "[", 
    RowBox[{
    "hV", ",", "aV", ",", "eta", ",", "0.1", ",", "1.0", ",", "4.0", ",", 
     "nS", ",", "theta0"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"lGD", "=", 
    RowBox[{"gdSimND", "[", 
     RowBox[{"hV", ",", "aV", ",", "etaGD", ",", "nS", ",", "theta0"}], 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<=== N=10, kappa=1000, quartic (a=1) ===\>\"", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", "\"\<h = log-spaced from 1 to 1000\>\"", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Derived final loss: \>\"", ",", 
    RowBox[{"lDer", "[", 
     RowBox[{"[", 
      RowBox[{"-", "1"}], "]"}], "]"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Print", "[", 
    RowBox[{"\"\<GD final loss: \>\"", ",", 
     RowBox[{"lGD", "[", 
      RowBox[{"[", 
       RowBox[{"-", "1"}], "]"}], "]"}]}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dRates", "=", 
   RowBox[{"Table", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"lDer", "[", 
          RowBox[{"[", "i", "]"}], "]"}], ">", 
         RowBox[{"10.0", "^", 
          RowBox[{"-", "280"}]}]}], "&&", 
        RowBox[{
         RowBox[{"lDer", "[", 
          RowBox[{"[", 
           RowBox[{"i", "+", "1"}], "]"}], "]"}], ">", 
         RowBox[{"10.0", "^", 
          RowBox[{"-", "280"}]}]}]}], ",", "\[IndentingNewLine]", "    ", 
       RowBox[{"-", 
        RowBox[{"Log", "[", 
         RowBox[{
          RowBox[{"lDer", "[", 
           RowBox[{"[", 
            RowBox[{"i", "+", "1"}], "]"}], "]"}], "/", 
          RowBox[{"lDer", "[", 
           RowBox[{"[", "i", "]"}], "]"}]}], "]"}]}], ",", "Nothing"}], "]"}],
      ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"{", 
      RowBox[{"i", ",", "200", ",", "500"}], "}"}]}], "\[IndentingNewLine]", 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"gRates", "=", 
   RowBox[{"Table", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"lGD", "[", 
          RowBox[{"[", "i", "]"}], "]"}], ">", 
         RowBox[{"10.0", "^", 
          RowBox[{"-", "280"}]}]}], "&&", 
        RowBox[{
         RowBox[{"lGD", "[", 
          RowBox[{"[", 
           RowBox[{"i", "+", "1"}], "]"}], "]"}], ">", 
         RowBox[{"10.0", "^", 
          RowBox[{"-", "280"}]}]}]}], ",", "\[IndentingNewLine]", "    ", 
       RowBox[{"-", 
        RowBox[{"Log", "[", 
         RowBox[{
          RowBox[{"lGD", "[", 
           RowBox[{"[", 
            RowBox[{"i", "+", "1"}], "]"}], "]"}], "/", 
          RowBox[{"lGD", "[", 
           RowBox[{"[", "i", "]"}], "]"}]}], "]"}]}], ",", "Nothing"}], "]"}],
      ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"{", 
      RowBox[{"i", ",", "200", ",", "500"}], "}"}]}], "\[IndentingNewLine]", 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Derived rate: \>\"", ",", 
    RowBox[{
     RowBox[{"Mean", "[", "dRates", "]"}], " ", "//", " ", "N"}]}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<GD rate: \>\"", ",", 
    RowBox[{
     RowBox[{"Mean", "[", "gRates", "]"}], " ", "//", " ", "N"}]}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Improvement: \>\"", ",", 
    RowBox[{"N", "[", 
     RowBox[{
      RowBox[{"Mean", "[", "dRates", "]"}], "/", 
      RowBox[{"Mean", "[", "gRates", "]"}]}], "]"}], ",", "\"\<x\>\""}], 
   "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<hgeo = \>\"", ",", 
    RowBox[{
     RowBox[{"GeometricMean", "[", "hV", "]"}], " ", "//", " ", "N"}]}], 
   "]"}], ";"}]}], "Input",ExpressionUUID->"416574ca-870c-4f92-88c7-\
ca618c825e06"],

Cell["10. Discussion: Neural Networks", "Section",ExpressionUUID->"d14453c4-0335-423a-9af9-2f835e9f8c45"],

Cell[TextData[{
 StyleBox["The Hessian-Lipschitz constant for neural networks is not \
well-characterized.",
  FontWeight->Bold],
 " This is a fundamental open problem. "
}], "Text",ExpressionUUID->"5c686d01-2d13-4671-8314-4a6d2317e268"],

Cell["What can be bounded", "Subsection",ExpressionUUID->"7811b972-2751-42bc-bfff-2d3b83075b92"],

Cell[TextData[{
 "1. ",
 StyleBox["Linear models",
  FontWeight->Bold],
 " (logistic regression, linear networks): ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["L", "TI"], 
          StyleBox["H", "TI"]], "\[LongEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "L_H = 0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ea52538a-1ab0-4b2e-b2ce-c1409a5c8b9d"],
 " if the loss is quadratic in ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Theta]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\theta", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a4420770-1bdd-4df9-b58a-b5472897a47f"],
 "; ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["L", "TI"], 
        StyleBox["H", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "L_H", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c4026549-2c67-419e-934c-35c1538dbb48"],
 " is bounded by the data for cross-entropy."
}], "Text",ExpressionUUID->"9e1bf955-e3ca-411d-bc6b-b537a3c71f48"],

Cell[TextData[{
 "2. ",
 StyleBox["Shallow networks",
  FontWeight->Bold],
 " (one hidden layer, width ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["m", "TI"], TraditionalForm], "errors" -> {}, "input" -> "m", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b48992f8-5e0d-4397-a116-f3f330b44f30"],
 "): ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["L", "TI"], 
        StyleBox["H", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "L_H", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "28e28d04-14fe-4728-a5be-1385d2177b25"],
 " scales with ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
        "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", "\[Theta]", 
         "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9"}], 
       TraditionalForm], "errors" -> {}, "input" -> "|\\theta|", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "9084bef2-be63-4e19-a594-418436e9039c"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["m", "TI"], TraditionalForm], "errors" -> {}, "input" -> "m", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "7d564b1e-3821-4b56-af58-86c3b2111d7c"],
 ", but explicit bounds are available in the NTK regime."
}], "Text",ExpressionUUID->"7bfaf4b3-3df0-4868-8ea9-51b4250a77f6"],

Cell[TextData[{
 "3. ",
 StyleBox["Deep networks",
  FontWeight->Bold],
 ": ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["L", "TI"], 
        StyleBox["H", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "L_H", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "32866e8f-f858-4042-8f28-dbbf72f16fa3"],
 " grows exponentially with depth in the worst case. Residual connections and \
normalization help, but no tight general bounds exist. "
}], "Text",ExpressionUUID->"20132232-589d-49e5-86b8-97b827599f93"],

Cell["Practical implications", "Subsection",ExpressionUUID->"985c34b5-1017-4913-9a65-4db8a2c248ad"],

Cell[TextData[{
 "The theorem says: convergence rate is ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Gamma]", "\[LongEqual]", "min", 
         RowBox[{"(", 
           RowBox[{"\[Eta] ", 
             SuperscriptBox[
              StyleBox["e", "TI"], 
              RowBox[{"-", 
                StyleBox["c", "TI"]}]], " ", 
             SubscriptBox["\[Mu]", 
              RowBox[{
                StyleBox["s", "TI"], 
                StyleBox["c", "TI"]}]], ", ", 
             FractionBox["3", "2"], "\[Mu]\[Lambda]"}], ")"}]}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\gamma = \\min(\\eta\\, e^{-c}\\, \\mu_{sc},\\; \
\\frac{3}{2}\\mu\\lambda)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e44f204d-01ed-48fb-95b5-cf6d3204b169"],
 ". The rate does ",
 StyleBox["not",
  FontWeight->Bold],
 " depend on ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["L", "TI"], 
        StyleBox["H", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "L_H", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "609904eb-1f79-4186-9a20-c822bc960c02"],
 " directly. ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["L", "TI"], 
        StyleBox["H", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "L_H", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c5e038a2-b62f-4505-b9a9-cddd6a7627fd"],
 " only constrains:"
}], "Text",ExpressionUUID->"11e943fb-2130-49ae-8344-1c42c8fa3c8d"],

Cell[TextData[{
 "1. The Lyapunov weight ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Alpha]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\alpha", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "bcf3fd1d-fc97-4eca-bfb4-1a62ca71f66a"],
 ", affecting the ",
 StyleBox["provable",
  FontWeight->Bold],
 " coupling strength"
}], "Text",ExpressionUUID->"c2caae6f-036d-4c18-8c52-a0dfadee62e4"],

Cell["\<\
2. The basin of attraction radius (which the denominator extends far beyond)\
\>", "Text",ExpressionUUID->"88913d8e-0333-4d8d-8fb0-71f5e60eca68"],

Cell["\<\
In practice, the derived optimizer works on neural networks because: \
\>", "Text",ExpressionUUID->"9ba44436-6eb1-4a6a-ab64-d608f18a6dcb"],

Cell[TextData[{
 "The metric tracks the Hessian with EMA lag, which is small when ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["\[Beta]", 
        StyleBox["s", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\beta_s", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "064db2ef-f836-400a-918d-37f3985c1576"],
 " is appropriate"
}], "Item",ExpressionUUID->"20e44d39-c03e-4476-b51c-9f58355d5929"],

Cell["\<\
The denominator provides global stabilization that the local theory cannot \
capture\
\>", "Item",ExpressionUUID->"d8796765-1357-4293-ad2c-7c2db2d0f82e"],

Cell[TextData[{
 "The Newton equilibrium is attracting regardless of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["L", "TI"], 
        StyleBox["H", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "L_H", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d16806d6-9ae9-4f06-b886-9d00b7115184"],
 " (numerically verified)"
}], "Item",ExpressionUUID->"3c69ccb4-eec0-4cce-ab40-df4c87a2c913"],

Cell["Scaling with architecture", "Subsection",ExpressionUUID->"dbcfbb78-ee2d-4d5c-ab45-148e0944c314"],

Cell[BoxData[
 PaneBox[
  PaneBox[
   StyleBox[
    TagBox[
     TagBox[GridBox[{
        {
         TagBox["\<\"Architecture\"\>",
          HoldForm], 
         TagBox[Cell[TextData[{
           "Expected ",
           Cell[BoxData[
            FormBox[
             TemplateBox[<|"boxes" -> FormBox[
                 SubscriptBox[
                  StyleBox["L", "TI"], 
                  StyleBox["H", "TI"]], TraditionalForm], "errors" -> {}, 
               "input" -> "L_H", "state" -> "Boxes"|>,
              "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
            "e245e42a-5a22-4d25-87ca-37026ba7967d"]
          }],ExpressionUUID->"78ba96f0-8583-4c9e-b54c-b4bb6b4cf256"],
          HoldForm], 
         TagBox["\<\"Metric behavior\"\>",
          HoldForm]},
        {"\<\"Linear / shallow\"\>", "\<\"Small (bounded)\"\>", "\<\"Perfect \
Newton convergence\"\>"},
        {"\<\"MLP (moderate depth)\"\>", "\<\"Moderate\"\>", "\<\"Newton with \
EMA lag\"\>"},
        {"\<\"Deep ResNet\"\>", "\<\"Large (mitigated by skip \
connections)\"\>", "\<\"Newton with larger lag\"\>"},
        {"\<\"Transformer\"\>", "\<\"Large (attention nonlinearity)\"\>", "\<\
\"Empirically effective\"\>"}
       },
       GridBoxAlignment->{
        "Columns" -> {Center, Center, {Center}}, "Rows" -> {{Baseline}}},
       GridBoxDividers->{
        "Columns" -> {{False}}, "Rows" -> {False, True, {False}, False}},
       GridBoxSpacings->{"Columns" -> {
           Offset[0.27999999999999997`], {
            Offset[2.0999999999999996`]}, 
           Offset[0.27999999999999997`]}, "Rows" -> {
           Offset[0.2], {
            Offset[0.4]}, 
           Offset[0.2]}}],
      {None, OutputFormsDump`HeadedColumns}],
     Function[BoxForm`e$, 
      TableForm[BoxForm`e$, TableHeadings -> {None, {"Architecture", 
          RawBoxes[
           Cell[
            TextData[{"Expected ", 
              Cell[
               BoxData[
                FormBox[
                 TemplateBox[<|"boxes" -> FormBox[
                    SubscriptBox[
                    StyleBox["L", "TI"], 
                    StyleBox["H", "TI"]], TraditionalForm], "errors" -> {}, 
                   "input" -> "L_H", "state" -> "Boxes"|>, 
                  "TeXAssistantTemplate"], TraditionalForm]]]}]]], 
          "Metric behavior"}}]]], "Text",
    StripOnInput->False,
    ShowStringCharacters->False],
   ImageMargins->{{0, 0}, {5, 5}}],
  ImageMargins->{{0, 0}, {5, 5}}]], "TextTableForm", \
"Text",ExpressionUUID->"c8248bfe-8be7-4ce9-b67e-4d3275cca233"],

Cell["\<\
The gap between theory (local quadratic analysis) and practice (global \
convergence on deep networks) is mediated by the denominator stabilization \
mechanism (IMO-16, Section 8). \
\>", "Text",ExpressionUUID->"b5a216de-effe-4349-bde1-e95ce3a3487e"],

Cell["11. Summary", "Section",ExpressionUUID->"b5f95092-a60d-4667-a282-fbd6d67e9b43"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Print", "[", "\"\<=== Summary of Results ===\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<THEOREM (Hessian-Lipschitz convergence):\>\"", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<  On strongly convex losses with Hessian-Lipschitz \
constant L_H,\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<  the derived optimizer converges at rate\>\"", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<    gamma = min(eta e^{-c} mu_sc, 3/2 mu lam)\>\"", 
   "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<  with Lyapunov weight constrained by\>\"", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<    alpha < 2 eta e^{-c} mu_sc^4 / (mu lam L_H^2).\>\"", 
   "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", "\"\<KEY FINDINGS:\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<  1. L_H constrains alpha, NOT the convergence rate.\>\"",
    "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<  2. The rate matches the quadratic result (up to \
constants).\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<  3. The improvement over GD scales as sqrt(kappa).\>\"",
    "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<  4. The denominator extends the basin far beyond local \
theory.\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<  5. Zero Lyapunov violations on all test functions.\>\"",
    "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", "\"\<SPECIAL CASES:\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<  L_H = 0: Recovers IMO-16 (zero cross-term, any alpha).\
\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<  L_H large: Rate unchanged, but alpha -> 0 (Lyapunov \
proof weakens).\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", "\"\<NUMERICAL VERIFICATION:\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<  Quartic (N=2, kappa=100): rate constant across L_H = 0 \
to 60\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<  Quartic (N=10, kappa=1000): 17.5x improvement over \
GD\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<  Rosenbrock: derived optimizer converges faster than GD\
\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<  Basin of attraction: ~5 orders of magnitude beyond \
local prediction\>\"", "]"}], ";"}]}], "Input",ExpressionUUID->"b6d0c740-6f74-\
4d5b-9540-ae29dfebc0db"]
},
FrontEndVersion->"14.3 for Mac OS X ARM (64-bit) (July 8, 2025)",
StyleDefinitions->"Default.nb",
ExpressionUUID->"a83bd6d1-c378-4ba4-8c49-4f0e587986a8"
