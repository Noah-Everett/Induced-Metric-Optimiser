 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["s", "TI"], "\[LongEqual]", 
         SuperscriptBox[
          StyleBox["s", "TI"], "*"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "s = s^*", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "4eb30bf2-a394-4f4f-a1f2-b00137b0ecbb"],
 "), the preconditioned eigenvalues are all equal to ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["h", "TI"], 
          RowBox[{
            StyleBox["g", "TI"], 
            StyleBox["e", "TI"], 
            StyleBox["o", "TI"]}]], "\[LongEqual]", "exp", 
         RowBox[{"(", 
           OverscriptBox[
            RowBox[{"log", 
              StyleBox["h", "TI"]}], "_"], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> "h_{geo} = \\exp(\\overline{\\log h})", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e96d8a50-684e-44f2-995e-10bac2431e17"],
 ". "
}], "Text",ExpressionUUID->"30d6ff04-98be-4fd6-b91a-57f80f53320b"],

