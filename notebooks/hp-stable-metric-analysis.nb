Notebook[{
Cell["IMO-83: Stable Metric Learning \[LongDash] Analytical Derivations", \
"Title",ExpressionUUID->"ed6e4856-0959-4bc4-af22-d1db963adc01"],

Cell[TextData[{
 "Companion to ",
 Cell[BoxData[Cell["notes/stable-metric-update.md",
   Background->None,ExpressionUUID->"360540a6-bb46-4596-8d45-711675e1ee31"]], 
  "InlineCode",ExpressionUUID->"4dec4ab8-9d45-4823-86f9-a628b63ead03"],
 " and ",
 Cell[BoxData[Cell["hp-stable-metric-verification.py",
   Background->None,ExpressionUUID->"a6909f65-4f45-4f68-8f90-42a53f29a8a9"]], 
  "InlineCode",ExpressionUUID->"7873a67a-4f6c-42d2-b236-c4c40c1b5930"],
 ". "
}], "Text",ExpressionUUID->"dceecdc7-5dc9-48ca-9732-16a9afc360be"],

Cell["1. Original Update Rule", "Section",ExpressionUUID->"d0586199-de80-4115-927f-32507bcc8dd7"],

Cell[TextData[{
 "The current s-update uses the s-gradient of v: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         OverscriptBox[
          StyleBox["s", "TI"], "."], "\[LongEqual]", "\[Xi]", 
         SuperscriptBox[
          StyleBox["e", "TI"], 
          StyleBox["s", "TI"]], 
         SuperscriptBox[
          StyleBox["g", "TI"], "2"], "-", "\[Lambda]", 
         StyleBox["s", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\dot{s} = \\xi e^s g^2 - \\lambda s", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "8fddd3f4-f368-4f87-aa4a-079ae4099754"]
}], "Text",ExpressionUUID->"069e13da-6eeb-4ac0-ac76-cdc54d53d927"],

Cell["\<\
fOrig[s_] := xi Exp[s] g2 - lam s;
Print[\"Jacobian (original): \", D[fOrig[s], s] // Simplify]
Print[\"At equilibrium (xi*Exp[s]*g^2 = lam*s*): lam*(s* - 1)\"]
Print[\"Stable iff s* < 1\"]
Print[\"Equilibrium exists iff xi*g^2/lam < 1/e\"]
Print[\"Practical values: xi*g^2/lam ~ 10^4\
\>", "Program",ExpressionUUID->"1c84a2d0-6a98-4e64-b7c3-9ea47c06615f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"1", "/", "e"}], "=", "\"\<, N[1/E]]\>"}]], "Echo",ExpressionUUID->\
"85bd60fe-26c8-497d-9f10-27ef9ea16a5d"],

Cell["2. Normalized Gradient Update Rule", "Section",ExpressionUUID->"e7deedc0-a7f1-4159-b485-62239a3554f9"],

Cell[TextData[{
 "Divide driving force by Exp[s]: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         OverscriptBox[
          StyleBox["s", "TI"], "."], "\[LongEqual]", "\[Xi]", 
         SuperscriptBox[
          StyleBox["g", "TI"], "2"], "-", "\[Lambda]", 
         StyleBox["s", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\dot{s} = \\xi g^2 - \\lambda s", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a3de7c3b-6337-417b-b332-b351ff6821df"]
}], "Text",ExpressionUUID->"b15cf436-ad82-48fe-9034-bee9c88bb91c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"fNorm", "[", "s_", "]"}], ":=", 
   RowBox[{
    RowBox[{"xi", " ", "g2"}], "-", 
    RowBox[{"lam", " ", "s"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  RowBox[{"\"\<Jacobian (normalized): \>\"", ",", 
   RowBox[{"D", "[", 
    RowBox[{
     RowBox[{"fNorm", "[", "s", "]"}], ",", "s"}], "]"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"Print", 
  "[", "\"\<= -lambda (ALWAYS negative, unconditionally stable)\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  RowBox[{"\"\<Equilibrium: s* = \>\"", ",", 
   RowBox[{
    RowBox[{"Solve", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"fNorm", "[", "s", "]"}], "==", "0"}], ",", "s"}], "]"}], "[", 
    
    RowBox[{"[", 
     RowBox[{"1", ",", "1", ",", "2"}], "]"}], "]"}]}], "]"}]}], "Input",Expre\
ssionUUID->"15bf438c-9b55-4608-b820-97aa8109de63"],

Cell["3. Exact Solution (Linear ODE)", "Section",ExpressionUUID->"1aa712ea-a6ab-407c-9901-fcf5e2e50e93"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"sol", "=", 
   RowBox[{"DSolve", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"s", "'"}], "[", "t", "]"}], "==", 
        RowBox[{
         RowBox[{"xi", " ", "g2"}], "-", 
         RowBox[{"lam", " ", 
          RowBox[{"s", "[", "t", "]"}]}]}]}], ",", 
       RowBox[{
        RowBox[{"s", "[", "0", "]"}], "==", "s0"}]}], "}"}], ",", 
     RowBox[{"s", "[", "t", "]"}], ",", "t"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  RowBox[{"\"\<s(t) = \>\"", ",", 
   RowBox[{
    RowBox[{"sol", "[", 
     RowBox[{"[", 
      RowBox[{"1", ",", "1", ",", "2"}], "]"}], "]"}], " ", "//", " ", 
    "Simplify"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sInf", "=", 
   RowBox[{"Limit", "[", 
    RowBox[{
     RowBox[{"sol", "[", 
      RowBox[{"[", 
       RowBox[{"1", ",", "1", ",", "2"}], "]"}], "]"}], ",", 
     RowBox[{"t", "->", "Infinity"}], ",", 
     RowBox[{"Assumptions", "->", 
      RowBox[{"{", 
       RowBox[{"lam", ">", "0"}], "}"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  RowBox[{"\"\<s(infinity) = \>\"", ",", 
   RowBox[{"sInf", " ", "//", " ", "Simplify"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"Print", 
  "[", "\"\<Error: s(t) - s* = (s0 - xi*g^2/lam) * Exp[-lam*t]\>\"", 
  "]"}]}], "Input",ExpressionUUID->"c1a18aab-65db-46c7-b707-6f870a3a8a09"],

Cell["4. Global Lyapunov Stability", "Section",ExpressionUUID->"363fd6b5-4e61-41be-88b9-06bddbb2804e"],

Cell["Lyapunov function V = (s - s*)^2 / 2: ", "CodeText",ExpressionUUID->"547f88df-655e-4ae9-a745-d24b459c2829"],

Cell[BoxData[{
 RowBox[{"Print", "[", "\"\<dV/dt = (s - s*)(xi*g^2 - lam*s)\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", "\"\<      = (s - s*)(-lam)(s - s*)\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", "\"\<      = -lam*(s - s*)^2\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", "\"\<      = -2*lam*V < 0 for all s != s*\>\"", 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", "\"\<=> Globally asymptotically stable\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{"Print", 
  "[", "\"\<=> Exponential convergence: |s(t)-s*| ~ Exp[-lam*t]\>\"", 
  "]"}]}], "Input",ExpressionUUID->"fb70b237-cb16-4188-a87f-7fc71fc5dc6b"],

Cell["5. Curvature Correction Preserves Stability", "Section",ExpressionUUID->"c1b67f85-e199-44ee-ba0e-b79fc08025c0"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"fCurv", ",", "H", ",", "tau", ",", "r"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"fCurv", "[", "s_", "]"}], ":=", 
   RowBox[{
    RowBox[{"xi", " ", "g2", " ", 
     RowBox[{"(", 
      RowBox[{"1", "-", 
       RowBox[{"r", " ", 
        RowBox[{"Tanh", "[", 
         RowBox[{"H", "/", "tau"}], "]"}]}]}], ")"}]}], "-", 
    RowBox[{"lam", " ", "s"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  RowBox[{"\"\<Jacobian with curvature: \>\"", ",", 
   RowBox[{"D", "[", 
    RowBox[{
     RowBox[{"fCurv", "[", "s", "]"}], ",", "s"}], "]"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", "\"\<= -lam (UNCHANGED by curvature correction)\>\"", 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  RowBox[{"\"\<Equilibrium: s* = \>\"", ",", 
   RowBox[{
    RowBox[{"Solve", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"fCurv", "[", "s", "]"}], "==", "0"}], ",", "s"}], "]"}], "[", 
    
    RowBox[{"[", 
     RowBox[{"1", ",", "1", ",", "2"}], "]"}], "]"}]}], "]"}]}], "Input",Expre\
ssionUUID->"1d7ef367-180d-4b08-a59c-af6d152d8a66"],

Cell["6. Mean-Centered Equilibrium", "Section",ExpressionUUID->"e5aab9ed-474b-4a6b-bf9a-1a59db84c384"],

Cell["With constraint sum(s_i) = 0: ", "CodeText",ExpressionUUID->"2dbf3cb8-1322-445f-831e-3358fd177cbb"],

Cell[BoxData[{
 RowBox[{"Print", "[", "\"\<Constrained equilibrium:\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", "\"\<  xi*g_i^2 - lam*s_i = muL  for all i\>\"", 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", "\"\<  sum(s_i) = 0\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", "\"\<Solution:\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", "\"\<  muL = xi * mean(g^2)\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", "\"\<  s_i* = xi*(g_i^2 - mean(g^2)) / lam\>\"", 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", "\"\<Stability: eigenvalue = -lam for each mode\>\"", 
  "]"}]}], "Input",ExpressionUUID->"40a5a6cb-c1d3-436f-9a7e-6d7a85b51a61"],

Cell["7. Geometric Interpretation", "Section",ExpressionUUID->"68006eab-4022-4ebe-8d6b-f41894af9a95"],

Cell[BoxData[{
 RowBox[{"Print", 
  "[", "\"\<v = xi * sum(M_i * g_i^2) where M_i = exp(s_i)\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{"Print", 
  "[", "\"\<In M-coordinates: dv/dM_i = xi * g_i^2  (constant)\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{"Print", 
  "[", "\"\<In s-coordinates: dv/ds_i = xi * exp(s_i) * g_i^2  \
(amplified)\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", "]"}], "\[IndentingNewLine]", 
 RowBox[{"Print", 
  "[", "\"\<The original update uses dv/ds (the s-gradient)\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{"Print", 
  "[", "\"\<The normalized update uses dv/dM (the M-gradient, projected to \
s-space)\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", "]"}], "\[IndentingNewLine]", 
 RowBox[{"Print", 
  "[", "\"\<This is mirror descent / natural gradient for the exp \
parameterization.\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{"Print", 
  "[", "\"\<Irony: the optimizer learns a metric for parameter space, but the\
\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{"Print", 
  "[", "\"\<original uses a flat metric for learning the metric itself.\>\"", 
  "]"}]}], "Input",ExpressionUUID->"fac8b2ed-2e37-471b-9cb9-243fd8c0c33f"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
