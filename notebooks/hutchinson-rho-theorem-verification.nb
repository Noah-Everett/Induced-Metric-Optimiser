Notebook[{
Cell["\<\
Hutchinson Diagonal Estimator: Kronecker rho Factorization \[LongDash] \
Numerical Verification\
\>", "Title",ExpressionUUID->"da1bf33a-8724-4ded-8fba-666c21979fa9"],

Cell[TextData[{
 "IMO-144. Verifies the theorem: for ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["H", "TI"], "\[LongEqual]", 
         StyleBox["A", "TI"], "\[CircleTimes]", 
         StyleBox["B", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "H = A \\otimes B", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "7a497b97-b0b4-4c0c-afa9-792ac6ac3d18"],
 " with SPD factors, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubsuperscriptBox["\[Rho]", 
          RowBox[{"(", 
            RowBox[{
              StyleBox["i", "TI"], ",", 
              StyleBox["j", "TI"]}], ")"}], "2"], "+", "1", "\[LongEqual]", 
         RowBox[{"(", 
           RowBox[{"1", "+", 
             SubsuperscriptBox[
              StyleBox["r", "TI"], 
              RowBox[{
                StyleBox["A", "TI"], ",", 
                StyleBox["i", "TI"]}], "2"]}], ")"}], 
         RowBox[{"(", 
           RowBox[{"1", "+", 
             SubsuperscriptBox[
              StyleBox["r", "TI"], 
              RowBox[{
                StyleBox["B", "TI"], ",", 
                StyleBox["j", "TI"]}], "2"]}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\rho_{(i,j)}^2 + 1 = (1 + r_{A,i}^2)(1 + r_{B,j}^2)", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ecb95c6e-a3b4-4e48-a93c-1c367f4823ea"],
 "where ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["r", "TI"], 
          RowBox[{
            StyleBox["A", "TI"], ",", 
            StyleBox["i", "TI"]}]], "\[LongEqual]", 
         SqrtBox[
          RowBox[{
            UnderscriptBox["\[Sum]", 
             RowBox[{
               StyleBox["k", "TI"], "\[NotEqual]", 
               StyleBox["i", "TI"]}], LimitsPositioning -> True], 
            SubsuperscriptBox[
             StyleBox["A", "TI"], 
             RowBox[{
               StyleBox["i", "TI"], 
               StyleBox["k", "TI"]}], "2"]}]], "/", 
         SubscriptBox[
          StyleBox["A", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["i", "TI"]}]]}], TraditionalForm], "errors" -> {}, 
     "input" -> "r_{A,i} = \\sqrt{\\sum_{k \\neq i} A_{ik}^2} / A_{ii}", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0fb9fd70-ff74-4463-9ed3-d31be0ab84e7"],
 ". "
}], "Text",ExpressionUUID->"0dac6ddd-41d3-446b-b1d5-4df8d3697f4c"],

Cell["1. Helper: generate random SPD matrices", "Section",ExpressionUUID->"95a5eb59-748e-4019-b868-a909ac4b1421"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"randomSPD", "[", "n_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"m", "=", 
       RowBox[{"RandomReal", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"n", ",", "n"}], "}"}]}], "]"}]}], "}"}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"m", " ", ".", " ", 
       RowBox[{"Transpose", "[", "m", "]"}]}], "+", 
      RowBox[{"n", "*", 
       RowBox[{"IdentityMatrix", "[", "n", "]"}]}]}]}], "\[IndentingNewLine]",
     "]"}]}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"equicorr", "[", 
   RowBox[{"n_", ",", "c_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", "-", "c"}], ")"}], "*", 
    RowBox[{"IdentityMatrix", "[", "n", "]"}]}], "+", 
   RowBox[{"c", "*", 
    RowBox[{"ConstantArray", "[", 
     RowBox[{"1", ",", 
      RowBox[{"{", 
       RowBox[{"n", ",", "n"}], "}"}]}], "]"}]}]}]}]}], "Input",ExpressionUUID\
->"7d96681a-d934-4f73-be96-67d221f67d51"],

Cell["\<\
2. Test 1: Factorization formula on random SPD Kronecker product\
\>", "Section",ExpressionUUID->"50a60703-c24f-4d60-a297-370c0d0b1b1f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"SeedRandom", "[", "42", "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"A", "=", 
   RowBox[{"randomSPD", "[", "4", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"B", "=", 
   RowBox[{"randomSPD", "[", "3", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"H", "=", 
    RowBox[{"KroneckerProduct", "[", 
     RowBox[{"A", ",", "B"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"Compute", " ", "rho", " ", "directly", " ", "from", " ", "H"}], 
   " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"rhoDirect", "=", 
    RowBox[{"Table", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{
       RowBox[{"Sqrt", "[", 
        RowBox[{
         RowBox[{"Total", "[", 
          RowBox[{
           RowBox[{"H", "[", 
            RowBox[{"[", "i", "]"}], "]"}], "^", "2"}], "]"}], "-", 
         RowBox[{
          RowBox[{"H", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", "i"}], "]"}], "]"}], "^", "2"}]}], "]"}], "/", 
       RowBox[{"H", "[", 
        RowBox[{"[", 
         RowBox[{"i", ",", "i"}], "]"}], "]"}]}], ",", "\[IndentingNewLine]", 
      "  ", 
      RowBox[{"{", 
       RowBox[{"i", ",", 
        RowBox[{"Length", "[", "H", "]"}]}], "}"}]}], "\[IndentingNewLine]", 
     "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"Compute", " ", "rho", " ", "via", " ", "factorization"}], " ", 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rA", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Sqrt", "[", 
       RowBox[{
        RowBox[{"Total", "[", 
         RowBox[{
          RowBox[{"A", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "^", "2"}], "]"}], "-", 
        RowBox[{
         RowBox[{"A", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "i"}], "]"}], "]"}], "^", "2"}]}], "]"}], "/", 
      RowBox[{"A", "[", 
       RowBox[{"[", 
        RowBox[{"i", ",", "i"}], "]"}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", 
       RowBox[{"Length", "[", "A", "]"}]}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"rB", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Sqrt", "[", 
        RowBox[{
         RowBox[{"Total", "[", 
          RowBox[{
           RowBox[{"B", "[", 
            RowBox[{"[", "j", "]"}], "]"}], "^", "2"}], "]"}], "-", 
         RowBox[{
          RowBox[{"B", "[", 
           RowBox[{"[", 
            RowBox[{"j", ",", "j"}], "]"}], "]"}], "^", "2"}]}], "]"}], "/", 
       RowBox[{"B", "[", 
        RowBox[{"[", 
         RowBox[{"j", ",", "j"}], "]"}], "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"j", ",", 
        RowBox[{"Length", "[", "B", "]"}]}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"rhoFactored", "=", 
    RowBox[{"Flatten", "[", 
     RowBox[{"Table", "[", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"Sqrt", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", "+", 
            RowBox[{
             RowBox[{"rA", "[", 
              RowBox[{"[", "i", "]"}], "]"}], "^", "2"}]}], ")"}], "*", 
          RowBox[{"(", 
           RowBox[{"1", "+", 
            RowBox[{
             RowBox[{"rB", "[", 
              RowBox[{"[", "j", "]"}], "]"}], "^", "2"}]}], ")"}]}], "-", 
         "1"}], "]"}], ",", "\[IndentingNewLine]", "  ", 
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{"Length", "[", "A", "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", 
         RowBox[{"Length", "[", "B", "]"}]}], "}"}]}], "\[IndentingNewLine]", 
      "]"}], "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"maxError", "=", 
   RowBox[{"Max", "[", 
    RowBox[{"Abs", "[", 
     RowBox[{"rhoDirect", "-", "rhoFactored"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Test 1: Max error (direct vs factored): \>\"", ",", 
    "maxError"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<PASS: \>\"", ",", 
    RowBox[{"maxError", "<", 
     RowBox[{"10", "^", 
      RowBox[{"-", "12"}]}]}]}], "]"}], ";"}]}], "Input",ExpressionUUID->\
"d1ad4e7b-6a61-4613-bc48-2756e3d562d3"],

Cell["3. Test 2: Larger random SPD (5x5 \[CircleTimes] 4x4)", "Section",ExpressionUUID->"6e33d525-e386-4b8d-94b0-d2f5bd038ed4"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "123", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"A2", "=", 
   RowBox[{"randomSPD", "[", "5", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"B2", "=", 
   RowBox[{"randomSPD", "[", "4", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"H2", "=", 
    RowBox[{"KroneckerProduct", "[", 
     RowBox[{"A2", ",", "B2"}], "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"rhoDirect2", "=", 
    RowBox[{"Table", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{
       RowBox[{"Sqrt", "[", 
        RowBox[{
         RowBox[{"Total", "[", 
          RowBox[{
           RowBox[{"H2", "[", 
            RowBox[{"[", "i", "]"}], "]"}], "^", "2"}], "]"}], "-", 
         RowBox[{
          RowBox[{"H2", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", "i"}], "]"}], "]"}], "^", "2"}]}], "]"}], "/", 
       RowBox[{"H2", "[", 
        RowBox[{"[", 
         RowBox[{"i", ",", "i"}], "]"}], "]"}]}], ",", "\[IndentingNewLine]", 
      "  ", 
      RowBox[{"{", 
       RowBox[{"i", ",", 
        RowBox[{"Length", "[", "H2", "]"}]}], "}"}]}], "\[IndentingNewLine]", 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rA2", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Sqrt", "[", 
       RowBox[{
        RowBox[{"Total", "[", 
         RowBox[{
          RowBox[{"A2", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "^", "2"}], "]"}], "-", 
        RowBox[{
         RowBox[{"A2", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "i"}], "]"}], "]"}], "^", "2"}]}], "]"}], "/", 
      RowBox[{"A2", "[", 
       RowBox[{"[", 
        RowBox[{"i", ",", "i"}], "]"}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", 
       RowBox[{"Length", "[", "A2", "]"}]}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"rB2", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Sqrt", "[", 
        RowBox[{
         RowBox[{"Total", "[", 
          RowBox[{
           RowBox[{"B2", "[", 
            RowBox[{"[", "j", "]"}], "]"}], "^", "2"}], "]"}], "-", 
         RowBox[{
          RowBox[{"B2", "[", 
           RowBox[{"[", 
            RowBox[{"j", ",", "j"}], "]"}], "]"}], "^", "2"}]}], "]"}], "/", 
       RowBox[{"B2", "[", 
        RowBox[{"[", 
         RowBox[{"j", ",", "j"}], "]"}], "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"j", ",", 
        RowBox[{"Length", "[", "B2", "]"}]}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"rhoFactored2", "=", 
    RowBox[{"Flatten", "[", 
     RowBox[{"Table", "[", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"Sqrt", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", "+", 
            RowBox[{
             RowBox[{"rA2", "[", 
              RowBox[{"[", "i", "]"}], "]"}], "^", "2"}]}], ")"}], "*", 
          RowBox[{"(", 
           RowBox[{"1", "+", 
            RowBox[{
             RowBox[{"rB2", "[", 
              RowBox[{"[", "j", "]"}], "]"}], "^", "2"}]}], ")"}]}], "-", 
         "1"}], "]"}], ",", "\[IndentingNewLine]", "  ", 
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{"Length", "[", "A2", "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", 
         RowBox[{"Length", "[", "B2", "]"}]}], "}"}]}], "\[IndentingNewLine]",
       "]"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"maxError2", "=", 
   RowBox[{"Max", "[", 
    RowBox[{"Abs", "[", 
     RowBox[{"rhoDirect2", "-", "rhoFactored2"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Test 2: Max error (5x5 x 4x4): \>\"", ",", "maxError2"}], 
   "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<PASS: \>\"", ",", 
    RowBox[{"maxError2", "<", 
     RowBox[{"10", "^", 
      RowBox[{"-", "12"}]}]}]}], "]"}], ";"}]}], "Input",ExpressionUUID->\
"9c27834a-642f-4420-90b5-cfbc500c6ef4"],

Cell["4. Test 3: Equicorrelated formula verification", "Section",ExpressionUUID->"30347318-1d5d-4279-94d3-7eccd624fb5e"],

Cell[TextData[{
 "For equicorrelated matrices with ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["A", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["i", "TI"]}]], "\[LongEqual]", "1"}], TraditionalForm], 
     "errors" -> {}, "input" -> "A_{ii} = 1", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d8baa9e1-f69c-469d-ba40-ab6e52fc8430"],
 ", ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["A", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["k", "TI"]}]], "\[LongEqual]", 
         StyleBox["c", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "A_{ik} = c", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0f83f03e-82a9-4173-a572-fac9d4edafc2"],
 " for ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["k", "TI"], "\[NotEqual]", 
         StyleBox["i", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "k \\neq i", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c0a799a8-eac1-42ef-ad47-1073d6257b7c"],
 ": ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["r", "TI"], 
          RowBox[{
            StyleBox["A", "TI"], ",", 
            StyleBox["i", "TI"]}]], "\[LongEqual]", 
         StyleBox["c", "TI"], 
         SqrtBox[
          RowBox[{
            StyleBox["m", "TI"], "-", "1"}]]}], TraditionalForm], 
     "errors" -> {}, "input" -> "r_{A,i} = c\\sqrt{m-1}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "6c3f9421-d0c9-4076-ab77-5615f3f50bf1"],
 ", and the formula gives ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox["\[Rho]", "2"], "\[LongEqual]", 
         RowBox[{"(", 
           RowBox[{
             StyleBox["m", "TI"], "-", "1"}], ")"}], 
         SubsuperscriptBox[
          StyleBox["c", "TI"], 
          StyleBox["A", "TI"], "2"], "+", 
         RowBox[{"(", 
           RowBox[{
             StyleBox["n", "TI"], "-", "1"}], ")"}], 
         SubsuperscriptBox[
          StyleBox["c", "TI"], 
          StyleBox["B", "TI"], "2"], "+", 
         RowBox[{"(", 
           RowBox[{
             StyleBox["m", "TI"], "-", "1"}], ")"}], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["n", "TI"], "-", "1"}], ")"}], 
         SubsuperscriptBox[
          StyleBox["c", "TI"], 
          StyleBox["A", "TI"], "2"], 
         SubsuperscriptBox[
          StyleBox["c", "TI"], 
          StyleBox["B", "TI"], "2"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\rho^2 = (m-1)c_A^2 + (n-1)c_B^2 + (m-1)(n-1)c_A^2 c_B^2", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "16f09e30-9fb5-47f2-b9cf-2f024b2fa2bb"],
 ". "
}], "Text",ExpressionUUID->"b738a165-3ce2-4d2b-bbfa-193faa22df9c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"m", "=", "64"}], ";", " ", 
  RowBox[{"n", "=", "64"}], ";", " ", 
  RowBox[{"c", "=", "0.1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"formulaRho", "=", 
    RowBox[{"Sqrt", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"m", "-", "1"}], ")"}], "*", 
       RowBox[{"c", "^", "2"}]}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"n", "-", "1"}], ")"}], "*", 
       RowBox[{"c", "^", "2"}]}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"m", "-", "1"}], ")"}], "*", 
       RowBox[{"(", 
        RowBox[{"n", "-", "1"}], ")"}], "*", 
       RowBox[{"c", "^", "4"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Heq", "=", 
   RowBox[{"KroneckerProduct", "[", 
    RowBox[{
     RowBox[{"equicorr", "[", 
      RowBox[{"m", ",", "c"}], "]"}], ",", 
     RowBox[{"equicorr", "[", 
      RowBox[{"n", ",", "c"}], "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"directRho", "=", 
    RowBox[{
     RowBox[{"Sqrt", "[", 
      RowBox[{
       RowBox[{"Total", "[", 
        RowBox[{
         RowBox[{"Heq", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "^", "2"}], "]"}], "-", 
       RowBox[{
        RowBox[{"Heq", "[", 
         RowBox[{"[", 
          RowBox[{"1", ",", "1"}], "]"}], "]"}], "^", "2"}]}], "]"}], "/", 
     RowBox[{"Heq", "[", 
      RowBox[{"[", 
       RowBox[{"1", ",", "1"}], "]"}], "]"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<Test 3: Equicorrelated formula (m=64, n=64, c=0.1)\>\"", 
   "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<  Formula: rho = \>\"", ",", 
    RowBox[{"formulaRho", " ", "//", " ", "N"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<  Direct:  rho = \>\"", ",", 
    RowBox[{"directRho", " ", "//", " ", "N"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<  PASS: \>\"", ",", 
    RowBox[{
     RowBox[{"Abs", "[", 
      RowBox[{"formulaRho", "-", "directRho"}], "]"}], "<", 
     RowBox[{"10", "^", 
      RowBox[{"-", "12"}]}]}]}], "]"}], ";"}]}], "Input",ExpressionUUID->\
"28596386-fb7b-4f86-8917-bad39623a9a0"],

Cell["5. Test 4: Per-row block structure", "Section",ExpressionUUID->"24b0d33d-e3b5-4d42-ac4e-c732c7f3578d"],

Cell[TextData[{
 "Per-row Hutchinson restricts to row ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["i", "TI"], TraditionalForm], "errors" -> {}, "input" -> "i", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "65976d06-3a5f-4c27-92eb-000cf9be7c5b"],
 " of ",
 Cell[BoxData[
  FormBox[
