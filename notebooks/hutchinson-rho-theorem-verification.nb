Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Extract", " ", "per"}], "-", 
     RowBox[{"column", " ", "block", " ", "for", " ", "col", " ", "j"}]}], "=", 
    RowBox[{
     RowBox[{"1", ":", " ", 
      RowBox[{"H", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"i", ",", "0"}], ")"}], ",", 
        RowBox[{"(", 
         RowBox[{"k", ",", "0"}], ")"}]}], "]"}]}], " ", "=", " ", 
     RowBox[{
      RowBox[{"B", "[", 
       RowBox[{"0", ",", "0"}], "]"}], " ", "*", " ", 
      RowBox[{"A", "[", 
       RowBox[{"i", ",", "k"}], "]"}]}]}]}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"colBlock", "=", 
     RowBox[{
      RowBox[{"B3", "[", 
       RowBox[{"[", 
        RowBox[{"1", ",", "1"}], "]"}], "]"}], "*", "A3"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
