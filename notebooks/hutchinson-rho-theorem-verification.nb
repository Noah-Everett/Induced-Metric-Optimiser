        RowBox[{"colBlock", "[", 
         RowBox[{"[", 
          RowBox[{"i", ",", "i"}], "]"}], "]"}]}], ",", "\[IndentingNewLine]",
        "  ", 
       RowBox[{"{", 
        RowBox[{"i", ",", "mDim"}], "}"}]}], "\[IndentingNewLine]", "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
