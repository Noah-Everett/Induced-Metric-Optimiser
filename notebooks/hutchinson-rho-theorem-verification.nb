            RowBox[{"t", "[", 
             RowBox[{"[", "3", "]"}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"5", ",", "4"}], "}"}]}], "]"}], "]"}], ",", "20"}], 
        "]"}]}], "]"}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"{", 
      RowBox[{"t", ",", "thresholds"}], "}"}]}], "\[IndentingNewLine]", "]"}],
    ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<Real neural net correlations are c ~ 0.3-0.8\>\"", "]"}],
   ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<Required c ~ 0.01-0.04 => global Hutchinson is \
fundamentally incompatible\>\"", "]"}], ";"}]}], "Input",ExpressionUUID->\
