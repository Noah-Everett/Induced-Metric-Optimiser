Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "42", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"A3", "=", 
   RowBox[{"randomSPD", "[", "4", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"B3", "=", 
   RowBox[{"randomSPD", "[", "5", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"H3", "=", 
    RowBox[{"KroneckerProduct", "[", 
     RowBox[{"A3", ",", "B3"}], "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"mDim", "=", 
    RowBox[{"Length", "[", "A3", "]"}]}], ";", " ", 
   RowBox[{"nDim", "=", 
    RowBox[{"Length", "[", "B3", "]"}]}], ";"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Extract", " ", "per"}], "-", 
     RowBox[{"row", " ", "block", " ", "for", " ", "row", " ", "i"}]}], "=", 
    RowBox[{
     RowBox[{"1", ":", " ", 
      RowBox[{"H", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"0", ",", "j"}], ")"}], ",", 
        RowBox[{"(", 
         RowBox[{"0", ",", "l"}], ")"}]}], "]"}]}], " ", "=", " ", 
     RowBox[{
      RowBox[{"A", "[", 
       RowBox[{"0", ",", "0"}], "]"}], " ", "*", " ", 
      RowBox[{"B", "[", 
       RowBox[{"j", ",", "l"}], "]"}]}]}]}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"rowBlock", "=", 
    RowBox[{
     RowBox[{"A3", "[", 
      RowBox[{"[", 
       RowBox[{"1", ",", "1"}], "]"}], "]"}], "*", "B3"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
   "Compute", " ", "rho", " ", "from", " ", "the", " ", "row", " ", "block"}],
    " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"rhoPerRow", "=", 
    RowBox[{"Table", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{
       RowBox[{"Sqrt", "[", 
        RowBox[{
         RowBox[{"Total", "[", 
          RowBox[{
           RowBox[{"rowBlock", "[", 
            RowBox[{"[", "j", "]"}], "]"}], "^", "2"}], "]"}], "-", 
         RowBox[{
          RowBox[{"rowBlock", "[", 
           RowBox[{"[", 
            RowBox[{"j", ",", "j"}], "]"}], "]"}], "^", "2"}]}], "]"}], "/", 
       RowBox[{"rowBlock", "[", 
        RowBox[{"[", 
         RowBox[{"j", ",", "j"}], "]"}], "]"}]}], ",", "\[IndentingNewLine]", 
      "  ", 
      RowBox[{"{", 
       RowBox[{"j", ",", "nDim"}], "}"}]}], "\[IndentingNewLine]", "]"}]}], 
   ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"Should", " ", "equal", " ", "r_", 
    RowBox[{"{", 
     RowBox[{"B", ",", "j"}], "}"}]}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"rBdirect", "=", 
    RowBox[{"Table", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{
       RowBox[{"Sqrt", "[", 
        RowBox[{
         RowBox[{"Total", "[", 
          RowBox[{
           RowBox[{"B3", "[", 
            RowBox[{"[", "j", "]"}], "]"}], "^", "2"}], "]"}], "-", 
         RowBox[{
          RowBox[{"B3", "[", 
           RowBox[{"[", 
            RowBox[{"j", ",", "j"}], "]"}], "]"}], "^", "2"}]}], "]"}], "/", 
       RowBox[{"B3", "[", 
        RowBox[{"[", 
         RowBox[{"j", ",", "j"}], "]"}], "]"}]}], ",", "\[IndentingNewLine]", 
      "  ", 
      RowBox[{"{", 
       RowBox[{"j", ",", "nDim"}], "}"}]}], "\[IndentingNewLine]", "]"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", "\"\<Test 4: Per-row rho = r_B\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<  Per-row rho: \>\"", ",", 
    RowBox[{"rhoPerRow", " ", "//", " ", "N"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<  r_B direct:  \>\"", ",", 
    RowBox[{"rBdirect", " ", "//", " ", "N"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
