Cell["7. Test 6: Equicorrelated scaling across dimensions", "Section",ExpressionUUID->"4f2ed88f-08d1-431d-8c54-e78d88b17427"],

Cell["\<\
Show how rho grows with layer dimensions for fixed correlation. \
\>", "Text",ExpressionUUID->"346efaa0-0d2f-416f-9108-c5e4c9d1a7ee"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<Test 6: Equicorrelated rho scaling (c_A = c_B = \
0.05)\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{
    RowBox[{"StringPadRight", "[", 
     RowBox[{"\"\<m\>\"", ",", "6"}], "]"}], ",", 
    RowBox[{"StringPadLeft", "[", 
     RowBox[{"\"\<n\>\"", ",", "6"}], "]"}], ",", "\[IndentingNewLine]", 
    "      ", 
    RowBox[{"StringPadLeft", "[", 
     RowBox[{"\"\<mn\>\"", ",", "8"}], "]"}], ",", 
    RowBox[{"StringPadLeft", "[", 
     RowBox[{"\"\<rho\>\"", ",", "10"}], "]"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Print", "[", 
    RowBox[{"StringJoin", "[", 
     RowBox[{"Table", "[", 
      RowBox[{"\"\<-\>\"", ",", "30"}], "]"}], "]"}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Do", "[", "\[IndentingNewLine]", "  ", 
   RowBox[{
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"rho", "=", 
        RowBox[{"Sqrt", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"m", "-", "1"}], ")"}], "*", 
           RowBox[{"0.05", "^", "2"}]}], "+", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"n", "-", "1"}], ")"}], "*", 
           RowBox[{"0.05", "^", "2"}]}], "+", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"m", "-", "1"}], ")"}], "*", 
           RowBox[{"(", 
            RowBox[{"n", "-", "1"}], ")"}], "*", 
           RowBox[{"0.05", "^", "4"}]}]}], "]"}]}], "}"}], ",", 
      "\[IndentingNewLine]", "    ", 
      RowBox[{
       RowBox[{"Print", "[", 
        RowBox[{
         RowBox[{"StringPadRight", "[", 
          RowBox[{
           RowBox[{"ToString", "[", "m", "]"}], ",", "6"}], "]"}], ",", 
         RowBox[{"StringPadLeft", "[", 
          RowBox[{
           RowBox[{"ToString", "[", "n", "]"}], ",", "6"}], "]"}], ",", 
         "\[IndentingNewLine]", "          ", 
         RowBox[{"StringPadLeft", "[", 
          RowBox[{
           RowBox[{"ToString", "[", 
            RowBox[{"m", "*", "n"}], "]"}], ",", "8"}], "]"}], ",", 
         "\[IndentingNewLine]", "          ", 
         RowBox[{"StringPadLeft", "[", 
          RowBox[{
           RowBox[{"ToString", "[", 
            RowBox[{"NumberForm", "[", 
             RowBox[{"rho", ",", 
              RowBox[{"{", 
               RowBox[{"5", ",", "2"}], "}"}]}], "]"}], "]"}], ",", "10"}], 
          "]"}]}], "]"}], ";"}]}], "\[IndentingNewLine]", "  ", "]"}], ",", 
    "\[IndentingNewLine]", "  ", 
    RowBox[{"{", 
     RowBox[{"m", ",", 
      RowBox[{"{", 
       RowBox[{"16", ",", "64", ",", "256", ",", "784"}], "}"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"n", ",", 
      RowBox[{"{", 
       RowBox[{"16", ",", "64", ",", "256", ",", "784"}], "}"}]}], "}"}]}], 
   "\[IndentingNewLine]", "]"}], ";"}]}], "Input",ExpressionUUID->"b7045cf5-\
9c48-4fd3-a784-fa3704dbd208"],

Cell["8. Test 7: Implied correlation from empirical rho", "Section",ExpressionUUID->"0c0ef6a1-4464-4ad6-aede-71ea1874dd42"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<Test 7: Implied correlation from observed rho\>\"", 
   "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "Solve", " ", "for", " ", "c", " ", "given", " ", "observed", " ", 
     "rho"}], ",", " ", "m", ",", " ", "n"}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"impliedC", "[", 
    RowBox[{"rhoObs_", ",", "mDim_", ",", "nDim_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "x", "}"}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"sol", "=", 
       RowBox[{"Solve", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"mDim", "-", "1"}], ")"}], "*", 
            RowBox[{"x", "^", "2"}]}], "+", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"nDim", "-", "1"}], ")"}], "*", 
            RowBox[{"x", "^", "2"}]}], "+", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"mDim", "-", "1"}], ")"}], "*", 
            RowBox[{"(", 
             RowBox[{"nDim", "-", "1"}], ")"}], "*", 
            RowBox[{"x", "^", "4"}]}]}], "==", 
          RowBox[{"rhoObs", "^", "2"}]}], ",", "x", ",", "Reals"}], "]"}]}], ";",
       "\[IndentingNewLine]", "  ", 
      RowBox[{"x", " ", "/.", " ", 
       RowBox[{
        RowBox[{"Select", "[", 
         RowBox[{"sol", ",", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", 
               RowBox[{"1", ",", "2"}], "]"}], "]"}], ">", "0"}], ")"}], " ", 
           "&"}]}], "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}]}]}]}], "\[IndentingNewLine]", "]"}]}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"MNIST", " ", "MLP", " ", "layers"}], " ", "\[LongDash]", " ", 
    RowBox[{
     RowBox[{"observed", " ", "rho", " ", "from", " ", "IMO"}], "-", 
     "133"}]}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<MNIST dense1 (64x784, rho=42):  c = \>\"", ",", 
    RowBox[{
     RowBox[{"impliedC", "[", 
      RowBox[{"42", ",", "64", ",", "784"}], "]"}], " ", "//", " ", "N"}]}], 
   "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<MNIST dense2 (64x64,  rho=39):  c = \>\"", ",", 
    RowBox[{
     RowBox[{"impliedC", "[", 
      RowBox[{"39", ",", "64", ",", "64"}], "]"}], " ", "//", " ", "N"}]}], 
   "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Print", "[", 
    RowBox[{"\"\<MNIST dense3 (10x64,  rho=11):  c = \>\"", ",", 
     RowBox[{
      RowBox[{"impliedC", "[", 
       RowBox[{"11", ",", "10", ",", "64"}], "]"}], " ", "//", " ", "N"}]}], 
    "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<All physically plausible (0.4-0.8 for correlated MNIST \
data)\>\"", "]"}], ";"}]}], "Input",ExpressionUUID->"868483ff-d185-4578-af68-\
6e5cfc9fddc5"],

Cell["9. Test 8: Prediction table for neural net layers", "Section",ExpressionUUID->"17c38bb6-0c6a-438d-ace3-b3d957f1f08f"],

Cell["\<\
Print[\"Test 8: Predicted rho for neural net layers\"];
Print[\"Using c = 0.425 (implied from MNIST dense1)\"];
Print[\"\"];

c = 0.425114;
layers = {
  {\"dense1 (784->64)\", 64, 784},
  {\"dense2 (64->64)\", 64, 64},
  {\"dense3 (64->10)\", 10, 64},
  {\"attn_qkv (128->128)\", 128, 128},
  {\"attn_out (128->128)\", 128, 128},
  {\"ffn_up (128->512)\", 512, 128}
};

Print[StringPadRight[\"Layer\", 25], \"  \", StringPadLeft[\"m\", 5], \"  \",
      StringPadLeft[\"n\", 5], \"  \", StringPadLeft[\"global rho\", 11], \"  \
\",
      StringPadLeft[\"per-row rho\", 12], \"  \", StringPadLeft[\"per-col rho\
\", 12]];
Print[StringJoin[Table[\"-\", 78]]];

Do[
  Module[{name = layer[[1]], m = layer[[2]], n = layer[[3]], rhoG, rhoR, rhoC},
    rhoG = Sqrt[(m - 1)*c^2 + (n - 1)*c^2 + (m - 1)*(n - 1)*c^4];
    rhoR = c * Sqrt[n - 1];
    rhoC = c * Sqrt[m - 1];
    Print[StringPadRight[name, 25], \"  \", StringPadLeft[ToString[m], 5], \" \
 \",
          StringPadLeft[ToString[n], 5], \"  \",
          StringPadLeft[ToString[NumberForm[rhoG, {5, 1}]], 11], \"  \",
          StringPadLeft[ToString[NumberForm[rhoR, {5, 1}]], 12], \"  \",
          StringPadLeft[ToString[NumberForm[rhoC, {5, 1}]], 12]];
  ],
  {layer, layers}
];

Print[\"\"];
Print[\"Robustness theorem requires rho < 0.3\"];
Print[\"Global rho is always\
\>", "Program",ExpressionUUID->"56569ee9-eb8d-4163-ab92-c2eb5a857374"],

Cell[BoxData[
 RowBox[{
  RowBox[{"1", " ", 
   RowBox[{"(", "broken", ")"}], "\<\"];
Print[\"\>", "Per"}], "-", 
  RowBox[{
   RowBox[{"row", "/", "col"}], " ", "helps", " ", "but", " ", "only", " ", 
   "small", " ", "layers", " ", "reach", " ", 
   RowBox[{"rho", " ", "~", " ", "1"}], "\"\<];\>"}]}]], "Echo",ExpressionUUID\
->"86f9e7ad-5e9f-4ac8-bff0-09eb2df1f93e"],

Cell["10. Test 9: Threshold correlation for rho < 0.3", "Section",ExpressionUUID->"47425fa5-3047-49fb-a087-fac0099cebca"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<Test 9: Maximum correlation for rho < 0.3\>\"", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"thresholds", "=", 
    RowBox[{
     RowBox[{"Table", "[", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"x", ",", "sol"}], "}"}], ",", "\[IndentingNewLine]", 
         "    ", 
         RowBox[{
          RowBox[{"sol", "=", 
           RowBox[{"Solve", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"m", "-", "1"}], ")"}], "*", 
                RowBox[{"x", "^", "2"}]}], "+", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"n", "-", "1"}], ")"}], "*", 
                RowBox[{"x", "^", "2"}]}], "+", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"m", "-", "1"}], ")"}], "*", 
                RowBox[{"(", 
                 RowBox[{"n", "-", "1"}], ")"}], "*", 
                RowBox[{"x", "^", "4"}]}]}], "==", 
              RowBox[{"0.3", "^", "2"}]}], ",", "x", ",", "Reals"}], "]"}]}], 
          ";", "\[IndentingNewLine]", "    ", 
          RowBox[{"cMax", "=", 
           RowBox[{
            RowBox[{"x", " ", "/.", " ", 
             RowBox[{
              RowBox[{"Select", "[", 
               RowBox[{"sol", ",", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"#", "[", 
                    RowBox[{"[", 
                    RowBox[{"1", ",", "2"}], "]"}], "]"}], ">", "0"}], ")"}], 
                 " ", "&"}]}], "]"}], "[", 
              RowBox[{"[", "1", "]"}], "]"}]}], " ", "//", " ", "N"}]}], ";", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"{", 
           RowBox[{"m", ",", "n", ",", "cMax"}], "}"}]}]}], 
        "\[IndentingNewLine]", "  ", "]"}], ",", "\[IndentingNewLine]", "  ", 
       
       RowBox[{"{", 
        RowBox[{"m", ",", 
         RowBox[{"{", 
          RowBox[{"10", ",", "64", ",", "128", ",", "512"}], "}"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"n", ",", 
         RowBox[{"{", 
          RowBox[{"64", ",", "128", ",", "256", ",", "784"}], "}"}]}], 
        "}"}]}], "\[IndentingNewLine]", "]"}], " ", "//", " ", 
     RowBox[{
      RowBox[{"Flatten", "[", 
       RowBox[{"#", ",", "1"}], "]"}], " ", "&"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{
    RowBox[{"StringPadRight", "[", 
     RowBox[{"\"\<m\>\"", ",", "6"}], "]"}], ",", 
    RowBox[{"StringPadLeft", "[", 
     RowBox[{"\"\<n\>\"", ",", "6"}], "]"}], ",", 
    RowBox[{"StringPadLeft", "[", 
     RowBox[{"\"\<max c for rho<0.3\>\"", ",", "20"}], "]"}]}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"StringJoin", "[", 
    RowBox[{"Table", "[", 
     RowBox[{"\"\<-\>\"", ",", "32"}], "]"}], "]"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Do", "[", 
    RowBox[{
     RowBox[{"Print", "[", 
      RowBox[{
       RowBox[{"StringPadRight", "[", 
        RowBox[{
         RowBox[{"ToString", "[", 
          RowBox[{"t", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "]"}], ",", "6"}], "]"}], ",", 
       RowBox[{"StringPadLeft", "[", 
        RowBox[{
         RowBox[{"ToString", "[", 
          RowBox[{"t", "[", 
           RowBox[{"[", "2", "]"}], "]"}], "]"}], ",", "6"}], "]"}], ",", 
       "\[IndentingNewLine]", "         ", 
       RowBox[{"StringPadLeft", "[", 
        RowBox[{
         RowBox[{"ToString", "[", 
          RowBox[{"NumberForm", "[", 
