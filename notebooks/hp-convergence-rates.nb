 ", recovering one-step Newton convergence on quadratics. "
}], "Text",ExpressionUUID->"30a62eef-ca65-49da-939a-4bee00d434d8"],

Cell["3.3 Phase 2 iteration count", "Subsection",ExpressionUUID->"96216866-40b9-4d1a-ab4e-22e96d4e876e"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["T", "TI"], "phase2"], "\[LongEqual]", 
         FractionBox[
          RowBox[{"log", "(", 
            RowBox[{
              StyleBox["L", "TI"], 
              RowBox[{"(", 
                SubscriptBox[
                 StyleBox["T", "TI"], "1"], ")"}], "/", "\[Epsilon]"}], ")"}], 
          RowBox[{"-2", "log", "tanh", 
            RowBox[{"(", "\[Delta]", ")"}]}]]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "T_{\\text{phase2}} = \
\\frac{\\log(L(T_1)/\\varepsilon)}{-2\\log\\tanh(\\delta)}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "fc4744b3-b344-48ea-9b1e-d825cbd91425"],
 "For small ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Delta]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\delta", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "4e7679b7-d352-4b8e-822d-73d286da7163"],
 ": ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["T", "TI"], "phase2"], "\[TildeTilde]", 
         FractionBox[
          RowBox[{"log", "(", 
            RowBox[{
              StyleBox["L", "TI"], 
              RowBox[{"(", 
                SubscriptBox[
                 StyleBox["T", "TI"], "1"], ")"}], "/", "\[Epsilon]"}], ")"}], 
          RowBox[{"-2", "log", "\[Delta]"}]], "\[TildeTilde]", 
         FractionBox[
          RowBox[{"log", "(", 
            RowBox[{"1", "/", "\[Epsilon]"}], ")"}], 
          RowBox[{"2|", "log", "\[Delta]", "|"}]]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "T_{\\text{phase2}} \\approx \
\\frac{\\log(L(T_1)/\\varepsilon)}{-2\\log\\delta} \\approx \
\\frac{\\log(1/\\varepsilon)}{2|\\log\\delta|}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e4ce667d-4425-4dcf-9c6e-3c30cdad4672"],
 ". "
}], "Text",ExpressionUUID->"6f4010b1-b327-4e3d-b217-fe75088ed335"],

Cell["4. Total Iteration Complexity", "Section",ExpressionUUID->"3c52342b-1bf1-4698-878d-efa9fa3965dc"],

Cell["4.1 Optimal delta", "Subsection",ExpressionUUID->"e07ec547-eafe-4058-99b3-e65493558966"],

Cell[TextData[Cell[BoxData[
 FormBox[
  TemplateBox[<|"boxes" -> FormBox[
      RowBox[{
        SubscriptBox[
         StyleBox["T", "TI"], "total"], 
        RowBox[{"(", "\[Delta]", ")"}], "\[LongEqual]", 
        UnderscriptBox[
         UnderscriptBox[
          RowBox[{
            FractionBox["1", 
             SubscriptBox["\[Beta]", 
              StyleBox["s", "TI"]]], "log", 
            FractionBox[
             RowBox[{"\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", 
               SuperscriptBox[
                StyleBox["e", "TI"], "0"], 
               "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9"}], 
             "\[Delta]"]}], "\[UnderBrace]", LimitsPositioning -> False], 
         SubscriptBox[
          StyleBox["T", "TI"], "metric"], LimitsPositioning -> False], "+", 
        UnderscriptBox[
         UnderscriptBox[
          FractionBox[
           RowBox[{"log", "(", 
             RowBox[{"1", "/", "\[Epsilon]"}], ")"}], 
           RowBox[{"-2", "log", "tanh", 
             RowBox[{"(", "\[Delta]", ")"}]}]], "\[UnderBrace]", 
          LimitsPositioning -> False], 
         SubscriptBox[
          StyleBox["T", "TI"], "phase2"], LimitsPositioning -> False]}], 
      TraditionalForm], "errors" -> {}, "input" -> 
    "T_{\\text{total}}(\\delta) = \
\\underbrace{\\frac{1}{\\beta_s}\\log\\frac{|e^0|}{\\delta}}_{T_{\\text{\
metric}}} + \
\\underbrace{\\frac{\\log(1/\\varepsilon)}{-2\\log\\tanh(\\delta)}}_{T_{\\\
text{phase2}}}", "state" -> "Boxes"|>,
   "TeXAssistantTemplate"], 
  TraditionalForm]],ExpressionUUID->"2055f6ce-5ab4-49dd-856c-bad848719b79"]], \
"Text",ExpressionUUID->"fbdc4589-a2fd-4a74-b02d-c7115190ac5d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Clear", "[", "\"\<Global`*\>\"", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"totalT", "[", 
     RowBox[{"delta_", ",", "betaS_", ",", "e0_", ",", "logEps_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"tM", ",", "tP2", ",", "rho"}], "}"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"tM", "=", 
        RowBox[{
         RowBox[{"Log", "[", 
          RowBox[{"e0", "/", "delta"}], "]"}], "/", "betaS"}]}], ";", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"rho", "=", 
        RowBox[{"Tanh", "[", "delta", "]"}]}], ";", "\[IndentingNewLine]", 
       "  ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"rho", ">=", "1"}], "||", 
          RowBox[{"rho", "<=", "0"}]}], ",", 
         RowBox[{"Return", "[", 
          RowBox[{"10.0", "^", "10"}], "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"tP2", "=", 
        RowBox[{"logEps", "/", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "2"}], " ", 
           RowBox[{"Log", "[", "rho", "]"}]}], ")"}]}]}], ";", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"tM", "+", "tP2"}]}]}], "\[IndentingNewLine]", "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
   "Find", " ", "optimal", " ", "delta", " ", "for", " ", "various", " ", 
    "parameters"}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", "\"\<=== Optimal delta ===\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Table", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"opt", ",", "dOpt", ",", "tOpt", ",", "parts"}], "}"}], ",", 
       "\[IndentingNewLine]", "    ", 
       RowBox[{
        RowBox[{"opt", "=", 
         RowBox[{"NMinimize", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"totalT", "[", 
              RowBox[{"d", ",", "bs", ",", "e0", ",", 
               RowBox[{"Log", "[", 
                RowBox[{"1", "/", "eps"}], "]"}]}], "]"}], ",", 
             RowBox[{"0.01", "<", "d", "<", "4.5"}]}], "}"}], ",", "d"}], 
          "]"}]}], ";", "\[IndentingNewLine]", "    ", 
        RowBox[{"dOpt", "=", 
         RowBox[{"d", " ", "/.", " ", 
          RowBox[{"opt", "[", 
           RowBox[{"[", "2", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
        "    ", 
        RowBox[{"tOpt", "=", 
         RowBox[{"opt", "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
        "    ", 
        RowBox[{"parts", "=", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"Log", "[", 
             RowBox[{"e0", "/", "dOpt"}], "]"}], "/", "bs"}], ",", 
           RowBox[{
            RowBox[{"Log", "[", 
             RowBox[{"1", "/", "eps"}], "]"}], "/", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"-", "2"}], " ", 
              RowBox[{"Log", "[", 
               RowBox[{"Tanh", "[", "dOpt", "]"}], "]"}]}], ")"}]}]}], 
          "}"}]}], ";", "\[IndentingNewLine]", "    ", 
        RowBox[{"{", 
         RowBox[{"bs", ",", "e0", ",", "eps", ",", 
          RowBox[{"dOpt", " ", "//", " ", "N"}], ",", 
          RowBox[{"tOpt", " ", "//", " ", "Round"}], ",", 
          RowBox[{
           RowBox[{"parts", "[", 
            RowBox[{"[", "1", "]"}], "]"}], " ", "//", " ", "Round"}], ",", 
          RowBox[{
           RowBox[{"parts", "[", 
            RowBox[{"[", "2", "]"}], "]"}], " ", "//", " ", "Round"}]}], 
         "}"}]}]}], "\[IndentingNewLine]", "  ", "]"}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"{", 
      RowBox[{"bs", ",", 
       RowBox[{"{", "0.01", "}"}]}], "}"}], ",", "\[IndentingNewLine]", "  ", 
     
     RowBox[{"{", 
      RowBox[{"e0", ",", 
       RowBox[{"{", "5.0", "}"}]}], "}"}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"{", 
      RowBox[{"eps", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"10.0", "^", 
          RowBox[{"(", 
           RowBox[{"-", "5"}], ")"}]}], ",", 
         RowBox[{"10.0", "^", 
          RowBox[{"(", 
           RowBox[{"-", "10"}], ")"}]}], ",", 
         RowBox[{"10.0", "^", 
          RowBox[{"(", 
           RowBox[{"-", "20"}], ")"}]}]}], "}"}]}], "}"}]}], 
    "\[IndentingNewLine]", "]"}], " ", "//", " ", 
   RowBox[{
    RowBox[{"Flatten", "[", 
     RowBox[{"#", ",", "2"}], "]"}], " ", "&"}]}], " ", "//", 
  "\[IndentingNewLine]", "  ", 
  RowBox[{
   RowBox[{"TableForm", "[", 
    RowBox[{"#", ",", 
     RowBox[{"TableHeadings", "->", 
      RowBox[{"{", 
       RowBox[{"None", ",", 
        RowBox[{"{", 
         RowBox[{"\"\<betaS\>\"", ",", "\"\<E0\>\"", ",", "\"\<eps\>\"", 
          ",", "\"\<delta*\>\"", ",", "\"\<T_total*\>\"", 
          ",", "\"\<T_metric\>\"", ",", "\"\<T_phase2\>\""}], "}"}]}], 
       "}"}]}]}], "]"}], " ", "&"}]}]}], "Input",ExpressionUUID->"9ad5e8b8-\
acf8-4725-a4cf-a2df06e984fb"],

Cell["4.2 Scaling analysis", "Subsection",ExpressionUUID->"6c0fd253-ebef-437e-8b2c-f88a9ae630fb"],

Cell[TextData[{
 "For large ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Kappa]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\kappa", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "eb761b4a-c0d8-457b-8556-272072ff93fd"],
 ", the optimal ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox["\[Delta]", "*"], TraditionalForm], "errors" -> {}, 
     "input" -> "\\delta^*", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "9fe343b1-9035-4d59-b82d-2dfece24b6cd"],
 " is ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["O", "TI"], "(", "1", ")"}], TraditionalForm], 
     "errors" -> {}, "input" -> "O(1)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b296788a-d9dd-4da3-80c6-1b2446ee3f44"],
 ". The dominant costs are: "
}], "Text",ExpressionUUID->"fc68f0ca-5f65-4770-a87f-787cfaa07de1"],

Cell[TextData[Cell[BoxData[
 FormBox[
  TemplateBox[<|"boxes" -> FormBox[
      RowBox[{
        SubscriptBox[
         StyleBox["T", "TI"], "metric"], "\[LongEqual]", 
        StyleBox["O", "TI"], "\[NegativeThinSpace]", 
        RowBox[{"(", 
          RowBox[{
            FractionBox["1", 
             SubscriptBox["\[Beta]", 
              StyleBox["s", "TI"]]], "log", "log", "\[Kappa]"}], ")"}]}], 
      TraditionalForm], "errors" -> {}, "input" -> 
    "T_{\\text{metric}} = \
O\\!\\left(\\frac{1}{\\beta_s}\\log\\log\\kappa\\right)", "state" -> "Boxes"|>,
   "TeXAssistantTemplate"], 
  TraditionalForm]],ExpressionUUID->"c15850a9-8152-4ba2-9867-cac4b5db3fde"]], \
"Item",ExpressionUUID->"7904f349-343a-40ae-b5bc-30b11625bb34"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["T", "TI"], "phase2"], "\[LongEqual]", 
         StyleBox["O", "TI"], 
         RowBox[{"(", 
           RowBox[{"log", "(", 
             RowBox[{"1", "/", "\[Epsilon]"}], ")"}], ")"}]}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "T_{\\text{phase2}} = O(\\log(1/\\varepsilon))", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "43140961-5ddb-4e7f-9445-648c93062e79"],
 " (independent of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Kappa]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\kappa", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "58262534-1c14-43ae-8921-23d59b7be25d"],
 "!)"
}], "Item",ExpressionUUID->"dbfd54b6-c563-4c2b-8e09-11b472ea6cdd"],

Cell[TextData[{
 "But this analysis assumes ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Eta]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\eta", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ff732f4b-91b8-4c86-97f4-2faffb30ee57"],
 " can vary. **With fixed ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Eta]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\eta", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ad1984c9-1fc2-4cb4-b05f-ef3ad401a7bf"],
 "**, the picture changes. "
}], "Text",ExpressionUUID->"4b0e6cc7-20a5-49d6-9d37-61a7c95a10ed"],

Cell["4.3 Fixed vs adaptive step size", "Subsection",ExpressionUUID->"c94b31e1-c7e8-45ba-a105-982cf07e489c"],

Cell[TextData[{
 "**Fixed ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Eta]", "\[LongEqual]", "2", "/", 
         RowBox[{"(", 
           RowBox[{
             SubscriptBox[
              StyleBox["h", "TI"], "min"], "+", 
             SubscriptBox[
              StyleBox["h", "TI"], "max"]}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\eta = 2/(h_{\\min}+h_{\\max})", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "dce9542f-225a-40c1-aaff-41d9ba39e96f"],
 ":**"
}], "Text",ExpressionUUID->"7eaa1a0a-1a31-4234-8c51-8082937c764c"],

Cell[TextData[{
 "At equilibrium, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Eta]", 
         SubscriptBox[
          StyleBox["h", "TI"], "geo"], "\[LongEqual]", "2", 
         SqrtBox["\[Kappa]"], "/", 
         RowBox[{"(", 
           RowBox[{"1", "+", "\[Kappa]"}], ")"}], "\[TildeTilde]", "2", "/", 
         SqrtBox["\[Kappa]"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\eta h_{\\text{geo}} = 2\\sqrt{\\kappa}/(1+\\kappa) \\approx 2/\\sqrt{\
\\kappa}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "fa30638a-34fa-4333-83cc-1a11779aa069"],
 " for large ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Kappa]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\kappa", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "11f0d448-4efa-4d54-b575-2c35a6c0f954"],
 "."
}], "Text",ExpressionUUID->"e8678894-ff51-4736-b974-5996408887c8"],

Cell[TextData[{
 "Phase 2 rate: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          RowBox[{"(", 
            RowBox[{"1", "-", "\[Eta]", 
              SubscriptBox[
               StyleBox["h", "TI"], "geo"]}], ")"}], "2"], "\[TildeTilde]", 
         "1", "-", "4", "/", 
         SqrtBox["\[Kappa]"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "(1 - \\eta h_{\\text{geo}})^2 \\approx 1 - 4/\\sqrt{\\kappa}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b5fe4a5a-8e86-49ec-886a-779ffd505a75"],
 ". ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["T", "TI"], "phase2"], "\[TildeTilde]", 
         FractionBox[
          SqrtBox["\[Kappa]"], "4"], "log", 
         RowBox[{"(", 
           RowBox[{"1", "/", "\[Epsilon]"}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "T_{\\text{phase2}} \\approx \
\\frac{\\sqrt{\\kappa}}{4}\\log(1/\\varepsilon)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "603ec4c4-f2e6-4450-ad5d-3efffc0cc989"],
 "**Adaptive ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Eta]", 
          StyleBox["t", "TI"]], "\[LongEqual]", "1.5", "/", 
         UnderscriptBox["max", 
          StyleBox["i", "TI"], LimitsPositioning -> True], 
         RowBox[{"(", 
           RowBox[{
             SuperscriptBox[
              StyleBox["e", "TI"], 
              SubsuperscriptBox[
               StyleBox["s", "TI"], 
               StyleBox["i", "TI"], 
               StyleBox["t", "TI"]]], 
             SubscriptBox[
              StyleBox["h", "TI"], 
              StyleBox["i", "TI"]]}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\eta_t = 1.5/\\max_i(e^{s_i^t} h_i)", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "571f41ac-4b08-4ca4-b90a-c53b184217ac"],
 ":**"
}], "Text",ExpressionUUID->"eee1a1b0-99dd-47bb-8100-c2fce4ef0852"],

Cell[TextData[{
 "As the metric converges, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["\[Eta]", 
        StyleBox["t", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\eta_t", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "79cc05cc-e230-4e3a-98ee-35bbba5871be"],
 " automatically increases toward ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"1", "/", 
         SubscriptBox[
          StyleBox["h", "TI"], "geo"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "1/h_{\\text{geo}}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "39970067-96ac-436a-b65b-027523852197"],
 ", giving near-Newton convergence. ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["T", "TI"], "total"], "\[LongEqual]", 
         StyleBox["O", "TI"], "\[NegativeThinSpace]", 
         RowBox[{"(", 
           RowBox[{
             FractionBox["1", 
              SubscriptBox["\[Beta]", 
               StyleBox["s", "TI"]]], "log", "\[Kappa]", "+", "log", 
             RowBox[{"(", 
               RowBox[{"1", "/", "\[Epsilon]"}], ")"}]}], ")"}]}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "T_{\\text{total}} = O\\!\\left(\\frac{1}{\\beta_s}\\log\\kappa + \
\\log(1/\\varepsilon)\\right)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a369a9d7-0c9c-4975-9d38-e59c50063ccd"]
}], "Text",ExpressionUUID->"dc2bb5bb-fa98-4f6d-88fd-237e2cc0425b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Verify", " ", "adaptive", " ", "eta", " ", "scaling"}], " ", 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Clear", "[", "\"\<Global`*\>\"", "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"simulateAdaptive", "[", 
      RowBox[{"hVals_", ",", "betaS_", ",", "epsTarget_"}], "]"}], ":=", 
     RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"nd", "=", 
          RowBox[{"Length", "[", "hVals", "]"}]}], ",", "theta", ",", "s", ",",
          "loss", ",", "loss0", ",", 
         RowBox[{"step", "=", "0"}], ",", "eta"}], "}"}], ",", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{
        RowBox[{"theta", "=", 
         RowBox[{"ConstantArray", "[", 
          RowBox[{"1.0", ",", "nd"}], "]"}]}], ";", "\[IndentingNewLine]", 
        "  ", 
        RowBox[{"s", "=", 
         RowBox[{"ConstantArray", "[", 
          RowBox[{"0.0", ",", "nd"}], "]"}]}], ";", "\[IndentingNewLine]", 
        "  ", 
        RowBox[{"loss0", "=", 
         RowBox[{
          RowBox[{"Total", "[", 
           RowBox[{"hVals", " ", 
            RowBox[{"theta", "^", "2"}]}], "]"}], "/", "2"}]}], ";", 
        "\[IndentingNewLine]", "  ", 
        RowBox[{"loss", "=", "loss0"}], ";", "\[IndentingNewLine]", "  ", 
        RowBox[{"While", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"loss", "/", "loss0"}], ">", "epsTarget"}], "&&", 
           RowBox[{"step", "<", "1000000"}]}], ",", "\[IndentingNewLine]", 
          "    ", 
          RowBox[{
           RowBox[{"eta", "=", 
            RowBox[{"1.5", "/", 
             RowBox[{"Max", "[", 
              RowBox[{
               RowBox[{"Exp", "[", "s", "]"}], " ", "hVals"}], "]"}]}]}], ";",
            "\[IndentingNewLine]", "    ", 
           RowBox[{"theta", "=", 
            RowBox[{"theta", " ", 
             RowBox[{"(", 
              RowBox[{"1", "-", 
               RowBox[{"eta", " ", 
                RowBox[{"Exp", "[", "s", "]"}], " ", "hVals"}]}], ")"}]}]}], ";",
            "\[IndentingNewLine]", "    ", 
           RowBox[{"s", "=", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{"1", "-", "betaS"}], ")"}], " ", "s"}], "+", 
             RowBox[{"betaS", " ", 
              RowBox[{"(", 
               RowBox[{"-", 
                RowBox[{"Log", "[", "hVals", "]"}]}], ")"}]}]}]}], ";", 
           "\[IndentingNewLine]", "    ", 
           RowBox[{"s", "=", 
            RowBox[{"s", "-", 
             RowBox[{"Mean", "[", "s", "]"}]}]}], ";", "\[IndentingNewLine]", 
           "    ", 
           RowBox[{"loss", "=", 
            RowBox[{
             RowBox[{"Total", "[", 
              RowBox[{"hVals", " ", 
               RowBox[{"theta", "^", "2"}]}], "]"}], "/", "2"}]}], ";", 
           "\[IndentingNewLine]", "    ", 
           RowBox[{"step", "++"}], ";"}]}], "\[IndentingNewLine]", "  ", 
         "]"}], ";", "\[IndentingNewLine]", "  ", "step"}]}], 
      "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"simulateGD", "[", 
      RowBox[{"hVals_", ",", "epsTarget_"}], "]"}], ":=", 
     RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"nd", "=", 
          RowBox[{"Length", "[", "hVals", "]"}]}], ",", "theta", ",", "eta", ",",
          "loss", ",", "loss0", ",", 
         RowBox[{"step", "=", "0"}]}], "}"}], ",", "\[IndentingNewLine]", 
       "  ", 
       RowBox[{
        RowBox[{"eta", "=", 
         RowBox[{"2.0", "/", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"Min", "[", "hVals", "]"}], "+", 
            RowBox[{"Max", "[", "hVals", "]"}]}], ")"}]}]}], ";", 
        "\[IndentingNewLine]", "  ", 
        RowBox[{"theta", "=", 
         RowBox[{"ConstantArray", "[", 
          RowBox[{"1.0", ",", "nd"}], "]"}]}], ";", "\[IndentingNewLine]", 
        "  ", 
        RowBox[{"loss0", "=", 
         RowBox[{
          RowBox[{"Total", "[", 
           RowBox[{"hVals", " ", 
            RowBox[{"theta", "^", "2"}]}], "]"}], "/", "2"}]}], ";", 
        "\[IndentingNewLine]", "  ", 
        RowBox[{"loss", "=", "loss0"}], ";", "\[IndentingNewLine]", "  ", 
        RowBox[{"While", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"loss", "/", "loss0"}], ">", "epsTarget"}], "&&", 
           RowBox[{"step", "<", "1000000"}]}], ",", "\[IndentingNewLine]", 
          "    ", 
          RowBox[{
           RowBox[{"theta", "=", 
            RowBox[{"theta", " ", 
             RowBox[{"(", 
              RowBox[{"1", "-", 
               RowBox[{"eta", " ", "hVals"}]}], ")"}]}]}], ";", 
           "\[IndentingNewLine]", "    ", 
           RowBox[{"loss", "=", 
            RowBox[{
             RowBox[{"Total", "[", 
              RowBox[{"hVals", " ", 
               RowBox[{"theta", "^", "2"}]}], "]"}], "/", "2"}]}], ";", 
           "\[IndentingNewLine]", "    ", 
           RowBox[{"step", "++"}], ";"}]}], "\[IndentingNewLine]", "  ", 
         "]"}], ";", "\[IndentingNewLine]", "  ", "step"}]}], 
      "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"simulateMomentum", "[", 
      RowBox[{"hVals_", ",", "epsTarget_"}], "]"}], ":=", 
     RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"nd", "=", 
          RowBox[{"Length", "[", "hVals", "]"}]}], ",", "theta", ",", "v", ",",
          "eta", ",", "beta", ",", "loss", ",", "loss0", ",", 
         RowBox[{"step", "=", "0"}], ",", "kap", ",", "grad"}], "}"}], ",", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{
        RowBox[{"kap", "=", 
         RowBox[{
          RowBox[{"Max", "[", "hVals", "]"}], "/", 
          RowBox[{"Min", "[", "hVals", "]"}]}]}], ";", "\[IndentingNewLine]", 
        "  ", 
        RowBox[{"eta", "=", 
         RowBox[{"4.0", "/", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"Sqrt", "[", 
               RowBox[{"Max", "[", "hVals", "]"}], "]"}], "+", 
              RowBox[{"Sqrt", "[", 
               RowBox[{"Min", "[", "hVals", "]"}], "]"}]}], ")"}], "^", "2"}],
            ")"}]}]}], ";", "\[IndentingNewLine]", "  ", 
        RowBox[{"beta", "=", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"Sqrt", "[", "kap", "]"}], "-", "1"}], ")"}], "/", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"Sqrt", "[", "kap", "]"}], "+", "1"}], ")"}]}], ")"}], "^",
           "2"}]}], ";", "\[IndentingNewLine]", "  ", 
        RowBox[{"theta", "=", 
         RowBox[{"ConstantArray", "[", 
          RowBox[{"1.0", ",", "nd"}], "]"}]}], ";", "\[IndentingNewLine]", 
        "  ", 
        RowBox[{"v", "=", 
         RowBox[{"ConstantArray", "[", 
          RowBox[{"0.0", ",", "nd"}], "]"}]}], ";", "\[IndentingNewLine]", 
        "  ", 
        RowBox[{"loss0", "=", 
         RowBox[{
          RowBox[{"Total", "[", 
           RowBox[{"hVals", " ", 
            RowBox[{"theta", "^", "2"}]}], "]"}], "/", "2"}]}], ";", 
        "\[IndentingNewLine]", "  ", 
        RowBox[{"loss", "=", "loss0"}], ";", "\[IndentingNewLine]", "  ", 
        RowBox[{"While", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"loss", "/", "loss0"}], ">", "epsTarget"}], "&&", 
           RowBox[{"step", "<", "1000000"}]}], ",", "\[IndentingNewLine]", 
          "    ", 
          RowBox[{
           RowBox[{"grad", "=", 
            RowBox[{"hVals", " ", "theta"}]}], ";", "\[IndentingNewLine]", 
           "    ", 
           RowBox[{"v", "=", 
            RowBox[{
             RowBox[{"beta", " ", "v"}], "-", 
             RowBox[{"eta", " ", "grad"}]}]}], ";", "\[IndentingNewLine]", 
           "    ", 
           RowBox[{"theta", "=", 
            RowBox[{"theta", "+", "v"}]}], ";", "\[IndentingNewLine]", "    ", 
           RowBox[{"loss", "=", 
            RowBox[{
             RowBox[{"Total", "[", 
              RowBox[{"hVals", " ", 
               RowBox[{"theta", "^", "2"}]}], "]"}], "/", "2"}]}], ";", 
           "\[IndentingNewLine]", "    ", 
           RowBox[{"step", "++"}], ";"}]}], "\[IndentingNewLine]", "  ", 
         "]"}], ";", "\[IndentingNewLine]", "  ", "step"}]}], 
      "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"epsTarget", "=", 
     RowBox[{"10.0", "^", 
      RowBox[{"(", 
       RowBox[{"-", "10"}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"betaS", "=", "0.01"}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
