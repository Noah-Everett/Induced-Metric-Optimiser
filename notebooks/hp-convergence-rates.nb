   RowBox[{
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{"Log", "[", "1", "]"}], "+", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Log", "[", "1000", "]"}], "-", 
           RowBox[{"Log", "[", "1", "]"}]}], ")"}], " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"i", "-", "1"}], ")"}], "/", "9"}]}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "10"}], "}"}]}], "]"}], " ", "//", " ", "N"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sStar", "=", 
   RowBox[{
    RowBox[{"-", 
     RowBox[{"Log", "[", "hVals", "]"}]}], "+", 
    RowBox[{"Mean", "[", 
     RowBox[{"Log", "[", "hVals", "]"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"betaS", "=", "0.01"}], ";"}], "\[IndentingNewLine]", 
