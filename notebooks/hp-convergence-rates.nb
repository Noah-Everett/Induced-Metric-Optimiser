Cell[TextData[{
 "The key result: ",
 StyleBox["with adaptive step size, the condition number enters only \
logarithmically.",
  FontWeight->Bold],
 " This is exponentially better than GD and polynomially better than \
momentum. "
}], "Text",ExpressionUUID->"37c6fde2-f158-44da-8778-bd59b4cfc04f"],

Cell["Numerical evidence", "Subsection",ExpressionUUID->"12b05ab2-7443-474a-a13a-7442732078b1"],

Cell[BoxData[
 PaneBox[
  PaneBox[
   StyleBox[
    TagBox[
     TagBox[GridBox[{
        {
         TagBox[Cell[BoxData[
           FormBox[
            
            TemplateBox[<|
             "boxes" -> FormBox["\[Kappa]", TraditionalForm], "errors" -> {}, 
              "input" -> "\\kappa", "state" -> "Boxes"|>,
