           "c8554cd5-42d8-419c-a302-d2dfd3d3b330"],
          HoldForm], 
         TagBox["\<\"GD\"\>",
          HoldForm], 
         TagBox["\<\"Momentum\"\>",
          HoldForm], 
         TagBox["\<\"Derived\"\>",
          HoldForm], 
         TagBox["\<\"GD/Derived\"\>",
          HoldForm], 
         TagBox["\<\"Mom/Derived\"\>",
          HoldForm]},
        {"\<\"10\"\>", "\<\"55\"\>", "\<\"22\"\>", "\<\"38\"\>", \
"\<\"1.4x\"\>", "\<\"0.6x\"\>"},
        {"\<\"100\"\>", "\<\"554\"\>", "\<\"80\"\>", "\<\"89\"\>", \
"\<\"6.2x\"\>", "\<\"0.9x\"\>"},
        {"\<\"1,000\"\>", "\<\"5,601\"\>", "\<\"277\"\>", "\<\"124\"\>", \
"\<\"45x\"\>", "\<\"2.2x\"\>"},
        {"\<\"10,000\"\>", "\<\"56,452\"\>", "\<\"942\"\>", "\<\"148\"\>", \
"\<\"381x\"\>", "\<\"6.4x\"\>"}
       },
       GridBoxAlignment->{
        "Columns" -> {Center, Center, Center, Center, Center, {Center}}, 
         "Rows" -> {{Baseline}}},
       GridBoxDividers->{
        "Columns" -> {{False}}, "Rows" -> {False, True, {False}, False}},
       GridBoxSpacings->{"Columns" -> {
           Offset[0.27999999999999997`], {
            Offset[2.0999999999999996`]}, 
           Offset[0.27999999999999997`]}, "Rows" -> {
           Offset[0.2], {
            Offset[0.4]}, 
           Offset[0.2]}}],
      {None, OutputFormsDump`HeadedColumns}],
     Function[BoxForm`e$, 
      TableForm[BoxForm`e$, TableHeadings -> {None, {
          RawBoxes[
           Cell[
            BoxData[
             FormBox[
              
              TemplateBox[<|
               "boxes" -> FormBox["\[Kappa]", TraditionalForm], 
                "errors" -> {}, "input" -> "\\kappa", "state" -> "Boxes"|>, 
               "TeXAssistantTemplate"], TraditionalForm]]]], "GD", "Momentum",
           "Derived", "GD/Derived", "Mom/Derived"}}]]], "Text",
    StripOnInput->False,
    ShowStringCharacters->False],
   ImageMargins->{{0, 0}, {5, 5}}],
  ImageMargins->{{0, 0}, {5, 5}}]], "TextTableForm", \
"Text",ExpressionUUID->"f0c11ed4-578c-450b-b4d0-4090901804bf"],

Cell[TextData[{
 "Crossover with momentum: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Kappa]", "\[TildeTilde]", "200"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\kappa \\approx 200", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "44d69d1f-6e4b-45da-b0cb-2daebe471f50"],
 "."
}], "Text",ExpressionUUID->"ca64f0c2-482a-4812-bcab-866543e3f3ef"],

Cell[TextData[{
 "Empirical scaling: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["T", "TI"], "derived"], "\[TildeTilde]", "8", "+", "16", 
         "log", "\[Kappa]"}], TraditionalForm], "errors" -> {}, "input" -> 
     "T_{\\text{derived}} \\approx 8 + 16\\log\\kappa", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b991cb02-b097-4e45-b502-2423fc4f4ea8"],
 " vs ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["T", "TI"], "momentum"], "\[TildeTilde]", "9", 
         SqrtBox["\[Kappa]"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "T_{\\text{momentum}} \\approx 9\\sqrt{\\kappa}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "cd78e0fc-5c17-4ddb-a3de-e7fbc6ea4ad0"],
 ". "
}], "Text",ExpressionUUID->"bf96771c-de02-4593-a910-dd52c28e759d"],

Cell["8. Summary", "Section",ExpressionUUID->"85cba97e-4698-4c80-9c44-3fa250f30363"],

Cell[TextData[{
 "1. ",
 StyleBox["Metric convergence (Theorem 1):",
  FontWeight->Bold],
 " ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["T", "TI"], "metric"], "\[LongEqual]", 
         FractionBox["1", 
          SubscriptBox["\[Beta]", 
           StyleBox["s", "TI"]]], "log", 
         RowBox[{"(", 
           RowBox[{"\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", 
             SuperscriptBox[
              StyleBox["e", "TI"], "0"], 
             "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", "/", 
             "\[Delta]"}], ")"}]}], TraditionalForm], "errors" -> {}, "input" -> 
     "T_{\\text{metric}} = \\frac{1}{\\beta_s}\\log(|e^0|/\\delta)", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "4fa8d27d-3173-462a-bf1b-cdf5a177d6aa"],
 ". Linear in ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"1", "/", 
         SubscriptBox["\[Beta]", 
          StyleBox["s", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "1/\\beta_s", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f1ecbd10-2377-4487-875e-c3e2cc0ee1f5"],
 ", logarithmic in initial error and tolerance."
}], "Text",ExpressionUUID->"62a089c8-49c8-41e2-806a-9b1b8a8ded31"],

Cell[TextData[{
 "2. ",
 StyleBox["Optimal Phase 2 rate (Theorem 2):",
  FontWeight->Bold],
 " ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox["\[Rho]", "*"], 
         RowBox[{"(", "\[Delta]", ")"}], "\[LongEqual]", "tanh", 
         RowBox[{"(", "\[Delta]", ")"}], "\[TildeTilde]", "\[Delta]"}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\rho^*(\\delta) = \\tanh(\\delta) \\approx \\delta", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a806fff6-6d3c-424b-9b8d-bc61035a4c3a"],
 " for small ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Delta]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\delta", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b0f3b177-1a56-4166-83de-222cd7750096"],
 ". Perfect Newton at ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Delta]", "\[LongEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\delta = 0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "2f547c03-8e4a-4c60-a68e-419245b2100f"],
 "."
}], "Text",ExpressionUUID->"da43290e-c125-41e3-9f8a-8fecae34cb4e"],

Cell[TextData[{
 "3. ",
 StyleBox["Adaptive-eta complexity:",
  FontWeight->Bold],
 " ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["T", "TI"], "\[LongEqual]", 
         StyleBox["O", "TI"], "\[NegativeThinSpace]", 
         RowBox[{"(", 
           RowBox[{
             FractionBox["1", 
              SubscriptBox["\[Beta]", 
               StyleBox["s", "TI"]]], "log", "\[Kappa]", "+", "log", 
             RowBox[{"(", 
               RowBox[{"1", "/", "\[Epsilon]"}], ")"}]}], ")"}]}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "T = O\\!\\left(\\frac{1}{\\beta_s}\\log\\kappa + \
\\log(1/\\varepsilon)\\right)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "7da08875-3b81-48b0-b495-c96f856d6c35"],
 ". The condition number appears only logarithmically. Verified numerically \
up to ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Kappa]", "\[LongEqual]", 
         SuperscriptBox["10", "4"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\kappa = 10^4", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b2292fc8-31c6-4391-82e0-4a55a8c4d608"],
 "."
}], "Text",ExpressionUUID->"1028f237-c943-49ec-a290-cfd23ac79a30"],

Cell[TextData[{
 "4. ",
 StyleBox["Stochastic case (Theorem 3):",
  FontWeight->Bold],
 " Noise floor ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Delta]", "\[Infinity]"], "\[LongEqual]", 
         SqrtBox[
          RowBox[{
            SubscriptBox["\[Beta]", 
             StyleBox["s", "TI"]], "/", 
            RowBox[{"(", 
              RowBox[{"2", "-", 
                SubscriptBox["\[Beta]", 
                 StyleBox["s", "TI"]]}], ")"}]}]], " ", 
         SubscriptBox["\[Sigma]", 
          StyleBox["w", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\delta_\\infty = \\sqrt{\\beta_s/(2-\\beta_s)}\\;\\sigma_w", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "2f1d5e19-c57e-4c95-9181-8db6fb0ce413"],
 " limits achievable precision. On diagonal quadratics, Hutchinson is exact \
so no floor."
}], "Text",ExpressionUUID->"71b71077-6887-4a78-bc36-5229b861d09b"],

Cell[TextData[{
 "5. ",
 StyleBox["Comparison:",
  FontWeight->Bold],
 " Beats GD at ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Kappa]\[GreaterTilde]", "20"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\kappa \\gtrsim 20", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "13746453-058f-414e-99a4-57447944acb0"],
 ", beats momentum at ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Kappa]\[GreaterTilde]", "200"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\kappa \\gtrsim 200", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "dc583126-1dd9-4fac-bfdb-20bcb4fbdbae"],
 ". The advantage grows with ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Kappa]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\kappa", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "9c4f9953-3a71-41c9-a7f9-552603cb67ed"],
 "."
}], "Text",ExpressionUUID->"a19dbab3-23de-4d28-8bf3-130a29ff4f6b"]
},
