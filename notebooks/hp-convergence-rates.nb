 " regime)"
}], "Subsection",ExpressionUUID->"df87810e-a944-4994-8c3a-75a459b78551"],

Cell[TextData[{
 "For small metric error: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox["\[Rho]", "*"], 
         RowBox[{"(", "\[Delta]", ")"}], "\[LongEqual]", "tanh", 
         RowBox[{"(", "\[Delta]", ")"}], "\[TildeTilde]", "\[Delta]"}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\rho^*(\\delta) = \\tanh(\\delta) \\approx \\delta", "state" -> 
     "Boxes"|>,
