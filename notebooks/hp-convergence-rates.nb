(* Beginning of Notebook Content *)
Notebook[{
Cell["\<\
IMO-132: Explicit Convergence Rates --- Two-Phase Iteration Complexity\
\>", "Title",ExpressionUUID->"4c6ac3ae-5d24-4882-a26e-98b95865ce5e"],

Cell["\<\
Derives explicit iteration complexity for the derived optimizer on diagonal \
quadratics.\
\>", "Text",ExpressionUUID->"7d87729a-60e8-4b50-82c7-02debb38a04c"],

Cell[TextData[{
 "Companion theory note: ",
 Cell[BoxData[Cell["notes/convergence-rates.md",
   Background->None,ExpressionUUID->"79df9e2f-cdc6-4f2a-bc87-222afde7e84f"]], 
  "InlineCode",ExpressionUUID->"a5f0a511-0430-454c-a968-bd01a6f2727e"],
 ". "
}], "Text",ExpressionUUID->"b32436bb-9fe7-4f5b-b698-ac2a400c28a8"],

Cell["1. Setup", "Section",ExpressionUUID->"db718634-49ec-47c8-89d5-13b98a76d7c1"],

Cell[TextData[{
 "On a diagonal quadratic ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["L", "TI"], 
         RowBox[{"(", "\[Theta]", ")"}], "\[LongEqual]", 
         FractionBox["1", "2"], 
         UnderscriptBox["\[Sum]", 
          StyleBox["i", "TI"], LimitsPositioning -> True], 
         SubscriptBox[
          StyleBox["h", "TI"], 
          StyleBox["i", "TI"]], 
         SubsuperscriptBox["\[Theta]", 
          StyleBox["i", "TI"], "2"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "L(\\theta) = \\frac{1}{2}\\sum_i h_i \\theta_i^2", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "17e7bdb0-f7fa-4a93-9643-473eaa8cb143"],
 " with condition number ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Kappa]", "\[LongEqual]", 
         SubscriptBox[
          StyleBox["h", "TI"], "max"], "/", 
         SubscriptBox[
          StyleBox["h", "TI"], "min"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\kappa = h_{\\max}/h_{\\min}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "115cc2f2-2081-437b-8ddf-dcc6e49fe0e5"],
 ".",
 StyleBox["Parameter update:",
  FontWeight->Bold],
 " ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Theta]", 
          StyleBox["i", "TI"]], "\[LeftArrow]", 
         SubscriptBox["\[Theta]", 
          StyleBox["i", "TI"]], "-", "\[Eta] ", 
         SuperscriptBox[
          StyleBox["e", "TI"], 
          SubscriptBox[
           StyleBox["s", "TI"], 
           StyleBox["i", "TI"]]], " ", 
         SubscriptBox[
          StyleBox["h", "TI"], 
          StyleBox["i", "TI"]], " ", 
         SubscriptBox["\[Theta]", 
          StyleBox["i", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\theta_i \\leftarrow \\theta_i - \\eta\\, e^{s_i}\\, h_i\\, \\theta_i",
      "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f30cae59-d7f8-4d43-8bde-c295ce5e0b84"],
 StyleBox["Metric update:",
  FontWeight->Bold],
 " ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubsuperscriptBox[
          StyleBox["s", "TI"], 
          StyleBox["i", "TI"], 
          RowBox[{
            StyleBox["t", "TI"], "+", "1"}]], "\[LongEqual]", 
         RowBox[{"(", 
           RowBox[{"1", "-", 
             SubscriptBox["\[Beta]", 
              StyleBox["s", "TI"]]}], ")"}], " ", 
         SubsuperscriptBox[
          StyleBox["s", "TI"], 
          StyleBox["i", "TI"], 
          StyleBox["t", "TI"]], "+", 
         SubscriptBox["\[Beta]", 
          StyleBox["s", "TI"]], " ", 
         RowBox[{"(", 
           RowBox[{"-", "log", 
             SubscriptBox[
              StyleBox["h", "TI"], 
              StyleBox["i", "TI"]]}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "s_i^{t+1} = (1-\\beta_s)\\, s_i^t + \\beta_s\\,(-\\log h_i)", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "50973b29-113f-4fa4-897f-31589264755b"],
 ", followed by mean-centering.",
 StyleBox["Newton target:",
  FontWeight->Bold],
 " ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubsuperscriptBox[
          StyleBox["s", "TI"], 
          StyleBox["i", "TI"], "*"], "\[LongEqual]", "-", "log", 
         SubscriptBox[
          StyleBox["h", "TI"], 
          StyleBox["i", "TI"]], "+", 
         OverscriptBox[
          RowBox[{"log", 
            StyleBox["h", "TI"]}], "_"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "s_i^* = -\\log h_i + \\overline{\\log h}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "523ce294-821f-477f-920e-3fb48d0d633e"],
 ". At this target, all preconditioned eigenvalues equal ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["h", "TI"], "geo"], "\[LongEqual]", "exp", 
         RowBox[{"(", 
           OverscriptBox[
            RowBox[{"log", 
              StyleBox["h", "TI"]}], "_"], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "h_{\\text{geo}} = \\exp(\\overline{\\log h})", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "4d4c54b1-b696-4de7-ac17-976eae973dff"],
 ". "
}], "Text",ExpressionUUID->"4642a5e7-5609-4451-94c9-c62e0692537a"],

Cell["2. Phase 1: Metric Convergence Rate", "Section",ExpressionUUID->"68ce886b-0d7b-4fc5-84f2-593e346c268c"],

Cell["2.1 Deterministic case", "Subsection",ExpressionUUID->"edc5a3aa-2e18-408c-9c67-f05bb8d51693"],

Cell[TextData[{
 "The metric error ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubsuperscriptBox[
          StyleBox["e", "TI"], 
          StyleBox["i", "TI"], 
          StyleBox["t", "TI"]], "\[LongEqual]", 
         SubsuperscriptBox[
          StyleBox["s", "TI"], 
          StyleBox["i", "TI"], 
          StyleBox["t", "TI"]], "-", 
         SubsuperscriptBox[
          StyleBox["s", "TI"], 
          StyleBox["i", "TI"], "*"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "e_i^t = s_i^t - s_i^*", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "9449cd1a-f1bf-4352-a124-c88acb6244e0"],
 " satisfies the linear recursion ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubsuperscriptBox[
          StyleBox["e", "TI"], 
          StyleBox["i", "TI"], 
          RowBox[{
            StyleBox["t", "TI"], "+", "1"}]], "\[LongEqual]", 
         RowBox[{"(", 
           RowBox[{"1", "-", 
             SubscriptBox["\[Beta]", 
              StyleBox["s", "TI"]]}], ")"}], " ", 
         SubsuperscriptBox[
          StyleBox["e", "TI"], 
          StyleBox["i", "TI"], 
          StyleBox["t", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "e_i^{t+1} = (1 - \\beta_s)\\, e_i^t", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d9d17522-4753-4922-b586-6ca84763b403"],
 ". Mean-centering is a no-op since both ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox[
        StyleBox["s", "TI"], 
        StyleBox["t", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "s^t", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "55a604b4-5320-4781-a7d6-2f26c238f2a3"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox[
        StyleBox["s", "TI"], "*"], TraditionalForm], "errors" -> {}, "input" -> 
     "s^*", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5b047def-49bf-4488-b1a4-c96753c0ab49"],
 " are mean-centered. "
}], "Text",ExpressionUUID->"028f4b88-b3d9-4d6f-bd36-1ce07eeb6b08"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Clear", "[", "\"\<Global`*\>\"", "]"}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"Metric", " ", "error", " ", "decay"}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", "\"\<=== Metric Error Decay ===\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", "\"\<e_i^t = (1 - beta_s)^t * e_i^0\>\"", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", "\"\<||e^t|| = (1 - beta_s)^t * ||e^0||\>\"", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"Verify", ":", " ", 
    RowBox[{"log", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "/", 
        RowBox[{"(", 
         RowBox[{"1", "-", "betaS"}], ")"}]}], ")"}], " ", "~", " ", 
      "betaS"}], " ", "for", " ", "small", " ", "betaS"}]}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<Approximation quality: log(1/(1-betaS)) / betaS\>\"", 
   "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Table", "[", "\[IndentingNewLine]", "  ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"b", ",", 
      RowBox[{
       RowBox[{
        RowBox[{"Log", "[", 
         RowBox[{"1", "/", 
          RowBox[{"(", 
           RowBox[{"1", "-", "b"}], ")"}]}], "]"}], "/", "b"}], " ", "//", 
       " ", "N"}]}], "}"}], ",", "\[IndentingNewLine]", "  ", 
    RowBox[{"{", 
     RowBox[{"b", ",", 
      RowBox[{"{", 
       RowBox[{"0.001", ",", "0.01", ",", "0.05", ",", "0.1"}], "}"}]}], 
     "}"}]}], "\[IndentingNewLine]", "]"}], " ", "//", " ", 
  RowBox[{
   RowBox[{"TableForm", "[", 
    RowBox[{"#", ",", 
     RowBox[{"TableHeadings", "->", 
      RowBox[{"{", 
       RowBox[{"None", ",", 
        RowBox[{"{", 
         RowBox[{"\"\<beta_s\>\"", ",", "\"\<ratio\>\""}], "}"}]}], "}"}]}]}],
     "]"}], " ", "&"}]}]}], "Input",ExpressionUUID->"760a9a51-4b0f-4d1b-93da-\
2e0f33d49807"],

Cell["Theorem 1 (Metric convergence time)", "Subsection",ExpressionUUID->"f115b137-9c47-4e70-a4a0-89292a815104"],

Cell[TextData[{
 "The metric reaches ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", 
         SuperscriptBox[
          StyleBox["e", "TI"], 
          StyleBox["t", "TI"]], 
         "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", 
         "\[LessEqual]", "\[Delta]"}], TraditionalForm], "errors" -> {}, 
     "input" -> "|e^t| \\leq \\delta", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "68125c29-b886-49b4-8a24-e703c9c07a95"],
 " in ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["T", "TI"], "metric"], "\[LongEqual]", 
         RowBox[{"\[LeftCeiling]", 
           FractionBox[
            RowBox[{"log", "(", 
              RowBox[{"\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", 
                SuperscriptBox[
                 StyleBox["e", "TI"], "0"], 
                "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", "/", 
                "\[Delta]"}], ")"}], 
            RowBox[{"log", "(", 
              RowBox[{"1", "/", 
                RowBox[{"(", 
                  RowBox[{"1", "-", 
                    SubscriptBox["\[Beta]", 
                    StyleBox["s", "TI"]]}], ")"}]}], ")"}]], 
           "\[RightCeiling]"}], "\[TildeTilde]", 
         FractionBox["1", 
          SubscriptBox["\[Beta]", 
           StyleBox["s", "TI"]]], " ", "log", "\[NegativeThinSpace]", 
         RowBox[{"(", 
           FractionBox[
            RowBox[{"\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", 
              SuperscriptBox[
               StyleBox["e", "TI"], "0"], 
              "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9"}], 
            "\[Delta]"], ")"}]}], TraditionalForm], "errors" -> {}, "input" -> 
     "T_{\\text{metric}} = \\left\\lceil \
\\frac{\\log(|e^0|/\\delta)}{\\log(1/(1-\\beta_s))} \\right\\rceil \\approx \
\\frac{1}{\\beta_s}\\,\\log\\!\\left(\\frac{|e^0|}{\\delta}\\right)", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d24f4556-3c45-4129-8173-649b193bffe3"],
 "steps. "
}], "Text",ExpressionUUID->"8dbd31c3-eb55-4eb7-825a-8aa367c566ea"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Initial", " ", 
      RowBox[{"error", ":", " ", 
       RowBox[{"s", "^", "0"}]}]}], " ", "=", " ", "0"}], ",", " ", 
    RowBox[{
     RowBox[{"s", "*"}], " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "log"}], " ", "h"}], " ", "+", " ", 
      RowBox[{"mean", 
       RowBox[{"(", 
        RowBox[{"log", " ", "h"}], ")"}]}]}]}]}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"||", 
     RowBox[{"e", "^", "0"}], "||", 
     RowBox[{"^", "2"}]}], " ", "=", " ", 
    RowBox[{
     RowBox[{"sum_i", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"log", " ", "h_i"}], " ", "-", " ", 
         RowBox[{"mean", 
          RowBox[{"(", 
           RowBox[{"log", " ", "h"}], ")"}]}]}], ")"}], "^", "2"}]}], " ", "=",
      " ", 
     RowBox[{"N", " ", "*", " ", "Var", 
      RowBox[{"(", 
       RowBox[{"log", " ", "h"}], ")"}]}]}]}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"For", " ", "two"}], "-", 
     RowBox[{"point", " ", "spectrum", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"fraction", " ", "alpha", " ", "at", " ", "hmin"}], ",", " ", 
        
        RowBox[{"rest", " ", "at", " ", "hmax"}]}], ")"}]}]}], ":"}], " ", 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"||", 
     RowBox[{"e", "^", "0"}], "||", 
     RowBox[{"^", "2"}]}], " ", "=", " ", 
    RowBox[{"N", " ", "*", " ", "alpha", 
     RowBox[{"(", 
      RowBox[{"1", "-", "alpha"}], ")"}], " ", "*", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"log", " ", "kappa"}], ")"}], "^", "2"}]}]}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Maximum", " ", "at", " ", "alpha"}], "=", 
    RowBox[{
     RowBox[{
      RowBox[{"1", "/", "2"}], ":", " ", 
      RowBox[{"||", 
       RowBox[{"e", "^", "0"}], "||"}]}], " ", "=", " ", 
     RowBox[{"sqrt", 
      RowBox[{
       RowBox[{"(", "N", ")"}], "/", "2"}], " ", "*", " ", "log", 
      RowBox[{"(", "kappa", ")"}]}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Print", "[", "\"\<=== Initial Metric Error ===\>\"", "]"}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<||e^0|| = sqrt(N * alpha(1-alpha)) * log(kappa)\>\"", 
     "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Maximum: ||e^0|| = sqrt(N)/2 * log(kappa) (at \
alpha=1/2)\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"Numerical", " ", 
     RowBox[{"examples", ":", " ", "T_metric"}]}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<=== T_metric for N=10, alpha=0.5, beta_s=0.01 ===\>\"",
      "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Table", "[", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"e0", ",", "tM"}], "}"}], ",", "\[IndentingNewLine]", 
         "    ", 
         RowBox[{
          RowBox[{"e0", "=", 
           RowBox[{
            RowBox[{"Sqrt", "[", 
             RowBox[{"10", " ", "0.5", " ", "0.5"}], "]"}], " ", 
            RowBox[{"Log", "[", "kap", "]"}]}]}], ";", "\[IndentingNewLine]", 
          "    ", 
          RowBox[{"tM", "=", 
           RowBox[{"Ceiling", "[", 
            RowBox[{
             RowBox[{"Log", "[", 
              RowBox[{"e0", "/", "delta"}], "]"}], "/", 
             RowBox[{"Log", "[", 
              RowBox[{"1", "/", 
               RowBox[{"(", 
                RowBox[{"1", "-", "0.01"}], ")"}]}], "]"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"{", 
           RowBox[{"kap", ",", "delta", ",", 
            RowBox[{"e0", " ", "//", " ", "N"}], ",", "tM"}], "}"}]}]}], 
        "\[IndentingNewLine]", "  ", "]"}], ",", "\[IndentingNewLine]", "  ", 
       
       RowBox[{"{", 
        RowBox[{"kap", ",", 
         RowBox[{"{", 
          RowBox[{"10", ",", "100", ",", "1000", ",", "10000"}], "}"}]}], 
        "}"}], ",", "\[IndentingNewLine]", "  ", 
       RowBox[{"{", 
        RowBox[{"delta", ",", 
         RowBox[{"{", 
          RowBox[{"0.1", ",", "0.01"}], "}"}]}], "}"}]}], 
      "\[IndentingNewLine]", "]"}], " ", "//", " ", 
     RowBox[{
      RowBox[{"Flatten", "[", 
       RowBox[{"#", ",", "1"}], "]"}], " ", "&"}]}], " ", "//", 
    "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"TableForm", "[", 
      RowBox[{"#", ",", 
       RowBox[{"TableHeadings", "->", 
        RowBox[{"{", 
         RowBox[{"None", ",", 
          RowBox[{"{", 
           
           RowBox[{"\"\<kappa\>\"", ",", "\"\<delta\>\"", 
            ",", "\"\<||e^0||\>\"", ",", "\"\<T_metric\>\""}], "}"}]}], 
         "}"}]}]}], "]"}], " ", "&"}]}]}]}]], "Input",ExpressionUUID->\
"2c442569-acea-4f73-bf15-b4557a369030"],

Cell["2.2 With Hutchinson noise", "Subsection",ExpressionUUID->"1f6388d6-ec28-4dda-9bba-df01d172909f"],

Cell[TextData[{
 "On a diagonal quadratic, the Hutchinson diagonal estimator is exact: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          OverscriptBox[
           StyleBox["h", "TI"], "^"], 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["i", "TI"]}]], "\[LongEqual]", 
         SubscriptBox[
          RowBox[{"(", 
            RowBox[{
              StyleBox["H", "TI"], 
              StyleBox["z", "TI"]}], ")"}], 
          StyleBox["i", "TI"]], 
         SubscriptBox[
          StyleBox["z", "TI"], 
          StyleBox["i", "TI"]], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["h", "TI"], 
          StyleBox["i", "TI"]], 
         SubsuperscriptBox[
          StyleBox["z", "TI"], 
          StyleBox["i", "TI"], "2"], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["h", "TI"], 
          StyleBox["i", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\hat{h}_{ii} = (Hz)_i z_i = h_i z_i^2 = h_i", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5de6f028-c9d9-4273-ba4a-adf6e815ff51"],
 ". So the deterministic analysis is the full story."
}], "Text",ExpressionUUID->"98db22df-9a6b-485e-ab71-69a02781edb7"],

Cell[TextData[{
 "For general (non-diagonal) losses, the noisy update is an AR(1) process: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubsuperscriptBox[
          StyleBox["e", "TI"], 
          StyleBox["i", "TI"], 
          RowBox[{
            StyleBox["t", "TI"], "+", "1"}]], "\[LongEqual]", 
         RowBox[{"(", 
           RowBox[{"1", "-", 
             SubscriptBox["\[Beta]", 
              StyleBox["s", "TI"]]}], ")"}], " ", 
         SubsuperscriptBox[
          StyleBox["e", "TI"], 
          StyleBox["i", "TI"], 
          StyleBox["t", "TI"]], "+", 
         SubscriptBox["\[Beta]", 
          StyleBox["s", "TI"]], " ", 
         SubsuperscriptBox[
          StyleBox["w", "TI"], 
          StyleBox["i", "TI"], 
          StyleBox["t", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "e_i^{t+1} = (1-\\beta_s)\\, e_i^t + \\beta_s\\, w_i^t", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "30a2f0fd-1692-4dab-b32a-5bf74ef107bd"],
 "with steady-state variance ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"Var", 
         RowBox[{"(", 
           SubscriptBox[
            StyleBox["e", "TI"], 
            StyleBox["i", "TI"]], ")"}], "\[LongEqual]", 
         FractionBox[
          SubscriptBox["\[Beta]", 
           StyleBox["s", "TI"]], 
          RowBox[{"2", "-", 
            SubscriptBox["\[Beta]", 
             StyleBox["s", "TI"]]}]], " ", 
         SubsuperscriptBox["\[Sigma]", 
          StyleBox["w", "TI"], "2"]}], TraditionalForm], "errors" -> {}, 
     "input" -> 
     "\\text{Var}(e_i) = \\frac{\\beta_s}{2-\\beta_s}\\,\\sigma_w^2", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f4ba90d6-8b20-4cf8-af45-6fcb8dd64314"],
 ". "
}], "Text",ExpressionUUID->"5d4b74f9-5323-4e1f-96a5-deccad11e3f0"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<=== Steady-State Metric Error with Noise ===\>\"", "]"}],
   ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<delta_inf = sqrt(beta_s / (2 - beta_s)) * sigma_w\>\"", 
   "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<For small beta_s: delta_inf ~ sqrt(beta_s/2) * sigma_w\>\
\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Table", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"bs", ",", "sw", ",", 
       RowBox[{
        RowBox[{
         RowBox[{"Sqrt", "[", 
          RowBox[{"bs", "/", 
           RowBox[{"(", 
            RowBox[{"2", "-", "bs"}], ")"}]}], "]"}], " ", "sw"}], " ", "//", 
        " ", "N"}]}], "}"}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"{", 
      RowBox[{"bs", ",", 
       RowBox[{"{", 
        RowBox[{"0.001", ",", "0.01", ",", "0.1"}], "}"}]}], "}"}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"{", 
      RowBox[{"sw", ",", 
       RowBox[{"{", 
        RowBox[{"0.1", ",", "0.5", ",", "1.0"}], "}"}]}], "}"}]}], 
    "\[IndentingNewLine]", "]"}], " ", "//", " ", 
   RowBox[{
    RowBox[{"Flatten", "[", 
     RowBox[{"#", ",", "1"}], "]"}], " ", "&"}]}], " ", "//", 
  "\[IndentingNewLine]", "  ", 
  RowBox[{
   RowBox[{"TableForm", "[", 
    RowBox[{"#", ",", 
     RowBox[{"TableHeadings", "->", 
      RowBox[{"{", 
       RowBox[{"None", ",", 
        RowBox[{"{", 
         RowBox[{"\"\<beta_s\>\"", ",", "\"\<sigma_w\>\"", 
          ",", "\"\<delta_inf\>\""}], "}"}]}], "}"}]}]}], "]"}], " ", 
   "&"}]}]}], "Input",ExpressionUUID->"6aff6f5c-b048-48f3-8c7d-d3b5d901ff0e"],

Cell["3. Phase 2: Parameter Convergence at Metric Equilibrium", "Section",ExpressionUUID->"a95eb6b8-b287-4796-b857-67c89f4ccf55"],

Cell["3.1 Per-coordinate contraction", "Subsection",ExpressionUUID->"675fea66-86cf-4ace-9f3a-552bfcc60dfe"],

Cell[TextData[{
 "At metric error ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["e", "TI"], 
        StyleBox["i", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "e_i", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f6d726f2-220c-49ed-b7b1-b366f240a492"],
 ", the per-coordinate contraction factor is: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Rho]", 
          StyleBox["i", "TI"]], "\[LongEqual]", "|1", "-", "\[Eta] ", 
         SubscriptBox[
          StyleBox["h", "TI"], "geo"], " ", 
         SuperscriptBox[
          StyleBox["e", "TI"], 
          SubscriptBox[
           StyleBox["e", "TI"], 
           StyleBox["i", "TI"]]], "|"}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\rho_i = |1 - \\eta\\, h_{\\text{geo}}\\, e^{e_i}|", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ed0cfeae-fb53-4a4d-899f-d10cf9e882d8"],
 "The worst-case rate over all coordinates: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Rho]", 
         RowBox[{"(", "\[Delta]", ")"}], "\[LongEqual]", "max", 
         RowBox[{"(", 
           RowBox[{"|1", "-", "\[Eta] ", 
             SubscriptBox[
              StyleBox["h", "TI"], "geo"], " ", 
             SuperscriptBox[
              StyleBox["e", "TI"], "\[Delta]"], "|", ", ", "|1", "-", 
             "\[Eta] ", 
             SubscriptBox[
              StyleBox["h", "TI"], "geo"], " ", 
             SuperscriptBox[
              StyleBox["e", "TI"], 
              RowBox[{"-", "\[Delta]"}]], "|"}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\rho(\\delta) = \\max\\big(|1 - \\eta\\, h_{\\text{geo}}\\, \
e^{\\delta}|,\\; |1 - \\eta\\, h_{\\text{geo}}\\, e^{-\\delta}|\\big)", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ca2018c0-6d9d-494e-9537-19296e0df432"]
}], "Text",ExpressionUUID->"91bc653a-2374-4eec-825c-90266e3475e9"],

Cell["3.2 Optimal step size for given metric error", "Subsection",ExpressionUUID->"307de25e-5b7d-4a4c-aad2-67b62f4a7b7f"],

Cell["Theorem 2 (Optimal Phase 2 rate)", "Subsection",ExpressionUUID->"65aab6fa-7e16-47e9-aabb-07ebdd81f178"],

Cell[TextData[{
 "Given metric error bound ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"|", 
         SubscriptBox[
          StyleBox["e", "TI"], 
          StyleBox["i", "TI"]], "|", "\[LessEqual]", "\[Delta]"}], 
       TraditionalForm], "errors" -> {}, "input" -> "|e_i| \\leq \\delta", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "11715607-92f8-47d9-ba7b-0ebcd43922d2"],
 " for all ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["i", "TI"], TraditionalForm], "errors" -> {}, "input" -> "i", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c1397176-793b-4c0e-ae2e-ee813a7c5e5c"],
 ", the optimal step size is ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox["\[Eta]", "*"], "\[LongEqual]", "sech", 
         RowBox[{"(", "\[Delta]", ")"}], "/", 
         SubscriptBox[
          StyleBox["h", "TI"], "geo"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\eta^* = \\text{sech}(\\delta)/h_{\\text{geo}}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "979b86a1-9353-46f7-a075-48a56fb7ab0d"],
 ", yielding the ",
 StyleBox["optimal contraction rate",
  FontWeight->Bold],
 " ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox["\[Rho]", "*"], 
         RowBox[{"(", "\[Delta]", ")"}], "\[LongEqual]", "tanh", 
         RowBox[{"(", "\[Delta]", ")"}]}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\rho^*(\\delta) = \\tanh(\\delta)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ac9aac85-f331-4bce-8576-0775bd54350c"],
 ".",
 StyleBox["Proof.",
  FontWeight->Bold],
 " Minimize ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"max", "(", 
         RowBox[{"|1", "-", "\[Alpha]", 
           SuperscriptBox[
            StyleBox["e", "TI"], "\[Delta]"], "|", ", ", "|1", "-", 
           "\[Alpha]", 
           SuperscriptBox[
            StyleBox["e", "TI"], 
            RowBox[{"-", "\[Delta]"}]], "|"}], ")"}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\max(|1 - \\alpha e^{\\delta}|,\\, |1 - \\alpha e^{-\\delta}|)", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5a9e6cbc-efaf-438e-a497-45cc656942d2"],
 " over ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Alpha]", "\[LongEqual]", "\[Eta]", 
         SubscriptBox[
          StyleBox["h", "TI"], "geo"], ">", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\alpha = \\eta h_{\\text{geo}} > 0", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f57bcd6a-0d0d-4b49-995e-788e50e241bd"],
 ". Setting the two branches equal: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Alpha]", 
         SuperscriptBox[
          StyleBox["e", "TI"], "\[Delta]"], "-", "1", "\[LongEqual]", "1", 
         "-", "\[Alpha]", 
         SuperscriptBox[
          StyleBox["e", "TI"], 
          RowBox[{"-", "\[Delta]"}]]}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\alpha e^{\\delta} - 1 = 1 - \\alpha e^{-\\delta}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "137a74d5-e186-48b5-bb6a-b812c032d52b"],
 ", giving ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox["\[Alpha]", "*"], "\[LongEqual]", "2", "/", 
         RowBox[{"(", 
           RowBox[{
             SuperscriptBox[
              StyleBox["e", "TI"], "\[Delta]"], "+", 
             SuperscriptBox[
              StyleBox["e", "TI"], 
              RowBox[{"-", "\[Delta]"}]]}], ")"}], "\[LongEqual]", "sech", 
         RowBox[{"(", "\[Delta]", ")"}]}], TraditionalForm], "errors" -> {}, 
     "input" -> 
     "\\alpha^* = 2/(e^{\\delta} + e^{-\\delta}) = \\text{sech}(\\delta)", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ca8c7348-53b5-4263-9fa4-262b1d3ea806"],
 ". The optimal rate is ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox["\[Alpha]", "*"], 
         SuperscriptBox[
          StyleBox["e", "TI"], "\[Delta]"], "-", "1", "\[LongEqual]", 
         SuperscriptBox[
          StyleBox["e", "TI"], "\[Delta]"], "/", "cosh", "\[Delta]", "-", "1",
          "\[LongEqual]", "tanh", "\[Delta]"}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\alpha^* e^{\\delta} - 1 = e^{\\delta}/\\cosh\\delta - 1 = \
\\tanh\\delta", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "7afc5ef3-f693-4d62-9a0c-270a2ba8bbe8"],
 ". ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> InterpretationBox["", 
       Failure[
       "TeXAssistantError", <|
        "MessageTemplate" -> "Errors: `Errors`", 
         "MessageParameters" -> <|"Errors" -> {}|>, "Input" -> "\\square"|>]],
      "errors" -> {}, "input" -> "\\square", "state" -> "Error"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "71a6fccc-f644-414c-890e-be8c618051d3"]
}], "Text",ExpressionUUID->"f492b42f-8a6a-4c0a-99fd-8a80084f5e33"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Clear", "[", "\"\<Global`*\>\"", "]"}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Verify", ":", " ", 
     RowBox[{"optimal", " ", "rate"}]}], " ", "=", " ", 
    RowBox[{"tanh", 
     RowBox[{"(", "delta", ")"}]}]}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"rho1", "[", "d_", "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"Sech", "[", "d", "]"}], " ", 
     RowBox[{"Exp", "[", "d", "]"}]}], "-", "1"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"rho2", "[", "d_", "]"}], ":=", 
    RowBox[{"1", "-", 
     RowBox[{
      RowBox[{"Sech", "[", "d", "]"}], " ", 
      RowBox[{"Exp", "[", 
       RowBox[{"-", "d"}], "]"}]}]}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<=== Verification: rho1 = rho2 = tanh(delta) ===\>\"", 
   "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<rho1 - rho2 = \>\"", ",", 
    RowBox[{"Simplify", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"rho1", "[", "d", "]"}], "-", 
       RowBox[{"rho2", "[", "d", "]"}]}], ",", 
      RowBox[{"d", ">", "0"}]}], "]"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<rho1 - tanh = \>\"", ",", 
    RowBox[{"Simplify", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"rho1", "[", "d", "]"}], "-", 
       RowBox[{"Tanh", "[", "d", "]"}]}], ",", 
      RowBox[{"d", ">", "0"}]}], "]"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"Numerical", " ", "values"}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Table", "[", "\[IndentingNewLine]", "  ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"d", ",", 
      RowBox[{
       RowBox[{"Sech", "[", "d", "]"}], " ", "//", " ", "N"}], ",", 
      RowBox[{
       RowBox[{"Tanh", "[", "d", "]"}], " ", "//", " ", "N"}]}], "}"}], ",", 
    "\[IndentingNewLine]", "  ", 
    RowBox[{"{", 
     RowBox[{"d", ",", 
      RowBox[{"{", 
       RowBox[{
       "0.001", ",", "0.01", ",", "0.1", ",", "0.5", ",", "1.0", ",", "2.0"}],
        "}"}]}], "}"}]}], "\[IndentingNewLine]", "]"}], " ", "//", " ", 
  RowBox[{
   RowBox[{"TableForm", "[", 
    RowBox[{"#", ",", 
     RowBox[{"TableHeadings", "->", 
      RowBox[{"{", 
       RowBox[{"None", ",", 
        RowBox[{"{", 
         RowBox[{"\"\<delta\>\"", ",", "\"\<alpha*=sech(d)\>\"", 
          ",", "\"\<rho*=tanh(d)\>\""}], "}"}]}], "}"}]}]}], "]"}], " ", 
   "&"}]}]}], "Input",ExpressionUUID->"29b8d9f4-9965-4a6e-845b-8a1daaa11f02"],

Cell[TextData[{
 "Corollary (small ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Delta]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\delta", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
