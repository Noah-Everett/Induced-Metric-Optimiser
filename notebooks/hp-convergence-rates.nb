  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"theta", "=", 
   RowBox[{"ConstantArray", "[", 
    RowBox[{"1.0", ",", "10"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"s", "=", 
   RowBox[{"ConstantArray", "[", 
    RowBox[{"0.0", ",", "10"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"loss0", "=", 
    RowBox[{
     RowBox[{"Total", "[", 
      RowBox[{"hVals", " ", 
       RowBox[{"theta", "^", "2"}]}], "]"}], "/", "2"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"metricData", "=", 
   RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"lossData", "=", 
    RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Do", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Mod", "[", 
          RowBox[{"t", ",", "5"}], "]"}], "==", "1"}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{
         RowBox[{"AppendTo", "[", 
          RowBox[{"metricData", ",", 
           RowBox[{"{", 
            RowBox[{"t", ",", 
             RowBox[{"Sqrt", "[", 
              RowBox[{"Total", "[", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"s", "-", "sStar"}], ")"}], "^", "2"}], "]"}], 
              "]"}]}], "}"}]}], "]"}], ";", "\[IndentingNewLine]", "    ", 
         RowBox[{"AppendTo", "[", 
          RowBox[{"lossData", ",", 
           RowBox[{"{", 
            RowBox[{"t", ",", 
             RowBox[{"Log10", "[", 
              RowBox[{
               RowBox[{"Total", "[", 
                RowBox[{"hVals", " ", 
                 RowBox[{"theta", "^", "2"}]}], "]"}], "/", 
               RowBox[{"(", 
                RowBox[{"2", " ", "loss0"}], ")"}]}], "]"}]}], "}"}]}], "]"}],
          ";"}]}], "\[IndentingNewLine]", "  ", "]"}], ";", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"eta", "=", 
       RowBox[{"1.5", "/", 
        RowBox[{"Max", "[", 
         RowBox[{
          RowBox[{"Exp", "[", "s", "]"}], " ", "hVals"}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"theta", "=", 
       RowBox[{"theta", " ", 
        RowBox[{"(", 
         RowBox[{"1", "-", 
          RowBox[{"eta", " ", 
           RowBox[{"Exp", "[", "s", "]"}], " ", "hVals"}]}], ")"}]}]}], ";", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"s", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "-", "betaS"}], ")"}], " ", "s"}], "+", 
        RowBox[{"betaS", " ", 
         RowBox[{"(", 
          RowBox[{"-", 
           RowBox[{"Log", "[", "hVals", "]"}]}], ")"}]}]}]}], ";", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"s", "=", 
       RowBox[{"s", "-", 
        RowBox[{"Mean", "[", "s", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
     "  ", ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "300"}], "}"}]}], "\[IndentingNewLine]", "]"}], ";"}],
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"Predicted", " ", "metric", " ", "error"}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"predictedMetric", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"t", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", "-", "betaS"}], ")"}], "^", "t"}], " ", "e0Norm"}]}], 
       "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", "1", ",", "300", ",", "5"}], "}"}]}], "]"}]}], ";"}],
   "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<=== Metric Error: Actual vs Predicted ===\>\"", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<Predicted: ||e^t|| = (1-betaS)^t * ||e^0||\>\"", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Table", "[", "\[IndentingNewLine]", "  ", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<t=\>\"", ",", 
      RowBox[{"metricData", "[", 
       RowBox[{"[", 
        RowBox[{"k", ",", "1"}], "]"}], "]"}], ",", "\"\<: actual=\>\"", ",", 
      
      RowBox[{"NumberForm", "[", 
       RowBox[{
        RowBox[{"metricData", "[", 
         RowBox[{"[", 
          RowBox[{"k", ",", "2"}], "]"}], "]"}], ",", "4"}], "]"}], ",", 
      "\[IndentingNewLine]", "    ", "\"\< predicted=\>\"", ",", 
      RowBox[{"NumberForm", "[", 
       RowBox[{
        RowBox[{"predictedMetric", "[", 
         RowBox[{"[", 
          RowBox[{"k", ",", "2"}], "]"}], "]"}], ",", "4"}], "]"}], ",", 
      "\[IndentingNewLine]", "    ", "\"\< ratio=\>\"", ",", 
      RowBox[{"NumberForm", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"metricData", "[", 
          RowBox[{"[", 
           RowBox[{"k", ",", "2"}], "]"}], "]"}], "/", 
         RowBox[{"predictedMetric", "[", 
          RowBox[{"[", 
           RowBox[{"k", ",", "2"}], "]"}], "]"}]}], ",", "4"}], "]"}]}], 
     "]"}], ",", "\[IndentingNewLine]", "  ", 
    RowBox[{"{", 
     RowBox[{"k", ",", 
      RowBox[{"{", 
       RowBox[{
       "1", ",", "10", ",", "20", ",", "30", ",", "40", ",", "50", ",", 
        "60"}], "}"}]}], "}"}]}], "\[IndentingNewLine]", "]"}], 
  ";"}]}], "Input",ExpressionUUID->"38585950-a2d9-4751-b753-8b37c75fd484"],

Cell["6. With Hutchinson Noise", "Section",ExpressionUUID->"1e29fc59-95aa-46ea-a69f-87f284daa5bb"],

Cell["Theorem 3 (Stochastic convergence)", "Subsection",ExpressionUUID->"036357d1-b374-47f8-a33a-cde1680f945b"],

Cell[TextData[{
 "With Hutchinson noise of variance ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubsuperscriptBox["\[Sigma]", 
        StyleBox["w", "TI"], "2"], TraditionalForm], "errors" -> {}, "input" -> 
     "\\sigma_w^2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "954ce8e6-7a45-47d1-b2a7-319bac99be00"],
 " in log-space, the metric converges to a ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["\[Delta]", "\[Infinity]"], TraditionalForm], 
     "errors" -> {}, "input" -> "\\delta_\\infty", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f7cd395b-b6d4-4474-9a5f-b9a6066e45b4"],
 "-neighborhood of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox[
        StyleBox["s", "TI"], "*"], TraditionalForm], "errors" -> {}, "input" -> 
     "s^*", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "78ed664a-da42-40fb-af30-57c49cb8533f"],
 ": ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Delta]", "\[Infinity]"], "\[LongEqual]", 
         SqrtBox[
          FractionBox[
           SubscriptBox["\[Beta]", 
            StyleBox["s", "TI"]], 
           RowBox[{"2", "-", 
             SubscriptBox["\[Beta]", 
              StyleBox["s", "TI"]]}]]], " ", 
         SubscriptBox["\[Sigma]", 
          StyleBox["w", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\delta_\\infty = \\sqrt{\\frac{\\beta_s}{2-\\beta_s}}\\;\\sigma_w", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "deafe298-4e64-40c3-811d-caa134cc5395"],
 "The Phase 2 convergence rate is limited by ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Rho]", "\[LongEqual]", "tanh", 
         RowBox[{"(", 
           SubscriptBox["\[Delta]", "\[Infinity]"], ")"}], "\[TildeTilde]", 
         SubscriptBox["\[Delta]", "\[Infinity]"]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\rho = \\tanh(\\delta_\\infty) \\approx \\delta_\\infty", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a56d4475-bbef-4d3b-b3b1-f189f284ac4e"],
 "."
}], "Text",ExpressionUUID->"7ddbfcd2-0d9d-4249-ba39-06e063f4a5aa"],

Cell[TextData[{
 "The loss converges to a neighborhood of size ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["O", "TI"], "(", 
         SubsuperscriptBox["\[Delta]", "\[Infinity]", "2"], ")"}], 
       TraditionalForm], "errors" -> {}, "input" -> "O(\\delta_\\infty^2)", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d5fb6c8f-657b-4f3d-9bd5-b5e6d87ea1bb"],
 " around the minimum. "
}], "Text",ExpressionUUID->"57ce9c2a-8325-480a-b189-8dae3453663e"],

Cell["Total stochastic complexity", "Subsection",ExpressionUUID->"e47792c8-3fd9-40b9-8d08-eebf3230de20"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["T", "TI"], "\[LongEqual]", 
         FractionBox["1", 
          SubscriptBox["\[Beta]", 
           StyleBox["s", "TI"]]], "log", 
         FractionBox[
          RowBox[{"\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", 
            SuperscriptBox[
             StyleBox["e", "TI"], "0"], 
            "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9"}], 
          RowBox[{"2", 
            SubscriptBox["\[Delta]", "\[Infinity]"]}]], "+", 
         FractionBox[
          RowBox[{"log", "(", 
            RowBox[{"1", "/", "\[Epsilon]"}], ")"}], 
          RowBox[{"-2", "log", "tanh", 
            RowBox[{"(", 
              SubscriptBox["\[Delta]", "\[Infinity]"], ")"}]}]]}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "T = \\frac{1}{\\beta_s}\\log\\frac{|e^0|}{2\\delta_\\infty} + \
\\frac{\\log(1/\\varepsilon)}{-2\\log\\tanh(\\delta_\\infty)}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c678da07-c042-4456-ad42-47007bddb598"],
 "provided ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Epsilon]", ">", 
         SubsuperscriptBox["\[Delta]", "\[Infinity]", "2"]}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\varepsilon > \\delta_\\infty^2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "515fe53a-96fb-4a1d-917c-d6c40afe1cd0"],
 " (the noise floor). "
}], "Text",ExpressionUUID->"eef6a920-4f38-4b97-ae66-b9a9b349e1cc"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Print", "[", "\"\<=== Stochastic Complexity ===\>\"", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", "\"\<To reach loss eps with noise:\>\"", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<1. Need eps > delta_inf^2 (noise floor)\>\"", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", "\"\<2. Need betaS < 2 eps / sigma_w^2\>\"", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<T_metric ~ (1/betaS) * [log(E0) + (1/2) log(1/betaS) + \
log(1/sigma_w)]\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<T_phase2 ~ log(1/eps) / (2 delta_inf) = log(1/eps) / \
(sqrt(2 betaS) sigma_w)\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", "\"\<Key tradeoff in betaS:\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<  Larger betaS -> faster Phase 1 but larger noise \
floor\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<  Smaller betaS -> slower Phase 1 but smaller noise \
floor\>\"", "]"}], ";"}]}], "Input",ExpressionUUID->"621b1304-d78c-4eec-85ed-\
534df8e38807"],

Cell["7. Comparison Table (Publication)", "Section",ExpressionUUID->"2a32616a-e3f0-4da2-92ad-0e2edbed8dcd"],

Cell["Theorem 4 (Iteration complexity comparison)", "Subsection",ExpressionUUID->"3f722329-68a9-4005-8a92-22a0e3ceb0f1"],

Cell[TextData[{
 "On a diagonal quadratic ",
