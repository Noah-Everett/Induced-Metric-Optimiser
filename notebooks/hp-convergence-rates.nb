Cell["5.1 Multi-kappa, multi-N comparison", "Subsection",ExpressionUUID->"d346470e-7ab2-4cb3-b21b-901880018b22"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Clear", "[", "\"\<Global`*\>\"", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"simulateAdaptive2", "[", 
     RowBox[{"hVals_", ",", "betaS_", ",", "epsTarget_"}], "]"}], ":=", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"nd", "=", 
         RowBox[{"Length", "[", "hVals", "]"}]}], ",", "theta", ",", "s", ",",
         "loss", ",", "loss0", ",", 
        RowBox[{"step", "=", "0"}], ",", "eta"}], "}"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"theta", "=", 
        RowBox[{"ConstantArray", "[", 
         RowBox[{"1.0", ",", "nd"}], "]"}]}], ";", "\[IndentingNewLine]", 
       "  ", 
       RowBox[{"s", "=", 
        RowBox[{"ConstantArray", "[", 
         RowBox[{"0.0", ",", "nd"}], "]"}]}], ";", "\[IndentingNewLine]", 
       "  ", 
       RowBox[{"loss0", "=", 
        RowBox[{
         RowBox[{"Total", "[", 
          RowBox[{"hVals", " ", 
           RowBox[{"theta", "^", "2"}]}], "]"}], "/", "2"}]}], ";", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"loss", "=", "loss0"}], ";", "\[IndentingNewLine]", "  ", 
       RowBox[{"While", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"loss", "/", "loss0"}], ">", "epsTarget"}], "&&", 
          RowBox[{"step", "<", "1000000"}]}], ",", "\[IndentingNewLine]", 
         "    ", 
         RowBox[{
          RowBox[{"eta", "=", 
           RowBox[{"1.5", "/", 
            RowBox[{"Max", "[", 
             RowBox[{
              RowBox[{"Exp", "[", "s", "]"}], " ", "hVals"}], "]"}]}]}], ";", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"theta", "=", 
           RowBox[{"theta", " ", 
            RowBox[{"(", 
             RowBox[{"1", "-", 
              RowBox[{"eta", " ", 
               RowBox[{"Exp", "[", "s", "]"}], " ", "hVals"}]}], ")"}]}]}], ";",
           "\[IndentingNewLine]", "    ", 
          RowBox[{"s", "=", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"1", "-", "betaS"}], ")"}], " ", "s"}], "+", 
            RowBox[{"betaS", " ", 
             RowBox[{"(", 
              RowBox[{"-", 
               RowBox[{"Log", "[", "hVals", "]"}]}], ")"}]}]}]}], ";", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"s", "=", 
           RowBox[{"s", "-", 
            RowBox[{"Mean", "[", "s", "]"}]}]}], ";", "\[IndentingNewLine]", 
          "    ", 
          RowBox[{"loss", "=", 
           RowBox[{
            RowBox[{"Total", "[", 
             RowBox[{"hVals", " ", 
              RowBox[{"theta", "^", "2"}]}], "]"}], "/", "2"}]}], ";", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"step", "++"}], ";"}]}], "\[IndentingNewLine]", "  ", "]"}],
        ";", "\[IndentingNewLine]", "  ", "step"}]}], "\[IndentingNewLine]", 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"simulateGD2", "[", 
     RowBox[{"hVals_", ",", "epsTarget_"}], "]"}], ":=", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"nd", "=", 
         RowBox[{"Length", "[", "hVals", "]"}]}], ",", "theta", ",", "eta", ",",
         "loss", ",", "loss0", ",", 
        RowBox[{"step", "=", "0"}]}], "}"}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"eta", "=", 
        RowBox[{"2.0", "/", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Min", "[", "hVals", "]"}], "+", 
           RowBox[{"Max", "[", "hVals", "]"}]}], ")"}]}]}], ";", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"theta", "=", 
        RowBox[{"ConstantArray", "[", 
         RowBox[{"1.0", ",", "nd"}], "]"}]}], ";", "\[IndentingNewLine]", 
       "  ", 
       RowBox[{"loss0", "=", 
        RowBox[{
         RowBox[{"Total", "[", 
          RowBox[{"hVals", " ", 
           RowBox[{"theta", "^", "2"}]}], "]"}], "/", "2"}]}], ";", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"loss", "=", "loss0"}], ";", "\[IndentingNewLine]", "  ", 
       RowBox[{"While", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"loss", "/", "loss0"}], ">", "epsTarget"}], "&&", 
          RowBox[{"step", "<", "1000000"}]}], ",", "\[IndentingNewLine]", 
         "    ", 
         RowBox[{
          RowBox[{"theta", "=", 
           RowBox[{"theta", " ", 
            RowBox[{"(", 
             RowBox[{"1", "-", 
              RowBox[{"eta", " ", "hVals"}]}], ")"}]}]}], ";", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"loss", "=", 
           RowBox[{
            RowBox[{"Total", "[", 
             RowBox[{"hVals", " ", 
              RowBox[{"theta", "^", "2"}]}], "]"}], "/", "2"}]}], ";", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"step", "++"}], ";"}]}], "\[IndentingNewLine]", "  ", "]"}],
        ";", "\[IndentingNewLine]", "  ", "step"}]}], "\[IndentingNewLine]", 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"epsTarget", "=", 
   RowBox[{"10.0", "^", 
    RowBox[{"(", 
     RowBox[{"-", "10"}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"betaS", "=", "0.01"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<=== Verification: Various kappa and N ===\>\"", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", "\"\<eps = 10^{-10}, betaS = 0.01\>\"", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Table", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "hV", ",", "hgeo", ",", "e0", ",", "tMetricPred", ",", "tDerived", ",",
          "tGD"}], "}"}], ",", "\[IndentingNewLine]", "    ", 
       RowBox[{
        RowBox[{"hV", "=", 
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"Exp", "[", 
             RowBox[{
              RowBox[{"Log", "[", "1", "]"}], "+", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"Log", "[", "kap", "]"}], "-", 
                 RowBox[{"Log", "[", "1", "]"}]}], ")"}], " ", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"i", "-", "1"}], ")"}], "/", 
                RowBox[{"(", 
                 RowBox[{"nd0", "-", "1"}], ")"}]}]}]}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "nd0"}], "}"}]}], "]"}], " ", "//", " ", 
          "N"}]}], ";", "\[IndentingNewLine]", "    ", 
        RowBox[{"hgeo", "=", 
         RowBox[{"GeometricMean", "[", "hV", "]"}]}], ";", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"e0", "=", 
         RowBox[{"Sqrt", "[", 
          RowBox[{"Total", "[", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"-", 
               RowBox[{"Log", "[", "hV", "]"}]}], "+", 
              RowBox[{"Mean", "[", 
               RowBox[{"Log", "[", "hV", "]"}], "]"}]}], ")"}], "^", "2"}], 
           "]"}], "]"}]}], ";", "\[IndentingNewLine]", "    ", 
        RowBox[{"tMetricPred", "=", 
         RowBox[{"Ceiling", "[", 
          RowBox[{
           RowBox[{"Log", "[", 
            RowBox[{"e0", "/", "1.0"}], "]"}], "/", 
           RowBox[{"Log", "[", 
            RowBox[{"1", "/", 
             RowBox[{"(", 
              RowBox[{"1", "-", "betaS"}], ")"}]}], "]"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"tDerived", "=", 
         RowBox[{"simulateAdaptive2", "[", 
          RowBox[{"hV", ",", "betaS", ",", "epsTarget"}], "]"}]}], ";", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"tGD", "=", 
         RowBox[{"simulateGD2", "[", 
          RowBox[{"hV", ",", "epsTarget"}], "]"}]}], ";", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"{", 
         RowBox[{"kap", ",", "nd0", ",", 
          RowBox[{"Round", "[", 
           RowBox[{"hgeo", ",", "0.1"}], "]"}], ",", 
          RowBox[{"Round", "[", 
           RowBox[{"e0", ",", "0.1"}], "]"}], ",", "tMetricPred", ",", 
          "tDerived", ",", "tGD", ",", 
          RowBox[{"Round", "[", 
           RowBox[{"N", "[", 
            RowBox[{"tGD", "/", "tDerived"}], "]"}], "]"}]}], "}"}]}]}], 
      "\[IndentingNewLine]", "  ", "]"}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"{", 
      RowBox[{"kap", ",", 
       RowBox[{"{", 
        RowBox[{"10", ",", "100", ",", "1000", ",", "10000"}], "}"}]}], "}"}],
      ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"{", 
      RowBox[{"nd0", ",", 
       RowBox[{"{", 
        RowBox[{"10", ",", "100"}], "}"}]}], "}"}]}], "\[IndentingNewLine]", 
    "]"}], " ", "//", " ", 
   RowBox[{
    RowBox[{"Flatten", "[", 
     RowBox[{"#", ",", "1"}], "]"}], " ", "&"}]}], " ", "//", 
  "\[IndentingNewLine]", "  ", 
  RowBox[{
   RowBox[{"TableForm", "[", 
    RowBox[{"#", ",", 
     RowBox[{"TableHeadings", "->", 
      RowBox[{"{", 
       RowBox[{"None", ",", 
        RowBox[{"{", 
         RowBox[{"\"\<kappa\>\"", ",", "\"\<N\>\"", ",", "\"\<hgeo\>\"", 
          ",", "\"\<||e0||\>\"", ",", "\"\<T_metric(pred)\>\"", 
          ",", "\"\<T_derived\>\"", ",", "\"\<T_GD\>\"", 
          ",", "\"\<speedup\>\""}], "}"}]}], "}"}]}]}], "]"}], " ", 
   "&"}]}]}], "Input",ExpressionUUID->"dba2b910-29eb-4c18-81e3-f093ff640d5c"],

Cell["5.2 Metric convergence tracking", "Subsection",ExpressionUUID->"e2ae97f5-d3b6-4dbf-be4c-1f025f5b71bf"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Clear", "[", "\"\<Global`*\>\"", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
