Notebook[{
Cell["IMO-83: Stable Metric Learning \[LongDash] Analytical Derivations", \
"Title",ExpressionUUID->"73ee3f6d-6429-46b1-a90e-313c1cfae721"],

Cell[TextData[{
 "Companion to ",
 Cell[BoxData[Cell["notes/stable-metric-update.md",
   Background->None,ExpressionUUID->"17d5bfdf-d78f-41fe-80bd-ce71b89c18c4"]], 
  "InlineCode",ExpressionUUID->"278770b3-2431-4041-8bff-bbbfdc0477ce"],
 " and ",
 Cell[BoxData[Cell["hp-stable-metric-verification.py",
   Background->None,ExpressionUUID->"12792b25-6e2d-48d6-8a1f-cb01d7c2ed26"]], 
  "InlineCode",ExpressionUUID->"f1cff649-d763-4aa3-bcc9-7df46bb7ef49"],
 ". "
}], "Text",ExpressionUUID->"57b904a2-67e7-4f6a-8260-5e06fc9ab47f"],

Cell["1. Original Update Rule", "Section",ExpressionUUID->"9e2f7ab6-cde1-4b52-bdde-b85aebfd7c0b"],

Cell[TextData[{
 "The current s-update uses the s-gradient of v: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         OverscriptBox[
          StyleBox["s", "TI"], "."], "\[LongEqual]", "\[Xi]", 
         SuperscriptBox[
          StyleBox["e", "TI"], 
          StyleBox["s", "TI"]], 
         SuperscriptBox[
          StyleBox["g", "TI"], "2"], "-", "\[Lambda]", 
         StyleBox["s", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\dot{s} = \\xi e^s g^2 - \\lambda s", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d5cf53ea-8341-4f0d-b7d2-39ffc6301382"]
}], "Text",ExpressionUUID->"2e964be6-259f-4fe2-b9b4-45d1764e4fcf"],

Cell["\<\
fOrig[s_] := xi Exp[s] g2 - lam s;
Print[\"Jacobian (original): \", D[fOrig[s], s] // Simplify]
Print[\"At equilibrium (xi*Exp[s]*g^2 = lam*s*): lam*(s* - 1)\"]
Print[\"Stable iff s* < 1\"]
Print[\"Equilibrium exists iff xi*g^2/lam < 1/e\"]
Print[\"Practical values: xi*g^2/lam ~ 10^4\
\>", "Program",ExpressionUUID->"dc15f904-4a4e-4f55-b4ac-449a65f32766"],

Cell[BoxData[
 RowBox[{
  RowBox[{"1", "/", "e"}], "=", "\"\<, N[1/E]]\>"}]], "Echo",ExpressionUUID->\
"da1bf201-2aee-4556-b8c6-bd0191c678a0"],

Cell["2. Normalized Gradient Update Rule", "Section",ExpressionUUID->"f8ca6a88-d13b-4d29-9d58-8420fcfa53ef"],

Cell[TextData[{
 "Divide driving force by Exp[s]: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         OverscriptBox[
          StyleBox["s", "TI"], "."], "\[LongEqual]", "\[Xi]", 
         SuperscriptBox[
          StyleBox["g", "TI"], "2"], "-", "\[Lambda]", 
         StyleBox["s", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\dot{s} = \\xi g^2 - \\lambda s", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "dc9685f8-d0d3-4506-ada0-bd62380001a4"]
}], "Text",ExpressionUUID->"0394c319-adda-478f-906b-bce073e60373"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"fNorm", "[", "s_", "]"}], ":=", 
   RowBox[{
    RowBox[{"xi", " ", "g2"}], "-", 
    RowBox[{"lam", " ", "s"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  RowBox[{"\"\<Jacobian (normalized): \>\"", ",", 
   RowBox[{"D", "[", 
    RowBox[{
     RowBox[{"fNorm", "[", "s", "]"}], ",", "s"}], "]"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"Print", 
  "[", "\"\<= -lambda (ALWAYS negative, unconditionally stable)\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  RowBox[{"\"\<Equilibrium: s* = \>\"", ",", 
   RowBox[{
    RowBox[{"Solve", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"fNorm", "[", "s", "]"}], "==", "0"}], ",", "s"}], "]"}], "[", 
    
    RowBox[{"[", 
     RowBox[{"1", ",", "1", ",", "2"}], "]"}], "]"}]}], "]"}]}], "Input",Expre\
ssionUUID->"0fdd62fd-e4f1-40b8-8819-a0ae62cbf178"],

Cell["3. Exact Solution (Linear ODE)", "Section",ExpressionUUID->"efe0c13e-d112-46fc-b7a2-a43dcf2f0d20"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"sol", "=", 
   RowBox[{"DSolve", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"s", "'"}], "[", "t", "]"}], "==", 
        RowBox[{
         RowBox[{"xi", " ", "g2"}], "-", 
         RowBox[{"lam", " ", 
          RowBox[{"s", "[", "t", "]"}]}]}]}], ",", 
       RowBox[{
        RowBox[{"s", "[", "0", "]"}], "==", "s0"}]}], "}"}], ",", 
     RowBox[{"s", "[", "t", "]"}], ",", "t"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  RowBox[{"\"\<s(t) = \>\"", ",", 
   RowBox[{
    RowBox[{"sol", "[", 
     RowBox[{"[", 
      RowBox[{"1", ",", "1", ",", "2"}], "]"}], "]"}], " ", "//", " ", 
    "Simplify"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sInf", "=", 
   RowBox[{"Limit", "[", 
    RowBox[{
     RowBox[{"sol", "[", 
      RowBox[{"[", 
       RowBox[{"1", ",", "1", ",", "2"}], "]"}], "]"}], ",", 
     RowBox[{"t", "->", "Infinity"}], ",", 
     RowBox[{"Assumptions", "->", 
      RowBox[{"{", 
       RowBox[{"lam", ">", "0"}], "}"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  RowBox[{"\"\<s(infinity) = \>\"", ",", 
   RowBox[{"sInf", " ", "//", " ", "Simplify"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"Print", 
  "[", "\"\<Error: s(t) - s* = (s0 - xi*g^2/lam) * Exp[-lam*t]\>\"", 
  "]"}]}], "Input",ExpressionUUID->"91121161-e8bc-423d-8ef1-021420ecff4a"],

Cell["4. Global Lyapunov Stability", "Section",ExpressionUUID->"20164992-f338-4ddc-95b3-324a5195bfb8"],

Cell["Lyapunov function V = (s - s*)^2 / 2: ", "CodeText",ExpressionUUID->"c5276d5e-4a65-4a08-805d-0c83906525f3"],

Cell[BoxData[{
 RowBox[{"Print", "[", "\"\<dV/dt = (s - s*)(xi*g^2 - lam*s)\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", "\"\<      = (s - s*)(-lam)(s - s*)\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", "\"\<      = -lam*(s - s*)^2\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", "\"\<      = -2*lam*V < 0 for all s != s*\>\"", 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", "\"\<=> Globally asymptotically stable\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{"Print", 
  "[", "\"\<=> Exponential convergence: |s(t)-s*| ~ Exp[-lam*t]\>\"", 
  "]"}]}], "Input",ExpressionUUID->"f47e4238-b4de-499d-97ed-2365a0243250"],

Cell["5. Curvature Correction Preserves Stability", "Section",ExpressionUUID->"bd9d0a02-3139-4b90-8e71-57838dfa5573"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"fCurv", ",", "H", ",", "tau", ",", "r"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"fCurv", "[", "s_", "]"}], ":=", 
   RowBox[{
    RowBox[{"xi", " ", "g2", " ", 
     RowBox[{"(", 
      RowBox[{"1", "-", 
       RowBox[{"r", " ", 
        RowBox[{"Tanh", "[", 
         RowBox[{"H", "/", "tau"}], "]"}]}]}], ")"}]}], "-", 
    RowBox[{"lam", " ", "s"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  RowBox[{"\"\<Jacobian with curvature: \>\"", ",", 
   RowBox[{"D", "[", 
    RowBox[{
     RowBox[{"fCurv", "[", "s", "]"}], ",", "s"}], "]"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", "\"\<= -lam (UNCHANGED by curvature correction)\>\"", 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  RowBox[{"\"\<Equilibrium: s* = \>\"", ",", 
   RowBox[{
    RowBox[{"Solve", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"fCurv", "[", "s", "]"}], "==", "0"}], ",", "s"}], "]"}], "[", 
    
    RowBox[{"[", 
     RowBox[{"1", ",", "1", ",", "2"}], "]"}], "]"}]}], "]"}]}], "Input",Expre\
ssionUUID->"79f091bc-9445-43bb-84da-fad782d0ae4f"],

Cell["6. Mean-Centered Equilibrium", "Section",ExpressionUUID->"cd6dfeab-29f3-4422-930f-46cecc72fff7"],

Cell["With constraint sum(s_i) = 0: ", "CodeText",ExpressionUUID->"8af0a16d-057c-42d1-9201-887e11acbc4d"],

Cell[BoxData[{
 RowBox[{"Print", "[", "\"\<Constrained equilibrium:\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", "\"\<  xi*g_i^2 - lam*s_i = muL  for all i\>\"", 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", "\"\<  sum(s_i) = 0\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", "\"\<Solution:\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", "\"\<  muL = xi * mean(g^2)\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", "\"\<  s_i* = xi*(g_i^2 - mean(g^2)) / lam\>\"", 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", "\"\<Stability: eigenvalue = -lam for each mode\>\"", 
  "]"}]}], "Input",ExpressionUUID->"ed4c89f4-4210-43da-8cfd-418200f8ccf5"],

Cell["7. Optimality: General phi(s) Family", "Section",ExpressionUUID->"0ab485a6-b47a-4342-9788-73088cba7a88"],

Cell[TextData[{
 "Consider ds/dt = phi(s) ",
 StyleBox[" [xi",
  FontSlant->Italic],
 "g^2 - lam*s], phi > 0."
}], "Text",ExpressionUUID->"1ffe06b1-ec6b-48b9-8f33-8a029a7ad55e"],

Cell[TextData[{
 "All members share the same equilibrium s",
 StyleBox[" = xi",
  FontSlant->Italic],
 "g^2/lam. "
}], "Text",ExpressionUUID->"fa839854-24d9-416a-89c7-2311b19f2e77"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"phi", ",", "F"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"F", "[", "s_", "]"}], ":=", 
   RowBox[{
    RowBox[{"phi", "[", "s", "]"}], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"xi", " ", "g2"}], "-", 
      RowBox[{"lam", " ", "s"}]}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dF", "=", 
   RowBox[{
    RowBox[{"D", "[", 
     RowBox[{
      RowBox[{"F", "[", "s", "]"}], ",", "s"}], "]"}], " ", "//", " ", 
    "Expand"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  RowBox[{"\"\<General Jacobian: \>\"", ",", "dF"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", "\"\<At equilibrium: F'(s*) = -lam*phi(s*)\>\"", 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", "\"\<Convergence rate: rho_i = lam*phi(s_i*)\>\"", 
  "]"}]}], "Input",ExpressionUUID->"b7743ba6-8015-4e63-8971-198ee8814e81"],

Cell["8. Minimax Convergence Rate", "Section",ExpressionUUID->"f8c419df-fb6c-4b4a-9299-afcc97dc50bb"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{
   "g2List", ",", "xiVal", ",", "muVal", ",", "gmax", ",", "results", ",", 
    "c", ",", "kTarget", ",", "lamMax"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"g2List", "=", 
   RowBox[{"{", 
    RowBox[{"0.1", ",", "1.0", ",", "5.0", ",", "20.0", ",", "50.0"}], 
    "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"xiVal", "=", "0.1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"muVal", "=", "0.01"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"gmax", "=", 
    RowBox[{"Max", "[", "g2List", "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", "\"\<=== MINIMAX CONVERGENCE RATE ===\>\"", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Print", "[", 
    RowBox[{"\"\<g^2 = \>\"", ",", "g2List", ",", "\"\<, xi=\>\"", ",", 
     "xiVal", ",", "\"\<, mu=\>\"", ",", "muVal"}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"results", "=", 
   RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Do", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"alphaVal", "==", "0"}], ",", "\[IndentingNewLine]", "    ", 
        RowBox[{
         RowBox[{"lamMax", "=", 
          RowBox[{
           RowBox[{"2.0", "/", "muVal"}], "-", "0.01"}]}], ";"}], 
        "\[IndentingNewLine]", "    ", ",", "\[IndentingNewLine]", "    ", 
        RowBox[{
         RowBox[{"c", "=", 
          RowBox[{"alphaVal", " ", "xiVal", " ", "gmax"}]}], ";", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"kTarget", "=", 
          RowBox[{"2.0", "/", "muVal"}]}], ";", "\[IndentingNewLine]", "    ", 
         RowBox[{"lamMax", "=", 
          RowBox[{
           RowBox[{"l", " ", "/.", " ", 
            RowBox[{"FindRoot", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"l", " ", 
                RowBox[{"Exp", "[", 
                 RowBox[{"c", "/", "l"}], "]"}]}], "==", "kTarget"}], ",", 
              RowBox[{"{", 
               RowBox[{"l", ",", "kTarget"}], "}"}]}], "]"}]}], " ", "//", 
           " ", "N"}]}], ";", "\[IndentingNewLine]", "    ", 
         RowBox[{"lamMax", "=", 
          RowBox[{"lamMax", "-", "0.01"}]}], ";"}]}], "\[IndentingNewLine]", 
       "  ", "]"}], ";", "\[IndentingNewLine]", "  ", 
      RowBox[{"sStarsOpt", "=", 
       RowBox[{"xiVal", " ", 
        RowBox[{"g2List", "/", "lamMax"}]}]}], ";", "\[IndentingNewLine]", 
      "  ", 
      RowBox[{"phiValsOpt", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"alphaVal", "==", "0"}], ",", "\[IndentingNewLine]", "    ", 
         
         RowBox[{"Table", "[", 
          RowBox[{"1.0", ",", 
           RowBox[{"{", 
            RowBox[{"Length", "[", "g2List", "]"}], "}"}]}], "]"}], ",", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"Exp", "[", 
          RowBox[{"alphaVal", " ", "sStarsOpt"}], "]"}]}], 
        "\[IndentingNewLine]", "  ", "]"}]}], ";", "\[IndentingNewLine]", 
      "  ", 
      RowBox[{"rates", "=", 
       RowBox[{"lamMax", " ", "phiValsOpt"}]}], ";", "\[IndentingNewLine]", 
      "  ", 
      RowBox[{"AppendTo", "[", 
       RowBox[{"results", ",", 
        RowBox[{"{", 
         RowBox[{"alphaVal", ",", "lamMax", ",", 
          RowBox[{"Min", "[", "rates", "]"}], ",", 
          RowBox[{"Max", "[", "rates", "]"}]}], "}"}]}], "]"}], ";"}], 
     "\[IndentingNewLine]", ",", 
     RowBox[{"{", 
      RowBox[{"alphaVal", ",", 
       RowBox[{"{", 
        RowBox[{
        "0", ",", "0.01", ",", "0.05", ",", "0.1", ",", "0.2", ",", "0.5", ",",
          "1.0"}], "}"}]}], "}"}]}], "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{
    RowBox[{"PaddedForm", "[", 
     RowBox[{"\"\<alpha\>\"", ",", 
      RowBox[{"{", 
       RowBox[{"5", ",", "2"}], "}"}]}], "]"}], ",", "\"\<  \>\"", ",", 
    "\[IndentingNewLine]", "      ", 
    RowBox[{"PaddedForm", "[", 
     RowBox[{"\"\<lam_max\>\"", ",", 
      RowBox[{"{", 
       RowBox[{"8", ",", "2"}], "}"}]}], "]"}], ",", "\"\<  \>\"", ",", 
    "\[IndentingNewLine]", "      ", 
    RowBox[{"PaddedForm", "[", 
     RowBox[{"\"\<min rate\>\"", ",", 
      RowBox[{"{", 
       RowBox[{"10", ",", "2"}], "}"}]}], "]"}], ",", "\"\<  \>\"", ",", 
    "\[IndentingNewLine]", "      ", 
    RowBox[{"PaddedForm", "[", 
     RowBox[{"\"\<max rate\>\"", ",", 
      RowBox[{"{", 
       RowBox[{"10", ",", "2"}], "}"}]}], "]"}], ",", "\"\<  \>\"", ",", 
    "\[IndentingNewLine]", "      ", 
    RowBox[{"PaddedForm", "[", 
     RowBox[{"\"\<min/max\>\"", ",", 
      RowBox[{"{", 
       RowBox[{"8", ",", "4"}], "}"}]}], "]"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"StringJoin", "[", 
    RowBox[{"Table", "[", 
     RowBox[{"\"\<-\>\"", ",", "60"}], "]"}], "]"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Do", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"a", ",", "lm", ",", "mn", ",", "mx"}], "}"}], "=", "res"}], ";",
       "\[IndentingNewLine]", "  ", 
      RowBox[{"Print", "[", 
       RowBox[{
        RowBox[{"PaddedForm", "[", 
         RowBox[{"a", ",", 
          RowBox[{"{", 
           RowBox[{"5", ",", "2"}], "}"}]}], "]"}], ",", "\"\<  \>\"", ",", 
        "\[IndentingNewLine]", "        ", 
        RowBox[{"PaddedForm", "[", 
         RowBox[{"lm", ",", 
          RowBox[{"{", 
           RowBox[{"8", ",", "2"}], "}"}]}], "]"}], ",", "\"\<  \>\"", ",", 
        "\[IndentingNewLine]", "        ", 
        RowBox[{"PaddedForm", "[", 
         RowBox[{"mn", ",", 
          RowBox[{"{", 
           RowBox[{"10", ",", "2"}], "}"}]}], "]"}], ",", "\"\<  \>\"", ",", 
        "\[IndentingNewLine]", "        ", 
        RowBox[{"PaddedForm", "[", 
         RowBox[{"mx", ",", 
          RowBox[{"{", 
           RowBox[{"10", ",", "2"}], "}"}]}], "]"}], ",", "\"\<  \>\"", ",", 
        "\[IndentingNewLine]", "        ", 
        RowBox[{"PaddedForm", "[", 
         RowBox[{
          RowBox[{"mn", "/", "mx"}], ",", 
          RowBox[{"{", 
           RowBox[{"8", ",", "4"}], "}"}]}], "]"}]}], "]"}], ";"}], 
     "\[IndentingNewLine]", ",", 
     RowBox[{"{", 
      RowBox[{"res", ",", "results"}], "}"}]}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<alpha=0 achieves highest min rate with perfect \
uniformity.\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<Any alpha>0 strictly decreases the worst-case rate.\>\"",
    "]"}], ";"}]}], "Input",ExpressionUUID->"532f1f36-8cab-4650-b684-\
6f477f85ed7a"],

Cell["9. Summary", "Section",ExpressionUUID->"3af25ced-bb28-47c6-b67f-4ea32edf2b9f"],

Cell[TextData[{
 StyleBox["Theorem.",
  FontWeight->Bold],
 " The normalized gradient (phi = 1) is simultaneously:"
}], "Text",ExpressionUUID->"c80e8060-4db6-4aab-9ce2-ceaaad99a8ff"],

Cell["1. Minimax optimal for convergence rate", "Text",ExpressionUUID->"a195e2f8-0ac9-4004-8cc4-b265d7286b49"],

Cell["2. Noise-optimal (minimum steady-state variance)", "Text",ExpressionUUID->"7be543bf-3504-4f06-933d-cab37a778655"],

Cell[TextData[{
 "3. Globally asymptotically stable",
 StyleBox["Code change:",
  FontWeight->Bold],
 " ",
 Cell[BoxData[Cell["grad_s = xi * g^2",
   Background->None,ExpressionUUID->"7d4b1419-0964-421f-941d-fbd06d3ccea8"]], 
  "InlineCode",ExpressionUUID->"f3b0a70a-2e3a-45a6-813c-9dc0dc10cf5b"],
 " (remove exp(s) factor)."
}], "Text",ExpressionUUID->"eac7dc5d-1f15-4d0c-8616-b8862900c297"]
},
