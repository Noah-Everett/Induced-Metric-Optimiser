Cell["Application", "Subsection",ExpressionUUID->"f328944c-895c-4bf7-b549-3143f09e2570"],

Cell[TextData[{
 "Near any non-degenerate local minimum: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["J", "TI"], "\[LongEqual]", 
         RowBox[{"(", 
           Cell[
            BoxData[
             FormBox[
              GridBox[{{
                 Cell[
                  TextData[{" ", 
                    Cell[
                    BoxData[
                    RowBox[{"-", "\[Eta] ", 
                    SuperscriptBox[
                    StyleBox["r", "TI"], "*"], " ", "diag", 
                    RowBox[{"(", 
                    RowBox[{
                    SuperscriptBox[
                    StyleBox["e", "TI"], 
                    SuperscriptBox[
                    StyleBox["s", "TI"], "*"]], 
                    StyleBox["h", "TI"]}], ")"}]}]], "InlineFormula"], " "}]], 
                 Cell[
                  TextData[{" ", 
                    Cell[
                    BoxData[
                    StyleBox["0", FontSlant -> "Bold"]], "InlineFormula"], 
                    " "}]]}, {
                 Cell[
                  TextData[{" ", 
                    Cell[
                    BoxData[
                    RowBox[{"\[Mu]\[Lambda] ", 
                    RowBox[{"(", 
                    RowBox[{"\[PartialD]", "log", 
                    StyleBox["H", "TI"], "/", "\[PartialD]", "\[Theta]"}], 
                    ")"}], 
                    SubscriptBox["|", "*"]}]], "InlineFormula"], " "}]], 
                 Cell[
                  TextData[{" ", 
                    Cell[
                    BoxData[
                    RowBox[{"-", "\[Mu]\[Lambda] ", 
                    StyleBox["I", "TI"]}]], "InlineFormula"], " "}]]}}], 
              TraditionalForm]]], ")"}]}], TraditionalForm], "errors" -> {}, 
     "input" -> 
     "J = \\begin{pmatrix} -\\eta\\, r^*\\, \\text{diag}(e^{s^*} h) & \
\\mathbf{0} \\\\ \\mu\\lambda\\, (\\partial\\log H/\\partial\\theta)\\big|_* \
& -\\mu\\lambda\\, I \\end{pmatrix}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b864c185-424e-4c1b-b29b-b8f1d63e87b1"],
 StyleBox["Eigenvalues",
  FontWeight->Bold],
 ": ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubsuperscriptBox[
          RowBox[{"{", 
            RowBox[{"-", "\[Eta]", 
              SuperscriptBox[
               StyleBox["r", "TI"], "*"], 
              SuperscriptBox[
               StyleBox["e", "TI"], 
               SubsuperscriptBox[
                StyleBox["s", "TI"], 
                StyleBox["i", "TI"], "*"]], 
              SubscriptBox[
               StyleBox["h", "TI"], 
               StyleBox["i", "TI"]]}], "}"}], 
          RowBox[{
            StyleBox["i", "TI"], "\[LongEqual]", "1"}], 
          StyleBox["N", "TI"]], "\[Union]", 
         RowBox[{"{", 
           
           RowBox[{"-", "\[Mu]\[Lambda]", ",", "\[Ellipsis]", ",", "-", 
             "\[Mu]\[Lambda]"}], "}"}]}], TraditionalForm], "errors" -> {}, 
     "input" -> 
     "\\{-\\eta r^* e^{s_i^*} h_i\\}_{i=1}^N \\cup \\{-\\mu\\lambda, \\ldots, \
-\\mu\\lambda\\}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "68b35977-d95c-4f16-b1d4-f6a6655bb67c"],
 "All negative. ",
 StyleBox["Local asymptotic stability at any non-degenerate minimum, without \
timescale separation.",
  FontWeight->Bold]
}], "Text",ExpressionUUID->"014e8156-e2d5-4378-bdd7-ba889b74d992"],

Cell["5. Newton-Targeted Decoupling Theorem", "Section",ExpressionUUID->"bdcd3116-c468-4463-bbb5-97be74c500c4"],

Cell["This is the central result for the Newton-targeted variant. ", "Text",ExpressionUUID->"0f8a81df-bad9-45d3-a26e-a3227e7a9ef3"],

Cell["Theorem (Decoupling)", "Subsection",ExpressionUUID->"5184db7e-4b26-4c48-9e76-9a44c932b3f3"],

Cell[TextData[{
 "On a diagonal quadratic ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["L", "TI"], "\[LongEqual]", 
         FractionBox["1", "2"], 
         SuperscriptBox["\[Theta]", 
          StyleBox["T", "TI"]], "diag", 
         RowBox[{"(", 
           StyleBox["h", "TI"], ")"}], " ", "\[Theta]"}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "L = \\frac{1}{2}\\theta^T \\text{diag}(h)\\,\\theta", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "36dc78f0-3100-4b45-a6a6-1307b7c72fbe"],
 ", the Newton-targeted metric update ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["s", "TI"], 
          RowBox[{
            StyleBox["t", "TI"], "+", "1"}]], "\[LongEqual]", 
         RowBox[{"(", 
           RowBox[{"1", "-", "\[Mu]\[Lambda]"}], ")"}], " ", 
         SubscriptBox[
          StyleBox["s", "TI"], 
          StyleBox["t", "TI"]], "-", "\[Mu]\[Lambda] ", "log", 
         StyleBox["h", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "s_{t+1} = (1-\\mu\\lambda)\\, s_t - \\mu\\lambda\\, \\log h", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "6122accd-5674-47c8-96eb-d5d2f09b02ca"],
 " is an ",
 StyleBox["autonomous linear system",
  FontWeight->Bold],
 ", independent of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Theta]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\theta", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "1b41001e-2832-4681-8b0b-8b0e255dbf9a"],
 ".",
 StyleBox["Proof.",
  FontWeight->Bold],
 " The driving force ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["D", "TI"], 
          StyleBox["i", "TI"]], "\[LongEqual]", "-", "\[Lambda]", "log", 
         SubscriptBox[
          StyleBox["h", "TI"], 
          StyleBox["i", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "D_i = -\\lambda \\log h_i", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d19edfe4-1ff4-48cb-a7bc-07cd3fa4664c"],
 " depends only on the Hessian diagonal, which is constant for a quadratic. \
The ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["s", "TI"], TraditionalForm], "errors" -> {}, "input" -> "s", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "de5b1074-4067-4ddc-b899-9ddcc0e56135"],
 "-update contains no ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Theta]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\theta", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "2881cb37-009b-4305-ab11-0cd31a5e8e66"],
 " terms. ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> InterpretationBox["", 
       Failure[
       "TeXAssistantError", <|
        "MessageTemplate" -> "Errors: `Errors`", 
         "MessageParameters" -> <|"Errors" -> {}|>, "Input" -> "\\square"|>]],
      "errors" -> {}, "input" -> "\\square", "state" -> "Error"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "3b83808e-d035-44bc-ad56-fa927312028c"]
}], "Text",ExpressionUUID->"16c4e63a-4c66-4a97-b2b9-dc0c123a2cc4"],

Cell["Corollary 1 (Global convergence)", "Subsection",ExpressionUUID->"05df10bc-0daf-485e-9cfc-ec160600561d"],

Cell[TextData[{
 "The coupled system ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"(", 
         RowBox[{"\[Theta]", ",", 
           StyleBox["s", "TI"]}], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "(\\theta, s)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5d7ce58c-30a3-4705-ba78-d8327ca217f1"],
 " converges to ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"(", 
         RowBox[{"0", ",", 
           SuperscriptBox[
            StyleBox["s", "TI"], "*"]}], ")"}], TraditionalForm], 
     "errors" -> {}, "input" -> "(0, s^*)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5f2807ef-1abd-4fbc-86ea-9002391f419d"],
 " from any initial condition, provided:"
}], "Text",ExpressionUUID->"28bc2cda-c839-467b-b4e3-798de774cd89"],

Cell[TextData[{
 "1. ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"0", "<", "\[Mu]\[Lambda]", "<", "2"}], TraditionalForm], 
     "errors" -> {}, "input" -> "0 < \\mu\\lambda < 2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e214a24b-dcaa-468e-8050-62679db2923e"],
 " (metric stability)"
}], "Text",ExpressionUUID->"4a2b074b-fc91-4666-bf0a-52e01c6b2892"],

Cell[TextData[{
 "2. ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Eta] ", 
         SuperscriptBox[
          StyleBox["e", "TI"], 
          StyleBox["c", "TI"]], " ", 
         SubscriptBox[
          StyleBox["h", "TI"], "max"], "<", "2"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\eta\\, e^c\\, h_{\\max} < 2", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "44d79cad-acd2-487d-a5bb-df0e8ac1bf34"],
 " (parameter stability with worst-case metric) "
}], "Text",ExpressionUUID->"7a70ecac-1bc6-49ed-b22f-df2b83f75f13"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Joint", " ", "Lyapunov", " ", "for", " ", "Newton"}], "-", 
     RowBox[{"targeted", ":", " ", "V"}]}], " ", "=", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"L", 
       RowBox[{"(", "theta", ")"}]}], " ", "+", " ", 
      RowBox[{"(", 
       RowBox[{"alpha", "/", "2"}], ")"}]}], " ", "||", 
     RowBox[{"s", " ", "-", " ", 
      RowBox[{"s", "*"}]}], "||", 
     RowBox[{"^", "2"}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"dV", "/", "dt"}], " ", "=", " ", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"-", "eta"}], " ", "r", " ", 
       RowBox[{"Sum", "[", 
        RowBox[{"exp", 
         RowBox[{"(", "si", ")"}], " ", 
         RowBox[{"hi", "^", "2"}], " ", 
         RowBox[{"thetai", "^", "2"}]}], "]"}]}], " ", "-", " ", 
      RowBox[{"alpha", " ", "mu", " ", "lam"}]}], " ", "||", 
     RowBox[{"s", " ", "-", " ", 
      RowBox[{"s", "*"}]}], "||", 
     RowBox[{"^", "2"}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Both", " ", "terms", " ", "non"}], "-", 
    RowBox[{"positive", ".", " ", "Cross"}], "-", 
    RowBox[{"term", " ", "is", " ", 
     RowBox[{"ZERO", "."}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Print", "[", "\"\<Newton-targeted joint Lyapunov:\>\"", "]"}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<V = L(theta) + (alpha/2) ||s - s*||^2\>\"", "]"}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<dV/dt = -eta r Sum[exp(si) hi^2 thetai^2] - alpha mu \
lam ||s - s*||^2\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Cross-term = 0 (s-dynamics independent of theta).\>\"",
      "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<V is a STRICT Lyapunov function for any alpha > 0.\>\"",
      "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Global asymptotic stability WITHOUT timescale \
separation.\>\"", "]"}], ";"}]}]}]], "Input",ExpressionUUID->"24736a5f-3484-\
482b-b9ff-3a3ef945d353"],

Cell["Corollary 2 (No timescale separation required)", "Subsection",ExpressionUUID->"b19d5d8e-8e68-424e-9476-e727d442748d"],

Cell[TextData[{
 "Unlike the base rule, the Newton-targeted rule converges for ",
 StyleBox["any",
  FontWeight->Bold],
 " ratio ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Mu]", "/", "\[Eta]"}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\mu/\\eta", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "764d5cf8-447b-4c6f-bd4c-83f3a72a2efe"],
 ". The constraints are only (1) and (2) above."
}], "Text",ExpressionUUID->"76fbcac5-acc5-4242-9504-4ee9aa65343b"],

Cell["\<\
This resolves the fundamental concern in the issue: the reviewer's objection \
about subsystem-only guarantees does not apply to the Newton-targeted \
variant. \
\>", "Text",ExpressionUUID->"85a7ed0b-7229-4c96-898e-4a438a28f702"],

Cell["6. Base Rule: Joint Lyapunov with Cross-Term", "Section",ExpressionUUID->"8f5595a7-1c2e-424b-85a1-0ff6dc4ab081"],

Cell[TextData[{
 "For the base gradient-magnitude rule, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["D", "TI"], 
          StyleBox["i", "TI"]], 
         RowBox[{"(", "\[Theta]", ")"}], "\[LongEqual]", "\[Xi]", 
         SubsuperscriptBox[
          StyleBox["h", "TI"], 
          StyleBox["i", "TI"], "2"], 
         SubsuperscriptBox["\[Theta]", 
          StyleBox["i", "TI"], "2"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "D_i(\\theta) = \\xi h_i^2 \\theta_i^2", "state" -> "Boxes"|>,
    
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "57dab296-84b1-4911-ac22-bc0f6343802d"],
 " depends on ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Theta]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\theta", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "6356652f-c28e-4bc0-9890-0a7130f3e73b"],
 ", creating genuine coupling. "
}], "Text",ExpressionUUID->"6d243cc2-e4d1-4557-a5aa-83164e7c517f"],

Cell["Lyapunov analysis", "Subsection",ExpressionUUID->"6ae4051b-90d6-4179-ab44-b85fb800c961"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"N", "=", 
    RowBox[{"1", " ", "analysis"}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"V", " ", "=", " ", 
    RowBox[{
     RowBox[{"h1", " ", 
      RowBox[{
       RowBox[{"theta1", "^", "2"}], "/", "2"}]}], " ", "+", " ", 
     RowBox[{"alpha", " ", 
      RowBox[{
       RowBox[{"s1", "^", "2"}], "/", "2"}]}]}]}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"dV", "/", "dt"}], " ", "=", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "eta"}], " ", "r", " ", "exp", 
      RowBox[{"(", "s1", ")"}], " ", 
      RowBox[{"h1", "^", "2"}], " ", 
      RowBox[{"theta1", "^", "2"}]}], " ", "-", " ", 
     RowBox[{"alpha", " ", "mu", " ", "lam", " ", 
      RowBox[{"s1", "^", "2"}]}], " ", "+", " ", 
     RowBox[{"alpha", " ", "mu", " ", "xi", " ", 
      RowBox[{"h1", "^", "2"}], " ", 
      RowBox[{"theta1", "^", "2"}], " ", "s1"}]}]}], " ", "*)"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"The", " ", "cross"}], "-", 
    RowBox[{"term", ":", " ", 
     RowBox[{"alpha", " ", "mu", " ", "xi", " ", 
      RowBox[{"h1", "^", "2"}], " ", 
      RowBox[{"theta1", "^", "2"}], " ", "s1"}]}]}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"With", " ", "clipping"}], " ", "|", "s", "|", " ", 
    RowBox[{"<=", " ", 
     RowBox[{"c", ":"}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"|", "cross", "|", " ", 
    RowBox[{"<=", " ", 
     RowBox[{"alpha", " ", "mu", " ", "xi", " ", "c", " ", 
      RowBox[{"h1", "^", "2"}], " ", 
      RowBox[{"theta1", "^", "2"}]}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"For", " ", 
      RowBox[{"dV", "/", "dt"}]}], " ", "<", " ", 
     RowBox[{
      RowBox[{"0", " ", "in", " ", "the", " ", "L"}], "-", "direction"}]}], ",",
     " ", 
    RowBox[{"need", ":"}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"eta", " ", "r", " ", "exp", 
     RowBox[{"(", 
      RowBox[{"-", "c"}], ")"}], " ", 
     RowBox[{"h1", "^", "2"}], " ", 
     RowBox[{"theta1", "^", "2"}]}], " ", ">", " ", 
    RowBox[{"alpha", " ", "mu", " ", "xi", " ", "c", " ", 
     RowBox[{"h1", "^", "2"}], " ", 
     RowBox[{"theta1", "^", "2"}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"i", ".", "e", "."}], ",", " ", 
    RowBox[{"alpha", " ", "<", " ", 
     RowBox[{"eta", " ", "r", " ", "exp", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"-", "c"}], ")"}], " ", "/", " ", 
       RowBox[{"(", 
        RowBox[{"mu", " ", "xi", " ", "c"}], ")"}]}]}]}]}], " ", "*)"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Print", "[", "\"\<Base rule joint Lyapunov:\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<V = L(theta) + (alpha/2) ||s||^2\>\"", "]"}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<dV/dt = -eta r exp(s) h^2 theta^2 - alpha mu lam s^2 + \
alpha mu xi h^2 theta^2 s\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Cross-term bounded: |alpha mu xi h^2 theta^2 s| <= \
alpha mu xi c 2L/hmin\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Sufficient condition: alpha < eta exp(-2c) / (mu xi c)\
\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Always satisfiable: choose alpha small enough.\>\"", 
     "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Joint rate: min(eta exp(-c)/2, alpha mu lam)\>\"", 
     "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Optimal alpha: eta exp(-c)/(2 mu lam), giving rate ~ \
sqrt(eta mu lam exp(-c))\>\"", "]"}], ";"}]}]}]], "Input",ExpressionUUID->\
"69f74858-0801-48a9-a38b-109d5f6caae8"],

Cell["Theorem (Base rule convergence)", "Subsection",ExpressionUUID->"b560eb55-dce4-4160-aa23-187fe8575c53"],

Cell["Under the conditions:", "Text",ExpressionUUID->"e9e93bbf-257f-47b2-a285-6a2089e54de4"],

Cell[TextData[{
 "1. ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"0", "<", "\[Mu]\[Lambda]", "<", "2"}], TraditionalForm], 
     "errors" -> {}, "input" -> "0 < \\mu\\lambda < 2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "4a3f8913-5553-4c25-8d8e-4d94f617bf15"],
 "2. ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Eta] ", 
         SuperscriptBox[
          StyleBox["e", "TI"], 
          StyleBox["c", "TI"]], " ", 
         SubscriptBox[
          StyleBox["h", "TI"], "max"], "<", "2"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\eta\\, e^c\\, h_{\\max} < 2", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c08a1f73-a3b2-4a09-ad9f-7449000b8be3"],
 "3. ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"|", 
         SubscriptBox[
          StyleBox["s", "TI"], 
          StyleBox["i", "TI"]], "|", "\[LessEqual]", 
         StyleBox["c", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "|s_i| \\leq c", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "89304678-3fda-4c89-b1bd-5a59209dbf27"],
 " (enforced by clipping)"
}], "Text",ExpressionUUID->"e7ea1ae4-a6e7-4d5e-bc5f-98eb751e06b1"],

Cell[TextData[{
 "the coupled base-rule system converges to ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         RowBox[{"(", 
           RowBox[{
             SuperscriptBox["\[Theta]", "*"], ",", 
             SuperscriptBox[
              StyleBox["s", "TI"], "*"]}], ")"}], "\[LongEqual]", 
         RowBox[{"(", 
           RowBox[{"0", ",", "0"}], ")"}]}], TraditionalForm], "errors" -> {},
      "input" -> "(\\theta^*, s^*) = (0, 0)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "fc6ec120-1934-4cc8-981e-9bfbf3921c9a"],
 " with joint rate: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Rho]", "joint"], "\[LongEqual]", "max", 
         "\[NegativeThinSpace]", 
         RowBox[{"(", 
           RowBox[{"|1", "-", "\[Eta] ", 
             SubscriptBox[
              StyleBox["h", "TI"], "min"], "|", ", ", "|1", "-", 
             "\[Mu]\[Lambda]", "|"}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\rho_{\\text{joint}} = \\max\\!\\left(|1 - \\eta\\, \
h_{\\text{min}}|,\\; |1 - \\mu\\lambda|\\right)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "dcf38618-efa1-4a75-b757-65e662cea4d0"],
 "The joint rate is limited by the ",
 StyleBox["slower",
  FontWeight->Bold],
 " of the two subsystems. "
}], "Text",ExpressionUUID->"120ffab3-0ccb-492d-876b-0fd4ff402754"],

Cell["7. Denominator as Stabilizer", "Section",ExpressionUUID->"d9323d1b-c3b5-4e68-8567-aef7dfa5ff2a"],

Cell[TextData[{
 "The adaptive denominator ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["r", "TI"], "\[LongEqual]", "1", "/", 
         RowBox[{"(", 
           RowBox[{"1", "+", "|", 
             StyleBox["v", "TI"], "|"}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> "r = 1/(1 + |v|)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "1fbb3ffd-20b2-4e42-b046-5ffb7f3ae2f0"],
 " provides a natural safety valve. "
}], "Text",ExpressionUUID->"2555804a-038e-4fd0-9a77-9531e4023d40"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Effective", " ", "step", " ", "bound"}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"eta", " ", "r", " ", "exp", 
     RowBox[{"(", "s_i", ")"}], " ", "h_i"}], " ", "=", " ", 
    RowBox[{"eta", " ", "exp", 
     RowBox[{"(", "s_i", ")"}], " ", 
     RowBox[{"h_i", " ", "/", " ", 
      RowBox[{"(", 
       RowBox[{"1", " ", "+", " ", 
        RowBox[{"xi", " ", 
         RowBox[{"Sum_k", "[", 
          RowBox[{"exp", 
           RowBox[{"(", "s_k", ")"}], " ", 
           RowBox[{"h_k", "^", "2"}], " ", 
           RowBox[{"theta_k", "^", "2"}]}], "]"}]}]}], ")"}]}]}]}], " ", 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Using", " ", "only", " ", "the", " ", "i"}], "-", 
    RowBox[{"th", " ", "term", " ", "in", " ", "the", " ", 
     RowBox[{"sum", ":"}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"<=", " ", 
    RowBox[{"eta", " ", "exp", 
     RowBox[{"(", "s_i", ")"}], " ", 
     RowBox[{"h_i", " ", "/", " ", 
      RowBox[{"(", 
       RowBox[{"1", " ", "+", " ", 
        RowBox[{"xi", " ", "exp", 
         RowBox[{"(", "s_i", ")"}], " ", 
         RowBox[{"h_i", "^", "2"}], " ", 
         RowBox[{"theta_i", "^", "2"}]}]}], ")"}]}]}]}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"For", " ", "large", " ", 
     RowBox[{"theta", ":", " ", 
      RowBox[{"<=", " ", 
       RowBox[{"eta", "/", 
        RowBox[{"(", 
         RowBox[{"xi", " ", "h_i", " ", 
          RowBox[{"theta_i", "^", "2"}]}], ")"}]}]}]}]}], " ", "->", " ", 
    "0"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"For", " ", "large", " ", "exp", 
      RowBox[{"(", "s_i", ")"}]}], ":", " ", 
     RowBox[{"<=", " ", 
      RowBox[{"eta", "/", 
       RowBox[{"(", 
        RowBox[{"xi", " ", "h_i", " ", 
         RowBox[{"theta_i", "^", "2"}]}], ")"}]}]}]}], " ", "->", " ", 
    RowBox[{"0", " ", 
     RowBox[{"(", 
      RowBox[{"same", " ", "bound"}], ")"}]}]}], " ", "*)"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Print", "[", "\"\<=== Denominator Stabilization ===\>\"", "]"}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<Effective step: eta r exp(si) hi\>\"", "]"}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<Self-regulating bounds:\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<  Large theta: effective step <= eta/(xi hi thetai^2) \
-> 0\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<  Large exp(si): effective step <= eta/(xi hi \
thetai^2) -> 0\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<  Both: denominator grows, step shrinks. Negative \
feedback.\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<This explains the numerical finding \
(hp-two-timescale-verification.py):\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<the optimizer does NOT diverge at any tested mu/eta \
ratio.\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<The denominator acts as an automatic Lyapunov \
regularizer.\>\"", "]"}], ";"}]}]}]], "Input",ExpressionUUID->"99308f03-be6b-\
4b4a-a7e1-c5d51655e884"],

Cell["8. Discrete Spectral Radius", "Section",ExpressionUUID->"c3a45a4d-5a8d-46fd-8938-149c3a7e09fe"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Spectral", " ", "radius", " ", "of", " ", "the", " ", "discrete", " ", 
    "coupled", " ", "map", " ", "at", " ", "equilibrium"}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<=== Discrete Spectral Radius at Equilibrium ===\>\"", 
     "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<Newton-targeted:\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<  rho = max(|1 - eta hgeo|, |1 - mu lam|)\>\"", "]"}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<  hgeo = exp(mean(log h)) = geometric mean of Hessian \
eigenvalues\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<Base rule:\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<  rho = max(max_i |1 - eta hi|, |1 - mu lam|)\>\"", 
     "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<  Rate limited by worst eigenvalue (no preconditioning \
at s*=0)\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"Numerical", " ", "comparison"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"hVals", "=", 
     RowBox[{"{", 
      RowBox[{"1", ",", "10", ",", "100"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"hGeo", "=", 
     RowBox[{
      RowBox[{"GeometricMean", "[", "hVals", "]"}], " ", "//", " ", "N"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"eta", "=", "0.05"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"mulam", "=", "0.01"}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"rhoNewton", "=", 
     RowBox[{"Max", "[", 
      RowBox[{
       RowBox[{"Abs", "[", 
        RowBox[{"1", "-", 
         RowBox[{"eta", " ", "hGeo"}]}], "]"}], ",", 
       RowBox[{"Abs", "[", 
        RowBox[{"1", "-", "mulam"}], "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"rhoBase", "=", 
     RowBox[{"Max", "[", 
      RowBox[{
       RowBox[{"Max", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Abs", "[", 
           RowBox[{"1", "-", 
            RowBox[{"eta", " ", "#"}]}], "]"}], " ", "&"}], " ", "/@", " ", 
         "hVals"}], "]"}], ",", 
       RowBox[{"Abs", "[", 
        RowBox[{"1", "-", "mulam"}], "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Example: h = \>\"", ",", "hVals", ",", "\"\<, eta = \>\"", ",",
       "eta", ",", "\"\<, mu lam = \>\"", ",", "mulam"}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Newton: rho = \>\"", ",", 
      RowBox[{"rhoNewton", " ", "//", " ", "N"}], ",", "\"\<  (rate = \>\"", ",", 
      RowBox[{
       RowBox[{"-", 
        RowBox[{"Log", "[", "rhoNewton", "]"}]}], " ", "//", " ", "N"}], 
      ",", "\"\<)\>\""}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Base:   rho = \>\"", ",", 
      RowBox[{"rhoBase", " ", "//", " ", "N"}], ",", "\"\<  (rate = \>\"", ",", 
      RowBox[{
       RowBox[{"-", 
        RowBox[{"Log", "[", "rhoBase", "]"}]}], " ", "//", " ", "N"}], 
      ",", "\"\<)\>\""}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Newton is \>\"", ",", 
      RowBox[{
       RowBox[{
        RowBox[{"-", 
         RowBox[{"Log", "[", "rhoNewton", "]"}]}], "/", 
        RowBox[{"-", 
         RowBox[{"Log", "[", "rhoBase", "]"}]}]}], " ", "//", " ", "N"}], 
      ",", "\"\<x faster at equilibrium.\>\""}], "]"}], ";"}]}]}]], "Input",Ex\
pressionUUID->"7c56ba27-54e4-4db1-b923-66a507c6e2ca"],

Cell["9. Borkar's Conditions Verification", "Section",ExpressionUUID->"86d7d03b-ceba-44f9-ab4e-141fd215d7c2"],

Cell[TextData[{
 "For diminishing step sizes ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Eta]", 
          StyleBox["t", "TI"]], "\[LongEqual]", 
         SubscriptBox["\[Eta]", "0"], "/", 
         SuperscriptBox[
          StyleBox["t", "TI"], 
          StyleBox["a", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\eta_t = \\eta_0/t^a", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "3efa521e-3c93-424e-b279-87c44148e402"],
 ", ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Mu]", 
          StyleBox["t", "TI"]], "\[LongEqual]", 
         SubscriptBox["\[Mu]", "0"], "/", 
         SuperscriptBox[
          StyleBox["t", "TI"], 
          StyleBox["b", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\mu_t = \\mu_0/t^b", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "33dcc895-3b42-4c13-8c06-f6acf4d47c74"],
 " with ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         FractionBox["1", "2"], "<", 
         StyleBox["a", "TI"], "<", 
         StyleBox["b", "TI"], "\[LessEqual]", "1"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\frac{1}{2} < a < b \\leq 1", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "188a1cd1-ec17-4315-96aa-c65d87c3de31"],
 "."
}], "Text",ExpressionUUID->"50978ff8-1118-4050-89db-ba1ae2c281b5"],

Cell[TextData[{
 "**(A1) Fast ODE has GAS equilibrium for each ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["s", "TI"], TraditionalForm], "errors" -> {}, "input" -> "s", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a7a08336-97a3-4a3d-b421-8de2ed0eeffe"],
 ".**"
}], "Text",ExpressionUUID->"72bc81bc-5fdd-405a-8405-f1c0d65b9fe0"],

Cell[TextData[{
 "For fixed ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["s", "TI"], TraditionalForm], "errors" -> {}, "input" -> "s", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0a0f8a52-806a-48a1-b345-a41894bc3cdf"],
 ", ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          OverscriptBox["\[Theta]", "."], 
          StyleBox["i", "TI"]], "\[LongEqual]", "-", "\[Eta] ", 
         StyleBox["r", "TI"], 
         RowBox[{"(", 
           RowBox[{"\[Theta]", ",", 
             StyleBox["s", "TI"]}], ")"}], " ", 
         SuperscriptBox[
          StyleBox["e", "TI"], 
          SubscriptBox[
           StyleBox["s", "TI"], 
           StyleBox["i", "TI"]]], " ", 
         SubscriptBox[
          StyleBox["h", "TI"], 
          StyleBox["i", "TI"]], " ", 
         SubscriptBox["\[Theta]", 
          StyleBox["i", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\dot{\\theta}_i = -\\eta\\, r(\\theta,s)\\, e^{s_i}\\, h_i\\, \
\\theta_i", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "4f70bef3-d65b-40a6-a550-d6875db0ea94"],
 " has Lyapunov function ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["V", "TI"], "\[LongEqual]", 
         StyleBox["L", "TI"], 
         RowBox[{"(", "\[Theta]", ")"}]}], TraditionalForm], "errors" -> {}, 
     "input" -> "V = L(\\theta)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c7d956c5-4576-4022-8065-1f52eb0595bd"],
 " with ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         OverscriptBox[
          StyleBox["V", "TI"], "."], "<", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\dot{V} < 0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c8770f85-e74a-457a-a9f2-1588f658cf8f"],
 " for ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Theta]\[NotEqual]", "0"}], TraditionalForm], "errors" -> {},
      "input" -> "\\theta \\neq 0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "6d5f92d0-13fb-457d-9c32-4f45d073a55a"],
 ". The unique equilibrium ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox["\[Theta]", "*"], 
         RowBox[{"(", 
           StyleBox["s", "TI"], ")"}], "\[LongEqual]", "0"}], 
       TraditionalForm], "errors" -> {}, "input" -> "\\theta^*(s) = 0", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "84a10252-5eac-4d4b-b94d-f71296b630f9"],
 " is GAS. ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> InterpretationBox["", 
       Failure[
       "TeXAssistantError", <|
        "MessageTemplate" -> "Errors: `Errors`", 
         "MessageParameters" -> <|"Errors" -> {}|>, "Input" -> 
         "\\checkmark"|>]], "errors" -> {}, "input" -> "\\checkmark", "state" -> 
     "Error"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "43748001-8aae-411b-8d19-147d3c2b8b20"],
 StyleBox["(A2) Slow ODE at fast equilibrium has GAS equilibrium.",
  FontWeight->Bold],
 "At ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox["\[Theta]", "*"], "\[LongEqual]", "0"}], 
       TraditionalForm], "errors" -> {}, "input" -> "\\theta^* = 0", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "00fd9bcb-ab0d-403d-95e9-430dc1e00ae7"],
 ": Newton-targeted gives ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         OverscriptBox[
          StyleBox["s", "TI"], "."], "\[LongEqual]", "-", "\[Mu]\[Lambda]", 
         RowBox[{"(", 
           RowBox[{
             StyleBox["s", "TI"], "+", "log", 
             StyleBox["h", "TI"]}], ")"}]}], TraditionalForm], "errors" -> {},
      "input" -> "\\dot{s} = -\\mu\\lambda(s + \\log h)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "6fdc75d2-a09e-4dab-9569-b0e6b05c6934"],
 " with GAS equilibrium ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox[
        StyleBox["s", "TI"], "*"], TraditionalForm], "errors" -> {}, "input" -> 
     "s^*", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "fa2ce2a1-c99f-4751-80b6-379c72a4861c"],
 ". Base rule gives ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         OverscriptBox[
          StyleBox["s", "TI"], "."], "\[LongEqual]", "-", "\[Mu]\[Lambda] ", 
         StyleBox["s", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\dot{s} = -\\mu\\lambda\\, s", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "76115e51-4b1c-4a94-959c-061fe824867c"],
 " with GAS equilibrium ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["s", "TI"], "*"], "\[LongEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "s^* = 0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "36ee139c-7318-40f3-af3a-a8697bb24eb3"],
 ". ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> InterpretationBox["", 
       Failure[
       "TeXAssistantError", <|
        "MessageTemplate" -> "Errors: `Errors`", 
         "MessageParameters" -> <|"Errors" -> {}|>, "Input" -> 
         "\\checkmark"|>]], "errors" -> {}, "input" -> "\\checkmark", "state" -> 
     "Error"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "2889aa65-9d53-4692-9b26-3c1996c617e3"],
 StyleBox["(A3) Step size conditions.",
  FontWeight->Bold],
 " ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Sum]", 
         SubscriptBox["\[Eta]", 
          StyleBox["t", "TI"]], "\[LongEqual]", "\[Sum]", 
         SubscriptBox["\[Mu]", 
          StyleBox["t", "TI"]], "\[LongEqual]", "\[Infinity]"}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\sum \\eta_t = \\sum \\mu_t = \\infty", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "802bcdbc-9fff-4ef9-b3a8-843b3941569a"],
 ", ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Sum]", 
         SubsuperscriptBox["\[Eta]", 
          StyleBox["t", "TI"], "2"], "<", "\[Infinity]"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\sum \\eta_t^2 < \\infty", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "23ccf48f-9081-4f9f-a430-0a6ab2fdbe01"],
 ", ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Sum]", 
         SubsuperscriptBox["\[Mu]", 
          StyleBox["t", "TI"], "2"], "<", "\[Infinity]"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\sum \\mu_t^2 < \\infty", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "1e686aa3-ec5b-4004-bb7f-d99555112fcc"],
 ", ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Mu]", 
          StyleBox["t", "TI"]], "/", 
         SubscriptBox["\[Eta]", 
          StyleBox["t", "TI"]], "\[Rule]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\mu_t/\\eta_t \\to 0", "state" -> "Boxes"|>,
    
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5dd0a48c-2984-43d0-af4c-c29b5e9f64d1"],
 ". Standard SA schedule. ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> InterpretationBox["", 
       Failure[
       "TeXAssistantError", <|
        "MessageTemplate" -> "Errors: `Errors`", 
         "MessageParameters" -> <|"Errors" -> {}|>, "Input" -> 
         "\\checkmark"|>]], "errors" -> {}, "input" -> "\\checkmark", "state" -> 
     "Error"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0049fea0-76ca-469e-bd04-322efcb629b4"],
 StyleBox["(A4-A5) Noise and Lipschitz conditions.",
  FontWeight->Bold],
 " The RHS functions $f, g$ are smooth with bounded derivatives on any \
compact set. Stochastic gradient noise is a martingale difference with \
bounded conditional variance (standard assumption). ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> InterpretationBox["", 
       Failure[
       "TeXAssistantError", <|
        "MessageTemplate" -> "Errors: `Errors`", 
         "MessageParameters" -> <|"Errors" -> {}|>, "Input" -> 
         "\\checkmark"|>]], "errors" -> {}, "input" -> "\\checkmark", "state" -> 
     "Error"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "cf0390af-2a57-4de2-a984-8b18b5dab428"],
 StyleBox["Conclusion",
  FontWeight->Bold],
 ": Borkar's two-timescale SA theorem applies. For diminishing step sizes, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         RowBox[{"(", 
           RowBox[{
             SubscriptBox["\[Theta]", 
              StyleBox["t", "TI"]], ",", 
             SubscriptBox[
              StyleBox["s", "TI"], 
              StyleBox["t", "TI"]]}], ")"}], "\[Rule]", 
         RowBox[{"(", 
           RowBox[{
             SuperscriptBox["\[Theta]", "*"], ",", 
             SuperscriptBox[
              StyleBox["s", "TI"], "*"]}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> "(\\theta_t, s_t) \\to (\\theta^*, s^*)", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "4c78f58f-23e4-4fd3-80cd-1c1b401d21cb"],
 " almost surely."
}], "Text",ExpressionUUID->"d16bc004-f2c2-4597-ae10-8e48f1e501ae"],

Cell[TextData[{
 "For constant step sizes (as used in practice), the ODE method gives \
convergence to a ",
 StyleBox["neighborhood",
  FontWeight->Bold],
 " of the equilibrium with radius ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["O", "TI"], "(", 
         RowBox[{"\[Eta]", "+", "\[Mu]"}], ")"}], TraditionalForm], 
     "errors" -> {}, "input" -> "O(\\eta + \\mu)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "7b4fc2e3-388c-4069-b297-32d65c4f3bf2"],
 ". "
}], "Text",ExpressionUUID->"696280cc-35fe-4cba-aaf2-a0f8f126d405"],

Cell["10. Summary of Results", "Section",ExpressionUUID->"4a1b9834-c397-4b62-ad8a-f02a8426cd49"],

Cell["\<\
Print[\"=== Summary ===\"];
Print[\"\"];
Print[\"1. EQUILIBRIUM STABILITY (both rules):\"];
Print[\"   Jacobian is block-diagonal at equilibrium.\"];
Print[\"   All eigenvalues negative. Local stability without timescale \
separation.\"];
Print[\"\"];
Print[\"2. NEWTON-TARGETED (strong result):\"];
Print[\"   s-dynamics DECOUPLE from theta on diagonal quadratics.\"];
Print[\"   Joint Lyapunov with ZERO cross-term.\"];
Print[\"   Global convergence for ANY mu/eta ratio.\"];
Print[\"   On general smooth loss: block-TRIANGULAR Jacobian at local \
min.\"];
Print[\"   Local convergence without timescale separation.\"];
Print[\"\"];
Print[\"3. BASE RULE (weaker, requires more conditions):\"];
Print[\"   Cross-term bounded by alpha mu xi c (2L/hmin).\"];
Print[\"   Global convergence with alpha < eta exp(-2c)/(mu xi c).\"];
Print[\"   Joint rate: min(theta-rate, s-rate).\"];
Print[\"   Timescale separation (mu\
\>", "Program",ExpressionUUID->"e5a29067-fbf6-4aa7-8b58-9598b8f194b4"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"eta", ")"}], " ", "ensures", " ", "quasi"}], "-", 
    RowBox[{"static", " ", 
     RowBox[{"s", ".", "\<\"];
Print[\"\>"}], "\<\"];
Print[\"\>", "4.", " ", "DENOMINATOR", " ", "STABILIZATION", " ", 
     RowBox[{"(", 
      RowBox[{"both", " ", "rules"}], ")"}]}]}], ":", 
   RowBox[{"\<\"];
Print[\"\>", "   ", "r"}]}], "=", 
  RowBox[{
   RowBox[{"1", "/", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"1", "+"}], "|", "v", "|"}], ")"}]}], " ", "provides", " ", 
   "negative", " ", 
   RowBox[{"feedback", ".", "\<\"];
Print[\"\>"}], "   ", "Effective", " ", "step", " ", "bounded", " ", "by", " ", 
   RowBox[{"eta", "/", 
    RowBox[{"(", 
     RowBox[{"xi", " ", "h", " ", 
      RowBox[{"theta", "^", "2"}]}], ")"}]}], " ", "for", " ", "large", " ", 
   RowBox[{"theta", ".", "\<\"];
Print[\"\>"}], "   ", "Prevents", " ", "divergence", " ", "even", " ", 
   "without", " ", "strict", " ", "timescale", " ", 
   RowBox[{"separation", ".", "\<\"];
Print[\"\>"}], "\<\"];
Print[\"\>", "5.", " ", 
   RowBox[{"BORKAR", "'"}], "S", " ", 
   RowBox[{"THEOREM", ":", 
    RowBox[{"\<\"];
Print[\"\>", "   ", "All", " ", "conditions", " ", "verified", " ", "for", " ",
      "both", " ", 
     RowBox[{"rules", ".", "\<\"];
Print[\"\>"}], "   ", "Diminishing", " ", "step", " ", "sizes"}], ":", " ", 
    RowBox[{
     RowBox[{"a", ".", "s", ".", " ", "convergence", ".", "\<\"];
Print[\"\>"}], "   ", "Constant", " ", "step", " ", 
     RowBox[{"sizes", ":", " ", 
      RowBox[{"convergence", " ", "to", " ", "O", 
       RowBox[{"(", 
        RowBox[{"eta", "+", "mu"}], ")"}], " ", 
       RowBox[{"neighborhood", ".", "\"\<];\>"}]}]}]}]}]}]}]], "Echo",Expressi\
onUUID->"839adb11-a4be-445a-b641-828ba8c5a64f"]
},
