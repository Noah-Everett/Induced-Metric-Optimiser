 " structure. "
}], "Text",ExpressionUUID->"4417da5b-ed12-4068-aa26-caea5269aec7"],

Cell["Lemma (Block-triangular eigenvalues)", "Subsection",ExpressionUUID->"40c09442-ff8d-404e-bd3a-7954e8b3bfb0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Eigenvalues", " ", "of", " ", "block"}], "-", "triangular"}], 
    " ", "=", " ", 
    RowBox[{
    "union", " ", "of", " ", "diagonal", " ", "block", " ", "eigenvalues"}]}],
    " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"A", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"a11", ",", "a12"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"a21", ",", "a22"}], "}"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"B2", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0"}], "}"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"C2", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"c11", ",", "c12"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"c21", ",", "c22"}], "}"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"D2", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"d11", ",", "d12"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"d21", ",", "d22"}], "}"}]}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"blockTriangular", "=", 
     RowBox[{"ArrayFlatten", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"A", ",", "B2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"C2", ",", "D2"}], "}"}]}], "}"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"eigsBT", "=", 
     RowBox[{"Sort", "[", 
      RowBox[{"Simplify", "[", 
       RowBox[{"Eigenvalues", "[", "blockTriangular", "]"}], "]"}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"eigsAD", "=", 
     RowBox[{"Sort", "[", 
      RowBox[{"Join", "[", 
       RowBox[{
        RowBox[{"Simplify", "[", 
         RowBox[{"Eigenvalues", "[", "A", "]"}], "]"}], ",", 
        RowBox[{"Simplify", "[", 
         RowBox[{"Eigenvalues", "[", "D2", "]"}], "]"}]}], "]"}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Block-triangular eigenvalues = diagonal block eigenvalues: \
\>\"", ",", 
      RowBox[{"eigsBT", "===", "eigsAD"}]}], "]"}], ";"}]}]}]], "Input",Expres\
sionUUID->"abb956eb-12b2-4c1d-bfab-037508bd2ae3"],

