Cell["1. Setup: The Coupled System", "Section",ExpressionUUID->"1d664654-65bd-4d78-b6ec-c527be4a0d10"],

Cell[TextData[{
 "On a diagonal quadratic ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["L", "TI"], 
         RowBox[{"(", "\[Theta]", ")"}], "\[LongEqual]", 
         FractionBox["1", "2"], 
         UnderscriptBox["\[Sum]", 
          StyleBox["i", "TI"], LimitsPositioning -> True], 
         SubscriptBox[
          StyleBox["h", "TI"], 
          StyleBox["i", "TI"]], 
         SubsuperscriptBox["\[Theta]", 
          StyleBox["i", "TI"], "2"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "L(\\theta) = \\frac{1}{2}\\sum_i h_i \\theta_i^2", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "802d37a8-ee3e-40c2-a2ea-d6ba16bea814"],
 ", the optimizer couples two dynamical systems.",
 StyleBox["Parameter dynamics",
  FontWeight->Bold],
 " (",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Theta]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\theta", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "2dd95234-a611-4765-ae58-eb9f52a9cbcc"],
 ", fast timescale): ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubsuperscriptBox["\[Theta]", 
          StyleBox["i", "TI"], 
          RowBox[{"(", 
            RowBox[{
              StyleBox["t", "TI"], "+", "1"}], ")"}]], "\[LongEqual]", 
         SubsuperscriptBox["\[Theta]", 
          StyleBox["i", "TI"], 
          RowBox[{"(", 
            StyleBox["t", "TI"], ")"}]], "-", "\[Eta] ", 
         SubscriptBox[
          StyleBox["r", "TI"], 
          StyleBox["t", "TI"]], " ", 
         SuperscriptBox[
          StyleBox["e", "TI"], 
          SubsuperscriptBox[
           StyleBox["s", "TI"], 
           StyleBox["i", "TI"], 
           RowBox[{"(", 
             StyleBox["t", "TI"], ")"}]]], " ", 
         SubscriptBox[
          StyleBox["h", "TI"], 
          StyleBox["i", "TI"]], " ", 
         SubsuperscriptBox["\[Theta]", 
          StyleBox["i", "TI"], 
          RowBox[{"(", 
            StyleBox["t", "TI"], ")"}]]}], TraditionalForm], "errors" -> {}, 
     "input" -> 
     "\\theta_i^{(t+1)} = \\theta_i^{(t)} - \\eta\\, r_t\\, e^{s_i^{(t)}}\\, \
h_i\\, \\theta_i^{(t)}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a47971d9-030a-4abf-a4a2-449f7b49d926"],
 StyleBox["Metric dynamics",
  FontWeight->Bold],
 " (",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["s", "TI"], TraditionalForm], "errors" -> {}, "input" -> "s", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "405c60ab-f71d-4292-b531-6732ce4d74f4"],
 ", slow timescale): ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubsuperscriptBox[
          StyleBox["s", "TI"], 
          StyleBox["i", "TI"], 
          RowBox[{"(", 
            RowBox[{
              StyleBox["t", "TI"], "+", "1"}], ")"}]], "\[LongEqual]", 
         RowBox[{"(", 
           RowBox[{"1", "-", "\[Mu]\[Lambda]"}], ")"}], " ", 
         SubsuperscriptBox[
          StyleBox["s", "TI"], 
          StyleBox["i", "TI"], 
          RowBox[{"(", 
            StyleBox["t", "TI"], ")"}]], "+", "\[Mu] ", 
         SubscriptBox[
          StyleBox["D", "TI"], 
          StyleBox["i", "TI"]], 
         RowBox[{"(", 
           SuperscriptBox["\[Theta]", 
            RowBox[{"(", 
              StyleBox["t", "TI"], ")"}]], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "s_i^{(t+1)} = (1-\\mu\\lambda)\\, s_i^{(t)} + \\mu\\, \
D_i(\\theta^{(t)})", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "1f628db4-4adf-46cf-aeb7-a6bf8cb77d3e"],
 "where ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["r", "TI"], 
          StyleBox["t", "TI"]], "\[LongEqual]", "1", "/", 
         RowBox[{"(", 
           RowBox[{"1", "+", "|", 
             SubscriptBox[
              OverscriptBox[
               StyleBox["v", "TI"], "^"], 
              StyleBox["t", "TI"]], "|"}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> "r_t = 1/(1 + |\\hat{v}_t|)", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "86d90307-1e6c-440e-ace9-748b2410ca26"],
 ", ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["v", "TI"], 
          StyleBox["t", "TI"]], "\[LongEqual]", "\[Xi]", 
         UnderscriptBox["\[Sum]", 
          StyleBox["k", "TI"], LimitsPositioning -> True], 
         SuperscriptBox[
          StyleBox["e", "TI"], 
          SubscriptBox[
           StyleBox["s", "TI"], 
           StyleBox["k", "TI"]]], 
         SubsuperscriptBox[
          StyleBox["h", "TI"], 
          StyleBox["k", "TI"], "2"], 
         SubsuperscriptBox["\[Theta]", 
          StyleBox["k", "TI"], "2"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "v_t = \\xi \\sum_k e^{s_k} h_k^2 \\theta_k^2", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "00079ad8-a06c-47af-9b5c-b8c126e16478"],
 ", and $D_i$ is the driving force. "
}], "Text",ExpressionUUID->"bae03ac5-28ce-4254-8c5a-0b4a8571bea4"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Clear", "[", "\"\<Global`*\>\"", "]"}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", "Denominator", " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"r", "[", 
     RowBox[{
     "theta1_", ",", "theta2_", ",", "s1_", ",", "s2_", ",", "xi_", ",", 
      "h1_", ",", "h2_"}], "]"}], ":=", "\[IndentingNewLine]", "  ", 
    RowBox[{"1", "/", 
     RowBox[{"(", 
      RowBox[{"1", "+", 
       RowBox[{"xi", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"Exp", "[", "s1", "]"}], " ", 
           RowBox[{"h1", "^", "2"}], " ", 
           RowBox[{"theta1", "^", "2"}]}], "+", 
          RowBox[{
           RowBox[{"Exp", "[", "s2", "]"}], " ", 
           RowBox[{"h2", "^", "2"}], " ", 
           RowBox[{"theta2", "^", "2"}]}]}], ")"}]}]}], ")"}]}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"theta", "-", 
    RowBox[{"dynamics", ":", " ", 
     RowBox[{"continuous", "-", 
      RowBox[{"time", " ", "RHS"}]}]}]}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"fTheta1", "[", 
    RowBox[{
    "theta1_", ",", "theta2_", ",", "s1_", ",", "s2_", ",", "eta_", ",", 
     "xi_", ",", "h1_", ",", "h2_"}], "]"}], ":=", "\[IndentingNewLine]", 
   "  ", 
   RowBox[{
    RowBox[{"-", "eta"}], " ", 
    RowBox[{"r", "[", 
     RowBox[{
     "theta1", ",", "theta2", ",", "s1", ",", "s2", ",", "xi", ",", "h1", ",",
       "h2"}], "]"}], " ", 
    RowBox[{"Exp", "[", "s1", "]"}], " ", "h1", " ", "theta1"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"fTheta2", "[", 
     RowBox[{
     "theta1_", ",", "theta2_", ",", "s1_", ",", "s2_", ",", "eta_", ",", 
      "xi_", ",", "h1_", ",", "h2_"}], "]"}], ":=", "\[IndentingNewLine]", 
    "  ", 
    RowBox[{
     RowBox[{"-", "eta"}], " ", 
     RowBox[{"r", "[", 
      RowBox[{
      "theta1", ",", "theta2", ",", "s1", ",", "s2", ",", "xi", ",", "h1", ",",
        "h2"}], "]"}], " ", 
     RowBox[{"Exp", "[", "s2", "]"}], " ", "h2", " ", "theta2"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"s", "-", 
    RowBox[{"dynamics", ":", " ", 
     RowBox[{"Newton", "-", "targeted"}]}]}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"gNewtonS1", "[", 
    RowBox[{"s1_", ",", "mu_", ",", "lam_", ",", "h1_"}], "]"}], ":=", 
   RowBox[{"mu", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "lam"}], " ", 
       RowBox[{"Log", "[", "h1", "]"}]}], "-", 
      RowBox[{"lam", " ", "s1"}]}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"gNewtonS2", "[", 
     RowBox[{"s2_", ",", "mu_", ",", "lam_", ",", "h2_"}], "]"}], ":=", 
    RowBox[{"mu", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "lam"}], " ", 
        RowBox[{"Log", "[", "h2", "]"}]}], "-", 
       RowBox[{"lam", " ", "s2"}]}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"s", "-", 
    RowBox[{"dynamics", ":", " ", 
     RowBox[{
      RowBox[{"base", " ", "gradient"}], "-", 
      RowBox[{"magnitude", " ", "rule"}]}]}]}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"gBaseS1", "[", 
    RowBox[{
    "theta1_", ",", "s1_", ",", "mu_", ",", "xi_", ",", "lam_", ",", "h1_"}], 
    "]"}], ":=", 
   RowBox[{"mu", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"xi", " ", 
       RowBox[{"h1", "^", "2"}], " ", 
       RowBox[{"theta1", "^", "2"}]}], "-", 
      RowBox[{"lam", " ", "s1"}]}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"gBaseS2", "[", 
    RowBox[{
    "theta2_", ",", "s2_", ",", "mu_", ",", "xi_", ",", "lam_", ",", "h2_"}], 
    "]"}], ":=", 
   RowBox[{"mu", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"xi", " ", 
       RowBox[{"h2", "^", "2"}], " ", 
       RowBox[{"theta2", "^", "2"}]}], "-", 
      RowBox[{"lam", " ", "s2"}]}], ")"}]}]}], ";"}]}], "Input",ExpressionUUID\
->"8e19a8d4-0665-4d43-a524-436ac52c965f"],

Cell["2. Equilibrium Analysis", "Section",ExpressionUUID->"cbaedd11-b21e-42de-999f-94c8eb8b4ae8"],

Cell["Newton-targeted equilibrium", "Subsection",ExpressionUUID->"1cfb1257-8953-41f0-a977-036830660329"],

Cell[TextData[{
 "The equilibrium satisfies ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox["\[Theta]", "*"], "\[LongEqual]", "0"}], 
       TraditionalForm], "errors" -> {}, "input" -> "\\theta^* = 0", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "cb336673-dd4e-4626-a697-f50f5b86ba2f"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubsuperscriptBox[
          StyleBox["s", "TI"], 
          StyleBox["i", "TI"], "*"], "\[LongEqual]", "-", "log", 
         SubscriptBox[
          StyleBox["h", "TI"], 
          StyleBox["i", "TI"]], "+", 
         OverscriptBox[
          RowBox[{"log", 
            StyleBox["h", "TI"]}], "_"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "s_i^* = -\\log h_i + \\overline{\\log h}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "bc4bb374-33ec-436b-be2c-11fcc45f4953"],
 " (mean-centered)."
}], "Text",ExpressionUUID->"4cba2f7a-ceb7-4447-8c86-fe066ccad93f"],

Cell["\<\
At the Newton equilibrium, all preconditioned eigenvalues equal the geometric \
mean. \
\>", "Text",ExpressionUUID->"a3c6e6bd-70c5-4227-91e9-d8598d55745d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Newton", " ", "equilibrium", " ", "for", " ", "N"}], "=", "2"}], 
   " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"s1Star", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Log", "[", "h2", "]"}], "-", 
        RowBox[{"Log", "[", "h1", "]"}]}], ")"}], "/", "2"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"s2Star", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Log", "[", "h1", "]"}], "-", 
        RowBox[{"Log", "[", "h2", "]"}]}], ")"}], "/", "2"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"Verify", ":", " ", 
     RowBox[{"exp", 
      RowBox[{"(", "s"}]}]}], "*)"}], " ", 
   RowBox[{"h", "=", 
    RowBox[{"hgeo", " ", "for", " ", "both", " ", "coordinates"}]}]}], " ", 
  "*)"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"result1", "=", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Exp", "[", "s1Star", "]"}], " ", "h1"}], ",", 
     RowBox[{"Assumptions", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"h1", ">", "0"}], ",", 
        RowBox[{"h2", ">", "0"}]}], "}"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"result2", "=", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Exp", "[", "s2Star", "]"}], " ", "h2"}], ",", 
     RowBox[{"Assumptions", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"h1", ">", "0"}], ",", 
        RowBox[{"h2", ">", "0"}]}], "}"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<exp(s1*) h1 = \>\"", ",", "result1"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<exp(s2*) h2 = \>\"", ",", "result2"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Equal: \>\"", ",", 
    RowBox[{"Simplify", "[", 
     RowBox[{
      RowBox[{"result1", "==", "result2"}], ",", 
      RowBox[{"Assumptions", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"h1", ">", "0"}], ",", 
         RowBox[{"h2", ">", "0"}]}], "}"}]}]}], "]"}]}], "]"}], 
  ";"}]}], "Input",ExpressionUUID->"77c68b9a-3165-4ec3-8ee9-98c361d51629"],

Cell["Base rule equilibrium", "Subsection",ExpressionUUID->"0410f6d3-228e-48cf-b5b7-0a65a20dfd11"],

Cell[TextData[{
 "For the base gradient-magnitude rule with ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["D", "TI"], 
          StyleBox["i", "TI"]], "\[LongEqual]", "\[Xi]", 
         SubsuperscriptBox[
          StyleBox["h", "TI"], 
          StyleBox["i", "TI"], "2"], 
         SubsuperscriptBox["\[Theta]", 
          StyleBox["i", "TI"], "2"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "D_i = \\xi h_i^2 \\theta_i^2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0a993745-2a8c-49dc-a6b7-0186452e47a7"],
 ", the equilibrium is ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox["\[Theta]", "*"], "\[LongEqual]", "0"}], 
       TraditionalForm], "errors" -> {}, "input" -> "\\theta^* = 0", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "068bc9b3-230f-468f-b7f0-78c397e3841f"],
 ", ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["s", "TI"], "*"], "\[LongEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "s^* = 0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0015e4ec-fc6e-495d-8c42-2c9d28321fb8"],
 " (identity metric). "
}], "Text",ExpressionUUID->"501cc375-f6f1-4984-9ba5-4ff6d2dec6a9"],

Cell["3. Jacobian at Equilibrium", "Section",ExpressionUUID->"81d7d53e-87a4-44eb-bc57-116573926f2e"],

Cell["Theorem (Block-diagonal Jacobian)", "Subsection",ExpressionUUID->"1dbda1af-f8b1-4570-b148-30073c8398d6"],

Cell[TextData[{
 "At any equilibrium of the coupled system on a diagonal quadratic, the \
Jacobian is ",
 StyleBox["block diagonal",
  FontWeight->Bold],
 ". The ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Theta]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\theta", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "cabaa391-2991-4146-8e55-93a601d38866"],
 "-",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["s", "TI"], TraditionalForm], "errors" -> {}, "input" -> "s", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a7a6f72f-8e6d-44c8-a961-45c2b5f7fbd8"],
 " coupling vanishes because ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox["\[Theta]", "*"], "\[LongEqual]", "0"}], 
       TraditionalForm], "errors" -> {}, "input" -> "\\theta^* = 0", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ae03f2ff-fcf5-416a-878a-1ec1ebd28e06"],
 ". "
}], "Text",ExpressionUUID->"89e24f02-e638-4097-bed2-f488707bcf74"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"NEWTON", "-", 
    RowBox[{"TARGETED", ":", " ", 
     RowBox[{"Jacobian", " ", "at", " ", "equilibrium"}]}]}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"stateVars", "=", 
     RowBox[{"{", 
      RowBox[{"theta1", ",", "theta2", ",", "s1", ",", "s2"}], "}"}]}], ";"}],
    "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"rhsNewton", "=", 
     RowBox[{"{", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"fTheta1", "[", 
        RowBox[{
        "theta1", ",", "theta2", ",", "s1", ",", "s2", ",", "eta", ",", "xi", 
         ",", "h1", ",", "h2"}], "]"}], ",", "\[IndentingNewLine]", "  ", 
       RowBox[{"fTheta2", "[", 
        RowBox[{
        "theta1", ",", "theta2", ",", "s1", ",", "s2", ",", "eta", ",", "xi", 
         ",", "h1", ",", "h2"}], "]"}], ",", "\[IndentingNewLine]", "  ", 
       RowBox[{"gNewtonS1", "[", 
        RowBox[{"s1", ",", "mu", ",", "lam", ",", "h1"}], "]"}], ",", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"gNewtonS2", "[", 
        RowBox[{"s2", ",", "mu", ",", "lam", ",", "h2"}], "]"}]}], 
      "\[IndentingNewLine]", "}"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"jacobNewton", "=", 
