}], "Text",ExpressionUUID->"5008769e-9f8d-4816-8d8c-cb983ef931ea"],

Cell["4. Block-Triangular Structure (General Smooth Loss)", "Section",ExpressionUUID->"95f2f364-a74d-415e-bebd-eeb5a85bffa3"],

Cell[TextData[{
 "For general smooth loss near a minimum ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox["\[Theta]", "*"], TraditionalForm], "errors" -> {}, 
     "input" -> "\\theta^*", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f9e448d0-8ccf-4fcb-a94e-a110b75ec627"],
 " with Hessian ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["H", "TI"], "*"], "\[LongEqual]", 
         StyleBox["H", "TI"], 
         RowBox[{"(", 
           SuperscriptBox["\[Theta]", "*"], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> "H^* = H(\\theta^*)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0d48c7c1-16b1-477a-ac6a-6e2aadd16eba"],
 ", the Jacobian has ",
