   "\[IndentingNewLine]", "  ", 
   RowBox[{"{", 
    RowBox[{"rv", ",", 
     RowBox[{"{", 
      RowBox[{
      "0.01", ",", "0.1", ",", "1", ",", "10", ",", "100", ",", "1000"}], 
      "}"}]}], "}"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"(*", "\n", 
   RowBox[{
    RowBox[{
    "0.01", "     ", "1.0000", "   ", "1.0000", "   ", "1.0000", "   ", 
     "1.0000", "\n", "0.1", "      ", "0.9991", "   ", "0.9999", "   ", 
     "1.0000", "   ", "1.0000", "\n", "1", "        ", "0.9182", "   ", 
     "0.9902", "   ", "0.9990", "   ", "0.9999", "\n", "10", "       ", 
     "0.1818", "   ", "0.5050", "   ", "0.9092", "   ", "0.9901", "\n", "100",
      "      ", "0.1009", "   ", "0.0198", "   ", "0.0918", "   ", "0.5001", "\n",
      "1000", "     ", "0.1000", "   ", "0.0101", "   ", "0.0020", "   ", 
     "0.0100", "\n", "Minimum", " ", "at", " ", 
     RowBox[{"theta1", "/", "theta2"}]}], " ", "=", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"sqrt", 
       RowBox[{"(", "kappa", ")"}]}], ":", " ", "ratio"}], " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"kappa", "+", "1"}], ")"}], "/", 
