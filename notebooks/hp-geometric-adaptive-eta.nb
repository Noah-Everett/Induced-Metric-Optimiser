Cell["7. Effect of beta_s on Convergence", "Section",ExpressionUUID->"f8feeae2-9b3e-4f7f-aa02-56afbe4f4833"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<=== beta_s sweep: N=10, kappa=1000 ===\>\"", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"nn", "=", "10"}], ";", " ", 
  RowBox[{"hvec", "=", 
   RowBox[{"N", "[", 
    RowBox[{"10", "^", 
     RowBox[{"Range", "[", 
      RowBox[{"0.", ",", "3.", ",", 
       RowBox[{"3.", "/", 
        RowBox[{"(", 
         RowBox[{"nn", "-", "1"}], ")"}]}]}], "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SeedRandom", "[", "42", "]"}], ";", " ", 
  RowBox[{"theta0", "=", 
   RowBox[{"RandomVariate", "[", 
    RowBox[{
     RowBox[{"NormalDistribution", "[", 
      RowBox[{"0", ",", "1"}], "]"}], ",", "nn"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Do", "[", "\[IndentingNewLine]", "  ", 
  RowBox[{
   RowBox[{
    RowBox[{"rSqrt", "=", 
     RowBox[{"runFast", "[", 
      RowBox[{
      "hvec", ",", "theta0", ",", "10.", ",", "5.", ",", "bs", ",", "100000", 
       ",", 
       RowBox[{"10.", "^", 
        RowBox[{"-", "10"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", "  ", 
    RowBox[{"rAdapt", "=", 
     RowBox[{"runAdaptive", "[", 
      RowBox[{"hvec", ",", "theta0", ",", "1.5", ",", "bs", ",", "100000", ",", 
       RowBox[{"10.", "^", 
        RowBox[{"-", "10"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", "  ", 
    RowBox[{"Print", "[", 
     RowBox[{"\"\<betaS=\>\"", ",", "bs", ",", "\"\<: sqrt=\>\"", ",", 
      RowBox[{"rSqrt", "[", 
       RowBox[{"[", "1", "]"}], "]"}], ",", "\"\< adaptive=\>\"", ",", 
      RowBox[{"rAdapt", "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], "]"}]}], ",", "\[IndentingNewLine]", 
   "  ", 
   RowBox[{"{", 
    RowBox[{"bs", ",", 
     RowBox[{"{", 
      RowBox[{
      "0.001", ",", "0.005", ",", "0.01", ",", "0.02", ",", "0.05", ",", 
       "0.1", ",", "0.2", ",", "0.5", ",", "1.0"}], "}"}]}], "}"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"(*", "\n", 
   RowBox[{
    RowBox[{"betaS", "=", 
     RowBox[{
      RowBox[{"0.001", ":", " ", "sqrt"}], "=", 
      RowBox[{
       RowBox[{"641", " ", "adaptive"}], "=", 
       RowBox[{
        RowBox[{"697", "\n", "betaS"}], "=", 
        RowBox[{
         RowBox[{"0.005", ":", " ", "sqrt"}], "=", 
         RowBox[{
          RowBox[{"213", " ", "adaptive"}], "=", 
          RowBox[{
           RowBox[{"227", "\n", "betaS"}], "=", 
           RowBox[{
            RowBox[{"0.01", ":", "  ", "sqrt"}], "=", 
            RowBox[{
             RowBox[{"131", " ", "adaptive"}], "=", 
             RowBox[{
              RowBox[{"137", "\n", "betaS"}], "=", 
              RowBox[{
               RowBox[{"0.02", ":", "  ", "sqrt"}], "=", 
               RowBox[{
                RowBox[{"80", "  ", "adaptive"}], "=", 
                RowBox[{
                 RowBox[{"83", "\n", "betaS"}], "=", 
                 RowBox[{
                  RowBox[{"0.05", ":", "  ", "sqrt"}], "=", 
                  RowBox[{
                   RowBox[{"42", "  ", "adaptive"}], "=", 
                   RowBox[{
                    RowBox[{"42", "\n", "betaS"}], "=", 
                    RowBox[{
                    RowBox[{"0.1", ":", "   ", "sqrt"}], "=", 
                    RowBox[{
                    RowBox[{"26", "  ", "adaptive"}], "=", 
                    RowBox[{
                    RowBox[{"25", "\n", "betaS"}], "=", 
                    RowBox[{
                    RowBox[{"0.2", ":", "   ", "sqrt"}], "=", 
                    RowBox[{
                    RowBox[{"16", "  ", "adaptive"}], "=", 
                    RowBox[{
                    RowBox[{"20", "\n", "betaS"}], "=", 
                    RowBox[{
                    RowBox[{"0.5", ":", "   ", "sqrt"}], "=", 
                    RowBox[{
                    RowBox[{"9", "   ", "adaptive"}], "=", 
                    RowBox[{
                    RowBox[{"20", "\n", "betaS"}], "=", 
                    RowBox[{
                    RowBox[{"1.0", ":", "   ", "sqrt"}], "=", 
                    RowBox[{
                    RowBox[{"4", "   ", "adaptive"}], "=", 
                    RowBox[{"22", "\n", 
                    RowBox[{"Key", ":", " ", 
                    RowBox[{"sqrt", " ", "achieves", " ", "O", 
                    RowBox[{"(", "1", ")"}], " ", "with", " ", "perfect", " ",
                     "metric"}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}\
]}]}]}]}]}], ";", " ", 
    RowBox[{"adaptive", " ", "stuck", " ", 
     RowBox[{"at", " ", "~", "22"}], " ", 
     RowBox[{"steps", "."}]}]}], "\n", "*)"}]}]}], "Input",ExpressionUUID->\
"c9ff220d-fc5e-46fb-ab7e-9158cde1455a"],

Cell["8. Phase 2 Convergence Rates", "Section",ExpressionUUID->"de189abc-a3ea-4dff-beb3-6e8bc09ee5cc"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<Phase 2 contraction rates at Newton equilibrium:\>\"", 
   "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Do", "[", "\[IndentingNewLine]", "  ", 
  RowBox[{
   RowBox[{
    RowBox[{"hgeo", "=", 
     RowBox[{"Sqrt", "[", 
      RowBox[{"N", "[", "kv", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
    "  ", 
    RowBox[{"rhoSqrt", "=", 
     RowBox[{"2.", "/", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"10.", "*", "hgeo"}], "+", "2."}], ")"}]}]}], ";", 
    "\[IndentingNewLine]", "  ", 
    RowBox[{"phase2Sqrt", "=", 
     RowBox[{
      RowBox[{"-", "23."}], "/", 
      RowBox[{"Log", "[", "rhoSqrt", "]"}]}]}], ";", "\[IndentingNewLine]", 
    "  ", 
    RowBox[{"Print", "[", 
     RowBox[{"\"\<kappa=\>\"", ",", "kv", ",", "\"\<: hgeo=\>\"", ",", 
      RowBox[{"NumberForm", "[", 
       RowBox[{"hgeo", ",", 
        RowBox[{"{", 
         RowBox[{"6", ",", "2"}], "}"}]}], "]"}], ",", "\[IndentingNewLine]", 
      "        ", "\"\< rho_sqrt=\>\"", ",", 
      RowBox[{"NumberForm", "[", 
       RowBox[{"rhoSqrt", ",", 
        RowBox[{"{", 
         RowBox[{"5", ",", "4"}], "}"}]}], "]"}], ",", "\[IndentingNewLine]", 
      "        ", "\"\< rho_adapt=0.50\>\"", ",", "\[IndentingNewLine]", 
      "        ", "\"\< phase2_sqrt=\>\"", ",", 
      RowBox[{"NumberForm", "[", 
       RowBox[{"phase2Sqrt", ",", 
        RowBox[{"{", 
         RowBox[{"4", ",", "1"}], "}"}]}], "]"}], ",", "\[IndentingNewLine]", 
      "        ", "\"\< phase2_adapt=33.2\>\""}], "]"}]}], ",", 
   "\[IndentingNewLine]", "  ", 
   RowBox[{"{", 
    RowBox[{"kv", ",", 
     RowBox[{"{", 
      RowBox[{"10", ",", "100", ",", "1000", ",", "10000"}], "}"}]}], "}"}]}],
   "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"(*", "\n", 
   RowBox[{"kappa", "=", 
    RowBox[{
     RowBox[{"10", ":", "    ", "hgeo"}], "=", 
     RowBox[{
      RowBox[{"3.16", "   ", "rho_sqrt"}], "=", 
      RowBox[{
       RowBox[{"0.0595", "  ", "rho_adapt"}], "=", 
       RowBox[{
        RowBox[{"0.50", "  ", "phase2_sqrt"}], "=", 
        RowBox[{
         RowBox[{"8.2", "   ", "phase2_adapt"}], "=", 
         RowBox[{
          RowBox[{"33.2", "\n", "kappa"}], "=", 
          RowBox[{
           RowBox[{"100", ":", "   ", "hgeo"}], "=", 
           RowBox[{
            RowBox[{"10.00", "  ", "rho_sqrt"}], "=", 
            RowBox[{
             RowBox[{"0.0196", "  ", "rho_adapt"}], "=", 
             RowBox[{
              RowBox[{"0.50", "  ", "phase2_sqrt"}], "=", 
              RowBox[{
               RowBox[{"5.8", "   ", "phase2_adapt"}], "=", 
               RowBox[{
                RowBox[{"33.2", "\n", "kappa"}], "=", 
                RowBox[{
                 RowBox[{"1000", ":", "  ", "hgeo"}], "=", 
                 RowBox[{
                  RowBox[{"31.62", "  ", "rho_sqrt"}], "=", 
                  RowBox[{
                   RowBox[{"0.0063", "  ", "rho_adapt"}], "=", 
                   RowBox[{
                    RowBox[{"0.50", "  ", "phase2_sqrt"}], "=", 
                    RowBox[{
                    RowBox[{"4.5", "   ", "phase2_adapt"}], "=", 
                    RowBox[{
                    RowBox[{"33.2", "\n", "kappa"}], "=", 
                    RowBox[{
                    RowBox[{"10000", ":", " ", "hgeo"}], "=", 
                    RowBox[{
                    RowBox[{"100.00", " ", "rho_sqrt"}], "=", 
                    RowBox[{
                    RowBox[{"0.0020", "  ", "rho_adapt"}], "=", 
                    RowBox[{
                    RowBox[{"0.50", "  ", "phase2_sqrt"}], "=", 
                    RowBox[{
                    RowBox[{"3.7", "   ", "phase2_adapt"}], "=", 
                    "33.2"}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}], 
   "\n", "*)"}]}]}], "Input",ExpressionUUID->"c089cd72-d6a3-4513-84f7-\
cd3c885008d1"],

Cell["9. Stability Guards", "Section",ExpressionUUID->"00afdae7-b817-4714-b343-2af65e8941c6"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"runFastClip", "[", 
     RowBox[{
     "hvec_List", ",", "theta0_List", ",", "xi_", ",", "eta_", ",", "betaS_", 
      ",", "maxEtaEff_", ",", "maxSteps_", ",", "tol_"}], "]"}], ":=", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "theta", ",", "svec", ",", "n", ",", "loss", ",", "ewl", ",", "denom", 
        ",", "etaEff", ",", "sTarget", ",", "fStep", ",", "fLoss", ",", 
        "conv"}], "}"}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"n", "=", 
        RowBox[{"Length", "[", "theta0", "]"}]}], ";", " ", 
       RowBox[{"theta", "=", 
        RowBox[{"N", "[", "theta0", "]"}]}], ";", " ", 
       RowBox[{"svec", "=", 
        RowBox[{"ConstantArray", "[", 
         RowBox[{"0.", ",", "n"}], "]"}]}], ";", "\[IndentingNewLine]", "  ", 
       
       RowBox[{"fStep", "=", "maxSteps"}], ";", " ", 
       RowBox[{"fLoss", "=", "0."}], ";", " ", 
       RowBox[{"conv", "=", "False"}], ";", "\[IndentingNewLine]", "  ", 
       RowBox[{"Do", "[", "\[IndentingNewLine]", "    ", 
        RowBox[{
         RowBox[{
          RowBox[{"loss", "=", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"1", "/", "2"}], ")"}], " ", 
            RowBox[{"Total", "[", 
             RowBox[{"hvec", "*", 
              RowBox[{"theta", "^", "2"}]}], "]"}]}]}], ";", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"loss", "<", "tol"}], ",", 
            RowBox[{
             RowBox[{"fStep", "=", 
              RowBox[{"step", "-", "1"}]}], ";", " ", 
             RowBox[{"fLoss", "=", "loss"}], ";", " ", 
             RowBox[{"conv", "=", "True"}], ";", " ", 
             RowBox[{"Break", "[", "]"}]}]}], "]"}], ";", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"!", 
              RowBox[{"NumberQ", "[", "loss", "]"}]}], "||", 
             RowBox[{
              RowBox[{"Abs", "[", "loss", "]"}], ">", 
              RowBox[{"10.", "^", "20"}]}]}], ",", 
            RowBox[{
             RowBox[{"fStep", "=", "step"}], ";", " ", 
             RowBox[{"fLoss", "=", "loss"}], ";", " ", 
             RowBox[{"Break", "[", "]"}]}]}], "]"}], ";", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"loss", "<", 
             RowBox[{"10.", "^", 
              RowBox[{"-", "30"}]}]}], ",", 
            RowBox[{"ewl", "=", 
             RowBox[{"Mean", "[", 
              RowBox[{
               RowBox[{"Exp", "[", "svec", "]"}], "*", "hvec"}], "]"}]}], ",",
             "\[IndentingNewLine]", "       ", 
            RowBox[{"ewl", "=", 
             RowBox[{
              RowBox[{"Total", "[", 
               RowBox[{
                RowBox[{"hvec", "^", "2"}], "*", 
                RowBox[{"theta", "^", "2"}], "*", 
                RowBox[{"Exp", "[", "svec", "]"}]}], "]"}], "/", 
              RowBox[{"Total", "[", 
               RowBox[{"hvec", "*", 
                RowBox[{"theta", "^", "2"}]}], "]"}]}]}]}], "]"}], ";", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"denom", "=", 
           RowBox[{"1", "+", 
            RowBox[{"xi", "*", 
             RowBox[{"ewl", "/", "2"}]}]}]}], ";", " ", 
          RowBox[{"etaEff", "=", 
           RowBox[{"Min", "[", 
            RowBox[{
             RowBox[{"eta", "/", "denom"}], ",", "maxEtaEff"}], "]"}]}], ";", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"theta", "=", 
           RowBox[{"theta", "*", 
            RowBox[{"(", 
             RowBox[{"1", "-", 
              RowBox[{"etaEff", "*", 
               RowBox[{"Exp", "[", "svec", "]"}], "*", "hvec"}]}], ")"}]}]}], 
          ";", "\[IndentingNewLine]", "    ", 
          RowBox[{"sTarget", "=", 
           RowBox[{"-", 
            RowBox[{"Log", "[", "hvec", "]"}]}]}], ";", " ", 
          RowBox[{"svec", "=", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"1", "-", "betaS"}], ")"}], "*", "svec"}], "+", 
            RowBox[{"betaS", "*", "sTarget"}]}]}], ";", " ", 
          RowBox[{"svec", "=", 
           RowBox[{"svec", "-", 
            RowBox[{"Mean", "[", "svec", "]"}]}]}]}], ",", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"{", 
          RowBox[{"step", ",", "1", ",", "maxSteps"}], "}"}]}], "]"}], ";", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"!", "conv"}], "&&", 
          RowBox[{"fStep", "==", "maxSteps"}]}], ",", 
         RowBox[{
          RowBox[{"fLoss", "=", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"1", "/", "2"}], ")"}], " ", 
            RowBox[{"Total", "[", 
             RowBox[{"hvec", "*", 
              RowBox[{"theta", "^", "2"}]}], "]"}]}]}], ";", " ", 
          RowBox[{"conv", "=", 
           RowBox[{"fLoss", "<", "tol"}]}]}]}], "]"}], ";", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"{", 
        RowBox[{"fStep", ",", "fLoss", ",", "conv"}], "}"}]}]}], "]"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"hvec", "=", 
   RowBox[{"{", 
    RowBox[{"1.", ",", "10000."}], "}"}]}], ";", " ", 
  RowBox[{"th0", "=", 
   RowBox[{"{", 
    RowBox[{"1000.", ",", "0.001"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Base sqrt:      \>\"", ",", 
    RowBox[{
     RowBox[{"runFast", "[", 
      RowBox[{
      "hvec", ",", "th0", ",", "10.", ",", "5.", ",", "0.01", ",", "100000", ",", 
       RowBox[{"10.", "^", 
        RowBox[{"-", "10"}]}]}], "]"}], "[", 
     RowBox[{"[", "1", "]"}], "]"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Clip(0.1):      \>\"", ",", 
    RowBox[{
     RowBox[{"runFastClip", "[", 
      RowBox[{
      "hvec", ",", "th0", ",", "10.", ",", "5.", ",", "0.01", ",", "0.1", ",",
        "100000", ",", 
       RowBox[{"10.", "^", 
        RowBox[{"-", "10"}]}]}], "]"}], "[", 
     RowBox[{"[", "1", "]"}], "]"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Clip(2/hmax):   \>\"", ",", 
    RowBox[{
     RowBox[{"runFastClip", "[", 
      RowBox[{"hvec", ",", "th0", ",", "10.", ",", "5.", ",", "0.01", ",", 
       RowBox[{"2.", "/", "10000."}], ",", "100000", ",", 
       RowBox[{"10.", "^", 
        RowBox[{"-", "10"}]}]}], "]"}], "[", 
     RowBox[{"[", "1", "]"}], "]"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Adaptive:       \>\"", ",", 
    RowBox[{
     RowBox[{"runAdaptive", "[", 
      RowBox[{"hvec", ",", "th0", ",", "1.5", ",", "0.01", ",", "100000", ",", 
       RowBox[{"10.", "^", 
        RowBox[{"-", "10"}]}]}], "]"}], "[", 
     RowBox[{"[", "1", "]"}], "]"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"(*", "\n", 
   RowBox[{"Base", " ", 
    RowBox[{"sqrt", ":", "      ", 
     RowBox[{"118", "\n", "Clip", 
      RowBox[{"(", "0.1", ")"}]}], ":", "      ", 
     RowBox[{"97", "\n", "Clip", 
      RowBox[{"(", 
       RowBox[{"2", "/", "hmax"}], ")"}]}], ":", "   ", 
     RowBox[{"1106", "\n", "Adaptive"}], ":", "       ", "185"}]}], "\n", 
   "*)"}]}]}], "Input",ExpressionUUID->"473fa67b-d838-474d-90cf-f21f94b4617a"],

Cell["10. Conclusions", "Section",ExpressionUUID->"ecb70fbd-5907-4ca5-a313-b8c2959b9366"],

Cell["\<\
The sqrt embedding f(L) = sqrt(L) is the unique power-law embedding producing\
\
\>", "Text",ExpressionUUID->"880add84-89ec-447a-af83-1d607b066c3f"],

Cell["an L-independent denominator. With eta = xi/2, it achieves: ", "Text",ExpressionUUID->"622b922e-23ff-47c0-bd34-ac2441d5197e"],

Cell["\<\
O(1) convergence for balanced N=2 init (step count DECREASES with kappa)\
\>", "Item",ExpressionUUID->"40db1725-1d8b-4364-8d75-aff702e27712"],

Cell["\<\
O(log kappa) for N=10 random init, 7-10% faster than adaptive baseline\
\>", "Item",ExpressionUUID->"b20860ec-feff-459d-a224-403006fa9e80"],

Cell["\<\
O(1) with perfect metric (beta_s=1): 4 steps vs adaptive's 22\
\>", "Item",ExpressionUUID->"25576ec4-c4f4-4907-8020-d9c309ea35dd"],

Cell["Near-Newton Phase 2: contraction rate 2/(xi*h_geo+2) -> 0", "Item",ExpressionUUID->"2b661687-2fee-443c-bab2-8ca4f138afb7"],

Cell["NO DIVERGENCE for any tested adversarial initialization", "Item",ExpressionUUID->"7b1c8f0a-f9c3-4436-808b-ad66319cb244"],

Cell["\<\
The practical advantage at realistic beta_s is modest (7-10%).\
\>", "Text",ExpressionUUID->"3c49b277-1439-4604-ae5d-14b861ad5355"],

Cell["\<\
The theoretical advantage (unique geometric derivation of adaptive step \
sizing) is clear.\
\>", "Text",ExpressionUUID->"8c4a90bb-3aa6-4b57-968f-4675fe8ba394"]
},
