Cell["5. Random Initialization Ensemble (N=10, 100 trials)", "Section",ExpressionUUID->"429282de-79fe-45d0-817a-6aa1139eb6a5"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<=== Random init ensemble: N=10, 100 trials, theta0 ~ \
N(0,1) ===\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Do", "[", "\[IndentingNewLine]", "  ", 
  RowBox[{
   RowBox[{
    RowBox[{"nn", "=", "10"}], ";", "\[IndentingNewLine]", "  ", 
    RowBox[{"hvec", "=", 
     RowBox[{"N", "[", 
      RowBox[{"10", "^", 
       RowBox[{"Range", "[", 
        RowBox[{"0.", ",", 
         RowBox[{"Log10", "[", "kv", "]"}], ",", 
         RowBox[{
          RowBox[{"Log10", "[", "kv", "]"}], "/", 
          RowBox[{"(", 
           RowBox[{"nn", "-", "1"}], ")"}]}]}], "]"}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", "  ", 
    RowBox[{"SeedRandom", "[", "42", "]"}], ";", "\[IndentingNewLine]", "  ", 
    
    RowBox[{"theta0s", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"RandomVariate", "[", 
        RowBox[{
         RowBox[{"NormalDistribution", "[", 
          RowBox[{"0", ",", "1"}], "]"}], ",", "nn"}], "]"}], ",", 
       RowBox[{"{", "100", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", "  ", 
    RowBox[{"sqrtRes", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"runFast", "[", 
        RowBox[{"hvec", ",", 
         RowBox[{"theta0s", "[", 
          RowBox[{"[", "i", "]"}], "]"}], ",", "10.", ",", "5.", ",", "0.01", 
         ",", "50000", ",", 
         RowBox[{"10.", "^", 
          RowBox[{"-", "10"}]}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "100"}], "}"}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", "  ", 
    RowBox[{"adaptRes", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"runAdaptive", "[", 
        RowBox[{"hvec", ",", 
         RowBox[{"theta0s", "[", 
          RowBox[{"[", "i", "]"}], "]"}], ",", "1.5", ",", "0.01", ",", 
         "50000", ",", 
         RowBox[{"10.", "^", 
          RowBox[{"-", "10"}]}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "100"}], "}"}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", "  ", 
    RowBox[{"sqrtConv", "=", 
     RowBox[{"Select", "[", 
      RowBox[{"sqrtRes", ",", 
       RowBox[{
        RowBox[{"#", "[", 
         RowBox[{"[", "3", "]"}], "]"}], "&"}]}], "]"}]}], ";", " ", 
    RowBox[{"adaptConv", "=", 
     RowBox[{"Select", "[", 
      RowBox[{"adaptRes", ",", 
       RowBox[{
        RowBox[{"#", "[", 
         RowBox[{"[", "3", "]"}], "]"}], "&"}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", "  ", 
    RowBox[{"Print", "[", 
     RowBox[{"\"\<kappa=\>\"", ",", "kv", ",", "\"\<: sqrt mean=\>\"", ",", 
      RowBox[{"Round", "@", 
       RowBox[{"Mean", "[", 
        RowBox[{"sqrtConv", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "1"}], "]"}], "]"}], "]"}]}], ",", 
      "\[IndentingNewLine]", "        ", "\"\< adaptive mean=\>\"", ",", 
      RowBox[{"Round", "@", 
       RowBox[{"Mean", "[", 
        RowBox[{"adaptConv", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "1"}], "]"}], "]"}], "]"}]}], ",", 
      "\[IndentingNewLine]", "        ", "\"\< sqrt conv=\>\"", ",", 
      RowBox[{"Length", "[", "sqrtConv", "]"}], ",", "\"\</100\>\"", ",", 
      "\[IndentingNewLine]", "        ", "\"\< adapt conv=\>\"", ",", 
      RowBox[{"Length", "[", "adaptConv", "]"}], ",", "\"\</100\>\""}], 
     "]"}]}], ",", "\[IndentingNewLine]", "  ", 
   RowBox[{"{", 
    RowBox[{"kv", ",", 
     RowBox[{"{", 
      RowBox[{
      "10", ",", "30", ",", "100", ",", "300", ",", "1000", ",", "3000", ",", 
       "10000"}], "}"}]}], "}"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"(*", "\n", 
   RowBox[{
    RowBox[{"kappa", "=", 
     RowBox[{
      RowBox[{"10", ":", " ", 
       RowBox[{"sqrt", " ", "mean"}]}], "=", 
      RowBox[{
       RowBox[{"37", " ", "adaptive", " ", "mean"}], "=", 
       RowBox[{
        RowBox[{"41", " ", "sqrt", " ", "conv"}], "=", 
        RowBox[{
         RowBox[{
          RowBox[{"100", "/", "100"}], " ", "adapt", " ", "conv"}], "=", 
         RowBox[{
          RowBox[{
           RowBox[{"100", "/", "100"}], "\n", "kappa"}], "=", 
          RowBox[{
           RowBox[{"30", ":", " ", 
            RowBox[{"sqrt", " ", "mean"}]}], "=", 
           RowBox[{
            RowBox[{"62", " ", "adaptive", " ", "mean"}], "=", 
            RowBox[{
             RowBox[{"69", " ", "sqrt", " ", "conv"}], "=", 
             RowBox[{
              RowBox[{
               RowBox[{"100", "/", "100"}], " ", "adapt", " ", "conv"}], "=", 
              
              RowBox[{
               RowBox[{
                RowBox[{"100", "/", "100"}], "\n", "kappa"}], "=", 
               RowBox[{
                RowBox[{"100", ":", " ", 
                 RowBox[{"sqrt", " ", "mean"}]}], "=", 
                RowBox[{
