Cell["1.4 Newton equilibrium property", "Subsection",ExpressionUUID->"d5554612-b028-43da-bd4e-d59675c0e931"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"At", " ", 
     RowBox[{"equilibrium", ":", " ", 
      RowBox[{
       RowBox[{"e", "^", 
        RowBox[{"{", "s_i", "}"}]}], " ", "h_i"}]}]}], " ", "=", " ", 
    RowBox[{"hgeo", " ", "for", " ", "all", " ", "i"}]}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"hgeo", "=", 
   RowBox[{"Sqrt", "[", "kappa", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"w1", "=", 
   RowBox[{
    RowBox[{"th1", "^", "2"}], "/", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"th1", "^", "2"}], "+", 
      RowBox[{"kappa", " ", 
       RowBox[{"th2", "^", "2"}]}]}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"w2", "=", 
   RowBox[{"kappa", " ", 
    RowBox[{
     RowBox[{"th2", "^", "2"}], "/", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"th1", "^", "2"}], "+", 
       RowBox[{"kappa", " ", 
        RowBox[{"th2", "^", "2"}]}]}], ")"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{"w1", "*", "hgeo"}], "+", 
   RowBox[{"w2", "*", "hgeo"}], "-", "hgeo"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Output", ":", " ", 
     RowBox[{
      RowBox[{"0", " ", "--"}], " ", 
      RowBox[{"E_w", "[", "lambda", "]"}]}]}], " ", "=", " ", 
    RowBox[{
    "h_geo", " ", "at", " ", "equilibrium", " ", "regardless", " ", "of", " ",
      "theta"}]}], " ", "*)"}]}]}], "Input",ExpressionUUID->"61f39f78-02ba-\
4bd6-8c4f-319739e9fe15"],

Cell["2. Optimizer Definition", "Section",ExpressionUUID->"7837d30b-4508-4116-9329-277d0cb54587"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"runFast", "[", 
     RowBox[{
     "hvec_List", ",", "theta0_List", ",", "xi_", ",", "eta_", ",", "betaS_", 
      ",", "maxSteps_", ",", "tol_"}], "]"}], ":=", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "theta", ",", "svec", ",", "n", ",", "loss", ",", "ewl", ",", "denom", 
        ",", "etaEff", ",", "sTarget", ",", "fStep", ",", "fLoss", ",", 
        "conv"}], "}"}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"n", "=", 
        RowBox[{"Length", "[", "theta0", "]"}]}], ";", " ", 
       RowBox[{"theta", "=", 
        RowBox[{"N", "[", "theta0", "]"}]}], ";", " ", 
       RowBox[{"svec", "=", 
        RowBox[{"ConstantArray", "[", 
         RowBox[{"0.", ",", "n"}], "]"}]}], ";", "\[IndentingNewLine]", "  ", 
       
       RowBox[{"fStep", "=", "maxSteps"}], ";", " ", 
       RowBox[{"fLoss", "=", "0."}], ";", " ", 
       RowBox[{"conv", "=", "False"}], ";", "\[IndentingNewLine]", "  ", 
       RowBox[{"Do", "[", "\[IndentingNewLine]", "    ", 
        RowBox[{
         RowBox[{
          RowBox[{"loss", "=", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"1", "/", "2"}], ")"}], " ", 
            RowBox[{"Total", "[", 
             RowBox[{"hvec", "*", 
              RowBox[{"theta", "^", "2"}]}], "]"}]}]}], ";", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"loss", "<", "tol"}], ",", 
            RowBox[{
             RowBox[{"fStep", "=", 
              RowBox[{"step", "-", "1"}]}], ";", " ", 
             RowBox[{"fLoss", "=", "loss"}], ";", " ", 
             RowBox[{"conv", "=", "True"}], ";", " ", 
             RowBox[{"Break", "[", "]"}]}]}], "]"}], ";", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"!", 
              RowBox[{"NumberQ", "[", "loss", "]"}]}], "||", 
             RowBox[{
              RowBox[{"Abs", "[", "loss", "]"}], ">", 
              RowBox[{"10.", "^", "20"}]}]}], ",", 
            RowBox[{
             RowBox[{"fStep", "=", "step"}], ";", " ", 
             RowBox[{"fLoss", "=", "loss"}], ";", " ", 
             RowBox[{"Break", "[", "]"}]}]}], "]"}], ";", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"loss", "<", 
             RowBox[{"10.", "^", 
              RowBox[{"-", "30"}]}]}], ",", 
            RowBox[{"ewl", "=", 
             RowBox[{"Mean", "[", 
              RowBox[{
               RowBox[{"Exp", "[", "svec", "]"}], "*", "hvec"}], "]"}]}], ",",
             "\[IndentingNewLine]", "       ", 
            RowBox[{"ewl", "=", 
             RowBox[{
              RowBox[{"Total", "[", 
               RowBox[{
                RowBox[{"hvec", "^", "2"}], "*", 
                RowBox[{"theta", "^", "2"}], "*", 
                RowBox[{"Exp", "[", "svec", "]"}]}], "]"}], "/", 
              RowBox[{"Total", "[", 
               RowBox[{"hvec", "*", 
                RowBox[{"theta", "^", "2"}]}], "]"}]}]}]}], "]"}], ";", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"denom", "=", 
           RowBox[{"1", "+", 
            RowBox[{"xi", "*", 
             RowBox[{"ewl", "/", "2"}]}]}]}], ";", " ", 
          RowBox[{"etaEff", "=", 
           RowBox[{"eta", "/", "denom"}]}], ";", "\[IndentingNewLine]", 
          "    ", 
          RowBox[{"theta", "=", 
           RowBox[{"theta", "*", 
            RowBox[{"(", 
             RowBox[{"1", "-", 
              RowBox[{"etaEff", "*", 
               RowBox[{"Exp", "[", "svec", "]"}], "*", "hvec"}]}], ")"}]}]}], 
          ";", "\[IndentingNewLine]", "    ", 
          RowBox[{"sTarget", "=", 
           RowBox[{"-", 
            RowBox[{"Log", "[", "hvec", "]"}]}]}], ";", " ", 
          RowBox[{"svec", "=", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"1", "-", "betaS"}], ")"}], "*", "svec"}], "+", 
            RowBox[{"betaS", "*", "sTarget"}]}]}], ";", " ", 
          RowBox[{"svec", "=", 
           RowBox[{"svec", "-", 
            RowBox[{"Mean", "[", "svec", "]"}]}]}]}], ",", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"{", 
          RowBox[{"step", ",", "1", ",", "maxSteps"}], "}"}]}], "]"}], ";", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"!", "conv"}], "&&", 
          RowBox[{"fStep", "==", "maxSteps"}]}], ",", 
         RowBox[{
          RowBox[{"fLoss", "=", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"1", "/", "2"}], ")"}], " ", 
            RowBox[{"Total", "[", 
             RowBox[{"hvec", "*", 
              RowBox[{"theta", "^", "2"}]}], "]"}]}]}], ";", " ", 
          RowBox[{"conv", "=", 
           RowBox[{"fLoss", "<", "tol"}]}]}]}], "]"}], ";", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"{", 
        RowBox[{"fStep", ",", "fLoss", ",", "conv"}], "}"}]}]}], "]"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"runAdaptive", "[", 
    RowBox[{
    "hvec_List", ",", "theta0_List", ",", "c_", ",", "betaS_", ",", 
     "maxSteps_", ",", "tol_"}], "]"}], ":=", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "theta", ",", "svec", ",", "n", ",", "loss", ",", "lambdas", ",", 
       "maxLam", ",", "etaAdapt", ",", "sTarget", ",", "fStep", ",", "fLoss", 
       ",", "conv"}], "}"}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"n", "=", 
       RowBox[{"Length", "[", "theta0", "]"}]}], ";", " ", 
      RowBox[{"theta", "=", 
       RowBox[{"N", "[", "theta0", "]"}]}], ";", " ", 
      RowBox[{"svec", "=", 
       RowBox[{"ConstantArray", "[", 
        RowBox[{"0.", ",", "n"}], "]"}]}], ";", "\[IndentingNewLine]", "  ", 
      RowBox[{"fStep", "=", "maxSteps"}], ";", " ", 
      RowBox[{"fLoss", "=", "0."}], ";", " ", 
      RowBox[{"conv", "=", "False"}], ";", "\[IndentingNewLine]", "  ", 
      RowBox[{"Do", "[", "\[IndentingNewLine]", "    ", 
       RowBox[{
        RowBox[{
         RowBox[{"loss", "=", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", "/", "2"}], ")"}], " ", 
           RowBox[{"Total", "[", 
            RowBox[{"hvec", "*", 
             RowBox[{"theta", "^", "2"}]}], "]"}]}]}], ";", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"loss", "<", "tol"}], ",", 
           RowBox[{
            RowBox[{"fStep", "=", 
             RowBox[{"step", "-", "1"}]}], ";", " ", 
            RowBox[{"fLoss", "=", "loss"}], ";", " ", 
            RowBox[{"conv", "=", "True"}], ";", " ", 
            RowBox[{"Break", "[", "]"}]}]}], "]"}], ";", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"!", 
             RowBox[{"NumberQ", "[", "loss", "]"}]}], "||", 
            RowBox[{
             RowBox[{"Abs", "[", "loss", "]"}], ">", 
             RowBox[{"10.", "^", "20"}]}]}], ",", 
           RowBox[{
            RowBox[{"fStep", "=", "step"}], ";", " ", 
            RowBox[{"fLoss", "=", "loss"}], ";", " ", 
            RowBox[{"Break", "[", "]"}]}]}], "]"}], ";", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"lambdas", "=", 
          RowBox[{
           RowBox[{"Exp", "[", "svec", "]"}], "*", "hvec"}]}], ";", " ", 
         RowBox[{"maxLam", "=", 
          RowBox[{"Max", "[", "lambdas", "]"}]}], ";", "\[IndentingNewLine]", 
         "    ", 
         RowBox[{"etaAdapt", "=", 
          RowBox[{"c", "/", 
           RowBox[{"Max", "[", 
            RowBox[{"maxLam", ",", 
             RowBox[{"10.", "^", 
              RowBox[{"-", "10"}]}]}], "]"}]}]}], ";", "\[IndentingNewLine]", 
         "    ", 
         RowBox[{"theta", "=", 
          RowBox[{"theta", "*", 
           RowBox[{"(", 
            RowBox[{"1", "-", 
             RowBox[{"etaAdapt", "*", 
              RowBox[{"Exp", "[", "svec", "]"}], "*", "hvec"}]}], ")"}]}]}], ";",
          "\[IndentingNewLine]", "    ", 
         RowBox[{"sTarget", "=", 
          RowBox[{"-", 
           RowBox[{"Log", "[", "hvec", "]"}]}]}], ";", " ", 
         RowBox[{"svec", "=", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"1", "-", "betaS"}], ")"}], "*", "svec"}], "+", 
           RowBox[{"betaS", "*", "sTarget"}]}]}], ";", " ", 
         RowBox[{"svec", "=", 
          RowBox[{"svec", "-", 
           RowBox[{"Mean", "[", "svec", "]"}]}]}]}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"{", 
         RowBox[{"step", ",", "1", ",", "maxSteps"}], "}"}]}], "]"}], ";", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"!", "conv"}], "&&", 
         RowBox[{"fStep", "==", "maxSteps"}]}], ",", 
        RowBox[{
         RowBox[{"fLoss", "=", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", "/", "2"}], ")"}], " ", 
           RowBox[{"Total", "[", 
            RowBox[{"hvec", "*", 
             RowBox[{"theta", "^", "2"}]}], "]"}]}]}], ";", " ", 
         RowBox[{"conv", "=", 
          RowBox[{"fLoss", "<", "tol"}]}]}]}], "]"}], ";", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"{", 
       RowBox[{"fStep", ",", "fLoss", ",", "conv"}], "}"}]}]}], "]"}]}], 
  ";"}]}], "Input",ExpressionUUID->"3e016d72-a151-4775-abfa-dec9621ce217"],

