    RowBox[{"(", 
     RowBox[{
      RowBox[{"ha", " ", 
       RowBox[{"ta", "^", "2"}]}], "+", 
      RowBox[{"hb", " ", 
       RowBox[{"tb", "^", "2"}]}], "+", 
      RowBox[{"hc", " ", 
       RowBox[{"tc", "^", "2"}]}]}], ")"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"denomContribExpr", "[", "pp_", "]"}], ":=", 
   RowBox[{
    RowBox[{"pp", "^", "2"}], "*", 
    RowBox[{"loss", "^", 
     RowBox[{"(", 
      RowBox[{"2", 
       RowBox[{"(", 
        RowBox[{"pp", "-", "1"}], ")"}]}], ")"}]}], "*", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"Exp", "[", "sa", "]"}], " ", 
       RowBox[{"ha", "^", "2"}], " ", 
       RowBox[{"ta", "^", "2"}]}], "+", 
      RowBox[{
       RowBox[{"Exp", "[", "sb", "]"}], " ", 
       RowBox[{"hb", "^", "2"}], " ", 
       RowBox[{"tb", "^", "2"}]}], "+", 
      RowBox[{
       RowBox[{"Exp", "[", "sc", "]"}], " ", 
       RowBox[{"hc", "^", "2"}], " ", 
       RowBox[{"tc", "^", "2"}]}]}], ")"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ewl", "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"ha", "^", "2"}], " ", 
       RowBox[{"ta", "^", "2"}], " ", 
       RowBox[{"Exp", "[", "sa", "]"}]}], "+", 
      RowBox[{
       RowBox[{"hb", "^", "2"}], " ", 
       RowBox[{"tb", "^", "2"}], " ", 
       RowBox[{"Exp", "[", "sb", "]"}]}], "+", 
      RowBox[{
       RowBox[{"hc", "^", "2"}], " ", 
       RowBox[{"tc", "^", "2"}], " ", 
       RowBox[{"Exp", "[", "sc", "]"}]}]}], ")"}], "/", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"ha", " ", 
       RowBox[{"ta", "^", "2"}]}], "+", 
      RowBox[{"hb", " ", 
       RowBox[{"tb", "^", "2"}]}], "+", 
      RowBox[{"hc", " ", 
       RowBox[{"tc", "^", "2"}]}]}], ")"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"claimedExpr", "[", "pp_", "]"}], ":=", 
   RowBox[{"2", " ", 
    RowBox[{"pp", "^", "2"}], "*", 
    RowBox[{"loss", "^", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"2", "pp"}], "-", "1"}], ")"}]}], "*", "ewl"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{"denomContribExpr", "[", 
      RowBox[{"1", "/", "2"}], "]"}], "-", 
     RowBox[{"claimedExpr", "[", 
      RowBox[{"1", "/", "2"}], "]"}]}], "]"}], ",", "\[IndentingNewLine]", 
   " ", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{"denomContribExpr", "[", "1", "]"}], "-", 
     RowBox[{"claimedExpr", "[", "1", "]"}]}], "]"}], ",", 
   "\[IndentingNewLine]", " ", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{"denomContribExpr", "[", "2", "]"}], "-", 
     RowBox[{"claimedExpr", "[", "2", "]"}]}], "]"}]}], "}"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Output", ":", " ", 
    RowBox[{"{", 
     RowBox[{"0", ",", " ", "0", ",", " ", "0"}], "}"}]}], " ", 
   "*)"}]}]}], "Input",ExpressionUUID->"d84557a0-bd09-40be-bd70-660e43b820ff"],

Cell["1.3 L-independence at p=1/2", "Subsection",ExpressionUUID->"5c85fadb-b798-4f08-b84e-eedb65c11f03"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"hVals", "=", 
   RowBox[{"{", 
    RowBox[{"ha", ",", "hb"}], "}"}]}], ";", " ", 
  RowBox[{"thVals", "=", 
   RowBox[{"{", 
    RowBox[{"ta", ",", "tb"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"loss", "=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "/", "2"}], ")"}], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"ha", " ", 
        RowBox[{"ta", "^", "2"}]}], "+", 
       RowBox[{"hb", " ", 
        RowBox[{"tb", "^", "2"}]}]}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"p", "=", 
    RowBox[{
     RowBox[{
      RowBox[{"1", "/", "2"}], ":", " ", 
      RowBox[{"denom", " ", "contrib"}]}], " ", "=", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "/", "4"}], ")"}], " ", "*", " ", 
      RowBox[{"L", "^", 
       RowBox[{"{", 
        RowBox[{"-", "1"}], "}"}]}], " ", "*", " ", 
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{"e", "^", 
         RowBox[{"{", "s_i", "}"}]}], " ", 
        RowBox[{"h_i", "^", "2"}], " ", 
        RowBox[{"th_i", "^", "2"}]}], "]"}]}]}]}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"denomHalf", "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", "/", "4"}], ")"}], "*", 
    RowBox[{"loss", "^", 
     RowBox[{"(", 
      RowBox[{"-", "1"}], ")"}]}], "*", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"Exp", "[", "sa", "]"}], " ", 
       RowBox[{"ha", "^", "2"}], " ", 
       RowBox[{"ta", "^", "2"}]}], "+", 
      RowBox[{
       RowBox[{"Exp", "[", "sb", "]"}], " ", 
       RowBox[{"hb", "^", "2"}], " ", 
       RowBox[{"tb", "^", "2"}]}]}], ")"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ewl2", "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"ha", "^", "2"}], " ", 
       RowBox[{"ta", "^", "2"}], " ", 
       RowBox[{"Exp", "[", "sa", "]"}]}], "+", 
      RowBox[{
       RowBox[{"hb", "^", "2"}], " ", 
