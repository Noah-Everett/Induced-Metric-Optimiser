Cell["6. E_w[lambda] / max(lambda) Characterization", "Section",ExpressionUUID->"00a20c29-d6d4-44e3-947b-9bd38dda3616"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ratioEwlMax", "[", 
