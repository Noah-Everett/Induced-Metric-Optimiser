Cell["1.1 Denominator identity for N=2", "Subsection",ExpressionUUID->"57e39477-72c7-4811-8c35-5d46829ee9fa"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Verify", ":", " ", 
     RowBox[{"xi", " ", "*", " ", 
      RowBox[{
       RowBox[{"[", 
        RowBox[{
         RowBox[{"f", "'"}], 
         RowBox[{"(", "L", ")"}]}], "]"}], "^", "2"}], " ", "*", " ", 
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{"e", "^", 
         RowBox[{"{", "s_i", "}"}]}], " ", 
        RowBox[{"g_i", "^", "2"}]}], "]"}]}]}], " ", "=", " ", 
    RowBox[{"2", "*", "xi", "*", 
     RowBox[{"p", "^", "2"}], " ", "*", " ", 
     RowBox[{"L", "^", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"2", "p"}], "-", "1"}], "}"}]}], " ", "*", " ", 
     RowBox[{"E_w", "[", "lambda", "]"}]}]}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"h", "=", 
     RowBox[{"{", 
      RowBox[{"h1", ",", "h2"}], "}"}]}], ";", " ", 
    RowBox[{"theta", "=", 
     RowBox[{"{", 
      RowBox[{"th1", ",", "th2"}], "}"}]}], ";", " ", 
    RowBox[{"s", "=", 
     RowBox[{"{", 
      RowBox[{"s1", ",", "s2"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"L2", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "/", "2"}], ")"}], " ", 
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"h", "[", 
          RowBox[{"[", "i", "]"}], "]"}], " ", 
         RowBox[{
          RowBox[{"theta", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "^", "2"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "2"}], "}"}]}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"g", "=", 
     RowBox[{"h", "*", "theta"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"denomContrib", "[", "p_", "]"}], ":=", 
     RowBox[{
      RowBox[{"p", "^", "2"}], "*", 
      RowBox[{"L2", "^", 
       RowBox[{"(", 
        RowBox[{"2", 
         RowBox[{"(", 
          RowBox[{"p", "-", "1"}], ")"}]}], ")"}]}], "*", 
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Exp", "[", 
          RowBox[{"s", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "]"}], " ", 
         RowBox[{
          RowBox[{"g", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "^", "2"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "2"}], "}"}]}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"EwLambda", "=", 
     RowBox[{
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"h", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "^", "2"}], " ", 
         RowBox[{
          RowBox[{"theta", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "^", "2"}], " ", 
         RowBox[{"Exp", "[", 
          RowBox[{"s", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "2"}], "}"}]}], "]"}], "/", 
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"h", "[", 
          RowBox[{"[", "j", "]"}], "]"}], " ", 
         RowBox[{
          RowBox[{"theta", "[", 
           RowBox[{"[", "j", "]"}], "]"}], "^", "2"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", "2"}], "}"}]}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"claimed", "=", 
     RowBox[{"2", " ", 
      RowBox[{"p", "^", "2"}], "*", 
      RowBox[{"L2", "^", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"2", "p"}], "-", "1"}], ")"}]}], "*", "EwLambda"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{"denomContrib", "[", "p", "]"}], "-", "claimed"}], "]"}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"Output", ":", " ", "0"}], " ", "*)"}]}]}]], "Input",ExpressionUUI\
D->"e3f05b65-8925-45be-bca1-b2d24804e822"],

