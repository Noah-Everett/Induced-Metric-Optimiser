       RowBox[{"(", 
        RowBox[{
         RowBox[{"r", "^", "2"}], "+", "kappa"}], ")"}]}], ")"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
