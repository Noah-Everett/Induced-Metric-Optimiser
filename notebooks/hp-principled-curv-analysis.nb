Notebook[{
Cell["\<\
IMO-84: Principled Curvature Correction -- Newton-Targeted Metric Learning\
\>", "Title",ExpressionUUID->"f085747f-6f6c-4070-84c6-beee69595baa"],

Cell[TextData[{
 "Companion to ",
 Cell[BoxData[Cell["notes/principled-curvature-correction.md",
   Background->None,ExpressionUUID->"786924b6-f23b-49ee-92dd-44200a6bbc84"]], 
  "InlineCode",ExpressionUUID->"ab5b4897-39c8-43c4-a5ee-81f2adaa7efd"],
 ". Builds on the separation principle from IMO-83. "
}], "Text",ExpressionUUID->"3b6c6d67-9d1e-4b11-9dba-cdaa14f229ed"],

Cell["Part I: Optimal Diagonal Preconditioner on Quadratics", "Section",ExpressionUUID->"f7cc8cea-f459-4107-ba8d-819bafdf221f"],

Cell[TextData[{
 "For the learnable diagonal metric ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["M", "TI"], "\[LongEqual]", "diag", 
         RowBox[{"(", 
           RowBox[{
             SuperscriptBox[
              StyleBox["e", "TI"], 
              SubscriptBox[
               StyleBox["s", "TI"], "1"]], ",", "\[Ellipsis]", ",", 
             SuperscriptBox[
              StyleBox["e", "TI"], 
              SubscriptBox[
               StyleBox["s", "TI"], 
               StyleBox["N", "TI"]]]}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> "M = \\text{diag}(e^{s_1}, \\ldots, e^{s_N})",
      "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "6517dbe5-bcba-443a-ad58-2b4519902ddf"],
 ", the preconditioned gradient step on a quadratic ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["L", "TI"], "\[LongEqual]", 
         FractionBox["1", "2"], 
         SuperscriptBox["\[Theta]", 
          StyleBox["T", "TI"]], "diag", 
         RowBox[{"(", 
           StyleBox["h", "TI"], ")"}], "\[Theta]"}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "L = \\frac{1}{2}\\theta^T \\text{diag}(h)\\theta", "state" -> "Boxes"|>,
    
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "513f26b4-66dc-4ee9-b702-dda6a84610e3"],
 " gives per-coordinate contraction factor ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Rho]", 
          StyleBox["i", "TI"]], "\[LongEqual]", "|1", "-", "\[Alpha]", 
         SuperscriptBox[
          StyleBox["e", "TI"], 
          SubscriptBox[
           StyleBox["s", "TI"], 
           StyleBox["i", "TI"]]], 
         SubscriptBox[
          StyleBox["h", "TI"], 
          StyleBox["i", "TI"]], "|"}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\rho_i = |1 - \\alpha e^{s_i} h_i|", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ebdc33b2-6b60-4707-9596-9e8df04552da"],
 ".",
 StyleBox["Theorem:",
  FontWeight->Bold],
 " The minimax-optimal s (minimizing ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         UnderscriptBox["max", 
          StyleBox["i", "TI"], LimitsPositioning -> True], 
         SubscriptBox["\[Rho]", 
          StyleBox["i", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\max_i \\rho_i", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "9351c79d-6cbd-4483-a9a7-e60ebf9f4278"],
 " subject to ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Sum]", 
         SubscriptBox[
          StyleBox["s", "TI"], 
          StyleBox["i", "TI"]], "\[LongEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\sum s_i = 0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5a98c179-855f-42ba-bee6-b3e877c627c1"],
 ") is ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubsuperscriptBox[
          StyleBox["s", "TI"], 
          StyleBox["i", "TI"], "*"], "\[LongEqual]", "-", "log", 
         SubscriptBox[
          StyleBox["h", "TI"], 
          StyleBox["i", "TI"]], "+", 
         OverscriptBox[
          RowBox[{"log", 
            StyleBox["h", "TI"]}], "_"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "s_i^* = -\\log h_i + \\overline{\\log h}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f28afa0b-461e-4cde-9a36-405f495ac60a"],
 ", the Newton metric. "
}], "Text",ExpressionUUID->"e16d06dd-7610-4fb6-8af3-f320f0ec2f5d"],

Cell["Symbolic proof for N=2", "Subsection",ExpressionUUID->"800a4666-a2d3-404c-b313-abb6f47c676b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Mean", "-", 
     RowBox[{"centering", ":", " ", "s2"}]}], " ", "=", " ", 
    RowBox[{
     RowBox[{"-", 
      RowBox[{"s1", ".", " ", "Equal"}]}], " ", "products", " ", 
     RowBox[{"condition", ":"}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Clear", "[", 
     RowBox[{"s", ",", "h1", ",", "h2", ",", "alpha"}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"meanLogH", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Log", "[", "h1", "]"}], "+", 
        RowBox[{"Log", "[", "h2", "]"}]}], ")"}], "/", "2"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"s1Star", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"-", 
        RowBox[{"Log", "[", "h1", "]"}]}], "+", "meanLogH"}], " ", "//", " ", 
      "Simplify"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"s2Star", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"-", 
        RowBox[{"Log", "[", "h2", "]"}]}], "+", "meanLogH"}], " ", "//", " ", 
      "Simplify"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<s1* = \>\"", ",", "s1Star"}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<s2* = \>\"", ",", "s2Star"}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<s1* + s2* = \>\"", ",", 
      RowBox[{"Simplify", "[", 
       RowBox[{"s1Star", "+", "s2Star"}], "]"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"Preconditioned", " ", "eigenvalues"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"p1", "=", 
     RowBox[{
      RowBox[{"alpha", " ", 
       RowBox[{"Exp", "[", "s1Star", "]"}], " ", "h1"}], " ", "//", " ", 
      "Simplify"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"p2", "=", 
     RowBox[{
      RowBox[{"alpha", " ", 
       RowBox[{"Exp", "[", "s2Star", "]"}], " ", "h2"}], " ", "//", " ", 
      "Simplify"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<alpha*Exp[s1]*h1 = \>\"", ",", "p1"}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<alpha*Exp[s2]*h2 = \>\"", ",", "p2"}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Equal? \>\"", ",", 
      RowBox[{
       RowBox[{"Simplify", "[", 
        RowBox[{"p1", "-", "p2"}], "]"}], "==", "0"}]}], "]"}], 
    ";"}]}]}]], "Input",ExpressionUUID->"c960dcc1-5048-486d-9c6a-\
c580b6417bdf"],

Cell[TextData[{
 "Both preconditioned eigenvalues equal ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> InterpretationBox["", 
       Failure[
       "TeXAssistantError", <|
        "MessageTemplate" -> "Errors: `Errors`", 
         "MessageParameters" -> <|"Errors" -> {}|>, "Input" -> 
         "\\alpha \\sqrt{h_1 h_2} = \\alpha \\cdot h_\\text{geo}"|>]], 
     "errors" -> {}, "input" -> 
     "\\alpha \\sqrt{h_1 h_2} = \\alpha \\cdot h_\\text{geo}", "state" -> 
     "Error"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "2dbd8407-2fde-4dad-a43b-1719b7a3273b"],
 ". "
}], "Text",ExpressionUUID->"1883c8d7-ae21-434f-abef-66778d90b0a5"],

Cell["Numerical verification for N=10", "Subsection",ExpressionUUID->"0fcde2f0-aceb-4364-a8c2-07450ecff2fe"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"nn", "=", "10"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"hVals", "=", 
   RowBox[{
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"10", "^", 
       RowBox[{"(", 
        RowBox[{"2", " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"i", "-", "1"}], ")"}], "/", 
          RowBox[{"(", 
           RowBox[{"nn", "-", "1"}], ")"}]}]}], ")"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "nn"}], "}"}]}], "]"}], " ", "//", " ", "N"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Eigenvalues: \>\"", ",", 
    RowBox[{"hVals", " ", "//", " ", "Short"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Print", "[", 
    RowBox[{"\"\<Condition number: \>\"", ",", 
     RowBox[{
      RowBox[{"Max", "[", "hVals", "]"}], "/", 
      RowBox[{"Min", "[", "hVals", "]"}]}]}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"meanLogH", "=", 
   RowBox[{"Mean", "[", 
    RowBox[{"Log", "[", "hVals", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sNewton", "=", 
   RowBox[{
    RowBox[{"-", 
     RowBox[{"Log", "[", "hVals", "]"}]}], "+", "meanLogH"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Newton metric s: \>\"", ",", 
    RowBox[{"sNewton", " ", "//", " ", "Short"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Preconditioned eigenvalues: \>\"", ",", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Exp", "[", "sNewton", "]"}], " ", "hVals"}], ")"}], " ", "//",
      " ", "Short"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<All equal to geometric mean = \>\"", ",", 
    RowBox[{"Exp", "[", "meanLogH", "]"}]}], "]"}], ";"}]}], "Input",Expressio\
nUUID->"d9df5e6c-008e-43a5-8940-dc9776789569"],

Cell["\<\
All 10 preconditioned eigenvalues equal the geometric mean (10.0). Condition \
number reduced from 100 to 1. \
\>", "Text",ExpressionUUID->"eef15bc6-d6da-4432-b697-81d81c618aed"],

Cell["Direct minimax verification for N=3", "Subsection",ExpressionUUID->"b044d442-d223-4d5f-ba8b-315a1e082ca8"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"hTest", "=", 
   RowBox[{"{", 
    RowBox[{"1.0", ",", "10.0", ",", "100.0"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"alphaTest", "=", "0.05"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"obj", "[", 
     RowBox[{
      RowBox[{"s1_", "?", "NumericQ"}], ",", 
      RowBox[{"s2_", "?", "NumericQ"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"s3", "=", 
         RowBox[{
          RowBox[{"-", "s1"}], "-", "s2"}]}], ",", "rhos"}], "}"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"rhos", "=", 
        RowBox[{"Abs", "[", 
         RowBox[{"1", "-", 
          RowBox[{"alphaTest", " ", 
           RowBox[{"Exp", "[", 
            RowBox[{"{", 
             RowBox[{"s1", ",", "s2", ",", "s3"}], "}"}], "]"}], " ", 
           "hTest"}]}], "]"}]}], ";", "\[IndentingNewLine]", "  ", 
       RowBox[{"Max", "[", "rhos", "]"}]}]}], "\[IndentingNewLine]", "]"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"result", "=", 
    RowBox[{"NMinimize", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"obj", "[", 
         RowBox[{"s1", ",", "s2"}], "]"}], ",", 
        RowBox[{
         RowBox[{"-", "10"}], "<", "s1", "<", "10"}], ",", 
        RowBox[{
         RowBox[{"-", "10"}], "<", "s2", "<", "10"}]}], "}"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"{", 
       RowBox[{"s1", ",", "s2"}], "}"}], ",", 
      RowBox[{"Method", "->", "\"\<NelderMead\>\""}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sOpt", "=", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"s1", ",", "s2", ",", 
      RowBox[{
       RowBox[{"-", "s1"}], "-", "s2"}]}], "}"}], " ", "/.", " ", 
    RowBox[{"result", "[", 
     RowBox[{"[", "2", "]"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sNewtonPred", "=", 
   RowBox[{
    RowBox[{"-", 
     RowBox[{"Log", "[", "hTest", "]"}]}], "+", 
    RowBox[{"Mean", "[", 
     RowBox[{"Log", "[", "hTest", "]"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<NMinimize optimal s = \>\"", ",", "sOpt"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Newton predicted s  = \>\"", ",", "sNewtonPred"}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Max contraction (NMinimize) = \>\"", ",", 
    RowBox[{"result", "[", 
     RowBox[{"[", "1", "]"}], "]"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Max contraction (Newton)    = \>\"", ",", 
    RowBox[{"Max", "[", 
     RowBox[{"Abs", "[", 
      RowBox[{"1", "-", 
       RowBox[{"alphaTest", " ", 
        RowBox[{"Exp", "[", "sNewtonPred", "]"}], " ", "hTest"}]}], "]"}], 
     "]"}]}], "]"}], ";"}]}], "Input",ExpressionUUID->"a2dc861e-ef1d-4c57-\
b951-9c1aea9d31d7"],

Cell["\<\
NMinimize finds the Newton metric exactly. Both give max contraction = 0.5. \
\>", "Text",ExpressionUUID->"8863aedc-c597-41b0-915a-0136c60c39d0"],

Cell["Part II: Convergence Simulation -- Four Driving Forces", "Section",ExpressionUUID->"1193380f-b982-425d-844e-b0cdda90c1a5"],

Cell[TextData[{
 "Compare on 10D diagonal quadratic (",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Kappa]", "\[LongEqual]", "100"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\kappa = 100", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "2a4a56f0-3150-4b91-ae0f-d6f96ea06489"],
 "):"
}], "Text",ExpressionUUID->"c1f20eba-5b19-4637-8d80-f3bba4587a11"],

Cell[TextData[{
 "1. No metric (",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["s", "TI"], "\[LongEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "s = 0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "092663cf-4efe-4359-9365-31c1ea97ad17"],
 ")"
}], "Text",ExpressionUUID->"580af772-5678-4704-9821-995a52643ffa"],

Cell[TextData[{
 "2. Gradient magnitude: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["D", "TI"], 
          StyleBox["i", "TI"]], "\[LongEqual]", "\[Xi]", 
         SubsuperscriptBox[
          StyleBox["g", "TI"], 
          StyleBox["i", "TI"], "2"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "D_i = \\xi g_i^2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d7c53b5c-5079-46f7-8891-5d1fce597333"],
 "3. Tanh heuristic: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["D", "TI"], 
          StyleBox["i", "TI"]], "\[LongEqual]", "\[Xi]", 
         SubsuperscriptBox[
          StyleBox["g", "TI"], 
          StyleBox["i", "TI"], "2"], 
         RowBox[{"(", 
           RowBox[{"1", "-", 
             StyleBox["r", "TI"], "tanh", 
             RowBox[{"(", 
               RowBox[{
                 SubscriptBox[
                  StyleBox["H", "TI"], 
                  StyleBox["i", "TI"]], "/", "\[Tau]"}], ")"}]}], ")"}]}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "D_i = \\xi g_i^2(1 - r\\tanh(H_i/\\tau))", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ea60d70c-0cf6-49ba-ba70-1e56245c4882"],
 "4. Newton target: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["D", "TI"], 
          StyleBox["i", "TI"]], "\[LongEqual]", "-", "\[Lambda]", "log", 
         "max", 
         RowBox[{"(", 
           RowBox[{
             SubscriptBox[
              OverscriptBox[
               StyleBox["H", "TI"], "^"], 
              RowBox[{
                StyleBox["i", "TI"], 
                StyleBox["i", "TI"]}]], ",", "\[Epsilon]"}], ")"}]}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "D_i = -\\lambda \\log\\max(\\hat{H}_{ii}, \\varepsilon)", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c63ba375-c301-4994-ac1e-a34790237f12"]
}], "Text",ExpressionUUID->"6ff120a2-d983-464d-8198-8211a4e972b5"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Clear", "[", "\"\<Global`*\>\"", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"nn", "=", "10"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"hVals", "=", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"10", "^", 
        RowBox[{"(", 
         RowBox[{"2", " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"i", "-", "1"}], ")"}], "/", 
           RowBox[{"(", 
            RowBox[{"nn", "-", "1"}], ")"}]}]}], ")"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "nn"}], "}"}]}], "]"}], " ", "//", " ", "N"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"mu", "=", "0.01"}], ";", " ", 
  RowBox[{"lam", "=", "0.01"}], ";", " ", 
  RowBox[{"eta", "=", "0.001"}], ";", " ", 
  RowBox[{"xi", "=", "0.1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"clip", "=", "6.0"}], ";", " ", 
  RowBox[{"eps", "=", "1.0*^-8"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"curvBeta", "=", "0.05"}], ";", " ", 
  RowBox[{"curvTau", "=", "1.0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"nSteps", "=", "20000"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"theta0", "=", 
    RowBox[{"ConstantArray", "[", 
     RowBox[{"1.0", ",", "nn"}], "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"meanCenterClip", "[", 
     RowBox[{"s_", ",", "c_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"sc", "=", 
        RowBox[{"s", "-", 
         RowBox[{"Mean", "[", "s", "]"}]}]}], "}"}], ",", 
      RowBox[{"Clip", "[", 
       RowBox[{"sc", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "c"}], ",", "c"}], "}"}]}], "]"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"simulate", "[", 
     RowBox[{"hVals_", ",", "theta0_", ",", "rule_", ",", "nSteps_"}], "]"}], 
    ":=", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"theta", "=", "theta0"}], ",", 
        RowBox[{"s", "=", 
         RowBox[{"ConstantArray", "[", 
          RowBox[{"0.0", ",", 
           RowBox[{"Length", "[", "hVals", "]"}]}], "]"}]}], ",", 
        "\[IndentingNewLine]", "   ", 
        RowBox[{"lossHist", "=", 
         RowBox[{"Table", "[", 
          RowBox[{"0.0", ",", "nSteps"}], "]"}]}], ",", "sHist", ",", "g", ",",
         "g2", ",", "drive", ",", "v", ",", "r", ",", 
        RowBox[{"n", "=", 
         RowBox[{"Length", "[", "hVals", "]"}]}]}], "}"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"sHist", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"ConstantArray", "[", 
           RowBox[{"0.0", ",", "n"}], "]"}], ",", "nSteps"}], "]"}]}], ";", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"Do", "[", "\[IndentingNewLine]", "    ", 
        RowBox[{
         RowBox[{
          RowBox[{"g", "=", 
           RowBox[{"hVals", " ", "theta"}]}], ";", " ", 
          RowBox[{"g2", "=", 
           RowBox[{"g", "^", "2"}]}], ";", "\[IndentingNewLine]", "    ", 
          RowBox[{"v", "=", 
           RowBox[{"xi", " ", 
            RowBox[{"Total", "[", 
             RowBox[{
              RowBox[{"Exp", "[", "s", "]"}], " ", "g2"}], "]"}]}]}], ";", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"r", "=", 
           RowBox[{"1.0", "/", 
            RowBox[{"(", 
             RowBox[{"1.0", "+", 
              RowBox[{"Abs", "[", "v", "]"}]}], ")"}]}]}], ";", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"theta", "=", 
           RowBox[{"theta", "-", 
            RowBox[{"eta", " ", "r", " ", 
             RowBox[{"Exp", "[", "s", "]"}], " ", "g"}]}]}], ";", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"drive", "=", 
           RowBox[{"Switch", "[", 
            RowBox[{
            "rule", ",", "\[IndentingNewLine]", "      ", "\"\<none\>\"", ",", 
             RowBox[{"ConstantArray", "[", 
              RowBox[{"0.0", ",", "n"}], "]"}], ",", "\[IndentingNewLine]", 
             "      ", "\"\<grad_mag\>\"", ",", 
             RowBox[{"xi", " ", "g2"}], ",", "\[IndentingNewLine]", 
             "      ", "\"\<tanh_heuristic\>\"", ",", 
             RowBox[{"xi", " ", "g2", " ", 
              RowBox[{"(", 
               RowBox[{"1", "-", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"curvBeta", "/", "xi"}], ")"}], " ", 
                 RowBox[{"Tanh", "[", 
                  RowBox[{"hVals", "/", "curvTau"}], "]"}]}]}], ")"}]}], ",", 
             "\[IndentingNewLine]", "      ", "\"\<newton\>\"", ",", 
             RowBox[{
              RowBox[{"-", "lam"}], " ", 
              RowBox[{"Log", "[", 
               RowBox[{"MapThread", "[", 
                RowBox[{"Max", ",", 
                 RowBox[{"{", 
                  RowBox[{"hVals", ",", 
                   RowBox[{"ConstantArray", "[", 
                    RowBox[{"eps", ",", "n"}], "]"}]}], "}"}]}], "]"}], 
               "]"}]}]}], "\[IndentingNewLine]", "    ", "]"}]}], ";", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"s", "=", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"1", "-", 
               RowBox[{"mu", " ", "lam"}]}], ")"}], " ", "s"}], "+", 
            RowBox[{"mu", " ", "drive"}]}]}], ";", "\[IndentingNewLine]", 
          "    ", 
          RowBox[{"s", "=", 
           RowBox[{"meanCenterClip", "[", 
            RowBox[{"s", ",", "clip"}], "]"}]}], ";", "\[IndentingNewLine]", 
          "    ", 
          RowBox[{
           RowBox[{"lossHist", "[", 
            RowBox[{"[", "t", "]"}], "]"}], "=", 
           RowBox[{
            RowBox[{"Total", "[", 
             RowBox[{"hVals", " ", 
              RowBox[{"theta", "^", "2"}]}], "]"}], "/", "2"}]}], ";", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{
           RowBox[{"sHist", "[", 
            RowBox[{"[", "t", "]"}], "]"}], "=", "s"}], ";"}], 
         "\[IndentingNewLine]", "  ", ",", 
         RowBox[{"{", 
          RowBox[{"t", ",", "nSteps"}], "}"}]}], "]"}], ";", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"{", 
        RowBox[{"lossHist", ",", "sHist"}], "}"}]}]}], "\[IndentingNewLine]", 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"lossNone", ",", "sNone"}], "}"}], "=", 
   RowBox[{"simulate", "[", 
    RowBox[{"hVals", ",", "theta0", ",", "\"\<none\>\"", ",", "nSteps"}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"lossGrad", ",", "sGrad"}], "}"}], "=", 
   RowBox[{"simulate", "[", 
    RowBox[{"hVals", ",", "theta0", ",", "\"\<grad_mag\>\"", ",", "nSteps"}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"lossTanh", ",", "sTanh"}], "}"}], "=", 
   RowBox[{"simulate", "[", 
    RowBox[{
    "hVals", ",", "theta0", ",", "\"\<tanh_heuristic\>\"", ",", "nSteps"}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{"lossNewt", ",", "sNewt"}], "}"}], "=", 
    RowBox[{"simulate", "[", 
     RowBox[{"hVals", ",", "theta0", ",", "\"\<newton\>\"", ",", "nSteps"}], 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Final losses (step \>\"", ",", "nSteps", ",", "\"\<):\>\""}], 
   "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<  No metric:      \>\"", ",", 
    RowBox[{"lossNone", "[", 
     RowBox[{"[", 
      RowBox[{"-", "1"}], "]"}], "]"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<  Grad magnitude:  \>\"", ",", 
    RowBox[{"lossGrad", "[", 
     RowBox[{"[", 
      RowBox[{"-", "1"}], "]"}], "]"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<  Tanh heuristic:  \>\"", ",", 
    RowBox[{"lossTanh", "[", 
     RowBox[{"[", 
      RowBox[{"-", "1"}], "]"}], "]"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<  Newton target:   \>\"", ",", 
    RowBox[{"lossNewt", "[", 
     RowBox[{"[", 
      RowBox[{"-", "1"}], "]"}], "]"}]}], "]"}], ";"}]}], "Input",ExpressionUU\
ID->"9b1d09b2-5289-40bc-abad-e74288bcd374"],

