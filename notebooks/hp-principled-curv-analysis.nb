Cell["Effective condition number over time", "Subsection",ExpressionUUID->"b2b4b520-abf7-440d-a45b-6d8e49c424a3"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"condNum", "[", 
     RowBox[{"s_", ",", "h_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"Max", "[", 
      RowBox[{
       RowBox[{"Exp", "[", "s", "]"}], " ", "h"}], "]"}], "/", 
     RowBox[{"Min", "[", 
      RowBox[{
       RowBox[{"Exp", "[", "s", "]"}], " ", "h"}], "]"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"condTable", "=", 
    RowBox[{"Table", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"t", ",", 
        RowBox[{"condNum", "[", 
         RowBox[{
          RowBox[{"sNone", "[", 
           RowBox[{"[", "t", "]"}], "]"}], ",", "hVals"}], "]"}], ",", 
        RowBox[{"condNum", "[", 
         RowBox[{
          RowBox[{"sGrad", "[", 
           RowBox[{"[", "t", "]"}], "]"}], ",", "hVals"}], "]"}], ",", 
        "\[IndentingNewLine]", "   ", 
        RowBox[{"condNum", "[", 
         RowBox[{
          RowBox[{"sTanh", "[", 
           RowBox[{"[", "t", "]"}], "]"}], ",", "hVals"}], "]"}], ",", 
        RowBox[{"condNum", "[", 
         RowBox[{
          RowBox[{"sNewt", "[", 
           RowBox[{"[", "t", "]"}], "]"}], ",", "hVals"}], "]"}]}], "}"}], ",",
       "\[IndentingNewLine]", "  ", 
      RowBox[{"{", 
       RowBox[{"t", ",", 
        RowBox[{"{", 
         RowBox[{
         "100", ",", "500", ",", "1000", ",", "5000", ",", "10000", ",", 
          "20000"}], "}"}]}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<Step\\t\\tNone\\t\\tGradMag\\t\\tTanh\\t\\tNewton\>\"", 
   "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Do", "[", 
    RowBox[{
     RowBox[{"Print", "[", 
      RowBox[{"Row", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"PaddedForm", "[", 
           RowBox[{"#", ",", 
            RowBox[{"{", 
             RowBox[{"10", ",", "1"}], "}"}]}], "]"}], " ", "&"}], " ", "/@", 
         " ", "r"}], ",", "\"\<\\t\>\""}], "]"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"r", ",", "condTable"}], "}"}]}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Metric convergence timescale T = 1/(mu*lam) = \>\"", ",", 
    RowBox[{"1.0", "/", 
     RowBox[{"(", 
      RowBox[{"mu", " ", "lam"}], ")"}]}], ",", "\"\< steps\>\""}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<Curves diverge at ~T, when the Newton metric has built \
up.\>\"", "]"}], ";"}]}], "Input",ExpressionUUID->"7246c781-b348-479d-9c4e-\
10277a960101"],

Cell["Part III: Why Gradient-Magnitude is Anti-Newton", "Section",ExpressionUUID->"834169ca-e9f3-4200-b5ef-f5d8c93e40f8"],

Cell[TextData[{
 "The gradient-magnitude equilibrium ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubsuperscriptBox[
          StyleBox["s", "TI"], 
          StyleBox["i", "TI"], "*"], "\[Proportional]", 
         SubsuperscriptBox[
          StyleBox["g", "TI"], 
          StyleBox["i", "TI"], "2"], "\[LongEqual]", 
         SubsuperscriptBox[
          StyleBox["h", "TI"], 
          StyleBox["i", "TI"], "2"], 
         SubsuperscriptBox["\[Theta]", 
          StyleBox["i", "TI"], "2"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "s_i^* \\propto g_i^2 = h_i^2 \\theta_i^2", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0e251356-a700-4fc0-b1a2-d095d62177d8"],
 " is ",
 StyleBox["positively correlated",
  FontWeight->Bold],
 " with $h_i$ -- large curvature gets large metric weight. Newton needs the \
opposite. "
}], "Text",ExpressionUUID->"26ebe099-6bdd-4704-80c0-ee6b29d57b26"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<Correlation of equilibrium s* with Log[h]:\>\"", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Do", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{
      RowBox[{"thetaTest", "=", 
       RowBox[{"ConstantArray", "[", 
        RowBox[{"tMag", ",", "nn"}], "]"}]}], ";", "\[IndentingNewLine]", 
      "  ", 
      RowBox[{"g2Test", "=", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"hVals", " ", "thetaTest"}], ")"}], "^", "2"}]}], ";", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"sStarGM", "=", 
       RowBox[{"0.1", " ", 
        RowBox[{"g2Test", "/", "0.01"}]}]}], ";", "\[IndentingNewLine]", "  ", 
      RowBox[{"sStarTanh", "=", 
       RowBox[{"0.1", " ", "g2Test", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "-", 
           RowBox[{"0.5", " ", 
            RowBox[{"Tanh", "[", 
             RowBox[{"hVals", "/", "1.0"}], "]"}]}]}], ")"}], "/", 
         "0.01"}]}]}], ";", "\[IndentingNewLine]", "  ", 
      RowBox[{"sStarNewt", "=", 
       RowBox[{"-", 
        RowBox[{"Log", "[", "hVals", "]"}]}]}], ";", "\[IndentingNewLine]", 
      "  ", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<  |theta|=\>\"", ",", "tMag", ",", "\"\<:  GradMag=\>\"", 
        ",", 
        RowBox[{"NumberForm", "[", 
         RowBox[{
          RowBox[{"Correlation", "[", 
           RowBox[{"sStarGM", ",", 
            RowBox[{"Log", "[", "hVals", "]"}]}], "]"}], ",", "4"}], "]"}], ",",
         "\[IndentingNewLine]", "    ", "\"\<  Tanh=\>\"", ",", 
        RowBox[{"NumberForm", "[", 
         RowBox[{
          RowBox[{"Correlation", "[", 
           RowBox[{"sStarTanh", ",", 
            RowBox[{"Log", "[", "hVals", "]"}]}], "]"}], ",", "4"}], "]"}], ",",
         "\[IndentingNewLine]", "    ", "\"\<  Newton=\>\"", ",", 
        RowBox[{"NumberForm", "[", 
         RowBox[{
          RowBox[{"Correlation", "[", 
           RowBox[{"sStarNewt", ",", 
            RowBox[{"Log", "[", "hVals", "]"}]}], "]"}], ",", "4"}], "]"}]}], 
       "]"}], ";"}], "\[IndentingNewLine]", ",", 
     RowBox[{"{", 
      RowBox[{"tMag", ",", 
       RowBox[{"{", 
        RowBox[{"1.0", ",", "0.1", ",", "0.01", ",", "0.001"}], "}"}]}], 
      "}"}]}], "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<GradMag and Tanh: always +0.71 (anti-Newton)\>\"", "]"}],
   ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<Newton: always -1.0 (perfect Newton, \
position-independent)\>\"", "]"}], ";"}]}], "Input",ExpressionUUID->"56ed0a1f-\
dbaf-43e9-b9c7-3b0d290db6d6"],

Cell["Condition number at equilibrium", "Subsection",ExpressionUUID->"f690f665-55b5-4d5f-8823-0602ddb93617"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"thetaEq", "=", 
   RowBox[{"ConstantArray", "[", 
    RowBox[{"1.0", ",", "nn"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"g2Eq", "=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"hVals", " ", "thetaEq"}], ")"}], "^", "2"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"Newton", " ", "equilibrium"}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sEqN", "=", 
   RowBox[{"-", 
    RowBox[{"Log", "[", "hVals", "]"}]}]}], ";", " ", 
  RowBox[{"sEqN", "=", 
   RowBox[{"sEqN", "-", 
    RowBox[{"Mean", "[", "sEqN", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"kappaN", "=", 
    RowBox[{
     RowBox[{"Max", "[", 
      RowBox[{
       RowBox[{"Exp", "[", "sEqN", "]"}], " ", "hVals"}], "]"}], "/", 
     RowBox[{"Min", "[", 
      RowBox[{
       RowBox[{"Exp", "[", "sEqN", "]"}], " ", "hVals"}], "]"}]}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"GradMag", " ", 
    RowBox[{"equilibrium", " ", "--"}], " ", "clip", " ", "to", " ", 
    "prevent", " ", "infinity"}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sEqG", "=", 
   RowBox[{"0.1", " ", 
    RowBox[{"g2Eq", "/", "0.01"}]}]}], ";", " ", 
  RowBox[{"sEqG", "=", 
   RowBox[{"sEqG", "-", 
    RowBox[{"Mean", "[", "sEqG", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sEqGc", "=", 
   RowBox[{"Clip", "[", 
    RowBox[{"sEqG", ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "6"}], ",", "6"}], "}"}]}], "]"}]}], ";", " ", 
  RowBox[{"sEqGc", "=", 
   RowBox[{"sEqGc", "-", 
    RowBox[{"Mean", "[", "sEqGc", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"kappaGc", "=", 
    RowBox[{
     RowBox[{"Max", "[", 
      RowBox[{
       RowBox[{"Exp", "[", "sEqGc", "]"}], " ", "hVals"}], "]"}], "/", 
     RowBox[{"Min", "[", 
      RowBox[{
       RowBox[{"Exp", "[", "sEqGc", "]"}], " ", "hVals"}], "]"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Original kappa = \>\"", ",", 
    RowBox[{
     RowBox[{"Max", "[", "hVals", "]"}], "/", 
     RowBox[{"Min", "[", "hVals", "]"}]}]}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Newton equilibrium kappa = \>\"", ",", "kappaN"}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<GradMag equilibrium kappa (clipped) = \>\"", ",", 
    RowBox[{"ScientificForm", "[", 
     RowBox[{"kappaGc", ",", "3"}], "]"}]}], "]"}], ";"}]}], "Input",Expressio\
nUUID->"a9297c65-3827-4ce4-9c4d-a9712f01c291"],

Cell["Part IV: Position Dependence -- The Critical Flaw", "Section",ExpressionUUID->"562b1781-95c8-434c-9c7d-0715aea7f405"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"The", " ", "gradient"}], "-", 
     RowBox[{"magnitude", " ", "drive", " ", "D"}]}], " ", "=", " ", 
    RowBox[{
     RowBox[{"xi", "*", 
      RowBox[{"g", "^", "2"}]}], " ", "=", " ", 
     RowBox[{
      RowBox[{"xi", "*", 
       RowBox[{"h", "^", "2"}], "*", 
       RowBox[{"theta", "^", "2"}], " ", "\n", "   ", "vanishes", " ", "as", " ",
        "theta"}], " ", "->", " ", 
      RowBox[{
      "0.", " ", "The", " ", "metric", " ", "relaxes", " ", "to", " ", 
       "identity", "\n", "   ", "EXACTLY", " ", "when", " ", "Newton", " ", 
       "preconditioning", " ", "is", " ", "most", " ", 
       RowBox[{"needed", "."}]}]}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Driving force magnitude at step 20000:\>\"", "]"}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<  Loss(none) = \>\"", ",", 
      RowBox[{"ScientificForm", "[", 
       RowBox[{
        RowBox[{"lossNone", "[", 
         RowBox[{"[", 
          RowBox[{"-", "1"}], "]"}], "]"}], ",", "3"}], "]"}], ",", 
      "\[IndentingNewLine]", "  ", "\"\< -> |theta| ~ \>\"", ",", 
      RowBox[{"ScientificForm", "[", 
       RowBox[{
        RowBox[{"Sqrt", "[", 
         RowBox[{"2", " ", 
          RowBox[{
           RowBox[{"lossNone", "[", 
            RowBox[{"[", 
             RowBox[{"-", "1"}], "]"}], "]"}], "/", 
           RowBox[{"Mean", "[", "hVals", "]"}]}]}], "]"}], ",", "3"}], 
       "]"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<  Loss(grad) = \>\"", ",", 
      RowBox[{"ScientificForm", "[", 
       RowBox[{
        RowBox[{"lossGrad", "[", 
         RowBox[{"[", 
          RowBox[{"-", "1"}], "]"}], "]"}], ",", "3"}], "]"}], ",", 
      "\[IndentingNewLine]", "  ", "\"\< -> |theta| ~ \>\"", ",", 
      RowBox[{"ScientificForm", "[", 
       RowBox[{
        RowBox[{"Sqrt", "[", 
         RowBox[{"2", " ", 
          RowBox[{
           RowBox[{"lossGrad", "[", 
            RowBox[{"[", 
             RowBox[{"-", "1"}], "]"}], "]"}], "/", 
           RowBox[{"Mean", "[", "hVals", "]"}]}]}], "]"}], ",", "3"}], 
       "]"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<  Loss(newt) = \>\"", ",", 
      RowBox[{"ScientificForm", "[", 
       RowBox[{
        RowBox[{"lossNewt", "[", 
         RowBox[{"[", 
          RowBox[{"-", "1"}], "]"}], "]"}], ",", "3"}], "]"}], ",", 
      "\[IndentingNewLine]", "  ", "\"\< -> |theta| ~ \>\"", ",", 
      RowBox[{"ScientificForm", "[", 
       RowBox[{
        RowBox[{"Sqrt", "[", 
         RowBox[{"2", " ", 
          RowBox[{
           RowBox[{"lossNewt", "[", 
            RowBox[{"[", 
             RowBox[{"-", "1"}], "]"}], "]"}], "/", 
           RowBox[{"Mean", "[", "hVals", "]"}]}]}], "]"}], ",", "3"}], 
       "]"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<GradMag D = xi*h^2*theta^2 -> 0 as theta -> 0\>\"", 
     "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Newton  D = -lam*Log[h], always nonzero\>\"", "]"}], 
    ";"}]}]}]], "Input",ExpressionUUID->"54ec9e9c-10ee-4f9a-bcc7-\
4e2b48bacaa8"],

Cell["Part V: Saddle Escape", "Section",ExpressionUUID->"be9acf78-23e2-4d13-b7e5-8140a4bcb8a1"],

Cell[TextData[{
 "On ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["L", "TI"], "\[LongEqual]", 
         SuperscriptBox[
          StyleBox["x", "TI"], "2"], "-", 
         SuperscriptBox[
          StyleBox["y", "TI"], "2"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "L = x^2 - y^2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ed5f0db1-a9b6-4a72-aee4-e1391abef7f4"],
 ", all three learnable rules develop the correct anti-correlation ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["s", "TI"], "\[LongEqual]", 
         RowBox[{"(", 
           RowBox[{"-", 
             StyleBox["c", "TI"], ",", "+", 
             StyleBox["c", "TI"]}], ")"}]}], TraditionalForm], "errors" -> {},
      "input" -> "s = (-c, +c)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "dc5f1dad-a855-46fd-ba1a-7f8902926786"],
 " at the clip boundary. The Newton target achieves this because ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"max", 
         RowBox[{"(", 
           RowBox[{"-2", ",", "\[Epsilon]"}], ")"}], "\[LongEqual]", 
         "\[Epsilon]"}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\max(-2, \\varepsilon) = \\varepsilon", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "7b1be2a7-4dbd-47a2-bec5-23744261f08f"],
 ", so ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["D", "TI"], "2"], "\[LongEqual]", "-", "\[Lambda]", "log", 
         "\[Epsilon]", "\[GreaterGreater]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "D_2 = -\\lambda\\log\\varepsilon \\gg 0", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "570ef983-4bf3-4a82-b193-bbfc6d3d950b"],
 ". "
}], "Text",ExpressionUUID->"d15c7c1f-35c0-4f24-8187-b06d2bde44c1"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"simulateSaddle", "[", 
     RowBox[{"rule_", ",", "nSt_"}], "]"}], ":=", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"theta", "=", 
         RowBox[{"{", 
          RowBox[{"1.0", ",", "0.1"}], "}"}]}], ",", 
        RowBox[{"s", "=", 
         RowBox[{"{", 
          RowBox[{"0.0", ",", "0.0"}], "}"}]}], ",", 
        RowBox[{"hDiag", "=", 
         RowBox[{"{", 
          RowBox[{"2.0", ",", 
           RowBox[{"-", "2.0"}]}], "}"}]}], ",", "\[IndentingNewLine]", "   ", 
        RowBox[{"sH", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0.0", ",", "0.0"}], "}"}], ",", "nSt"}], "]"}]}], ",", 
        "g", ",", "g2", ",", "v", ",", "r", ",", "drive"}], "}"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"Do", "[", "\[IndentingNewLine]", "    ", 
        RowBox[{
         RowBox[{
          RowBox[{"g", "=", 
           RowBox[{"hDiag", " ", "theta"}]}], ";", " ", 
          RowBox[{"g2", "=", 
           RowBox[{"g", "^", "2"}]}], ";", "\[IndentingNewLine]", "    ", 
          RowBox[{"v", "=", 
           RowBox[{"xi", " ", 
            RowBox[{"Total", "[", 
             RowBox[{
              RowBox[{"Exp", "[", "s", "]"}], " ", "g2"}], "]"}]}]}], ";", 
          " ", 
          RowBox[{"r", "=", 
           RowBox[{"1.0", "/", 
            RowBox[{"(", 
             RowBox[{"1.0", "+", 
              RowBox[{"Abs", "[", "v", "]"}]}], ")"}]}]}], ";", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"theta", "=", 
           RowBox[{"theta", "-", 
            RowBox[{"eta", " ", "r", " ", 
             RowBox[{"Exp", "[", "s", "]"}], " ", "g"}]}]}], ";", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"drive", "=", 
           RowBox[{"Switch", "[", 
            RowBox[{
            "rule", ",", "\[IndentingNewLine]", "      ", "\"\<none\>\"", ",", 
             RowBox[{"{", 
              RowBox[{"0.0", ",", "0.0"}], "}"}], ",", "\[IndentingNewLine]", 
             "      ", "\"\<grad_mag\>\"", ",", 
             RowBox[{"xi", " ", "g2"}], ",", "\[IndentingNewLine]", 
             "      ", "\"\<tanh_heuristic\>\"", ",", 
             RowBox[{"xi", " ", "g2", " ", 
              RowBox[{"(", 
               RowBox[{"1", "-", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"curvBeta", "/", "xi"}], ")"}], " ", 
                 RowBox[{"Tanh", "[", 
                  RowBox[{"hDiag", "/", "curvTau"}], "]"}]}]}], ")"}]}], ",", 
             "\[IndentingNewLine]", "      ", "\"\<newton\>\"", ",", 
             RowBox[{
              RowBox[{"-", "lam"}], " ", 
              RowBox[{"Log", "[", 
               RowBox[{"MapThread", "[", 
                RowBox[{"Max", ",", 
                 RowBox[{"{", 
                  RowBox[{"hDiag", ",", 
                   RowBox[{"{", 
                    RowBox[{"eps", ",", "eps"}], "}"}]}], "}"}]}], "]"}], 
               "]"}]}]}], "\[IndentingNewLine]", "    ", "]"}]}], ";", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"s", "=", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"1", "-", 
               RowBox[{"mu", " ", "lam"}]}], ")"}], " ", "s"}], "+", 
            RowBox[{"mu", " ", "drive"}]}]}], ";", "\[IndentingNewLine]", 
          "    ", 
          RowBox[{"s", "=", 
           RowBox[{"meanCenterClip", "[", 
            RowBox[{"s", ",", "clip"}], "]"}]}], ";", "\[IndentingNewLine]", 
          "    ", 
          RowBox[{
           RowBox[{"sH", "[", 
            RowBox[{"[", "t", "]"}], "]"}], "=", "s"}], ";"}], 
         "\[IndentingNewLine]", "  ", ",", 
         RowBox[{"{", 
          RowBox[{"t", ",", "nSt"}], "}"}]}], "]"}], ";", 
       "\[IndentingNewLine]", "  ", "sH"}]}], "\[IndentingNewLine]", "]"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"nSaddle", "=", "10000"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", "\"\<Final s on saddle L=x^2-y^2:\>\"", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<  None:    \>\"", ",", 
    RowBox[{
     RowBox[{"simulateSaddle", "[", 
      RowBox[{"\"\<none\>\"", ",", "nSaddle"}], "]"}], "[", 
     RowBox[{"[", 
      RowBox[{"-", "1"}], "]"}], "]"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<  GradMag: \>\"", ",", 
    RowBox[{
     RowBox[{"simulateSaddle", "[", 
      RowBox[{"\"\<grad_mag\>\"", ",", "nSaddle"}], "]"}], "[", 
     RowBox[{"[", 
      RowBox[{"-", "1"}], "]"}], "]"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<  Tanh:    \>\"", ",", 
    RowBox[{
     RowBox[{"simulateSaddle", "[", 
      RowBox[{"\"\<tanh_heuristic\>\"", ",", "nSaddle"}], "]"}], "[", 
     RowBox[{"[", 
      RowBox[{"-", "1"}], "]"}], "]"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<  Newton:  \>\"", ",", 
    RowBox[{
     RowBox[{"simulateSaddle", "[", 
      RowBox[{"\"\<newton\>\"", ",", "nSaddle"}], "]"}], "[", 
     RowBox[{"[", 
      RowBox[{"-", "1"}], "]"}], "]"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<All learnable rules reach clip. Saddle escape is \
clip-dominated.\>\"", "]"}], ";"}]}], "Input",ExpressionUUID->"e0f48dcb-a08e-\
41f5-9612-b4ca4cea5ead"],

Cell["Part VI: Stochastic Gradients", "Section",ExpressionUUID->"29404391-8a73-467c-9e26-d4bc69e0ad94"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "42", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"simulateStoch", "[", 
     RowBox[{
     "hVals_", ",", "theta0_", ",", "rule_", ",", "nSt_", ",", 
      "noiseScale_"}], "]"}], ":=", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"theta", "=", "theta0"}], ",", 
        RowBox[{"s", "=", 
         RowBox[{"ConstantArray", "[", 
          RowBox[{"0.0", ",", 
           RowBox[{"Length", "[", "hVals", "]"}]}], "]"}]}], ",", 
        "\[IndentingNewLine]", "   ", 
        RowBox[{"lossH", "=", 
         RowBox[{"Table", "[", 
          RowBox[{"0.0", ",", "nSt"}], "]"}]}], ",", "sH", ",", "g", ",", 
        "g2", ",", "v", ",", "r", ",", "drive", ",", "hHat", ",", 
        "\[IndentingNewLine]", "   ", 
        RowBox[{"n", "=", 
         RowBox[{"Length", "[", "hVals", "]"}]}], ",", "prevG", ",", 
        "prevTheta", ",", "deltaTheta", ",", "deltaGrad", ",", "safe", ",", 
        "noise"}], "}"}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"sH", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"ConstantArray", "[", 
           RowBox[{"0.0", ",", "n"}], "]"}], ",", "nSt"}], "]"}]}], ";", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"prevG", "=", 
        RowBox[{"hVals", " ", "theta0"}]}], ";", " ", 
       RowBox[{"prevTheta", "=", "theta0"}], ";", "\[IndentingNewLine]", "  ", 
       RowBox[{"Do", "[", "\[IndentingNewLine]", "    ", 
        RowBox[{
         RowBox[{
          RowBox[{"noise", "=", 
           RowBox[{"RandomReal", "[", 
            RowBox[{
             RowBox[{"NormalDistribution", "[", 
              RowBox[{"0", ",", "noiseScale"}], "]"}], ",", "n"}], "]"}]}], ";",
           "\[IndentingNewLine]", "    ", 
          RowBox[{"g", "=", 
           RowBox[{
            RowBox[{"hVals", " ", "theta"}], "+", "noise"}]}], ";", " ", 
          RowBox[{"g2", "=", 
           RowBox[{"g", "^", "2"}]}], ";", "\[IndentingNewLine]", "    ", 
          RowBox[{"v", "=", 
           RowBox[{"xi", " ", 
            RowBox[{"Total", "[", 
             RowBox[{
              RowBox[{"Exp", "[", "s", "]"}], " ", "g2"}], "]"}]}]}], ";", 
          " ", 
          RowBox[{"r", "=", 
           RowBox[{"1.0", "/", 
            RowBox[{"(", 
             RowBox[{"1.0", "+", 
              RowBox[{"Abs", "[", "v", "]"}]}], ")"}]}]}], ";", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"deltaTheta", "=", 
           RowBox[{"theta", "-", "prevTheta"}]}], ";", " ", 
          RowBox[{"deltaGrad", "=", 
           RowBox[{"g", "-", "prevG"}]}], ";", "\[IndentingNewLine]", "    ", 
          
          RowBox[{"safe", "=", 
           RowBox[{"Thread", "[", 
            RowBox[{
             RowBox[{"Abs", "[", "deltaTheta", "]"}], ">", "1.0*^-5"}], 
            "]"}]}], ";", "\[IndentingNewLine]", "    ", 
          RowBox[{"hHat", "=", 
           RowBox[{"MapThread", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"If", "[", 
               RowBox[{"#1", ",", 
                RowBox[{"#2", "/", "#3"}], ",", "0.0"}], "]"}], " ", "&"}], ",", 
             RowBox[{"{", 
              RowBox[{"safe", ",", "deltaGrad", ",", "deltaTheta"}], "}"}]}], 
            "]"}]}], ";", "\[IndentingNewLine]", "    ", 
          RowBox[{"prevG", "=", "g"}], ";", " ", 
          RowBox[{"prevTheta", "=", "theta"}], ";", "\[IndentingNewLine]", 
          "    ", 
          RowBox[{"theta", "=", 
           RowBox[{"theta", "-", 
            RowBox[{"eta", " ", "r", " ", 
             RowBox[{"Exp", "[", "s", "]"}], " ", "g"}]}]}], ";", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"drive", "=", 
           RowBox[{"Switch", "[", 
            RowBox[{
            "rule", ",", "\[IndentingNewLine]", "      ", "\"\<grad_mag\>\"", 
             ",", 
             RowBox[{"xi", " ", "g2"}], ",", "\[IndentingNewLine]", 
             "      ", "\"\<newton\>\"", ",", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"t", ">", "1"}], ",", 
               RowBox[{
                RowBox[{"-", "lam"}], " ", 
                RowBox[{"Log", "[", 
                 RowBox[{"MapThread", "[", 
                  RowBox[{"Max", ",", 
                   RowBox[{"{", 
                    RowBox[{"hHat", ",", 
                    RowBox[{"ConstantArray", "[", 
                    RowBox[{"eps", ",", "n"}], "]"}]}], "}"}]}], "]"}], 
                 "]"}]}], ",", "\[IndentingNewLine]", "        ", 
               RowBox[{"ConstantArray", "[", 
                RowBox[{"0.0", ",", "n"}], "]"}]}], "]"}]}], 
            "\[IndentingNewLine]", "    ", "]"}]}], ";", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"s", "=", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"1", "-", 
               RowBox[{"mu", " ", "lam"}]}], ")"}], " ", "s"}], "+", 
            RowBox[{"mu", " ", "drive"}]}]}], ";", "\[IndentingNewLine]", 
          "    ", 
          RowBox[{"s", "=", 
           RowBox[{"meanCenterClip", "[", 
            RowBox[{"s", ",", "clip"}], "]"}]}], ";", "\[IndentingNewLine]", 
          "    ", 
          RowBox[{
           RowBox[{"lossH", "[", 
            RowBox[{"[", "t", "]"}], "]"}], "=", 
           RowBox[{
            RowBox[{"Total", "[", 
             RowBox[{"hVals", " ", 
              RowBox[{"theta", "^", "2"}]}], "]"}], "/", "2"}]}], ";", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{
           RowBox[{"sH", "[", 
            RowBox[{"[", "t", "]"}], "]"}], "=", "s"}], ";"}], 
         "\[IndentingNewLine]", "  ", ",", 
         RowBox[{"{", 
          RowBox[{"t", ",", "nSt"}], "}"}]}], "]"}], ";", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"{", 
        RowBox[{"lossH", ",", "sH"}], "}"}]}]}], "\[IndentingNewLine]", 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"lossStG", ",", "sStG"}], "}"}], "=", 
   RowBox[{"simulateStoch", "[", 
    RowBox[{
    "hVals", ",", "theta0", ",", "\"\<grad_mag\>\"", ",", "20000", ",", 
     "0.1"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{"lossStN", ",", "sStN"}], "}"}], "=", 
    RowBox[{"simulateStoch", "[", 
     RowBox[{
     "hVals", ",", "theta0", ",", "\"\<newton\>\"", ",", "20000", ",", 
      "0.1"}], "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", "\"\<Stochastic gradients (noise=0.1):\>\"", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<  GradMag loss: \>\"", ",", 
    RowBox[{"lossStG", "[", 
     RowBox[{"[", 
      RowBox[{"-", "1"}], "]"}], "]"}], ",", "\"\<  metric std: \>\"", ",", 
    "\[IndentingNewLine]", "  ", 
    RowBox[{"StandardDeviation", "[", 
     RowBox[{"Flatten", "[", 
      RowBox[{"sStG", "[", 
       RowBox[{"[", 
        RowBox[{
         RowBox[{"-", "5000"}], " ", ";;"}], "]"}], "]"}], "]"}], "]"}]}], 
   "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<  Newton  loss: \>\"", ",", 
    RowBox[{"lossStN", "[", 
     RowBox[{"[", 
      RowBox[{"-", "1"}], "]"}], "]"}], ",", "\"\<  metric std: \>\"", ",", 
    "\[IndentingNewLine]", "  ", 
    RowBox[{"StandardDeviation", "[", 
     RowBox[{"Flatten", "[", 
      RowBox[{"sStN", "[", 
       RowBox[{"[", 
        RowBox[{
         RowBox[{"-", "5000"}], " ", ";;"}], "]"}], "]"}], "]"}], "]"}]}], 
   "]"}], ";"}]}], "Input",ExpressionUUID->"bb7f9cf4-792b-4396-a0f0-\
31e114e69c7b"],

Cell["Part VII: Why the Tanh Heuristic Hurts on Convex Problems", "Section",ExpressionUUID->"84960edc-edca-4b70-be98-bba54393e756"],

Cell[TextData[{
 "On a convex quadratic (all $H_{ii} > 0$), ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"tanh", 
         RowBox[{"(", 
           RowBox[{
             SubscriptBox[
              StyleBox["H", "TI"], 
              RowBox[{
                StyleBox["i", "TI"], 
                StyleBox["i", "TI"]}]], "/", "\[Tau]"}], ")"}], ">", "0"}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\tanh(H_{ii}/\\tau) > 0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "04ea46f5-b806-4557-b1d1-a26d179de381"],
 ", so the correction ",
 StyleBox["reduces",
  FontWeight->Bold],
 " the drive: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> InterpretationBox["", 
       Failure[
       "TeXAssistantError", <|
        "MessageTemplate" -> "Errors: `Errors`", 
         "MessageParameters" -> <|"Errors" -> {}|>, "Input" -> 
         "D_\\text{tanh} = \\xi g^2(1 - r\\tanh(H/\\tau)) < D_\\text{grad} = \
\\xi g^2"|>]], "errors" -> {}, "input" -> 
     "D_\\text{tanh} = \\xi g^2(1 - r\\tanh(H/\\tau)) < D_\\text{grad} = \\xi \
g^2", "state" -> "Error"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "65696672-0022-4c86-b64b-6746f0c618b2"],
 "."
}], "Text",ExpressionUUID->"495a26d0-a474-49dc-8e4c-db3d5d1da4d7"],

Cell[TextData[{
 "The correction does NOT fix the anti-Newton structure (same +0.71 \
correlation with ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"log", 
         StyleBox["h", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\log h", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "8f42744e-167b-4d8b-8f19-9a869b266b34"],
 "). It only slows convergence of the metric. On convex problems the tanh \
heuristic is purely harmful."
}], "Text",ExpressionUUID->"aed6ea45-af47-4677-a291-f11dcda19af6"],

Cell["The Newton target handles both regimes: ", "Text",ExpressionUUID->"66780d17-d457-4333-b298-230793f5e76f"],

Cell[TextData[{
 StyleBox["Convex",
  FontWeight->Bold],
 ": perfect Newton preconditioning (",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Kappa]", "\[Rule]", "1"}], TraditionalForm], "errors" -> {},
      "input" -> "\\kappa \\to 1", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "89fda7f0-a33b-4820-ab70-909fe3660bfe"],
 ")"
}], "Item",ExpressionUUID->"f293b817-81bb-4668-9fef-1eaf9c16ddf4"],

Cell[TextData[{
 StyleBox["Saddle",
  FontWeight->Bold],
 ": maximum amplification for escape (",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["s", "TI"], "\[Rule]", 
         StyleBox["c", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "s \\to c", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "1a235744-1561-4ca1-bca2-c830c5ef7980"],
 ")"
}], "Item",ExpressionUUID->"6e59d324-85ff-46d6-8b2c-f51502cf78b0"],

Cell["Summary", "Section",ExpressionUUID->"ea5bfd8c-d319-4ec0-a527-730571ed908d"],

Cell[BoxData[
 PaneBox[
  PaneBox[
   StyleBox[
    TagBox[
     TagBox[GridBox[{
        {
         TagBox["\<\"Property\"\>",
          HoldForm], 
         TagBox["\<\"Grad magnitude\"\>",
          HoldForm], 
         TagBox["\<\"Tanh heuristic\"\>",
          HoldForm], 
         TagBox["\<\"Newton target\"\>",
          HoldForm]},
        {Cell[TextData[{
          "Equilibrium correlation with ",
          Cell[BoxData[
           FormBox[
            TemplateBox[<|"boxes" -> FormBox[
                RowBox[{"log", 
                  StyleBox["h", "TI"]}], TraditionalForm], "errors" -> {}, 
              "input" -> "\\log h", "state" -> "Boxes"|>,
             "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
           "461ff239-1bc4-44ae-8c52-7bfee9813509"]
         }],ExpressionUUID->
          "5bd4dc15-1473-459b-91f4-820ee27fec61"], "\<\"+0.71 (anti-Newton)\"\
\>", "\<\"+0.71 (anti-Newton)\"\>", 
         StyleBox[
          RowBox[{
           RowBox[{"-", "1.0"}], " ", 
           RowBox[{"(", 
