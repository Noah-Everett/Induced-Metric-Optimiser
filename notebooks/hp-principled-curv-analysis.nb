Cell[TextData[{
 "The Newton-targeted driving force ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["D", "TI"], 
          StyleBox["i", "TI"]], "\[LongEqual]", "-", "\[Lambda]", "log", 
         "max", 
         RowBox[{"(", 
           RowBox[{
             SubscriptBox[
              OverscriptBox[
               StyleBox["H", "TI"], "^"], 
              RowBox[{
                StyleBox["i", "TI"], 
                StyleBox["i", "TI"]}]], ",", "\[Epsilon]"}], ")"}]}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "D_i = -\\lambda\\log\\max(\\hat{H}_{ii}, \\varepsilon)", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "3b9ab835-5ad9-4bef-bcbb-d01c7f7c920f"],
 " is the principled completion of the separation principle from IMO-83."
}], "Text",ExpressionUUID->"8ebe9f1c-b0e7-456a-aa8f-00d172460bc2"]
},
