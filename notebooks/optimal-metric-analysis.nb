Notebook[{
Cell["Optimal Learnable Metric Analysis", "Title",ExpressionUUID->"60648578-2c5f-4e5c-853b-f2f87c01232c"],

Cell["Setup: Riemannian Hessian Framework for n=2", "Section",ExpressionUUID->"c88495c2-8964-4856-b35f-58d9842e39a8"],

Cell[TextData[{
 "For the learnable diagonal metric ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["g", "TI"], "\[LongEqual]", "diag", 
         RowBox[{"(", 
           RowBox[{
             SuperscriptBox[
              StyleBox["e", "TI"], 
              SubscriptBox[
               StyleBox["s", "TI"], "1"]], ",", 
             SuperscriptBox[
              StyleBox["e", "TI"], 
              SubscriptBox[
               StyleBox["s", "TI"], "2"]]}], ")"}], "+", "\[Xi] ", 
         StyleBox["l", "TI"], "\[CircleTimes]", 
         StyleBox["l", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "g = \\text{diag}(e^{s_1}, e^{s_2}) + \\xi\\, l \\otimes l", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b5ccf931-352a-4ae4-ab07-868f813d8180"],
 ", the Riemannian Hessian is: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          RowBox[{"(", 
            RowBox[{
              SubscriptBox["Hess", 
               StyleBox["g", "TI"]], 
              StyleBox["L", "TI"]}], ")"}], 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"]}]], "\[LongEqual]", 
         FractionBox[
          RowBox[{
            SubscriptBox[
             StyleBox["H", "TI"], 
             RowBox[{
               StyleBox["i", "TI"], 
               StyleBox["j", "TI"]}]], "-", 
            SubscriptBox[
             StyleBox["C", "TI"], 
             RowBox[{
               StyleBox["i", "TI"], 
               StyleBox["j", "TI"]}]]}], 
          
          RowBox[{"1", "+", "\[Xi]", 
            "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", 
            StyleBox["l", "TI"], 
            SubsuperscriptBox[
            "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", "\[Gamma]",
              "2"]}]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "(\\text{Hess}_g L)_{ij} = \\frac{H_{ij} - C_{ij}}{1 + \\xi \
|l|^2_\\gamma}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ae8e96da-25e2-439c-a082-abb71a001c81"],
 "where ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["C", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"]}]], "\[LongEqual]", 
         SubsuperscriptBox["\[CapitalGamma]", 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"]}], 
          StyleBox["k", "TI"]], 
         RowBox[{"(", "\[Gamma]", ")"}], " ", 
         SubscriptBox[
          StyleBox["l", "TI"], 
          StyleBox["k", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "C_{ij} = \\Gamma^k_{ij}(\\gamma)\\, l_k", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "595a1963-47b5-4927-a8fa-85cf87fc2eed"],
 " is the curvature correction depending on ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Del]", 
         StyleBox["s", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\nabla s", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d9d1a81f-ee15-46fd-bcb9-312ae7300838"],
 "."
}], "Text",ExpressionUUID->"986932aa-ba6a-4d8e-a759-b2627f0a798a"],

Cell[TextData[{
 "At ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Gamma]", "\[LongEqual]", 
         StyleBox["I", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\gamma = I", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "823aa62c-2295-4c55-b3b3-4d93cddb10c4"],
 " (i.e. ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["s", "TI"], "1"], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["s", "TI"], "2"], "\[LongEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "s_1 = s_2 = 0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "2392b0f9-14c5-4087-97eb-b2293a00009e"],
 "), the correction matrix is: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["C", "TI"], "\[LongEqual]", 
         RowBox[{"(", 
           Cell[
            BoxData[
             FormBox[
              GridBox[{{
                 Cell[
                  TextData[{" ", 
                    Cell[
                    BoxData[
                    FractionBox[
                    RowBox[{
                    StyleBox["a", "TI"], " ", 
                    SubscriptBox[
                    StyleBox["l", "TI"], "1"], "-", 
                    StyleBox["b", "TI"], " ", 
                    SubscriptBox[
                    StyleBox["l", "TI"], "2"]}], "2"]], "InlineFormula"], 
                    " "}]], 
                 Cell[
                  TextData[{" ", 
                    Cell[
                    BoxData[
                    FractionBox[
                    RowBox[{
                    StyleBox["b", "TI"], " ", 
                    SubscriptBox[
                    StyleBox["l", "TI"], "1"], "+", 
                    StyleBox["c", "TI"], " ", 
                    SubscriptBox[
                    StyleBox["l", "TI"], "2"]}], "2"]], "InlineFormula"], 
                    " "}]]}, {
                 Cell[
                  TextData[{" ", 
                    Cell[
                    BoxData[
                    FractionBox[
                    RowBox[{
                    StyleBox["b", "TI"], " ", 
                    SubscriptBox[
                    StyleBox["l", "TI"], "1"], "+", 
                    StyleBox["c", "TI"], " ", 
                    SubscriptBox[
                    StyleBox["l", "TI"], "2"]}], "2"]], "InlineFormula"], 
                    " "}]], 
                 Cell[
                  TextData[{" ", 
                    Cell[
                    BoxData[
                    FractionBox[
                    RowBox[{"-", 
                    StyleBox["c", "TI"], " ", 
                    SubscriptBox[
                    StyleBox["l", "TI"], "1"], "+", 
                    StyleBox["d", "TI"], " ", 
                    SubscriptBox[
                    StyleBox["l", "TI"], "2"]}], "2"]], "InlineFormula"], 
                    " "}]]}}], TraditionalForm]]], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "C = \\begin{pmatrix} \\frac{a\\, l_1 - b\\, l_2}{2} & \\frac{b\\, l_1 + \
c\\, l_2}{2} \\\\ \\frac{b\\, l_1 + c\\, l_2}{2} & \\frac{-c\\, l_1 + d\\, \
l_2}{2} \\end{pmatrix}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d3491349-914f-4cf4-a2ef-854b18281a8d"],
 "where ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["a", "TI"], "\[LongEqual]", "\[PartialD]", 
         SubscriptBox[
          StyleBox["s", "TI"], "1"], "/", "\[PartialD]", 
         SuperscriptBox["\[Theta]", "1"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "a = \\partial s_1/\\partial\\theta^1", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "014f660c-cc28-4d52-b1e2-361d0352b7d0"],
 ", ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["b", "TI"], "\[LongEqual]", "\[PartialD]", 
         SubscriptBox[
          StyleBox["s", "TI"], "1"], "/", "\[PartialD]", 
         SuperscriptBox["\[Theta]", "2"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "b = \\partial s_1/\\partial\\theta^2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "06afb83e-8d6c-43fa-8546-1cc283a37ecd"],
 ", ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["c", "TI"], "\[LongEqual]", "\[PartialD]", 
         SubscriptBox[
          StyleBox["s", "TI"], "2"], "/", "\[PartialD]", 
         SuperscriptBox["\[Theta]", "1"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "c = \\partial s_2/\\partial\\theta^1", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "03bf971e-9695-4551-b5f4-7fac2a8219d4"],
 ", ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["d", "TI"], "\[LongEqual]", "\[PartialD]", 
         SubscriptBox[
          StyleBox["s", "TI"], "2"], "/", "\[PartialD]", 
         SuperscriptBox["\[Theta]", "2"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "d = \\partial s_2/\\partial\\theta^2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "41f0e398-1ec9-498a-ae71-7919a5d495f8"],
 ". "
}], "Text",ExpressionUUID->"2452cb16-431a-43ed-abf3-80f934e76e99"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Christoffel", " ", "symbols", " ", "at", " ", "gamma"}], "=", 
    RowBox[{"I", " ", "for", " ", "diagonal", " ", "metric"}]}], " ", 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dsm", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"a", ",", "b"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"c", ",", "d"}], "}"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"l", "=", 
    RowBox[{"{", 
     RowBox[{"l1", ",", "l2"}], "}"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"christoffelSymb", "[", 
     RowBox[{"k_", ",", "i_", ",", "j_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"val", "=", "0"}], ",", 
        RowBox[{"s", "=", 
         RowBox[{"{", 
          RowBox[{"s1", ",", "s2"}], "}"}]}]}], "}"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"j", "==", "k"}], ",", 
         RowBox[{"val", " ", "+=", " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", "/", "2"}], ")"}], " ", 
           RowBox[{"Exp", "[", 
            RowBox[{
             RowBox[{"s", "[", 
              RowBox[{"[", "j", "]"}], "]"}], "-", 
             RowBox[{"s", "[", 
              RowBox[{"[", "k", "]"}], "]"}]}], "]"}], " ", 
           RowBox[{"dsm", "[", 
            RowBox[{"[", 
             RowBox[{"j", ",", "i"}], "]"}], "]"}]}]}]}], "]"}], ";", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"i", "==", "k"}], ",", 
         RowBox[{"val", " ", "+=", " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", "/", "2"}], ")"}], " ", 
           RowBox[{"Exp", "[", 
            RowBox[{
             RowBox[{"s", "[", 
              RowBox[{"[", "i", "]"}], "]"}], "-", 
             RowBox[{"s", "[", 
              RowBox[{"[", "k", "]"}], "]"}]}], "]"}], " ", 
           RowBox[{"dsm", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", "j"}], "]"}], "]"}]}]}]}], "]"}], ";", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"i", "==", "j"}], ",", 
         RowBox[{"val", " ", "-=", " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", "/", "2"}], ")"}], " ", 
           RowBox[{"Exp", "[", 
            RowBox[{
             RowBox[{"s", "[", 
              RowBox[{"[", "i", "]"}], "]"}], "-", 
             RowBox[{"s", "[", 
              RowBox[{"[", "k", "]"}], "]"}]}], "]"}], " ", 
           RowBox[{"dsm", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", "k"}], "]"}], "]"}]}]}]}], "]"}], ";", 
       "\[IndentingNewLine]", "  ", "val"}]}], "\[IndentingNewLine]", "]"}]}],
    ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"corrC", "[", 
    RowBox[{"i_", ",", "j_"}], "]"}], ":=", 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"christoffelSymb", "[", 
       RowBox[{"k", ",", "i", ",", "j"}], "]"}], "*", 
      RowBox[{"l", "[", 
       RowBox[{"[", "k", "]"}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"k", ",", "1", ",", "2"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Cmat", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"corrC", "[", 
      RowBox[{"i", ",", "j"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", "2"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "1", ",", "2"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"CmatAtI", "=", 
    RowBox[{
     RowBox[{"Cmat", " ", "/.", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"s1", "->", "0"}], ",", 
        RowBox[{"s2", "->", "0"}]}], "}"}]}], " ", "//", " ", "Simplify"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", "\"\<Correction matrix C at \[Gamma] = I:\>\"", "]"}],
   ";"}], "\[IndentingNewLine]", 
 RowBox[{"CmatAtI", " ", "//", " ", "MatrixForm"}]}], "Input",ExpressionUUID->\
"09ad8710-e434-485b-8d1a-7cfde9eafeb2"],

Cell["Test Functions", "Section",ExpressionUUID->"20142df6-980a-4807-915b-72f9b30fd535"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{"x", ",", "y"}], "]"}], ";"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", "Saddle", " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Lsaddle", "=", 
   RowBox[{
    RowBox[{"x", "^", "2"}], "-", 
    RowBox[{"y", "^", "2"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"gradSaddle", "=", 
   RowBox[{"D", "[", 
    RowBox[{"Lsaddle", ",", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"x", ",", "y"}], "}"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"hessSaddle", "=", 
    RowBox[{"D", "[", 
     RowBox[{"Lsaddle", ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"x", ",", "y"}], "}"}], ",", "2"}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", "Rosenbrock", " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Lrosen", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "-", "x"}], ")"}], "^", "2"}], "+", 
    RowBox[{"100", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"y", "-", 
        RowBox[{"x", "^", "2"}]}], ")"}], "^", "2"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"gradRosen", "=", 
   RowBox[{"D", "[", 
    RowBox[{"Lrosen", ",", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"x", ",", "y"}], "}"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"hessRosen", "=", 
    RowBox[{"D", "[", 
     RowBox[{"Lrosen", ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"x", ",", "y"}], "}"}], ",", "2"}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"Asymmetric", " ", "saddle"}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Lasym", "=", 
   RowBox[{
    RowBox[{"x", "^", "2"}], "-", 
    RowBox[{"3", " ", 
     RowBox[{"y", "^", "2"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"gradAsym", "=", 
   RowBox[{"D", "[", 
    RowBox[{"Lasym", ",", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"x", ",", "y"}], "}"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"hessAsym", "=", 
    RowBox[{"D", "[", 
     RowBox[{"Lasym", ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"x", ",", "y"}], "}"}], ",", "2"}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"Monkey", " ", "saddle"}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Lmonkey", "=", 
   RowBox[{
    RowBox[{"x", "^", "3"}], "-", 
    RowBox[{"3", " ", "x", " ", 
     RowBox[{"y", "^", "2"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"gradMonkey", "=", 
   RowBox[{"D", "[", 
    RowBox[{"Lmonkey", ",", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"x", ",", "y"}], "}"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"hessMonkey", "=", 
   RowBox[{"D", "[", 
    RowBox[{"Lmonkey", ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", "y"}], "}"}], ",", "2"}], "}"}]}], "]"}]}], 
  ";"}]}], "Input",ExpressionUUID->"e9148bbe-89ea-428b-8661-41e28425c20c"],

Cell["\<\
Part A: Optimal lambda_min vs Gradient Budget R (Diagonal Case)\
\>", "Section",ExpressionUUID->"f2a5d910-38c8-43c6-83cc-96a63d28ac72"],

Cell[TextData[{
 "We optimize ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Lambda]", "min"], "(", 
         RowBox[{
           SubscriptBox["Hess", 
            StyleBox["g", "TI"]], 
           StyleBox["L", "TI"]}], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\lambda_{\\min}(\\text{Hess}_g L)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5c517a84-f181-47ee-9625-cb2988453984"],
 " over the 4 free parameters $(a, b, c, d)$ subject to ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["a", "TI"], "2"], "+", 
         SuperscriptBox[
          StyleBox["b", "TI"], "2"], "+", 
         SuperscriptBox[
          StyleBox["c", "TI"], "2"], "+", 
         SuperscriptBox[
          StyleBox["d", "TI"], "2"], "\[LessEqual]", 
         SuperscriptBox[
          StyleBox["R", "TI"], "2"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "a^2 + b^2 + c^2 + d^2 \\le R^2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "89c483f4-c7cd-4854-9428-852090cd3263"],
 ". "
}], "Text",ExpressionUUID->"cc3fe987-a096-4dd3-af08-021ff97da5c2"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "optimalNablaS", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"optimalNablaS", "[", 
    RowBox[{"Hmat_List", ",", "lvec_List", ",", 
     RowBox[{"rr_", "?", "NumericQ"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"Cgen", ",", "Mgen", ",", "denom", ",", "res"}], "}"}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"Cgen", "=", 
       RowBox[{"CmatAtI", " ", "/.", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"l1", "->", 
           RowBox[{"lvec", "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], ",", 
          RowBox[{"l2", "->", 
           RowBox[{"lvec", "[", 
            RowBox[{"[", "2", "]"}], "]"}]}]}], "}"}]}]}], ";", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"Mgen", "=", 
       RowBox[{"Hmat", "-", "Cgen"}]}], ";", "\[IndentingNewLine]", "  ", 
      RowBox[{"denom", "=", 
       RowBox[{"1", "+", 
        RowBox[{"lvec", " ", ".", " ", "lvec"}]}]}], ";", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"rr", "==", "0"}], ",", "\[IndentingNewLine]", "    ", 
        RowBox[{"res", "=", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"Min", "[", 
             RowBox[{"Eigenvalues", "[", 
              RowBox[{"N", "[", "Hmat", "]"}], "]"}], "]"}], "/", "denom"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"a", "->", "0"}], ",", 
             RowBox[{"b", "->", "0"}], ",", 
             RowBox[{"c", "->", "0"}], ",", 
             RowBox[{"d", "->", "0"}]}], "}"}]}], "}"}]}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"res", "=", 
         RowBox[{"NMaximize", "[", "\[IndentingNewLine]", "      ", 
