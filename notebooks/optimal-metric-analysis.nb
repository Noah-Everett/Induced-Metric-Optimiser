Cell["Root Cause", "Subsection",ExpressionUUID->"2eed20ac-fdfc-47fe-ade9-c691804b58e4"],

Cell[TextData[{
 "For the saddle at $(1,1)$ with ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["l", "TI"], "\[LongEqual]", 
         RowBox[{"(", 
           RowBox[{"2", ",", "-2"}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> "l = (2,-2)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0101679d-485d-4184-90fa-8c02edda5ac2"],
 ": since ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubsuperscriptBox[
          StyleBox["l", "TI"], "1", "2"], "\[LongEqual]", 
         SubsuperscriptBox[
          StyleBox["l", "TI"], "2", "2"], "\[LongEqual]", "4"}], 
       TraditionalForm], "errors" -> {}, "input" -> "l_1^2 = l_2^2 = 4", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "23c2114e-4deb-4e71-8729-d625f0986c5d"],
 ", the online rule gives ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["a", "TI"], "\[LongEqual]", 
         StyleBox["d", "TI"], "\[LongEqual]", "8", "/", 
         RowBox[{"(", 
           RowBox[{
             SubscriptBox["\[Lambda]", 
              StyleBox["s", "TI"]], "-", "4"}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> "a = d = 8/(\\lambda_s - 4)", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "27fce485-d6f4-4c14-b824-1c41aaa756d2"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["b", "TI"], "\[LongEqual]", 
         StyleBox["c", "TI"], "\[LongEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "b = c = 0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "28a0c9b7-1ba1-4acd-a162-c807c914c67b"],
 "."
}], "Text",ExpressionUUID->"c6034313-7740-472e-b80a-b002a1657f8e"],

Cell[TextData[{
 "The trace correction is: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"tr", 
         RowBox[{"(", 
           StyleBox["C", "TI"], ")"}], "\[LongEqual]", 
         FractionBox[
          RowBox[{
            RowBox[{"(", 
              RowBox[{
                StyleBox["a", "TI"], "-", 
                StyleBox["c", "TI"]}], ")"}], " ", 
            SubscriptBox[
             StyleBox["l", "TI"], "1"], "+", 
            RowBox[{"(", 
              RowBox[{
                StyleBox["d", "TI"], "-", 
                StyleBox["b", "TI"]}], ")"}], " ", 
            SubscriptBox[
             StyleBox["l", "TI"], "2"]}], "2"], "\[LongEqual]", 
         FractionBox[
          RowBox[{
            StyleBox["a", "TI"], "\[CenterDot]", "2", "+", 
            StyleBox["d", "TI"], "\[CenterDot]", 
            RowBox[{"(", "-2", ")"}]}], "2"], "\[LongEqual]", 
         StyleBox["a", "TI"], "-", 
         StyleBox["d", "TI"], "\[LongEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\text{tr}(C) = \\frac{(a-c)\\,l_1 + (d-b)\\,l_2}{2} = \\frac{a \\cdot \
2 + d \\cdot (-2)}{2} = a - d = 0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e4a7c885-e2c8-41a6-b75e-e4447eb2f172"],
 "**The online rule creates zero trace shift because ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["a", "TI"], "\[LongEqual]", 
         StyleBox["d", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "a = d", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "4b677760-ff43-4493-b6fa-e4c6ad99a874"],
 " (both scales adapt identically when ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubsuperscriptBox[
          StyleBox["l", "TI"], "1", "2"], "\[LongEqual]", 
         SubsuperscriptBox[
          StyleBox["l", "TI"], "2", "2"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "l_1^2 = l_2^2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "7d9b9921-73da-4c55-8b4a-6527b91a6d40"],
 ").** The diagonal degree of freedom is completely wasted."
}], "Text",ExpressionUUID->"c908868c-bd05-4b8f-98ed-67132449118a"],

Cell[TextData[{
 "The optimal requires ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["a", "TI"], "\[LessLess]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "a \\ll 0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5ebb2a18-b98a-4f47-90d1-e0970c8a1746"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["d", "TI"], "\[GreaterGreater]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "d \\gg 0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "9d63241d-284a-4723-a4c7-94d360db44a5"],
 " (anti-correlated with the Hessian diagonal), which the current rule cannot \
produce. "
}], "Text",ExpressionUUID->"f750fe9c-3936-44a9-b437-2aa22a85a0d1"],

Cell["Part D: Structure of the Optimal Gradient", "Section",ExpressionUUID->"294e6ce1-62f2-41be-ab69-21c1f1df39af"],

Cell["Pattern", "Subsection",ExpressionUUID->"6246a324-b848-4a67-8fe0-a774d0768108"],

Cell[TextData[{
 "For diagonal ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["H", "TI"], TraditionalForm], "errors" -> {}, "input" -> "H", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "fa6fbea7-b00e-4d37-bab3-ac101f1afb15"],
 " at ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Gamma]", "\[LongEqual]", 
         StyleBox["I", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\gamma = I", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "6a9f16af-e460-4d21-9b93-d2c97c685fa7"],
 ", the optimal ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Del]", 
         StyleBox["s", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\nabla s", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ae1677d4-c7ca-4301-b348-36d6e9044128"],
 " at large budget ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["R", "TI"], TraditionalForm], "errors" -> {}, "input" -> "R", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "25eebdc6-51a7-4dc1-ab85-a06c313e1814"],
 ":"
}], "Text",ExpressionUUID->"7b27aa61-9c34-45d3-b817-368e74804f8a"],

Cell[TextData[{
 "1. ",
 StyleBox["Off-diagonal zeroing:",
  FontWeight->Bold],
 " ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["c", "TI"], "\[LongEqual]", "-", 
         StyleBox["b", "TI"], " ", 
         SubscriptBox[
          StyleBox["l", "TI"], "1"], "/", 
         SubscriptBox[
          StyleBox["l", "TI"], "2"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "c = -b\\,l_1/l_2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "cfeb93ef-7f72-4958-b63c-6265f13692eb"],
 " (makes ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["Hess", 
          StyleBox["g", "TI"]], 
         StyleBox["L", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\text{Hess}_g L", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "bc34eb34-9905-42a1-9bb1-f2e2f4fedeed"],
 " diagonal)"
}], "Text",ExpressionUUID->"b310bfb5-5541-4716-afa4-50bfde9c60ec"],

Cell[TextData[{
 "2. ",
 StyleBox["Equal eigenvalues:",
  FontWeight->Bold],
 " ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["a", "TI"], "+", "2", 
         StyleBox["b", "TI"], "+", 
         StyleBox["d", "TI"], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["h", "TI"], "1"], "-", 
         SubscriptBox[
          StyleBox["h", "TI"], "2"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "a + 2b + d = h_1 - h_2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ef940b32-25fa-4f22-96e9-4d11c569e5b4"],
 " (equalizes the two eigenvalues)"
}], "Text",ExpressionUUID->"42f8b3a7-ffbb-4f2d-aefd-359a590164a6"],

Cell[TextData[{
 "3. ",
 StyleBox["Anti-correlation:",
  FontWeight->Bold],
 " ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[PartialD]", 
         SubscriptBox[
          StyleBox["s", "TI"], 
          StyleBox["i", "TI"]], "/", "\[PartialD]", 
         SuperscriptBox["\[Theta]", 
          StyleBox["i", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\partial s_i / \\partial \\theta^i", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "390aad29-ca21-477c-8589-13188b9c9b28"],
 " is anti-correlated with $H_{ii}$ "
}], "Text",ExpressionUUID->"982aed93-f73d-4e40-9347-9d38ab23a9db"],

Cell[TextData[{
 "Where curvature is positive ($H",
 StyleBox["{ii} > 0$): $\\partial s",
  FontSlant->Italic],
 "i / \\partial \\theta^i < 0$ (shrink scale)"
}], "Subitem",ExpressionUUID->"ecaa1359-cd94-4382-ab54-5f8f48002edd"],

Cell[TextData[{
 "Where curvature is negative ($H",
 StyleBox["{ii} < 0$): $\\partial s",
  FontSlant->Italic],
 "i / \\partial \\theta^i > 0$ (grow scale)"
}], "Subitem",ExpressionUUID->"94c47e9a-969b-4bad-afbf-e457933e3f00"],

Cell["Physical Interpretation", "Subsection",ExpressionUUID->"90ef5fe5-ede6-455f-a414-07f630558078"],

Cell[TextData[{
 "The Christoffel correction $C_{ij}$ acts as a ",
 StyleBox["curvature redistribution",
  FontWeight->Bold],
 ": it transfers curvature from positive-curvature directions to \
negative-curvature directions, equalizing the eigenvalue spectrum. The \
diagonal metric's extra freedom (",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Del]", 
         SubscriptBox[
          StyleBox["s", "TI"], "1"], "\[NotEqual]", "\[Del]", 
         SubscriptBox[
          StyleBox["s", "TI"], "2"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\nabla s_1 \\ne \\nabla s_2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0667c73e-d785-4a04-a292-7790e35d33e9"],
 ") is what enables this redistribution via a nonzero trace shift. "
}], "Text",ExpressionUUID->"4f0429bc-83d5-49c9-93b2-459fc7520203"],

Cell["Summary and Recommendations", "Section",ExpressionUUID->"d9a2d9d7-8630-4052-9bd9-1b94dd6cf25b"],

Cell["Finding 1: Diagonal is Strictly Necessary", "Subsection",ExpressionUUID->"4c1af736-f393-4472-9db9-90c6853bf26b"],

Cell[TextData[{
 "Scalar learnable metric (",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["s", "TI"], "1"], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["s", "TI"], "2"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "s_1 = s_2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "bde842c3-e66e-4f82-8ca3-04de04c958fd"],
 ") provably cannot achieve sign flip when ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"tr", 
         RowBox[{"(", 
           StyleBox["H", "TI"], ")"}], "\[LessEqual]", "0"}], 
       TraditionalForm], "errors" -> {}, "input" -> "\\text{tr}(H) \\le 0", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c2caba40-8981-4b40-9acd-84b8c29692a6"],
 ", because ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"tr", 
         RowBox[{"(", 
           StyleBox["C", "TI"], ")"}], "\[LongEqual]", "0"}], 
       TraditionalForm], "errors" -> {}, "input" -> "\\text{tr}(C) = 0", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "7551afd9-91e7-45cf-bd61-7581c0853aa7"],
 " identically. Diagonal learnable metric CAN achieve sign flip for any \
indefinite ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["H", "TI"], TraditionalForm], "errors" -> {}, "input" -> "H", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "efa19ef6-5c91-4b9f-928a-f7c9b9e35ddd"],
 ", given sufficient ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
        "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", "\[Del]", 
         StyleBox["s", "TI"], 
         "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9"}], 
       TraditionalForm], "errors" -> {}, "input" -> "|\\nabla s|", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0f6db715-ca26-467f-937c-69f4fcc94e5f"],
 " budget. "
}], "Text",ExpressionUUID->"52e51482-a089-4ce9-a63a-bce133ed1999"],

Cell["Finding 2: Current Rule Wastes Diagonal Freedom", "Subsection",ExpressionUUID->"1e0ac9cb-7533-48fe-8fa1-dd6a0b9ecf98"],

Cell[TextData[{
 "The online rule ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["s", "TI"], 
          StyleBox["i", "TI"]], "\[LeftArrow]", 
         SubscriptBox[
          StyleBox["s", "TI"], 
          StyleBox["i", "TI"]], "+", "\[Mu]\[Xi]", 
         SuperscriptBox[
          StyleBox["e", "TI"], 
          SubscriptBox[
           StyleBox["s", "TI"], 
           StyleBox["i", "TI"]]], 
         SubsuperscriptBox[
          StyleBox["l", "TI"], 
          StyleBox["i", "TI"], "2"], "-", 
         SubscriptBox["\[Mu]\[Lambda]", 
          StyleBox["s", "TI"]], 
         SubscriptBox[
          StyleBox["s", "TI"], 
          StyleBox["i", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "s_i \\leftarrow s_i + \\mu\\xi e^{s_i} l_i^2 - \\mu\\lambda_s s_i", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "6acbb7ba-1f41-49c4-abcf-40ca287ec7c5"],
 " produces ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Del]", 
         StyleBox["s", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\nabla s", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "3523ce8f-460d-4ee6-9ca2-7a63f1126da3"],
 " proportional to $l",
 StyleBox["i H",
  FontSlant->Italic],
 "{ij}$, which gives ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["a", "TI"], "\[LongEqual]", 
         StyleBox["d", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "a = d", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b465d193-d7be-47d3-b576-85575c2e84e3"],
 " at symmetric saddles (zero trace correction). It never achieves sign flip \
on any test case. "
}], "Text",ExpressionUUID->"022bdea2-e220-4952-b0fa-eeafe8833545"],

Cell["Finding 3: Optimal nabla-s is Anti-Correlated with Curvature", \
"Subsection",ExpressionUUID->"c61f9147-3c9e-4d6b-b193-8c75ba8efca6"],

Cell[TextData[{
 "The optimal gradient of the scale parameters has ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[PartialD]", 
         SubscriptBox[
          StyleBox["s", "TI"], 
          StyleBox["i", "TI"]], "/", "\[PartialD]", 
         SuperscriptBox["\[Theta]", 
          StyleBox["i", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\partial s_i / \\partial \\theta^i", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d3f1d4c4-6da2-4c08-b6c3-f6867252b0a0"],
 " anti-correlated with $H_{ii}$: shrink the metric scale along \
positive-curvature directions, grow it along negative-curvature directions. \
This creates a positive trace shift that raises both eigenvalues. "
}], "Text",ExpressionUUID->"c30a1c95-16e8-4523-b8d6-8045d0415521"],

Cell["\<\
Finding 4: Better Update Rule Must Include Curvature Information\
\>", "Subsection",ExpressionUUID->"4d9ec338-1f5b-4d9d-9777-4da15ad256bc"],

Cell[TextData[{
 "A better rule should target ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[PartialD]", 
         SubscriptBox[
          StyleBox["s", "TI"], 
          StyleBox["i", "TI"]], "/", "\[PartialD]", 
         SuperscriptBox["\[Theta]", 
          StyleBox["i", "TI"]], "\[Proportional]", "-", 
         RowBox[{"(", 
           RowBox[{
             SubscriptBox[
              StyleBox["H", "TI"], 
              RowBox[{
                StyleBox["i", "TI"], 
                StyleBox["i", "TI"]}]], "-", 
             OverscriptBox[
              StyleBox["H", "TI"], "_"]}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\partial s_i / \\partial \\theta^i \\propto -(H_{ii} - \\bar{H})", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e7e1325c-8ab9-4a7c-b0b1-1727aa51c7ba"],
 " where ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       OverscriptBox[
        StyleBox["H", "TI"], "_"], TraditionalForm], "errors" -> {}, "input" -> 
     "\\bar{H}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ab3b31c2-0a76-4be0-836c-ac9cb6d5a6cd"],
 " is the mean diagonal curvature. One concrete proposal: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["s", "TI"], 
          StyleBox["i", "TI"]], "\[LeftArrow]", 
         SubscriptBox[
          StyleBox["s", "TI"], 
          StyleBox["i", "TI"]], "+", "\[Mu]", 
         RowBox[{"[", 
           RowBox[{"\[Xi] ", 
             SuperscriptBox[
              StyleBox["e", "TI"], 
              SubscriptBox[
               StyleBox["s", "TI"], 
               StyleBox["i", "TI"]]], " ", 
             SubsuperscriptBox[
              StyleBox["l", "TI"], 
              StyleBox["i", "TI"], "2"], "-", "\[Alpha] ", "sign", 
             RowBox[{"(", 
               SubscriptBox[
                StyleBox["H", "TI"], 
                RowBox[{
                  StyleBox["i", "TI"], 
                  StyleBox["i", "TI"]}]], ")"}], " ", 
             SuperscriptBox[
              StyleBox["e", "TI"], 
              SubscriptBox[
               StyleBox["s", "TI"], 
               StyleBox["i", "TI"]]], " ", "|", 
             SubscriptBox[
              StyleBox["l", "TI"], 
              StyleBox["i", "TI"]], 
             SuperscriptBox["|", "2"]}], "]"}], "-", "\[Mu] ", 
         SubscriptBox["\[Lambda]", 
          StyleBox["s", "TI"]], " ", 
         SubscriptBox[
          StyleBox["s", "TI"], 
          StyleBox["i", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "s_i \\leftarrow s_i + \\mu\\left[\\xi\\, e^{s_i}\\, l_i^2 - \\alpha\\, \
\\text{sign}(H_{ii})\\, e^{s_i}\\, |l_i|^2\\right] - \\mu\\,\\lambda_s\\, \
s_i", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "471c8b99-6475-49bb-9a62-9e3430f14f78"],
 "The key insight: the update must ",
 StyleBox["distinguish directions by their curvature sign",
  FontWeight->Bold],
 ", not just by gradient magnitude. The term ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"-", "\[Alpha] ", "sign", 
         RowBox[{"(", 
           SubscriptBox[
            StyleBox["H", "TI"], 
            RowBox[{
              StyleBox["i", "TI"], 
              StyleBox["i", "TI"]}]], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> "-\\alpha\\,\\text{sign}(H_{ii})", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "df00fea6-65ad-4d04-96d1-c2b8482a8876"],
 " creates the anti-correlation that the current rule lacks. "
}], "Text",ExpressionUUID->"93c317e9-ec28-40fe-81b6-a4eb4e110789"],

Cell["Quantitative Benchmarks", "Subsection",ExpressionUUID->"a1a47201-668a-43e5-a514-fbf76a068be1"],

Cell[BoxData[
 PaneBox[
  PaneBox[
   StyleBox[
    TagBox[
     TagBox[GridBox[{
        {
         TagBox["\<\"Scenario\"\>",
          HoldForm], 
         TagBox["\<\"No correction\"\>",
          HoldForm], 
         TagBox["\<\"Current rule (best lambda_s)\"\>",
          HoldForm], 
         TagBox["\<\"Optimal (R=5)\"\>",
          HoldForm]},
        {"\<\"Saddle at (1,1)\"\>", "\<\"-0.222\"\>", "\<\"-0.074\"\>", 
         StyleBox[
          RowBox[{"+", "0.360"}],
          FontWeight->Bold]},
        {"\<\"Asym saddle at (1,1)\"\>", "\<\"-0.146\"\>", "\<\"+0.045 \
(lucky)\"\>", 
         StyleBox[
          RowBox[{"+", "0.182"}],
          FontWeight->Bold]},
        {"\<\"Monkey saddle at (1,0)\"\>", "\<\"-0.600\"\>", "\<\"-0.600\"\>", 
         StyleBox[
          RowBox[{"+", "0.150"}],
          FontWeight->Bold]},
        {"\<\"Monkey saddle at (1,1)\"\>", "\<\"-0.229\"\>", "\<\"-0.051\"\>", 
         StyleBox[
          RowBox[{"+", "0.207"}],
          FontWeight->Bold]}
       },
       GridBoxAlignment->{
        "Columns" -> {Center, Center, Center, {Center}}, 
         "Rows" -> {{Baseline}}},
       GridBoxDividers->{
        "Columns" -> {{False}}, "Rows" -> {False, True, {False}, False}},
       GridBoxSpacings->{"Columns" -> {
           Offset[0.27999999999999997`], {
            Offset[2.0999999999999996`]}, 
           Offset[0.27999999999999997`]}, "Rows" -> {
           Offset[0.2], {
            Offset[0.4]}, 
           Offset[0.2]}}],
      {None, OutputFormsDump`HeadedColumns}],
     Function[BoxForm`e$, 
      TableForm[
      BoxForm`e$, 
       TableHeadings -> {
        None, {"Scenario", "No correction", "Current rule (best lambda_s)", 
          "Optimal (R=5)"}}]]], "Text",
    StripOnInput->False,
    ShowStringCharacters->False],
   ImageMargins->{{0, 0}, {5, 5}}],
  ImageMargins->{{0, 0}, {5, 5}}]], "TextTableForm", \
"Text",ExpressionUUID->"773d8fdf-c9b2-46ed-a5fb-9a3541d147fb"]
},
FrontEndVersion->"14.3 for Mac OS X ARM (64-bit) (July 8, 2025)",
