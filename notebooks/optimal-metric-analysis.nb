        None, {"Point", "No correction", "Scalar bound", "Scalar best", 
          "Diag R=5", "Diag R=10"}}]]], "Text",
    StripOnInput->False,
    ShowStringCharacters->False],
   ImageMargins->{{0, 0}, {5, 5}}],
  ImageMargins->{{0, 0}, {5, 5}}]], "TextTableForm", \
"Text",ExpressionUUID->"98bf4460-fa40-4f13-a4bb-ae457b2a5bc9"],

Cell["Part B: Key Theorem -- Scalar Case Cannot Flip Signs", "Section",ExpressionUUID->"10eacf54-16a6-4df5-bb2d-db4f28dcde72"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Trace", " ", "of", " ", "the", " ", "correction", " ", "matrix"}],
    " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"trC", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"CmatAtI", "[", 
        RowBox[{"[", 
         RowBox[{"1", ",", "1"}], "]"}], "]"}], "+", 
       RowBox[{"CmatAtI", "[", 
        RowBox[{"[", 
         RowBox[{"2", ",", "2"}], "]"}], "]"}]}], " ", "//", " ", 
      "Simplify"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<tr(C) at \[Gamma]=I = \>\"", ",", "trC"}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"Scalar", " ", 
       RowBox[{"case", ":", " ", "a"}]}], "=", 
      RowBox[{"c", "=", "p"}]}], ",", " ", 
     RowBox[{"b", "=", 
      RowBox[{"d", "=", "q"}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"trCscalar", "=", 
     RowBox[{
      RowBox[{"trC", " ", "/.", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"a", "->", "p"}], ",", 
         RowBox[{"c", "->", "p"}], ",", 
         RowBox[{"b", "->", "q"}], ",", 
         RowBox[{"d", "->", "q"}]}], "}"}]}], " ", "//", " ", "Simplify"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<tr(C) scalar = \>\"", ",", "trCscalar", 
      ",", "\"\< = 0 always\>\""}], "]"}], ";"}]}]}]], "Input",ExpressionUUID->\
"42e9e96a-c02c-4ae4-8768-84b7469a7846"],

Cell[TextData[{
 StyleBox["Theorem.",
  FontWeight->Bold],
 " In the scalar case (",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["s", "TI"], "1"], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["s", "TI"], "2"], "\[LongEqual]", 
         StyleBox["s", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "s_1 = s_2 = s", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "7011db8c-7b32-423b-9b52-cac103931782"],
 "), we have ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"tr", 
         RowBox[{"(", 
           StyleBox["C", "TI"], ")"}], "\[LongEqual]", "0"}], 
       TraditionalForm], "errors" -> {}, "input" -> "\\text{tr}(C) = 0", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "7d1423ed-5dc5-4a22-b613-5771bd7c544a"],
 " identically, so ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"tr", 
         RowBox[{"(", 
           RowBox[{
             SubscriptBox["Hess", 
              StyleBox["g", "TI"]], 
             StyleBox["L", "TI"]}], ")"}], "\[LongEqual]", "tr", 
         RowBox[{"(", 
           StyleBox["H", "TI"], ")"}], "/", 
         RowBox[{"(", 
           
           RowBox[{"1", "+", "\[Xi]", 
             "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", 
             StyleBox["l", "TI"], 
             SuperscriptBox[
             "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", "2"]}], 
           ")"}]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\text{tr}(\\text{Hess}_g L) = \\text{tr}(H) / (1 + \\xi|l|^2)", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "17af48d9-9a24-474d-b87b-3875414670d5"],
 ". For any ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["H", "TI"], TraditionalForm], "errors" -> {}, "input" -> "H", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "cae704f5-14ce-4b32-b4d0-fa53600bc888"],
 " with ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"tr", 
         RowBox[{"(", 
           StyleBox["H", "TI"], ")"}], "\[LessEqual]", "0"}], 
       TraditionalForm], "errors" -> {}, "input" -> "\\text{tr}(H) \\le 0", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e764a83e-de96-4d43-9036-7a972f480540"],
 " (including all symmetric saddles), ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Lambda]", "min"], 
         RowBox[{"(", 
           RowBox[{
             SubscriptBox["Hess", 
              StyleBox["g", "TI"]], 
             StyleBox["L", "TI"]}], ")"}], "\[LessEqual]", "0"}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\lambda_{\\min}(\\text{Hess}_g L) \\le 0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0ae54b8f-1656-449f-89c7-3a7c910cd3ed"],
 " regardless of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Del]", 
         StyleBox["s", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\nabla s", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "978e0d50-f35a-4316-8997-7367eee0f16e"],
 ".",
 StyleBox["Proof.",
  FontSlant->Italic],
 " In the scalar case, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["a", "TI"], "\[LongEqual]", 
         StyleBox["c", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "a = c", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c2a0ecf8-2b5e-461d-8e53-9208a27a525d"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["b", "TI"], "\[LongEqual]", 
         StyleBox["d", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "b = d", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "4a6f8884-d30a-4a36-b21e-d1c87be0c8fb"],
 ", so ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"tr", 
         RowBox[{"(", 
           StyleBox["C", "TI"], ")"}], "\[LongEqual]", 
         RowBox[{"(", 
           RowBox[{
             RowBox[{"(", 
               RowBox[{
                 StyleBox["a", "TI"], "-", 
                 StyleBox["c", "TI"]}], ")"}], 
             SubscriptBox[
              StyleBox["l", "TI"], "1"], "+", 
             RowBox[{"(", 
               RowBox[{
                 StyleBox["d", "TI"], "-", 
                 StyleBox["b", "TI"]}], ")"}], 
             SubscriptBox[
              StyleBox["l", "TI"], "2"]}], ")"}], "/", "2", "\[LongEqual]", 
         "0"}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\text{tr}(C) = ((a-c)l_1 + (d-b)l_2)/2 = 0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "3ef2d50b-9c9a-4104-8fb2-eb2fca568c0d"],
 "."
}], "Text",ExpressionUUID->"560a20d0-1c96-4fc2-8b0f-99168c237674"],

Cell[TextData[{
 "**The diagonal case can achieve ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"tr", 
         RowBox[{"(", 
           StyleBox["C", "TI"], ")"}], "\[NotEqual]", "0"}], TraditionalForm],
      "errors" -> {}, "input" -> "\\text{tr}(C) \\ne 0", "state" -> "Boxes"|>,
    
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b17aac2d-b9a9-47c0-9f8b-d169989f01b1"],
 " because ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["a", "TI"], "\[NotEqual]", 
         StyleBox["c", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "a \\ne c", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e45ac966-8de6-463f-a428-3460d7bdc3d4"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["b", "TI"], "\[NotEqual]", 
         StyleBox["d", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "b \\ne d", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "bf39f164-c25b-43bd-a439-aa81c0fea392"],
 ", giving the trace shift ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[CapitalDelta]", "\[LongEqual]", 
         RowBox[{"(", 
           RowBox[{
             RowBox[{"(", 
               RowBox[{
                 StyleBox["a", "TI"], "-", 
                 StyleBox["c", "TI"]}], ")"}], 
             SubscriptBox[
              StyleBox["l", "TI"], "1"], "+", 
             RowBox[{"(", 
               RowBox[{
                 StyleBox["d", "TI"], "-", 
                 StyleBox["b", "TI"]}], ")"}], 
             SubscriptBox[
              StyleBox["l", "TI"], "2"]}], ")"}], "/", "2"}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\Delta = ((a-c)l_1 + (d-b)l_2)/2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c863be39-8471-49ed-823b-3f662be0c306"],
 " that shifts both eigenvalues.** "
}], "Text",ExpressionUUID->"1fba77a4-2c7a-4fc3-8e2d-4bdfd374daa1"],

Cell["Part C: Online Update Rule Comparison", "Section",ExpressionUUID->"4f86de6f-710d-41f5-a803-24194dc8114e"],

Cell[TextData[{
 "The current rule is ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["s", "TI"], 
          StyleBox["i", "TI"]], "\[LeftArrow]", 
         SubscriptBox[
          StyleBox["s", "TI"], 
          StyleBox["i", "TI"]], "+", "\[Mu] ", "\[Xi] ", 
         SuperscriptBox[
          StyleBox["e", "TI"], 
          SubscriptBox[
           StyleBox["s", "TI"], 
           StyleBox["i", "TI"]]], " ", 
         SubsuperscriptBox[
          StyleBox["l", "TI"], 
          StyleBox["i", "TI"], "2"], "-", "\[Mu] ", 
         SubscriptBox["\[Lambda]", 
          StyleBox["s", "TI"]], " ", 
         SubscriptBox[
          StyleBox["s", "TI"], 
          StyleBox["i", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "s_i \\leftarrow s_i + \\mu\\,\\xi\\, e^{s_i}\\, l_i^2 - \
\\mu\\,\\lambda_s\\, s_i", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "cf110367-cef6-4187-bb09-aede071a6aec"],
 "."
}], "Text",ExpressionUUID->"fbd1e985-b0d6-4489-b398-375f6edfa6bf"],

Cell[TextData[{
 "Near ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["s", "TI"], "\[LongEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "s = 0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "74dda29f-6503-48d1-a4ce-0873d73086c6"],
 ", at equilibrium the linearized gradient is: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         FractionBox[
          RowBox[{"\[PartialD]", 
            SubscriptBox[
             StyleBox["s", "TI"], 
             StyleBox["i", "TI"]]}], 
          RowBox[{"\[PartialD]", 
            SuperscriptBox["\[Theta]", 
             StyleBox["j", "TI"]]}]], "\[TildeTilde]", 
         FractionBox[
          RowBox[{"2 ", "\[Xi] ", 
            SubscriptBox[
             StyleBox["l", "TI"], 
             StyleBox["i", "TI"]], " ", 
            SubscriptBox[
             StyleBox["H", "TI"], 
             RowBox[{
               StyleBox["i", "TI"], 
               StyleBox["j", "TI"]}]]}], 
          RowBox[{
            SubscriptBox["\[Lambda]", 
             StyleBox["s", "TI"]], "-", "\[Xi] ", 
            SubsuperscriptBox[
             StyleBox["l", "TI"], 
             StyleBox["i", "TI"], "2"]}]]}], TraditionalForm], "errors" -> {},
      "input" -> 
     "\\frac{\\partial s_i}{\\partial \\theta^j} \\approx \\frac{2\\,\\xi\\, \
l_i\\, H_{ij}}{\\lambda_s - \\xi\\, l_i^2}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f538239d-833c-477e-a14b-1a41d07ffe5c"]
}], "Text",ExpressionUUID->"e6ff1be2-9cc9-478a-9f0e-07a3e20c8b30"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Online", " ", "rule", " ", "results", " ", "for", " ", "saddle", " ", 
    "at", " ", 
    RowBox[{"(", 
     RowBox[{"1", ",", "1"}], ")"}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"xi", "=", "1"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"onlineResults", "=", 
     RowBox[{"Table", "[", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"dsOnline", ",", "Ceval", ",", "Meval", ",", 
           RowBox[{"denom", "=", "9"}], ",", "lamMinOnline", ",", "normDS", ",", 
           RowBox[{"lvec", "=", 
            RowBox[{"{", 
             RowBox[{"2", ",", 
              RowBox[{"-", "2"}]}], "}"}]}], ",", 
           RowBox[{"Hmat", "=", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"2", ",", "0"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"0", ",", 
                RowBox[{"-", "2"}]}], "}"}]}], "}"}]}]}], "}"}], ",", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{
          RowBox[{"dsOnline", "=", 
           RowBox[{"Table", "[", "\[IndentingNewLine]", "      ", 
            RowBox[{
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"lams", "-", 
                 RowBox[{
                  RowBox[{"lvec", "[", 
                   RowBox[{"[", "i", "]"}], "]"}], "^", "2"}]}], "==", "0"}], 
               ",", "Infinity", ",", "\[IndentingNewLine]", "        ", 
               RowBox[{"2", " ", "xi", " ", 
                RowBox[{"lvec", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], " ", 
                RowBox[{
                 RowBox[{"Hmat", "[", 
                  RowBox[{"[", 
                   RowBox[{"i", ",", "j"}], "]"}], "]"}], "/", 
                 RowBox[{"(", 
                  RowBox[{"lams", "-", 
                   RowBox[{
                    RowBox[{"lvec", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "^", "2"}]}], ")"}]}]}]}],
               "]"}], ",", "\[IndentingNewLine]", "      ", 
             RowBox[{"{", 
              RowBox[{"i", ",", "1", ",", "2"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"j", ",", "1", ",", "2"}], "}"}]}], 
            "\[IndentingNewLine]", "    ", "]"}]}], ";", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"normDS", "=", 
           RowBox[{
            RowBox[{"Norm", "[", 
             RowBox[{"Flatten", "[", "dsOnline", "]"}], "]"}], " ", "//", " ",
             "N"}]}], ";", "\[IndentingNewLine]", "    ", 
          RowBox[{"Ceval", "=", 
           RowBox[{"CmatAtI", " ", "/.", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"l1", "->", "2"}], ",", 
              RowBox[{"l2", "->", 
               RowBox[{"-", "2"}]}], ",", 
              RowBox[{"a", "->", 
               RowBox[{"dsOnline", "[", 
                RowBox[{"[", 
                 RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ",", 
              RowBox[{"b", "->", 
               RowBox[{"dsOnline", "[", 
                RowBox[{"[", 
                 RowBox[{"1", ",", "2"}], "]"}], "]"}]}], ",", 
              "\[IndentingNewLine]", "                        ", 
              RowBox[{"c", "->", 
               RowBox[{"dsOnline", "[", 
                RowBox[{"[", 
                 RowBox[{"2", ",", "1"}], "]"}], "]"}]}], ",", 
              RowBox[{"d", "->", 
               RowBox[{"dsOnline", "[", 
                RowBox[{"[", 
                 RowBox[{"2", ",", "2"}], "]"}], "]"}]}]}], "}"}]}]}], ";", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"Meval", "=", 
           RowBox[{"Hmat", "-", "Ceval"}]}], ";", "\[IndentingNewLine]", 
          "    ", 
          RowBox[{"lamMinOnline", "=", 
           RowBox[{
            RowBox[{"Min", "[", 
             RowBox[{"Eigenvalues", "[", 
              RowBox[{"N", "[", "Meval", "]"}], "]"}], "]"}], "/", 
            "denom"}]}], ";", "\[IndentingNewLine]", "    ", 
          RowBox[{"{", 
           RowBox[{
           "lams", ",", "lamMinOnline", ",", "normDS", ",", "dsOnline"}], 
           "}"}]}]}], "\[IndentingNewLine]", "  ", "]"}], ",", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"{", 
        RowBox[{"lams", ",", 
         RowBox[{"{", 
          RowBox[{"5", ",", "10", ",", "20", ",", "50"}], "}"}]}], "}"}]}], 
      "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"TableForm", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"r", "[", 
          RowBox[{"[", "1", "]"}], "]"}], ",", 
         RowBox[{"r", "[", 
          RowBox[{"[", "2", "]"}], "]"}], ",", 
         RowBox[{"r", "[", 
          RowBox[{"[", "3", "]"}], "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"r", ",", "onlineResults"}], "}"}]}], "]"}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"TableHeadings", "->", 
      RowBox[{"{", 
       RowBox[{"None", ",", 
        RowBox[{"{", 
         RowBox[{"\"\<\[Lambda]_s\>\"", ",", "\"\<\[Lambda]_min(online)\>\"", 
          ",", "\"\<||\[Del]s||\>\""}], "}"}]}], "}"}]}]}], 
    "]"}]}]}]], "Input",ExpressionUUID->"8969cef7-b9b4-4c53-955c-\
d9d57011c00c"],

