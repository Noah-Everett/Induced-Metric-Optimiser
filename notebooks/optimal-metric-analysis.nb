Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Hsaddle", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"2", ",", "0"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"0", ",", 
        RowBox[{"-", "2"}]}], "}"}]}], "}"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"completeResultsSaddle", "=", 
    RowBox[{"Table", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", "res", "}"}], ",", "\[IndentingNewLine]", "    ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"R", "==", "0"}], ",", "\[IndentingNewLine]", "      ", 
          RowBox[{"{", 
           RowBox[{"R", ",", 
            RowBox[{
             RowBox[{"Min", "[", 
              RowBox[{"Eigenvalues", "[", 
               RowBox[{"Hsaddle", " ", "//", " ", "N"}], "]"}], "]"}], "/", 
             "9."}], ",", "0", ",", "0", ",", "0", ",", "0"}], "}"}], ",", 
          "\[IndentingNewLine]", "      ", 
          RowBox[{
           RowBox[{"res", "=", 
            RowBox[{"NMaximize", "[", "\[IndentingNewLine]", "        ", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{
                 RowBox[{"Min", "[", 
                  RowBox[{"Eigenvalues", "[", 
                   RowBox[{
                    RowBox[{"Hsaddle", "-", 
                    RowBox[{"(", 
                    RowBox[{"CmatAtI", " ", "/.", " ", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"l1", "->", "2"}], ",", 
                    RowBox[{"l2", "->", 
                    RowBox[{"-", "2"}]}]}], "}"}]}], ")"}]}], " ", "//", " ", 
                    "N"}], "]"}], "]"}], "/", "9.0"}], ",", 
                "\[IndentingNewLine]", "         ", 
                RowBox[{
                 RowBox[{
                  RowBox[{"a", "^", "2"}], "+", 
                  RowBox[{"b", "^", "2"}], "+", 
                  RowBox[{"c", "^", "2"}], "+", 
                  RowBox[{"d", "^", "2"}]}], "<=", 
                 RowBox[{"R", "^", "2"}]}]}], "}"}], ",", 
              "\[IndentingNewLine]", "        ", 
              RowBox[{"{", 
               RowBox[{"a", ",", "b", ",", "c", ",", "d"}], "}"}], ",", 
              "\[IndentingNewLine]", "        ", 
              RowBox[{"Method", "->", 
               RowBox[{"{", 
                RowBox[{"\"\<DifferentialEvolution\>\"", ",", 
                 RowBox[{"\"\<SearchPoints\>\"", "->", "100"}]}], "}"}]}], ",",
               "\[IndentingNewLine]", "        ", 
              RowBox[{"MaxIterations", "->", "1000"}]}], 
             "\[IndentingNewLine]", "      ", "]"}]}], ";", 
           "\[IndentingNewLine]", "      ", 
           RowBox[{"{", 
            RowBox[{"R", ",", 
             RowBox[{"res", "[", 
              RowBox[{"[", "1", "]"}], "]"}], ",", 
             RowBox[{"a", " ", "/.", " ", 
              RowBox[{"res", "[", 
               RowBox[{"[", "2", "]"}], "]"}]}], ",", 
             RowBox[{"b", " ", "/.", " ", 
              RowBox[{"res", "[", 
               RowBox[{"[", "2", "]"}], "]"}]}], ",", 
             RowBox[{"c", " ", "/.", " ", 
              RowBox[{"res", "[", 
               RowBox[{"[", "2", "]"}], "]"}]}], ",", 
             RowBox[{"d", " ", "/.", " ", 
              RowBox[{"res", "[", 
               RowBox[{"[", "2", "]"}], "]"}]}]}], "}"}]}]}], 
         "\[IndentingNewLine]", "    ", "]"}]}], "\[IndentingNewLine]", "  ", 
       "]"}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"{", 
       RowBox[{"R", ",", 
        RowBox[{"{", 
         RowBox[{
         "0", ",", "0.5", ",", "1", ",", "1.5", ",", "2", ",", "2.5", ",", 
          "3", ",", "5", ",", "10"}], "}"}]}], "}"}]}], "\[IndentingNewLine]",
      "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"TableForm", "[", 
  RowBox[{"completeResultsSaddle", ",", "\[IndentingNewLine]", "  ", 
   RowBox[{"TableHeadings", "->", 
    RowBox[{"{", 
     RowBox[{"None", ",", 
      RowBox[{"{", 
       RowBox[{"\"\<R\>\"", ",", "\"\<\[Lambda]_min\>\"", ",", "\"\<a\>\"", 
        ",", "\"\<b\>\"", ",", "\"\<c\>\"", ",", "\"\<d\>\""}], "}"}]}], 
