Cell["7. Verified claims", "Section",ExpressionUUID->"bdbe0d19-5745-4852-b212-ceb66fb991d9"],

Cell[TextData[{
 "1. **Diagonal sign-flip criterion (",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[FivePointedStar]", TraditionalForm], "errors" -> {},
      "input" -> "\\star", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "fff10e5a-d988-4237-9be1-86ac79e12402"],
 ")** \[LongDash] analytic, sharp for the diagonal construction."
}], "Text",ExpressionUUID->"8bc6235a-78c1-42b8-b07e-cc49fcc4ed29"],

Cell[TextData[{
 "2. **Per-direction \[CurlyEpsilon]-bound (",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Dagger]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\dagger", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "7fa0f19a-476d-4992-af7f-53f7d73e466d"],
 ")** \[LongDash] analytic via Taylor + (",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[FivePointedStar]", TraditionalForm], "errors" -> {},
      "input" -> "\\star", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "973782e8-a0a5-49a2-98d7-5cd5163810c9"],
 ")."
}], "Text",ExpressionUUID->"e1281d6e-5622-41f3-8879-703de6921634"],

Cell[TextData[{
 "3. **Uniform \[CurlyEpsilon]-bound (",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[DoubleDagger]", TraditionalForm], "errors" -> {}, 
     "input" -> "\\ddagger", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "718ab11a-98e8-4bc9-af01-06703d9b5c54"],
 ")** \[LongDash] uses cross-term lift to bound ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         UnderscriptBox["sup", 
          OverscriptBox[
           StyleBox["u", "TI"], "^"], LimitsPositioning -> True], 
         "\[CapitalPhi]", 
         RowBox[{"(", 
           OverscriptBox[
            StyleBox["u", "TI"], "^"], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\sup_{\\hat u} \\Phi(\\hat u)", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "4050ef8c-a775-4820-850f-deff40f5fca8"],
 " uniformly."
}], "Text",ExpressionUUID->"4edd6ab8-4220-4c2b-91ce-3a4a6d81c376"],

Cell[TextData[{
 "4. ",
 StyleBox["Symmetric saddle:",
  FontWeight->Bold],
 " prediction ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Epsilon]", 
         RowBox[{"(", 
           StyleBox["R", "TI"], ")"}], "\[LongEqual]", "4", "/", 
         StyleBox["R", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\varepsilon(R) = 4/R", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "cebfe374-5378-405e-95eb-6241e0f3513b"],
 " matches numerics. The ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"2", 
         StyleBox["N", "TI"], 
         SuperscriptBox["\[Rho]", "*"], "/", 
         RowBox[{"(", 
           RowBox[{
             SuperscriptBox["\[Mu]", "*"], 
             StyleBox["R", "TI"]}], ")"}]}], TraditionalForm], "errors" -> {},
      "input" -> "2N\\rho^*/(\\mu^* R)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "2497ff4b-0d4c-4d1d-91eb-e6b50fa2e020"],
 " envelope is sharp."
}], "Text",ExpressionUUID->"4834e217-e560-43e6-94e9-319c0e7ea8bd"],

Cell[TextData[{
 "5. ",
 StyleBox["Asymmetric saddle, quartic well:",
  FontWeight->Bold],
 " predictions match numerics to scan resolution. "
}], "Text",ExpressionUUID->"e19f4994-3733-4057-899c-58c588d07ef0"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
