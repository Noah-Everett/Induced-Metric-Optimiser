Cell["1. Setup", "Section",ExpressionUUID->"bedd211c-56e8-45ed-b4b6-a56e84531b7b"],

Cell[TextData[{
 "Let ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["L", "TI"], "\[Element]", 
         SuperscriptBox[
          StyleBox["C", "TI"], "3"], 
         RowBox[{"(", "\[CapitalOmega]", ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> "L\\in C^3(\\Omega)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "84645e1e-5668-48aa-a885-09b8f04f6a3c"],
 " be Morse on a bounded open set ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[CapitalOmega]", "\[Subset]", 
         SuperscriptBox[
          StyleBox["R", FontSlant -> "Plain"], 
          StyleBox["N", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\Omega\\subset\\mathbb{R}^N", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0dbd0052-70da-4ff2-b572-7372f12dc73a"],
 " with finite critical set ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["Crit", FontSlant -> "Plain"], 
         RowBox[{"(", 
           StyleBox["L", "TI"], ")"}], "\[LongEqual]", 
         RowBox[{"{", 
           RowBox[{
             SubsuperscriptBox["\[Theta]", "1", "*"], ",", "\[Ellipsis]", ",", 
             SubsuperscriptBox["\[Theta]", 
              StyleBox["m", "TI"], "*"]}], "}"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\mathrm{Crit}(L) = \\{\\theta^*_1,\\dots,\\theta^*_m\\}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a4bf92f9-b569-4203-91c0-f5a7d739fed1"],
 ". At each ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Theta]", "\[Element]", "\[CapitalOmega]"}], 
       TraditionalForm], "errors" -> {}, "input" -> "\\theta\\in\\Omega", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f613f8f8-cf5e-4efb-a582-93cd8c71af2b"],
 " write ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[ScriptL]", 
         RowBox[{"(", "\[Theta]", ")"}], ":", "\[LongEqual]", "\[Del]", 
         StyleBox["L", "TI"], 
         RowBox[{"(", "\[Theta]", ")"}]}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\ell(\\theta) := \\nabla L(\\theta)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "df18a543-095b-42c5-8f05-cdb935c8a3d6"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["H", "TI"], 
         RowBox[{"(", "\[Theta]", ")"}], ":", "\[LongEqual]", 
         SuperscriptBox["\[Del]", "2"], 
         StyleBox["L", "TI"], 
         RowBox[{"(", "\[Theta]", ")"}]}], TraditionalForm], "errors" -> {}, 
     "input" -> "H(\\theta) := \\nabla^2 L(\\theta)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "210b9515-c08a-4e22-864f-57428d5109b9"],
 "."
}], "Text",ExpressionUUID->"7a9e6e2a-4f7d-41a0-bf20-dd7ed0c4f824"],

Cell[TextData[{
 "For the diagonal learnable metric ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Gamma]", 
         RowBox[{"(", "\[Theta]", ")"}], "\[LongEqual]", 
         StyleBox["diag", FontSlant -> "Plain"], 
         RowBox[{"(", 
           SuperscriptBox[
            StyleBox["e", "TI"], 
            RowBox[{
              SubscriptBox[
               StyleBox["s", "TI"], 
               StyleBox["i", "TI"]], "(", "\[Theta]", ")"}]], ")"}]}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\gamma(\\theta) = \\mathrm{diag}(e^{s_i(\\theta)})", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c6bc6c88-0db8-4dfa-8195-77c3e0354a93"],
 " with ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["s", "TI"], 
         RowBox[{"(", 
           SuperscriptBox["\[Theta]", "*"], ")"}], "\[LongEqual]", "0"}], 
       TraditionalForm], "errors" -> {}, "input" -> "s(\\theta^*)=0", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "7a149a9b-3a7c-4294-8c24-2ae64f6ef517"],
 ", the curvature correction takes the form (see ",
 Cell[BoxData[Cell["learnable-metric-christoffel.nb",
   Background->None,ExpressionUUID->"05bc7e5e-b082-46d0-b592-748acc4b6ab6"]], 
  "InlineCode",ExpressionUUID->"b325299a-1d51-43b0-b331-a14e7ac00e5d"],
 "): ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       FractionBox[
        RowBox[{
          SubscriptBox[
           StyleBox["C", "TI"], 
           RowBox[{
             StyleBox["i", "TI"], 
             StyleBox["j", "TI"]}]], 
          RowBox[{"(", 
            RowBox[{"\[Sigma]", ",", "\[ScriptL]"}], ")"}], " ", 
          "\[LongEqual] ", "1"}], 
        RowBox[{"2", 
          RowBox[{"[", 
            RowBox[{
              SubscriptBox["\[Sigma]", 
               RowBox[{
                 StyleBox["j", "TI"], 
                 StyleBox["i", "TI"]}]], 
              SubscriptBox["\[ScriptL]", 
               StyleBox["i", "TI"]], "+", 
              SubscriptBox["\[Sigma]", 
               RowBox[{
                 StyleBox["i", "TI"], 
                 StyleBox["j", "TI"]}]], 
              SubscriptBox["\[ScriptL]", 
               StyleBox["j", "TI"]], "-", 
              RowBox[{"(", 
                RowBox[{"\[Del]", 
                  StyleBox["s", "TI"], "\[CenterDot]", "\[ScriptL]"}], ")"}], 
              " ", 
              SubscriptBox["\[Delta]", 
               RowBox[{
                 StyleBox["i", "TI"], 
                 StyleBox["j", "TI"]}]]}], "]"}], ",    ", 
          SubscriptBox["\[Sigma]", 
           RowBox[{
             StyleBox["k", "TI"], 
             StyleBox["i", "TI"]}]], ":", "\[LongEqual]", 
          SubscriptBox["\[PartialD]", 
           StyleBox["k", "TI"]], 
          SubscriptBox[
           StyleBox["s", "TI"], 
           StyleBox["i", "TI"]], "."}]], TraditionalForm], "errors" -> {}, 
     "input" -> 
     "C_{ij}(\\sigma,\\ell) \\;=\\; \\tfrac{1}{2}\\bigl[\\sigma_{ji}\\ell_i + \
\\sigma_{ij}\\ell_j - (\\nabla s\\cdot\\ell)\\,\\delta_{ij}\\bigr], \\qquad \
\\sigma_{ki} := \\partial_k s_i.", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "8ad30c92-d9d1-44a4-afba-82fcb4a1560f"],
 "The geodesic-convexity basin at budget ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["R", "TI"], TraditionalForm], "errors" -> {}, "input" -> "R", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e360671f-d635-4596-bc14-c92fd77d6ba0"],
 " is ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["B", "TI"], 
          StyleBox["g", "TI"]], 
         RowBox[{"(", 
           StyleBox["R", "TI"], ")"}], " ", ":", "\[LongEqual] ", 
         RowBox[{"{", 
           
           RowBox[{"\[Theta]", "\[Element]", "\[CapitalOmega]", ":", 
             "\[Exists] ", "\[Sigma]", ", ", 
             "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", 
             "\[Sigma]", 
             SubscriptBox[
             "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", 
              StyleBox["F", "TI"]], "\[LessEqual]", 
             StyleBox["R", "TI"], ", ", 
             StyleBox["H", "TI"], 
             RowBox[{"(", "\[Theta]", ")"}], "-", 
             StyleBox["C", "TI"], 
             RowBox[{"(", 
               RowBox[{"\[Sigma]", ",", "\[ScriptL]", 
                 RowBox[{"(", "\[Theta]", ")"}]}], ")"}], "\[Succeeds]", 
             "0"}], "}"}], "."}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\mathcal{B}_g(R) \\;:=\\; \\bigl\\{\\theta\\in\\Omega : \
\\exists\\,\\sigma,\\ |\\sigma|_F\\le R,\\ \
H(\\theta)-C(\\sigma,\\ell(\\theta))\\succ 0\\bigr\\}.", "state" -> "Boxes"|>,
    
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c626dd0d-abd1-4180-b184-9e4c4598a00c"],
 StyleBox["Goal.",
  FontWeight->Bold],
 " Prove ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["B", "TI"], 
          StyleBox["g", "TI"]], 
         SuperscriptBox[
          RowBox[{"(", 
            StyleBox["R", "TI"], ")"}], 
          StyleBox["c", "TI"]], "\[Intersection]", "\[CapitalOmega]", 
         "\[SubsetEqual]", 
         SubscriptBox["\[Union]", 
          StyleBox["k", "TI"]], 
         OverscriptBox[
          RowBox[{
            StyleBox["B", "TI"], "(", 
            RowBox[{
              SubsuperscriptBox["\[Theta]", 
               StyleBox["k", "TI"], "*"], ",", 
              SubscriptBox["\[Epsilon]", 
               StyleBox["k", "TI"]], 
              RowBox[{"(", 
                StyleBox["R", "TI"], ")"}]}], ")"}], "_"]}], TraditionalForm],
      "errors" -> {}, "input" -> 
     "\\mathcal{B}_g(R)^c \\cap \\Omega \\subseteq \\bigcup_k \
\\overline{B(\\theta^*_k,\\varepsilon_k(R))}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "597c620f-3da6-45c1-904e-6ee0cdb3ee9a"],
 " with explicit ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Epsilon]", 
          StyleBox["k", "TI"]], 
         RowBox[{"(", 
           StyleBox["R", "TI"], ")"}], "\[LongEqual]", 
         StyleBox["O", "TI"], 
         RowBox[{"(", 
           RowBox[{"1", "/", 
             StyleBox["R", "TI"]}], ")"}]}], TraditionalForm], "errors" -> {},
      "input" -> "\\varepsilon_k(R) = O(1/R)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "2157fc17-2473-4ad9-aba6-726df6a8650a"],
 ". "
}], "Text",ExpressionUUID->"f8c6de8f-2c9a-4f38-b4ef-d3585911e8c5"],

