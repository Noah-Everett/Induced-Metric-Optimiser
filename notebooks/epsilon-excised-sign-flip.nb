Notebook[{
Cell["\[CurlyEpsilon]-Excised Sign Flip: Quantitative Critical-Point \
Obstruction", "Title",ExpressionUUID->"ca30ad12-7c99-434a-bf26-6c783ba6d136"],

Cell[TextData[{
 StyleBox["IMO-174",
  FontWeight->Bold],
 " \[LongDash] Induced Metric Optimiser Project. ",
 StyleBox["Authors:",
  FontWeight->Bold],
 " Noah Everett, Matt Schwartz, Thomas Harvey. ",
 StyleBox["Date:",
  FontWeight->Bold],
 " 2026-05-27. ",
 StyleBox["Claude session:",
  FontWeight->Bold],
 " ",
 Cell[BoxData[Cell["f0c07d40-3dc8-47e0-980f-57c4e1e80333",
   Background->None,ExpressionUUID->"e0b5dc5d-b7a8-422f-96a4-ed46c2dc802d"]], 
  "InlineCode",ExpressionUUID->"3297946e-dcb8-434f-9e3d-71f074118374"],
 "."
}], "Text",ExpressionUUID->"79a5cb99-f5e1-4383-8a1b-d32e177ea0e6"],

Cell[TextData[{
 "This notebook derives and numerically verifies the ",
 StyleBox["\[CurlyEpsilon]-excised sign-flip proposition",
  FontWeight->Bold],
 ": the positive complement to Theorem 1 (critical-point obstruction). \
Whereas Theorem 1 says no metric makes a critical point convex, this notebook \
proves the ",
 StyleBox["failure region",
  FontSlant->Italic],
 " is contained in tubes of radius ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Epsilon]", 
          StyleBox["k", "TI"]], 
         RowBox[{"(", 
           StyleBox["R", "TI"], ")"}], "\[LongEqual]", 
         StyleBox["O", "TI"], 
         RowBox[{"(", 
           RowBox[{"1", "/", 
             StyleBox["R", "TI"]}], ")"}]}], TraditionalForm], "errors" -> {},
      "input" -> "\\varepsilon_k(R) = O(1/R)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "df896e1b-dafb-4d3d-945b-d0217b16705e"],
 " around each critical point.",
 StyleBox["Depends on:",
  FontWeight->Bold],
 " ",
 Cell[BoxData[Cell["diagonal-sign-flip-general-N.nb",
   Background->None,ExpressionUUID->"b746aae0-e534-4093-9c43-f84942a5f7c7"]], 
  "InlineCode",ExpressionUUID->"fdf4e24b-177f-4e84-840c-f8e654b2ad8f"],
 " (IMO-43, constructive Gershgorin sign-flip).",
 StyleBox["Formalizes / verifies:",
  FontWeight->Bold],
 " ",
 Cell[BoxData[Cell["lean/EpsilonExcisedSignFlip.lean",
   Background->None,ExpressionUUID->"7e8d93c7-9965-4879-8cb2-90a142a6cd91"]], 
  "InlineCode",ExpressionUUID->"b1f17164-197f-4d54-b57a-79d39faf8d56"],
 ", ",
 Cell[BoxData[Cell["notes/trajectory-geodesic-convexity.md",
   Background->None,ExpressionUUID->"c23ece0b-aefc-4ef5-a9a2-db897e21126a"]], 
  "InlineCode",ExpressionUUID->"3c1b0f7c-c57e-4291-a449-48f81e2636e2"],
 " (proposition between Theorem 1 and \[Section]2). "
}], "Text",ExpressionUUID->"58f601ea-24f1-4dca-a281-48d587be12f3"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
