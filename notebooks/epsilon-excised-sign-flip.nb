Cell["2. Diagonal-only construction (Gershgorin lemma)", "Section",ExpressionUUID->"b112fccb-fd35-46cd-a23f-8f3b35546b75"],

Cell[TextData[{
 "Following IMO-43 / ",
 Cell[BoxData[Cell["DiagonalSignFlip.lean",
   Background->None,ExpressionUUID->"301853f3-2414-451c-8583-dfdfd671088c"]], 
  "InlineCode",ExpressionUUID->"395eda33-36e8-494c-bcfc-bdf309dc2e6e"],
 ": fix ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Theta]", "\[Element]", "\[CapitalOmega]"}], 
       TraditionalForm], "errors" -> {}, "input" -> "\\theta\\in\\Omega", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0c081d69-5438-4943-8031-89318a1fb79c"],
 " with ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[ScriptL]", 
          StyleBox["i", "TI"]], 
         RowBox[{"(", "\[Theta]", ")"}], "\[NotEqual]", "0"}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\ell_i(\\theta) \\neq 0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "2632d0bd-27c5-4405-a952-e15d469fd1d1"],
 " for all ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["i", "TI"], TraditionalForm], "errors" -> {}, "input" -> "i", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ca9019a4-8334-42f3-bee4-2e7f0330c1b8"],
 ". Set ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Sigma]", 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["i", "TI"]}]], "\[LongEqual]", "-", 
         FractionBox[
          RowBox[{"2", 
            StyleBox["m", "TI"]}], 
          SubscriptBox["\[ScriptL]", 
           StyleBox["i", "TI"]]], ",    ", 
         SubscriptBox["\[Sigma]", 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"]}]], "\[LongEqual]", "0 ", 
         RowBox[{"(", 
           RowBox[{
             StyleBox["i", "TI"], "\[NotEqual]", 
             StyleBox["j", "TI"]}], ")"}], ","}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\sigma_{ii} = -\\frac{2 m}{\\ell_i}, \\qquad \\sigma_{ij} = 0 \\ \
(i\\neq j),", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "8a36489b-aaf4-4738-b137-22bb9fcb8df8"],
 "for a scalar $m > 0$. Then ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["C", "TI"], 
         RowBox[{"(", 
           RowBox[{"\[Sigma]", ",", "\[ScriptL]"}], ")"}], "\[LongEqual]", 
         "-", 
         StyleBox["m", "TI"], " ", 
         SubscriptBox[
          StyleBox["I", "TI"], 
          StyleBox["N", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "C(\\sigma,\\ell) = -m\\, I_N", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "7321a39d-07a5-4ad2-8839-938d139091bf"],
 " (verified below), so ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["H", "TI"], "-", 
         StyleBox["C", "TI"], "\[LongEqual]", 
         StyleBox["H", "TI"], "+", 
         StyleBox["m", "TI"], 
         StyleBox["I", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "H-C = H + mI", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "37d06e4f-b31a-4b82-b11a-75ee66cd80a0"],
 ". "
}], "Text",ExpressionUUID->"918f126c-6e8c-42f6-8789-6dd9c4eccb45"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"diagCorr", "[", 
     RowBox[{"d_", ",", "ell_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"n", "=", 
        RowBox[{"Length", "[", "d", "]"}]}], "}"}], ",", 
      "\[IndentingNewLine]", "   ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"i", "==", "j"}], ",", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", "/", "2"}], ")"}], " ", 
           RowBox[{"d", "[", 
            RowBox[{"[", "i", "]"}], "]"}], " ", 
           RowBox[{"ell", "[", 
            RowBox[{"[", "i", "]"}], "]"}]}], ",", "0"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "n"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", "n"}], "}"}]}], "]"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"n", "=", "4"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ellSym", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Subscript", "[", 
      RowBox[{"\[ScriptL]", ",", "i"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "n"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dSym", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "2"}], " ", 
      RowBox[{"m", "/", 
       RowBox[{"ellSym", "[", 
        RowBox[{"[", "i", "]"}], "]"}]}]}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "n"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"CSym", "=", 
   RowBox[{
    RowBox[{"diagCorr", "[", 
     RowBox[{"dSym", ",", "ellSym"}], "]"}], " ", "//", " ", 
    "FullSimplify"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{"Diagonal", "[", "CSym", "]"}], " ", "//", " ", "Simplify"}], ",", 
   RowBox[{"CSym", " ", "//", " ", "MatrixForm"}]}], "}"}]}], "Input",Expressi\
onUUID->"2c8d5261-2b4e-4d9e-9649-62415a77324b"],

Cell[TextData[{
 "So ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["H", "TI"], "-", 
         StyleBox["C", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "H-C", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0de96c99-49d8-41fd-940b-35fe4569aa74"],
 " has diagonal entries ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["H", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["i", "TI"]}]], "+", 
         StyleBox["m", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "H_{ii}+m", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "8ea3ec97-91dd-47c9-95aa-bb2c50d21c31"],
 " and unchanged off-diagonals. "
}], "Text",ExpressionUUID->"7cdd627a-c0ca-4e5a-be56-1af2ce9bd531"],

Cell["Gershgorin sufficient condition", "Subsection",ExpressionUUID->"95ef462b-fb60-4707-b31e-41e20cf5ba36"],

Cell[TextData[{
 "Define the ",
 StyleBox["Gershgorin deficit",
  FontWeight->Bold],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Rho]", 
         RowBox[{"(", "\[Theta]", ")"}], " ", ":", "\[LongEqual] ", 
         UnderscriptBox["max", 
          StyleBox["i", "TI"], LimitsPositioning -> True], 
         RowBox[{"[", 
           RowBox[{
             UnderscriptBox["\[Sum]", 
              RowBox[{
                StyleBox["j", "TI"], "\[NotEqual]", 
                StyleBox["i", "TI"]}], LimitsPositioning -> True], "|", 
             SubscriptBox[
              StyleBox["H", "TI"], 
              RowBox[{
                StyleBox["i", "TI"], 
                StyleBox["j", "TI"]}]], 
             RowBox[{"(", "\[Theta]", ")"}], "|", "-", 
             SubscriptBox[
              StyleBox["H", "TI"], 
              RowBox[{
                StyleBox["i", "TI"], 
                StyleBox["i", "TI"]}]], 
             RowBox[{"(", "\[Theta]", ")"}]}], "]"}], "."}], TraditionalForm],
      "errors" -> {}, "input" -> 
     "\\rho(\\theta) \\;:=\\; \\max_i \\Bigl[\\sum_{j\\neq \
i}|H_{ij}(\\theta)| - H_{ii}(\\theta)\\Bigr].", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "eaa5f896-1730-443b-a9b8-b5ceb95c2f6a"],
 "By Gershgorin's theorem, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["H", "TI"], "+", 
         StyleBox["m", "TI"], 
         StyleBox["I", "TI"], "\[Succeeds]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "H+mI \\succ 0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "4d41dc02-4398-40f4-a0d0-c1200572af57"],
 " whenever ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["m", "TI"], ">", "\[Rho]", 
         RowBox[{"(", "\[Theta]", ")"}]}], TraditionalForm], "errors" -> {}, 
     "input" -> "m > \\rho(\\theta)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "42f32497-8ad6-4cdf-af0e-490ba483dd88"],
 ". (At a minimum, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Rho]", "<", "0"}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\rho < 0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "8f24bf8a-6bb7-475e-9e4a-04a0f5d1e8f4"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["m", "TI"], "\[LongEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "m=0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f33340f6-2f15-4a71-a7cb-6a67c7c7698c"],
 " suffices. At a saddle, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Rho]", ">", "0"}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\rho > 0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "55be06b0-75ef-4509-935d-e0230f1ccedf"],
 ".) "
}], "Text",ExpressionUUID->"56cf70b3-d30b-4fa0-91ef-5143562ebf77"],

Cell["Frobenius budget", "Subsection",ExpressionUUID->"e7511c04-639c-47b9-adb1-f797a59a8639"],

Cell[TextData[{
 "The Frobenius norm of the diagonal-only ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Sigma]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\sigma", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f02c3cc7-76b9-449c-807b-a1ec845c21b3"],
 " is ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
        "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", "\[Sigma]", 
         SubscriptBox["\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", 
          StyleBox["F", "TI"]], "\[LongEqual]", "2", 
         StyleBox["m", "TI"], " ", 
         SuperscriptBox[
          RowBox[{"(", 
            RowBox[{
              UnderscriptBox["\[Sum]", 
               StyleBox["i", "TI"], LimitsPositioning -> True], 
              SubsuperscriptBox["\[ScriptL]", 
               StyleBox["i", "TI"], "-2"]}], ")"}], 
          RowBox[{"1", "/", "2"}]], "\[LongEqual]", "2", 
         StyleBox["m", "TI"], "\[CenterDot]", 
         "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", 
         SuperscriptBox["\[ScriptL]", "-1"], 
         SubscriptBox[
         "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", "2"], "."}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "|\\sigma|_F = 2m\\,\\Bigl(\\sum_i \\ell_i^{-2}\\Bigr)^{1/2} = 2m \\cdot \
|\\ell^{-1}|_2.", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "eb3c9ea4-203a-437f-a596-1fc408d2130c"],
 "So the budget constraint ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
        "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", "\[Sigma]", 
         SubscriptBox["\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", 
          StyleBox["F", "TI"]], "\[LessEqual]", 
         StyleBox["R", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "|\\sigma|_F \\le R", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ffb83cc5-4f76-4928-9c89-151c8ff0d17c"],
 " caps ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["m", "TI"], "\[LessEqual]", 
         SubscriptBox[
          StyleBox["m", "TI"], "max"], 
         RowBox[{"(", 
           RowBox[{"\[Theta]", ",", 
             StyleBox["R", "TI"]}], ")"}], ":", "\[LongEqual]", 
         StyleBox["R", "TI"], "/", 
         RowBox[{"(", 
           RowBox[{"2\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", 
             SuperscriptBox["\[ScriptL]", "-1"], 
             SubscriptBox[
             "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", "2"]}], 
           ")"}]}], TraditionalForm], "errors" -> {}, "input" -> 
     "m \\le m_{\\max}(\\theta,R) := R/(2|\\ell^{-1}|_2)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "191108a2-8864-4e95-b90e-73b591fb1c4d"],
 ". "
}], "Text",ExpressionUUID->"01552e2a-32b4-44db-bda6-eda6d8d09411"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"sigmaFroSq", "=", 
   RowBox[{
    RowBox[{"Total", "[", 
     RowBox[{"dSym", "^", "2"}], "]"}], " ", "//", " ", "FullSimplify"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"{", 
  RowBox[{"\"\<||\[Sigma]||_F^2 = \>\"", ",", "sigmaFroSq", ",", 
   "\[IndentingNewLine]", " ", "\"\<  m_max(R) = \>\"", ",", 
   RowBox[{
    RowBox[{"R", "/", 
     RowBox[{"(", 
      RowBox[{"2", " ", 
       RowBox[{"Sqrt", "[", 
        RowBox[{"Total", "[", 
         RowBox[{"1", "/", 
          RowBox[{"ellSym", "^", "2"}]}], "]"}], "]"}]}], ")"}]}], " ", "//", 
    " ", "FullSimplify"}]}], "}"}]}], "Input",ExpressionUUID->"f2726339-2e2f-\
41bd-b3b5-74e2ab2b36dc"],

Cell["Sufficient condition for sign flip", "Subsection",ExpressionUUID->"dc46cacf-af2e-404e-ad08-c7cfebc33354"],

Cell[TextData[{
 "The diagonal construction succeeds when ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["m", "TI"], "max"], 
         RowBox[{"(", 
           RowBox[{"\[Theta]", ",", 
             StyleBox["R", "TI"]}], ")"}], ">", "\[Rho]", 
         RowBox[{"(", "\[Theta]", ")"}]}], TraditionalForm], "errors" -> {}, 
     "input" -> "m_{\\max}(\\theta,R) > \\rho(\\theta)", "state" -> "Boxes"|>,
    
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "cab40675-5ed5-4d15-a213-80dacc3b21b9"],
 ", i.e. ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> InterpretationBox["", 
       Failure[
       "TeXAssistantError", <|
        "MessageTemplate" -> "Errors: `Errors`", 
         "MessageParameters" -> <|"Errors" -> {}|>, "Input" -> 
         "\\boxed{\\;|\\ell^{-1}(\\theta)|_2 \\;<\\; \
\\frac{R}{2\\,\\rho(\\theta)}\\;.}\\tag{$\\star$}"|>]], "errors" -> {}, 
     "input" -> 
     "\\boxed{\\;|\\ell^{-1}(\\theta)|_2 \\;<\\; \
\\frac{R}{2\\,\\rho(\\theta)}\\;.}\\tag{$\\star$}", "state" -> "Error"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "18596b92-4d4a-412b-ae1a-6d3357cfca74"],
 "This is the ",
 StyleBox["diagonal sign-flip criterion",
  FontWeight->Bold],
 ". It depends on the gradient through the inverse-coordinate norm ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", 
         SuperscriptBox["\[ScriptL]", "-1"], 
         SubscriptBox[
         "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", "2"]}], 
       TraditionalForm], "errors" -> {}, "input" -> "|\\ell^{-1}|_2", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "de153c04-08a3-45a1-8733-1bd6137ce673"],
 " (which blows up when any ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[ScriptL]", 
          StyleBox["i", "TI"]], "\[Rule]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\ell_i \\to 0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "97ce28a1-bdbe-4396-8ff7-2622605879fa"],
 ") and on the local Gershgorin deficit ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Rho]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\rho", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "fa6c6053-4750-4906-8b12-3e7882fd5fd5"],
 ". "
}], "Text",ExpressionUUID->"e61663b8-f2fb-4ffe-a19e-cf0d327d8c38"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     GrayLevel[0.8], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"1bdd23a4-201b-47d7-a276-a979f8b7f6df"],

Cell["3. Taylor expansion near a Morse critical point", "Section",ExpressionUUID->"0ef4a9af-26a2-4764-ae5c-43238159e3a1"],

Cell[TextData[{
 "Fix ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox["\[Theta]", "*"], "\[Element]", 
         StyleBox["Crit", FontSlant -> "Plain"], 
         RowBox[{"(", 
           StyleBox["L", "TI"], ")"}]}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\theta^*\\in\\mathrm{Crit}(L)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d6d8611e-d33d-4acd-bac2-451f0a612b8c"],
 " with ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["H", "TI"], "*"], ":", "\[LongEqual]", 
         StyleBox["H", "TI"], 
         RowBox[{"(", 
           SuperscriptBox["\[Theta]", "*"], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> "H^* := H(\\theta^*)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "3208776c-15b9-4a2e-9b9a-61ac376b843b"],
 " nondegenerate. Without loss of generality assume coordinates aligned so \
that ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox[
        StyleBox["H", "TI"], "*"], TraditionalForm], "errors" -> {}, "input" -> 
     "H^*", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e7e7604e-999c-4834-87cb-70e05e80e8ee"],
 " is diagonal: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["H", "TI"], "*"], "\[LongEqual]", 
         StyleBox["diag", FontSlant -> "Plain"], 
         RowBox[{"(", 
           RowBox[{
             SubscriptBox["\[Lambda]", "1"], ",", "\[Ellipsis]", ",", 
             SubscriptBox["\[Lambda]", 
              StyleBox["N", "TI"]]}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "H^* = \\mathrm{diag}(\\lambda_1,\\dots,\\lambda_N)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "fa18497a-77fb-44b0-81ec-ba74c32e79b6"],
 " with all ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Lambda]", 
          StyleBox["i", "TI"]], "\[NotEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\lambda_i \\neq 0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "19bbaeec-45f1-4c83-8711-e41a993bde0f"],
 ". Set ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Delta]", ":", "\[LongEqual]", "\[Theta]", "-", 
         SuperscriptBox["\[Theta]", "*"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\delta := \\theta-\\theta^*", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e2ed655f-6313-410c-b46c-4e6769e6c671"],
 ", ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["r", "TI"], ":", "\[LongEqual]", 
         "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", "\[Delta]", 
         "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9"}], 
       TraditionalForm], "errors" -> {}, "input" -> "r := |\\delta|", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "152af1fc-e199-461b-bc90-26923ed95ba6"],
 ", ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         OverscriptBox[
          StyleBox["u", "TI"], "^"], ":", "\[LongEqual]", "\[Delta]", "/", 
         StyleBox["r", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\hat u := \\delta/r", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "7d2c95ab-b1cf-4919-9487-e852b0a25d5a"],
 "."
}], "Text",ExpressionUUID->"3698d78f-e62d-4281-9c2d-ebef79f0d5ae"],

Cell[TextData[{
 "By the ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox[
        StyleBox["C", "TI"], "3"], TraditionalForm], "errors" -> {}, "input" -> 
     "C^3", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "857d2b62-7bab-4e88-95ce-e9329129611f"],
 " hypothesis, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       FractionBox[
        RowBox[{
          SubscriptBox["\[ScriptL]", 
           StyleBox["i", "TI"]], 
          RowBox[{"(", "\[Theta]", ")"}], "\[LongEqual]", 
          SubscriptBox["\[Lambda]", 
           StyleBox["i", "TI"]], 
          SubscriptBox["\[Delta]", 
           StyleBox["i", "TI"]], "+", 
          SubsuperscriptBox[
           StyleBox["R", "TI"], 
           StyleBox["i", "TI"], 
           RowBox[{"(", "\[ScriptL]", ")"}]], 
          RowBox[{"(", "\[Delta]", ")"}], ",    ", "|", 
          SubsuperscriptBox[
           StyleBox["R", "TI"], 
           StyleBox["i", "TI"], 
           RowBox[{"(", "\[ScriptL]", ")"}]], 
          RowBox[{"(", "\[Delta]", ")"}], "|", "\[LessEqual]", "1"}], 
        RowBox[{"2", 
          SubscriptBox[
           StyleBox["L", "TI"], "3"], 
          SuperscriptBox[
           StyleBox["r", "TI"], "2"], ","}]], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\ell_i(\\theta) = \\lambda_i \\delta_i + R^{(\\ell)}_i(\\delta), \
\\qquad |R^{(\\ell)}_i(\\delta)| \\le \\tfrac{1}{2} L_3 r^2,", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c4d98e61-8bb1-41b1-a194-4342c11892c7"],
 "where ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["L", "TI"], "3"], ":", "\[LongEqual]", 
         "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", 
         SuperscriptBox[
          StyleBox["D", "TI"], "3"], 
         StyleBox["L", "TI"], 
         SubscriptBox["\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", 
          RowBox[{
            SuperscriptBox[
             StyleBox["L", "TI"], "\[Infinity]"], "(", "\[CapitalOmega]", 
            ")"}]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "L_3 := |D^3 L|_{L^\\infty(\\Omega)}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ca786832-0a41-43f5-9489-6d7370c805ff"],
 ". Similarly ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", 
         StyleBox["H", "TI"], 
         RowBox[{"(", "\[Theta]", ")"}], "-", 
         SuperscriptBox[
          StyleBox["H", "TI"], "*"], 
         SubscriptBox[
         "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", "2"], 
         "\[LessEqual]", 
         SubscriptBox[
          StyleBox["L", "TI"], "3"], 
         StyleBox["r", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "|H(\\theta) - H^*|_2 \\le L_3 r", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f16ffdde-4c5c-4a23-b438-e9b7878a87a1"],
 ", giving ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Rho]", 
         RowBox[{"(", "\[Theta]", ")"}], " ", "\[LessEqual] ", 
         SuperscriptBox["\[Rho]", "*"], "+", 
         StyleBox["N", "TI"], 
         SubscriptBox[
          StyleBox["L", "TI"], "3"], 
         StyleBox["r", "TI"], ",    ", 
         SuperscriptBox["\[Rho]", "*"], ":", "\[LongEqual]", "\[Rho]", 
         RowBox[{"(", 
           SuperscriptBox["\[Theta]", "*"], ")"}], "."}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\rho(\\theta) \\;\\le\\; \\rho^* + N L_3 r,\\qquad \\rho^* := \
\\rho(\\theta^*).", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f669e33a-73b1-4d56-aa1e-7ee8e48a8eaa"],
 "For the leading-order gradient, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", 
         SuperscriptBox["\[ScriptL]", "-1"], 
         RowBox[{"(", "\[Theta]", ")"}], 
         SubsuperscriptBox[
         "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", "2", "2"], 
         " ", "\[LongEqual] ", 
         UnderscriptBox["\[Sum]", 
          StyleBox["i", "TI"], LimitsPositioning -> True], 
         FractionBox["1", 
          SuperscriptBox[
           RowBox[{"(", 
             RowBox[{
               SubscriptBox["\[Lambda]", 
                StyleBox["i", "TI"]], 
               SubscriptBox[
                StyleBox["u", "TI"], 
                StyleBox["i", "TI"]], 
               StyleBox["r", "TI"], "+", 
               StyleBox["O", "TI"], 
               RowBox[{"(", 
                 SuperscriptBox[
                  StyleBox["r", "TI"], "2"], ")"}]}], ")"}], "2"]], " ", 
         "\[LongEqual] ", 
         FractionBox["1", 
          SuperscriptBox[
           StyleBox["r", "TI"], "2"]], " ", "\[CapitalPhi]", 
         RowBox[{"(", 
           OverscriptBox[
            StyleBox["u", "TI"], "^"], ")"}], "\[CenterDot]", 
         RowBox[{"(", 
           RowBox[{"1", "+", 
             StyleBox["O", "TI"], 
             RowBox[{"(", 
               StyleBox["r", "TI"], ")"}]}], ")"}], ","}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "|\\ell^{-1}(\\theta)|_2^2 \\;=\\; \\sum_i \\frac{1}{(\\lambda_i u_i r + \
O(r^2))^2} \\;=\\; \\frac{1}{r^2}\\,\\Phi(\\hat u) \\cdot \\bigl(1 + \
O(r)\\bigr),", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "4555de57-ee53-4874-ab94-946f7bb2149a"],
 "where the ",
 StyleBox["directional factor",
  FontWeight->Bold],
 " is ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[CapitalPhi]", 
         RowBox[{"(", 
           OverscriptBox[
            StyleBox["u", "TI"], "^"], ")"}], " ", ":", "\[LongEqual] ", 
         UnderscriptBox["\[Sum]", 
          StyleBox["i", "TI"], LimitsPositioning -> True], 
         FractionBox["1", 
          SuperscriptBox[
           RowBox[{"(", 
             RowBox[{
               SubscriptBox["\[Lambda]", 
                StyleBox["i", "TI"]], 
               SubscriptBox[
                StyleBox["u", "TI"], 
                StyleBox["i", "TI"]]}], ")"}], "2"]], "."}], TraditionalForm],
      "errors" -> {}, "input" -> 
     "\\Phi(\\hat u) \\;:=\\; \\sum_i \\frac{1}{(\\lambda_i u_i)^2}.", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "312a6a23-e8c9-4c47-8e98-60212477c8d5"],
 "Note ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[CapitalPhi]", "(", 
         OverscriptBox[
          StyleBox["u", "TI"], "^"], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\Phi(\\hat u)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "9e08f409-4e1b-4ffe-a8bd-60a0c3d57812"],
 " is finite for any direction with ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["u", "TI"], 
          StyleBox["i", "TI"]], "\[NotEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "u_i \\neq 0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "69c8e214-5e78-4dc1-a68a-aec0d4d243ed"],
 " for all ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["i", "TI"], TraditionalForm], "errors" -> {}, "input" -> "i", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b37f82ab-db55-48b3-859e-2b6ca398923a"],
 " (i.e., off the coordinate-axis null-cones); ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[CapitalPhi]", "\[Rule]", "\[Infinity]"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\Phi \\to \\infty", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a00b2e98-43e1-4cf1-8f87-6afb3019d53b"],
 " as any ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["u", "TI"], 
          StyleBox["i", "TI"]], "\[Rule]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "u_i \\to 0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "27f5e4db-aca6-4751-bc38-d4338490e3bc"],
 "."
}], "Text",ExpressionUUID->"8715a797-85ab-40a0-8c2e-0e55a9c335d9"],

Cell[TextData[{
 "Substituting into (",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[FivePointedStar]", TraditionalForm], "errors" -> {},
      "input" -> "\\star", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ce517ec6-3654-4a53-88fa-a336388b1737"],
 ") and keeping leading order in ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["r", "TI"], TraditionalForm], "errors" -> {}, "input" -> "r", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "927aa9ef-53f0-4beb-b633-0352c64f078d"],
 ": ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         FractionBox[
          SqrtBox[
           RowBox[{"\[CapitalPhi]", "(", 
             OverscriptBox[
              StyleBox["u", "TI"], "^"], ")"}]], 
          StyleBox["r", "TI"]], " ", 
         RowBox[{"(", 
           RowBox[{"1", "+", 
             StyleBox["O", "TI"], 
             RowBox[{"(", 
               StyleBox["r", "TI"], ")"}]}], ")"}], " ", "< ", 
         FractionBox[
          StyleBox["R", "TI"], 
          RowBox[{"2", "(", 
            RowBox[{
              SuperscriptBox["\[Rho]", "*"], "+", 
              StyleBox["N", "TI"], 
              SubscriptBox[
               StyleBox["L", "TI"], "3"], 
              StyleBox["r", "TI"]}], ")"}]], ","}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\frac{\\sqrt{\\Phi(\\hat u)}}{r}\\,(1+O(r)) \\;<\\; \
\\frac{R}{2(\\rho^* + N L_3 r)},", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "18e3d43e-c4dc-44d7-82c3-d46a33974b14"],
 "which rearranges to ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> InterpretationBox["", 
       Failure[
       "TeXAssistantError", <|
        "MessageTemplate" -> "Errors: `Errors`", 
         "MessageParameters" -> <|"Errors" -> {}|>, "Input" -> 
         "r \\;>\\; \\varepsilon(R,\\hat u) \\;:=\\; \
\\frac{2\\rho^*\\sqrt{\\Phi(\\hat u)}}{R} \\;+\\; O(R^{-2}). \
\\tag{$\\dagger$}"|>]], "errors" -> {}, "input" -> 
     "r \\;>\\; \\varepsilon(R,\\hat u) \\;:=\\; \\frac{2\\rho^*\\sqrt{\\Phi(\
\\hat u)}}{R} \\;+\\; O(R^{-2}). \\tag{$\\dagger$}", "state" -> "Error"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c9be2bba-8608-4e4c-b6c7-4aeeebeb7f1b"],
 "This is the ",
 StyleBox["per-direction \[CurlyEpsilon]-excised bound",
  FontWeight->Bold],
 ". "
}], "Text",ExpressionUUID->"b622934b-ebee-423e-b896-03f9a0529cc0"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     GrayLevel[0.8], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"fe7ea86b-5379-4dd0-8ce3-a5dd9e8a63e5"],

Cell["4. Worst-direction handling: cross-term lift", "Section",ExpressionUUID->"998e4707-84ff-4a93-8765-817bde8e6292"],

Cell[TextData[{
 "The directional factor ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[CapitalPhi]", "(", 
         OverscriptBox[
          StyleBox["u", "TI"], "^"], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\Phi(\\hat u)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ea37d167-4ef7-4ec9-922b-8ec83c19f003"],
 " diverges at coordinate axes. To uniformize the bound, we use the ",
 StyleBox["cross-term construction",
  FontWeight->Bold],
 " from Part F of ",
 Cell[BoxData[Cell["DiagonalSignFlip.lean",
   Background->None,ExpressionUUID->"a2f011ec-11ec-4e6f-9fc7-7eaedc34fbe6"]], 
  "InlineCode",ExpressionUUID->"3e726fe1-bf10-411d-9505-d5119db83854"],
 ": when ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[ScriptL]", 
          StyleBox["i", "TI"]], "\[LongEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\ell_i = 0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "1d3dcbbe-db83-45a0-b153-6050f3ffc0d5"],
 ", replace the diagonal entry ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Sigma]", 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["i", "TI"]}]], "\[LongEqual]", "-2", 
         StyleBox["m", "TI"], "/", 
         SubscriptBox["\[ScriptL]", 
          StyleBox["i", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\sigma_{ii} = -2m/\\ell_i", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d0b9479b-438f-4ece-ab34-0e311ca0fc18"],
 " with a cross-derivative ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Sigma]", 
          RowBox[{
            StyleBox["k", "TI"], 
            StyleBox["i", "TI"]}]], "\[LongEqual]", "2", 
         StyleBox["m", "TI"], "/", 
         SubscriptBox["\[ScriptL]", 
          StyleBox["k", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\sigma_{ki} = 2m/\\ell_k", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "8da10294-b8d9-4bfb-bec4-920039949418"],
 " for some ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["k", "TI"], TraditionalForm], "errors" -> {}, "input" -> "k", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "657907d2-e3a5-4a73-8a87-708752db37d7"],
 " with ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[ScriptL]", 
          StyleBox["k", "TI"]], "\[NotEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\ell_k\\neq 0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "15693513-a48e-4ff3-bc76-489dae0048f5"],
 ". The Frobenius cost increases at most by a factor of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SqrtBox[
        StyleBox["N", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\sqrt{N}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "50eeb5bb-5de3-4d8a-a073-025e29482e28"],
 ", and the construction succeeds for ",
 StyleBox["any",
  FontWeight->Bold],
 " ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[ScriptL]\[NotEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\ell\\neq 0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "04b1a524-d5d6-465d-bb05-6b0d998babae"],
 "."
}], "Text",ExpressionUUID->"637b1a66-5349-4559-ac7d-7f02e2532474"],

Cell[TextData[{
 "Concretely, define the ",
 StyleBox["lifted budget functional",
  FontWeight->Bold],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         OverscriptBox["\[CapitalPhi]", "^"], 
         RowBox[{"(", 
           OverscriptBox[
            StyleBox["u", "TI"], "^"], ")"}], " ", ":", "\[LongEqual] ", 
         UnderscriptBox[
         "min", "partition of indices", LimitsPositioning -> True], 
         UnderscriptBox["\[Sum]", 
          StyleBox["i", "TI"], LimitsPositioning -> True], 
         FractionBox["1", 
          SuperscriptBox[
           RowBox[{"(", 
             RowBox[{
               SubscriptBox["\[Lambda]", 
                RowBox[{
                  StyleBox["k", "TI"], "(", 
                  StyleBox["i", "TI"], ")"}]], 
               SubscriptBox[
                StyleBox["u", "TI"], 
                RowBox[{
                  StyleBox["k", "TI"], "(", 
                  StyleBox["i", "TI"], ")"}]]}], ")"}], "2"]], ","}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\widehat{\\Phi}(\\hat u) \\;:=\\; \\min_{\\text{partition of indices}} \
\\sum_i \\frac{1}{(\\lambda_{k(i)} u_{k(i)})^2},", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "7a5afd71-2d3f-4fce-92f7-abd3399d7181"],
 "where the minimum is over assignments ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["k", "TI"], ":", 
         RowBox[{"[", 
           StyleBox["N", "TI"], "]"}], "\[Rule]", 
         RowBox[{"[", 
           StyleBox["N", "TI"], "]"}]}], TraditionalForm], "errors" -> {}, 
     "input" -> "k:[N]\\to[N]", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ae30e5e0-29bd-4a76-b0ba-1a19c5d1cc75"],
 " assigning to each index ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["i", "TI"], TraditionalForm], "errors" -> {}, "input" -> "i", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "fccd47be-44b3-4279-837d-b1f6648b7ccb"],
 " a \"donor\" coordinate ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["k", "TI"], "(", 
         StyleBox["i", "TI"], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "k(i)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "7094a8aa-224c-47e4-9cdd-285fc875c71e"],
 " with ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["u", "TI"], 
          RowBox[{
            StyleBox["k", "TI"], "(", 
            StyleBox["i", "TI"], ")"}]], "\[NotEqual]", "0"}], 
       TraditionalForm], "errors" -> {}, "input" -> "u_{k(i)}\\neq 0", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "9df86a6e-ee89-4356-bfd2-e799ca88a4ad"],
 ". For any direction with ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         OverscriptBox[
          StyleBox["u", "TI"], "^"], "\[NotEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\hat u\\neq 0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f30d84b2-0ff5-40b8-91d5-6362c22a4649"],
 ", ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         OverscriptBox["\[CapitalPhi]", "^"], 
         RowBox[{"(", 
           OverscriptBox[
            StyleBox["u", "TI"], "^"], ")"}], " ", "\[LessEqual] ", 
         FractionBox[
          StyleBox["N", "TI"], 
          RowBox[{
            SuperscriptBox[
             RowBox[{"(", 
               SuperscriptBox["\[Mu]", "*"], ")"}], "2"], " ", 
            UnderscriptBox["max", 
             StyleBox["k", "TI"], LimitsPositioning -> True], 
            SubsuperscriptBox[
             StyleBox["u", "TI"], 
             StyleBox["k", "TI"], "2"]}]], " ", "\[LessEqual] ", 
         FractionBox[
          SuperscriptBox[
           StyleBox["N", "TI"], "2"], 
          SuperscriptBox[
           RowBox[{"(", 
             SuperscriptBox["\[Mu]", "*"], ")"}], "2"]], ","}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\widehat{\\Phi}(\\hat u) \\;\\le\\; \\frac{N}{(\\mu^*)^2\\,\\max_k \
u_k^2} \\;\\le\\; \\frac{N^2}{(\\mu^*)^2},", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "8d9c7aeb-e255-45fb-91f8-e3249638250c"],
 "with ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox["\[Mu]", "*"], ":", "\[LongEqual]", 
         UnderscriptBox["min", 
          StyleBox["i", "TI"], LimitsPositioning -> True], "|", 
         SubscriptBox["\[Lambda]", 
          StyleBox["i", "TI"]], "|", "\[LongEqual]", "|", 
         SubscriptBox["\[Lambda]", "min"], 
         RowBox[{"(", 
           SuperscriptBox[
            StyleBox["H", "TI"], "*"], ")"}], "|"}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\mu^* := \\min_i |\\lambda_i| = |\\lambda_{\\min}(H^*)|", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "07eba7a2-4fe3-43a1-9d8e-2b461a3c7373"],
 ", since ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         UnderscriptBox["max", 
          StyleBox["k", "TI"], LimitsPositioning -> True], 
         SubsuperscriptBox[
          StyleBox["u", "TI"], 
          StyleBox["k", "TI"], "2"], "\[GreaterEqual]", "1", "/", 
         StyleBox["N", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\max_k u_k^2 \\ge 1/N", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "542ded6d-416b-401b-9faa-14d0a1ea3abc"],
 "."
}], "Text",ExpressionUUID->"8660e606-9bf7-461b-aa9e-2b98bd07fa4a"],

Cell[TextData[{
 "Thus the ",
 StyleBox["uniform bound",
  FontWeight->Bold],
 " over directions is ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> InterpretationBox["", 
       Failure[
       "TeXAssistantError", <|
        "MessageTemplate" -> "Errors: `Errors`", 
         "MessageParameters" -> <|"Errors" -> {}|>, "Input" -> 
         "\\varepsilon^*(R) \\;:=\\; \\sup_{\\hat u} \\varepsilon(R,\\hat u) \
\\;\\le\\; \\frac{2 \\rho^* N}{\\mu^* R} \\;+\\; O(R^{-2}). \
\\tag{$\\ddagger$}"|>]], "errors" -> {}, "input" -> 
     "\\varepsilon^*(R) \\;:=\\; \\sup_{\\hat u} \\varepsilon(R,\\hat u) \
\\;\\le\\; \\frac{2 \\rho^* N}{\\mu^* R} \\;+\\; O(R^{-2}). \
\\tag{$\\ddagger$}", "state" -> "Error"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ba770bae-b349-4da8-86d7-d22929dfdff0"]
}], "Text",ExpressionUUID->"1f81a256-1b7d-47f4-90c5-bedf62cf1a64"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     GrayLevel[0.8], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"db710729-c677-486d-aa70-afc702ac45f5"],

Cell["5. Main proposition", "Section",ExpressionUUID->"db9fbdd3-9c97-42dc-9957-8a8803ba0dec"],

Cell[TextData[{
 StyleBox["Proposition (\[CurlyEpsilon]-excised sign flip).",
  FontWeight->Bold],
 " Let ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["L", "TI"], "\[Element]", 
         SuperscriptBox[
          StyleBox["C", "TI"], "3"], 
         RowBox[{"(", "\[CapitalOmega]", ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> "L\\in C^3(\\Omega)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b3485f4e-7cd1-4ea5-90bb-569bf89922f2"],
 " be Morse on a bounded open set ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[CapitalOmega]", "\[Subset]", 
         SuperscriptBox[
          StyleBox["R", FontSlant -> "Plain"], 
          StyleBox["N", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\Omega\\subset\\mathbb{R}^N", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "45edcf96-a15b-44ba-82fb-95512af3d970"],
 " with finite critical set ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["Crit", FontSlant -> "Plain"], "(", 
         StyleBox["L", "TI"], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\mathrm{Crit}(L)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0d8044cc-9de6-4ab3-b658-1c7d3c7f7132"],
 ". Define ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubsuperscriptBox["\[Mu]", 
          StyleBox["k", "TI"], "*"], ":", "\[LongEqual]", "|", 
         SubscriptBox["\[Lambda]", "min"], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["H", "TI"], "(", 
             SubsuperscriptBox["\[Theta]", 
              StyleBox["k", "TI"], "*"], ")"}], ")"}], "|", ">", "0", ",    ", 
         SubsuperscriptBox["\[Rho]", 
          StyleBox["k", "TI"], "*"], ":", "\[LongEqual]", "\[Rho]", 
         RowBox[{"(", 
           SubsuperscriptBox["\[Theta]", 
            StyleBox["k", "TI"], "*"], ")"}], ",    ", 
         SubscriptBox[
          StyleBox["L", "TI"], "3"], ":", "\[LongEqual]", 
         "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", 
         SuperscriptBox[
          StyleBox["D", "TI"], "3"], 
         StyleBox["L", "TI"], 
         SubscriptBox["\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", 
          RowBox[{
            SuperscriptBox[
             StyleBox["L", "TI"], "\[Infinity]"], "(", "\[CapitalOmega]", 
            ")"}]], "."}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\mu^*_k := |\\lambda_{\\min}(H(\\theta^*_k))| > 0,\\qquad \\rho^*_k := \
\\rho(\\theta^*_k),\\qquad L_3 := |D^3 L|_{L^\\infty(\\Omega)}.", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "78da88e7-c5af-4192-b685-da707899eedf"],
 "Then for every correction budget $R > 0$, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["B", "TI"], 
          StyleBox["g", "TI"]], 
         SuperscriptBox[
          RowBox[{"(", 
            StyleBox["R", "TI"], ")"}], 
          StyleBox["c", "TI"]], "\[Intersection]", "\[CapitalOmega] ", 
         "\[SubsetEqual] ", 
         SubscriptBox["\[Union]", 
          RowBox[{
            StyleBox["k", "TI"], ": ", 
            SubsuperscriptBox["\[Rho]", 
             StyleBox["k", "TI"], "*"], ">", "0"}]], 
         OverscriptBox[
          RowBox[{
            StyleBox["B", "TI"], "(", 
            RowBox[{
              SubsuperscriptBox["\[Theta]", 
               StyleBox["k", "TI"], "*"], ", ", 
              SubscriptBox["\[Epsilon]", 
               StyleBox["k", "TI"]], 
              RowBox[{"(", 
                StyleBox["R", "TI"], ")"}]}], ")"}], "_"], ","}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\mathcal{B}_g(R)^c \\cap \\Omega \\;\\subseteq\\; \
\\bigcup_{k:\\,\\rho^*_k > 0} \
\\overline{B\\bigl(\\theta^*_k,\\;\\varepsilon_k(R)\\bigr)},", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "1636c267-3faf-471b-ae78-25dcd6884e10"],
 "where ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Epsilon]", 
          StyleBox["k", "TI"]], 
         RowBox[{"(", 
           StyleBox["R", "TI"], ")"}], " ", "\[LessEqual] ", 
         FractionBox[
          RowBox[{"2", 
            StyleBox["N", "TI"], 
            SubsuperscriptBox["\[Rho]", 
             StyleBox["k", "TI"], "*"]}], 
          RowBox[{
            SubsuperscriptBox["\[Mu]", 
             StyleBox["k", "TI"], "*"], 
            StyleBox["R", "TI"]}]], " ", "+ ", 
         StyleBox["O", "TI"], 
         RowBox[{"(", 
           SuperscriptBox[
            StyleBox["R", "TI"], "-2"], ")"}], "  ", "as ", 
         StyleBox["R", "TI"], "\[Rule]", "\[Infinity]", "."}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\varepsilon_k(R) \\;\\le\\; \\frac{2 N\\rho^*_k}{\\mu^*_k R} \\;+\\; \
O(R^{-2}) \\quad\\text{as } R\\to\\infty.", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "cee27ec1-701d-4196-959e-0456f33317a0"],
 "(Minima and points with ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubsuperscriptBox["\[Rho]", 
          StyleBox["k", "TI"], "*"], "\[LessEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\rho^*_k \\le 0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "80e31445-a798-4dba-acd2-bc47cf94abf8"],
 " contribute no excised region: the construction succeeds at budget 0 in a \
neighborhood.)",
 StyleBox["Proof.",
  FontWeight->Bold],
 " Combine (",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[FivePointedStar]", TraditionalForm], "errors" -> {},
      "input" -> "\\star", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "2e2c9754-c947-49db-afd0-2703a7137dc1"],
 "), (",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Dagger]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\dagger", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0b3a2d85-d861-46ae-9f48-1185c369566f"],
 "), and (",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[DoubleDagger]", TraditionalForm], "errors" -> {}, 
     "input" -> "\\ddagger", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "378a8878-6684-403c-be47-c9943e04a490"],
 "). For each saddle ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubsuperscriptBox["\[Theta]", 
        StyleBox["k", "TI"], "*"], TraditionalForm], "errors" -> {}, "input" -> 
     "\\theta^*_k", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "136f6e97-adfe-49a1-9fbd-f6c1595a0a4f"],
 ", points outside ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["B", "TI"], "(", 
         RowBox[{
           SubsuperscriptBox["\[Theta]", 
            StyleBox["k", "TI"], "*"], ",", 
           SubscriptBox["\[Epsilon]", 
            StyleBox["k", "TI"]], 
           RowBox[{"(", 
             StyleBox["R", "TI"], ")"}]}], ")"}], TraditionalForm], 
     "errors" -> {}, "input" -> "B(\\theta^*_k,\\varepsilon_k(R))", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "590859ef-754c-4b49-aca8-7681537d3a50"],
 " admit an admissible ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Sigma]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\sigma", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b74237ee-79da-4ff3-bf48-765d3894819c"],
 " by the Gershgorin + cross-term construction. ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> InterpretationBox["", 
       Failure[
       "TeXAssistantError", <|
        "MessageTemplate" -> "Errors: `Errors`", 
         "MessageParameters" -> <|"Errors" -> {}|>, "Input" -> "\\square"|>]],
      "errors" -> {}, "input" -> "\\square", "state" -> "Error"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "652cbf34-d65b-4eed-9f42-9ecaff100308"]
}], "Text",ExpressionUUID->"60037ad6-7b39-4c59-afa3-550684a658d3"],

