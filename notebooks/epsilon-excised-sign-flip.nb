Cell["6. Numerical verification", "Section",ExpressionUUID->"9ae26a09-0882-49a7-bf0f-b993780fb083"],

Cell[TextData[{
 "6.1 Symmetric saddle ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["L", "TI"], "\[LongEqual]", 
         SuperscriptBox[
          StyleBox["x", "TI"], "2"], "-", 
         SuperscriptBox[
          StyleBox["y", "TI"], "2"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "L = x^2 - y^2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "cba5c73b-06ba-4998-ae62-9d7d70522655"]
}], "Subsection",ExpressionUUID->"2dbbe083-d678-47ac-b950-36448b2210d1"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"H1", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"2", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", 
       RowBox[{"-", "2"}]}], "}"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ell1", "[", 
    RowBox[{"x0_", ",", "y0_"}], "]"}], ":=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"2", " ", "x0"}], ",", 
     RowBox[{
      RowBox[{"-", "2"}], " ", "y0"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rho1", "=", 
   RowBox[{"Max", "[", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"i", "==", "j"}], ",", "0", ",", 
           RowBox[{"Abs", "[", 
            RowBox[{"H1", "[", 
             RowBox[{"[", 
              RowBox[{"i", ",", "j"}], "]"}], "]"}], "]"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", "2"}], "}"}]}], "]"}], "-", 
       RowBox[{"H1", "[", 
        RowBox[{"[", 
         RowBox[{"i", ",", "i"}], "]"}], "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "2"}], "}"}]}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"mu1", "=", 
   RowBox[{"Min", "[", 
    RowBox[{"Abs", "[", 
     RowBox[{"Eigenvalues", "[", "H1", "]"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"{", 
  RowBox[{"\"\<rho* = \>\"", ",", "rho1", ",", "\"\<  mu* = \>\"", ",", "mu1",
    ",", "\"\<  predicted leading eps = \>\"", ",", "\[IndentingNewLine]", 
   " ", 
   RowBox[{
    RowBox[{"2", "*", "2", "*", 
     RowBox[{"rho1", "/", 
      RowBox[{"(", "mu1", ")"}]}]}], " ", "//", " ", "N"}], 
   ",", "\"\</ R\>\""}], "}"}]}], "Input",ExpressionUUID->"2da264f6-9f10-42e6-\
926c-af2416de94e7"],

Cell[TextData[{
 "Numerical scan along the diagonal direction ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         OverscriptBox[
          StyleBox["u", "TI"], "^"], "\[LongEqual]", 
         RowBox[{"(", 
           RowBox[{"1", ",", "1"}], ")"}], "/", 
         SqrtBox["2"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\hat u = (1,1)/\\sqrt{2}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f0886270-2af9-4222-894e-b27e34eaf180"],
 ": "
}], "CodeText",ExpressionUUID->"31573b72-e482-4d7e-9938-c2e46f43dec0"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"signFlipOk1", "[", 
     RowBox[{
      RowBox[{"x0_", "?", "NumericQ"}], ",", 
      RowBox[{"y0_", "?", "NumericQ"}], ",", 
      RowBox[{"R0_", "?", "NumericQ"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"ellVec", ",", "oneOverEllNorm", ",", "mMax"}], "}"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"ellVec", "=", 
        RowBox[{"ell1", "[", 
         RowBox[{"x0", ",", "y0"}], "]"}]}], ";", "\[IndentingNewLine]", "  ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"ellVec", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "==", "0"}], "||", 
          RowBox[{
           RowBox[{"ellVec", "[", 
            RowBox[{"[", "2", "]"}], "]"}], "==", "0"}]}], ",", 
         RowBox[{"Return", "[", "False", "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"oneOverEllNorm", "=", 
        RowBox[{"Sqrt", "[", 
         RowBox[{"Total", "[", 
          RowBox[{"1", "/", 
           RowBox[{"ellVec", "^", "2"}]}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"mMax", "=", 
        RowBox[{"R0", "/", 
         RowBox[{"(", 
          RowBox[{"2", " ", "oneOverEllNorm"}], ")"}]}]}], ";", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"mMax", ">", "rho1"}]}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"findFail1", "[", 
     RowBox[{"R0_", ",", "dir_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"rs", "=", 
         RowBox[{"Range", "[", 
          RowBox[{"0.001", ",", "5", ",", "0.001"}], "]"}]}], ",", "idx"}], 
       "}"}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"idx", "=", 
        RowBox[{"SelectFirst", "[", 
         RowBox[{
          RowBox[{"Range", "[", 
           RowBox[{"Length", "[", "rs", "]"}], "]"}], ",", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{
           RowBox[{"signFlipOk1", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"rs", "[", 
               RowBox[{"[", "#", "]"}], "]"}], " ", 
              RowBox[{"dir", "[", 
               RowBox[{"[", "1", "]"}], "]"}]}], ",", 
             RowBox[{
              RowBox[{"rs", "[", 
               RowBox[{"[", "#", "]"}], "]"}], " ", 
              RowBox[{"dir", "[", 
               RowBox[{"[", "2", "]"}], "]"}]}], ",", "R0"}], "]"}], " ", 
           "&"}], ",", 
          RowBox[{"Length", "[", "rs", "]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"rs", "[", 
        RowBox[{"[", "idx", "]"}], "]"}]}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"predicted1", "[", "R0_", "]"}], ":=", 
    RowBox[{"4", "/", "R0"}]}], ";"}], "  ", 
  RowBox[{"(*", " ", 
   RowBox[{"sharp", " ", "on", " ", "diagonal"}], " ", "*)"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"TableForm", "[", "\[IndentingNewLine]", "  ", 
  RowBox[{
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"R0", ",", 
       RowBox[{"N", "@", 
        RowBox[{"predicted1", "[", "R0", "]"}]}], ",", 
       RowBox[{"findFail1", "[", 
        RowBox[{"R0", ",", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"1", ",", "1"}], "}"}], "/", 
          RowBox[{"Sqrt", "[", "2", "]"}]}]}], "]"}]}], "}"}], ",", 
     "\[IndentingNewLine]", "        ", 
     RowBox[{"{", 
      RowBox[{"R0", ",", 
       RowBox[{"{", 
        RowBox[{
        "2", ",", "5", ",", "10", ",", "20", ",", "50", ",", "100", ",", 
         "200"}], "}"}]}], "}"}]}], "]"}], ",", "\[IndentingNewLine]", "  ", 
   RowBox[{"TableHeadings", "->", 
    RowBox[{"{", 
     RowBox[{"None", ",", 
      RowBox[{"{", 
       RowBox[{"\"\<R\>\"", ",", "\"\<Predicted 4/R\>\"", 
        ",", "\"\<Observed eps\>\""}], "}"}]}], "}"}]}]}], "]"}]}], "Input",Ex\
pressionUUID->"5db55cbc-c65e-476b-9067-5adc98b43c82"],

Cell[TextData[{
 "The predicted ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Epsilon]", 
         RowBox[{"(", 
           StyleBox["R", "TI"], ")"}], "\[LongEqual]", "4", "/", 
         StyleBox["R", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\varepsilon(R) = 4/R", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "3edbce69-9f69-496c-b899-5b8287432336"],
 " matches observation to within the ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox["10", "-3"], TraditionalForm], "errors" -> {}, "input" -> 
     "10^{-3}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "38cc8778-0434-4114-be27-e1560634d79a"],
 " scan resolution. The proposition's worst-case bound ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"2", 
         StyleBox["N", "TI"], 
         SuperscriptBox["\[Rho]", "*"], "/", 
         RowBox[{"(", 
           RowBox[{
             SuperscriptBox["\[Mu]", "*"], 
             StyleBox["R", "TI"]}], ")"}], "\[LongEqual]", "4", "/", 
         StyleBox["R", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "2 N \\rho^*/(\\mu^* R) = 4/R", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a0423aa5-d00e-47a0-87e1-7ad03274436a"],
 " is ",
 StyleBox["sharp",
  FontWeight->Bold],
 " for the symmetric saddle. "
}], "Text",ExpressionUUID->"23e03e64-6c7e-4713-8316-c9ee1244d8b0"],

Cell[TextData[{
 "6.2 Asymmetric saddle ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["L", "TI"], "\[LongEqual]", 
         SuperscriptBox[
          StyleBox["x", "TI"], "2"], "-", "3", 
         SuperscriptBox[
          StyleBox["y", "TI"], "2"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "L = x^2 - 3 y^2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c3dd6ab9-1ea8-4446-898a-a1fca9cb26b8"]
}], "Subsection",ExpressionUUID->"6673d3d0-0a4c-46b7-ac41-2cb6f9fd61fd"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"H2", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"2", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", 
       RowBox[{"-", "6"}]}], "}"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ell2", "[", 
    RowBox[{"x0_", ",", "y0_"}], "]"}], ":=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"2", " ", "x0"}], ",", 
     RowBox[{
      RowBox[{"-", "6"}], " ", "y0"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rho2", "=", 
   RowBox[{"Max", "[", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"i", "==", "j"}], ",", "0", ",", 
           RowBox[{"Abs", "[", 
            RowBox[{"H2", "[", 
             RowBox[{"[", 
              RowBox[{"i", ",", "j"}], "]"}], "]"}], "]"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", "2"}], "}"}]}], "]"}], "-", 
       RowBox[{"H2", "[", 
        RowBox[{"[", 
         RowBox[{"i", ",", "i"}], "]"}], "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "2"}], "}"}]}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"mu2", "=", 
    RowBox[{"Min", "[", 
     RowBox[{"Abs", "[", 
      RowBox[{"Eigenvalues", "[", "H2", "]"}], "]"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"signFlipOk2", "[", 
     RowBox[{
      RowBox[{"x0_", "?", "NumericQ"}], ",", 
      RowBox[{"y0_", "?", "NumericQ"}], ",", 
      RowBox[{"R0_", "?", "NumericQ"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"ellVec", ",", "oneOverEllNorm", ",", "mMax"}], "}"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"ellVec", "=", 
        RowBox[{"ell2", "[", 
         RowBox[{"x0", ",", "y0"}], "]"}]}], ";", "\[IndentingNewLine]", "  ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"ellVec", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "==", "0"}], "||", 
          RowBox[{
           RowBox[{"ellVec", "[", 
            RowBox[{"[", "2", "]"}], "]"}], "==", "0"}]}], ",", 
         RowBox[{"Return", "[", "False", "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"oneOverEllNorm", "=", 
        RowBox[{"Sqrt", "[", 
         RowBox[{"Total", "[", 
          RowBox[{"1", "/", 
           RowBox[{"ellVec", "^", "2"}]}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"mMax", "=", 
        RowBox[{"R0", "/", 
         RowBox[{"(", 
          RowBox[{"2", " ", "oneOverEllNorm"}], ")"}]}]}], ";", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"mMax", ">", "rho2"}]}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"Along", " ", "diagonal", " ", "direction"}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"predicted2", "[", "R0_", "]"}], ":=", 
    RowBox[{"6", " ", 
     RowBox[{
      RowBox[{"Sqrt", "[", 
       RowBox[{"20", "/", "9"}], "]"}], "/", "R0"}]}]}], ";"}], "  ", 
  RowBox[{"(*", " ", 
   RowBox[{"direction", "-", 
    RowBox[{"specific", " ", "via", " ", "Phi"}]}], " ", "*)"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"TableForm", "[", "\[IndentingNewLine]", "  ", 
  RowBox[{
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"R0", ",", 
       RowBox[{"N", "@", 
        RowBox[{"predicted2", "[", "R0", "]"}]}], ",", "\[IndentingNewLine]", 
       "         ", 
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"rs", "=", 
            RowBox[{"Range", "[", 
             RowBox[{"0.001", ",", "10", ",", "0.001"}], "]"}]}], ",", 
           "idx"}], "}"}], ",", "\[IndentingNewLine]", "           ", 
         RowBox[{
          RowBox[{"idx", "=", 
           RowBox[{"SelectFirst", "[", 
            RowBox[{
             RowBox[{"Range", "[", 
              RowBox[{"Length", "[", "rs", "]"}], "]"}], ",", 
             "\[IndentingNewLine]", "             ", 
             RowBox[{
              RowBox[{"signFlipOk2", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"rs", "[", 
                  RowBox[{"[", "#", "]"}], "]"}], "/", 
                 RowBox[{"Sqrt", "[", "2", "]"}]}], ",", 
                RowBox[{
                 RowBox[{"rs", "[", 
                  RowBox[{"[", "#", "]"}], "]"}], "/", 
                 RowBox[{"Sqrt", "[", "2", "]"}]}], ",", "R0"}], "]"}], " ", 
              "&"}], ",", 
             RowBox[{"Length", "[", "rs", "]"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", "           ", 
          RowBox[{"rs", "[", 
           RowBox[{"[", "idx", "]"}], "]"}]}]}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"R0", ",", 
       RowBox[{"{", 
        RowBox[{
        "5", ",", "10", ",", "20", ",", "50", ",", "100", ",", "200"}], 
        "}"}]}], "}"}]}], "]"}], ",", "\[IndentingNewLine]", "  ", 
   RowBox[{"TableHeadings", "->", 
    RowBox[{"{", 
     RowBox[{"None", ",", 
      RowBox[{"{", 
       RowBox[{"\"\<R\>\"", ",", "\"\<Predicted (diag dir)\>\"", 
        ",", "\"\<Observed\>\""}], "}"}]}], "}"}]}]}], "]"}]}], "Input",Expres\
sionUUID->"6f1f29a0-4711-46fe-a471-db081838de64"],

Cell[TextData[{
 "6.3 Quartic well ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["L", "TI"], "\[LongEqual]", 
         SuperscriptBox[
          StyleBox["x", "TI"], "4"], "+", 
         SuperscriptBox[
          StyleBox["y", "TI"], "4"], "-", "2", 
         SuperscriptBox[
