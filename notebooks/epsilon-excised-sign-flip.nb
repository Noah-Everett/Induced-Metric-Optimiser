 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"b88a4d6c-bc24-4a62-88a4-7e63f9e46fd3"],

Cell["8. Open / deferred", "Section",ExpressionUUID->"8e2625f1-037d-4beb-919c-9adffde64961"],

Cell[TextData[{
 StyleBox["Degenerate critical points",
  FontWeight->Bold],
 " (monkey saddle ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["L", "TI"], "\[LongEqual]", 
         SuperscriptBox[
          StyleBox["x", "TI"], "3"], "-", "3", 
         StyleBox["x", "TI"], 
         SuperscriptBox[
          StyleBox["y", "TI"], "2"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "L = x^3 - 3 x y^2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "47012a53-f511-4bdd-af9e-84ce92bfb4a9"],
 "): ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["H", "TI"], "*"], "\[LongEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "H^* = 0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "3efdd241-ad47-4e7b-a1e9-f6a6124a5947"],
 ", so ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox["\[Mu]", "*"], "\[LongEqual]", "0"}], 
       TraditionalForm], "errors" -> {}, "input" -> "\\mu^* = 0", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "84851ee5-d876-44d2-8008-1f8dc229c7d0"],
 " and (",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[DoubleDagger]", TraditionalForm], "errors" -> {}, 
     "input" -> "\\ddagger", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "fb180408-dfa6-4f93-87eb-c76c4964a359"],
 ") diverges. Needs a separate \[CurlyEpsilon]-scaling using the leading \
nonzero term of the Taylor expansion. Tracked in a sub-issue of IMO-174."
}], "Item",ExpressionUUID->"f89bb83a-7d78-474f-9741-5c5567340cde"],

Cell[TextData[{
 "Sharpness of the ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["N", "TI"], TraditionalForm], "errors" -> {}, "input" -> "N", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b4eb038a-2347-40c4-aa32-7d9268d5870d"],
 "-dependence",
 " in (",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[DoubleDagger]", TraditionalForm], "errors" -> {}, 
     "input" -> "\\ddagger", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "31d8cbb6-7d9e-41e0-8a8b-371acd9d0914"],
 "): the cross-term lift gives ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         OverscriptBox["\[CapitalPhi]", "^"], "\[LessEqual]", 
         SuperscriptBox[
          StyleBox["N", "TI"], "2"], "/", 
         SuperscriptBox[
          RowBox[{"(", 
            SuperscriptBox["\[Mu]", "*"], ")"}], "2"]}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\widehat\\Phi \\le N^2/(\\mu^*)^2", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "6648e3f1-9a70-45e4-b0ae-1d9dec9e722f"],
 ", but generic directions concentrate ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       OverscriptBox["\[CapitalPhi]", "^"], TraditionalForm], "errors" -> {}, 
     "input" -> "\\widehat\\Phi", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "9daca2ae-5d41-45d8-800d-70c8241747ab"],
 " around ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["N", "TI"], "/", 
         SuperscriptBox[
          RowBox[{"(", 
            SuperscriptBox["\[Mu]", "*"], ")"}], "2"]}], TraditionalForm], 
     "errors" -> {}, "input" -> "N/(\\mu^*)^2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e441202c-7467-4855-8eb0-bb6222ddad60"],
 ". Open: is the ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["N", "TI"], TraditionalForm], "errors" -> {}, "input" -> "N", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "1a7a49a9-2e60-409a-8b2a-3f5b3d0c645c"],
 " in (",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[DoubleDagger]", TraditionalForm], "errors" -> {}, 
     "input" -> "\\ddagger", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f9e0ed4f-1a0b-4611-8f3a-7a88bd0e9017"],
 ") tight, or can the cross-term construction achieve ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SqrtBox[
        StyleBox["N", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\sqrt N", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c12652ff-42ab-4e82-a082-69ae096ce6a9"],
 "?"
}], "Item",ExpressionUUID->"7016568d-4f75-498f-9e48-1941fc02f97b"],

Cell[TextData[{
 StyleBox["Stochastic gradients:",
  FontWeight->Bold],
 " the analysis assumes exact ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[ScriptL]", TraditionalForm], "errors" -> {}, 
     "input" -> "\\ell", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e59b4e9b-f008-4193-817a-40698d0ca161"],
 ", ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["H", "TI"], TraditionalForm], "errors" -> {}, "input" -> "H", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0fd041da-73a5-4109-b9f9-e845e33f7548"],
 ". Stochastic versions would replace (",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[FivePointedStar]", TraditionalForm], "errors" -> {},
      "input" -> "\\star", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "3f494a88-7178-4916-957e-4d5ce8870468"],
 ") with a probabilistic sign-flip with high probability, and \[CurlyEpsilon] \
with an \"effective\" \[CurlyEpsilon] accounting for noise."
}], "Item",ExpressionUUID->"7e1a332e-dd21-4e60-a91b-1b454b253359"],

