}], "Subsection",ExpressionUUID->"3d4c251d-8cbc-4792-b3eb-35143900a981"],

Cell[TextData[{
 "Multiple critical points: minima at ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"(", 
         RowBox[{"\[PlusMinus]", "1", ",", "\[PlusMinus]", "1"}], ")"}], 
       TraditionalForm], "errors" -> {}, "input" -> "(\\pm 1,\\pm 1)", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "3104e19a-95a4-4f45-a60e-1a8b80b988d8"],
 ", saddles at ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         RowBox[{"(", 
           RowBox[{"\[PlusMinus]", "1", ",", "0"}], ")"}], ",", 
         RowBox[{"(", 
           RowBox[{"0", ",", "\[PlusMinus]", "1"}], ")"}]}], TraditionalForm],
      "errors" -> {}, "input" -> "(\\pm 1,0), (0,\\pm 1)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c1f81c00-ce2e-45dc-9371-bd2f1aa5a7f5"],
 ", max at $(0,0)$. The proposition predicts the failure region is the union \
of \[CurlyEpsilon]-balls around the 5 non-minimum critical points. "
}], "Text",ExpressionUUID->"6be7e106-5737-4bdb-97e4-c7c089e23f21"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"L3f", "[", 
    RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"x", "^", "4"}], "+", 
    RowBox[{"y", "^", "4"}], "-", 
    RowBox[{"2", " ", 
     RowBox[{"x", "^", "2"}]}], "-", 
    RowBox[{"2", " ", 
     RowBox[{"y", "^", "2"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"grad3", "[", 
    RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"4", " ", 
       RowBox[{"x", "^", "3"}]}], "-", 
      RowBox[{"4", " ", "x"}]}], ",", 
     RowBox[{
      RowBox[{"4", " ", 
       RowBox[{"y", "^", "3"}]}], "-", 
      RowBox[{"4", " ", "y"}]}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"hess3", "[", 
     RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"12", " ", 
          RowBox[{"x", "^", "2"}]}], "-", "4"}], ",", "0"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"0", ",", 
        RowBox[{
         RowBox[{"12", " ", 
          RowBox[{"y", "^", "2"}]}], "-", "4"}]}], "}"}]}], "}"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"Sign", "-", 
    RowBox[{"flip", " ", "test", " ", "at", " ", "point", " ", 
     RowBox[{"(", 
      RowBox[{"x", ",", "y"}], ")"}], " ", "with", " ", "budget", " ", 
     "R"}]}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"signFlipOk3", "[", 
     RowBox[{
      RowBox[{"x0_", "?", "NumericQ"}], ",", 
      RowBox[{"y0_", "?", "NumericQ"}], ",", 
      RowBox[{"R0_", "?", "NumericQ"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "ellVec", ",", "oneOverEllNorm", ",", "mMax", ",", "h", ",", "rho"}], 
       "}"}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"ellVec", "=", 
        RowBox[{"grad3", "[", 
         RowBox[{"x0", ",", "y0"}], "]"}]}], ";", "\[IndentingNewLine]", "  ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"Abs", "[", 
            RowBox[{"ellVec", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "]"}], "<", 
           RowBox[{"10", "^", 
            RowBox[{"-", "12"}]}]}], "||", 
          RowBox[{
           RowBox[{"Abs", "[", 
            RowBox[{"ellVec", "[", 
             RowBox[{"[", "2", "]"}], "]"}], "]"}], "<", 
           RowBox[{"10", "^", 
            RowBox[{"-", "12"}]}]}]}], ",", 
         RowBox[{"Return", "[", "False", "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"h", "=", 
        RowBox[{"hess3", "[", 
         RowBox[{"x0", ",", "y0"}], "]"}]}], ";", "\[IndentingNewLine]", "  ", 
       RowBox[{"rho", "=", 
        RowBox[{"Max", "[", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Sum", "[", 
             RowBox[{
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"i", "==", "j"}], ",", "0", ",", 
                RowBox[{"Abs", "[", 
                 RowBox[{"h", "[", 
                  RowBox[{"[", 
                   RowBox[{"i", ",", "j"}], "]"}], "]"}], "]"}]}], "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"j", ",", "2"}], "}"}]}], "]"}], "-", 
            RowBox[{"h", "[", 
             RowBox[{"[", 
              RowBox[{"i", ",", "i"}], "]"}], "]"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "2"}], "}"}]}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"rho", "<=", "0"}], ",", 
         RowBox[{"Return", "[", "True", "]"}]}], "]"}], ";", "  ", 
       RowBox[{"(*", " ", 
        RowBox[{"already", " ", "locally", " ", "convex"}], " ", "*)"}], 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"oneOverEllNorm", "=", 
        RowBox[{"Sqrt", "[", 
         RowBox[{"Total", "[", 
          RowBox[{"1", "/", 
           RowBox[{"ellVec", "^", "2"}]}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"mMax", "=", 
        RowBox[{"R0", "/", 
         RowBox[{"(", 
          RowBox[{"2", " ", "oneOverEllNorm"}], ")"}]}]}], ";", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"mMax", ">", "rho"}]}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Visualize", " ", "failure", " ", "region", " ", "at", " ", "R"}],
     " ", "=", " ", "20"}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{"ContourPlot", "[", 
  RowBox[{
   RowBox[{"Boole", "[", 
    RowBox[{"!", 
     RowBox[{"signFlipOk3", "[", 
      RowBox[{"x", ",", "y", ",", "20"}], "]"}]}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"-", "1.5"}], ",", "1.5"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"y", ",", 
     RowBox[{"-", "1.5"}], ",", "1.5"}], "}"}], ",", "\[IndentingNewLine]", 
   "  ", 
   RowBox[{"PlotPoints", "->", "80"}], ",", 
   RowBox[{"ContourShading", "->", 
    RowBox[{"{", 
     RowBox[{"White", ",", "LightRed"}], "}"}]}], ",", "\[IndentingNewLine]", 
   "  ", 
   RowBox[{"Epilog", "->", 
    RowBox[{"{", 
     RowBox[{"Black", ",", 
      RowBox[{"PointSize", "[", "0.012", "]"}], ",", "\[IndentingNewLine]", 
      "    ", 
      RowBox[{"Point", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", "0"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", "0"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "1"}], ",", "0"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"0", ",", "1"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"0", ",", 
           RowBox[{"-", "1"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", "1"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", 
           RowBox[{"-", "1"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "1"}], ",", 
           RowBox[{"-", "1"}]}], "}"}]}], "}"}], "]"}]}], "}"}]}], ",", 
   "\[IndentingNewLine]", "  ", 
   RowBox[{
   "PlotLabel", 
    "->", "\"\<Failure region at R=20 (red); critical points (dots)\>\""}]}], 
  "]"}]}], "Input",ExpressionUUID->"8bc91b3d-46a9-4f44-b64e-80e9b4b444b0"],

Cell[TextData[{
 "The failure region forms thin tubes around the saddles and the maximum, \
plus expected thin strips along the coordinate axes (where ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[ScriptL]", 
          StyleBox["i", "TI"]], "\[LongEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\ell_i = 0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "6cbe6bb3-af43-4ad4-ba30-a0fd0065bc1b"],
 ", exactly the directions where the diagonal-only construction needs the \
cross-term lift). "
}], "Text",ExpressionUUID->"a610587d-a7fb-413d-9541-0b1bee0ddbe9"],

