Notebook[{
Cell[TextData[{
 "Deriving the Metric Clip Value ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["c", "TI"], TraditionalForm], "errors" -> {}, "input" -> "c", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "3ad9e05d-16fb-45b7-b1d1-c752c6cc9022"],
 " (IMO-125)"
}], "Title",ExpressionUUID->"6bbfe4d8-a3b7-4e34-b910-ba979df57779"],

Cell[TextData[{
 "Companion to ",
 Cell[BoxData[Cell["notes/metric-clip-derivation.md",
   Background->None,ExpressionUUID->"10007001-8d92-4f82-9754-d69f9712928a"]], 
  "InlineCode",ExpressionUUID->"cf61da56-4d81-48b0-8756-ba2fb1059ae2"],
 ". All results verified here. "
}], "Text",ExpressionUUID->"bc186f41-f8b8-41df-8d68-6e6bea3d2696"],

Cell["1. What the clip does", "Section",ExpressionUUID->"73755a39-4702-4c5d-a22d-b11596bbdb48"],

Cell[TextData[{
 "After mean-centering, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["s", "TI"], 
          StyleBox["i", "TI"]], "\[Element]", 
         RowBox[{"[", 
           RowBox[{"-", 
             StyleBox["c", "TI"], ",", 
             StyleBox["c", "TI"]}], "]"}]}], TraditionalForm], "errors" -> {},
      "input" -> "s_i \\in [-c, c]", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c719fa51-0289-43b7-8999-1866883f52cc"],
 " bounds the preconditioner condition number: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Kappa]", 
          StyleBox["M", "TI"]], "\[LongEqual]", 
         FractionBox[
          RowBox[{
            UnderscriptBox["max", 
             StyleBox["i", "TI"], LimitsPositioning -> True], 
            SuperscriptBox[
             StyleBox["e", "TI"], 
             SubscriptBox[
              StyleBox["s", "TI"], 
              StyleBox["i", "TI"]]]}], 
          RowBox[{
            UnderscriptBox["min", 
             StyleBox["i", "TI"], LimitsPositioning -> True], 
            SuperscriptBox[
             StyleBox["e", "TI"], 
             SubscriptBox[
              StyleBox["s", "TI"], 
              StyleBox["i", "TI"]]]}]], "\[LessEqual]", 
         SuperscriptBox[
          StyleBox["e", "TI"], 
          RowBox[{"2", 
            StyleBox["c", "TI"]}]]}], TraditionalForm], "errors" -> {}, 
     "input" -> 
     "\\kappa_M = \\frac{\\max_i e^{s_i}}{\\min_i e^{s_i}} \\le e^{2c}", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "6d879ab0-9350-4bc1-a7e9-a175c20efe64"]
}], "Text",ExpressionUUID->"8f4a20a8-ac2a-4c46-8666-80cd865af1b4"],

Cell[BoxData[
 RowBox[{"Grid", "[", "\[IndentingNewLine]", "  ", 
  RowBox[{
   RowBox[{"Prepend", "[", "\[IndentingNewLine]", "    ", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"c0", ",", 
         RowBox[{"N", "[", 
          RowBox[{
           RowBox[{"Exp", "[", 
            RowBox[{"2", " ", "c0"}], "]"}], ",", "5"}], "]"}]}], "}"}], ",", 
       
       RowBox[{"{", 
        RowBox[{"c0", ",", 
         RowBox[{"{", 
          RowBox[{
          "1", ",", "2", ",", "3", ",", "4", ",", "5", ",", "6", ",", "8", ",",
            "10"}], "}"}]}], "}"}]}], "]"}], ",", "\[IndentingNewLine]", 
     "    ", 
     RowBox[{"{", 
      RowBox[{"\"\<c\>\"", ",", "\"\<kappa_M = e^(2c)\>\""}], "}"}]}], 
    "\[IndentingNewLine]", "  ", "]"}], ",", "\[IndentingNewLine]", "  ", 
   RowBox[{"Frame", "->", "All"}], ",", 
   RowBox[{"Alignment", "->", "Left"}]}], "\[IndentingNewLine]", 
  "]"}]], "Input",ExpressionUUID->"3ca2224e-fb5e-4de2-aa4d-ebe3aa92f966"],

Cell["2. Newton target range analysis", "Section",ExpressionUUID->"bcc25003-28de-4202-9e47-0f50292912e1"],

Cell[TextData[{
 "The mean-centered Newton target is ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubsuperscriptBox[
          StyleBox["s", "TI"], 
          StyleBox["i", "TI"], "*"], "\[LongEqual]", "log", 
         RowBox[{"(", 
           RowBox[{
             SubscriptBox[
              StyleBox["h", "TI"], "geo"], "/", 
             SubscriptBox[
              StyleBox["h", "TI"], 
              StyleBox["i", "TI"]]}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> "s_i^* = \\log(h_{\\text{geo}}/h_i)", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "dac5724c-3f89-4326-b6f2-64eada8b0480"],
 ". For the clip to be inactive at equilibrium we need ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         UnderscriptBox["max", 
          StyleBox["i", "TI"], LimitsPositioning -> True], "|", 
         SubsuperscriptBox[
          StyleBox["s", "TI"], 
          StyleBox["i", "TI"], "*"], "|", "\[LessEqual]", 
         StyleBox["c", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\max_i |s_i^*| \\le c", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e8583ead-f1bd-4699-8e2a-8aa67cc1bb1c"],
 ". "
}], "Text",ExpressionUUID->"1be72835-b107-43a8-bcba-c93e1118d31d"],

Cell["Log-uniform spectrum (balanced case)", "Subsection",ExpressionUUID->"dd958ba4-cdf6-4c71-8119-c2a6e66088df"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"nDim", "=", "10"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"hVals", "=", 
   RowBox[{
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"i", "-", "1"}], ")"}], "/", 
         RowBox[{"(", 
          RowBox[{"nDim", "-", "1"}], ")"}]}], "*", 
        RowBox[{"Log", "[", "1000", "]"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "nDim"}], "}"}]}], "]"}], " ", "//", " ", "N"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"logHMean", "=", 
   RowBox[{"Mean", "[", 
    RowBox[{"Log", "[", "hVals", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"hGeoVal", "=", 
   RowBox[{"Exp", "[", "logHMean", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"sStarVals", "=", 
    RowBox[{
     RowBox[{"Log", "[", "hGeoVal", "]"}], "-", 
     RowBox[{"Log", "[", "hVals", "]"}]}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  RowBox[{"\"\<Newton target s* (mean-centered): \>\"", ",", 
   RowBox[{"N", "[", 
    RowBox[{"sStarVals", ",", "5"}], "]"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  RowBox[{"\"\<max|s*| = \>\"", ",", 
   RowBox[{"Max", "[", 
    RowBox[{"Abs", "[", "sStarVals", "]"}], "]"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  RowBox[{"\"\<Log[kappa]/2 = \>\"", ",", 
   RowBox[{"N", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Log", "[", "1000", "]"}], "/", "2"}], ",", "10"}], "]"}]}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Result", ":", " ", 
     RowBox[{"max", "|", 
      RowBox[{"s", "*"}], "|"}]}], " ", "=", " ", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"Log", "[", "kappa", "]"}], "/", "2"}], " ", "exactly", " ", 
      "for", " ", "log"}], "-", 
     RowBox[{"uniform", " ", "spectrum"}]}]}], " ", "*)"}]}]}], "Input",Expres\
sionUUID->"78eaccf1-0114-4e85-87fb-6da7b062d7e6"],

Cell["Skewed spectrum: one outlier eigenvalue", "Subsection",ExpressionUUID->"2ecf2f8f-fa4d-459a-9729-b6ed1b6f9685"],

Cell[BoxData[{
 RowBox[{"Print", 
  "[", "\"\<=== Skewed distributions: 1 small, (N-1) large ===\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Do", "[", "\[IndentingNewLine]", "  ", 
   RowBox[{
    RowBox[{
     RowBox[{"hVals", "=", 
      RowBox[{"Join", "[", 
       RowBox[{
        RowBox[{"{", "1", "}"}], ",", 
        RowBox[{"Table", "[", 
         RowBox[{"100", ",", 
          RowBox[{"{", 
           RowBox[{"n0", "-", "1"}], "}"}]}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"logHMean", "=", 
      RowBox[{"Mean", "[", 
       RowBox[{"Log", "[", "hVals", "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"sStarVals", "=", 
      RowBox[{"logHMean", "-", 
       RowBox[{"Log", "[", "hVals", "]"}]}]}], ";", "\[IndentingNewLine]", 
     "  ", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<N=\>\"", ",", "n0", ",", "\[IndentingNewLine]", 
       "    ", "\"\<  max|s*|=\>\"", ",", 
       RowBox[{"N", "[", 
        RowBox[{
         RowBox[{"Max", "[", 
          RowBox[{"Abs", "[", "sStarVals", "]"}], "]"}], ",", "5"}], "]"}], ",",
        "\[IndentingNewLine]", "    ", "\"\<  Log[kappa]/2=\>\"", ",", 
       RowBox[{"N", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Log", "[", "100", "]"}], "/", "2"}], ",", "5"}], "]"}], ",",
        "\[IndentingNewLine]", "    ", "\"\<  ratio=\>\"", ",", 
       RowBox[{"N", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Max", "[", 
           RowBox[{"Abs", "[", "sStarVals", "]"}], "]"}], "/", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"Log", "[", "100", "]"}], "/", "2"}], ")"}]}], ",", "4"}],
         "]"}]}], "]"}]}], ",", "\[IndentingNewLine]", "  ", 
    RowBox[{"{", 
     RowBox[{"n0", ",", 
      RowBox[{"{", 
       RowBox[{"2", ",", "5", ",", "10", ",", "50", ",", "100", ",", "1000"}],
        "}"}]}], "}"}]}], "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Result", ":", " ", "ratio"}], " ", "->", " ", 
    RowBox[{
     RowBox[{"2", " ", "as", " ", "N"}], " ", "->", " ", "infinity"}]}], " ", 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"max", "|", 
     RowBox[{"s", "*"}], "|"}], " ", "=", " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"N", "-", "1"}], ")"}], "/", "N"}], ")"}], " ", "*", " ", 
     RowBox[{"Log", "[", "kappa", "]"}]}]}], " ", "*)"}]}]}], "Input",Expressi\
onUUID->"c849a6d0-80cf-4fd1-9e0c-0841e611b30b"],

Cell["Analytic derivation", "Subsection",ExpressionUUID->"2c406b46-bb67-4aca-b56e-206e3431199e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"n", ",", "hMin", ",", "hMax"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"logHGeo", "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", "/", "n"}], ")"}], "*", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"Log", "[", "hMin", "]"}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"n", "-", "1"}], ")"}], "*", 
       RowBox[{"Log", "[", "hMax", "]"}]}]}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sSmall", "=", 
   RowBox[{
    RowBox[{"logHGeo", "-", 
     RowBox[{"Log", "[", "hMin", "]"}]}], " ", "//", " ", "Simplify"}]}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"=", " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"n", "-", "1"}], ")"}], "/", "n"}], ")"}], " ", "*", " ", 
     RowBox[{"Log", "[", 
      RowBox[{"hMax", "/", "hMin"}], "]"}]}]}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{"sLarge", "=", 
  RowBox[{
   RowBox[{"logHGeo", "-", 
    RowBox[{"Log", "[", "hMax", "]"}]}], " ", "//", " ", "Simplify"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"=", " ", 
    RowBox[{
     RowBox[{"-", 
      RowBox[{"(", 
       RowBox[{"1", "/", "n"}], ")"}]}], " ", "*", " ", 
     RowBox[{"Log", "[", 
      RowBox[{"hMax", "/", "hMin"}], "]"}]}]}], " ", "*)"}]}]}], "Input",Expre\
ssionUUID->"0f915536-d747-44a4-999a-9491f719d781"],

Cell["What condition number does c=4 allow?", "Subsection",ExpressionUUID->"41b6018e-21d5-4099-abaf-8b14c39eab27"],

Cell[BoxData[{
 RowBox[{"Do", "[", "\[IndentingNewLine]", "  ", 
  RowBox[{
   RowBox[{
    RowBox[{"kappaAllowed", "=", 
     RowBox[{"Exp", "[", 
      RowBox[{"4", "*", 
       RowBox[{"n0", "/", 
        RowBox[{"(", 
         RowBox[{"n0", "-", "1"}], ")"}]}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", "  ", 
    RowBox[{"Print", "[", 
     RowBox[{"\"\<N=\>\"", ",", "n0", ",", "\"\<:  kappa_max = \>\"", ",", 
      RowBox[{"N", "[", 
       RowBox[{"kappaAllowed", ",", "5"}], "]"}]}], "]"}]}], ",", 
   "\[IndentingNewLine]", "  ", 
   RowBox[{"{", 
    RowBox[{"n0", ",", 
     RowBox[{"{", 
      RowBox[{"2", ",", "10", ",", "100", ",", "1000"}], "}"}]}], "}"}]}], 
  "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  RowBox[{"\"\<Balanced: kappa_max = e^8 = \>\"", ",", 
   RowBox[{"N", "[", 
    RowBox[{
     RowBox[{"Exp", "[", "8", "]"}], ",", "5"}], "]"}]}], "]"}]}], "Input",Exp\
ressionUUID->"71dfb337-c4f4-46dd-a9a2-5bdaaac219b9"],

Cell["3. Stability of clipped components", "Section",ExpressionUUID->"834e5ef4-5ce1-42f6-901d-69994a548261"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"nDim3", "=", "100"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"hVals3", "=", 
   RowBox[{
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"i", "-", "1"}], ")"}], "/", 
         RowBox[{"(", 
          RowBox[{"nDim3", "-", "1"}], ")"}]}], "*", 
        RowBox[{"Log", "[", "1000", "]"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "nDim3"}], "}"}]}], "]"}], " ", "//", " ", "N"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"hGeo3", "=", 
   RowBox[{"Exp", "[", 
    RowBox[{"Mean", "[", 
     RowBox[{"Log", "[", "hVals3", "]"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sTrue3", "=", 
   RowBox[{
    RowBox[{"Log", "[", "hGeo3", "]"}], "-", 
    RowBox[{"Log", "[", "hVals3", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"eta0", "=", 
    RowBox[{"0.8", "/", "hGeo3"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  RowBox[{"\"\<N=100, kappa=1000, hGeo=\>\"", ",", 
   RowBox[{"N", "[", 
    RowBox[{"hGeo3", ",", "5"}], "]"}], ",", "\"\<, eta=\>\"", ",", 
   RowBox[{"N", "[", 
    RowBox[{"eta0", ",", "5"}], "]"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Stability bound: c > Log[eta*hMax/2] = \>\"", ",", 
    RowBox[{"N", "[", 
     RowBox[{
      RowBox[{"Log", "[", 
       RowBox[{"eta0", "*", 
        RowBox[{"1000", "/", "2"}]}], "]"}], ",", "5"}], "]"}]}], "]"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"Do", "[", "\[IndentingNewLine]", "  ", 
  RowBox[{
   RowBox[{
    RowBox[{"sClipped", "=", 
     RowBox[{"Clip", "[", 
      RowBox[{"sTrue3", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "cVal"}], ",", "cVal"}], "}"}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", "  ", 
    RowBox[{"rhoVals", "=", 
     RowBox[{"Abs", "[", 
      RowBox[{"1", "-", 
       RowBox[{"eta0", "*", 
        RowBox[{"Exp", "[", "sClipped", "]"}], "*", "hVals3"}]}], "]"}]}], ";",
     "\[IndentingNewLine]", "  ", 
    RowBox[{"maxRho", "=", 
     RowBox[{"Max", "[", "rhoVals", "]"}]}], ";", "\[IndentingNewLine]", "  ", 
    RowBox[{"worstIdx", "=", 
     RowBox[{"First", "[", 
      RowBox[{"Ordering", "[", 
       RowBox[{"rhoVals", ",", 
        RowBox[{"-", "1"}]}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
    "  ", 
    RowBox[{"stable", "=", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"maxRho", "<", "1"}], ",", "\"\<YES\>\"", ",", "\"\<NO\>\""}], 
      "]"}]}], ";", "\[IndentingNewLine]", "  ", 
    RowBox[{"Print", "[", 
     RowBox[{"\"\<c=\>\"", ",", 
      RowBox[{"PaddedForm", "[", 
       RowBox[{"cVal", ",", 
        RowBox[{"{", 
         RowBox[{"3", ",", "1"}], "}"}]}], "]"}], ",", "\[IndentingNewLine]", 
      "    ", "\"\<  max_rho=\>\"", ",", 
      RowBox[{"N", "[", 
       RowBox[{"maxRho", ",", "5"}], "]"}], ",", "\[IndentingNewLine]", 
      "    ", "\"\<  worst=h_\>\"", ",", "worstIdx", ",", 
      "\[IndentingNewLine]", "    ", "\"\<  stable=\>\"", ",", "stable"}], 
     "]"}]}], ",", "\[IndentingNewLine]", "  ", 
   RowBox[{"{", 
    RowBox[{"cVal", ",", 
     RowBox[{"{", 
      RowBox[{
      "1", ",", "2", ",", "3", ",", "3.4", ",", "3.5", ",", "4", ",", "5", ",",
        "6", ",", "8", ",", "10"}], "}"}]}], "}"}]}], "\[IndentingNewLine]", 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"c", " ", "<", " ", "3"}], ":", " ", 
    RowBox[{
     RowBox[{"unstable", ".", " ", "c"}], " ", ">=", " ", "3.5"}], ":", " ", 
    RowBox[{"full", " ", "Newton", " ", 
     RowBox[{"rate", ".", " ", "No"}], " ", "degradation", " ", "for", " ", 
     "large", " ", 
     RowBox[{"c", "."}]}]}], " ", "*)"}]}]}], "Input",ExpressionUUID->\
"759d8c6d-b05f-4344-ab14-b28e78a3e214"],

Cell[TextData[{
 "4. Rosenbrock: c is insensitive for derived",
 StyleBox["newton",
  FontSlant->Italic],
 "diag"
}], "Section",ExpressionUUID->"853ca836-b74b-408b-8af3-7880a762f5f6"],

Cell["\<\
This is the key result. The Newton-targeted EMA optimizer shows NO \
c-sensitivity on Rosenbrock. \
\>", "Text",ExpressionUUID->"316bc2f9-fb4f-4c8f-a39a-394a6bcfaabd"],

Cell["Compiled simulation", "Subsection",ExpressionUUID->"4faabcfb-92d2-42fa-bad8-395b0e907551"],

Cell[BoxData[
 RowBox[{
  RowBox[{"simRC3", "=", 
   RowBox[{"Compile", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"c0", ",", "_Real"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"eta0", ",", "_Real"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"mom", ",", "_Real"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"nS", ",", "_Integer"}], "}"}]}], "}"}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"x", "=", 
          RowBox[{"-", "1.0"}]}], ",", 
         RowBox[{"y", "=", "1.0"}], ",", 
         RowBox[{"s1", "=", "0.0"}], ",", 
         RowBox[{"s2", "=", "0.0"}], ",", "\[IndentingNewLine]", "          ", 
         RowBox[{"m1", "=", "0.0"}], ",", 
         RowBox[{"m2", "=", "0.0"}], ",", "mc1", ",", "mc2", ",", 
         "\[IndentingNewLine]", "          ", "h11", ",", "h22", ",", "g1", ",",
          "g2", ",", "hG", ",", "sm", ",", "lo", ",", "hi", ",", 
         RowBox[{"loss", "=", "0.0"}], ",", 
         RowBox[{"t", "=", "0"}]}], "}"}], ",", "\[IndentingNewLine]", "    ", 
       RowBox[{
        RowBox[{"lo", "=", 
         RowBox[{"-", "c0"}]}], ";", " ", 
        RowBox[{"hi", "=", "c0"}], ";", "\[IndentingNewLine]", "    ", 
        RowBox[{"Do", "[", "\[IndentingNewLine]", "      ", 
         RowBox[{
          RowBox[{
           RowBox[{"t", " ", "+=", " ", "1"}], ";", "\[IndentingNewLine]", 
           "      ", 
           RowBox[{"loss", "=", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{"1.0", "-", "x"}], ")"}], "^", "2"}], "+", 
             RowBox[{"100.0", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"y", "-", 
                 RowBox[{"x", "^", "2"}]}], ")"}], "^", "2"}]}]}]}], ";", 
           "\[IndentingNewLine]", "      ", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"loss", ">", "1.*^20"}], ",", 
             RowBox[{"Break", "[", "]"}]}], "]"}], ";", "\[IndentingNewLine]",
            "      ", 
           RowBox[{"h11", "=", 
            RowBox[{"2.0", "+", 
             RowBox[{"800.0", " ", 
              RowBox[{"x", "^", "2"}]}], "-", 
             RowBox[{"400.0", " ", 
              RowBox[{"(", 
               RowBox[{"y", "-", 
                RowBox[{"x", "^", "2"}]}], ")"}]}]}]}], ";", 
           "\[IndentingNewLine]", "      ", 
           RowBox[{"h22", "=", "200.0"}], ";", "\[IndentingNewLine]", 
           "      ", 
           RowBox[{"h11", "=", 
            RowBox[{"Max", "[", 
             RowBox[{"h11", ",", "1.*^-6"}], "]"}]}], ";", " ", 
           RowBox[{"h22", "=", 
            RowBox[{"Max", "[", 
             RowBox[{"h22", ",", "1.*^-6"}], "]"}]}], ";", 
           "\[IndentingNewLine]", "      ", 
           RowBox[{"hG", "=", 
            RowBox[{"Sqrt", "[", 
             RowBox[{"h11", "*", "h22"}], "]"}]}], ";", "\[IndentingNewLine]",
            "      ", 
           RowBox[{"s1", "=", 
            RowBox[{
             RowBox[{"0.9", " ", "s1"}], "+", 
             RowBox[{"0.1", " ", 
              RowBox[{"Log", "[", 
               RowBox[{"hG", "/", "h11"}], "]"}]}]}]}], ";", 
           "\[IndentingNewLine]", "      ", 
           RowBox[{"s2", "=", 
            RowBox[{
             RowBox[{"0.9", " ", "s2"}], "+", 
             RowBox[{"0.1", " ", 
              RowBox[{"Log", "[", 
               RowBox[{"hG", "/", "h22"}], "]"}]}]}]}], ";", 
           "\[IndentingNewLine]", "      ", 
           RowBox[{"sm", "=", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"s1", "+", "s2"}], ")"}], "/", "2.0"}]}], ";", " ", 
           RowBox[{"s1", "=", 
            RowBox[{"s1", "-", "sm"}]}], ";", " ", 
           RowBox[{"s2", "=", 
            RowBox[{"s2", "-", "sm"}]}], ";", "\[IndentingNewLine]", "      ", 
           RowBox[{"s1", "=", 
            RowBox[{"Min", "[", 
             RowBox[{
              RowBox[{"Max", "[", 
               RowBox[{"s1", ",", "lo"}], "]"}], ",", "hi"}], "]"}]}], ";", 
           " ", 
           RowBox[{"s2", "=", 
            RowBox[{"Min", "[", 
             RowBox[{
              RowBox[{"Max", "[", 
               RowBox[{"s2", ",", "lo"}], "]"}], ",", "hi"}], "]"}]}], ";", 
           "\[IndentingNewLine]", "      ", 
           RowBox[{"g1", "=", 
            RowBox[{
             RowBox[{
              RowBox[{"-", "2.0"}], 
              RowBox[{"(", 
               RowBox[{"1.0", "-", "x"}], ")"}]}], "-", 
             RowBox[{"400.0", " ", "x", " ", 
              RowBox[{"(", 
               RowBox[{"y", "-", 
                RowBox[{"x", "^", "2"}]}], ")"}]}]}]}], ";", 
           "\[IndentingNewLine]", "      ", 
           RowBox[{"g2", "=", 
            RowBox[{"200.0", 
             RowBox[{"(", 
              RowBox[{"y", "-", 
               RowBox[{"x", "^", "2"}]}], ")"}]}]}], ";", 
           "\[IndentingNewLine]", "      ", 
           RowBox[{"m1", "=", 
            RowBox[{
             RowBox[{"mom", "*", "m1"}], "+", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"1.0", "-", "mom"}], ")"}], "*", "g1"}]}]}], ";", 
           "\[IndentingNewLine]", "      ", 
           RowBox[{"m2", "=", 
            RowBox[{
             RowBox[{"mom", "*", "m2"}], "+", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"1.0", "-", "mom"}], ")"}], "*", "g2"}]}]}], ";", 
           "\[IndentingNewLine]", "      ", 
           RowBox[{"mc1", "=", 
            RowBox[{"m1", "/", 
             RowBox[{"(", 
              RowBox[{"1.0", "-", 
               RowBox[{"mom", "^", "t"}]}], ")"}]}]}], ";", 
           "\[IndentingNewLine]", "      ", 
           RowBox[{"mc2", "=", 
            RowBox[{"m2", "/", 
             RowBox[{"(", 
              RowBox[{"1.0", "-", 
               RowBox[{"mom", "^", "t"}]}], ")"}]}]}], ";", 
           "\[IndentingNewLine]", "      ", 
           RowBox[{"x", "=", 
            RowBox[{"x", "-", 
             RowBox[{"eta0", "*", 
              RowBox[{"Exp", "[", "s1", "]"}], "*", "mc1"}]}]}], ";", 
           "\[IndentingNewLine]", "      ", 
           RowBox[{"y", "=", 
            RowBox[{"y", "-", 
             RowBox[{"eta0", "*", 
              RowBox[{"Exp", "[", "s2", "]"}], "*", "mc2"}]}]}], ";"}], 
          "\[IndentingNewLine]", "      ", ",", 
          RowBox[{"{", "nS", "}"}]}], "]"}], ";", "\[IndentingNewLine]", 
        "    ", "loss"}]}], "\[IndentingNewLine]", "  ", "]"}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]], "Input",ExpressionUUID->"cb75ec1c-\
3bd4-417d-83e5-1e74907e1260"],

Cell["Results with momentum", "Subsection",ExpressionUUID->"8f66a9ed-b890-4b7d-b72a-8258c0c0d6a3"],

Cell[BoxData[{
 RowBox[{"Print", 
  "[", "\"\<=== Rosenbrock, momentum=0.9, 5000 steps, start=(-1,1) ===\>\"", 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Do", "[", "\[IndentingNewLine]", "  ", 
   RowBox[{
    RowBox[{
     RowBox[{"Print", "[", 
      RowBox[{"\"\<\\neta = \>\"", ",", "eta0"}], "]"}], ";", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"Do", "[", "\[IndentingNewLine]", "    ", 
      RowBox[{
       RowBox[{
        RowBox[{"loss", "=", 
         RowBox[{"simRC3", "[", 
          RowBox[{"c0", ",", "eta0", ",", "0.9", ",", "5000"}], "]"}]}], ";", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<  c=\>\"", ",", 
          RowBox[{"PaddedForm", "[", 
           RowBox[{"c0", ",", 
            RowBox[{"{", 
             RowBox[{"3", ",", "1"}], "}"}]}], "]"}], ",", 
          "\[IndentingNewLine]", "      ", "\"\<  loss=\>\"", ",", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"loss", ">", "1.*^10"}], ",", "\"\<DIVERGED\>\"", ",", 
            RowBox[{"ScientificForm", "[", 
             RowBox[{"loss", ",", "3"}], "]"}]}], "]"}]}], "]"}]}], ",", 
       "\[IndentingNewLine]", "    ", 
       RowBox[{"{", 
        RowBox[{"c0", ",", 
         RowBox[{"{", 
          RowBox[{
          "0.5", ",", "1.0", ",", "2.0", ",", "4.0", ",", "6.0", ",", "10.0", 
           ",", "20.0"}], "}"}]}], "}"}]}], "]"}]}], ",", 
    "\[IndentingNewLine]", "  ", 
    RowBox[{"{", 
     RowBox[{"eta0", ",", 
      RowBox[{"{", 
       RowBox[{"0.0005", ",", "0.001", ",", "0.002", ",", "0.005"}], "}"}]}], 
     "}"}]}], "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"RESULT", ":", " ", 
    RowBox[{
    "c", " ", "has", " ", "negligible", " ", "effect", " ", "at", " ", 
     "every", " ", 
     RowBox[{"eta", "."}]}]}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Small", " ", "c", " ", "is", " ", "slightly", " ", "worse", " ", 
    RowBox[{
     RowBox[{"(", "bias", ")"}], ".", " ", "Large"}], " ", "c", " ", "never", 
    " ", 
    RowBox[{"hurts", "."}]}], " ", "*)"}]}]}], "Input",ExpressionUUID->\
"8dcd39bc-0dd7-4d6d-9cc3-4fd5a708e711"],

Cell["Results without momentum", "Subsection",ExpressionUUID->"b5a600c7-0f87-464b-8f9f-90fcefa871e3"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"simRC", "=", 
    RowBox[{"Compile", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"c0", ",", "_Real"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"eta0", ",", "_Real"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"nS", ",", "_Integer"}], "}"}]}], "}"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"x", "=", 
           RowBox[{"-", "1.0"}]}], ",", 
          RowBox[{"y", "=", "1.0"}], ",", 
          RowBox[{"s1", "=", "0.0"}], ",", 
          RowBox[{"s2", "=", "0.0"}], ",", "\[IndentingNewLine]", 
          "          ", "h11", ",", "h22", ",", "g1", ",", "g2", ",", "hG", ",",
           "sm", ",", "lo", ",", "hi", ",", 
          RowBox[{"loss", "=", "0.0"}]}], "}"}], ",", "\[IndentingNewLine]", 
        "    ", 
        RowBox[{
         RowBox[{"lo", "=", 
          RowBox[{"-", "c0"}]}], ";", " ", 
         RowBox[{"hi", "=", "c0"}], ";", "\[IndentingNewLine]", "    ", 
         RowBox[{"Do", "[", "\[IndentingNewLine]", "      ", 
          RowBox[{
           RowBox[{
            RowBox[{"loss", "=", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{"1.0", "-", "x"}], ")"}], "^", "2"}], "+", 
              RowBox[{"100.0", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"y", "-", 
                  RowBox[{"x", "^", "2"}]}], ")"}], "^", "2"}]}]}]}], ";", 
            "\[IndentingNewLine]", "      ", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"loss", ">", "1.*^20"}], ",", 
              RowBox[{"Break", "[", "]"}]}], "]"}], ";", 
            "\[IndentingNewLine]", "      ", 
            RowBox[{"h11", "=", 
             RowBox[{"2.0", "+", 
              RowBox[{"800.0", " ", 
               RowBox[{"x", "^", "2"}]}], "-", 
              RowBox[{"400.0", " ", 
               RowBox[{"(", 
                RowBox[{"y", "-", 
                 RowBox[{"x", "^", "2"}]}], ")"}]}]}]}], ";", 
            "\[IndentingNewLine]", "      ", 
            RowBox[{"h22", "=", "200.0"}], ";", "\[IndentingNewLine]", 
            "      ", 
            RowBox[{"h11", "=", 
             RowBox[{"Max", "[", 
              RowBox[{"h11", ",", "1.*^-6"}], "]"}]}], ";", " ", 
            RowBox[{"h22", "=", 
             RowBox[{"Max", "[", 
              RowBox[{"h22", ",", "1.*^-6"}], "]"}]}], ";", 
            "\[IndentingNewLine]", "      ", 
            RowBox[{"hG", "=", 
             RowBox[{"Sqrt", "[", 
              RowBox[{"h11", "*", "h22"}], "]"}]}], ";", 
            "\[IndentingNewLine]", "      ", 
            RowBox[{"s1", "=", 
             RowBox[{
              RowBox[{"0.9", " ", "s1"}], "+", 
              RowBox[{"0.1", " ", 
               RowBox[{"Log", "[", 
                RowBox[{"hG", "/", "h11"}], "]"}]}]}]}], ";", 
            "\[IndentingNewLine]", "      ", 
            RowBox[{"s2", "=", 
             RowBox[{
              RowBox[{"0.9", " ", "s2"}], "+", 
              RowBox[{"0.1", " ", 
               RowBox[{"Log", "[", 
                RowBox[{"hG", "/", "h22"}], "]"}]}]}]}], ";", 
            "\[IndentingNewLine]", "      ", 
            RowBox[{"sm", "=", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"s1", "+", "s2"}], ")"}], "/", "2.0"}]}], ";", " ", 
            RowBox[{"s1", "=", 
             RowBox[{"s1", "-", "sm"}]}], ";", " ", 
            RowBox[{"s2", "=", 
             RowBox[{"s2", "-", "sm"}]}], ";", "\[IndentingNewLine]", 
            "      ", 
            RowBox[{"s1", "=", 
             RowBox[{"Min", "[", 
              RowBox[{
               RowBox[{"Max", "[", 
                RowBox[{"s1", ",", "lo"}], "]"}], ",", "hi"}], "]"}]}], ";", 
            " ", 
            RowBox[{"s2", "=", 
             RowBox[{"Min", "[", 
              RowBox[{
               RowBox[{"Max", "[", 
                RowBox[{"s2", ",", "lo"}], "]"}], ",", "hi"}], "]"}]}], ";", 
            "\[IndentingNewLine]", "      ", 
            RowBox[{"g1", "=", 
             RowBox[{
              RowBox[{
               RowBox[{"-", "2.0"}], 
               RowBox[{"(", 
                RowBox[{"1.0", "-", "x"}], ")"}]}], "-", 
              RowBox[{"400.0", " ", "x", " ", 
               RowBox[{"(", 
                RowBox[{"y", "-", 
                 RowBox[{"x", "^", "2"}]}], ")"}]}]}]}], ";", 
            "\[IndentingNewLine]", "      ", 
            RowBox[{"g2", "=", 
             RowBox[{"200.0", 
              RowBox[{"(", 
               RowBox[{"y", "-", 
                RowBox[{"x", "^", "2"}]}], ")"}]}]}], ";", 
            "\[IndentingNewLine]", "      ", 
            RowBox[{"x", "=", 
             RowBox[{"x", "-", 
              RowBox[{"eta0", " ", 
               RowBox[{"Exp", "[", "s1", "]"}], " ", "g1"}]}]}], ";", 
            "\[IndentingNewLine]", "      ", 
            RowBox[{"y", "=", 
             RowBox[{"y", "-", 
              RowBox[{"eta0", " ", 
               RowBox[{"Exp", "[", "s2", "]"}], " ", "g2"}]}]}], ";"}], 
           "\[IndentingNewLine]", "      ", ",", 
           RowBox[{"{", "nS", "}"}]}], "]"}], ";", "\[IndentingNewLine]", 
         "    ", "loss"}]}], "\[IndentingNewLine]", "  ", "]"}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", "\"\<=== Rosenbrock, no momentum, 5000 steps ===\>\"", 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{"Do", "[", "\[IndentingNewLine]", "  ", 
  RowBox[{
   RowBox[{"Print", "[", 
    RowBox[{"\"\<c=\>\"", ",", "c0", ",", "\"\<  loss=\>\"", ",", 
     RowBox[{"ScientificForm", "[", 
      RowBox[{
       RowBox[{"simRC", "[", 
        RowBox[{"c0", ",", "0.001", ",", "5000"}], "]"}], ",", "3"}], "]"}]}],
     "]"}], ",", "\[IndentingNewLine]", "  ", 
   RowBox[{"{", 
    RowBox[{"c0", ",", 
     RowBox[{"{", 
      RowBox[{
      "0.5", ",", "1.0", ",", "2.0", ",", "4.0", ",", "6.0", ",", "10.0", ",",
        "20.0"}], "}"}]}], "}"}]}], "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Same", " ", 
    RowBox[{"result", ":", " ", 
     RowBox[{"c", " ", "insensitive"}]}]}], " ", "*)"}]}]}], "Input",Expressio\
nUUID->"638ce823-8252-4e4e-8251-0be45c07ee95"],

Cell["5. Rosenbrock Hessian structure (for reference)", "Section",ExpressionUUID->"5dcf3a78-7b8e-4675-a9a8-5382f287eeaf"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"x", ",", "y"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"fRosen", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "-", "x"}], ")"}], "^", "2"}], "+", 
    RowBox[{"100", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"y", "-", 
        RowBox[{"x", "^", "2"}]}], ")"}], "^", "2"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"hessRosen", "=", 
   RowBox[{"D", "[", 
    RowBox[{"fRosen", ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", "y"}], "}"}], ",", "2"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Hessian: \>\"", ",", 
    RowBox[{"hessRosen", " ", "//", " ", "MatrixForm"}]}], "]"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"points", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0.5", ",", "0.25"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0.8", ",", "0.64"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"1.0", ",", "1.0"}], "}"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Do", "[", "\[IndentingNewLine]", "  ", 
   RowBox[{
    RowBox[{
     RowBox[{"hess", "=", 
      RowBox[{"hessRosen", " ", "/.", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"x", "->", 
          RowBox[{"pt", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], ",", 
         RowBox[{"y", "->", 
          RowBox[{"pt", "[", 
           RowBox[{"[", "2", "]"}], "]"}]}]}], "}"}]}]}], ";", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"h11", "=", 
      RowBox[{"hess", "[", 
       RowBox[{"[", 
        RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ";", " ", 
     RowBox[{"h22", "=", 
      RowBox[{"hess", "[", 
       RowBox[{"[", 
        RowBox[{"2", ",", "2"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     "  ", 
     RowBox[{"hGeoLocal", "=", 
      RowBox[{"Sqrt", "[", 
       RowBox[{"h11", "*", "h22"}], "]"}]}], ";", "\[IndentingNewLine]", "  ", 
     RowBox[{"s1Star", "=", 
      RowBox[{"Log", "[", 
       RowBox[{"hGeoLocal", "/", "h11"}], "]"}]}], ";", "\[IndentingNewLine]",
      "  ", 
     RowBox[{"kappaDiag", "=", 
      RowBox[{
       RowBox[{"Max", "[", 
        RowBox[{"h11", ",", "h22"}], "]"}], "/", 
       RowBox[{"Min", "[", 
        RowBox[{"h11", ",", "h22"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     "  ", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Point \>\"", ",", "pt", ",", "\"\<:  H_diag={\>\"", ",", 
       RowBox[{"N", "[", "h11", "]"}], ",", "\"\<,\>\"", ",", 
       RowBox[{"N", "[", "h22", "]"}], ",", "\[IndentingNewLine]", 
       "    ", "\"\<}  s1*=\>\"", ",", 
       RowBox[{"N", "[", 
        RowBox[{"s1Star", ",", "3"}], "]"}], ",", "\"\<  kappa=\>\"", ",", 
       RowBox[{"N", "[", 
        RowBox[{"kappaDiag", ",", "4"}], "]"}]}], "]"}]}], ",", 
    "\[IndentingNewLine]", "  ", 
    RowBox[{"{", 
     RowBox[{"pt", ",", "points"}], "}"}]}], "\[IndentingNewLine]", "]"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "The", " ", "Newton", " ", "target", " ", "changes", " ", "sign", " ", 
     "along", " ", "the", " ", "valley"}], ","}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"but", " ", "the", " ", "EMA", " ", "tracks", " ", "this", " ", 
    RowBox[{"smoothly", ".", " ", "kappa_diag"}], " ", "is", " ", "modest", " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"<=", "100"}], ")"}], "."}]}], " ", "*)"}]}]}], "Input",Expressi\
onUUID->"dd52849b-ba64-4e21-a4f6-e231e27812cd"],

Cell["6. Quadratic with noisy Hutchinson", "Section",ExpressionUUID->"b2c99672-fd1c-417a-968d-fe72ef1f6fa2"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"nDim2", "=", "100"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"hTrue", "=", 
   RowBox[{
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"i", "-", "1"}], ")"}], "/", 
         RowBox[{"(", 
          RowBox[{"nDim2", "-", "1"}], ")"}]}], "*", 
        RowBox[{"Log", "[", "1000", "]"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "nDim2"}], "}"}]}], "]"}], " ", "//", " ", "N"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"betaS2", "=", "0.1"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"simulateWithNoise", "[", 
     RowBox[{"cVal_", ",", "noiseLevel_", ",", 
      RowBox[{"nSteps_", ":", " ", "1000"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"s", ",", "theta", ",", "hHat", ",", "sTarget", ",", 
        RowBox[{"lossHistory", "=", 
         RowBox[{"{", "}"}]}]}], "}"}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "42", "]"}], ";", "\[IndentingNewLine]", 
       "  ", 
       RowBox[{"s", "=", 
        RowBox[{"Table", "[", 
         RowBox[{"0.0", ",", 
          RowBox[{"{", "nDim2", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       "  ", 
       RowBox[{"theta", "=", 
        RowBox[{"Table", "[", 
         RowBox[{"1.0", ",", 
          RowBox[{"{", "nDim2", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       "  ", 
       RowBox[{"Do", "[", "\[IndentingNewLine]", "    ", 
        RowBox[{
         RowBox[{
          RowBox[{"hHat", "=", 
           RowBox[{"hTrue", "*", 
            RowBox[{"(", 
             RowBox[{"1", "+", 
              RowBox[{"noiseLevel", "*", 
               RowBox[{"RandomVariate", "[", 
                RowBox[{
                 RowBox[{"NormalDistribution", "[", "]"}], ",", "nDim2"}], 
                "]"}]}]}], ")"}]}]}], ";", "\[IndentingNewLine]", "    ", 
          RowBox[{"hHat", "=", 
           RowBox[{
            RowBox[{
             RowBox[{"Max", "[", 
              RowBox[{"#", ",", 
               RowBox[{"10", "^", 
                RowBox[{"-", "6"}]}]}], "]"}], " ", "&"}], " ", "/@", " ", 
            "hHat"}]}], ";", "\[IndentingNewLine]", "    ", 
          RowBox[{"sTarget", "=", 
           RowBox[{"-", 
            RowBox[{"Log", "[", "hHat", "]"}]}]}], ";", "\[IndentingNewLine]",
           "    ", 
          RowBox[{"s", "=", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"1", "-", "betaS2"}], ")"}], "*", "s"}], "+", 
            RowBox[{"betaS2", "*", "sTarget"}]}]}], ";", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"s", "=", 
           RowBox[{"s", "-", 
            RowBox[{"Mean", "[", "s", "]"}]}]}], ";", "\[IndentingNewLine]", 
          "    ", 
          RowBox[{"s", "=", 
           RowBox[{"Clip", "[", 
            RowBox[{"s", ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"-", "cVal"}], ",", "cVal"}], "}"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"theta", "=", 
           RowBox[{"theta", "-", 
            RowBox[{"0.05", "*", 
             RowBox[{"Exp", "[", "s", "]"}], "*", "hTrue", "*", "theta"}]}]}],
           ";", "\[IndentingNewLine]", "    ", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"lossHistory", ",", 
            RowBox[{"0.5", "*", 
             RowBox[{"Total", "[", 
              RowBox[{"hTrue", "*", 
               RowBox[{"theta", "^", "2"}]}], "]"}]}]}], "]"}], ";"}], ",", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"{", 
          RowBox[{"step", ",", "nSteps"}], "}"}]}], "]"}], ";", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<finalLoss\>\"", "->", 
          RowBox[{"Last", "[", "lossHistory", "]"}]}], ",", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"\"\<converged\>\"", "->", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"Last", "[", "lossHistory", "]"}], "<", 
            RowBox[{"10", "^", 
             RowBox[{"-", "5"}]}]}], ")"}]}]}], "|>"}]}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", "\"\<N=100, kappa=1000, 50% noise, 1000 steps\>\"", 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{"Do", "[", "\[IndentingNewLine]", "  ", 
  RowBox[{
   RowBox[{
    RowBox[{"result", "=", 
     RowBox[{"simulateWithNoise", "[", 
      RowBox[{"cVal", ",", "0.5"}], "]"}]}], ";", "\[IndentingNewLine]", "  ", 
    RowBox[{"Print", "[", 
     RowBox[{"\"\<c=\>\"", ",", "cVal", ",", "\[IndentingNewLine]", 
      "    ", "\"\<  converged=\>\"", ",", 
      RowBox[{"result", "[", "\"\<converged\>\"", "]"}]}], "]"}]}], ",", 
   "\[IndentingNewLine]", "  ", 
   RowBox[{"{", 
    RowBox[{"cVal", ",", 
     RowBox[{"{", 
      RowBox[{
      "2", ",", "3", ",", "3.5", ",", "4", ",", "5", ",", "6", ",", "8", ",", 
       "10"}], "}"}]}], "}"}]}], "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"c", " ", "<", " ", "3.5"}], ":", " ", 
    RowBox[{
     RowBox[{"diverges", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"clip", " ", "truncates", " ", "Newton", " ", "target"}], 
        ")"}], ".", " ", "c"}]}], " ", ">=", " ", "4"}], ":", " ", 
    RowBox[{"all", " ", "converge", " ", 
     RowBox[{"identically", "."}]}]}], " ", "*)"}]}]}], "Input",ExpressionUUID\
->"474e66cb-ed32-41e8-bb1d-153a71ca2e29"],

Cell["7. Summary", "Section",ExpressionUUID->"9898084a-ac08-460e-af3a-c56fdf5601b0"],

Cell[TextData[{
 "For ",
 Cell[BoxData[Cell["derived_newton_diag",
   Background->None,ExpressionUUID->"ce83ded5-183e-4838-a99c-3e7d653d5c4e"]], 
  "InlineCode",ExpressionUUID->"9f23e497-2725-40da-a7cb-a75d007f0f79"],
 ": "
}], "Text",ExpressionUUID->"3d3ac3f7-101b-4001-85e1-2f7b6ba8aa0e"],

Cell[TextData[{
 StyleBox["Lower bound:",
  FontWeight->Bold],
 " ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       FractionBox[
        RowBox[{
          StyleBox["c", "TI"], "\[GreaterEqual]", "1"}], 
        RowBox[{"2", "log", "\[Kappa]"}]], TraditionalForm], "errors" -> {}, 
     "input" -> "c \\ge \\tfrac{1}{2}\\log\\kappa", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "aca46d94-9809-456a-9554-ef976b535f30"],
 " (balanced), tight."
}], "Item",ExpressionUUID->"b8994481-05db-4080-9a38-46c2d75b7860"],

Cell[TextData[{
 StyleBox["Upper bound:",
  FontWeight->Bold],
 " NONE. Larger ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["c", "TI"], TraditionalForm], "errors" -> {}, "input" -> "c", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "98641271-cc50-4ccc-a8fd-e6635c118eb8"],
 " is always at least as good."
}], "Item",ExpressionUUID->"2fddcbb1-c5b3-4511-8b9b-d4804a754979"],

Cell[TextData[{
 StyleBox["c=4 default:",
  FontWeight->Bold],
 " covers ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Kappa]", "\[LessEqual]", "2981"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\kappa \\le 2981", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "2664e94a-69d4-46c9-a67f-274d90fc42d0"],
 ". Increase for ill-conditioned problems."
}], "Item",ExpressionUUID->"135f8a6f-bbee-4d2c-97b3-8ef36ad9f3af"],

Cell[TextData[{
 StyleBox["Adaptive rule:",
  FontWeight->Bold],
 " not needed and has a circular dependency."
}], "Item",ExpressionUUID->"99625f51-bc53-4f24-a4e6-a7df70c81598"],

Cell["The clip is a pure safety net, not a tuning knob.", "Item",ExpressionUUID->"f47c9c03-d13e-4cd0-ad37-f4fa97540664"],

Cell[TextData[{
 "The c-sensitivity reported in IMO-125 was from the learnable metric \
optimizer, not ",
 Cell[BoxData[Cell["derived_newton_diag",
   Background->None,ExpressionUUID->"c9f0e6bb-bec6-4f36-91be-3b7d3c18eb54"]], 
  "InlineCode",ExpressionUUID->"00581245-c8ab-4970-aa39-dc4a7aab0478"],
 "."
}], "Text",ExpressionUUID->"b56c41e6-db7a-4514-8a7f-fa96734698d0"]
},
