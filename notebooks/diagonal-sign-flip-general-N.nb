Notebook[{
Cell["Diagonal Sign-Flipping for General N", "Title",ExpressionUUID->"0a930a20-1d97-4db4-82a8-c2a860c6c15d"],

Cell[TextData[{
 StyleBox["IMO-43",
  FontWeight->Bold],
 " \[LongDash] Induced Metric Optimiser Project ",
 StyleBox["Authors:",
  FontWeight->Bold],
 " Noah Everett, Matt Schwartz, Thomas Harvey ",
 StyleBox["Date:",
  FontWeight->Bold],
 " 2026-04-05"
}], "Text",ExpressionUUID->"8c5162f4-0277-4bdf-bba0-e944d31bcf5b"],

Cell[TextData[{
 "This notebook proves that the diagonal learnable metric ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Gamma]", "\[LongEqual]", "diag", 
         RowBox[{"(", 
           RowBox[{
             SuperscriptBox[
              StyleBox["e", "TI"], 
              SubscriptBox[
               StyleBox["s", "TI"], "1"]], ",", "\[Ellipsis]", ",", 
             SuperscriptBox[
              StyleBox["e", "TI"], 
              SubscriptBox[
               StyleBox["s", "TI"], 
               StyleBox["N", "TI"]]]}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\gamma = \\text{diag}(e^{s_1}, \\ldots, e^{s_N})", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e64b94ca-d502-4a58-9fbc-6f70ead94949"],
 " can achieve eigenvalue sign-flipping for ",
 StyleBox["arbitrary",
  FontWeight->Bold],
 " symmetric Hessian ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["H", "TI"], TraditionalForm], "errors" -> {}, "input" -> "H", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "bf1ccb03-c64e-461d-93a1-947f61f2654d"],
 " in ",
 StyleBox["arbitrary",
  FontWeight->Bold],
 " dimension ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["N", "TI"], TraditionalForm], "errors" -> {}, "input" -> "N", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b4b43e07-9a76-4996-b325-925679ff45ac"],
 ", provided the gradient ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[ScriptL]\[NotEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\ell \\neq 0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "8f5f38e7-ee6a-471a-8547-206d6f2f5901"],
 ". It also derives the sign-flip budget ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["R", "TI"], "(", 
         StyleBox["N", "TI"], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "R(N)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ed73bd18-efb2-470c-93f0-d2df92f6f742"],
 " and assesses practical feasibility.",
 StyleBox["Depends on:",
  FontWeight->Bold],
 " ",
 Cell[BoxData[Cell["learnable-metric-christoffel.nb",
   Background->None,ExpressionUUID->"730f6121-54b3-4f13-92fb-efda023675f8"]], 
  "InlineCode",ExpressionUUID->"8fa85814-6981-4574-878a-9d2c95adc480"],
 " (N=2 results) "
}], "Text",ExpressionUUID->"46c9aa20-48a3-4ca3-9699-43c8c5b1b658"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
