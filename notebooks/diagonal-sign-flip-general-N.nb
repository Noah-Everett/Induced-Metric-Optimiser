                 \:2551\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<\:2551                                                   \
                  \:2551\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<\:2551  Ratio (DoF/constraints): 2  (for all N \
\[GreaterEqual] 1)                       \:2551\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<\:2551                                                   \
                  \:2551\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<\:2551  Compare SCALAR case: only N DoF for N(N+1)/2 \
constraints          \:2551\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<\:2551  Scalar ratio: 2N/(N(N+1)) = 2/(N+1) \
\[RightArrow] 0 as N \[RightArrow] \[Infinity]                \:2551\>\"", 
   "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<\:2551                                                   \
                  \:2551\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
   "Print", "[", "\"\<\:255a\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\
\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\
\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\
\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\
\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\
\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:255d\>\"", 
    "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"nn", ",", 
       RowBox[{"nn", " ", 
        RowBox[{"(", 
         RowBox[{"nn", "+", "1"}], ")"}]}], ",", 
       RowBox[{"nn", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"nn", "+", "1"}], ")"}], "/", "2"}]}], ",", "2.0", ",", 
       "nn", ",", 
       RowBox[{"nn", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"nn", "+", "1"}], ")"}], "/", "2"}]}], ",", 
       RowBox[{"2.0", " ", 
        RowBox[{"nn", "/", 
         RowBox[{"(", 
          RowBox[{"nn", " ", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"nn", "+", "1"}], ")"}], "/", "2"}]}], ")"}]}]}]}], 
      "}"}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"{", 
      RowBox[{"nn", ",", 
       RowBox[{"{", 
        RowBox[{
        "2", ",", "3", ",", "5", ",", "10", ",", "50", ",", "100", ",", 
         "1000"}], "}"}]}], "}"}]}], "]"}], " ", "//", "\[IndentingNewLine]", 
   "  ", 
   RowBox[{"Prepend", "[", 
    RowBox[{"{", 
     RowBox[{"\"\<N\>\"", ",", "\"\<Diag DoF\>\"", ",", "\"\<Constraints\>\"",
       ",", "\"\<Diag ratio\>\"", ",", "\"\<Scalar DoF\>\"", 
      ",", "\"\<Constraints\>\"", ",", "\"\<Scalar ratio\>\""}], "}"}], 
    "]"}]}], " ", "//", "\[IndentingNewLine]", "  ", "TableForm"}]}], "Input",\
ExpressionUUID->"4ab2339e-51ce-4f5c-bdf3-795bbb6df063"],

