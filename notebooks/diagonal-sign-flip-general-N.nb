Cell["8. Complete Hierarchy for General N", "Section",ExpressionUUID->"8037ab95-a70e-4fcb-b6d9-47a7877857be"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<\:2554\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\
\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\
\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\
\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\
\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\
\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\
\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\
\:2557\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<\:2551                                                   \
                                   \:2551\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<\:2551  COMPLETE HIERARCHY OF METRIC VARIANTS (GENERAL \
N):                                   \:2551\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<\:2551                                                   \
                                   \:2551\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<\:2551  CONSTANT \[Gamma]:                               \
                                          \:2551\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<\:2551    C = 0. Hess_g L = H/\[Alpha]. Eigenvalue signs \
PRESERVED.                                \:2551\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<\:2551    Proved for all N. (N=2 result generalises \
trivially.)                              \:2551\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<\:2551                                                   \
                                   \:2551\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<\:2551  SCALAR LEARNABLE \[Gamma] = e^s I:               \
                                          \:2551\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<\:2551    C has rank \[LessEqual] 3, with only N degrees \
of freedom.                                    \:2551\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<\:2551    N=2: sign-flip \[DoubleLongLeftRightArrow] \
Tr(H) > 0. (Previously proved.)                                \:2551\>\"", 
   "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<\:2551    N>2: can flip O(1) negative eigenvalues via \
low-rank + shift correction.           \:2551\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<\:2551    CANNOT flip all negative eigenvalues when \
their count exceeds ~3.                  \:2551\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<\:2551                                                   \
                                   \:2551\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<\:2551  DIAGONAL LEARNABLE \[Gamma] = \
diag(e^{s\:2081},...,e^{s\:2099}):                                     \:2551\
\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<\:2551    C has N\.b2+N degrees of freedom (2\[Times] \
the constraints).                               \:2551\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<\:2551    CAN ALWAYS achieve sign-flipping for ANY H, \
ANY N, whenever \[ScriptL] \[NotEqual] 0.                \:2551\>\"", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<\:2551    *** PROVED IN THIS NOTEBOOK (Theorem, Section \
3.1) ***                             \:2551\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<\:2551    Budget: R = O(\[Sqrt]N \[CenterDot] \
|\[Lambda]_neg|/|\[ScriptL]|) per negative eigenvalue in diagonal basis.      \
  \:2551\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<\:2551    Practically reachable for neural nets due to \
block-diagonal Hessian structure.     \:2551\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<\:2551                                                   \
                                   \:2551\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<\:2551  STRICT CONTAINMENT: Constant \[Subset] Scalar \
\[Subset] Diagonal (for all N \[GreaterEqual] 2)                   \:2551\>\"",
    "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<\:2551                                                   \
                                   \:2551\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<\:255a\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\
\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\
\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\
\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\
\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\
\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\
\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\
\:255d\>\"", "]"}], ";"}]}], "Input",ExpressionUUID->"9778c7e2-be80-4849-8a48-\
8bed3180b3e0"],

