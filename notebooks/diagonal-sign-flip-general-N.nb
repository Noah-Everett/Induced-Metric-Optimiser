Cell["7. Scalar Learnable Limitations for General N", "Section",ExpressionUUID->"428ac6c3-ff49-4c21-93c6-ae9788157c93"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<\:2554\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\
\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\
\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\
\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\
\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\
\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\
\:2550\:2550\:2550\:2550\:2550\:2557\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<\:2551  SCALAR CASE \[Gamma] = e^s I FOR GENERAL N:      \
                                 \:2551\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<\:2551                                                   \
                           \:2551\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<\:2551  C = (1/2)(\[Del]s\[CircleTimes]\[ScriptL] + \
\[ScriptL]\[CircleTimes]\[Del]s) \[Minus] \
(1/2)(\[Del]s\[CenterDot]\[ScriptL])I                                   \
\:2551\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<\:2551                                                   \
                           \:2551\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<\:2551  Tr(C) = (2\[Minus]N)/2 \[CenterDot] (\[Del]s\
\[CenterDot]\[ScriptL])                                                  \
\:2551\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<\:2551                                                   \
                           \:2551\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<\:2551  \[Bullet] N=2: Tr(C)=0. Sign-flip \
\[DoubleLongLeftRightArrow] Tr(H)>0. (Previously proved.)                \
\:2551\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<\:2551                                                   \
                           \:2551\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<\:2551  \[Bullet] N>2: Tr(C)\[NotEqual]0, controllable. \
No trace barrier!                            \:2551\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<\:2551    But C has rank \[LessEqual] 3 (rank-2 outer \
product + scalar\[CenterDot]I).                     \:2551\>\"", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<\:2551    The scalar has only N DoF for N(N+1)/2 \
constraints.                       \:2551\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<\:2551    For N\[GreaterGreater]1, the scalar CANNOT \
independently correct each                     \:2551\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<\:2551    negative eigenvalue \[LongDash] it can only do \
a low-rank perturbation.             \:2551\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<\:2551                                                   \
                           \:2551\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<\:2551  The diagonal metric's advantage grows with N:    \
                           \:2551\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<\:2551  N\.b2+N DoF vs N DoF \[LongDash] the gap is \
quadratic.                                  \:2551\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<\:2551                                                   \
                           \:2551\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
   "Print", "[", "\"\<\:255a\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\
\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\
\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\
\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\
\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\
\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\
\:2550\:2550\:2550\:2550\:2550\:255d\>\"", "]"}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Demonstrate", ":", " ", 
      RowBox[{"for", " ", "N"}]}], "=", "5"}], ",", " ", 
    RowBox[{
    "scalar", " ", "cannot", " ", "fix", " ", "a", " ", "Hessian", " ", 
     "that", " ", "diagonal", " ", "can"}]}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Clear", "[", "\"\<Global`*\>\"", "]"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"H", " ", "with", " ", "4", " ", "negative", " ", "eigenvalues"}],
     " ", "\[LongDash]", " ", 
    RowBox[{
    "scalar", " ", "has", " ", "only", " ", "5", " ", "DoF", " ", "to", " ", 
     "fix", " ", "15", " ", "constraints"}]}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"h5scalar", "=", 
   RowBox[{"DiagonalMatrix", "[", 
    RowBox[{"{", 
     RowBox[{"1.", ",", 
      RowBox[{"-", "1."}], ",", 
      RowBox[{"-", "1."}], ",", 
      RowBox[{"-", "1."}], ",", 
      RowBox[{"-", "1."}]}], "}"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ell5scalar", "=", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1.", ",", "1.", ",", "1.", ",", "1.", ",", "1."}], "}"}], "/", 
     
     RowBox[{"Sqrt", "[", "5.", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Scalar", " ", 
     RowBox[{"correction", ":", " ", "C"}]}], " ", "=", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "/", "2"}], ")"}], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"\[Del]", "s"}], "\[CircleTimes]", "\[ScriptL]"}], " ", "+", 
        " ", 
        RowBox[{"\[ScriptL]", "\[CircleTimes]", 
         RowBox[{"\[Del]", "s"}]}]}], ")"}]}], " ", "-", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "/", "2"}], ")"}], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"\[Del]", "s"}], "\[CenterDot]", "\[ScriptL]"}], ")"}], 
      "I"}]}]}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"scalarMinEig", "[", 
     RowBox[{"gradS_List", ",", "hh_", ",", "ll_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"cc", ",", "hmc"}], "}"}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"cc", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", "/", "2"}], ")"}], "*", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"Outer", "[", 
             RowBox[{"Times", ",", "gradS", ",", "ll"}], "]"}], "+", 
            RowBox[{"Outer", "[", 
             RowBox[{"Times", ",", "ll", ",", "gradS"}], "]"}]}], ")"}]}], "-", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", "/", "2"}], ")"}], "*", 
          RowBox[{"(", 
           RowBox[{"gradS", " ", ".", " ", "ll"}], ")"}], "*", 
          RowBox[{"IdentityMatrix", "[", 
           RowBox[{"Length", "[", "hh", "]"}], "]"}]}]}]}], ";", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"hmc", "=", 
        RowBox[{"hh", "-", "cc"}]}], ";", "\[IndentingNewLine]", "  ", 
       RowBox[{"Min", "[", 
        RowBox[{"Eigenvalues", "[", "hmc", "]"}], "]"}]}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"Optimize", " ", "over", " ", 
    RowBox[{"\[Del]", "s"}], " ", "to", " ", "maximize", " ", "min", " ", 
    "eigenvalue"}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"vars5s", "=", 
   RowBox[{"Array", "[", 
    RowBox[{"gs", ",", "5"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"result5s", "=", 
    RowBox[{"NMaximize", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"scalarMinEig", "[", 
         RowBox[{"vars5s", ",", "h5scalar", ",", "ell5scalar"}], "]"}], ",", 
        "True"}], "}"}], ",", "vars5s", ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"Method", "->", "\"\<NelderMead\>\""}], ",", 
      RowBox[{"MaxIterations", "->", "10000"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<=== SCALAR vs DIAGONAL: N=5 example ===\>\"", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<H = diag(1, -1, -1, -1, -1), \[ScriptL] = (1,1,1,1,1)/\
\[Sqrt]5\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<SCALAR: max(min eigenvalue of H-C) = \>\"", ",", 
    RowBox[{"result5s", "[", 
     RowBox[{"[", "1", "]"}], "]"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<  \>\"", ",", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"result5s", "[", 
        RowBox[{"[", "1", "]"}], "]"}], ">", "0"}], 
      ",", "\"\<CAN achieve positive definiteness\>\"", 
      ",", "\"\<CANNOT achieve positive definiteness\>\""}], "]"}]}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"Diagonal", ":", " ", 
    RowBox[{"use", " ", "Gershgorin", " ", "construction", " ", 
     RowBox[{"(", 
      RowBox[{"trivial", " ", "since", " ", "H", " ", "is", " ", "diagonal"}],
       ")"}]}]}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rDiag5", "=", 
   RowBox[{"gershgorinConstruct", "[", 
    RowBox[{"h5scalar", ",", "ell5scalar"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<DIAGONAL: eigenvalues of H-C = \>\"", ",", 
    RowBox[{"rDiag5", "[", "\"\<eigenvalues\>\"", "]"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<  Positive definite: \>\"", ",", 
    RowBox[{"rDiag5", "[", "\"\<posdef\>\"", "]"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<  Budget: \>\"", ",", 
    RowBox[{"rDiag5", "[", "\"\<budget\>\"", "]"}]}], "]"}], ";"}]}], "Input",\
ExpressionUUID->"25a891fa-1479-4515-87ce-f7a5cda387fe"],

