                  \:2551\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<\:2551    \[Bullet] N values s\:2081,...,s\:2099 \
(exponential ratios)                       \:2551\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
