Cell["\<\
5. The Key Insight: Diagonal Construction Needs Only O(1) Per Direction\
\>", "Section",ExpressionUUID->"314731dc-29be-430b-815e-8bda8bcbffc6"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<\:2554\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\
\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\
\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\
\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\
\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\
\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\
\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2557\>\"", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<\:2551  THE TWO REGIMES:                                 \
                              \:2551\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<\:2551                                                   \
                               \:2551\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<\:2551  1. H DIAGONAL in coordinate basis (or close to \
it):                             \:2551\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<\:2551     R = 2\[Sqrt](\[CapitalSigma]_{i:\[Lambda]\
\:1d62<0} \[Lambda]\:1d62\.b2/\[ScriptL]\:1d62\.b2) \[LongDash] depends on \
spectrum, NOT on N directly.      \:2551\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<\:2551     Each negative eigenvalue costs |\[PartialD]\
\:1d62s\:1d62| = 2|\[Lambda]\:1d62|/|\[ScriptL]\:1d62|.                       \
 \:2551\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<\:2551     Budget per direction: O(|\[Lambda]|/|\
\[ScriptL]|) \[LongDash] independent of N.                        \:2551\>\"",
    "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<\:2551                                                   \
                               \:2551\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<\:2551  2. H DENSE (rotated eigenbasis \[NotEqual] \
coordinate basis):                             \:2551\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<\:2551     Gershgorin construction gives R ~ O(N^{3/2}) \
for GOE Hessians.               \:2551\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<\:2551     But this is a LOOSE upper bound using only \
diagonal corrections.              \:2551\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<\:2551     The optimal construction (using off-diagonal \
corrections too) can be          \:2551\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<\:2551     MUCH cheaper.                                 \
                               \:2551\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<\:2551                                                   \
                               \:2551\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<\:2551  NEURAL NET HESSIANS are approximately \
block-diagonal due to layer structure,     \:2551\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<\:2551  so they are closer to regime 1. The effective N \
is the BLOCK SIZE,               \:2551\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<\:2551  not the total parameter count.                   \
                                \:2551\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<\:2551                                                   \
                               \:2551\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<\:255a\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\
\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\
\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\
\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\
\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\
\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\
\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:255d\>\"", "]"}], 
  ";"}]}], "Input",ExpressionUUID->"7fe9bd9f-4916-408c-9e48-041b22f15068"],

Cell["5.1 Per-Direction Budget", "Subsection",ExpressionUUID->"6b0466f2-cbeb-4f5c-bd32-21a1d8908e67"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"Analyse", " ", "the", " ", "per"}], "-", 
      RowBox[{"direction", " ", "cost"}]}], " ", "||", 
     RowBox[{
      RowBox[{"\[PartialD]", "_i"}], " ", "s_i"}], "||"}], " ", "=", " ", 
    RowBox[{"2", "|", "\[Lambda]_i", "|", 
     RowBox[{"/", 
      RowBox[{"|", "\[ScriptL]_i", "|"}]}]}]}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Clear", "[", "\"\<Global`*\>\"", "]"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<=== PER-DIRECTION BUDGET ANALYSIS ===\>\"", "]"}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<For diagonal H at a saddle point:\>\"", "]"}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<  Cost to flip eigenvalue \[Lambda]_i < 0: \
|\[PartialD]\:1d62s\:1d62| = 2|\[Lambda]\:1d62|/|\[ScriptL]\:1d62|\>\"", 
     "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"Neural", " ", "net", " ", "scaling", " ", "assumptions"}], " ", 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"Eigenvalues", ":", " ", 
     RowBox[{"|", "\[Lambda]", "|", " ", 
      RowBox[{
       RowBox[{"~", " ", "O"}], 
       RowBox[{"(", "1", ")"}], " ", 
       RowBox[{"(", 
        RowBox[{"bounded", " ", "spectral", " ", "radius"}], ")"}]}]}]}], " ",
     "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"Gradient", " ", 
     RowBox[{"components", ":", " ", 
      RowBox[{"|", "\[ScriptL]_i", "|", " ", 
       RowBox[{"~", " ", 
        RowBox[{"||", "\[ScriptL]", "||", 
         RowBox[{
          RowBox[{"/", 
           RowBox[{"\[Sqrt]", "N"}]}], " ", 
          RowBox[{"(", "isotropic", ")"}]}]}]}]}]}]}], " ", "*)"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Under neural net assumptions (|\[Lambda]| ~ O(1), |\
\[ScriptL]\:1d62| ~ ||\[ScriptL]||/\[Sqrt]N):\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<  Per-direction cost: |\[PartialD]\:1d62s\:1d62| ~ 2|\
\[Lambda]|\[Sqrt]N/||\[ScriptL]||\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<  Total budget for k negative eigenvalues:\>\"", "]"}],
     ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<  R ~ 2\[Sqrt]k \[CenterDot] |\[Lambda]| \[CenterDot] \
\[Sqrt]N / ||\[ScriptL]||\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<But the ONLINE LEARNING RULE accumulates per \
direction:\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<  \[CapitalDelta]s\:1d62/step ~ \[Mu] \[Xi] \
e^{s\:1d62} \[ScriptL]\:1d62\.b2 ~ \[Mu] \[Xi] ||\[ScriptL]||\.b2/N per \
step\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<  After T steps: |s\:1d62| ~ T \[Mu] \[Xi] \
||\[ScriptL]||\.b2/N\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<  Effective gradient: |\[PartialD]\:1d62s\:1d62| ~ |s\
\:1d62|/\[Delta] where \[Delta] is the correlation length\>\"", "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"Concrete", " ", "numbers"}], " ", "*)"}], "\[IndentingNewLine]", 
   
   RowBox[{
    RowBox[{"Print", "[", "\"\<=== CONCRETE ESTIMATES ===\>\"", "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Table", "[", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"absLam", "=", "1."}], ",", 
           RowBox[{"normEll", "=", "1."}], ",", "perDir", ",", "totalK"}], 
          "}"}], ",", "\[IndentingNewLine]", "    ", 
         RowBox[{
          RowBox[{"perDir", "=", 
           RowBox[{"2", "*", "absLam", "*", 
            RowBox[{
             RowBox[{"Sqrt", "[", "nn", "]"}], "/", "normEll"}]}]}], ";", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"totalK", "=", 
           RowBox[{"2", "*", 
            RowBox[{"Sqrt", "[", 
             RowBox[{"nn", "/", "2"}], "]"}], "*", "absLam", "*", 
            RowBox[{
             RowBox[{"Sqrt", "[", "nn", "]"}], "/", "normEll"}]}]}], ";", 
          "  ", 
          RowBox[{"(*", " ", 
           RowBox[{"k", " ", "=", " ", 
            RowBox[{
             RowBox[{"N", "/", "2"}], " ", "negative", " ", "eigenvalues"}]}],
            " ", "*)"}], "\[IndentingNewLine]", "    ", 
          RowBox[{"{", 
           RowBox[{"nn", ",", 
            RowBox[{"Round", "[", 
             RowBox[{"perDir", ",", "0.1"}], "]"}], ",", 
            RowBox[{"Round", "[", 
             RowBox[{"totalK", ",", "0.1"}], "]"}]}], "}"}]}]}], 
        "\[IndentingNewLine]", "  ", "]"}], ",", "\[IndentingNewLine]", "  ", 
       
       RowBox[{"{", 
        RowBox[{"nn", ",", 
         RowBox[{"{", 
          RowBox[{
          "10", ",", "100", ",", "1000", ",", "10000", ",", "100000", ",", 
           "1000000"}], "}"}]}], "}"}]}], "\[IndentingNewLine]", "]"}], " ", "//",
      " ", 
     RowBox[{"Prepend", "[", 
      RowBox[{"{", 
       RowBox[{"\"\<N\>\"", ",", "\"\<|\[PartialD]\:1d62s\:1d62| needed\>\"", 
        ",", "\"\<R(N) (worst-case k=N/2)\>\""}], "}"}], "]"}]}], " ", "//", 
    " ", "TableForm"}]}]}]], "Input",ExpressionUUID->"4530c43a-82ef-4feb-b2c5-\
4eee9db081ff"],

