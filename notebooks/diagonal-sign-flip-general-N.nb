Cell["4.2 Optimal Budget via Constrained Optimization", "Subsection",ExpressionUUID->"cb97d6cf-8b6c-4f71-94fe-000c92d8c0c1"],

Cell[TextData[{
 "The Gershgorin construction is an upper bound. The true minimum budget \
minimises ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
        "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", "\[Sigma]", 
         SubscriptBox["\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", 
          StyleBox["F", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "|\\sigma|_F", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c365e9b0-533c-4328-addf-578808f2f326"],
 " subject to ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["H", "TI"], "-", 
         StyleBox["C", "TI"], "\[Succeeds]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "H - C \\succ 0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "1f5f9411-ed37-4def-822d-17beae0e6a4e"],
 ". Since ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["C", "TI"], TraditionalForm], "errors" -> {}, "input" -> "C", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "99847c0b-5038-4b85-abcb-8887f0f96248"],
 " is linear in the gradient components (at fixed $s_i$), this is a \
semidefinite program. "
}], "Text",ExpressionUUID->"4ea8c045-eb0a-4334-babe-ba0f45483eed"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"For", " ", "small", " ", "N"}], ",", " ", 
    RowBox[{
    "find", " ", "the", " ", "minimum", " ", "budget", " ", "numerically"}]}],
    " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Clear", "[", "\"\<Global`*\>\"", "]"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"Minimum", "-", 
     RowBox[{"budget", " ", "sign"}], "-", 
     RowBox[{"flip", " ", "for", " ", "diagonal", " ", "metric"}]}], " ", 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"Fix", " ", "s_i"}], " ", "=", " ", 
     RowBox[{
     "0", " ", "so", " ", "C", " ", "is", " ", "linear", " ", "in", " ", 
      "gradient", " ", "components"}]}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"minBudgetSignFlip", "[", 
      RowBox[{"hMat_", ",", "ellVec_", ",", 
       RowBox[{"margin_", ":", " ", "0.01"}]}], "]"}], ":=", 
     RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "n", ",", "vars", ",", "gradS", ",", "corrMat", ",", "hmcMat", ",", 
         "objective", ",", "constraints", ",", "result", ",", "i", ",", "j", ",",
          "k"}], "}"}], ",", "\[IndentingNewLine]", "  ", 
       RowBox[{
        RowBox[{"n", "=", 
         RowBox[{"Length", "[", "hMat", "]"}]}], ";", "\[IndentingNewLine]", 
        "  ", "\[IndentingNewLine]", "  ", 
        RowBox[{"(*", " ", 
         RowBox[{
          RowBox[{"Decision", " ", 
           RowBox[{"variables", ":", " ", 
            RowBox[{"gradS", "[", 
             RowBox[{"[", 
              RowBox[{"i", ",", "j"}], "]"}], "]"}]}]}], " ", "=", " ", 
          RowBox[{
           RowBox[{"\[PartialD]", "_j"}], " ", "s_i"}]}], " ", "*)"}], 
        "\[IndentingNewLine]", "  ", 
        RowBox[{"vars", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"Symbol", "[", 
            RowBox[{"\"\<g\>\"", " ", "<>", " ", 
             RowBox[{"ToString", "[", "i", "]"}], " ", "<>", " ", "\"\<d\>\"",
              " ", "<>", " ", 
             RowBox[{"ToString", "[", "j", "]"}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "n"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"j", ",", "n"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", "  ", "\[IndentingNewLine]", "  ", 
        RowBox[{"(*", " ", 
         RowBox[{"Build", " ", "correction", " ", "matrix", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"s_i", " ", "=", " ", "0"}], ",", " ", 
            RowBox[{
             RowBox[{"so", " ", 
              RowBox[{"e", "^", 
               RowBox[{"{", 
                RowBox[{"s_i", "-", "s_k"}], "}"}]}]}], " ", "=", " ", 
             "1"}]}], ")"}]}], " ", "*)"}], "\[IndentingNewLine]", "  ", 
        RowBox[{"corrMat", "=", 
         RowBox[{"ConstantArray", "[", 
          RowBox[{"0", ",", 
           RowBox[{"{", 
            RowBox[{"n", ",", "n"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", "  ", 
        RowBox[{"Do", "[", "\[IndentingNewLine]", "    ", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"corrMat", "[", 
             RowBox[{"[", 
              RowBox[{"i", ",", "i"}], "]"}], "]"}], "=", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{"1", "/", "2"}], ")"}], "*", 
              RowBox[{"vars", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", "i"}], "]"}], "]"}], "*", 
              RowBox[{"ellVec", "[", 
               RowBox[{"[", "i", "]"}], "]"}]}], "-", "\[IndentingNewLine]", 
             "      ", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"1", "/", "2"}], ")"}], "*", 
              RowBox[{"Sum", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"vars", "[", 
                  RowBox[{"[", 
                   RowBox[{"i", ",", "k"}], "]"}], "]"}], "*", 
                 RowBox[{"ellVec", "[", 
                  RowBox[{"[", "k", "]"}], "]"}]}], ",", 
                RowBox[{"{", 
                 RowBox[{"k", ",", 
                  RowBox[{"DeleteCases", "[", 
                   RowBox[{
                    RowBox[{"Range", "[", "n", "]"}], ",", "i"}], "]"}]}], 
                 "}"}]}], "]"}]}]}]}], ";", "\[IndentingNewLine]", "    ", 
           RowBox[{"Do", "[", "\[IndentingNewLine]", "      ", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"corrMat", "[", 
                RowBox[{"[", 
                 RowBox[{"i", ",", "j"}], "]"}], "]"}], "=", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"1", "/", "2"}], ")"}], "*", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"vars", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", ",", "j"}], "]"}], "]"}], "*", 
                   RowBox[{"ellVec", "[", 
                    RowBox[{"[", "i", "]"}], "]"}]}], "+", 
                  RowBox[{
                   RowBox[{"vars", "[", 
                    RowBox[{"[", 
                    RowBox[{"j", ",", "i"}], "]"}], "]"}], "*", 
                   RowBox[{"ellVec", "[", 
                    RowBox[{"[", "j", "]"}], "]"}]}]}], ")"}]}]}], ";", 
              "\[IndentingNewLine]", "      ", 
              RowBox[{
               RowBox[{"corrMat", "[", 
                RowBox[{"[", 
                 RowBox[{"j", ",", "i"}], "]"}], "]"}], "=", 
               RowBox[{"corrMat", "[", 
                RowBox[{"[", 
                 RowBox[{"i", ",", "j"}], "]"}], "]"}]}]}], ",", 
             "\[IndentingNewLine]", "      ", 
             RowBox[{"{", 
              RowBox[{"j", ",", 
               RowBox[{"i", "+", "1"}], ",", "n"}], "}"}]}], 
            "\[IndentingNewLine]", "    ", "]"}]}], ",", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"{", 
           RowBox[{"i", ",", "n"}], "}"}]}], "\[IndentingNewLine]", "  ", 
         "]"}], ";", "\[IndentingNewLine]", "  ", "\[IndentingNewLine]", "  ", 
        RowBox[{"hmcMat", "=", 
         RowBox[{"hMat", "-", "corrMat"}]}], ";", "\[IndentingNewLine]", "  ", 
        RowBox[{"objective", "=", 
         RowBox[{"Total", "[", 
          RowBox[{
           RowBox[{"Flatten", "[", "vars", "]"}], "^", "2"}], "]"}]}], ";", 
        "\[IndentingNewLine]", "  ", "\[IndentingNewLine]", "  ", 
        RowBox[{"(*", " ", 
         RowBox[{"Positive", "-", 
          RowBox[{
          "definite", " ", "constraint", " ", "via", " ", "eigenvalue", " ", 
           "lower", " ", "bound"}]}], " ", "*)"}], "\[IndentingNewLine]", 
        "  ", 
        RowBox[{"constraints", "=", 
         RowBox[{"And", " ", "@@", " ", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"Eigenvalues", "[", "hmcMat", "]"}], "[", 
              RowBox[{"[", "i", "]"}], "]"}], ">=", "margin"}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "n"}], "}"}]}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", "  ", "\[IndentingNewLine]", "  ", 
        RowBox[{"(*", " ", "Minimise", " ", "*)"}], "\[IndentingNewLine]", 
        "  ", 
        RowBox[{"result", "=", 
         RowBox[{"Quiet", "[", 
          RowBox[{"NMinimize", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"objective", ",", "constraints"}], "}"}], ",", 
            RowBox[{"Flatten", "[", "vars", "]"}], ",", "\[IndentingNewLine]",
             "    ", 
            RowBox[{"Method", "->", "\"\<InteriorPoint\>\""}], ",", 
            RowBox[{"MaxIterations", "->", "5000"}]}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", "  ", "\[IndentingNewLine]", "  ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Sqrt", "[", 
           RowBox[{"result", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "]"}], ",", 
          RowBox[{"result", "[", 
           RowBox[{"[", "2", "]"}], "]"}], ",", 
          RowBox[{"hmcMat", " ", "/.", " ", 
           RowBox[{"result", "[", 
            RowBox[{"[", "2", "]"}], "]"}]}]}], "}"}]}]}], 
      "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"Test", " ", "for", " ", "small", " ", "dimensions"}], " ", 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<=== MINIMUM BUDGET vs GERSHGORIN UPPER BOUND ===\>\"", 
     "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"N", "=", 
     RowBox[{"2", ":", " ", 
      RowBox[{"canonical", " ", "saddle"}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"h2", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"2.", ",", "0."}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0.", ",", 
         RowBox[{"-", "2."}]}], "}"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ell2", "=", 
     RowBox[{"{", 
      RowBox[{"2.", ",", 
       RowBox[{"-", "2."}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"optBudget2", ",", "optVars2", ",", "optHmC2"}], "}"}], "=", 
     RowBox[{"minBudgetSignFlip", "[", 
      RowBox[{"h2", ",", "ell2"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"gersh2", "=", 
     RowBox[{"gershgorinConstruct", "[", 
      RowBox[{"h2", ",", "ell2"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<N=2, H=diag(2,-2), \[ScriptL]=(2,-2):\>\"", "]"}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<  Optimal budget: \>\"", ",", "optBudget2"}], "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<  Gershgorin budget: \>\"", ",", 
      RowBox[{"gersh2", "[", "\"\<budget\>\"", "]"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<  Ratio (Gersh/Opt): \>\"", ",", 
      RowBox[{
       RowBox[{"gersh2", "[", "\"\<budget\>\"", "]"}], "/", "optBudget2"}]}], 
     "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<  eigenvalues(H-C)_opt: \>\"", ",", 
      RowBox[{"Sort", "[", 
       RowBox[{"Eigenvalues", "[", "optHmC2", "]"}], "]"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"N", "=", 
     RowBox[{"3", ":", " ", 
      RowBox[{"mixed", " ", "saddle"}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"h3test", "=", 
     RowBox[{"N", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"5", ",", "1", ",", 
          RowBox[{"-", "2"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", 
          RowBox[{"-", "3"}], ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "2"}], ",", "1", ",", 
          RowBox[{"-", "4"}]}], "}"}]}], "}"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ell3test", "=", 
     RowBox[{"{", 
      RowBox[{"2.", ",", 
       RowBox[{"-", "1."}], ",", "3."}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"optBudget3", ",", "optVars3", ",", "optHmC3"}], "}"}], "=", 
     RowBox[{"minBudgetSignFlip", "[", 
      RowBox[{"h3test", ",", "ell3test"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"gersh3", "=", 
     RowBox[{"gershgorinConstruct", "[", 
      RowBox[{"h3test", ",", "ell3test"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<N=3, mixed-sign with off-diagonal:\>\"", "]"}],
     ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<  Optimal budget: \>\"", ",", "optBudget3"}], "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<  Gershgorin budget: \>\"", ",", 
      RowBox[{"gersh3", "[", "\"\<budget\>\"", "]"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<  Ratio (Gersh/Opt): \>\"", ",", 
      RowBox[{
       RowBox[{"gersh3", "[", "\"\<budget\>\"", "]"}], "/", "optBudget3"}]}], 
     "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<  eigenvalues(H-C)_opt: \>\"", ",", 
      RowBox[{"Sort", "[", 
       RowBox[{"Eigenvalues", "[", "optHmC3", "]"}], "]"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"N", "=", 
     RowBox[{"5", ":", " ", "random"}]}], " ", "*)"}], "\[IndentingNewLine]", 
   
   RowBox[{
    RowBox[{"SeedRandom", "[", "42", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"q5", "=", 
     RowBox[{"Orthogonalize", "[", 
      RowBox[{"RandomReal", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"5", ",", "5"}], "}"}]}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"h5test", "=", 
     RowBox[{"q5", " ", ".", " ", 
      RowBox[{"DiagonalMatrix", "[", 
       RowBox[{"{", 
        RowBox[{"3.", ",", "1.", ",", 
         RowBox[{"-", "1."}], ",", 
         RowBox[{"-", "2."}], ",", 
         RowBox[{"-", "4."}]}], "}"}], "]"}], " ", ".", " ", 
      RowBox[{"Transpose", "[", "q5", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ell5test", "=", 
     RowBox[{"Normalize", "[", 
      RowBox[{"RandomReal", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", "5"}], "]"}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"optBudget5", ",", "optVars5", ",", "optHmC5"}], "}"}], "=", 
     RowBox[{"minBudgetSignFlip", "[", 
      RowBox[{"h5test", ",", "ell5test"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"gersh5", "=", 
     RowBox[{"gershgorinConstruct", "[", 
      RowBox[{"h5test", ",", "ell5test"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<N=5, spectrum {3,1,-1,-2,-4}:\>\"", "]"}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<  Optimal budget: \>\"", ",", "optBudget5"}], "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<  Gershgorin budget: \>\"", ",", 
      RowBox[{"gersh5", "[", "\"\<budget\>\"", "]"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<  Ratio (Gersh/Opt): \>\"", ",", 
      RowBox[{
       RowBox[{"gersh5", "[", "\"\<budget\>\"", "]"}], "/", "optBudget5"}]}], 
     "]"}], ";"}]}]}]], "Input",ExpressionUUID->"bdc149c4-1133-4245-83d5-\
93bef9b56864"],

Cell["4.3 Scaling Study", "Subsection",ExpressionUUID->"8afb99b4-9130-4075-b30e-eb5a1c142928"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Study", " ", "how", " ", "R", 
    RowBox[{"(", "N", ")"}], " ", "scales", " ", "for", " ", "different", " ",
     "Hessian", " ", "ensembles"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Clear", "[", "\"\<Global`*\>\"", "]"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"Ensemble", " ", "1"}], ":", " ", 
     RowBox[{"Fixed", " ", "spectrum", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"+", "1"}], ",", "...", ",", 
        RowBox[{"+", "1"}], ",", 
        RowBox[{"-", "1"}], ",", "...", ",", 
        RowBox[{"-", "1"}]}], "}"}], " ", "with", " ", "half", " ", 
      "negative"}]}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "This", " ", "is", " ", "the", " ", "\"\<hardest\>\"", " ", "case", " ", 
     "for", " ", "fixed", " ", "eigenvalue", " ", "magnitudes"}], " ", "*)"}],
    "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"gershBudgetScaling", "[", "nn_", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"h", ",", "ell", ",", "result"}], "}"}], ",", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{
        RowBox[{"SeedRandom", "[", 
         RowBox[{
          RowBox[{"nn", "*", "100"}], "+", "7"}], "]"}], ";", 
        "\[IndentingNewLine]", "  ", 
        RowBox[{"(*", " ", 
         RowBox[{"Random", " ", "rotation", " ", "of", " ", "diag", 
          RowBox[{"(", 
           RowBox[{"1", ",", "...", ",", "1", ",", 
            RowBox[{"-", "1"}], ",", "...", ",", 
            RowBox[{"-", "1"}]}], ")"}]}], " ", "*)"}], "\[IndentingNewLine]",
         "  ", 
        RowBox[{"q", "=", 
         RowBox[{"Orthogonalize", "[", 
          RowBox[{"RandomReal", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"nn", ",", "nn"}], "}"}]}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", "  ", 
        RowBox[{"h", "=", 
         RowBox[{"q", " ", ".", " ", 
          RowBox[{"DiagonalMatrix", "[", 
           RowBox[{"Join", "[", 
            RowBox[{
             RowBox[{"ConstantArray", "[", 
              RowBox[{"1.", ",", 
               RowBox[{"Ceiling", "[", 
                RowBox[{"nn", "/", "2"}], "]"}]}], "]"}], ",", 
             RowBox[{"ConstantArray", "[", 
              RowBox[{
               RowBox[{"-", "1."}], ",", 
               RowBox[{"Floor", "[", 
                RowBox[{"nn", "/", "2"}], "]"}]}], "]"}]}], "]"}], "]"}], " ",
           ".", " ", 
          RowBox[{"Transpose", "[", "q", "]"}]}]}], ";", 
        "\[IndentingNewLine]", "  ", 
        RowBox[{"ell", "=", 
         RowBox[{"Normalize", "[", 
          RowBox[{"RandomReal", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", "nn"}], "]"}], 
          "]"}]}], ";", "\[IndentingNewLine]", "  ", 
        RowBox[{"result", "=", 
         RowBox[{"gershgorinConstruct", "[", 
          RowBox[{"h", ",", "ell"}], "]"}]}], ";", "\[IndentingNewLine]", 
        "  ", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<N\>\"", "->", "nn"}], ",", 
          RowBox[{"\"\<budget\>\"", "->", 
           RowBox[{"result", "[", "\"\<budget\>\"", "]"}]}], ",", 
          RowBox[{"\"\<M\>\"", "->", 
           RowBox[{"result", "[", "\"\<M\>\"", "]"}]}], ",", 
          RowBox[{"\"\<posdef\>\"", "->", 
           RowBox[{"result", "[", "\"\<posdef\>\"", "]"}]}]}], "|>"}]}]}], 
      "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"nValues", "=", 
     RowBox[{"{", 
      RowBox[{
      "2", ",", "3", ",", "5", ",", "8", ",", "10", ",", "15", ",", "20", ",",
        "30", ",", "50", ",", "75", ",", "100"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"scalingResults", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"gershBudgetScaling", "[", "nn", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"nn", ",", "nValues"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<=== SCALING: R_Gersh(N) for half-negative spectrum ===\
\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{
      RowBox[{"PaddedForm", "[", 
       RowBox[{"\"\<N\>\"", ",", 
        RowBox[{"{", "5", "}"}]}], "]"}], ",", "\"\<  | \>\"", ",", 
      RowBox[{"PaddedForm", "[", 
       RowBox[{"\"\<R_Gersh\>\"", ",", 
        RowBox[{"{", 
         RowBox[{"12", ",", "2"}], "}"}]}], "]"}], ",", "\"\< | \>\"", ",", 
      RowBox[{"PaddedForm", "[", 
       RowBox[{"\"\<M\>\"", ",", 
        RowBox[{"{", 
         RowBox[{"10", ",", "2"}], "}"}]}], "]"}], ",", "\"\< | PD?\>\""}], 
     "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"StringJoin", "[", 
      RowBox[{"Table", "[", 
       RowBox[{"\"\<-\>\"", ",", 
        RowBox[{"{", "55", "}"}]}], "]"}], "]"}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Do", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"Print", "[", 
       RowBox[{
        RowBox[{"PaddedForm", "[", 
         RowBox[{
          RowBox[{"r", "[", "\"\<N\>\"", "]"}], ",", 
          RowBox[{"{", "5", "}"}]}], "]"}], ",", "\"\<  | \>\"", ",", 
        RowBox[{"PaddedForm", "[", 
         RowBox[{
          RowBox[{"r", "[", "\"\<budget\>\"", "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"12", ",", "2"}], "}"}]}], "]"}], ",", "\"\< | \>\"", ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"PaddedForm", "[", 
         RowBox[{
          RowBox[{"r", "[", "\"\<M\>\"", "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"10", ",", "2"}], "}"}]}], "]"}], ",", "\"\< | \>\"", ",", 
        
        RowBox[{"r", "[", "\"\<posdef\>\"", "]"}]}], "]"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"{", 
       RowBox[{"r", ",", "scalingResults"}], "}"}]}], "\[IndentingNewLine]", 
     "]"}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"Fit", " ", "power", " ", "law"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"logN", "=", 
     RowBox[{"Log", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"#", "[", "\"\<N\>\"", "]"}], "&"}], " ", "/@", " ", 
       "scalingResults"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"logR", "=", 
     RowBox[{"Log", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"#", "[", "\"\<budget\>\"", "]"}], "&"}], " ", "/@", " ", 
       "scalingResults"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"fit", "=", 
     RowBox[{"Fit", "[", 
      RowBox[{
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{"logN", ",", "logR"}], "}"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "x"}], "}"}], ",", "x"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"slope", "=", 
     RowBox[{"Coefficient", "[", 
      RowBox[{"fit", ",", "x"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Power-law fit: R_Gersh ~ N^\>\"", ",", 
      RowBox[{"Round", "[", 
       RowBox[{"slope", ",", "0.01"}], "]"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<(This is an UPPER BOUND \[LongDash] the actual minimum \
budget may scale differently)\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"Also", " ", 
     RowBox[{"measure", ":", " ", 
      RowBox[{"diagonal", "-", 
       RowBox[{"only", " ", "construction", " ", 
        RowBox[{"(", 
         RowBox[{"H", " ", "in", " ", "eigenbasis"}], ")"}]}]}]}]}], " ", 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<=== SCALING: R_diag(N) for diagonal H (eigenbasis) ===\
\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"diagBudgetScaling", "[", "nn_", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"lambdas", ",", "ell", ",", "budget"}], "}"}], ",", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{
        RowBox[{"SeedRandom", "[", 
         RowBox[{
          RowBox[{"nn", "*", "100"}], "+", "7"}], "]"}], ";", 
        "\[IndentingNewLine]", "  ", 
        RowBox[{"lambdas", "=", 
         RowBox[{"Join", "[", 
          RowBox[{
           RowBox[{"ConstantArray", "[", 
            RowBox[{"1.", ",", 
             RowBox[{"Ceiling", "[", 
              RowBox[{"nn", "/", "2"}], "]"}]}], "]"}], ",", 
           RowBox[{"ConstantArray", "[", 
            RowBox[{
             RowBox[{"-", "1."}], ",", 
             RowBox[{"Floor", "[", 
              RowBox[{"nn", "/", "2"}], "]"}]}], "]"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", "  ", 
        RowBox[{"ell", "=", 
         RowBox[{"Normalize", "[", 
          RowBox[{"RandomReal", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", "nn"}], "]"}], 
          "]"}]}], ";", "\[IndentingNewLine]", "  ", 
        RowBox[{"budget", "=", 
         RowBox[{"2", "*", 
          RowBox[{"Sqrt", "[", 
           RowBox[{"Total", "[", 
            RowBox[{
             RowBox[{"Select", "[", "\[IndentingNewLine]", "    ", 
              RowBox[{
               RowBox[{"Table", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{
                   RowBox[{"lambdas", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "^", "2"}], "/", 
                  RowBox[{
                   RowBox[{"ell", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "^", "2"}]}], ",", 
                 RowBox[{"{", 
                  RowBox[{"i", ",", "nn"}], "}"}]}], "]"}], ",", 
               "\[IndentingNewLine]", "    ", 
               RowBox[{
                RowBox[{
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"lambdas", "[", 
                    RowBox[{"[", "#", "]"}], "]"}], "&"}], " ", "/@", " ", 
                    RowBox[{"Range", "[", "nn", "]"}]}], ")"}], "[", 
                  RowBox[{"[", "All", "]"}], "]"}], "<", "0"}], " ", "&"}]}], 
              "  ", 
              RowBox[{"(*", " ", 
               RowBox[{"only", " ", "negative", " ", "eigenvalues"}], " ", 
               "*)"}], "\[IndentingNewLine]", "  ", "]"}], " ", "/.", " ", 
             RowBox[{
              RowBox[{"{", "}"}], "->", 
              RowBox[{"{", "0", "}"}]}]}], "]"}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", "  ", 
        RowBox[{"(*", " ", 
         RowBox[{"More", " ", 
          RowBox[{"directly", ":"}]}], " ", "*)"}], "\[IndentingNewLine]", 
        "  ", 
        RowBox[{"budget", "=", 
         RowBox[{"2", "*", 
          RowBox[{"Sqrt", "[", 
           RowBox[{"Total", "[", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"lambdas", "[", 
                  RowBox[{"[", "i", "]"}], "]"}], "<", "0"}], ",", 
                RowBox[{
                 RowBox[{
                  RowBox[{"lambdas", "[", 
                   RowBox[{"[", "i", "]"}], "]"}], "^", "2"}], "/", 
                 RowBox[{
                  RowBox[{"ell", "[", 
                   RowBox[{"[", "i", "]"}], "]"}], "^", "2"}]}], ",", "0"}], 
               "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"i", ",", "nn"}], "}"}]}], "]"}], "]"}], "]"}]}]}], ";",
         "\[IndentingNewLine]", "  ", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<N\>\"", "->", "nn"}], ",", 
          RowBox[{"\"\<budget\>\"", "->", "budget"}]}], "|>"}]}]}], 
      "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"diagResults", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"diagBudgetScaling", "[", "nn", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"nn", ",", "nValues"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{
      RowBox[{"PaddedForm", "[", 
       RowBox[{"\"\<N\>\"", ",", 
        RowBox[{"{", "5", "}"}]}], "]"}], ",", "\"\<  | \>\"", ",", 
      RowBox[{"PaddedForm", "[", 
       RowBox[{"\"\<R_diag\>\"", ",", 
        RowBox[{"{", 
         RowBox[{"12", ",", "2"}], "}"}]}], "]"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"StringJoin", "[", 
      RowBox[{"Table", "[", 
       RowBox[{"\"\<-\>\"", ",", 
        RowBox[{"{", "25", "}"}]}], "]"}], "]"}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Do", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"Print", "[", 
       RowBox[{
        RowBox[{"PaddedForm", "[", 
         RowBox[{
          RowBox[{"r", "[", "\"\<N\>\"", "]"}], ",", 
          RowBox[{"{", "5", "}"}]}], "]"}], ",", "\"\<  | \>\"", ",", 
        RowBox[{"PaddedForm", "[", 
         RowBox[{
          RowBox[{"r", "[", "\"\<budget\>\"", "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"12", ",", "2"}], "}"}]}], "]"}]}], "]"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"{", 
       RowBox[{"r", ",", "diagResults"}], "}"}]}], "\[IndentingNewLine]", 
     "]"}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"logRdiag", "=", 
     RowBox[{"Log", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"#", "[", "\"\<budget\>\"", "]"}], "&"}], " ", "/@", " ", 
       "diagResults"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"fitDiag", "=", 
     RowBox[{"Fit", "[", 
      RowBox[{
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{"logN", ",", "logRdiag"}], "}"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "x"}], "}"}], ",", "x"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"slopeDiag", "=", 
     RowBox[{"Coefficient", "[", 
      RowBox[{"fitDiag", ",", "x"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Power-law fit: R_diag ~ N^\>\"", ",", 
      RowBox[{"Round", "[", 
       RowBox[{"slopeDiag", ",", "0.01"}], "]"}]}], "]"}], ";"}]}]}]], "Input",\
ExpressionUUID->"687ee4cb-42fb-4338-92f8-e819db12d11c"],

