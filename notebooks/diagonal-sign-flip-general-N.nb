 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"d50891eb-867c-4d0d-9847-2f477e55b4cb"],

Cell["1. General N Christoffel Symbols", "Section",ExpressionUUID->"83e03ae4-f2b4-459e-9172-acb1edc9601a"],

Cell["1.1 Derivation for Diagonal Metric", "Subsection",ExpressionUUID->"85a84e65-911c-4285-bbc5-476be6a72246"],

Cell[TextData[{
 "For ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Gamma]", 
          RowBox[{
            StyleBox["a", "TI"], 
            StyleBox["b", "TI"]}]], "\[LongEqual]", 
         SuperscriptBox[
          StyleBox["e", "TI"], 
          SubscriptBox[
           StyleBox["s", "TI"], 
           StyleBox["a", "TI"]]], 
         SubscriptBox["\[Delta]", 
          RowBox[{
            StyleBox["a", "TI"], 
            StyleBox["b", "TI"]}]]}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\gamma_{ab} = e^{s_a} \\delta_{ab}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "3514f70d-eb8b-4dcd-a668-d3bd92997cea"],
 " (no sum), the metric derivatives are ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[PartialD]", 
          StyleBox["m", "TI"]], 
         SubscriptBox["\[Gamma]", 
          RowBox[{
            StyleBox["a", "TI"], 
            StyleBox["b", "TI"]}]], "\[LongEqual]", 
         SuperscriptBox[
          StyleBox["e", "TI"], 
          SubscriptBox[
           StyleBox["s", "TI"], 
           StyleBox["a", "TI"]]], 
         RowBox[{"(", 
           RowBox[{
             SubscriptBox["\[PartialD]", 
              StyleBox["m", "TI"]], 
             SubscriptBox[
              StyleBox["s", "TI"], 
              StyleBox["a", "TI"]]}], ")"}], 
         SubscriptBox["\[Delta]", 
          RowBox[{
            StyleBox["a", "TI"], 
            StyleBox["b", "TI"]}]]}], TraditionalForm], "errors" -> {}, 
     "input" -> 
     "\\partial_m \\gamma_{ab} = e^{s_a} (\\partial_m s_a) \\delta_{ab}", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5abc5c65-aa54-43fc-9c72-74b088446b28"],
 ". "
}], "Text",ExpressionUUID->"857f0bad-b886-4ce8-b118-eb00b868e62b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "Verify", " ", "Christoffel", " ", "symbols", " ", "symbolically", " ", 
     "for", " ", "N"}], "=", "3"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Clear", "[", "\"\<Global`*\>\"", "]"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"n", "=", "3"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"coords", "=", 
     RowBox[{"Array", "[", 
      RowBox[{"x", ",", "n"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"sFuncs", "=", 
     RowBox[{"Array", "[", 
      RowBox[{"s", ",", "n"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"Build", " ", "diagonal", " ", "metric"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"gamDiag", "=", 
     RowBox[{"DiagonalMatrix", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Exp", "[", 
         RowBox[{"#", "[", 
          RowBox[{"Sequence", " ", "@@", " ", "coords"}], "]"}], "]"}], " ", 
        "&"}], " ", "/@", " ", "sFuncs"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"gamDiagInv", "=", 
     RowBox[{"DiagonalMatrix", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Exp", "[", 
         RowBox[{"-", 
          RowBox[{"#", "[", 
           RowBox[{"Sequence", " ", "@@", " ", "coords"}], "]"}]}], "]"}], 
        " ", "&"}], " ", "/@", " ", "sFuncs"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"Compute", " ", "Christoffel", " ", "symbols"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"christGam", "=", 
     RowBox[{"Table", "[", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"Simplify", "[", 
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"gamDiagInv", "[", 
            RowBox[{"[", 
             RowBox[{"k", ",", "ll"}], "]"}], "]"}], "*", 
           RowBox[{"(", 
            RowBox[{"1", "/", "2"}], ")"}], "*", 
           RowBox[{"(", "\[IndentingNewLine]", "    ", 
            RowBox[{
             RowBox[{"D", "[", 
              RowBox[{
               RowBox[{"gamDiag", "[", 
                RowBox[{"[", 
                 RowBox[{"j", ",", "ll"}], "]"}], "]"}], ",", 
               RowBox[{"coords", "[", 
                RowBox[{"[", "i", "]"}], "]"}]}], "]"}], "+", 
             "\[IndentingNewLine]", "    ", 
             RowBox[{"D", "[", 
              RowBox[{
               RowBox[{"gamDiag", "[", 
                RowBox[{"[", 
                 RowBox[{"i", ",", "ll"}], "]"}], "]"}], ",", 
               RowBox[{"coords", "[", 
                RowBox[{"[", "j", "]"}], "]"}]}], "]"}], "-", 
             "\[IndentingNewLine]", "    ", 
             RowBox[{"D", "[", 
              RowBox[{
               RowBox[{"gamDiag", "[", 
                RowBox[{"[", 
                 RowBox[{"i", ",", "j"}], "]"}], "]"}], ",", 
               RowBox[{"coords", "[", 
                RowBox[{"[", "ll", "]"}], "]"}]}], "]"}]}], 
            "\[IndentingNewLine]", "  ", ")"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"ll", ",", "1", ",", "n"}], "}"}]}], "]"}], "]"}], ",", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"{", 
        RowBox[{"k", ",", "1", ",", "n"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", "n"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "1", ",", "n"}], "}"}]}], "\[IndentingNewLine]", 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"Display", " ", "non"}], "-", 
     RowBox[{"zero", " ", "components"}]}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<=== Non-zero Christoffel symbols for N=3 diagonal \
metric ===\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Do", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"christGam", "[", 
          RowBox[{"[", 
           RowBox[{"k", ",", "i", ",", "j"}], "]"}], "]"}], "=!=", "0"}], ",",
         "\[IndentingNewLine]", "    ", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<\[CapitalGamma]^\>\"", ",", "k", ",", "\"\<_{\>\"", ",",
           "i", ",", "\"\<,\>\"", ",", "j", ",", "\"\<} = \>\"", ",", 
          RowBox[{"christGam", "[", 
           RowBox[{"[", 
            RowBox[{"k", ",", "i", ",", "j"}], "]"}], "]"}]}], "]"}]}], 
       "\[IndentingNewLine]", "  ", "]"}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"{", 
       RowBox[{"k", ",", "1", ",", "n"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "1", ",", "n"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"j", ",", "i", ",", "n"}], "}"}]}], "\[IndentingNewLine]", 
     "]"}], ";"}]}]}]], "Input",ExpressionUUID->"e5a54091-0845-4699-bff0-\
fc78850e275b"],

Cell["1.2 General Pattern", "Subsection",ExpressionUUID->"c9c949c4-90ee-4c29-9a34-6094d0721222"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "The", " ", "pattern", " ", "for", " ", "general", " ", "N", " ", 
    "diagonal", " ", "metric", " ", 
    RowBox[{"is", ":"}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<\:2554\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\
\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\
\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\
\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\
\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\
\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\
\:2550\:2550\:2557\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<\:2551  CHRISTOFFEL SYMBOLS for \[Gamma] = diag(e^{s\
\:2081}, ..., e^{s\:2099}):               \:2551\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<\:2551                                                 \
                        \:2551\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<\:2551  \[CapitalGamma]^i_{ii} = (1/2) \[PartialD]\
\:1d62s\:1d62                     (self-diagonal)            \:2551\>\"", 
     "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<\:2551  \[CapitalGamma]^k_{ii} = -(1/2) e^{s\:1d62-s\
\:2096} \[PartialD]\:2096s\:1d62         (cross-diagonal, k\[NotEqual]i)     \
\:2551\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<\:2551  \[CapitalGamma]^i_{ij} = (1/2) \[PartialD]\
\:2c7cs\:1d62                     (mixed, k=i, i\[NotEqual]j)         \
\:2551\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<\:2551  \[CapitalGamma]^j_{ij} = (1/2) \[PartialD]\
\:1d62s\:2c7c                     (mixed, k=j, i\[NotEqual]j)         \
\:2551\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<\:2551  \[CapitalGamma]^k_{ij} = 0                     \
          (all indices distinct)     \:2551\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<\:2551                                                 \
                        \:2551\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<\:255a\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\
\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\
\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\
\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\
\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\
\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\
\:2550\:2550\:255d\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Verify", " ", "the", " ", "pattern", " ", "against", " ", "symbolic", " ",
      "computation"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Verifying pattern against N=3 symbolic \
computation...\>\"", "]"}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"patternCheck", "=", "True"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Do", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"Case", " ", "1"}], ":", " ", 
       RowBox[{"all", " ", "equal"}]}], " ", "*)"}], "\[IndentingNewLine]", 
     "  ", 
     RowBox[{
      RowBox[{
       RowBox[{"expected", "=", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "/", "2"}], ")"}], "*", 
         RowBox[{"D", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"sFuncs", "[", 
             RowBox[{"[", "i", "]"}], "]"}], "[", 
            RowBox[{"Sequence", " ", "@@", " ", "coords"}], "]"}], ",", 
           RowBox[{"coords", "[", 
            RowBox[{"[", "i", "]"}], "]"}]}], "]"}]}]}], ";", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Simplify", "[", 
           RowBox[{
            RowBox[{"christGam", "[", 
             RowBox[{"[", 
              RowBox[{"i", ",", "i", ",", "i"}], "]"}], "]"}], "-", 
            "expected"}], "]"}], "=!=", "0"}], ",", "\[IndentingNewLine]", 
         "    ", 
         RowBox[{
          RowBox[{"Print", "[", 
           
           RowBox[{"\"\<FAIL: \[CapitalGamma]^\>\"", ",", "i", 
            ",", "\"\<_\>\"", ",", "i", ",", "i"}], "]"}], ";", " ", 
          RowBox[{"patternCheck", "=", "False"}]}]}], "]"}]}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"{", 
       RowBox[{"i", ",", "1", ",", "n"}], "}"}]}], "\[IndentingNewLine]", 
     "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Do", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"Case", " ", "2"}], ":", " ", 
       RowBox[{"cross", "-", "diagonal"}]}], " ", "*)"}], 
     "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{
       RowBox[{"expected", "=", 
        RowBox[{
         RowBox[{"-", 
          RowBox[{"(", 
           RowBox[{"1", "/", "2"}], ")"}]}], "*", 
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"sFuncs", "[", 
             RowBox[{"[", "i", "]"}], "]"}], "[", 
            RowBox[{"Sequence", " ", "@@", " ", "coords"}], "]"}], "-", 
           RowBox[{
            RowBox[{"sFuncs", "[", 
             RowBox[{"[", "k", "]"}], "]"}], "[", 
            RowBox[{"Sequence", " ", "@@", " ", "coords"}], "]"}]}], "]"}], "*",
          "\[IndentingNewLine]", "    ", 
         RowBox[{"D", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"sFuncs", "[", 
             RowBox[{"[", "i", "]"}], "]"}], "[", 
            RowBox[{"Sequence", " ", "@@", " ", "coords"}], "]"}], ",", 
           RowBox[{"coords", "[", 
            RowBox[{"[", "k", "]"}], "]"}]}], "]"}]}]}], ";", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Simplify", "[", 
           RowBox[{
            RowBox[{"christGam", "[", 
             RowBox[{"[", 
              RowBox[{"k", ",", "i", ",", "i"}], "]"}], "]"}], "-", 
            "expected"}], "]"}], "=!=", "0"}], ",", "\[IndentingNewLine]", 
         "    ", 
         RowBox[{
          RowBox[{"Print", "[", 
           
           RowBox[{"\"\<FAIL: \[CapitalGamma]^\>\"", ",", "k", 
            ",", "\"\<_\>\"", ",", "i", ",", "i"}], "]"}], ";", " ", 
          RowBox[{"patternCheck", "=", "False"}]}]}], "]"}]}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"{", 
       RowBox[{"i", ",", "1", ",", "n"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"k", ",", 
        RowBox[{"DeleteCases", "[", 
         RowBox[{
          RowBox[{"Range", "[", "n", "]"}], ",", "i"}], "]"}]}], "}"}]}], 
     "\[IndentingNewLine]", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Do", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"Case", " ", "3"}], ":", " ", "mixed"}], ",", " ", 
       RowBox[{"k", "=", "i"}]}], " ", "*)"}], "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{
       RowBox[{"expected", "=", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "/", "2"}], ")"}], "*", 
         RowBox[{"D", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"sFuncs", "[", 
             RowBox[{"[", "i", "]"}], "]"}], "[", 
            RowBox[{"Sequence", " ", "@@", " ", "coords"}], "]"}], ",", 
           RowBox[{"coords", "[", 
            RowBox[{"[", "j", "]"}], "]"}]}], "]"}]}]}], ";", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Simplify", "[", 
           RowBox[{
            RowBox[{"christGam", "[", 
             RowBox[{"[", 
              RowBox[{"i", ",", "i", ",", "j"}], "]"}], "]"}], "-", 
            "expected"}], "]"}], "=!=", "0"}], ",", "\[IndentingNewLine]", 
         "    ", 
         RowBox[{
          RowBox[{"Print", "[", 
           
           RowBox[{"\"\<FAIL: \[CapitalGamma]^\>\"", ",", "i", 
            ",", "\"\<_\>\"", ",", "i", ",", "j"}], "]"}], ";", " ", 
          RowBox[{"patternCheck", "=", "False"}]}]}], "]"}]}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"{", 
       RowBox[{"i", ",", "1", ",", "n"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"j", ",", 
        RowBox[{"DeleteCases", "[", 
         RowBox[{
          RowBox[{"Range", "[", "n", "]"}], ",", "i"}], "]"}]}], "}"}]}], 
     "\[IndentingNewLine]", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"If", "[", 
      RowBox[{
      "patternCheck", ",", "\"\<All patterns verified \[Checkmark]\>\"", 
       ",", "\"\<PATTERN MISMATCH\>\""}], "]"}], "]"}], ";"}]}]}]], "Input",Ex\
pressionUUID->"d713c83b-a095-4f28-9c9f-0ccdca700f0a"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
