Cell["2. Correction Matrix Structure", "Section",ExpressionUUID->"4b4b33fb-d37e-4994-9a74-8f449a927915"],

Cell["2.1 General Formula for $C_{ij}$", "Subsection",ExpressionUUID->"001007a0-ed72-4ec7-84e3-9c2bf55398b7"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Derive", " ", "C_", 
     RowBox[{"{", "ij", "}"}]}], " ", "=", " ", 
    RowBox[{
     RowBox[{"\[CapitalGamma]", "^", "k_"}], 
     RowBox[{"{", "ij", "}"}], 
     RowBox[{"(", "\[Gamma]", ")"}], " ", "\[ScriptL]_k", " ", "for", " ", 
     "general", " ", "N"}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<\:2554\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\
\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\
\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\
\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\
\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\
\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\
\:2550\:2550\:2550\:2550\:2550\:2557\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<\:2551  CORRECTION MATRIX C_{ij} = \[CapitalSigma]_k \
\[CapitalGamma]^k_{ij}(\[Gamma]) \[ScriptL]_k for diagonal \[Gamma]:         \
\:2551\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<\:2551                                                 \
                           \:2551\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<\:2551  DIAGONAL (i = j):                              \
                           \:2551\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<\:2551  C_{ii} = (1/2) (\[PartialD]\:1d62s\:1d62) \
\[ScriptL]\:1d62 - (1/2) \[CapitalSigma]_{k\[NotEqual]i} e^{s\:1d62-s\:2096} \
(\[PartialD]\:2096s\:1d62) \[ScriptL]\:2096       \:2551\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<\:2551                                                 \
                           \:2551\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<\:2551  OFF-DIAGONAL (i \[NotEqual] j):                \
                                     \:2551\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<\:2551  C_{ij} = (1/2) [(\[PartialD]\:2c7cs\:1d62) \
\[ScriptL]\:1d62 + (\[PartialD]\:1d62s\:2c7c) \[ScriptL]\:2c7c]               \
                \:2551\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<\:2551                                                 \
                           \:2551\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<\:2551  KEY STRUCTURAL PROPERTIES:                     \
                           \:2551\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<\:2551  \[Bullet] \[PartialD]\:1d62s\:1d62 appears \
ONLY in C_{ii} (no coupling to off-diagonal)              \:2551\>\"", "]"}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<\:2551  \[Bullet] \[PartialD]\:2c7cs\:1d62 (j\
\[NotEqual]i) appears in C_{ij} and C_{ii} \[LongDash] but when \[ScriptL]\
\:1d62=0,             \:2551\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<\:2551    its contribution to C_{ij} vanishes, leaving \
only C_{ii}                \:2551\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<\:2551  \[Bullet] Exponential ratios \
e^{s\:1d62-s\:2096} provide unbounded amplification           \:2551\>\"", 
     "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<\:2551                                                 \
                           \:2551\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<\:255a\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\
\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\
\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\
\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\
\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\
\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\
\:2550\:2550\:2550\:2550\:2550\:255d\>\"", "]"}], ";"}]}]}]], "Input",Expressi\
onUUID->"42a88807-1ba2-4bf1-923e-56056a7a70dc"],

Cell["2.2 Numerical Verification for N=3", "Subsection",ExpressionUUID->"5c13f1ea-22dd-4b78-93b5-78ddaabc452a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "Verify", " ", "C", " ", "formula", " ", "numerically", " ", "for", " ", 
     "N"}], "=", "3"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Clear", "[", "\"\<Global`*\>\"", "]"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"n", "=", "3"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"coords", "=", 
     RowBox[{"{", 
      RowBox[{"x", ",", "y", ",", "z"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"pt", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"x", "->", "1"}], ",", 
       RowBox[{"y", "->", "1"}], ",", 
       RowBox[{"z", "->", "1"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Define", " ", "learnable", " ", "parameters", " ", "and", " ", "loss"}], 
    " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"s1F", "[", 
      RowBox[{"x_", ",", "y_", ",", "z_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"-", "x"}], "+", 
      RowBox[{"2", " ", "y"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"s2F", "[", 
      RowBox[{"x_", ",", "y_", ",", "z_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"3", " ", "z"}], "-", "y"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"s3F", "[", 
      RowBox[{"x_", ",", "y_", ",", "z_"}], "]"}], ":=", 
     RowBox[{"x", "+", "z"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"lossF", "[", 
      RowBox[{"x_", ",", "y_", ",", "z_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"2", " ", 
       RowBox[{"x", "^", "2"}]}], "-", 
      RowBox[{"y", "^", "2"}], "+", 
      RowBox[{"3", " ", 
       RowBox[{"z", "^", "2"}]}], "-", 
      RowBox[{"x", " ", "y"}]}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"Build", " ", "metric"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"gamF", "=", 
     RowBox[{"DiagonalMatrix", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Exp", "[", 
         RowBox[{"s1F", "[", 
          RowBox[{"x", ",", "y", ",", "z"}], "]"}], "]"}], ",", 
        RowBox[{"Exp", "[", 
         RowBox[{"s2F", "[", 
          RowBox[{"x", ",", "y", ",", "z"}], "]"}], "]"}], ",", 
        RowBox[{"Exp", "[", 
         RowBox[{"s3F", "[", 
          RowBox[{"x", ",", "y", ",", "z"}], "]"}], "]"}]}], "}"}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"gamInvF", "=", 
     RowBox[{"DiagonalMatrix", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Exp", "[", 
         RowBox[{"-", 
          RowBox[{"s1F", "[", 
           RowBox[{"x", ",", "y", ",", "z"}], "]"}]}], "]"}], ",", 
        RowBox[{"Exp", "[", 
         RowBox[{"-", 
          RowBox[{"s2F", "[", 
           RowBox[{"x", ",", "y", ",", "z"}], "]"}]}], "]"}], ",", 
        RowBox[{"Exp", "[", 
         RowBox[{"-", 
          RowBox[{"s3F", "[", 
           RowBox[{"x", ",", "y", ",", "z"}], "]"}]}], "]"}]}], "}"}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"lGrad", "=", 
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"lossF", "[", 
        RowBox[{"x", ",", "y", ",", "z"}], "]"}], ",", 
       RowBox[{"{", "coords", "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   
   RowBox[{
    RowBox[{"hess", "=", 
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"lossF", "[", 
        RowBox[{"x", ",", "y", ",", "z"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"coords", ",", "2"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"gF", "=", 
     RowBox[{"gamF", "+", 
      RowBox[{"Outer", "[", 
       RowBox[{"Times", ",", "lGrad", ",", "lGrad"}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Direct", " ", "computation", " ", "of", " ", "Riemannian", " ", 
     "Hessian"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"gNum", "=", 
     RowBox[{
      RowBox[{"gF", " ", "/.", " ", "pt"}], " ", "//", " ", "N"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"gInvNum", "=", 
     RowBox[{"Inverse", "[", "gNum", "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"lNum", "=", 
     RowBox[{
      RowBox[{"lGrad", " ", "/.", " ", "pt"}], " ", "//", " ", "N"}]}], ";"}],
    "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"hNum", "=", 
     RowBox[{
      RowBox[{"hess", " ", "/.", " ", "pt"}], " ", "//", " ", "N"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"dgdi", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"D", "[", 
          RowBox[{"gF", ",", 
           RowBox[{"coords", "[", 
            RowBox[{"[", "i", "]"}], "]"}]}], "]"}], " ", "/.", " ", "pt"}], 
        " ", "//", " ", "N"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", "n"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"christGNum", "=", 
     RowBox[{"Table", "[", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"gInvNum", "[", 
           RowBox[{"[", 
            RowBox[{"k", ",", "ll"}], "]"}], "]"}], "*", 
          RowBox[{"(", 
           RowBox[{"1", "/", "2"}], ")"}], "*", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"dgdi", "[", 
              RowBox[{"[", "i", "]"}], "]"}], "[", 
             RowBox[{"[", 
              RowBox[{"j", ",", "ll"}], "]"}], "]"}], "+", 
            RowBox[{
             RowBox[{"dgdi", "[", 
              RowBox[{"[", "j", "]"}], "]"}], "[", 
             RowBox[{"[", 
              RowBox[{"i", ",", "ll"}], "]"}], "]"}], "-", 
            RowBox[{
             RowBox[{"dgdi", "[", 
              RowBox[{"[", "ll", "]"}], "]"}], "[", 
             RowBox[{"[", 
              RowBox[{"i", ",", "j"}], "]"}], "]"}]}], ")"}]}], ",", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"{", 
          RowBox[{"ll", ",", "1", ",", "n"}], "}"}]}], "]"}], ",", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"{", 
        RowBox[{"k", ",", "1", ",", "n"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", "n"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "1", ",", "n"}], "}"}]}], "\[IndentingNewLine]", 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"directRH", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"hNum", "[", 
         RowBox[{"[", 
          RowBox[{"i", ",", "j"}], "]"}], "]"}], "-", 
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"christGNum", "[", 
            RowBox[{"[", 
             RowBox[{"k", ",", "i", ",", "j"}], "]"}], "]"}], "*", 
           RowBox[{"lNum", "[", 
            RowBox[{"[", "k", "]"}], "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"k", ",", "1", ",", "n"}], "}"}]}], "]"}]}], ",", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", "n"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "1", ",", "n"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"Via", " ", 
     RowBox[{"formula", ":", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"H", " ", "-", " ", "C"}], ")"}], " ", "/", " ", 
       "\[Alpha]"}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"gamNum", "=", 
     RowBox[{
      RowBox[{"gamF", " ", "/.", " ", "pt"}], " ", "//", " ", "N"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"gamInvNum", "=", 
     RowBox[{
      RowBox[{"gamInvF", " ", "/.", " ", "pt"}], " ", "//", " ", "N"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"dgamdi", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"D", "[", 
          RowBox[{"gamF", ",", 
           RowBox[{"coords", "[", 
            RowBox[{"[", "i", "]"}], "]"}]}], "]"}], " ", "/.", " ", "pt"}], 
        " ", "//", " ", "N"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", "n"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"christGamNum", "=", 
     RowBox[{"Table", "[", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"gamInvNum", "[", 
           RowBox[{"[", 
            RowBox[{"k", ",", "ll"}], "]"}], "]"}], "*", 
          RowBox[{"(", 
           RowBox[{"1", "/", "2"}], ")"}], "*", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"dgamdi", "[", 
              RowBox[{"[", "i", "]"}], "]"}], "[", 
             RowBox[{"[", 
              RowBox[{"j", ",", "ll"}], "]"}], "]"}], "+", 
            RowBox[{
             RowBox[{"dgamdi", "[", 
              RowBox[{"[", "j", "]"}], "]"}], "[", 
             RowBox[{"[", 
              RowBox[{"i", ",", "ll"}], "]"}], "]"}], "-", 
            RowBox[{
             RowBox[{"dgamdi", "[", 
              RowBox[{"[", "ll", "]"}], "]"}], "[", 
             RowBox[{"[", 
              RowBox[{"i", ",", "j"}], "]"}], "]"}]}], ")"}]}], ",", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"{", 
          RowBox[{"ll", ",", "1", ",", "n"}], "}"}]}], "]"}], ",", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"{", 
        RowBox[{"k", ",", "1", ",", "n"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", "n"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "1", ",", "n"}], "}"}]}], "\[IndentingNewLine]", 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"corrNum", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"christGamNum", "[", 
           RowBox[{"[", 
            RowBox[{"k", ",", "i", ",", "j"}], "]"}], "]"}], "*", 
          RowBox[{"lNum", "[", 
           RowBox[{"[", "k", "]"}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", "1", ",", "n"}], "}"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", "n"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "1", ",", "n"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"alphaNum", "=", 
     RowBox[{"1", "+", 
      RowBox[{"lNum", " ", ".", " ", "gamInvNum", " ", ".", " ", "lNum"}]}]}],
     ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"formulaRH", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"hNum", "-", "corrNum"}], ")"}], "/", "alphaNum"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<=== N=3 VERIFICATION ===\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<L = 2x\.b2-y\.b2+3z\.b2-xy at (1,1,1)\>\"", "]"}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<\[Gamma] = diag(e^{-x+2y}, e^{3z-y}, e^{x+z})\>\"", 
     "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<H = \>\"", ",", 
      RowBox[{"hNum", " ", "//", " ", "MatrixForm"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<eigenvalues(H) = \>\"", ",", 
      RowBox[{"Sort", "[", 
       RowBox[{"Eigenvalues", "[", "hNum", "]"}], "]"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<C = \>\"", ",", 
      RowBox[{"corrNum", " ", "//", " ", "MatrixForm"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Tr(C) = \>\"", ",", 
      RowBox[{"Tr", "[", "corrNum", "]"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<Direct Riemannian Hessian:\>\"", "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"directRH", " ", "//", " ", "MatrixForm"}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<Formula (H-C)/\[Alpha]:\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"formulaRH", " ", "//", " ", "MatrixForm"}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Max |difference|: \>\"", ",", 
      RowBox[{"Max", "[", 
       RowBox[{"Abs", "[", 
        RowBox[{"Flatten", "[", 
         RowBox[{"directRH", "-", "formulaRH"}], "]"}], "]"}], "]"}]}], "]"}],
     ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<eigenvalues(Hess_g L) = \>\"", ",", 
      RowBox[{"Sort", "[", 
       RowBox[{"Eigenvalues", "[", "directRH", "]"}], "]"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Sign flip: \>\"", ",", 
      RowBox[{
       RowBox[{
        RowBox[{"Min", "[", 
         RowBox[{"Eigenvalues", "[", "hNum", "]"}], "]"}], "<", "0"}], "&&", 
       RowBox[{
        RowBox[{"Min", "[", 
         RowBox[{"Eigenvalues", "[", "directRH", "]"}], "]"}], ">", "0"}]}]}],
      "]"}], ";"}]}]}]], "Input",ExpressionUUID->"d72ff1d7-2809-475f-ab51-\
27509fd0a5ee"],

Cell["2.3 Degree-of-Freedom Count", "Subsection",ExpressionUUID->"ba55e754-9090-4bfa-a7f6-bab2cd93a62d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<\:2554\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\
\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\
\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\
\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\
\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\
\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2557\>\"", 
   "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<\:2551  DEGREE-OF-FREEDOM ANALYSIS:                      \
                 \:2551\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<\:2551                                                   \
                  \:2551\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
