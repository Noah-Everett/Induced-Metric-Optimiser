Cell["3. Theorem: Existence of Sign-Flipping for General N", "Section",ExpressionUUID->"12e51988-7acc-4a87-936f-b1c4d7f7dbe1"],

Cell["3.1 Statement and Proof", "Subsection",ExpressionUUID->"2576fab5-436a-464f-9ee4-47b9b860bbd3"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<\:2554\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\
\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\
\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\
\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\
\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\
\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\
\:2550\:2550\:2550\:2550\:2550\:2557\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<\:2551                                                   \
                           \:2551\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<\:2551  THEOREM (Diagonal Sign-Flipping, General N):     \
                           \:2551\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<\:2551                                                   \
                           \:2551\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<\:2551  Let H \[Element] \:211d^{N\[Times]N} be \
symmetric and \[ScriptL] \[Element] \:211d^N with \[ScriptL] \[NotEqual] 0.   \
                   \:2551\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<\:2551  There exist s\:2081,...,s\:2099 \[Element] \
\:211d and \[Del]s\:2081,...,\[Del]s\:2099 \[Element] \:211d^N such that,     \
          \:2551\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<\:2551  for \[Gamma] = diag(e^{s\:2081},...,e^{s\:2099}) \
with correction C_{ij} = \[CapitalGamma]^k_{ij}(\[Gamma]) \[ScriptL]_k, \
\:2551\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<\:2551  the matrix H \[Minus] C is positive definite.    \
                                  \:2551\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<\:2551                                                   \
                           \:2551\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<\:255a\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\
\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\
\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\
\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\
\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\
\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\
\:2550\:2550\:2550\:2550\:2550\:255d\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<PROOF (constructive, via Gershgorin circle theorem):\>\"",
    "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", "\"\<Step 1: DECOUPLED CONTROL\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<  Set all s\:1d62 = 0 and all off-diagonal gradients \
\[PartialD]\:2c7cs\:1d62 = 0 (j \[NotEqual] i).\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<  Then: C_{ij} = 0 for i \[NotEqual] j\>\"", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<        C_{ii} = (1/2)(\[PartialD]\:1d62s\:1d62)\
\[ScriptL]\:1d62\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<  So H \[Minus] C has off-diagonal = H_{ij} and diagonal \
(H\[Minus]C)_{ii} = H_{ii} \[Minus] (1/2)(\[PartialD]\:1d62s\:1d62)\[ScriptL]\
\:1d62.\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", "\"\<Step 2: GERSHGORIN TARGET\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<  Define R\:1d62 = \[CapitalSigma]_{j\[NotEqual]i} \
|H_{ij}| (Gershgorin radii of H).\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<  Choose M > max_i(R\:1d62 \[Minus] H_{ii}), so H_{ii} + \
M > R\:1d62 for all i.\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<Step 3a: DIRECTIONS WITH \[ScriptL]\:1d62 \[NotEqual] \
0\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<  Set \[PartialD]\:1d62s\:1d62 = \[Minus]2M/\[ScriptL]\
\:1d62. Then (H\[Minus]C)_{ii} = H_{ii} + M.\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<  The self-derivative \[PartialD]\:1d62s\:1d62 appears \
ONLY in C_{ii} \[LongDash] no other entry is affected.\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<Step 3b: DIRECTIONS WITH \[ScriptL]\:1d62 = 0\>\"", 
   "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<  Pick any k with \[ScriptL]\:2096 \[NotEqual] 0 (exists \
since \[ScriptL] \[NotEqual] 0).\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<  Set \[PartialD]\:2096s\:1d62 = 2M/\[ScriptL]\:2096 \
(using the cross-diagonal Christoffel symbol).\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<  Then C_{ii} = \[Minus](1/2)e^{0}(\[PartialD]\:2096s\
\:1d62)\[ScriptL]\:2096 = \[Minus]M, giving (H\[Minus]C)_{ii} = H_{ii} + M.\>\
\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<  KEY: when \[ScriptL]\:1d62 = 0, the variable \
\[PartialD]\:2096s\:1d62 does NOT affect C_{ik}:\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<    C_{ik} = (1/2)[(\[PartialD]\:2096s\:1d62)\[ScriptL]\
\:1d62 + (\[PartialD]\:1d62s\:2096)\[ScriptL]\:2096] = 0 + 0 = 0\>\"", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<  because \[ScriptL]\:1d62 = 0 kills the first term and \
\[PartialD]\:1d62s\:2096 = 0 (unchanged).\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<  So \[PartialD]\:2096s\:1d62 is a free variable \
affecting ONLY C_{ii}.\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", "\"\<Step 4: GERSHGORIN CONCLUSION\>\"", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<  H \[Minus] C has diagonal entries H_{ii} + M and \
off-diagonal entries H_{ij}.\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<  By Gershgorin, all eigenvalues \[GreaterEqual] \
min_i(H_{ii} + M \[Minus] R\:1d62) > 0.\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<  Therefore H \[Minus] C is positive definite. \
\[EmptySquare]\>\"", "]"}], ";"}]}], "Input",ExpressionUUID->"38193bd1-f11c-\
4bcf-b0bf-5bd634f9f6d1"],

Cell["3.2 Numerical Verification of Proof Construction", "Subsection",ExpressionUUID->"0b734eae-2037-4e90-8a35-1df73136e1ac"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Implement", " ", "the", " ", "Gershgorin", " ", "construction", " ", 
    "for", " ", "arbitrary", " ", "N"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Clear", "[", "\"\<Global`*\>\"", "]"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"gershgorinConstruct", "[", 
      RowBox[{"hMat_", ",", "ellVec_"}], "]"}], ":=", 
     RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "n", ",", "gershR", ",", "mVal", ",", "gradS", ",", "sVals", ",", 
         "corrMat", ",", "hmcMat", ",", "i", ",", "j", ",", "k", ",", 
         "nonZeroIdx"}], "}"}], ",", "\[IndentingNewLine]", "  ", 
       RowBox[{
        RowBox[{"n", "=", 
         RowBox[{"Length", "[", "hMat", "]"}]}], ";", "\[IndentingNewLine]", 
        "  ", "\[IndentingNewLine]", "  ", 
        RowBox[{"(*", " ", 
         RowBox[{"Gershgorin", " ", "radii"}], " ", "*)"}], 
        "\[IndentingNewLine]", "  ", 
        RowBox[{"gershR", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Total", "[", 
             RowBox[{"Abs", "[", 
              RowBox[{"hMat", "[", 
               RowBox[{"[", "i", "]"}], "]"}], "]"}], "]"}], "-", 
            RowBox[{"Abs", "[", 
             RowBox[{"hMat", "[", 
              RowBox[{"[", 
               RowBox[{"i", ",", "i"}], "]"}], "]"}], "]"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "n"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", "  ", "\[IndentingNewLine]", "  ", 
        RowBox[{"(*", " ", 
         RowBox[{"Choose", " ", "M"}], " ", "*)"}], "\[IndentingNewLine]", 
        "  ", 
        RowBox[{"mVal", "=", 
         RowBox[{
          RowBox[{"Max", "[", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"gershR", "[", 
               RowBox[{"[", "i", "]"}], "]"}], "-", 
              RowBox[{"hMat", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", "i"}], "]"}], "]"}]}], ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", "n"}], "}"}]}], "]"}], "]"}], "+", "1"}]}], ";",
         "\[IndentingNewLine]", "  ", "\[IndentingNewLine]", "  ", 
        RowBox[{"(*", " ", 
         RowBox[{
          RowBox[{"Initialize", " ", 
           RowBox[{"gradients", ":", " ", 
            RowBox[{"gradS", "[", 
             RowBox[{"[", 
              RowBox[{"i", ",", "j"}], "]"}], "]"}]}]}], " ", "=", " ", 
          RowBox[{
           RowBox[{"\[PartialD]", "_j"}], " ", "s_i"}]}], " ", "*)"}], 
        "\[IndentingNewLine]", "  ", 
        RowBox[{"gradS", "=", 
         RowBox[{"ConstantArray", "[", 
          RowBox[{"0.", ",", 
           RowBox[{"{", 
            RowBox[{"n", ",", "n"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", "  ", 
        RowBox[{"sVals", "=", 
         RowBox[{"ConstantArray", "[", 
          RowBox[{"0.", ",", "n"}], "]"}]}], ";", "\[IndentingNewLine]", "  ",
         "\[IndentingNewLine]", "  ", 
        RowBox[{"(*", " ", 
         RowBox[{
         "Find", " ", "a", " ", "nonzero", " ", "gradient", " ", 
          "component"}], " ", "*)"}], "\[IndentingNewLine]", "  ", 
        RowBox[{"nonZeroIdx", "=", 
         RowBox[{
          RowBox[{"FirstPosition", "[", 
           RowBox[{
            RowBox[{"Abs", "[", "ellVec", "]"}], ",", 
            RowBox[{"_", "?", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"#", ">", 
                RowBox[{"10", "^", 
                 RowBox[{"-", "10"}]}]}], " ", "&"}], ")"}]}]}], "]"}], "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", "  ", 
        "\[IndentingNewLine]", "  ", 
        RowBox[{"Do", "[", "\[IndentingNewLine]", "    ", 
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Abs", "[", 
              RowBox[{"ellVec", "[", 
               RowBox[{"[", "i", "]"}], "]"}], "]"}], ">", 
             RowBox[{"10", "^", 
              RowBox[{"-", "10"}]}]}], ",", "\[IndentingNewLine]", "      ", 
            RowBox[{"(*", " ", 
             RowBox[{
              RowBox[{"\[ScriptL]_i", " ", "\[NotEqual]", " ", "0"}], ":", 
              " ", 
              RowBox[{
               RowBox[{"use", " ", "self"}], "-", "derivative"}]}], " ", 
             "*)"}], "\[IndentingNewLine]", "      ", 
            RowBox[{
             RowBox[{"gradS", "[", 
              RowBox[{"[", 
               RowBox[{"i", ",", "i"}], "]"}], "]"}], "=", 
             RowBox[{
              RowBox[{"-", "2"}], " ", 
              RowBox[{"mVal", "/", 
               RowBox[{"ellVec", "[", 
                RowBox[{"[", "i", "]"}], "]"}]}]}]}], ",", 
            "\[IndentingNewLine]", "      ", 
            RowBox[{"(*", " ", 
             RowBox[{"\[ScriptL]_i", " ", "=", " ", 
              RowBox[{"0", ":", " ", 
               RowBox[{
                RowBox[{"use", " ", "cross"}], "-", 
                RowBox[{"derivative", " ", "from", " ", "nonZeroIdx"}]}]}]}], 
             " ", "*)"}], "\[IndentingNewLine]", "      ", 
            RowBox[{
             RowBox[{"gradS", "[", 
              RowBox[{"[", 
               RowBox[{"i", ",", "nonZeroIdx"}], "]"}], "]"}], "=", 
             RowBox[{"2", " ", 
              RowBox[{"mVal", "/", 
               RowBox[{"ellVec", "[", 
                RowBox[{"[", "nonZeroIdx", "]"}], "]"}]}]}]}]}], 
           "\[IndentingNewLine]", "    ", "]"}], ",", "\[IndentingNewLine]", 
          "    ", 
          RowBox[{"{", 
           RowBox[{"i", ",", "n"}], "}"}]}], "\[IndentingNewLine]", "  ", 
         "]"}], ";", "\[IndentingNewLine]", "  ", "\[IndentingNewLine]", "  ", 
        RowBox[{"(*", " ", 
         RowBox[{"Build", " ", "correction", " ", "matrix"}], " ", "*)"}], 
        "\[IndentingNewLine]", "  ", 
        RowBox[{"corrMat", "=", 
         RowBox[{"ConstantArray", "[", 
          RowBox[{"0.", ",", 
           RowBox[{"{", 
            RowBox[{"n", ",", "n"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", "  ", 
        RowBox[{"Do", "[", "\[IndentingNewLine]", "    ", 
         RowBox[{"(*", " ", "Diagonal", " ", "*)"}], "\[IndentingNewLine]", 
         "    ", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"corrMat", "[", 
             RowBox[{"[", 
              RowBox[{"i", ",", "i"}], "]"}], "]"}], "=", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{"1", "/", "2"}], ")"}], "*", 
              RowBox[{"gradS", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", "i"}], "]"}], "]"}], "*", 
              RowBox[{"ellVec", "[", 
               RowBox[{"[", "i", "]"}], "]"}]}], "-", "\[IndentingNewLine]", 
             "      ", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"1", "/", "2"}], ")"}], "*", 
              RowBox[{"Sum", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"Exp", "[", 
                  RowBox[{
                   RowBox[{"sVals", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "-", 
                   RowBox[{"sVals", "[", 
                    RowBox[{"[", "k", "]"}], "]"}]}], "]"}], "*", 
                 RowBox[{"gradS", "[", 
                  RowBox[{"[", 
                   RowBox[{"i", ",", "k"}], "]"}], "]"}], "*", 
                 RowBox[{"ellVec", "[", 
                  RowBox[{"[", "k", "]"}], "]"}]}], ",", 
                "\[IndentingNewLine]", "        ", 
                RowBox[{"{", 
                 RowBox[{"k", ",", 
                  RowBox[{"DeleteCases", "[", 
                   RowBox[{
                    RowBox[{"Range", "[", "n", "]"}], ",", "i"}], "]"}]}], 
                 "}"}]}], "]"}]}]}]}], ";", "\[IndentingNewLine]", "    ", 
           RowBox[{"(*", " ", 
            RowBox[{"Off", "-", "diagonal"}], " ", "*)"}], 
           "\[IndentingNewLine]", "    ", 
           RowBox[{"Do", "[", "\[IndentingNewLine]", "      ", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"corrMat", "[", 
                RowBox[{"[", 
                 RowBox[{"i", ",", "j"}], "]"}], "]"}], "=", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"1", "/", "2"}], ")"}], "*", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"gradS", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", ",", "j"}], "]"}], "]"}], "*", 
                   RowBox[{"ellVec", "[", 
                    RowBox[{"[", "i", "]"}], "]"}]}], "+", 
                  RowBox[{
                   RowBox[{"gradS", "[", 
                    RowBox[{"[", 
                    RowBox[{"j", ",", "i"}], "]"}], "]"}], "*", 
                   RowBox[{"ellVec", "[", 
                    RowBox[{"[", "j", "]"}], "]"}]}]}], ")"}]}]}], ";", 
              "\[IndentingNewLine]", "      ", 
              RowBox[{
               RowBox[{"corrMat", "[", 
                RowBox[{"[", 
                 RowBox[{"j", ",", "i"}], "]"}], "]"}], "=", 
               RowBox[{"corrMat", "[", 
                RowBox[{"[", 
                 RowBox[{"i", ",", "j"}], "]"}], "]"}]}]}], ",", 
             "\[IndentingNewLine]", "      ", 
             RowBox[{"{", 
              RowBox[{"j", ",", 
               RowBox[{"i", "+", "1"}], ",", "n"}], "}"}]}], 
            "\[IndentingNewLine]", "    ", "]"}]}], ",", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"{", 
           RowBox[{"i", ",", "n"}], "}"}]}], "\[IndentingNewLine]", "  ", 
         "]"}], ";", "\[IndentingNewLine]", "  ", "\[IndentingNewLine]", "  ", 
        RowBox[{"hmcMat", "=", 
         RowBox[{"hMat", "-", "corrMat"}]}], ";", "\[IndentingNewLine]", "  ",
         "\[IndentingNewLine]", "  ", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<M\>\"", "->", "mVal"}], ",", 
          RowBox[{"\"\<C\>\"", "->", "corrMat"}], ",", 
          RowBox[{"\"\<HminusC\>\"", "->", "hmcMat"}], ",", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"\"\<eigenvalues\>\"", "->", 
           RowBox[{"Sort", "[", 
            RowBox[{"Eigenvalues", "[", "hmcMat", "]"}], "]"}]}], ",", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"\"\<posdef\>\"", "->", 
           RowBox[{"Positive", "[", 
            RowBox[{"Min", "[", 
             RowBox[{"Eigenvalues", "[", "hmcMat", "]"}], "]"}], "]"}]}], ",",
           "\[IndentingNewLine]", "    ", 
          RowBox[{"\"\<gradS\>\"", "->", "gradS"}], ",", 
          RowBox[{"\"\<budget\>\"", "->", 
           RowBox[{"Norm", "[", 
            RowBox[{"Flatten", "[", "gradS", "]"}], "]"}]}]}], "|>"}]}]}], 
      "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
