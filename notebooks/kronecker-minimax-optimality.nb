Notebook[{
Cell["IMO-150: Kronecker Minimax Optimality Theorem", "Title",ExpressionUUID->"5c1bf498-9b94-43e5-be75-652dbdd8bdbc"],

Cell[TextData[{
 "Companion to ",
 Cell[BoxData[Cell["notes/kronecker-minimax-optimality.md",
   Background->None,ExpressionUUID->"d18b95a8-93f0-4256-ac9d-dd3ab1e9cc0c"]], 
  "InlineCode",ExpressionUUID->"44c4be09-abb3-464b-a1d6-b4044f07c248"],
 ". Extends IMO-84 (diagonal minimax theorem) to Kronecker-factored \
preconditioners.",
 StyleBox["Theorem.",
  FontWeight->Bold],
 " Let ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["H", "TI"], "\[LongEqual]", 
         StyleBox["A", "TI"], "\[CircleTimes]", 
         StyleBox["B", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "H = A \\otimes B", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "dab809d6-470e-4a0d-903d-8b3af4c22163"],
 " with ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["A", "TI"], ",", 
         StyleBox["B", "TI"], "\[Succeeds]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "A, B \\succ 0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "60614f1c-a453-4689-aa86-658c7ad010de"],
 ". Among Kronecker-factored preconditioners ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["M", "TI"], "\[LongEqual]", 
         StyleBox["P", "TI"], "\[CircleTimes]", 
         StyleBox["Q", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "M = P \\otimes Q", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "49aad038-109d-4818-9bbc-392eebab3d09"],
 " ($P, Q$ SPD), the minimax convergence rate is achieved uniquely by ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["P", "TI"], "*"], "\[Proportional]", 
         StyleBox["A", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "P^* \\propto A", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "7cbe8362-63a3-475c-a5ee-6a3324325fa1"],
 ", ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["Q", "TI"], "*"], "\[Proportional]", 
         StyleBox["B", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "Q^* \\propto B", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f3cab528-f878-4d1e-b494-975be77b650c"],
 ", giving ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Kappa]", 
         RowBox[{"(", 
           RowBox[{
             SuperscriptBox[
              StyleBox["M", "TI"], "-1"], 
             StyleBox["H", "TI"]}], ")"}], "\[LongEqual]", "1"}], 
       TraditionalForm], "errors" -> {}, "input" -> "\\kappa(M^{-1}H) = 1", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "82ae3c4d-173f-4119-8f11-e1af40ecc766"],
 " (one-step convergence on the quadratic). "
}], "Text",ExpressionUUID->"db163e22-53d7-4dfc-b6b0-65e9603a53bd"],

Cell["Part I: Symbolic Proof", "Section",ExpressionUUID->"1b3d7d36-ce63-44f4-846c-5f51e490b025"],

Cell["Step 1: Eigenvalue factorization of Kronecker products", "Subsection",ExpressionUUID->"3d74f6a6-2dad-4e51-b1aa-7e7d9ccd4529"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["M", "TI"], "-1"], 
         StyleBox["H", "TI"], "\[LongEqual]", 
         SuperscriptBox[
          RowBox[{"(", 
            RowBox[{
              StyleBox["P", "TI"], "\[CircleTimes]", 
              StyleBox["Q", "TI"]}], ")"}], "-1"], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["A", "TI"], "\[CircleTimes]", 
             StyleBox["B", "TI"]}], ")"}], "\[LongEqual]", 
         RowBox[{"(", 
           RowBox[{
             SuperscriptBox[
              StyleBox["P", "TI"], "-1"], 
             StyleBox["A", "TI"]}], ")"}], "\[CircleTimes]", 
         RowBox[{"(", 
           RowBox[{
             SuperscriptBox[
              StyleBox["Q", "TI"], "-1"], 
             StyleBox["B", "TI"]}], ")"}]}], TraditionalForm], "errors" -> {},
      "input" -> 
     "M^{-1}H = (P \\otimes Q)^{-1}(A \\otimes B) = (P^{-1}A) \\otimes \
(Q^{-1}B)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "3c29e92f-deb3-4f7e-89e2-fb485739ac0a"],
 "The eigenvalues of a Kronecker product are all pairwise products of the \
factor eigenvalues. "
}], "Text",ExpressionUUID->"8d30c2e0-8ec2-4313-81ee-873f30d58e6a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Symbolic", " ", 
    RowBox[{"verification", ":", " ", 
     RowBox[{
     "product", " ", "of", " ", "all", " ", "preconditioned", " ", 
      "eigenvalues"}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Clear", "[", 
     RowBox[{"lam1", ",", "lam2", ",", "mu1", ",", "mu2", ",", "alpha"}], 
     "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"prods", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"alpha", " ", "lam1", " ", "mu1"}], ",", 
       RowBox[{"alpha", " ", "lam1", " ", "mu2"}], ",", 
       RowBox[{"alpha", " ", "lam2", " ", "mu1"}], ",", 
       RowBox[{"alpha", " ", "lam2", " ", "mu2"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"prodAll", "=", 
    RowBox[{
     RowBox[{"Times", " ", "@@", " ", "prods"}], " ", "//", " ", 
     "Simplify"}]}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"=", " ", 
      RowBox[{
       RowBox[{"alpha", "^", "4"}], " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"lam1", " ", "lam2"}], ")"}], "^", "2"}], " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"mu1", " ", "mu2"}], ")"}], "^", "2"}]}]}], " ", "\[LongDash]",
      " ", 
     RowBox[{"constant", " ", "under", " ", "det", " ", "normalization"}]}], 
    " ", "*)"}]}]}]], "Input",ExpressionUUID->"630d5046-8fe9-4042-aab2-\
b356bdeecc82"],

Cell["Step 2: Product constraint from determinant normalization", "Subsection",ExpressionUUID->"4e7d90af-71a0-41b7-9df9-410c8d48760d"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         UnderscriptBox["\[Product]", 
          RowBox[{
            StyleBox["i", "TI"], ",", 
            StyleBox["j", "TI"]}], LimitsPositioning -> True], 
         SubscriptBox[
          StyleBox["p", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"]}]], "\[LongEqual]", 
         SuperscriptBox["\[Alpha]", 
          RowBox[{
            StyleBox["m", "TI"], 
            StyleBox["n", "TI"]}]], "\[CenterDot]", "det", 
         SuperscriptBox[
          RowBox[{"(", 
            StyleBox["A", "TI"], ")"}], 
          StyleBox["n", "TI"]], "\[CenterDot]", "det", 
         SuperscriptBox[
          RowBox[{"(", 
            StyleBox["B", "TI"], ")"}], 
          StyleBox["m", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\prod_{i,j} p_{ij} = \\alpha^{mn} \\cdot \\det(A)^n \\cdot \\det(B)^m",
      "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b0060279-7a39-4477-9b96-d4ca6bc47fe6"],
 " (constant, independent of $P, Q$)"
}], "Text",ExpressionUUID->"690005f2-656c-4201-8b2f-ce417d961fe3"],

Cell[TextData[{
 "This follows from ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"det", 
         RowBox[{"(", 
           RowBox[{
             SuperscriptBox[
              StyleBox["P", "TI"], "-1"], 
             StyleBox["A", "TI"]}], ")"}], "\[LongEqual]", "det", 
         RowBox[{"(", 
           StyleBox["A", "TI"], ")"}], "/", "det", 
         RowBox[{"(", 
           StyleBox["P", "TI"], ")"}]}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\det(P^{-1}A) = \\det(A)/\\det(P)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "6b3cd959-48c6-4818-9330-48316fb12405"],
 ", ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"det", 
         RowBox[{"(", 
           RowBox[{
             SuperscriptBox[
              StyleBox["Q", "TI"], "-1"], 
             StyleBox["B", "TI"]}], ")"}], "\[LongEqual]", "det", 
         RowBox[{"(", 
           StyleBox["B", "TI"], ")"}], "/", "det", 
         RowBox[{"(", 
           StyleBox["Q", "TI"], ")"}]}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\det(Q^{-1}B) = \\det(B)/\\det(Q)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "96c89211-0d49-4ccb-b180-bd85541e0f23"],
 ", and the volume constraint ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"det", 
         SuperscriptBox[
          RowBox[{"(", 
            StyleBox["P", "TI"], ")"}], 
          StyleBox["n", "TI"]], "\[CenterDot]", "det", 
         SuperscriptBox[
          RowBox[{"(", 
            StyleBox["Q", "TI"], ")"}], 
          StyleBox["m", "TI"]], "\[LongEqual]", "1"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\det(P)^n \\cdot \\det(Q)^m = 1", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "877f9331-d1dc-4e69-a80e-30fb31aaa43a"],
 ". "
}], "Text",ExpressionUUID->"e5ca575d-6b30-437c-944c-9b3c023b6a60"],

Cell["Step 3: Minimax equalization (IMO-84 argument)", "Subsection",ExpressionUUID->"3a43327d-288c-498a-8eab-5c727e83d00f"],

Cell[TextData[{
 "We minimize ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         UnderscriptBox["max", 
          RowBox[{
            StyleBox["i", "TI"], ",", 
            StyleBox["j", "TI"]}], LimitsPositioning -> True], "|1", "-", 
         SubscriptBox[
          StyleBox["p", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"]}]], "|"}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\max_{i,j} |1 - p_{ij}|", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "2e405331-eddf-42f7-a1b5-c91d1eab2642"],
 " subject to ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Product]", 
         SubscriptBox[
          StyleBox["p", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"]}]], "\[LongEqual]", 
         StyleBox["C", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\prod p_{ij} = C", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ec437362-3cf7-46c5-b1c8-73dd0094dbfb"],
 " (constant). By the IMO-84 argument (strict log-convexity of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"|1", "-", 
         SuperscriptBox[
          StyleBox["e", "TI"], 
          StyleBox["x", "TI"]], "|"}], TraditionalForm], "errors" -> {}, 
     "input" -> "|1 - e^x|", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "070b7411-4cab-4e11-b383-bda801dea151"],
 "), the unique optimum is ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["p", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"]}]], "\[LongEqual]", 
         SuperscriptBox[
          StyleBox["C", "TI"], 
          RowBox[{"1", "/", 
            RowBox[{"(", 
              RowBox[{
                StyleBox["m", "TI"], 
                StyleBox["n", "TI"]}], ")"}]}]]}], TraditionalForm], 
     "errors" -> {}, "input" -> "p_{ij} = C^{1/(mn)}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "895b0f73-4c49-4521-b5b5-f35c09e61e4d"],
 " for all $(i,j)$. "
}], "Text",ExpressionUUID->"d8c165f4-2338-4e03-b0bb-8e24921e556a"],

Cell["Step 4: Rank-1 factorization lemma", "Subsection",ExpressionUUID->"d1e4b517-51d9-4813-8ea2-77d167d44aaa"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Lambda]", 
          StyleBox["i", "TI"]], "\[CenterDot]", 
         SubscriptBox["\[Mu]", 
          StyleBox["j", "TI"]], "\[LongEqual]", 
         StyleBox["c", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\lambda_i \\cdot \\mu_j = c", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "993067db-e1c4-4759-b898-43ac3fefd96b"],
 " for all $(i,j)$ with ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Lambda]", 
          StyleBox["i", "TI"]], ",", 
         SubscriptBox["\[Mu]", 
          StyleBox["j", "TI"]], ">", "0"}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\lambda_i, \\mu_j > 0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d6b20b08-9529-46dc-ad4c-df4e54820e5c"],
 " forces all ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["\[Lambda]", 
        StyleBox["i", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\lambda_i", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "477ea202-ba00-4437-ae55-e8849780e120"],
 " equal and all ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["\[Mu]", 
        StyleBox["j", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\mu_j", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "10da4828-48d0-4af6-8344-6c44b61bae60"],
 " equal. "
}], "Text",ExpressionUUID->"3e09eac8-20ca-4de2-90db-2e36c52f69bf"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Symbolic", ":", " ", 
     RowBox[{"solve", " ", "lambda_i", " ", "*", " ", "mu_j"}]}], " ", "=", 
    " ", 
    RowBox[{"c", " ", "for", " ", "all", " ", "pairs"}]}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Clear", "[", 
     RowBox[{"lam1", ",", "lam2", ",", "mu1", ",", "mu2", ",", "c"}], "]"}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{"sol", "=", 
    RowBox[{"Solve", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"lam1", " ", "mu1"}], "==", "c"}], ",", 
        RowBox[{
         RowBox[{"lam1", " ", "mu2"}], "==", "c"}], ",", 
        RowBox[{
         RowBox[{"lam2", " ", "mu1"}], "==", "c"}], ",", 
        RowBox[{
         RowBox[{"lam2", " ", "mu2"}], "==", "c"}], ",", 
        "\[IndentingNewLine]", "             ", 
        RowBox[{"lam1", ">", "0"}], ",", 
        RowBox[{"lam2", ">", "0"}], ",", 
        RowBox[{"mu1", ">", "0"}], ",", 
        RowBox[{"mu2", ">", "0"}], ",", 
        RowBox[{"c", ">", "0"}]}], "}"}], ",", "\[IndentingNewLine]", 
      "            ", 
      RowBox[{"{", 
       RowBox[{"lam1", ",", "lam2", ",", "mu1", ",", "mu2"}], "}"}]}], 
     "]"}]}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"Solution", ":", " ", "lam1"}], " ", "=", " ", "lam2"}], ",", 
     " ", 
     RowBox[{"mu1", " ", "=", " ", 
      RowBox[{"mu2", " ", 
       RowBox[{"(", 
        RowBox[{"all", " ", "equal", " ", "within", " ", "each", " ", "set"}],
         ")"}]}]}]}], " ", "*)"}]}]}]], "Input",ExpressionUUID->"03172fba-\
d9f8-430f-b965-8dad46fae03a"],

Cell["Step 5: Conclusion", "Subsection",ExpressionUUID->"c66709a1-4e27-477a-be82-f6d6c3f2d241"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["P", "TI"], "-1"], 
         StyleBox["A", "TI"], "\[LongEqual]", "\[Lambda]", 
         StyleBox["I", "TI"], "\[DoubleLongRightArrow]", 
         StyleBox["P", "TI"], "\[LongEqual]", 
         StyleBox["A", "TI"], "/", "\[Lambda]", "\[Proportional]", 
         StyleBox["A", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "P^{-1}A = \\lambda I \\implies P = A/\\lambda \\propto A", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d01648a2-baa9-4f9e-99ef-30c1a57d468f"],
 ". Similarly ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["Q", "TI"], "\[Proportional]", 
         StyleBox["B", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "Q \\propto B", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b0841102-457b-4784-9ad7-2661305a9229"],
 "."
}], "Text",ExpressionUUID->"5396f3a2-65da-4032-aa9d-3256e2006f37"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox["\[Alpha]", "*"], "\[LongEqual]", "1", "/", 
         RowBox[{"(", "\[Lambda]\[Mu]", ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\alpha^* = 1/(\\lambda\\mu)", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b294dd1e-af3a-4e70-a864-c51cf6ed4d8c"],
 ": all contraction factors ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[LongEqual]", "0"}], TraditionalForm], "errors" -> {}, 
     "input" -> "= 0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "59266beb-2926-4246-8417-16fed70b00ec"],
 ". One-step convergence. ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> InterpretationBox["", 
       Failure[
       "TeXAssistantError", <|
        "MessageTemplate" -> "Errors: `Errors`", 
         "MessageParameters" -> <|"Errors" -> {}|>, "Input" -> "\\square"|>]],
      "errors" -> {}, "input" -> "\\square", "state" -> "Error"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "00e65b31-0b56-4bb9-820a-a834c8e20a71"]
}], "Text",ExpressionUUID->"0d4e5b1e-4a2b-45db-97d1-1c865bb22584"],

Cell["Part II: Numerical Verification", "Section",ExpressionUUID->"d7d6431f-35f2-4e17-962a-1bd0a50e9904"],

Cell["Test 1: 2\[Times]2 \[CircleTimes] 2\[Times]2", "Subsection",ExpressionUUID->"7669d170-060e-4b19-bc2d-8cae9cfff3fd"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"randomSPD", "[", "n_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"x", "=", 
        RowBox[{"RandomReal", "[", 
         RowBox[{
          RowBox[{"NormalDistribution", "[", "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"n", ",", "n"}], "}"}]}], "]"}]}], "}"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"x", " ", ".", " ", 
        RowBox[{"Transpose", "[", "x", "]"}]}], "+", 
       RowBox[{"IdentityMatrix", "[", "n", "]"}]}]}], "\[IndentingNewLine]", 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SeedRandom", "[", "42", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"m", "=", "2"}], ";", " ", 
  RowBox[{"n", "=", "2"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"amat", "=", 
   RowBox[{"randomSPD", "[", "m", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"bmat", "=", 
   RowBox[{"randomSPD", "[", "n", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"hmat", "=", 
    RowBox[{"KroneckerProduct", "[", 
     RowBox[{"amat", ",", "bmat"}], "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<A = \>\"", ",", 
    RowBox[{"MatrixForm", "[", 
     RowBox[{"amat", " ", "//", " ", 
      RowBox[{
       RowBox[{"Round", "[", 
        RowBox[{"#", ",", "0.001"}], "]"}], " ", "&"}]}], "]"}]}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<B = \>\"", ",", 
    RowBox[{"MatrixForm", "[", 
     RowBox[{"bmat", " ", "//", " ", 
      RowBox[{
       RowBox[{"Round", "[", 
        RowBox[{"#", ",", "0.001"}], "]"}], " ", "&"}]}], "]"}]}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Eigenvalues of H: \>\"", ",", 
    RowBox[{
     RowBox[{"Sort", "[", 
      RowBox[{
       RowBox[{"Eigenvalues", "[", "hmat", "]"}], " ", "//", " ", "N"}], 
      "]"}], " ", "//", " ", 
     RowBox[{
      RowBox[{"Round", "[", 
       RowBox[{"#", ",", "0.001"}], "]"}], " ", "&"}]}]}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Print", "[", 
    RowBox[{"\"\<Condition number \[Kappa](H): \>\"", ",", 
     RowBox[{
      RowBox[{
       RowBox[{"Max", "[", 
        RowBox[{"Eigenvalues", "[", "hmat", "]"}], "]"}], "/", 
       RowBox[{"Min", "[", 
        RowBox[{"Eigenvalues", "[", "hmat", "]"}], "]"}]}], " ", "//", " ", 
      "N"}]}], "]"}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Optimal", ":", " ", "P"}], " ", "=", " ", 
     RowBox[{
      RowBox[{"A", "/", "det"}], 
      RowBox[{
       RowBox[{"(", "A", ")"}], "^", 
       RowBox[{"(", 
        RowBox[{"1", "/", "m"}], ")"}]}]}]}], ",", " ", 
    RowBox[{"Q", " ", "=", " ", 
     RowBox[{
      RowBox[{"B", "/", "det"}], 
      RowBox[{
       RowBox[{"(", "B", ")"}], "^", 
       RowBox[{"(", 
        RowBox[{"1", "/", "n"}], ")"}]}]}]}]}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"aScale", "=", 
   RowBox[{
    RowBox[{"Det", "[", "amat", "]"}], "^", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "1"}], "/", "m"}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"bScale", "=", 
   RowBox[{
    RowBox[{"Det", "[", "bmat", "]"}], "^", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "1"}], "/", "n"}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"pOpt", "=", 
   RowBox[{"aScale", " ", "amat"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"qOpt", "=", 
   RowBox[{"bScale", " ", "bmat"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"mOpt", "=", 
   RowBox[{"KroneckerProduct", "[", 
    RowBox[{"pOpt", ",", "qOpt"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
