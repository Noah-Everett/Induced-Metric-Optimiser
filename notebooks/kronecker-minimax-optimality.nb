            "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
          "5a394c30-1c98-44d2-bc06-79c6122c0a78"], "\<\"1.0\"\>", "\<\"\
\[Checkmark]\"\>"},
        {"\<\"4\"\>", "\<\"3\[Times]3 \[CircleTimes] 3\[Times]3\"\>", "\<\"\
\[LongDash]\"\>", "\<\"Optimal vs 1000 random\"\>", "\<\"\[Checkmark]\"\>"},
        {"\<\"5\"\>", "\<\"2\[Times]2 \[CircleTimes] 2\[Times]2\"\>", \
"\<\"14.9\"\>", "\<\"NMinimize confirms P\[Proportional]A, \
Q\[Proportional]B\"\>", "\<\"\[Checkmark]\"\>"}
       },
       GridBoxAlignment->{
        "Columns" -> {Center, Center, Center, Center, {Center}}, 
         "Rows" -> {{Baseline}}},
       GridBoxDividers->{
        "Columns" -> {{False}}, "Rows" -> {False, True, {False}, False}},
       GridBoxSpacings->{"Columns" -> {
           Offset[0.27999999999999997`], {
            Offset[2.0999999999999996`]}, 
           Offset[0.27999999999999997`]}, "Rows" -> {
           Offset[0.2], {
            Offset[0.4]}, 
           Offset[0.2]}}],
      {None, OutputFormsDump`HeadedColumns}],
     Function[BoxForm`e$, 
