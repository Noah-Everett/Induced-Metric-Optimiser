Cell["Test 4: Optimality \[LongDash] 1000 random Kronecker preconditioners", \
"Subsection",ExpressionUUID->"ad87641a-6bd1-440f-8e20-f82d3bea6a98"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "999", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"m4", "=", "3"}], ";", " ", 
  RowBox[{"n4", "=", "3"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"amat4", "=", 
   RowBox[{"randomSPD", "[", "m4", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"bmat4", "=", 
   RowBox[{"randomSPD", "[", "n4", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"hmat4", "=", 
    RowBox[{"KroneckerProduct", "[", 
     RowBox[{"amat4", ",", "bmat4"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"minimaxRate", "[", "precondEigs_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"eigs", "=", 
         RowBox[{"Re", "[", "precondEigs", "]"}]}], ",", "eMax", ",", 
        "eMin"}], "}"}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"eMax", "=", 
        RowBox[{"Max", "[", "eigs", "]"}]}], ";", " ", 
       RowBox[{"eMin", "=", 
        RowBox[{"Min", "[", "eigs", "]"}]}], ";", "\[IndentingNewLine]", "  ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"eMax", "-", "eMin"}], ")"}], "/", 
        RowBox[{"(", 
         RowBox[{"eMax", "+", "eMin"}], ")"}]}]}]}], "\[IndentingNewLine]", 
     "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", "Optimal", " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"pOpt4", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"Det", "[", "amat4", "]"}], "^", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "1"}], "/", "m4"}], ")"}]}], " ", "amat4"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"qOpt4", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"Det", "[", "bmat4", "]"}], "^", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "1"}], "/", "n4"}], ")"}]}], " ", "bmat4"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"mOpt4", "=", 
   RowBox[{"KroneckerProduct", "[", 
    RowBox[{"pOpt4", ",", "qOpt4"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"eigsOpt", "=", 
   RowBox[{"Re", "[", 
    RowBox[{
     RowBox[{"Eigenvalues", "[", 
      RowBox[{
       RowBox[{"Inverse", "[", "mOpt4", "]"}], " ", ".", " ", "hmat4"}], 
      "]"}], " ", "//", " ", "N"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"rateOpt", "=", 
    RowBox[{"minimaxRate", "[", "eigsOpt", "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"1000", " ", "random", " ", "trials"}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"nTrials", "=", "1000"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"rates", "=", 
    RowBox[{"Table", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"p", "=", 
           RowBox[{"randomSPD", "[", "m4", "]"}]}], ",", 
          RowBox[{"q", "=", 
           RowBox[{"randomSPD", "[", "n4", "]"}]}], ",", "mRand", ",", 
          "eigsRand"}], "}"}], ",", "\[IndentingNewLine]", "    ", 
        RowBox[{
         RowBox[{"p", "=", 
          RowBox[{
           RowBox[{
            RowBox[{"Det", "[", "p", "]"}], "^", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"-", "1"}], "/", "m4"}], ")"}]}], " ", "p"}]}], ";", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"q", "=", 
          RowBox[{
           RowBox[{
            RowBox[{"Det", "[", "q", "]"}], "^", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"-", "1"}], "/", "n4"}], ")"}]}], " ", "q"}]}], ";", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"mRand", "=", 
          RowBox[{"KroneckerProduct", "[", 
           RowBox[{"p", ",", "q"}], "]"}]}], ";", "\[IndentingNewLine]", 
         "    ", 
         RowBox[{"eigsRand", "=", 
          RowBox[{"Re", "[", 
           RowBox[{
            RowBox[{"Eigenvalues", "[", 
             RowBox[{
              RowBox[{"Inverse", "[", "mRand", "]"}], " ", ".", " ", 
              "hmat4"}], "]"}], " ", "//", " ", "N"}], "]"}]}], ";", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"minimaxRate", "[", "eigsRand", "]"}]}]}], 
       "\[IndentingNewLine]", "  ", "]"}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"{", "nTrials", "}"}]}], "\[IndentingNewLine]", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Optimal rate (P \[Proportional] A, Q \[Proportional] B): \>\"",
     ",", "rateOpt"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Best random rate (1000 trials): \>\"", ",", 
    RowBox[{"Min", "[", "rates", "]"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Mean random rate: \>\"", ",", 
    RowBox[{
     RowBox[{"Mean", "[", "rates", "]"}], " ", "//", " ", "N"}]}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Optimal strictly better than all 1000? \>\"", ",", 
    RowBox[{"rateOpt", "<", 
     RowBox[{"Min", "[", "rates", "]"}]}]}], "]"}], ";"}]}], "Input",Expressio\
nUUID->"0c674c65-19c2-4832-9b4a-36f39ad9020c"],

