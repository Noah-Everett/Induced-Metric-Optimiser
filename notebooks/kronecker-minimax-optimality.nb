                  RowBox[{"\[Kappa]", "(", 
                    StyleBox["H", "TI"], ")"}], TraditionalForm], 
                "errors" -> {}, "input" -> "\\kappa(H)", "state" -> "Boxes"|>,
                "TeXAssistantTemplate"], TraditionalForm]]]], 
          RawBoxes[
           Cell[
            BoxData[
             FormBox[
              TemplateBox[<|"boxes" -> FormBox[
                  RowBox[{"\[Kappa]", "(", 
