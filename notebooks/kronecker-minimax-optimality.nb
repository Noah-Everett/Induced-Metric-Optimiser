Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "42", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"aTest", "=", 
   RowBox[{"randomSPD", "[", "2", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"bTest", "=", 
   RowBox[{"randomSPD", "[", "2", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"hTest", "=", 
    RowBox[{"KroneckerProduct", "[", 
     RowBox[{"aTest", ",", "bTest"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"condObj", "[", 
     RowBox[{
      RowBox[{"p11_", "?", "NumericQ"}], ",", 
      RowBox[{"p12_", "?", "NumericQ"}], ",", 
      RowBox[{"p22_", "?", "NumericQ"}], ",", "\[IndentingNewLine]", 
      "        ", 
      RowBox[{"q11_", "?", "NumericQ"}], ",", 
      RowBox[{"q12_", "?", "NumericQ"}], ",", 
      RowBox[{"q22_", "?", "NumericQ"}]}], "]"}], ":=", "\[IndentingNewLine]",
     "  ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"pMat", ",", "qMat", ",", "mMat", ",", "eigs"}], "}"}], ",", 
      "\[IndentingNewLine]", "    ", 
      RowBox[{
       RowBox[{"pMat", "=", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"p11", ",", "p12"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"p12", ",", "p22"}], "}"}]}], "}"}]}], ";", 
       "\[IndentingNewLine]", "    ", 
       RowBox[{"qMat", "=", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"q11", ",", "q12"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"q12", ",", "q22"}], "}"}]}], "}"}]}], ";", 
       "\[IndentingNewLine]", "    ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"Det", "[", "pMat", "]"}], "<=", "0.001"}], "||", 
          RowBox[{
           RowBox[{"Det", "[", "qMat", "]"}], "<=", "0.001"}], "||", 
          RowBox[{"p11", "<=", "0"}], "||", 
          RowBox[{"q11", "<=", "0"}]}], ",", 
         RowBox[{"Return", "[", 
          RowBox[{"10", "^", "10"}], "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", "    ", 
       RowBox[{"mMat", "=", 
        RowBox[{"KroneckerProduct", "[", 
         RowBox[{"pMat", ",", "qMat"}], "]"}]}], ";", "\[IndentingNewLine]", 
       "    ", 
       RowBox[{"eigs", "=", 
        RowBox[{"Re", "[", 
         RowBox[{
          RowBox[{"Eigenvalues", "[", 
           RowBox[{
            RowBox[{"Inverse", "[", "mMat", "]"}], " ", ".", " ", "hTest"}], 
           "]"}], " ", "//", " ", "N"}], "]"}]}], ";", "\[IndentingNewLine]", 
       "    ", 
       RowBox[{
        RowBox[{"Max", "[", "eigs", "]"}], "/", 
        RowBox[{"Min", "[", "eigs", "]"}]}]}]}], "\[IndentingNewLine]", "  ", 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"result", "=", 
    RowBox[{"NMinimize", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"condObj", "[", 
         RowBox[{
         "p11", ",", "p12", ",", "p22", ",", "q11", ",", "q12", ",", "q22"}], 
         "]"}], ",", "\[IndentingNewLine]", "   ", 
        RowBox[{"p11", ">", "0.1"}], ",", 
        RowBox[{"p22", ">", "0.1"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"p11", " ", "p22"}], "-", 
          RowBox[{"p12", "^", "2"}]}], ">", "0.01"}], ",", 
        "\[IndentingNewLine]", "   ", 
        RowBox[{"q11", ">", "0.1"}], ",", 
        RowBox[{"q22", ">", "0.1"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"q11", " ", "q22"}], "-", 
          RowBox[{"q12", "^", "2"}]}], ">", "0.01"}]}], "}"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"p11", ",", "0.5", ",", "5"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"p12", ",", 
          RowBox[{"-", "2"}], ",", "2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"p22", ",", "0.5", ",", "5"}], "}"}], ",", 
        "\[IndentingNewLine]", "   ", 
        RowBox[{"{", 
         RowBox[{"q11", ",", "0.5", ",", "5"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"q12", ",", 
          RowBox[{"-", "2"}], ",", "2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"q22", ",", "0.5", ",", "5"}], "}"}]}], "}"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"Method", "->", "\"\<DifferentialEvolution\>\""}], ",", 
      RowBox[{"MaxIterations", "->", "1000"}]}], "\[IndentingNewLine]", 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"pFound", "=", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"p11", ",", "p12"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"p12", ",", "p22"}], "}"}]}], "}"}], " ", "/.", " ", 
    RowBox[{"result", "[", 
     RowBox[{"[", "2", "]"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"qFound", "=", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"q11", ",", "q12"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"q12", ",", "q22"}], "}"}]}], "}"}], " ", "/.", " ", 
     RowBox[{"result", "[", 
      RowBox[{"[", "2", "]"}], "]"}]}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<NMinimize \[Kappa]: \>\"", ",", 
    RowBox[{"result", "[", 
     RowBox[{"[", "1", "]"}], "]"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<||P/||P|| - A/||A||||_F = \>\"", ",", "\[IndentingNewLine]", 
    "  ", 
    RowBox[{"Norm", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"pFound", "/", 
        RowBox[{"Norm", "[", 
         RowBox[{"pFound", ",", "\"\<Frobenius\>\""}], "]"}]}], "-", 
       RowBox[{"aTest", "/", 
        RowBox[{"Norm", "[", 
         RowBox[{"aTest", ",", "\"\<Frobenius\>\""}], "]"}]}]}], 
      ",", "\"\<Frobenius\>\""}], "]"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<||Q/||Q|| - B/||B||||_F = \>\"", ",", "\[IndentingNewLine]", 
    "  ", 
    RowBox[{"Norm", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"qFound", "/", 
        RowBox[{"Norm", "[", 
         RowBox[{"qFound", ",", "\"\<Frobenius\>\""}], "]"}]}], "-", 
       RowBox[{"bTest", "/", 
        RowBox[{"Norm", "[", 
         RowBox[{"bTest", ",", "\"\<Frobenius\>\""}], "]"}]}]}], 
      ",", "\"\<Frobenius\>\""}], "]"}]}], "]"}], ";"}]}], "Input",ExpressionU\
UID->"cc9bf38a-eece-408a-9a29-906667bb5ec5"],

Cell[TextData[{
 "NMinimize finds ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Kappa]", "\[LongEqual]", "1"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\kappa = 1", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "61c922b2-d0d0-4177-bedb-e6c9988858a6"],
 " with ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["P", "TI"], "\[Proportional]", 
         StyleBox["A", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "P \\propto A", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "9919b83b-992c-43a0-b40f-db0bb02d60b6"],
 ", ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["Q", "TI"], "\[Proportional]", 
         StyleBox["B", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "Q \\propto B", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f4c741ff-bd76-4633-88da-c9dd13d6baec"],
 " to ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox["10", "-10"], TraditionalForm], "errors" -> {}, "input" -> 
     "10^{-10}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a53c675e-d227-4db9-a5a9-0fe7f3abf602"],
 " precision. "
}], "Text",ExpressionUUID->"cde4b9d0-a818-4540-afe6-b7b6cbce88e0"],

Cell["Part III: One-Step Convergence Verification", "Section",ExpressionUUID->"c779d75b-fc35-4fed-8dcf-a2e5be4fbe00"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Using", " ", "the", " ", "3", "\[Times]", 
    RowBox[{"3", " ", "\[CircleTimes]", " ", "4"}], "\[Times]", "4", " ", 
    "test", " ", "case"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"alphaOptimal", "=", 
     RowBox[{"1", "/", 
      RowBox[{"Mean", "[", "precondEigs2", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"contractions", "=", 
     RowBox[{"Abs", "[", 
      RowBox[{"1", "-", 
       RowBox[{"alphaOptimal", " ", "precondEigs2"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Optimal \[Alpha] = \>\"", ",", 
      RowBox[{"alphaOptimal", " ", "//", " ", "N"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Max |1 - \[Alpha]\[CenterDot]eig|: \>\"", ",", 
      RowBox[{"Max", "[", "contractions", "]"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<One-step convergence? \>\"", ",", 
      RowBox[{
       RowBox[{"Max", "[", "contractions", "]"}], "<", 
       RowBox[{"10", "^", 
        RowBox[{"-", "10"}]}]}]}], "]"}], ";"}]}]}]], "Input",ExpressionUUID->\
"fb77c4c2-71cf-4c7d-a3b3-dde0848f0e89"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox["\[Alpha]", "*"], "\[LongEqual]", "1", "/", 
         RowBox[{"(", "\[Lambda]\[Mu]", ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\alpha^* = 1/(\\lambda\\mu)", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "aa4b1570-5813-4023-8bf1-480f355fba27"],
 ", all contraction factors are ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"<", 
         SuperscriptBox["10", "-15"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "< 10^{-15}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "543cad7f-ff4d-4396-9896-1e5017998631"],
 ". One-step convergence confirmed. "
}], "Text",ExpressionUUID->"59d0cc78-ae7c-4107-ba16-e6378cf1c645"],

Cell["Part IV: KFAC Corollary", "Section",ExpressionUUID->"101e1eb6-b613-480e-bad1-da247f2289ed"],

Cell[TextData[{
 StyleBox["Corollary.",
  FontWeight->Bold],
 " For the GN Hessian ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["H", "TI"], "\[LongEqual]", 
         SubscriptBox["\[CapitalSigma]", 
          StyleBox["G", "TI"]], "\[CircleTimes]", 
         SubscriptBox["\[CapitalSigma]", 
          StyleBox["x", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "H = \\Sigma_G \\otimes \\Sigma_x", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "1b09f750-c096-4fdd-b54c-a7dc34aff0c3"],
 " of a dense layer, the minimax-optimal Kronecker preconditioner is ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["M", "TI"], "*"], "\[LongEqual]", 
         SubscriptBox["\[CapitalSigma]", 
          StyleBox["G", "TI"]], "\[CircleTimes]", 
         SubscriptBox["\[CapitalSigma]", 
          StyleBox["x", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "M^* = \\Sigma_G \\otimes \\Sigma_x", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "9e1d201a-6630-4408-b9ad-d05920b9178b"],
 " (i.e., KFAC). This gives a first-principles derivation of KFAC from \
minimax optimality, independent of the Fisher information approximation in \
the original KFAC paper (Martens & Grosse, 2015). "
}], "Text",ExpressionUUID->"934a7167-29aa-4f74-adeb-da16bc9cdcd2"],

Cell["Summary", "Section",ExpressionUUID->"4e1e6c7e-8c40-4779-b1c6-cb08e0b9d6ee"],

Cell[BoxData[
 PaneBox[
  PaneBox[
   StyleBox[
    TagBox[
     TagBox[GridBox[{
        {
         TagBox["\<\"Test\"\>",
          HoldForm], 
         TagBox["\<\"Dimensions\"\>",
          HoldForm], 
         TagBox[Cell[BoxData[
           FormBox[
            TemplateBox[<|"boxes" -> FormBox[
                RowBox[{"\[Kappa]", "(", 
                  StyleBox["H", "TI"], ")"}], TraditionalForm], 
              "errors" -> {}, "input" -> "\\kappa(H)", "state" -> "Boxes"|>,
             "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
           "eb7c86ca-8583-4cb3-9366-89ce4cb717b4"],
          HoldForm], 
         TagBox[Cell[BoxData[
           FormBox[
            TemplateBox[<|"boxes" -> FormBox[
                RowBox[{"\[Kappa]", "(", 
                  RowBox[{
                    SuperscriptBox[
                    StyleBox["M", "TI"], 
                    RowBox[{"*", "-", "1"}]], 
                    StyleBox["H", "TI"]}], ")"}], TraditionalForm], 
              "errors" -> {}, "input" -> "\\kappa(M^{*-1}H)", "state" -> 
              "Boxes"|>,
             "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
           "a452e1cd-fb8d-43e1-b5df-ef8cd84b3f4f"],
          HoldForm], 
         TagBox["\<\"Verified\"\>",
          HoldForm]},
        {"\<\"1\"\>", "\<\"2\[Times]2 \[CircleTimes] 2\[Times]2\"\>", \
"\<\"14.9\"\>", "\<\"1.0\"\>", "\<\"\[Checkmark]\"\>"},
        {"\<\"2\"\>", "\<\"3\[Times]3 \[CircleTimes] 4\[Times]4\"\>", \
"\<\"82.6\"\>", "\<\"1.0\"\>", "\<\"\[Checkmark]\"\>"},
        {"\<\"3\"\>", "\<\"5\[Times]5 \[CircleTimes] 3\[Times]3\"\>", Cell[
         BoxData[
          FormBox[
           TemplateBox[<|"boxes" -> FormBox[
               RowBox[{"2.5", "\[Cross]", 
                 SuperscriptBox["10", "7"]}], TraditionalForm], 
             "errors" -> {}, "input" -> "2.5 \\times 10^7", "state" -> 
