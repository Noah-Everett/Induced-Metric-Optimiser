    RowBox[{"precondEigs", " ", "//", " ", 
     RowBox[{
      RowBox[{"Round", "[", 
       RowBox[{"#", ",", "0.0001"}], "]"}], " ", "&"}]}]}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<All equal? Max deviation: \>\"", ",", 
    RowBox[{
     RowBox[{"Max", "[", "precondEigs", "]"}], "-", 
     RowBox[{"Min", "[", "precondEigs", "]"}]}]}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Preconditioned \[Kappa]: \>\"", ",", 
    RowBox[{
     RowBox[{"Max", "[", "precondEigs", "]"}], "/", 
     RowBox[{"Min", "[", "precondEigs", "]"}]}]}], "]"}], ";"}]}], "Input",Exp\
ressionUUID->"312ce03c-754b-4b78-87d0-6c8d6fa4747d"],

