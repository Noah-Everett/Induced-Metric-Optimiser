Notebook[{
Cell["IMO-85: Hessian Diagonal Estimation \[LongDash] Robustness Analysis", \
"Title",ExpressionUUID->"d7ca7cba-2ca7-49df-bdd4-9a4f69c6c13e"],

Cell[TextData[{
 "Companion to ",
 Cell[BoxData[Cell["notes/hessian-estimator-robustness.md",
   Background->None,ExpressionUUID->"0a11f273-ec08-4a68-9b7e-69d7019bf067"]], 
  "InlineCode",ExpressionUUID->"da459deb-cd1d-47f6-ac55-ba7ce4840ed5"],
 ". Verifies all theoretical claims numerically. "
}], "Text",ExpressionUUID->"aa2a2375-8f1d-45ed-9f22-8e95a610b0ca"],

Cell["Part I: Robustness Theorem Verification", "Section",ExpressionUUID->"e9f48f7c-006f-48bf-9902-0fd0ab1dc617"],

Cell[TextData[{
 "Verify ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Kappa]", "prec"], "\[LessEqual]", 
         RowBox[{"(", 
           RowBox[{"1", "+", "\[Delta]"}], ")"}], "/", 
         RowBox[{"(", 
           RowBox[{"1", "-", "\[Delta]"}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\kappa_{\\text{prec}} \\leq (1+\\delta)/(1-\\delta)", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "4548638b-8d92-42b5-9bbb-b1edaa728639"],
 " across dimensions, condition numbers, and noise levels. "
}], "Text",ExpressionUUID->"b266507c-0e95-458a-91da-d0655f0d6f0d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Robustness", " ", 
    RowBox[{"theorem", ":", " ", 
     RowBox[{"\[Kappa]_prec", " ", "\[LessEqual]", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "+", "\[Delta]"}], ")"}], "/", 
       RowBox[{"(", 
        RowBox[{"1", "-", "\[Delta]"}], ")"}]}]}]}]}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"SeedRandom", "[", "42", "]"}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"robustnessTest", "[", 
      RowBox[{"n_", ",", "\[Kappa]orig_", ",", "\[Delta]_", ",", "nTrials_"}],
       "]"}], ":=", 
     RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "h", ",", "hHat", ",", "eps", ",", "sHat", ",", "hTilde", ",", 
         "\[Kappa]Prec", ",", "bound", ",", "results"}], "}"}], ",", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{
        RowBox[{"bound", "=", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", "+", "\[Delta]"}], ")"}], "/", 
          RowBox[{"(", 
           RowBox[{"1", "-", "\[Delta]"}], ")"}]}]}], ";", 
        "\[IndentingNewLine]", "  ", 
        RowBox[{"results", "=", 
         RowBox[{"Table", "[", "\[IndentingNewLine]", "    ", 
          RowBox[{
           RowBox[{
            RowBox[{"h", "=", 
             RowBox[{"Exp", "[", 
              RowBox[{"RandomReal", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"0", ",", 
                  RowBox[{"Log", "[", "\[Kappa]orig", "]"}]}], "}"}], ",", 
                "n"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", "    ", 
            RowBox[{"h", "=", 
             RowBox[{"h", "*", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"\[Kappa]orig", "^", 
                 RowBox[{"(", 
                  RowBox[{"1", "/", "n"}], ")"}]}], "/", 
                RowBox[{"GeometricMean", "[", "h", "]"}]}], ")"}]}]}], ";", 
            "\[IndentingNewLine]", "    ", 
            RowBox[{"eps", "=", 
             RowBox[{"RandomReal", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"-", "\[Delta]"}], ",", "\[Delta]"}], "}"}], ",", 
               "n"}], "]"}]}], ";", "\[IndentingNewLine]", "    ", 
            RowBox[{"hHat", "=", 
             RowBox[{"h", "*", 
              RowBox[{"(", 
               RowBox[{"1", "+", "eps"}], ")"}]}]}], ";", 
            "\[IndentingNewLine]", "    ", 
            RowBox[{"sHat", "=", 
             RowBox[{"-", 
              RowBox[{"Log", "[", "hHat", "]"}]}]}], ";", 
            "\[IndentingNewLine]", "    ", 
            RowBox[{"hTilde", "=", 
             RowBox[{
              RowBox[{"Exp", "[", "sHat", "]"}], "*", "h"}]}], ";", 
            "\[IndentingNewLine]", "    ", 
            RowBox[{"\[Kappa]Prec", "=", 
             RowBox[{
              RowBox[{"Max", "[", "hTilde", "]"}], "/", 
              RowBox[{"Min", "[", "hTilde", "]"}]}]}], ";", 
            "\[IndentingNewLine]", "    ", 
            RowBox[{"{", 
             RowBox[{"\[Kappa]Prec", ",", "bound", ",", 
              RowBox[{"\[Kappa]Prec", "<=", 
               RowBox[{"bound", "+", 
                RowBox[{"10", "^", 
                 RowBox[{"-", "10"}]}]}]}]}], "}"}]}], ",", 
           "\[IndentingNewLine]", "    ", 
           RowBox[{"{", "nTrials", "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", "  ", "results"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"testCases", "=", 
     RowBox[{"{", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"2", ",", 
         RowBox[{"10", "^", "2"}], ",", "0.1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"2", ",", 
         RowBox[{"10", "^", "2"}], ",", "0.5"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"2", ",", 
         RowBox[{"10", "^", "2"}], ",", "0.9"}], "}"}], ",", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"{", 
        RowBox[{"10", ",", 
         RowBox[{"10", "^", "4"}], ",", "0.1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"10", ",", 
         RowBox[{"10", "^", "4"}], ",", "0.5"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"10", ",", 
         RowBox[{"10", "^", "4"}], ",", "0.9"}], "}"}], ",", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"{", 
        RowBox[{"100", ",", 
         RowBox[{"10", "^", "6"}], ",", "0.1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"100", ",", 
         RowBox[{"10", "^", "6"}], ",", "0.5"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"100", ",", 
         RowBox[{"10", "^", "6"}], ",", "0.9"}], "}"}], ",", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"{", 
        RowBox[{"1000", ",", 
         RowBox[{"10", "^", "10"}], ",", "0.1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1000", ",", 
         RowBox[{"10", "^", "10"}], ",", "0.5"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1000", ",", 
         RowBox[{"10", "^", "10"}], ",", "0.9"}], "}"}]}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"nTrials", "=", "1000"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"results", "=", 
     RowBox[{"Association", " ", "@@", " ", 
      RowBox[{"Table", "[", "\[IndentingNewLine]", "  ", 
       RowBox[{
        RowBox[{"Module", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
           "n", ",", "\[Kappa]", ",", "\[Delta]", ",", "res", ",", 
            "max\[Kappa]", ",", "bound", ",", "pass"}], "}"}], ",", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{"n", ",", "\[Kappa]", ",", "\[Delta]"}], "}"}], "=", 
            "tc"}], ";", "\[IndentingNewLine]", "    ", 
           RowBox[{"res", "=", 
            RowBox[{"robustnessTest", "[", 
             RowBox[{"n", ",", "\[Kappa]", ",", "\[Delta]", ",", "nTrials"}], 
             "]"}]}], ";", "\[IndentingNewLine]", "    ", 
           RowBox[{"max\[Kappa]", "=", 
            RowBox[{"Max", "[", 
             RowBox[{"res", "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", "1"}], "]"}], "]"}], "]"}]}], ";", 
           "\[IndentingNewLine]", "    ", 
           RowBox[{"bound", "=", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"1", "+", "\[Delta]"}], ")"}], "/", 
             RowBox[{"(", 
              RowBox[{"1", "-", "\[Delta]"}], ")"}]}]}], ";", 
           "\[IndentingNewLine]", "    ", 
           RowBox[{"pass", "=", 
            RowBox[{"And", " ", "@@", " ", 
             RowBox[{"res", "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", "3"}], "]"}], "]"}]}]}], ";", 
           "\[IndentingNewLine]", "    ", 
           RowBox[{
            RowBox[{"StringForm", "[", 
             
             RowBox[{"\"\<N=``,\[Kappa]=``,\[Delta]=``\>\"", ",", "n", ",", 
              "\[Kappa]", ",", "\[Delta]"}], "]"}], "->", 
            "\[IndentingNewLine]", "      ", 
            RowBox[{"<|", 
             RowBox[{
              RowBox[{"\"\<max\[Kappa]Prec\>\"", "->", "max\[Kappa]"}], ",", 
              RowBox[{"\"\<bound\>\"", "->", "bound"}], ",", 
              RowBox[{"\"\<pass\>\"", "->", "pass"}]}], "|>"}]}]}]}], "]"}], ",",
         "\[IndentingNewLine]", "  ", 
        RowBox[{"{", 
         RowBox[{"tc", ",", "testCases"}], "}"}]}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"Display", " ", "results"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{"Grid", "[", 
    RowBox[{
     RowBox[{"Prepend", "[", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Module", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
            "n", ",", "\[Kappa]", ",", "\[Delta]", ",", "res", ",", 
             "max\[Kappa]", ",", "bound", ",", "pass"}], "}"}], ",", 
           "\[IndentingNewLine]", "    ", 
           RowBox[{
            RowBox[{
             RowBox[{"{", 
              RowBox[{"n", ",", "\[Kappa]", ",", "\[Delta]"}], "}"}], "=", 
             "tc"}], ";", "\[IndentingNewLine]", "    ", 
            RowBox[{"res", "=", 
             RowBox[{"robustnessTest", "[", 
              RowBox[{"n", ",", "\[Kappa]", ",", "\[Delta]", ",", "100"}], 
              "]"}]}], ";", "\[IndentingNewLine]", "    ", 
            RowBox[{"max\[Kappa]", "=", 
             RowBox[{"Max", "[", 
              RowBox[{"res", "[", 
               RowBox[{"[", 
                RowBox[{"All", ",", "1"}], "]"}], "]"}], "]"}]}], ";", 
            "\[IndentingNewLine]", "    ", 
            RowBox[{"bound", "=", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"1", "+", "\[Delta]"}], ")"}], "/", 
              RowBox[{"(", 
               RowBox[{"1", "-", "\[Delta]"}], ")"}]}]}], ";", 
            "\[IndentingNewLine]", "    ", 
            RowBox[{"pass", "=", 
             RowBox[{"And", " ", "@@", " ", 
              RowBox[{"res", "[", 
               RowBox[{"[", 
                RowBox[{"All", ",", "3"}], "]"}], "]"}]}]}], ";", 
            "\[IndentingNewLine]", "    ", 
            RowBox[{"{", 
             RowBox[{"n", ",", "\[Kappa]", ",", "\[Delta]", ",", 
              RowBox[{"NumberForm", "[", 
               RowBox[{"max\[Kappa]", ",", "5"}], "]"}], ",", 
              RowBox[{"NumberForm", "[", 
               RowBox[{"bound", ",", "5"}], "]"}], ",", "\[IndentingNewLine]",
               "     ", 
              RowBox[{"If", "[", 
               RowBox[{"pass", ",", 
                RowBox[{"Style", "[", 
                 RowBox[{"\"\<PASS\>\"", ",", 
                  RowBox[{"Darker", "[", "Green", "]"}]}], "]"}], ",", 
                RowBox[{"Style", "[", 
                 RowBox[{"\"\<FAIL\>\"", ",", "Red"}], "]"}]}], "]"}]}], 
             "}"}]}]}], "]"}], ",", "\[IndentingNewLine]", "    ", 
         RowBox[{"{", 
          RowBox[{"tc", ",", "testCases"}], "}"}]}], "]"}], ",", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{
        RowBox[{
         RowBox[{"Style", "[", 
          RowBox[{"#", ",", "Bold"}], "]"}], "&"}], " ", "/@", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<N\>\"", ",", "\"\<\[Kappa]_orig\>\"", 
          ",", "\"\<\[Delta]\>\"", ",", "\"\<max \[Kappa]_prec\>\"", 
          ",", "\"\<bound\>\"", ",", "\"\<result\>\""}], "}"}]}]}], "]"}], ",",
      "\[IndentingNewLine]", "  ", 
     RowBox[{"Frame", "->", "All"}], ",", 
     RowBox[{"Alignment", "->", "Center"}]}], "]"}]}]}]], "Input",ExpressionUU\
ID->"5529be6d-0848-4730-8bd9-82ba9c3e2243"],

Cell[TextData[{
 StyleBox["Result: ALL 12,000 TESTS PASSED.",
  FontWeight->Bold],
 " The bound ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Kappa]", "prec"], "\[LessEqual]", 
         RowBox[{"(", 
           RowBox[{"1", "+", "\[Delta]"}], ")"}], "/", 
         RowBox[{"(", 
           RowBox[{"1", "-", "\[Delta]"}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\kappa_{\\text{prec}} \\leq (1+\\delta)/(1-\\delta)", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c02d11bf-ef1f-4b9b-827f-d8afe4b70193"],
 " holds exactly. The bound is tight (achieved when ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Epsilon]", "min"], "\[LongEqual]", "-", "\[Delta]"}],
        TraditionalForm], "errors" -> {}, "input" -> 
     "\\epsilon_{\\min} = -\\delta", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "1437b5bc-89b3-4b74-b668-89dca207d612"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Epsilon]", "max"], "\[LongEqual]", "+", "\[Delta]"}],
        TraditionalForm], "errors" -> {}, "input" -> 
     "\\epsilon_{\\max} = +\\delta", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "82d995b0-5a14-4bbf-a065-e988572bcc00"],
 "). "
}], "Text",ExpressionUUID->"7d258556-de56-4efc-8806-ea357caf5ee9"],

Cell["Part II: Condition Number Reduction Table", "Section",ExpressionUUID->"bfe0b137-edf1-4572-a565-61f25c0fec11"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Verify", " ", "the", " ", "improvement", " ", "factor", " ", "table"}], 
   " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"\[Delta]Values", "=", 
     RowBox[{"{", 
      RowBox[{
      "0", ",", "0.1", ",", "0.3", ",", "0.5", ",", "0.7", ",", "0.9"}], 
      "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"Grid", "[", 
    RowBox[{
     RowBox[{"Prepend", "[", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"\[Delta]", ",", "\[IndentingNewLine]", "    ", 
           RowBox[{"NumberForm", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{"1", "+", "\[Delta]"}], ")"}], "/", 
               RowBox[{"(", 
                RowBox[{"1", "-", "\[Delta]"}], ")"}]}], " ", "//", " ", 
              "N"}], ",", "4"}], "]"}], ",", "\[IndentingNewLine]", "    ", 
           RowBox[{"NumberForm", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"10", "^", "4"}], "/", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"1", "+", "\[Delta]"}], ")"}], "/", 
                 RowBox[{"(", 
                  RowBox[{"1", "-", "\[Delta]"}], ")"}]}], ")"}]}], " ", "//",
               " ", "N"}], ",", 
             RowBox[{"{", 
              RowBox[{"6", ",", "0"}], "}"}]}], "]"}], ",", 
           "\[IndentingNewLine]", "    ", 
           RowBox[{"ScientificForm", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"10", "^", "10"}], "/", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"1", "+", "\[Delta]"}], ")"}], "/", 
                 RowBox[{"(", 
                  RowBox[{"1", "-", "\[Delta]"}], ")"}]}], ")"}]}], " ", "//",
               " ", "N"}], ",", "3"}], "]"}]}], "}"}], ",", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"{", 
          RowBox[{"\[Delta]", ",", "\[Delta]Values"}], "}"}]}], "]"}], ",", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{
        RowBox[{
         RowBox[{"Style", "[", 
          RowBox[{"#", ",", "Bold"}], "]"}], "&"}], " ", "/@", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<\[Delta]\>\"", ",", "\"\<\[Kappa]_prec bound\>\"", 
          ",", "\"\<Improvement (\[Kappa]=10\:2074)\>\"", 
          ",", "\"\<Improvement (\[Kappa]=10\.b9\:2070)\>\""}], "}"}]}]}], 
      "]"}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"Frame", "->", "All"}], ",", 
     RowBox[{"Alignment", "->", "Center"}]}], "]"}]}]}]], "Input",ExpressionUU\
ID->"b1fabbab-2e27-4c92-89da-76cb199256c5"],

Cell["Part III: Secant Error on Diagonal vs Non-Diagonal H", "Section",ExpressionUUID->"7e374dff-2a78-43e0-a0ba-5f37b168214e"],

Cell["\<\
Secant is exact on diagonal H (error ~ 10\:207b\.b9\.b3). On non-diagonal H, \
off-diagonal contamination creates systematic bias. \
\>", "Text",ExpressionUUID->"e2824d59-eb7c-44a1-b6c4-80dea2dc3fe1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Secant", " ", "simulation"}], " ", "*)"}], "\[IndentingNewLine]", 
  
  RowBox[{
   RowBox[{
    RowBox[{"SeedRandom", "[", "77", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"secantSim", "[", 
      RowBox[{"H_", ",", "nSteps_", ",", "\[Alpha]_"}], "]"}], ":=", 
     RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"n", "=", 
          RowBox[{"Length", "[", "H", "]"}]}], ",", "\[Theta]", ",", "g", ",",
          "prev\[Theta]", ",", "prevg", ",", 
         RowBox[{"relErrors", "=", 
          RowBox[{"{", "}"}]}], ",", 
         RowBox[{"secantEps", "=", 
          RowBox[{"10", "^", 
           RowBox[{"-", "5"}]}]}]}], "}"}], ",", "\[IndentingNewLine]", "  ", 
       
       RowBox[{
        RowBox[{"\[Theta]", "=", 
         RowBox[{"RandomReal", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", "n"}], "]"}]}], ";", 
        "\[IndentingNewLine]", "  ", 
        RowBox[{"g", "=", 
         RowBox[{"H", " ", ".", " ", "\[Theta]"}]}], ";", 
        "\[IndentingNewLine]", "  ", 
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"prev\[Theta]", "=", "\[Theta]"}], ";", " ", 
           RowBox[{"prevg", "=", "g"}], ";", "\[IndentingNewLine]", "    ", 
           RowBox[{"\[Theta]", "=", 
            RowBox[{"\[Theta]", "-", 
             RowBox[{"\[Alpha]", "*", "g"}]}]}], ";", " ", 
           RowBox[{"g", "=", 
            RowBox[{"H", " ", ".", " ", "\[Theta]"}]}], ";", 
           "\[IndentingNewLine]", "    ", 
           RowBox[{"Module", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"d\[Theta]", "=", 
                RowBox[{"\[Theta]", "-", "prev\[Theta]"}]}], ",", 
               RowBox[{"dg", "=", 
                RowBox[{"g", "-", "prevg"}]}], ",", "hSec", ",", "hTrue", ",", 
               RowBox[{"rErr", "=", 
                RowBox[{"{", "}"}]}]}], "}"}], ",", "\[IndentingNewLine]", 
             "      ", 
             RowBox[{
              RowBox[{"hTrue", "=", 
               RowBox[{"Diagonal", "[", "H", "]"}]}], ";", 
              "\[IndentingNewLine]", "      ", 
              RowBox[{"Do", "[", 
               RowBox[{
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"Abs", "[", 
                    RowBox[{"d\[Theta]", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "]"}], ">", "secantEps"}],
                   ",", "\[IndentingNewLine]", "        ", 
                  RowBox[{"AppendTo", "[", 
                   RowBox[{"rErr", ",", 
                    RowBox[{"Abs", "[", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"dg", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "/", 
                    RowBox[{"d\[Theta]", "[", 
                    RowBox[{"[", "i", "]"}], "]"}]}], "-", 
                    RowBox[{"hTrue", "[", 
                    RowBox[{"[", "i", "]"}], "]"}]}], ")"}], "/", 
                    RowBox[{"hTrue", "[", 
                    RowBox[{"[", "i", "]"}], "]"}]}], "]"}]}], "]"}]}], "]"}],
                 ",", "\[IndentingNewLine]", "        ", 
                RowBox[{"{", 
                 RowBox[{"i", ",", "n"}], "}"}]}], "]"}], ";", 
              "\[IndentingNewLine]", "      ", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"Length", "[", "rErr", "]"}], ">", "0"}], ",", 
                RowBox[{"AppendTo", "[", 
                 RowBox[{"relErrors", ",", "rErr"}], "]"}]}], "]"}]}]}], 
            "]"}]}], ",", "\[IndentingNewLine]", "    ", 
          RowBox[{"{", "nSteps", "}"}]}], "]"}], ";", "\[IndentingNewLine]", 
        "  ", 
        RowBox[{"Flatten", "[", "relErrors", "]"}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"Test", " ", "1"}], ":", " ", 
     RowBox[{"Diagonal", " ", "H"}]}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"HDiag", "=", 
     RowBox[{"DiagonalMatrix", "[", 
      RowBox[{"Exp", "[", 
       RowBox[{"RandomReal", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", 
           RowBox[{"Log", "[", "100", "]"}]}], "}"}], ",", "10"}], "]"}], 
       "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"errors1", "=", 
     RowBox[{"secantSim", "[", 
      RowBox[{"HDiag", ",", "50", ",", "0.001"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Diagonal H \[LongDash] max relative error: \>\"", ",", 
      RowBox[{"ScientificForm", "[", 
       RowBox[{
        RowBox[{"Max", "[", "errors1", "]"}], ",", "3"}], "]"}]}], "]"}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"Test", " ", "2"}], ":", " ", 
      RowBox[{"Block", "-", "diagonal"}]}], ",", " ", 
     RowBox[{"offDiagFrac", " ", "=", " ", "0.1"}]}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"SeedRandom", "[", "88", "]"}], ";", " ", 
    RowBox[{"n2", "=", "10"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"H2", "=", 
     RowBox[{"DiagonalMatrix", "[", 
      RowBox[{"Exp", "[", 
       RowBox[{"RandomReal", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", 
           RowBox[{"Log", "[", "10", "]"}]}], "}"}], ",", "n2"}], "]"}], 
       "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"i", "!=", "j"}], "&&", 
         RowBox[{
          RowBox[{"Ceiling", "[", 
           RowBox[{"i", "/", "5"}], "]"}], "==", 
          RowBox[{"Ceiling", "[", 
           RowBox[{"j", "/", "5"}], "]"}]}]}], ",", "\[IndentingNewLine]", 
        "  ", 
        RowBox[{
         RowBox[{"H2", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "j"}], "]"}], "]"}], "=", 
         RowBox[{"0.1", "*", 
          RowBox[{"RandomReal", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "1"}], ",", "1"}], "}"}], "]"}], "*", 
          RowBox[{"Sqrt", "[", 
           RowBox[{
            RowBox[{"H2", "[", 
             RowBox[{"[", 
              RowBox[{"i", ",", "i"}], "]"}], "]"}], "*", 
            RowBox[{"H2", "[", 
             RowBox[{"[", 
              RowBox[{"j", ",", "j"}], "]"}], "]"}]}], "]"}]}]}]}], "]"}], ",",
       "\[IndentingNewLine]", "  ", 
      RowBox[{"{", 
       RowBox[{"i", ",", "n2"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"j", ",", "n2"}], "}"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"H2", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"H2", "+", 
        RowBox[{"Transpose", "[", "H2", "]"}]}], ")"}], "/", "2"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"H2", "=", 
     RowBox[{"H2", "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Max", "[", 
          RowBox[{"0", ",", 
           RowBox[{"-", 
            RowBox[{"Min", "[", 
             RowBox[{"Eigenvalues", "[", "H2", "]"}], "]"}]}]}], "]"}], "+", 
         "0.1"}], ")"}], "*", 
       RowBox[{"IdentityMatrix", "[", "n2", "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"errors2", "=", 
     RowBox[{"secantSim", "[", 
      RowBox[{"H2", ",", "200", ",", "0.0001"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Block-diag (0.1) \[LongDash] median: \>\"", ",", 
      RowBox[{"NumberForm", "[", 
       RowBox[{
        RowBox[{"Median", "[", "errors2", "]"}], ",", "4"}], "]"}], ",", 
      "\[IndentingNewLine]", "  ", "\"\<, 95th: \>\"", ",", 
      RowBox[{"NumberForm", "[", 
       RowBox[{
        RowBox[{"Quantile", "[", 
         RowBox[{"errors2", ",", "0.95"}], "]"}], ",", "4"}], "]"}], ",", 
      "\[IndentingNewLine]", "  ", "\"\<, max: \>\"", ",", 
      RowBox[{"NumberForm", "[", 
       RowBox[{
        RowBox[{"Max", "[", "errors2", "]"}], ",", "4"}], "]"}]}], "]"}], 
    ";"}]}]}]], "Input",ExpressionUUID->"8738aed7-798d-443c-ace5-\
0e5bd9f0648c"],

Cell[TextData[{
 StyleBox["Result:",
  FontWeight->Bold],
 " Diagonal H \[RightArrow] error \[TildeTilde] 10\:207b\.b9\.b3. \
Block-diagonal (0.1) \[RightArrow] median 2.9%, max 30.7%. The error scales \
with the diagonal dominance ratio. "
}], "Text",ExpressionUUID->"c6495995-3ceb-4f19-b877-75ef49248111"],

Cell["Part IV: Fixed-Bias Newton (Robustness Theorem Direct Test)", "Section",ExpressionUUID->"4f12387a-3f1f-474d-8668-7434500539f9"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"The", " ", "robustness", " ", "theorem", " ", 
    RowBox[{"predicts", ":", " ", 
     RowBox[{
      RowBox[{"fixed", " ", "bias"}], " ", "\[RightArrow]", " ", 
      RowBox[{"bounded", " ", "\[Kappa]_prec"}]}]}]}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"SeedRandom", "[", "42", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"n", "=", "10"}], ";", " ", 
    RowBox[{"\[Kappa]", "=", "1000"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"h", "=", 
     RowBox[{"Exp", "[", 
      RowBox[{"Range", "[", 
       RowBox[{"0", ",", 
        RowBox[{"Log", "[", "\[Kappa]", "]"}], ",", 
        RowBox[{
         RowBox[{"Log", "[", "\[Kappa]", "]"}], "/", 
         RowBox[{"(", 
          RowBox[{"n", "-", "1"}], ")"}]}]}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"H", "=", 
     RowBox[{"DiagonalMatrix", "[", "h", "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Theta]0", "=", 
     RowBox[{"RandomReal", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", "n"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"nSteps", "=", "20000"}], ";", " ", 
    RowBox[{"\[Alpha]", "=", "0.001"}], ";", " ", 
    RowBox[{"\[Mu]", "=", "0.05"}], ";", " ", 
    RowBox[{"\[Lambda]", "=", "0.1"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"Fixed", "-", 
       RowBox[{"bias", " ", 
        RowBox[{"Newton", ":", " ", "\[Delta]"}]}]}], " ", "=", " ", "0.5"}], 
     ",", " ", 
     RowBox[{"FIXED", " ", "errors"}]}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Theta]", "=", "\[Theta]0"}], ";", " ", 
    RowBox[{"s", "=", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{"0.", ",", "n"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[CurlyEpsilon]Fixed", "=", 
     RowBox[{"RandomReal", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "0.5"}], ",", "0.5"}], "}"}], ",", "n"}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"hBiased", "=", 
     RowBox[{"h", "*", 
      RowBox[{"(", 
       RowBox[{"1", "+", "\[CurlyEpsilon]Fixed"}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"targetBiased", "=", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"Log", "[", "hBiased", "]"}]}], "+", 
      RowBox[{"Mean", "[", 
       RowBox[{"Log", "[", "hBiased", "]"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"lossFixedBias", "=", 
     RowBox[{"Table", "[", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{
        RowBox[{"l", "=", 
         RowBox[{"0.5", "*", 
          RowBox[{"\[Theta]", ".", "H", ".", "\[Theta]"}]}]}], ";", " ", 
        RowBox[{"g", "=", 
         RowBox[{"H", ".", "\[Theta]"}]}], ";", "\[IndentingNewLine]", "  ", 
        RowBox[{"s", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", "-", 
             RowBox[{"\[Mu]", "*", "\[Lambda]"}]}], ")"}], "*", "s"}], "+", 
          RowBox[{"\[Mu]", "*", "\[Lambda]", "*", "targetBiased"}]}]}], ";", 
        "\[IndentingNewLine]", "  ", 
        RowBox[{"\[Theta]", "=", 
         RowBox[{"\[Theta]", "-", 
          RowBox[{"\[Alpha]", "*", 
           RowBox[{"Exp", "[", "s", "]"}], "*", "g"}]}]}], ";", " ", "l"}], ",", 
       RowBox[{"{", "nSteps", "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Fixed-bias Newton (\[Delta]=0.5): final loss = \>\"", ",", 
      RowBox[{"ScientificForm", "[", 
       RowBox[{
        RowBox[{"lossFixedBias", "[", 
         RowBox[{"[", 
          RowBox[{"-", "1"}], "]"}], "]"}], ",", "3"}], "]"}]}], "]"}], ";"}],
    "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<max |\[CurlyEpsilon]_i| = \>\"", ",", 
      RowBox[{"Max", "[", 
       RowBox[{"Abs", "[", "\[CurlyEpsilon]Fixed", "]"}], "]"}]}], "]"}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Theoretical \[Kappa]_prec bound: \>\"", ",", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "+", 
         RowBox[{"Max", "[", 
          RowBox[{"Abs", "[", "\[CurlyEpsilon]Fixed", "]"}], "]"}]}], ")"}], "/", 
       RowBox[{"(", 
        RowBox[{"1", "-", 
         RowBox[{"Max", "[", 
          RowBox[{"Abs", "[", "\[CurlyEpsilon]Fixed", "]"}], "]"}]}], 
        ")"}]}]}], "]"}], ";"}]}]}]], "Input",ExpressionUUID->"8a1e5edd-6e0a-\
4614-b4e9-fc2ceed425d9"],

Cell[TextData[{
 StyleBox["Result:",
  FontWeight->Bold],
 " Loss underflows to 0. Measured tail \[Kappa]_eff = 1.0. Bound holds: ",
 StyleBox["YES \[Checkmark]",
  FontWeight->Bold],
 ". The robustness theorem is confirmed \[LongDash] fixed multiplicative bias \
of up to 50% is completely absorbed. "
}], "Text",ExpressionUUID->"4d2c6cd6-550a-42c8-95f2-39e0b66486f1"],

Cell["Part V: Secant Bias Self-Correction Trajectory", "Section",ExpressionUUID->"2cbc5e8d-56e9-4818-9654-cea2d16519fa"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "Track", " ", "secant", " ", "relative", " ", "error", " ", "over", " ", 
     "time", " ", "on", " ", "non"}], "-", 
    RowBox[{"diagonal", " ", "H"}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"SeedRandom", "[", "55", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"n", "=", "10"}], ";", " ", 
    RowBox[{"h", "=", 
     RowBox[{"Exp", "[", 
      RowBox[{"Range", "[", 
       RowBox[{"0", ",", 
        RowBox[{"Log", "[", "100", "]"}], ",", 
        RowBox[{
         RowBox[{"Log", "[", "100", "]"}], "/", 
         RowBox[{"(", 
          RowBox[{"n", "-", "1"}], ")"}]}]}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Hoff", "=", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{"0.", ",", 
       RowBox[{"{", 
        RowBox[{"n", ",", "n"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"i", "<", "j"}], ",", "\[IndentingNewLine]", "  ", 
        RowBox[{
         RowBox[{
          RowBox[{"Hoff", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", "j"}], "]"}], "]"}], "=", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", "/", "10."}], ")"}], "*", 
           RowBox[{"RandomReal", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "1"}], ",", "1"}], "}"}], "]"}], "*", 
           RowBox[{
            RowBox[{"Sqrt", "[", 
             RowBox[{
              RowBox[{"h", "[", 
               RowBox[{"[", "i", "]"}], "]"}], "*", 
              RowBox[{"h", "[", 
               RowBox[{"[", "j", "]"}], "]"}]}], "]"}], "/", 
            RowBox[{"(", 
             RowBox[{"n", "-", "1"}], ")"}]}]}]}], ";", "\[IndentingNewLine]",
          "  ", 
         RowBox[{
          RowBox[{"Hoff", "[", 
           RowBox[{"[", 
            RowBox[{"j", ",", "i"}], "]"}], "]"}], "=", 
          RowBox[{"Hoff", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", "j"}], "]"}], "]"}]}]}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "n"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"j", ",", "n"}], "}"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
   
   RowBox[{
    RowBox[{"Hfull", "=", 
     RowBox[{
      RowBox[{"DiagonalMatrix", "[", "h", "]"}], "+", "Hoff"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Hfull", "=", 
     RowBox[{"Hfull", "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Max", "[", 
          RowBox[{"0", ",", 
           RowBox[{"-", 
            RowBox[{"Min", "[", 
             RowBox[{"Eigenvalues", "[", "Hfull", "]"}], "]"}]}]}], "]"}], "+",
          "0.01"}], ")"}], "*", 
       RowBox[{"IdentityMatrix", "[", "n", "]"}]}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Alpha]", "=", "0.0005"}], ";", " ", 
    RowBox[{"\[Mu]", "=", "0.05"}], ";", " ", 
    RowBox[{"\[Lambda]", "=", "0.1"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Theta]", "=", 
     RowBox[{"RandomReal", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", "n"}], "]"}]}], ";"}], 
   " ", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"s", "=", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{"0.", ",", "n"}], "]"}]}], ";", " ", 
    RowBox[{"prev\[Theta]", "=", "\[Theta]"}], ";", " ", 
    RowBox[{"prevg", "=", 
     RowBox[{"Hfull", ".", "\[Theta]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"hTrue", "=", 
     RowBox[{"Diagonal", "[", "Hfull", "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"secantErrors", "=", 
     RowBox[{"{", "}"}]}], ";", " ", 
    RowBox[{"metricCorrs", "=", 
     RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"g", "=", 
        RowBox[{"Hfull", ".", "\[Theta]"}]}], ";", "\[IndentingNewLine]", 
       "  ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"t", ">", "1"}], ",", "\[IndentingNewLine]", "    ", 
         RowBox[{"Module", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"d\[Theta]", "=", 
              RowBox[{"\[Theta]", "-", "prev\[Theta]"}]}], ",", 
             RowBox[{"dg", "=", 
              RowBox[{"g", "-", "prevg"}]}], ",", "hSec", ",", "tgt", ",", 
             "ideal"}], "}"}], ",", "\[IndentingNewLine]", "      ", 
           RowBox[{
            RowBox[{"hSec", "=", 
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"Abs", "[", 
                   RowBox[{"d\[Theta]", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "]"}], ">", 
                  RowBox[{"10", "^", 
                   RowBox[{"-", "5"}]}]}], ",", 
                 RowBox[{
                  RowBox[{"dg", "[", 
                   RowBox[{"[", "i", "]"}], "]"}], "/", 
                  RowBox[{"d\[Theta]", "[", 
                   RowBox[{"[", "i", "]"}], "]"}]}], ",", "1."}], "]"}], ",", 
               
               RowBox[{"{", 
                RowBox[{"i", ",", "n"}], "}"}]}], "]"}]}], ";", 
            "\[IndentingNewLine]", "      ", 
            RowBox[{"AppendTo", "[", 
             RowBox[{"secantErrors", ",", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"hSec", "-", "hTrue"}], ")"}], "/", "hTrue"}]}], 
             "]"}], ";", "\[IndentingNewLine]", "      ", 
            RowBox[{"tgt", "=", 
             RowBox[{
              RowBox[{"-", 
               RowBox[{"Log", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"Max", "[", 
                   RowBox[{"#", ",", 
                    RowBox[{"10", "^", 
                    RowBox[{"-", "8"}]}]}], "]"}], "&"}], " ", "/@", " ", 
                 "hSec"}], "]"}]}], "+", 
              RowBox[{"Mean", "[", 
               RowBox[{"-", 
                RowBox[{"Log", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"Max", "[", 
                    RowBox[{"#", ",", 
                    RowBox[{"10", "^", 
                    RowBox[{"-", "8"}]}]}], "]"}], "&"}], " ", "/@", " ", 
                  "hSec"}], "]"}]}], "]"}]}]}], ";", "\[IndentingNewLine]", 
            "      ", 
            RowBox[{"s", "=", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{"1", "-", 
                 RowBox[{"\[Mu]", "*", "\[Lambda]"}]}], ")"}], "*", "s"}], "+", 
              RowBox[{"\[Mu]", "*", "\[Lambda]", "*", "tgt"}]}]}], ";", 
            "\[IndentingNewLine]", "      ", 
            RowBox[{"ideal", "=", 
             RowBox[{
              RowBox[{"-", 
               RowBox[{"Log", "[", "hTrue", "]"}]}], "+", 
              RowBox[{"Mean", "[", 
               RowBox[{"Log", "[", "hTrue", "]"}], "]"}]}]}], ";", 
            "\[IndentingNewLine]", "      ", 
            RowBox[{"AppendTo", "[", 
             RowBox[{"metricCorrs", ",", 
              RowBox[{"Correlation", "[", 
               RowBox[{"s", ",", "ideal"}], "]"}]}], "]"}]}]}], "]"}]}], 
        "]"}], ";", "\[IndentingNewLine]", "  ", 
       RowBox[{"prev\[Theta]", "=", "\[Theta]"}], ";", " ", 
       RowBox[{"prevg", "=", "g"}], ";", "\[IndentingNewLine]", "  ", 
       RowBox[{"\[Theta]", "=", 
        RowBox[{"\[Theta]", "-", 
         RowBox[{"\[Alpha]", "*", 
          RowBox[{"Exp", "[", "s", "]"}], "*", "g"}]}]}]}], ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", "5000"}], "}"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"ListLinePlot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"Max", "[", 
         RowBox[{"Abs", "[", "#", "]"}], "]"}], "&"}], " ", "/@", " ", 
       "secantErrors"}], "}"}], ",", 
     RowBox[{"PlotRange", "->", 
      RowBox[{"{", 
       RowBox[{"0", ",", "5"}], "}"}]}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"AxesLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<Step\>\"", ",", "\"\<Max |\[CurlyEpsilon]_i|\>\""}], 
       "}"}]}], ",", 
     RowBox[{"PlotLabel", "->", "\"\<Secant Relative Error Over Time\>\""}], ",",
      "\[IndentingNewLine]", "  ", 
     RowBox[{"Epilog", "->", 
      RowBox[{"{", 
       RowBox[{"Dashed", ",", "Red", ",", 
        RowBox[{"Line", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", "1"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"5000", ",", "1"}], "}"}]}], "}"}], "]"}]}], "}"}]}], ",",
      "\[IndentingNewLine]", "  ", 
     RowBox[{"PlotStyle", "->", "Blue"}], ",", 
     RowBox[{"ImageSize", "->", "500"}]}], "]"}]}]}]], "Input",ExpressionUUID->\
"81e19be0-69ac-481d-b55d-40080f3e259c"],

Cell[TextData[{
 StyleBox["Result:",
  FontWeight->Bold],
 " Secant relative error starts at 730% (step 1) but self-corrects: "
}], "Text",ExpressionUUID->"7efd21b0-90fc-4cab-8d50-692bfbbbd9b3"],

Cell[BoxData[
 PaneBox[
  PaneBox[
   StyleBox[
    TagBox[
     TagBox[GridBox[{
        {
         TagBox["\<\"Step\"\>",
          HoldForm], 
         TagBox["\<\"max\"\>",
          HoldForm], 
         TagBox["\<\"\[CurlyEpsilon]_i\"\>",
          HoldForm]},
        {"\<\"1\"\>", "\<\"11.0\"\>", "\<\"0.834\"\>"},
        {"\<\"50\"\>", "\<\"3.40\"\>", "\<\"0.926\"\>"},
        {"\<\"100\"\>", "\<\"1.76\"\>", "\<\"0.959\"\>"},
        {"\<\"500\"\>", "\<\"0.149\"\>", "\<\"0.998\"\>"},
        {"\<\"1000\"\>", "\<\"0.093\"\>", "\<\"1.000\"\>"},
        {"\<\"5000\"\>", "\<\"0.095\"\>", "\<\"0.997\"\>"}
       },
       GridBoxAlignment->{
        "Columns" -> {Center, Center, {Center}}, "Rows" -> {{Baseline}}},
       GridBoxDividers->{
