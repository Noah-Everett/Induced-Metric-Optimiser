         StyleBox[
          RowBox[{"matches", " ", "perfect"}],
          FontWeight->Bold]},
        {"\<\"Secant (clipped)\"\>", "\<\"2.62 \[Times] \
10\:207b\.b9\.b2\"\>", "\<\"modest 100\[Times]\"\>"}
       },
       GridBoxAlignment->{
        "Columns" -> {Center, Center, {Center}}, "Rows" -> {{Baseline}}},
       GridBoxDividers->{
