Cell[BoxData[
 PaneBox[
  PaneBox[
   StyleBox[
    TagBox[
     TagBox[GridBox[{
        {
         TagBox["\<\"Method\"\>",
          HoldForm], 
         TagBox["\<\"Final loss\"\>",
          HoldForm], 
         TagBox["\<\"vs no precond\"\>",
          HoldForm]},
        {"\<\"No preconditioning\"\>", "\<\"4.74 \[Times] \
10\:207b\.b9\:2070\"\>", "\<\"baseline\"\>"},
        {"\<\"Perfect Newton\"\>", "\<\"1.27 \[Times] \
10\:207b\:2078\:2074\"\>", "\<\"10\:2077\:2074\[Times] better\"\>"},
        {
         StyleBox[
          RowBox[{"Hutchinson", " ", 
           RowBox[{"(", "clipped", ")"}]}],
