      BoxForm`e$, 
       TableHeadings -> {
        None, {"Step", "max", "\[CurlyEpsilon]_i", "", "corr(s, s*)"}}]]], 
    "Text",
    StripOnInput->False,
    ShowStringCharacters->False],
   ImageMargins->{{0, 0}, {5, 5}}],
  ImageMargins->{{0, 0}, {5, 5}}]], "TextTableForm", \
"Text",ExpressionUUID->"b66bd84d-f9bb-4312-9d0f-c25bdb59d5e3"],

Cell["\<\
The bias drops below 1 by step ~120 and settles at ~10% by step 500. The \
metric correlation reaches 0.999. \
\>", "Text",ExpressionUUID->"278214f9-89d4-4664-963e-c14c91390b3a"],

Cell["Part VI: Hutchinson vs Secant WITH CLIPPING (Critical Test)", "Section",ExpressionUUID->"db17f1e7-10a6-4955-bf96-4beffbf39a0c"],

Cell["\<\
Clipping is essential \[LongDash] without it, negative estimates drive s to \
catastrophic values. \
\>", "Text",ExpressionUUID->"db345304-e4db-49c4-b462-03de7eea0fb8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Non", "-", 
     RowBox[{"diagonal", " ", "H"}]}], ",", " ", 
    RowBox[{
     RowBox[{"all", " ", "methods", " ", "with", " ", "clip", " ", "c"}], "=",
      "3"}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"SeedRandom", "[", "55", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"n", "=", "10"}], ";", " ", 
    RowBox[{"h", "=", 
     RowBox[{"Exp", "[", 
      RowBox[{"Range", "[", 
       RowBox[{"0", ",", 
        RowBox[{"Log", "[", "100", "]"}], ",", 
        RowBox[{
         RowBox[{"Log", "[", "100", "]"}], "/", 
         RowBox[{"(", 
          RowBox[{"n", "-", "1"}], ")"}]}]}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Hoff", "=", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{"0.", ",", 
       RowBox[{"{", 
        RowBox[{"n", ",", "n"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"i", "<", "j"}], ",", "\[IndentingNewLine]", "  ", 
        RowBox[{
         RowBox[{
          RowBox[{"Hoff", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", "j"}], "]"}], "]"}], "=", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", "/", "10."}], ")"}], "*", 
           RowBox[{"RandomReal", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "1"}], ",", "1"}], "}"}], "]"}], "*", 
           RowBox[{
            RowBox[{"Sqrt", "[", 
             RowBox[{
              RowBox[{"h", "[", 
               RowBox[{"[", "i", "]"}], "]"}], "*", 
              RowBox[{"h", "[", 
               RowBox[{"[", "j", "]"}], "]"}]}], "]"}], "/", 
            RowBox[{"(", 
             RowBox[{"n", "-", "1"}], ")"}]}]}]}], ";", "\[IndentingNewLine]",
          "  ", 
         RowBox[{
          RowBox[{"Hoff", "[", 
           RowBox[{"[", 
            RowBox[{"j", ",", "i"}], "]"}], "]"}], "=", 
          RowBox[{"Hoff", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", "j"}], "]"}], "]"}]}]}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "n"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"j", ",", "n"}], "}"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
   
   RowBox[{
    RowBox[{"Hfull", "=", 
     RowBox[{
      RowBox[{"DiagonalMatrix", "[", "h", "]"}], "+", "Hoff"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Hfull", "=", 
     RowBox[{"Hfull", "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Max", "[", 
          RowBox[{"0", ",", 
           RowBox[{"-", 
            RowBox[{"Min", "[", 
             RowBox[{"Eigenvalues", "[", "Hfull", "]"}], "]"}]}]}], "]"}], "+",
          "0.01"}], ")"}], "*", 
       RowBox[{"IdentityMatrix", "[", "n", "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Alpha]", "=", "0.0005"}], ";", " ", 
    RowBox[{"\[Mu]", "=", "0.05"}], ";", " ", 
    RowBox[{"\[Lambda]", "=", "0.1"}], ";", " ", 
    RowBox[{"c", "=", "3.0"}], ";", " ", 
    RowBox[{"nSteps", "=", "20000"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Theta]0", "=", 
     RowBox[{"RandomReal", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", "n"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"clipCenter", "[", 
      RowBox[{"s_", ",", "c_"}], "]"}], ":=", 
     RowBox[{"Clip", "[", 
      RowBox[{
       RowBox[{"s", "-", 
        RowBox[{"Mean", "[", "s", "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "c"}], ",", "c"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"No", " ", "preconditioning"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Theta]", "=", "\[Theta]0"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"lossNone", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"l", "=", 
         RowBox[{"0.5", "*", 
          RowBox[{"\[Theta]", ".", "Hfull", ".", "\[Theta]"}]}]}], ";", " ", 
        RowBox[{"\[Theta]", "=", 
         RowBox[{"\[Theta]", "-", 
          RowBox[{"\[Alpha]", "*", 
           RowBox[{"Hfull", ".", "\[Theta]"}]}]}]}], ";", " ", "l"}], ",", 
       RowBox[{"{", "nSteps", "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"Perfect", " ", "Newton"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Theta]", "=", "\[Theta]0"}], ";", " ", 
    RowBox[{"s", "=", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{"0.", ",", "n"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"trueTarget", "=", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"Log", "[", 
        RowBox[{"Diagonal", "[", "Hfull", "]"}], "]"}]}], "+", 
      RowBox[{"Mean", "[", 
       RowBox[{"Log", "[", 
        RowBox[{"Diagonal", "[", "Hfull", "]"}], "]"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"lossPerfect", "=", 
     RowBox[{"Table", "[", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{
        RowBox[{"l", "=", 
         RowBox[{"0.5", "*", 
          RowBox[{"\[Theta]", ".", "Hfull", ".", "\[Theta]"}]}]}], ";", " ", 
        RowBox[{"g", "=", 
         RowBox[{"Hfull", ".", "\[Theta]"}]}], ";", "\[IndentingNewLine]", 
        "  ", 
        RowBox[{"s", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", "-", 
             RowBox[{"\[Mu]", "*", "\[Lambda]"}]}], ")"}], "*", "s"}], "+", 
          RowBox[{"\[Mu]", "*", "\[Lambda]", "*", "trueTarget"}]}]}], ";", 
        " ", 
        RowBox[{"s", "=", 
         RowBox[{"clipCenter", "[", 
          RowBox[{"s", ",", "c"}], "]"}]}], ";", "\[IndentingNewLine]", "  ", 
        
        RowBox[{"\[Theta]", "=", 
         RowBox[{"\[Theta]", "-", 
          RowBox[{"\[Alpha]", "*", 
           RowBox[{"Exp", "[", "s", "]"}], "*", "g"}]}]}], ";", " ", "l"}], ",", 
       RowBox[{"{", "nSteps", "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"Hutchinson", " ", "+", " ", "clip"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Theta]", "=", "\[Theta]0"}], ";", " ", 
    RowBox[{"s", "=", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{"0.", ",", "n"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"lossHutch", "=", 
     RowBox[{"Table", "[", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{
        RowBox[{"l", "=", 
         RowBox[{"0.5", "*", 
          RowBox[{"\[Theta]", ".", "Hfull", ".", "\[Theta]"}]}]}], ";", " ", 
        RowBox[{"g", "=", 
         RowBox[{"Hfull", ".", "\[Theta]"}]}], ";", "\[IndentingNewLine]", 
        "  ", 
        RowBox[{"v", "=", 
         RowBox[{
          RowBox[{"2.", "*", 
           RowBox[{"RandomInteger", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"0", ",", "1"}], "}"}], ",", "n"}], "]"}]}], "-", 
          "1."}]}], ";", "\[IndentingNewLine]", "  ", 
        RowBox[{"hEst", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"Max", "[", 
            RowBox[{"#", ",", "0.01"}], "]"}], "&"}], " ", "/@", " ", 
          RowBox[{"(", 
           RowBox[{"v", "*", 
            RowBox[{"(", 
             RowBox[{"Hfull", ".", "v"}], ")"}]}], ")"}]}]}], ";", 
        "\[IndentingNewLine]", "  ", 
        RowBox[{"tgt", "=", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"Log", "[", "hEst", "]"}]}], "+", 
          RowBox[{"Mean", "[", 
           RowBox[{"-", 
            RowBox[{"Log", "[", "hEst", "]"}]}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", "  ", 
        RowBox[{"s", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", "-", 
             RowBox[{"\[Mu]", "*", "\[Lambda]"}]}], ")"}], "*", "s"}], "+", 
          RowBox[{"\[Mu]", "*", "\[Lambda]", "*", "tgt"}]}]}], ";", " ", 
        RowBox[{"s", "=", 
         RowBox[{"clipCenter", "[", 
          RowBox[{"s", ",", "c"}], "]"}]}], ";", "\[IndentingNewLine]", "  ", 
        
        RowBox[{"\[Theta]", "=", 
         RowBox[{"\[Theta]", "-", 
          RowBox[{"\[Alpha]", "*", 
           RowBox[{"Exp", "[", "s", "]"}], "*", "g"}]}]}], ";", " ", "l"}], ",", 
       RowBox[{"{", "nSteps", "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"Secant", " ", "+", " ", "clip"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Theta]", "=", "\[Theta]0"}], ";", " ", 
    RowBox[{"s", "=", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{"0.", ",", "n"}], "]"}]}], ";", " ", 
    RowBox[{"prev\[Theta]", "=", "\[Theta]"}], ";", " ", 
    RowBox[{"prevg", "=", 
     RowBox[{"Hfull", ".", "\[Theta]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"lossSec", "=", 
     RowBox[{"Table", "[", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{
        RowBox[{"l", "=", 
         RowBox[{"0.5", "*", 
          RowBox[{"\[Theta]", ".", "Hfull", ".", "\[Theta]"}]}]}], ";", " ", 
        RowBox[{"g", "=", 
         RowBox[{"Hfull", ".", "\[Theta]"}]}], ";", "\[IndentingNewLine]", 
        "  ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"t", ">", "1"}], ",", "\[IndentingNewLine]", "    ", 
          RowBox[{"Module", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"d\[Theta]", "=", 
               RowBox[{"\[Theta]", "-", "prev\[Theta]"}]}], ",", 
              RowBox[{"dg", "=", 
               RowBox[{"g", "-", "prevg"}]}], ",", "hSec", ",", "tgt"}], 
             "}"}], ",", "\[IndentingNewLine]", "      ", 
            RowBox[{
             RowBox[{"hSec", "=", 
              RowBox[{"Table", "[", 
               RowBox[{
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"Abs", "[", 
                    RowBox[{"d\[Theta]", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "]"}], ">", 
                   RowBox[{"10", "^", 
                    RowBox[{"-", "5"}]}]}], ",", 
                  RowBox[{
                   RowBox[{"dg", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "/", 
                   RowBox[{"d\[Theta]", "[", 
                    RowBox[{"[", "i", "]"}], "]"}]}], ",", "1."}], "]"}], ",", 
                RowBox[{"{", 
                 RowBox[{"i", ",", "n"}], "}"}]}], "]"}]}], ";", 
             "\[IndentingNewLine]", "      ", 
             RowBox[{"hSec", "=", 
              RowBox[{
               RowBox[{
                RowBox[{"Max", "[", 
                 RowBox[{"#", ",", "0.01"}], "]"}], "&"}], " ", "/@", " ", 
               "hSec"}]}], ";", "\[IndentingNewLine]", "      ", 
             RowBox[{"tgt", "=", 
              RowBox[{
               RowBox[{"-", 
                RowBox[{"Log", "[", "hSec", "]"}]}], "+", 
               RowBox[{"Mean", "[", 
                RowBox[{"-", 
                 RowBox[{"Log", "[", "hSec", "]"}]}], "]"}]}]}], ";", 
             "\[IndentingNewLine]", "      ", 
             RowBox[{"s", "=", 
              RowBox[{
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"1", "-", 
                  RowBox[{"\[Mu]", "*", "\[Lambda]"}]}], ")"}], "*", "s"}], "+", 
               RowBox[{"\[Mu]", "*", "\[Lambda]", "*", "tgt"}]}]}], ";", " ", 
             
             RowBox[{"s", "=", 
              RowBox[{"clipCenter", "[", 
               RowBox[{"s", ",", "c"}], "]"}]}]}]}], "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", "  ", 
        RowBox[{"prev\[Theta]", "=", "\[Theta]"}], ";", " ", 
        RowBox[{"prevg", "=", "g"}], ";", "\[IndentingNewLine]", "  ", 
        RowBox[{"\[Theta]", "=", 
         RowBox[{"\[Theta]", "-", 
          RowBox[{"\[Alpha]", "*", 
           RowBox[{"Exp", "[", "s", "]"}], "*", "g"}]}]}], ";", " ", "l"}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "nSteps"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"ListLogPlot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "lossNone", ",", "lossPerfect", ",", "lossHutch", ",", "lossSec"}], 
      "}"}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"PlotLegends", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<No precond\>\"", ",", "\"\<Perfect Newton\>\"", 
        ",", "\"\<Hutchinson\>\"", ",", "\"\<Secant\>\""}], "}"}]}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"AxesLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<Step\>\"", ",", "\"\<Loss\>\""}], "}"}]}], ",", 
     RowBox[{
     "PlotLabel", 
      "->", "\"\<Convergence: Non-Diagonal H \
(\[Kappa]\[TildeTilde]100)\>\""}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"PlotStyle", "->", 
      RowBox[{"{", 
       RowBox[{"Gray", ",", 
        RowBox[{"Darker", "[", "Green", "]"}], ",", "Blue", ",", "Orange"}], 
       "}"}]}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"ImageSize", "->", "600"}], ",", 
     RowBox[{"PlotRange", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"10", "^", 
         RowBox[{"-", "90"}]}], ",", "Automatic"}], "}"}]}]}], 
    "]"}]}]}]], "Input",ExpressionUUID->"2029dc02-f48f-4100-967b-\
0d25b90134fe"],

Cell[TextData[StyleBox["Key result (\[Kappa] \[TildeTilde] 100, non-diagonal \
H, 20000 steps):",
 FontWeight->Bold]], "Text",ExpressionUUID->"7c36c644-a655-4b8c-8bcf-\
